import Lean

/-!
Generate the binding contract from Lean.

For each method of the Python extension, it reads the docstring of the operation that it exposes.

It also reads the code of each constructor of the error types that the method can raise.

It writes the C docstrings, the contract as JSON, and the type stub of the extension module.

It also writes the modules of the Python type aliases, which the stub imports.

With `--check`, it writes nothing, and fails when a file differs from what it would write.
-/

open Lean Meta

namespace GenBindings

/-- One method of the Python extension, as the table in `EthLib.Base.Exports.Bindings` gives it. -/
structure Binding where
  method : String
  operation : Name
  signature : String
  errors : List Name
  errorClass : Option String

/-- The table of methods, read from the compiled Lean table. -/
unsafe def readBindings (env : Environment) : IO (List Binding) := do
  let data ← IO.ofExcept <| env.evalConst
    (List (String × String × String × List String × Option String)) {}
    `EthLib.Exports.bindingsData
  return data.map fun (m, op, sig, errs, cls) =>
    { method := m, operation := op.toName, signature := sig, errors := errs.map (·.toName),
      errorClass := cls }

/-- One Python type alias, as the table in `EthLib.Base.Exports.Bindings` gives it. -/
structure Alias where
  pyModule : String
  name : String
  doc : String
  type : String

/-- The type aliases, read from the compiled Lean table; two aliases never share a name. -/
unsafe def readAliases (env : Environment) : IO (List Alias) := do
  let data ← IO.ofExcept <| env.evalConst (List (String × String × String × String)) {}
    `EthLib.Exports.pythonAliasesData
  let aliases := data.map fun (m, n, d, t) => { pyModule := m, name := n, doc := d, type := t }
  for a in aliases do
    if (aliases.filter (·.name == a.name)).length > 1 then
      throw (IO.userError s!"alias {a.name} is defined twice")
  return aliases

/-- The file of a Python module of the package, relative to the repository root. -/
def modulePath (pyModule : String) : System.FilePath :=
  "bindings/python" / (("/".intercalate (pyModule.splitOn ".")) ++ ".py")

/-- The text of one module of type aliases. -/
def aliasModuleText (aliases : List Alias) : String := Id.run do
  let mut out := "# Generated by `lake exe gen-bindings` from Lean. Do not edit.\n"
  let doc := "The Python types of the values that the extension takes and returns."
  out := out ++ s!"\"\"\"{doc}\"\"\"\n\n"
  out := out ++ "from typing import TypeAlias\n"
  for a in aliases do
    out := out ++ s!"\n# {a.doc}\n{a.name}: TypeAlias = {a.type}\n"
  out ++ "\n__all__ = [" ++ ", ".intercalate
    ((aliases.map (·.name)).mergeSort (· ≤ ·) |>.map fun n => s!"\"{n}\"") ++ "]\n"

/-- The modules of type aliases, in the order of their first alias. -/
def aliasModules (aliases : List Alias) : List String :=
  aliases.foldl (fun acc a => if acc.contains a.pyModule then acc else acc ++ [a.pyModule]) []

/-- The files that the generator writes, relative to the repository root. -/
def docstringsPath : System.FilePath := "bindings/python/docstrings.h"
def contractPath : System.FilePath := "bindings/contract/contract.json"
def stubPath : System.FilePath := "bindings/python/ethlib/cryptography/_native.pyi"

/-- The code of each constructor of an error type, read by reducing its `code` function.

A constructor that passes on the code of the error it wraps has no code of its own, so `none`. -/
def ctorCodes (ty : Name) : MetaM (List (Name × Option Nat)) := do
  let some (.inductInfo info) := (← getEnv).find? ty | throwError "{ty} is not an inductive type"
  let code := ty ++ `code
  unless (← getEnv).contains code do throwError "{ty} has no code function"
  info.ctors.mapM fun ctor => do
    let cinfo ← getConstInfoCtor ctor
    forallTelescope cinfo.type fun xs _ => do
      -- Elaboration infers the parameters of the type, such as the error of a shuffle.
      let e := mkApp (mkConst ``UInt32.toNat) (← mkAppM code #[mkAppN (mkConst ctor) xs])
      let r ← instantiateMVars (← withTransparency .all <| whnf e)
      return (ctor, ← evalNat r)

/-- A string as a C string literal. -/
def cString (s : String) : String :=
  let body := s.foldl (init := "") fun acc c =>
    match c with
    | '"' => acc ++ "\\\""
    | '\\' => acc ++ "\\\\"
    | '\n' => acc ++ "\\n\"\n  \""
    | c => acc.push c
  "\"" ++ body ++ "\""

/-- The one-line docstring of a method: the first paragraph of its operation's docstring.

The contract keeps the whole docstring, with its warnings and its errors. -/
def methodDoc (_ : Binding) (doc : String) : String :=
  let first := (doc.trimAscii.toString.splitOn "\n\n").headD ""
  " ".intercalate ((first.splitOn "\n").map (·.trimAscii.toString))

/-- The text of `docstrings.h`. -/
def docstringsText (docs : List (Binding × String)) : String := Id.run do
  let mut out := "/* Generated by `lake exe gen-bindings` from Lean. Do not edit. */\n"
  out := out ++ "#ifndef ETHLIB_DOCSTRINGS_H\n#define ETHLIB_DOCSTRINGS_H\n\n"
  for (b, doc) in docs do
    out := out ++ s!"#define DOC_{b.method} \\\n  {cString (methodDoc b doc)}\n\n"
  out ++ "#endif /* ETHLIB_DOCSTRINGS_H */\n"

/-- The text of the type stub of the extension module. -/
def stubText (docs : List (Binding × String)) (aliases : List Alias) : String := Id.run do
  let mut out := "# Generated by `lake exe gen-bindings` from Lean. Do not edit.\n\n"
  out := out ++ "from typing import Any, Literal\n"
  for m in aliasModules aliases do
    let names := (aliases.filter (·.pyModule == m)).map (·.name) |>.mergeSort (· ≤ ·)
    out := out ++ s!"\nfrom {m} import {", ".intercalate names}"
  out := out ++ "\n\n\n"
  for (b, doc) in docs do
    let body := (methodDoc b doc).replace "\\" "\\\\" |>.replace "\"\"\"" "\\\"\\\"\\\""
    out := out ++ s!"def {b.method}{b.signature}:\n    \"\"\"{body}\"\"\"\n    ...\n\n"
  out ++ "def __getattr__(name: str) -> int: ...\n"

/-- The contract of one method, as JSON. -/
def methodJson (b : Binding) (doc : String) (codes : List (Name × List (Name × Option Nat))) :
    Json :=
  Json.mkObj [
    ("method", b.method),
    ("operation", b.operation.toString),
    ("signature", b.signature),
    ("summary", methodDoc b doc),
    ("docstring", doc.trimAscii.toString),
    ("error_class", match b.errorClass with | some c => toJson c | none => Json.null),
    ("errors", Json.arr (codes.toArray.map fun (ty, cs) => Json.mkObj [
      ("type", ty.toString),
      ("codes", Json.arr (cs.toArray.map fun (c, n) => Json.mkObj [
        ("constructor", c.componentsRev.head!.toString), ("code", toJson n)]))]))]

/-- Every file that the generator writes, with its text. -/
unsafe def outputs (env : Environment) : IO (List (System.FilePath × String)) := do
  let ctx : Core.Context := { fileName := "<gen-bindings>", fileMap := default }
  let mut docs := []
  let mut methods := #[]
  for b in ← readBindings env do
    unless env.contains b.operation do
      throw (IO.userError s!"{b.method}: no declaration {b.operation}")
    let some doc ← findDocString? env b.operation
      | throw (IO.userError s!"{b.method}: {b.operation} has no docstring")
    let mut codes := []
    for ty in b.errors do
      let (cs, _) ← ((ctorCodes ty).run' {} |>.toIO ctx { env })
      codes := codes ++ [(ty, cs)]
    docs := docs ++ [(b, doc)]
    methods := methods.push (methodJson b doc codes)
  let aliases ← readAliases env
  let aliasJson := aliases.toArray.map fun a => Json.mkObj [
    ("module", a.pyModule), ("name", a.name), ("doc", a.doc), ("type", a.type)]
  let contract :=
    (Json.mkObj [("aliases", Json.arr aliasJson), ("methods", Json.arr methods)]).pretty ++ "\n"
  let modules := (aliasModules aliases).map fun m =>
    (modulePath m, aliasModuleText (aliases.filter (·.pyModule == m)))
  return [(docstringsPath, docstringsText docs), (contractPath, contract),
    (stubPath, stubText docs aliases)] ++ modules

unsafe def run (args : List String) : IO UInt32 := do
  let check := args.contains "--check"
  initSearchPath (← findSysroot)
  enableInitializersExecution
  let env ← importModules #[{ module := `EthLib.Exports }] {} (loadExts := true)
  let files ← outputs env
  let mut stale := false
  for (path, text) in files do
    let old ← if ← path.pathExists then IO.FS.readFile path else pure ""
    if old != text then
      if check then
        IO.eprintln s!"gen-bindings: {path} is stale; run `lake exe gen-bindings`"
        stale := true
      else
        if let some dir := path.parent then IO.FS.createDirAll dir
        IO.FS.writeFile path text
        IO.println s!"gen-bindings: wrote {path}"
  return if stale then 1 else 0

end GenBindings

unsafe def main (args : List String) : IO UInt32 := GenBindings.run args
