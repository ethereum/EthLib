/-! ### `fail-msm_G2_bls.json` -/

theorem bls12G2Msm_empty_input :
    bls12G2Msm (.empty) 22500 = .error (.invalidInputLength 0) :=
  eq_error_of_kernel (by decide +kernel)

theorem bls12G2Msm_short_input :
    bls12G2Msm (byteArrayOf 575 ) 22500 = .error (.invalidInputLength 575) :=
