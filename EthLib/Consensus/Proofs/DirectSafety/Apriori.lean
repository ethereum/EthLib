namespace EthLib.Consensus.DirectSafety.Apriori.Internal
open EthLib.Consensus.DirectSafety.Apriori
open Base Classical
variable {preset : Preset} {config : Config} {checks : SignatureChecks}

/-- A paid pair carries a fresh tag exactly when its source is new.

A new source is one that is not an initial pending source at `x`. -/
private theorem ReservedReplay.fresh_not_initial {g x y : ForkedBeaconState preset} {high : Nat}
    {rounding : Nat → Nat} {events : List (BalanceEvent preset)}
    {final : List TaggedEntry} {allPayments : List (TaggedEntry × Payment preset)}
    {allAllocations : List OwnedRelease} {calls : List (IndexedDepartureCall preset config)}
    {before after : Ownership}
    (shared : Run config checks g x) (genesis : Genesis (config := config) (checks := checks) g)
    (electra : .pectra ≤ x.fork) (early : x.fork < .glamsterdam)
    (delay : 0 < config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    (history : ReservedReplay (config := config) (checks := checks) x high rounding
      x (getCurrentEpoch x.state) y (getCurrentEpoch y.state) 0 0 0
      events (initialTags (x.state.pendingConsolidations electra).data.toList) final
      allPayments allAllocations calls before after)
    (lifecycle : ∀ e ∈ events, RegistryLifecycle x.state e.before.state) :
    ∀ pair ∈ allPayments, ((∃ n, pair.1.tag = .fresh n) ↔
      (x.state.pendingConsolidations electra).data.toList.any
        (fun c => c.sourceIndex.toNat == pair.2.source) = false) := by
  have invariant := shared.pendingConsolidation_invariant genesis early electra delay
  have initialKnown :
      TagsKnown x (initialTags (x.state.pendingConsolidations electra).data.toList) := by
    intro tag member
    obtain ⟨⟨entry, position⟩, inside, rfl⟩ := List.mem_map.mp member
    refine ⟨fun _ _ => ?_, fun _ kind => by cases kind⟩
    simpa only [pendingQueue, electra, ↓reduceDIte] using List.fst_mem_of_mem_zipIdx inside
  obtain ⟨-, members⟩ := history.counters_original.2.2.2.2.2.2.1 lifecycle initialKnown
  intro pair member
  obtain ⟨known, source⟩ := members pair member
  have tagKnown := known pair.1 List.mem_cons_self
  cases kind : pair.1.tag with
  | initial p =>
    have inside := tagKnown.1 p kind
    simp only [pendingQueue, electra, ↓reduceDIte] at inside
    have found : (x.state.pendingConsolidations electra).data.toList.any
        (fun c => c.sourceIndex.toNat == pair.2.source) = true :=
      List.any_eq_true.mpr ⟨_, inside, by rw [source, beq_self_eq_true]⟩
    rw [found]
    simp
  | fresh n =>
    refine ⟨fun _ => ?_, fun _ => ⟨n, rfl⟩⟩
    have far := tagKnown.2 n kind
    cases initial : (x.state.pendingConsolidations electra).data.toList.any
        (fun c => c.sourceIndex.toNat == pair.2.source)
    · rfl
    · exfalso
      obtain ⟨c, inside, same⟩ := List.any_eq_true.mp initial
      obtain ⟨v, found, _, _, assigned⟩ := invariant.2 c inside
      rw [beq_iff_eq] at same
      rw [← source, ← same, found] at far
      simp only [Option.all_some, beq_iff_eq] at far
      exact assigned far

/-- Filtering zipped pairs on their first component, then keeping that component's image. -/
private theorem zip_filter_fst_map {α β γ : Type} (p : α → Bool) (f : α → γ) :
    ∀ (l : List α) (r : List β), l.length = r.length →
      ((l.zip r).filter (fun pair => p pair.1)).map (fun pair => f pair.1) = (l.filter p).map f
  | [], _, _ => by simp
  | _ :: _, [], same => by simp at same
  | a :: l, b :: r, same => by
    have rest := zip_filter_fst_map p f l r (by simpa using same)
    by_cases chosen : p a <;> simp [chosen, rest]

/-- SelectedRelease's `ActualPaymentCoverage` premise, for the fresh payments of the history. -/
private theorem ReservedReplay.actual_payment_coverage {x y : ForkedBeaconState preset}
    {high : Nat} {rounding : Nat → Nat} {events : List (BalanceEvent preset)}
    {final : List TaggedEntry} {allPayments : List (TaggedEntry × Payment preset)}
    {allAllocations : List OwnedRelease} {calls : List (IndexedDepartureCall preset config)}
    {before after : Ownership} (electra : .pectra ≤ x.fork)
    (history : ReservedReplay (config := config) (checks := checks) x high rounding
      x (getCurrentEpoch x.state) y (getCurrentEpoch y.state) 0 0 0
      events (initialTags (x.state.pendingConsolidations electra).data.toList) final
      allPayments allAllocations calls before after)
    (notInitial : ∀ pair ∈ allPayments, ((∃ n, pair.1.tag = .fresh n) ↔
      (x.state.pendingConsolidations electra).data.toList.any
        (fun c => c.sourceIndex.toNat == pair.2.source) = false)) :
    ActualPaymentCoverage events
      (((allPayments.zip allAllocations).filter fun pair =>
        match pair.1.1.tag with | .fresh _ => true | .initial _ => false).map
          fun pair => pair.1.2)
      (x.state.pendingConsolidations electra).data.toList := by
  obtain ⟨per, related, flat⟩ := history.counters_original.2.2.2.2.2.1
  have lengths : events.length = per.length := related.length_eq
  refine ⟨fun j => (per[j.val]'(lengths ▸ j.isLt)).map Prod.snd, fun j => ?_, ?_⟩
  · exact (List.forall₂_iff_get.mp related).2 j.val j.isLt _
  have spread : (List.finRange events.length).flatMap
      (fun j : Fin events.length => (per[j.val]'(lengths ▸ j.isLt)).map Prod.snd) =
      (per.map (List.map Prod.snd)).flatten := by
    rw [List.flatMap_def]
    congr 1
    apply List.ext_getElem (by simp [lengths])
    intro i _ _
    simp
  rw [spread, ← List.map_flatten, ← flat, List.filter_map]
  have zipped := zip_filter_fst_map
    (fun pair : TaggedEntry × Payment preset =>
      match pair.1.tag with | .fresh _ => true | .initial _ => false)
    Prod.snd allPayments allAllocations history.paired_rounds.length_eq
  refine zipped.trans (congrArg (List.map Prod.snd) (List.filter_congr fun pair member => ?_))
  have same := notInitial pair member
  cases kind : pair.1.tag with
  | initial p =>
    have : ¬ ∃ n, pair.1.tag = .fresh n := fun ⟨_, fresh⟩ => by rw [kind] at fresh; cases fresh
    have initial := Bool.not_eq_false _ |>.mp (mt same.mpr this)
    simp only [Function.comp_apply]
    rw [initial]
    rfl
  | fresh n =>
    have initial := same.mp ⟨n, kind⟩
    simp only [Function.comp_apply]
    rw [initial]
    rfl

/-- The release partition of the selected release, the source rounds and both rho sums.

They come from the history's fresh payments. -/
private theorem ReservedReplay.release_rounding {x y : ForkedBeaconState preset} {high : Nat}
    {tail : Run config checks x y}
        (ledger : RoundLedger (config := config) (checks := checks) tail high)
    {events : List (BalanceEvent preset)} {queue final : List TaggedEntry}
    {allPayments : List (TaggedEntry × Payment preset)} {allAllocations : List OwnedRelease}
    {calls : List (IndexedDepartureCall preset config)} {before after : Ownership}
    (history : ReservedReplay (config := config) (checks := checks) x high
      (fun i => if i ∈ ledger.sourceFalling then preset.EFFECTIVE_BALANCE_INCREMENT.toNat else 0)
      x (getCurrentEpoch x.state) y (getCurrentEpoch y.state) 0 0 0
      events queue final allPayments allAllocations calls before after)
    {selected : List SelectedCharge} {payments : List (Payment preset)}
    {tags : List TaggedEntry} {allocations : List OwnedRelease}
    (fresh : let pairs := (allPayments.zip allAllocations).filter fun pair =>
        match pair.1.1.tag with | .fresh _ => true | .initial _ => false
      payments = pairs.map (fun pair => pair.1.2) ∧ allocations = pairs.map Prod.snd ∧
        tags = pairs.map (fun pair => pair.1.1))
    (chosen : SelectedPayments selected payments tags) :
    ReleasePartition selected payments allocations ∧
    (∀ j : Fin allocations.length, ∃ p, payments[j.val]? = some p ∧
      allocations[j].sourceRound =
        if p.source ∈ ledger.sourceFalling then preset.EFFECTIVE_BALANCE_INCREMENT.toNat else 0) ∧
    (allocations.map (·.sourceRound)).sum ≤ roundingBudget (config := config) x high ∧
    (allocations.map (·.baseline)).sum ≤ (selected.map (·.amount)).sum +
        roundingBudget (config := config) x high := by
  dsimp only at fresh
  obtain ⟨rfl, rfl, rfl⟩ := fresh
  have rounds := history.fresh_source_round_bound ledger _ rfl
  have baselines := history.fresh_baseline_sum_le
  dsimp only at baselines
  have facts : ∀ pair ∈ (allPayments.zip allAllocations).filter (fun pair =>
      match pair.1.1.tag with | .fresh _ => true | .initial _ => false),
      pair.2.baseline ≤ pair.1.1.amount + pair.2.sourceRound ∧
      pair.1.2.amount = pair.2.external + pair.2.baseline ∧
      pair.2.sourceRound = if pair.1.2.source ∈ ledger.sourceFalling then
        preset.EFFECTIVE_BALANCE_INCREMENT.toNat else 0 := by
    intro pair member
    obtain ⟨zipped, chosenTag⟩ := List.mem_filter.mp member
    obtain ⟨parts, amount⟩ := List.forall₂_zip history.paired_releases zipped
    refine ⟨?_, amount, List.forall₂_zip history.paired_rounds zipped⟩
    cases kind : pair.1.1.tag with
    | initial p => rw [kind] at chosenTag; cases chosenTag
    | fresh n => simpa only [kind] using parts
  generalize (allPayments.zip allAllocations).filter (fun pair =>
      match pair.1.1.tag with | .fresh _ => true | .initial _ => false) = pairs
    at facts rounds baselines chosen ⊢
  obtain ⟨sizes, tagSizes, each⟩ := chosen
  simp only [List.length_map] at sizes tagSizes
  -- Each selected amount is its tag's amount.
  have amounts : selected.map (·.amount) = pairs.map (fun pair => pair.1.1.amount) := by
    apply List.ext_getElem (by simp [sizes])
    intro i inside _
    have below : i < selected.length := by simpa using inside
    obtain ⟨_, tag, _, found, _, _, _, _, _, amountEq, _, _⟩ := each ⟨i, below⟩
    simp only [Fin.getElem_fin, List.getElem?_map,
      List.getElem?_eq_getElem (show i < pairs.length by omega), Option.map_some,
      Option.some.injEq] at found amountEq
    simp only [List.getElem_map]
    rw [amountEq, ← found]
  refine ⟨⟨by simp, by simp [sizes], fun i => ?_⟩, fun j => ?_, ?_, ?_⟩
  · have inside : i.val < pairs.length := by simpa using i.isLt
    obtain ⟨below, amount, _⟩ := facts _ (List.getElem_mem inside)
    have selectedAmount := congrArg (·[i.val]?) amounts
    simp only [List.getElem?_map, List.getElem?_eq_getElem inside,
      List.getElem?_eq_getElem (show i.val < selected.length by omega), Option.map_some,
      Option.some.injEq] at selectedAmount
    refine ⟨(pairs[i.val]).2, selected[i.val]'(by omega), by simp [inside],
      List.getElem?_eq_getElem _, ?_, ?_⟩
    · simp only [Fin.getElem_fin, List.getElem_map]
      omega
    · omega
  · have inside : j.val < pairs.length := by simpa using j.isLt
    refine ⟨(pairs[j.val]).1.2, by simp [inside], ?_⟩
    simp only [Fin.getElem_fin, List.getElem_map]
    exact (facts _ (List.getElem_mem inside)).2.2
  · simpa only [List.map_map, Function.comp_def] using rounds
  · rw [amounts]
    simp only [List.map_map, Function.comp_def] at rounds ⊢
    omega

end EthLib.Consensus.DirectSafety.Apriori.Internal

section
namespace EthLib.Consensus.DirectSafety
open Apriori
open Base Classical Cryptography.Bls Uint64
variable {preset : Preset} {config : Config} {checks : SignatureChecks}
noncomputable section
namespace Apriori.Internal

/-- A strict drop of `i`'s effective balance between consecutive states of a path. -/
private def PathDrop (path : List (ForkedBeaconState preset)) (i : Nat) : Prop :=
  ∃ j a b, path[j]? = some a ∧ path[j + 1]? = some b ∧ effectiveAt b i < effectiveAt a i

/-- A strict drop of `i`'s effective balance between consecutive states of a step's path. -/
private def StepDrop {u v : ForkedBeaconState preset} (step : Step config checks u v)
    (i : Nat) : Prop :=
  ∃ j a b, step.balancePath[j]? = some a ∧ step.balancePath[j + 1]? = some b ∧
    effectiveAt b i < effectiveAt a i

/-- The bound a block hands to its requests: every key whose exit this block assigns. -/
private def BlockAssigned (rounding : Nat → Nat) {f h : Fork} (m : BeaconState preset f)
    (n : BeaconState preset h) (o : Ownership) : Prop :=
  ∀ (i : Nat) (v w : Validator), m.validators.data[i]? = some v →
    n.validators.data[i]? = some w →
    v.exitEpoch = FAR_FUTURE_EPOCH → w.exitEpoch ≠ FAR_FUTURE_EPOCH →
    o.original i ≤ v.effectiveBalance.toNat + rounding i

/-- A proposer slashing records one slashings event with its limits read at `s`. -/
private def ProposerSlashingReplay : Prop :=
  ∀ (x : ForkedBeaconState preset) (high : Nat) (rounding : Nat → Nat) {fork : Fork}
    (electra : .pectra ≤ fork) (_early : fork < .glamsterdam)
    (_delay : 0 < config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    {s t : BeaconState preset fork} (slashing : ProposerSlashing) {credit debit : Nat},
    slashingLimits [slashing.signedHeader1.message.proposerIndex] s = .ok (credit, debit) →
    processProposerSlashing config checks s slashing = .ok t →
    OperationReplay (config := config) (checks := checks) x high rounding electra s t
      [⟨.slashings, ⟨fork, s⟩, ⟨fork, t⟩, credit, debit⟩] []

/-- An attester slashing records one slashings event with its limits read at `s`. -/
private def AttesterSlashingReplay : Prop :=
  ∀ (x : ForkedBeaconState preset) (high : Nat) (rounding : Nat → Nat) {fork : Fork}
    (electra : .pectra ≤ fork) (_early : fork < .glamsterdam)
    (_delay : 0 < config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    {s t : BeaconState preset fork} (slashing : AttesterSlashing preset fork)
    {credit debit : Nat},
    slashingLimits (slashingIndices slashing) s = .ok (credit, debit) →
    processAttesterSlashing config checks s slashing = .ok t →
    OperationReplay (config := config) (checks := checks) x high rounding electra s t
      [⟨.slashings, ⟨fork, s⟩, ⟨fork, t⟩, credit, debit⟩] []

/-- The voluntary exits of a block record nothing. -/
private def VoluntaryExitsReplay : Prop :=
  ∀ (x : ForkedBeaconState preset) (high : Nat) (rounding : Nat → Nat) {fork : Fork}
    (electra : .pectra ≤ fork) (_early : fork < .glamsterdam)
    (_delay : 0 < config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    {s t : BeaconState preset fork} (exits : List SignedVoluntaryExit),
    exits.foldlM (processVoluntaryExit config checks) s = .ok t →
    OperationReplay (config := config) (checks := checks) x high rounding electra s t [] []

/-- The withdrawal requests of a block record nothing. -/
private def WithdrawalRequestsReplay : Prop :=
  ∀ (x : ForkedBeaconState preset) (high : Nat) (rounding : Nat → Nat) {fork : Fork}
    (electra : .pectra ≤ fork) (_early : fork < .glamsterdam)
    (_delay : 0 < config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    {s t : BeaconState preset fork} (requests : List WithdrawalRequest),
    requests.foldlM (processWithdrawalRequest config · electra ·) s = .ok t →
    OperationReplay (config := config) (checks := checks) x high rounding electra s t [] []

/-- `OperationReplay` for a whole block from `s` to `t`.

It also takes `BlockAssigned` at the block input, which each consolidation request reads. -/
private def BlockOperationReplay (x : ForkedBeaconState preset) (high : Nat)
    (rounding : Nat → Nat) {fork : Fork} (electra : .pectra ≤ fork)
    (s t : BeaconState preset fork) (added : List (BalanceEvent preset))
    (sites : List (ForkedBeaconState preset)) : Prop :=
  ∀ (queue : List TaggedEntry) (owned : Ownership)
    (eventPosition paymentPosition callPosition : Nat),
    BlockAssigned rounding s t owned →
    OperationReplayAt (config := config) (checks := checks) x high rounding electra s t added
      sites queue owned eventPosition paymentPosition callPosition

/-- A block step's replay is one block operation replay over its events.

Its sites are the block's consolidation sites. -/
private def BlockReplay : Prop :=
  ∀ (x : ForkedBeaconState preset) (high : Nat) (rounding : Nat → Nat) {fork : Fork}
    (electra : .pectra ≤ fork) (_early : fork < .glamsterdam)
    (_delay : 0 < config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    (_compounding : preset.MIN_ACTIVATION_BALANCE ≤ preset.MAX_EFFECTIVE_BALANCE_ELECTRA)
    {s t : BeaconState preset fork} (engine : ExecutionEngine preset fork)
    (signed : SignedBeaconBlock preset fork) (due : upgradeDue config ⟨fork, s⟩ = false)
    (ok : applySignedBlock config checks engine s signed true = .ok t)
    {events : List (BalanceEvent preset)},
    (Step.block engine signed due ok).balanceEvents = .ok events →
    BlockOperationReplay (config := config) (checks := checks) x high rounding electra s t
      events (Step.block (checks := checks) engine signed due ok).consolidationSites

/-- The replay of one slot step of a shared run, from `u` to `v`, inside the horizon.

The run facts at the epoch input come from the shared run and the branch prefix.

The run-level replay supplies the queue provenance and the zero initial tags from its history. -/
private def SlotStepReplay : Prop :=
  ∀ {g x u v : ForkedBeaconState preset} {high : Nat} {rounding : Nat → Nat}
    {queue : List TaggedEntry} {owned : Ownership}
    {eventPosition paymentPosition callPosition : Nat}
    (_shared : Run config checks g x) (_pre : Run config checks x u)
    (_genesis : Genesis (config := config) (checks := checks) g) (_caps : CapOrder preset)
    (_twoSlots : 2 ≤ preset.SLOTS_PER_EPOCH.toNat)
    (_delayTwo : 2 ≤ config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    (_electraX : .pectra ≤ x.fork) (electra : .pectra ≤ u.fork) (_early : v.fork < .glamsterdam)
    (_endEpoch : (getCurrentEpoch u.state).toNat ≤ high + 1)
    (ok : advanceSlotAcross config checks u = .ok v) {events : List (BalanceEvent preset)}
    (_replayed : (Step.slot ok).balanceEvents = .ok events)
    (_reserve : ReserveCut x high u (getCurrentEpoch u.state) (queue.map (·.entry)) owned)
    (_assignment : AssignmentCut rounding queue owned)
    (_erasure : QueueErasure queue (pendingQueue u))
    (_prior : OwnershipBefore eventPosition paymentPosition owned)
    (_retired : RetiredActivated u.state owned.retired)
    (_cover : EndpointCoverAll x u owned) (_future : FutureEffectiveCover x u owned)
    (_fresh : FreshExits u.state queue)
    (_provenance : ∀ c ∈ queue.map (·.entry), c ∈ pendingQueue x ∨
      (x.state.validators.data[c.sourceIndex.toNat]?).all (·.exitEpoch == FAR_FUTURE_EPOCH))
    (_initialZero : ∀ tag ∈ queue, ∀ n, tag.tag = .initial n →
      owned.original tag.entry.sourceIndex.toNat = 0),
    ∃ (queue' : List TaggedEntry) (payments : List (TaggedEntry × Payment preset))
      (allocations : List OwnedRelease) (owned' : Ownership),
      ReservedReplay (config := config) (checks := checks) x high rounding
        u (getCurrentEpoch u.state) v (getCurrentEpoch v.state)
        eventPosition paymentPosition callPosition events queue queue' payments allocations []
        owned owned' ∧
      ReserveCut x high v (getCurrentEpoch v.state) (queue'.map (·.entry)) owned' ∧
      AssignmentCut rounding queue' owned' ∧
      QueueErasure queue' (pendingQueue v) ∧
      OwnershipBefore (eventPosition + events.length) (paymentPosition + payments.length)
        owned' ∧
      RetiredActivated v.state owned'.retired ∧
      EndpointCoverAll x v owned' ∧ FutureEffectiveCover x v owned' ∧
      FreshExits v.state queue' ∧
      (∀ e ∈ events, e.source = .consolidations →
        PendingConsolidationInvariant config e.before.state) ∧
      (∀ pair ∈ payments, pair.2.epoch ≤ (getCurrentEpoch v.state).toNat) ∧
      (∀ pair ∈ payments, ∀ n, pair.1.tag = .fresh n → ∃ w,
        pair.2.before.state.validators.data[pair.2.source]? = some w ∧
          pair.1.epoch + config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat ≤
            w.withdrawableEpoch.toNat) ∧
      (∀ pair ∈ payments, Paying pair.2) ∧
      (0 < preset.EFFECTIVE_BALANCE_INCREMENT.toNat → ∀ down : Nat → Prop,
        (∀ i, owned.original i ≤ effectiveAt u i +
          (if down i then preset.EFFECTIVE_BALANCE_INCREMENT.toNat else 0)) →
        ∀ i, owned'.original i ≤ effectiveAt v i +
          (if down i ∨ StepDrop (Step.slot ok) i then
            preset.EFFECTIVE_BALANCE_INCREMENT.toNat else 0)) ∧
      ∀ target : .pectra ≤ v.fork,
        DepartureQueueTrace (u.state.earliestConsolidationEpoch electra)
          (u.state.consolidationBalanceToConsume electra) []
          (v.state.earliestConsolidationEpoch target)
          (v.state.consolidationBalanceToConsume target)

end Apriori.Internal
end
end EthLib.Consensus.DirectSafety
end

section
namespace EthLib.Consensus.DirectSafety
open Apriori
open Base Classical Cryptography.Bls Uint64
variable {preset : Preset} {config : Config} {checks : SignatureChecks}
noncomputable section
namespace Apriori.Internal

/-- A registry step keeps the slot and the registry size.

It keeps each validator's key, effective balance and credentials, and unslashes nobody.

It only assigns exits that were at the far future, and keeps activity up to the current epoch.

It keeps each withdrawable epoch, or moves one after the current epoch to another after it.

It keeps the order of exits and withdrawals. -/
private def RegistryStep {fork : Fork} (s t : BeaconState preset fork) : Prop :=
  RegistryEntriesKept s t ∧
    (∀ (i : Nat) (w₀ w : Validator), s.validators.data[i]? = some w₀ →
      t.validators.data[i]? = some w →
      w.withdrawableEpoch = w₀.withdrawableEpoch ∨
        (getCurrentEpoch s < w₀.withdrawableEpoch ∧ getCurrentEpoch s < w.withdrawableEpoch)) ∧
    (∀ (i : Nat) (w₀ w : Validator), s.validators.data[i]? = some w₀ →
      t.validators.data[i]? = some w → ∀ e ≤ getCurrentEpoch s,
        isActiveValidator w e = isActiveValidator w₀ e) ∧
    t.slot = s.slot ∧ RegistryLifecycle s t ∧
    t.validators.data.size = s.validators.data.size ∧ ExitsOrdered t

private theorem RegistryStep.of_validators {fork : Fork} {s t : BeaconState preset fork}
    (validators : t.validators.data = s.validators.data) (slot : t.slot = s.slot)
    (ordered : ExitsOrdered s) : RegistryStep s t := by
  refine ⟨?_, ?_, ?_, slot, ⟨by rw [validators], fun i v found =>
    ⟨v, by rw [validators]; exact found, .refl v⟩⟩, by rw [validators], ?_⟩
  · intro i w found
    rw [validators] at found
    exact ⟨w, found, rfl, rfl, rfl, id, .refl w⟩
  · intro i w₀ w read found
    rw [validators, read] at found
    cases found
    exact .inl rfl
  · intro i w₀ w read found _ _
    rw [validators, read] at found
    cases found
    rfl
  · intro v member
    rw [validators] at member
    exact ordered v member

private theorem RegistryStep.refl {fork : Fork} {s : BeaconState preset fork}
    (ordered : ExitsOrdered s) : RegistryStep s s :=
  .of_validators rfl rfl ordered

private theorem RegistryStep.trans {fork : Fork} {s u t : BeaconState preset fork}
    (one : RegistryStep s u) (two : RegistryStep u t) : RegistryStep s t := by
  obtain ⟨kept₁, withdrawable₁, activity₁, slot₁, life₁, size₁, _⟩ := one
  obtain ⟨kept₂, withdrawable₂, activity₂, slot₂, life₂, size₂, ordered₂⟩ := two
  have epoch : getCurrentEpoch u = getCurrentEpoch s := by simp only [getCurrentEpoch, slot₁]
  -- The validator at an index of `t` is read in `u`, then in `s`.
  have middle : ∀ (i : Nat) (w : Validator), t.validators.data[i]? = some w →
      ∃ w₁, u.validators.data[i]? = some w₁ := fun i w found => by
    obtain ⟨w₁, read, _⟩ := kept₂ i w found
    exact ⟨w₁, read⟩
  refine ⟨?_, ?_, ?_, slot₂.trans slot₁, life₁.trans life₂, size₂.trans size₁, ordered₂⟩
  · intro i w found
    obtain ⟨w₁, read₁, key₂, effective₂, credentials₂, clean₂, kept₂'⟩ := kept₂ i w found
    obtain ⟨w₀, read₀, key₁, effective₁, credentials₁, clean₁, kept₁'⟩ := kept₁ i w₁ read₁
    exact ⟨w₀, read₀, key₂.trans key₁, effective₂.trans effective₁,
      credentials₂.trans credentials₁, clean₁ ∘ clean₂, kept₁'.trans kept₂'⟩
  · intro i w₀ w read₀ found
    obtain ⟨w₁, read₁⟩ := middle i w found
    rw [epoch] at withdrawable₂
    rcases withdrawable₁ i w₀ w₁ read₀ read₁ with same₁ | ⟨old₁, new₁⟩ <;>
      rcases withdrawable₂ i w₁ w read₁ found with same₂ | ⟨old₂, new₂⟩
    · exact .inl (same₂.trans same₁)
    · exact .inr ⟨same₁ ▸ old₂, new₂⟩
    · exact .inr ⟨old₁, same₂ ▸ new₁⟩
    · exact .inr ⟨old₁, new₂⟩
  · intro i w₀ w read₀ found e early
    obtain ⟨w₁, read₁⟩ := middle i w found
    rw [activity₂ i w₁ w read₁ found e (epoch ▸ early), activity₁ i w₀ w₁ read₀ read₁ e early]

/-- Replacing one validator by a record that keeps the fields of a registry step is one. -/
private theorem RegistryStep.set {fork : Fork} {s t : BeaconState preset fork}
    {index : ValidatorIndex} {v w : Validator}
    (read : s.validators.data[index.toNat]? = some v)
    (set : s.setValidator index w = .ok t)
    (key : w.pubkey = v.pubkey) (effective : w.effectiveBalance = v.effectiveBalance)
    (credentials : withdrawalMaxEffectiveBalance preset fork w =
      withdrawalMaxEffectiveBalance preset fork v)
    (clean : w.slashed = false → v.slashed = false) (life : ValidatorLifecycle v w)
    (withdrawable : w.withdrawableEpoch = v.withdrawableEpoch ∨
      (getCurrentEpoch s < v.withdrawableEpoch ∧ getCurrentEpoch s < w.withdrawableEpoch))
    (activity : ∀ e ≤ getCurrentEpoch s, isActiveValidator w e = isActiveValidator v e)
    (orderedW : w.exitEpoch ≤ w.withdrawableEpoch) (ordered : ExitsOrdered s) :
    RegistryStep s t := by
  obtain ⟨inside, rfl⟩ := setValidator_ok set
  have lookup : ∀ (j : Nat) (u : Validator),
      (s.putValidator index.toNat inside w).validators.data[j]? = some u →
      (j = index.toNat ∧ u = w) ∨ (j ≠ index.toNat ∧ s.validators.data[j]? = some u) := by
    intro j u found
    simp only [BeaconState.putValidator, Serialization.Ssz.RootedForkList.data_set] at found
    by_cases same : index.toNat = j
    · subst same
      rw [Array.getElem?_set_self] at found
      exact .inl ⟨rfl, (Option.some.inj found).symm⟩
    · rw [Array.getElem?_set_ne _ same] at found
      exact .inr ⟨Ne.symm same, found⟩
  have size : (s.putValidator index.toNat inside w).validators.data.size =
      s.validators.data.size := by
    simp [BeaconState.putValidator, Serialization.Ssz.RootedForkList.data_set]
  refine ⟨?_, ?_, ?_, rfl, ⟨by rw [size], fun j u before => ?_⟩, size, ?_⟩
  · intro j u found
    rcases lookup j u found with ⟨rfl, rfl⟩ | ⟨_, before⟩
    · exact ⟨v, read, key, effective, credentials, clean, life⟩
    · exact ⟨u, before, rfl, rfl, rfl, id, .refl u⟩
  · intro j u₀ u before found
    rcases lookup j u found with ⟨rfl, rfl⟩ | ⟨_, same⟩
    · obtain rfl := Option.some.inj (before.symm.trans read)
      exact withdrawable
    · rw [Option.some.inj (same.symm.trans before)]
      exact .inl rfl
  · intro j u₀ u before found e early
    rcases lookup j u found with ⟨rfl, rfl⟩ | ⟨_, same⟩
    · obtain rfl := Option.some.inj (before.symm.trans read)
      exact activity e early
    · rw [Option.some.inj (same.symm.trans before)]
  · by_cases same : j = index.toNat
    · subst same
      obtain rfl := Option.some.inj (before.symm.trans read)
      exact ⟨w, by simp [BeaconState.putValidator, Serialization.Ssz.RootedForkList.data_set,
        inside], life⟩
    · refine ⟨u, ?_, .refl u⟩
      simp only [BeaconState.putValidator, Serialization.Ssz.RootedForkList.data_set]
      rw [Array.getElem?_set_ne _ (Ne.symm same)]
      exact before
  · exact ExitsOrdered.putValidator inside ordered orderedW

/-- A quiet step is a registry step that records no balance event.

It keeps the balances, the queue and the consolidation churn.

It also keeps the assigned exits of slashed validators. -/
private def QuietStep {fork : Fork} (electra : .pectra ≤ fork) (s t : BeaconState preset fork) :
    Prop :=
  RegistryStep s t ∧ t.balances = s.balances ∧
    t.pendingConsolidations = s.pendingConsolidations ∧
    t.earliestConsolidationEpoch electra = s.earliestConsolidationEpoch electra ∧
    t.consolidationBalanceToConsume electra = s.consolidationBalanceToConsume electra ∧
    (SlashedExitAssigned s → SlashedExitAssigned t)

private theorem QuietStep.refl {fork : Fork} {electra : .pectra ≤ fork}
    {s : BeaconState preset fork} (ordered : ExitsOrdered s) : QuietStep electra s s :=
  ⟨.refl ordered, rfl, rfl, rfl, rfl, id⟩

private theorem QuietStep.trans {fork : Fork} {electra : .pectra ≤ fork}
    {s u t : BeaconState preset fork}
    (one : QuietStep electra s u) (two : QuietStep electra u t) : QuietStep electra s t :=
  ⟨one.1.trans two.1, two.2.1.trans one.2.1, two.2.2.1.trans one.2.2.1,
    two.2.2.2.1.trans one.2.2.2.1, two.2.2.2.2.1.trans one.2.2.2.2.1,
    two.2.2.2.2.2 ∘ one.2.2.2.2.2⟩

/-- Initiating an exit is quiet. -/
private theorem QuietStep.initiateValidatorExit {fork : Fork} {electra : .pectra ≤ fork}
    {s t : BeaconState preset fork} {index : ValidatorIndex}
    (ok : initiateValidatorExit config s index = .ok t)
    (delay : 0 < config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    (ordered : ExitsOrdered s) (finite : getCurrentEpoch s < FAR_FUTURE_EPOCH) :
    QuietStep electra s t := by
  have held := initiateValidatorExit_slashed_exit_assigned ok delay
  obtain ⟨v, found, ⟨_, rfl⟩ | ⟨far, queued, exitEpoch, withdrawableEpoch, queue, summed, set⟩⟩ :=
    initiateValidatorExit_ok ok
  · exact .refl ordered
  · have later := exitQueue_lt queue
    have sum := (addChecked_ok_iff.mp summed).2
    obtain ⟨left, earliest, shape⟩ := exitQueue_eq queue
    have data : queued.validators.data = s.validators.data := by rw [shape]
    have read : s.validators.data[index.toNat]? = some v := getValidator_eq_ok_iff.mp found
    have readQ : queued.validators.data[index.toNat]? = some v := by rw [data]; exact read
    have foundQ : getValidator queued index = .ok v := getValidator_eq_ok_iff.mpr readQ
    have late : getCurrentEpoch s < exitEpoch := UInt64.lt_iff_toNat_lt.mpr (by omega)
    have delayed : exitEpoch ≤ withdrawableEpoch := UInt64.le_iff_toNat_le.mpr (by omega)
    have epochQ : getCurrentEpoch queued = getCurrentEpoch s := by rw [shape]; rfl
    -- The old withdrawable epoch was at the far future, after the current epoch.
    have oldLate : getCurrentEpoch s < v.withdrawableEpoch := by
      have order := ordered v (Array.mem_of_getElem? read)
      rw [far] at order
      rw [UInt64.le_antisymm (le_far _) order]
      exact finite
    have first : RegistryStep s queued := .of_validators data (by rw [shape]) ordered
    have second : RegistryStep queued t := RegistryStep.set readQ set
      rfl rfl rfl id ⟨fun _ => rfl, fun unset => absurd far unset⟩
      (.inr ⟨epochQ ▸ oldLate, epochQ ▸ UInt64.lt_of_lt_of_le late delayed⟩)
      (fun e early => by
        have one : e < exitEpoch := UInt64.lt_of_le_of_lt (epochQ ▸ early) late
        have two : e < FAR_FUTURE_EPOCH := UInt64.lt_of_le_of_lt (epochQ ▸ early) finite
        simp only [isActiveValidator, far, one, two])
      delayed first.2.2.2.2.2.2
    obtain ⟨_, rfl⟩ := setValidator_ok set
    subst shape
    exact ⟨first.trans second, rfl, rfl, rfl, rfl, held⟩

/-- A voluntary exit is quiet. -/
private theorem QuietStep.voluntaryExit {fork : Fork} {electra : .pectra ≤ fork}
    {s t : BeaconState preset fork} {signed : SignedVoluntaryExit}
    (ok : processVoluntaryExit config checks s signed = .ok t)
    (delay : 0 < config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    (ordered : ExitsOrdered s) (finite : getCurrentEpoch s < FAR_FUTURE_EPOCH) :
    QuietStep electra s t := by
  unfold processVoluntaryExit at ok
  simp only [bind_ok_iff, ensure_ok_iff, liftAccessor_ok, liftSsz_ok] at ok
  obtain ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, exited⟩ := ok
  exact .initiateValidatorExit exited delay ordered finite

/-- A withdrawal request is quiet. -/
private theorem QuietStep.withdrawalRequest {fork : Fork} {electra : .pectra ≤ fork}
    {s t : BeaconState preset fork} {request : WithdrawalRequest}
    (ok : processWithdrawalRequest config s electra request = .ok t)
    (delay : 0 < config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    (ordered : ExitsOrdered s) (finite : getCurrentEpoch s < FAR_FUTURE_EPOCH) :
    QuietStep electra s t := by
  rcases withdrawalRequest_cases ok with rfl | ⟨index, exited⟩ | ⟨index, v, owed, paid⟩
  · exact .refl ordered
  · exact .initiateValidatorExit exited delay ordered finite
  · simp only [requestPartialWithdrawal, bind_ok_iff, liftAccessor_ok, pure,
      Except.pure] at paid
    obtain ⟨_, _, _, _, paid⟩ := paid
    split at paid
    · simp only [bind_ok_iff, liftAccessor_ok, Except.ok.injEq] at paid
      obtain ⟨⟨_, _⟩, churned, _, _, _, _, rfl⟩ := paid
      simp only [computeExitEpochAndUpdateChurn, bind_ok_iff, pure, Except.pure,
        Except.ok.injEq] at churned
      obtain ⟨_, _, _, _, _, _, final⟩ := churned
      cases final
      exact ⟨.of_validators rfl rfl ordered, rfl, rfl, rfl, rfl, id⟩
    · cases paid
      exact .refl ordered

/-- A fold of steps, each of which keeps a property at the same current epoch, keeps it. -/
private theorem foldlM_step {α : Type} {fork : Fork}
    (P : BeaconState preset fork → BeaconState preset fork → Prop)
    (refl : ∀ s, ExitsOrdered s → P s s)
    (trans : ∀ {s u t}, P s u → P u t → P s t)
    (ordered' : ∀ {s t}, P s t → ExitsOrdered t)
    (slot : ∀ {s t}, P s t → t.slot = s.slot)
    (action : BeaconState preset fork → α → Except TransitionError (BeaconState preset fork))
    (step : ∀ item a b, action a item = .ok b → ExitsOrdered a →
      getCurrentEpoch a < FAR_FUTURE_EPOCH → P a b)
    (items : List α) {s t : BeaconState preset fork}
    (ok : items.foldlM action s = .ok t)
    (ordered : ExitsOrdered s) (finite : getCurrentEpoch s < FAR_FUTURE_EPOCH) : P s t :=
  (foldlM_ok_invariant (fun u => P s u ∧ getCurrentEpoch u < FAR_FUTURE_EPOCH)
    (fun u item v ⟨held, bounded⟩ computed => by
      have one := step item u v computed (ordered' held) bounded
      have epoch : getCurrentEpoch v = getCurrentEpoch u := by
        simp only [getCurrentEpoch, slot one]
      exact ⟨trans held one, epoch ▸ bounded⟩)
    ⟨refl s ordered, finite⟩ ok).1

/-- A registry step keeps the reserve cut at the current epoch.

The cut after it is read in the state with its validators and the balances before it. -/
private theorem reserveCut_of_registryStep {x : ForkedBeaconState preset} {high : Nat}
    {fork : Fork} {s t : BeaconState preset fork} {suffix : List PendingConsolidation}
    {o : Ownership}
    (registry : RegistryStep s t) (retired : RetiredActivated s o.retired)
    (life : RegistryLifecycle x.state s) (started : getCurrentEpoch x.state ≤ getCurrentEpoch s)
    (finite : getCurrentEpoch s < FAR_FUTURE_EPOCH)
    (reserve : ReserveCut x high ⟨fork, s⟩ (getCurrentEpoch s) suffix o) :
    ReserveCut x high ⟨fork, { s with validators := t.validators }⟩ (getCurrentEpoch s) suffix o :=
  reserveCut_of_kept (v := { s with validators := t.validators }) retired.assigned
    (lifecycle_start_active_assigned (u := ⟨fork, s⟩) life (UInt64.lt_of_le_of_lt started finite))
    registry.2.2.1 registry.1 registry.2.1 rfl reserve

/-- A quiet step along a frame path is an operation that records nothing. -/
private theorem operationReplay_quiet {x : ForkedBeaconState preset} {high : Nat}
    {rounding : Nat → Nat} {fork : Fork} {electra : .pectra ≤ fork}
    {s t : BeaconState preset fork}
    (path : FramePath (config := config) (checks := checks) ⟨fork, s⟩ ⟨fork, t⟩)
    (quiet : ExitsOrdered s → getCurrentEpoch s < FAR_FUTURE_EPOCH → QuietStep electra s t) :
    OperationReplay (config := config) (checks := checks) x high rounding electra s t [] [] := by
  intro queue owned eventPosition paymentPosition callPosition reserve assignment erasure _
    retired cover future _ ordered life started finite slashedExit fresh
  obtain ⟨registry, balances, sameQueue, earliest, left, slashed⟩ := quiet ordered finite
  obtain ⟨kept, _, _, slot, step, _, _⟩ := id registry
  have epoch : getCurrentEpoch t = getCurrentEpoch s := by simp only [getCurrentEpoch, slot]
  have pending : pendingQueue (⟨fork, t⟩ : ForkedBeaconState preset) = pendingQueue ⟨fork, s⟩ := by
    simp only [pendingQueue, sameQueue]
  have reserveT : ReserveCut x high ⟨fork, t⟩ (getCurrentEpoch t) (queue.map (·.entry)) owned := by
    rw [epoch]
    exact reserveCut_of_kept retired.assigned
      (lifecycle_start_active_assigned (u := ⟨fork, s⟩) life
        (UInt64.lt_of_le_of_lt started finite))
      registry.2.2.1 kept registry.2.1 balances reserve
  have frame : ReservedFrame (config := config) (checks := checks) x high rounding
      ⟨fork, s⟩ ⟨fork, t⟩ (getCurrentEpoch s) (getCurrentEpoch t) queue owned owned :=
    ⟨path, epoch ▸ UInt64.le_refl _,
      (reservedFrame_refl (config := config) (checks := checks) reserve assignment
        erasure).2.2.1,
      assignment, assignment, erasure, pending ▸ erasure, reserve, reserveT⟩
  refine ⟨queue, [], owned, .nil frame, reserveT, assignment, pending ▸ erasure,
    retired.lifecycle step, endpointCover_of_kept kept balances epoch cover,
    futureCover_of_kept kept epoch future, slashed slashedExit, ?_,
    by rw [earliest, left]; exact .nil _ _, by simp [ConsolidationCallSites]⟩
  intro tag member n tagged
  obtain ⟨v, read, exit, assigned⟩ := fresh tag member n tagged
  obtain ⟨w, located, kept'⟩ := step.validators _ v read
  exact ⟨w, located, (kept'.exitEpoch assigned) ▸ exit, (kept'.exitEpoch assigned) ▸ assigned⟩

/-- The voluntary exits of a block record nothing. -/
private theorem reservedReplay_voluntaryExits :
    VoluntaryExitsReplay (preset := preset) (config := config) (checks := checks) :=
  fun _ _ _ _ electra _ delay _ _ exits ok =>
  operationReplay_quiet (foldlM_framePath _ exits ok fun _ _ _ _ eq => .exit eq)
    (foldlM_step (QuietStep electra) (fun _ => .refl) .trans (·.1.2.2.2.2.2.2) (·.1.2.2.2.1) _
      (fun _ _ _ step => QuietStep.voluntaryExit step delay) exits ok)

/-- The withdrawal requests of a block record nothing. -/
private theorem reservedReplay_withdrawalRequests :
    WithdrawalRequestsReplay (preset := preset) (config := config) (checks := checks) :=
  fun _ _ _ _ electra _ delay _ _ requests ok =>
  operationReplay_quiet
    (foldlM_framePath _ requests ok fun _ _ _ _ eq => .withdrawalRequest electra eq)
    (foldlM_step (QuietStep electra) (fun _ => .refl) .trans (·.1.2.2.2.2.2.2) (·.1.2.2.2.1) _
      (fun _ _ _ step => QuietStep.withdrawalRequest step delay) requests ok)

/-- A slashing step is a registry step that keeps the queue and the consolidation churn.

It also keeps the balance count. -/
private def SlashStep {fork : Fork} (electra : .pectra ≤ fork) (s t : BeaconState preset fork) :
    Prop :=
  RegistryStep s t ∧ t.pendingConsolidations = s.pendingConsolidations ∧
    t.earliestConsolidationEpoch electra = s.earliestConsolidationEpoch electra ∧
    t.consolidationBalanceToConsume electra = s.consolidationBalanceToConsume electra ∧
    t.balances.data.size = s.balances.data.size

private theorem SlashStep.refl {fork : Fork} {electra : .pectra ≤ fork}
    {s : BeaconState preset fork} (ordered : ExitsOrdered s) : SlashStep electra s s :=
  ⟨.refl ordered, rfl, rfl, rfl, rfl⟩

private theorem SlashStep.trans {fork : Fork} {electra : .pectra ≤ fork}
    {s u t : BeaconState preset fork}
    (one : SlashStep electra s u) (two : SlashStep electra u t) : SlashStep electra s t :=
  ⟨one.1.trans two.1, two.2.1.trans one.2.1, two.2.2.1.trans one.2.2.1,
    two.2.2.2.1.trans one.2.2.2.1, two.2.2.2.2.trans one.2.2.2.2⟩

/-- Setting one balance keeps every field of a slashing step. -/
private theorem SlashStep.setBalance {fork : Fork} {electra : .pectra ≤ fork}
    {s t : BeaconState preset fork} {index : ValidatorIndex} {balance : Gwei}
    (set : s.setBalance index balance = .ok t) (ordered : ExitsOrdered s) :
    SlashStep electra s t := by
  have sizes := (sameSizes_setBalance set).2
  obtain ⟨_, rfl⟩ := setBalance_ok set
  exact ⟨.of_validators rfl rfl ordered, rfl, rfl, rfl, sizes⟩

/-- Slashing a validator that is slashable at the current epoch is a slashing step.

Its exit is assigned, or set after the current epoch.

Its withdrawable epoch is after the current epoch by slashability, and only grows. -/
private theorem SlashStep.slashValidator {fork : Fork} {electra : .pectra ≤ fork}
    {s t : BeaconState preset fork} {index : ValidatorIndex} {v : Validator}
    (early : fork < .glamsterdam)
    (ok : slashValidator config s index none = .ok t)
    (delay : 0 < config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    (found : getValidator s index = .ok v)
    (slashable : isSlashableValidator v (getCurrentEpoch s) = true)
    (ordered : ExitsOrdered s) (finite : getCurrentEpoch s < FAR_FUTURE_EPOCH) :
    SlashStep electra s t := by
  obtain ⟨exited, validator, withdrawable, marked, _, _, slashings, lowered, _, _, raised, last,
    exitedOk, foundE, _, markedOk, _, _, _, loweredOk, _, _, raisedOk, lastOk, done⟩ :=
    slashValidator_ok ok
  have quiet := QuietStep.initiateValidatorExit (electra := electra) exitedOk delay ordered finite
  have read : s.validators.data[index.toNat]? = some v := getValidator_eq_ok_iff.mp found
  have readE : exited.validators.data[index.toNat]? = some validator :=
    getValidator_eq_ok_iff.mp foundE
  have epochE : getCurrentEpoch exited = getCurrentEpoch s := by
    simp only [getCurrentEpoch, quiet.1.2.2.2.1]
  -- After the exit the withdrawable epoch is still after the current epoch.
  have slashableLate : getCurrentEpoch s < v.withdrawableEpoch := by
    simp only [isSlashableValidator, Bool.and_eq_true, decide_eq_true_eq] at slashable
    exact slashable.2
  have oldLate : getCurrentEpoch exited < validator.withdrawableEpoch := by
    rw [epochE]
    rcases quiet.1.2.1 _ v validator read readE with same | ⟨_, late⟩
    · exact same ▸ slashableLate
    · exact late
  have grows : validator.withdrawableEpoch ≤ max validator.withdrawableEpoch withdrawable := by
    rw [UInt64.max_def]
    split
    · assumption
    · exact UInt64.le_refl _
  have orderedE := quiet.1.2.2.2.2.2.2
  have mark : SlashStep electra exited marked := by
    have registry := RegistryStep.set readE markedOk rfl rfl rfl (fun flag => by simp at flag)
      ⟨fun _ => rfl, fun _ => rfl⟩ (.inr ⟨oldLate, UInt64.lt_of_lt_of_le oldLate grows⟩)
      (fun _ _ => rfl)
      (UInt64.le_trans (orderedE validator (Array.mem_of_getElem? readE)) grows) orderedE
    have sizes := (sameSizes_setValidator markedOk).2
    obtain ⟨_, rfl⟩ := setValidator_ok markedOk
    exact ⟨registry, rfl, rfl, rfl, sizes⟩
  have orderedM := mark.1.2.2.2.2.2.2
  obtain ⟨_, loweredSet⟩ := decreaseBalance_ok loweredOk
  obtain ⟨_, raisedSet⟩ := increaseBalance_ok raisedOk
  obtain ⟨_, lastSet⟩ := increaseBalance_ok lastOk
  have slashed : SlashStep electra marked { marked with slashings } :=
    ⟨.of_validators rfl rfl orderedM, rfl, rfl, rfl, rfl⟩
  have lower : SlashStep electra { marked with slashings } lowered :=
    .setBalance loweredSet orderedM
  have raise : SlashStep electra lowered raised := .setBalance raisedSet lower.1.2.2.2.2.2.2
  have pay : SlashStep electra raised last := .setBalance lastSet raise.1.2.2.2.2.2.2
  have final : t = last := by
    rw [done]
    split
    · rename_i gloas
      exact absurd gloas (Nat.not_le_of_gt early)
    · rfl
  subst final
  exact (SlashStep.trans ⟨quiet.1, quiet.2.2.1, quiet.2.2.2.1, quiet.2.2.2.2.1,
    by rw [quiet.2.1]⟩ mark).trans (slashed.trans (lower.trans (raise.trans pay)))

/-- Take a slashing that records one slashings event, at most its credit limit.

Let its registry part be a slashing step.

Then it is an operation that records that event. -/
private theorem operationReplay_slashing {x : ForkedBeaconState preset} {high : Nat}
    {rounding : Nat → Nat} {fork : Fork} {electra : .pectra ≤ fork}
    {s t : BeaconState preset fork} {credit debit : Nat}
    (step : ExitsOrdered s → getCurrentEpoch s < FAR_FUTURE_EPOCH → SlashStep electra s t)
    (bounded : balanceCredits s t ≤ credit)
    (slashedExit : SlashedExitAssigned s → SlashedExitAssigned t) :
    OperationReplay (config := config) (checks := checks) x high rounding electra s t
      [⟨.slashings, ⟨fork, s⟩, ⟨fork, t⟩, credit, debit⟩] [] := by
  intro queue owned eventPosition paymentPosition callPosition reserve assignment erasure prior
    retired cover future matched ordered life started finite held fresh
  obtain ⟨registry, sameQueue, earliest, left, balanceSize⟩ := step ordered finite
  obtain ⟨kept, _, _, slot, lifecycle, size, _⟩ := id registry
  have epoch : getCurrentEpoch t = getCurrentEpoch s := by simp only [getCurrentEpoch, slot]
  have pending : pendingQueue (⟨fork, t⟩ : ForkedBeaconState preset) = pendingQueue ⟨fork, s⟩ := by
    simp only [pendingQueue, sameQueue]
  -- The registry part is read first.
  --
  -- It is read in the state with the validators after and the balances before.
  --
  -- The balance part is then a credit event with the same registry.
  let m : BeaconState preset fork := { s with validators := t.validators }
  let e : BalanceEvent preset := ⟨.slashings, ⟨fork, s⟩, ⟨fork, t⟩, credit, debit⟩
  let e' : BalanceEvent preset := ⟨.slashings, ⟨fork, m⟩, ⟨fork, t⟩, credit, debit⟩
  have notDeposit : BalanceSource.slashings ≠ .deposits := by decide
  have notTransfer : BalanceSource.slashings ≠ .consolidations := by decide
  have epochM : getCurrentEpoch t = getCurrentEpoch m := epoch
  have matchedT : t.validators.data.size = t.balances.data.size := by
    have : s.balances.data.size = s.validators.data.size := matched
    omega
  have matchedM : BalancesMatch m := by
    change s.balances.data.size = t.validators.data.size
    have : s.balances.data.size = s.validators.data.size := matched
    omega
  have frame := reservedFrame_refl (config := config) (checks := checks) reserve assignment erasure
  have fresh' := (prior.frame frame.2.2.1).credit_fresh (Nat.le_refl eventPosition)
  have credit : OwnedCredit eventPosition e owned (creditOwnership eventPosition e owned) :=
    ownedCredit_of_bounded reserve.1 fresh' electra notTransfer matchedT bounded
  have credit' : OwnedCredit eventPosition e' owned (creditOwnership eventPosition e' owned) :=
    ownedCredit_of_bounded reserve.1 fresh' electra notTransfer matchedT bounded
  have tokens : creditOwnership eventPosition e' owned = creditOwnership eventPosition e owned := by
    have units : ∀ i, eventCreditUnits e' i = eventCreditUnits e i := fun i => by
      simp only [eventCreditUnits, e, e', notDeposit, false_and, ↓reduceIte]
      rfl
    simp only [creditOwnership, eventCreditTokens, units]
    rfl
  have reserveM : ReserveCut x high ⟨fork, m⟩ (getCurrentEpoch s) (queue.map (·.entry)) owned :=
    reserveCut_of_registryStep registry retired life started finite reserve
  have reserveT : ReserveCut x high ⟨fork, t⟩ (getCurrentEpoch t) (queue.map (·.entry))
      (creditOwnership eventPosition e owned) := by
    rw [epoch, ← tokens]
    exact reserveCut_credit_non_deposit (e := e') notDeposit rfl rfl matchedT fresh' credit'
      reserveM
  have event : ReservedEvent x high eventPosition paymentPosition rounding e queue queue [] []
      owned (creditOwnership eventPosition e owned) := by
    refine ⟨?_, assignment, assignment, ?_⟩
    · unfold OwnedEvent
      simp only [e, notTransfer, ↓reduceIte]
      exact ⟨trivial, trivial, .inl credit⟩
    · simp only [e, notTransfer, ↓reduceIte]
      exact ⟨reserve, reserveT⟩
  have tagged : TagEvent (config := config) e callPosition queue queue [] [] [] :=
    ⟨erasure, pending ▸ erasure, Or.inl ⟨notTransfer, rfl, rfl, rfl, rfl⟩⟩
  have coverM : EndpointCoverAll x ⟨fork, m⟩ owned := endpointCover_of_kept kept rfl rfl cover
  have futureM : FutureEffectiveCover x ⟨fork, m⟩ owned := futureCover_of_kept kept rfl future
  have coverT : EndpointCoverAll x ⟨fork, t⟩ (creditOwnership eventPosition e owned) := by
    rw [← tokens]
    exact endpointCover_nonDeposit (e := e') notDeposit rfl rfl epochM matchedM fresh' credit'
      coverM
  have futureT : FutureEffectiveCover x ⟨fork, t⟩ (creditOwnership eventPosition e owned) := by
    rw [← tokens]
    refine futureCover_credit (e := e') ⟨#[], by simp only [Array.append_empty]; rfl⟩ epochM
      matchedM ?_ fresh' credit'
      futureM
    intro j w outside read
    have inside := (Array.getElem?_eq_some_iff.mp read).1
    have before : e'.before.state.validators.data.size = t.validators.data.size := rfl
    have after : e'.after.state.validators.data.size = t.validators.data.size := rfl
    omega
  refine ⟨queue, [], creditOwnership eventPosition e owned,
    ReservedReplay.singleton_nonconsolidation notTransfer frame tagged event, reserveT,
    assignment, pending ▸ erasure, retired.lifecycle lifecycle, coverT, futureT,
    slashedExit held, ?_, by rw [earliest, left]; exact .nil _ _,
    by simp [ConsolidationCallSites]⟩
  intro tag member n fresh''
  obtain ⟨v, read, exit, assigned⟩ := fresh tag member n fresh''
  obtain ⟨w, located, kept'⟩ := lifecycle.validators _ v read
  exact ⟨w, located, (kept'.exitEpoch assigned) ▸ exit, (kept'.exitEpoch assigned) ▸ assigned⟩

/-- A proposer slashing records one slashings event with its limits read at `s`. -/
private theorem reservedReplay_proposerSlashing :
    ProposerSlashingReplay (preset := preset) (config := config) (checks := checks) := by
  intro _ _ _ _ _ early delay s _ slashing _ _ limits ok
  obtain ⟨credit', debit', limits', credits, _⟩ := proposer_slashing_bounds slashing ok
  obtain ⟨rfl, rfl⟩ := Prod.mk.inj (Except.ok.inj (limits'.symm.trans limits))
  have held := fun prior : SlashedExitAssigned s =>
    processSlashing_slashed_exit_assigned (.inl ⟨slashing, ok⟩) delay prior
  simp only [processProposerSlashing, bind_ok_iff, ensure_ok_iff, liftAccessor_ok] at ok
  obtain ⟨_, _, _, _, _, _, v, found, _, slashable, _, _, _, _, slashed⟩ := ok
  exact operationReplay_slashing
    (fun ordered finite => .slashValidator early slashed delay found slashable ordered finite)
    credits held

/-- Take the slashings of an attester slashing's indices.

Let each of them slash a slashable validator.

Then they are a slashing step. -/
private theorem SlashStep.foldlM_slashIfSlashable {fork : Fork} {electra : .pectra ≤ fork}
    (early : fork < .glamsterdam) (delay : 0 < config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    (indices : List ValidatorIndex) {s t : BeaconState preset fork} {flag last : Bool}
    (ok : indices.foldlM (slashIfSlashable config) (s, flag) = .ok (t, last))
    (ordered : ExitsOrdered s) (finite : getCurrentEpoch s < FAR_FUTURE_EPOCH) :
    SlashStep electra s t :=
  (foldlM_ok_invariant
    (fun pair : BeaconState preset fork × Bool =>
      SlashStep electra s pair.1 ∧ getCurrentEpoch pair.1 < FAR_FUTURE_EPOCH)
    (fun ⟨u, _⟩ _ ⟨v, _⟩ ⟨held, bounded⟩ one => by
      simp only [slashIfSlashable, bind_ok_iff, liftAccessor_ok] at one
      obtain ⟨w, read, one⟩ := one
      have ordered := held.1.2.2.2.2.2.2
      have step : SlashStep electra u v := by
        split at one
        · rename_i slashable
          simp only [bind_ok_iff, liftAccessor_ok, pure, Except.pure,
            Except.ok.injEq, Prod.mk.injEq] at one
          obtain ⟨u', slashed, rfl, rfl⟩ := one
          exact .slashValidator early slashed delay read slashable ordered bounded
        · simp only [pure, Except.pure, Except.ok.injEq, Prod.mk.injEq] at one
          obtain ⟨rfl, rfl⟩ := one
          exact .refl ordered
      have epoch : getCurrentEpoch v = getCurrentEpoch u := by
        simp only [getCurrentEpoch, step.1.2.2.2.1]
      exact ⟨held.trans step, epoch ▸ bounded⟩)
    (b := (s, flag)) ⟨.refl ordered, finite⟩ ok).1

/-- An attester slashing records one slashings event with its limits read at `s`. -/
private theorem reservedReplay_attesterSlashing :
    AttesterSlashingReplay (preset := preset) (config := config) (checks := checks) := by
  intro _ _ _ _ _ early delay s _ slashing _ _ limits ok
  obtain ⟨credit', debit', limits', credits, _⟩ := attester_slashing_bounds slashing ok
  obtain ⟨rfl, rfl⟩ := Prod.mk.inj (Except.ok.inj (limits'.symm.trans limits))
  have held := fun prior : SlashedExitAssigned s =>
    processSlashing_slashed_exit_assigned (.inr ⟨slashing, ok⟩) delay prior
  simp only [processAttesterSlashing, bind_ok_iff, ensure_ok_iff, pure, Except.pure,
    Except.ok.injEq] at ok
  obtain ⟨_, _, _, _, _, _, _, _, _, _, ⟨u, flag⟩, folded, _, _, rfl⟩ := ok
  exact operationReplay_slashing
    (fun ordered finite => .foldlM_slashIfSlashable early delay _ folded ordered finite) credits held

end Apriori.Internal
end
end EthLib.Consensus.DirectSafety
end


section
namespace EthLib.Consensus.DirectSafety
open Apriori
open Base Classical Cryptography.Bls
variable {preset : Preset} {config : Config} {checks : SignatureChecks}
noncomputable section
namespace Apriori.Internal

/-! ## Lowering the original baseline -/

/-- The paid reserve split `P = max(e, b) = R + C` keeps `R` nonincreasing.

Here `R' = min(R, P')`, with `P'` read at `u`.

Only `original` changes. -/
private def lowerOriginal (o : Ownership) (u : ForkedBeaconState preset) : Ownership :=
  { o with original := fun i => min (o.original i) (max (effectiveAt u i) (actualBalanceAt u i)) }

/-- The lowering mints, moves, retires and endpoints nothing, and only decreases `original`. -/
private theorem lowerOriginal_frame (o : Ownership) (u : ForkedBeaconState preset) :
    (lowerOriginal o u).issued = o.issued ∧ (lowerOriginal o u).owner = o.owner ∧
    (lowerOriginal o u).endpoint = o.endpoint ∧ (lowerOriginal o u).retired = o.retired ∧
    (∀ i, (lowerOriginal o u).original i ≤ o.original i) ∧
    (OwnershipValid o → OwnedFrame o (lowerOriginal o u)) :=
  ⟨rfl, rfl, rfl, rfl, fun _ => Nat.min_le_left _ _, fun valid =>
    ⟨valid, valid, rfl, fun _ => .inl rfl, Finset.Subset.refl _, rfl,
      fun _ => Nat.min_le_left _ _⟩⟩

/-- Lowering at the cut's own state keeps the cut.

Only the reference clause has `original` on its larger side.

The lowered value is either the old one or the funding value itself.

That funding value is `max (effectiveAt u i) (actualBalanceAt u i)`. -/
private theorem reserveCut_lowerOriginal {x : ForkedBeaconState preset} {high : Nat}
    {u : ForkedBeaconState preset} {demandEpoch : Epoch} {suffix : List PendingConsolidation}
    {o : Ownership} (reserve : ReserveCut x high u demandEpoch suffix o) :
    ReserveCut x high u demandEpoch suffix (lowerOriginal o u) := by
  obtain ⟨valid, wasRetired, original, reference, rest⟩ := reserve
  refine ⟨valid, wasRetired, fun i => ⟨(Nat.min_le_left _ _).trans (original i).1,
    fun notReference => ?_⟩, fun i ref notRetired relevant => ?_, rest⟩
  · show min (o.original i) _ = 0
    rw [(original i).2 notReference, Nat.zero_min]
  · have old := reference i ref notRetired relevant
    show max (effectiveAt u i) (actualBalanceAt u i) ≤
      min (o.original i) (max (effectiveAt u i) (actualBalanceAt u i)) + (held o i).card
    omega

/-- Lowering at a state is a reserved frame from that state to itself. -/
private theorem reservedFrame_lowerOriginal {x u : ForkedBeaconState preset} {high : Nat}
    {rounding : Nat → Nat} {epoch : Epoch} {queue : List TaggedEntry} {owned : Ownership}
    (reserve : ReserveCut x high u epoch (queue.map (·.entry)) owned)
    (assignment : AssignmentCut rounding queue owned)
    (erasure : QueueErasure queue (pendingQueue u)) :
    ReservedFrame (config := config) (checks := checks) x high rounding
      u u epoch epoch queue owned (lowerOriginal owned u) :=
  ⟨.nil, UInt64.le_refl _, (lowerOriginal_frame owned u).2.2.2.2.2 reserve.1, assignment,
    assignmentCut_transport assignment (lowerOriginal_frame owned u).2.2.2.2.1
      (List.Sublist.refl _),
    erasure, erasure, reserve, reserveCut_lowerOriginal reserve⟩

/-- A downward effective-balance update rounds the balance down.

Afterwards the balance is below the new effective balance plus one increment.

The caps rule out the capped branch. -/
private theorem effective_drop_balance_lt {fork : Fork} {s t : BeaconState preset fork}
    (ok : processEffectiveBalanceUpdates s = .ok t)
    (caps : ∀ v ∈ s.validators.data,
      v.effectiveBalance ≤ withdrawalMaxEffectiveBalance preset fork v)
    (increment : 0 < preset.EFFECTIVE_BALANCE_INCREMENT.toNat) (i : Nat)
    (drop : effectiveAt ⟨fork, t⟩ i < effectiveAt ⟨fork, s⟩ i) :
    actualBalanceAt ⟨fork, s⟩ i <
      effectiveAt ⟨fork, t⟩ i + preset.EFFECTIVE_BALANCE_INCREMENT.toNat := by
  cases read : s.balances.data[i]? with
  | none => simp only [actualBalanceAt, read, Option.map_none, Option.getD_none]; omega
  | some b =>
    cases found : s.validators.data[i]? with
    | none => simp [effectiveAt, found] at drop
    | some v =>
      obtain ⟨e, after, updated⟩ :=
        processEffectiveBalanceUpdates_effectiveBalance_eq ok found read
      have cap := UInt64.le_iff_toNat_le.mp (caps v (Array.mem_of_getElem? found))
      simp only [effectiveAt, after, found, Option.map_some, Option.getD_some] at drop ⊢
      simp only [actualBalanceAt, read, Option.map_some, Option.getD_some]
      rcases updatedEffectiveBalance_cases updated with same | rounded
      · subst same
        exact absurd drop (Nat.lt_irrefl _)
      · have r := toNat_rounded (preset := preset) (balance := b)
        have m1 := Nat.mod_lt b.toNat increment
        have m2 := Nat.mod_le b.toNat preset.EFFECTIVE_BALANCE_INCREMENT.toNat
        rw [rounded, UInt64.min_def] at drop ⊢
        by_cases small : b - b % preset.EFFECTIVE_BALANCE_INCREMENT ≤
            withdrawalMaxEffectiveBalance preset fork v
        · rw [ite_eq_left small] at drop ⊢
          rw [r]
          omega
        · rw [ite_eq_right small] at drop
          omega

/-- The epoch suffix after the pending consolidations, before Gloas.

Its payments stage keeps the state.

Its effective-balance update reads the consolidation output.

Its later stages keep the validators and the balances. -/
private theorem epochSuffix_effective {fork : Fork} {consolidated z : BeaconState preset fork}
    (early : fork < .glamsterdam)
    (trace : EpochTrace (EpochStage.action config checks)
      (EpochStage.middleStages ++ EpochStage.tailStages) consolidated z) :
    ∃ after, processEffectiveBalanceUpdates consolidated = .ok after ∧
      z.validators = after.validators ∧ z.balances = consolidated.balances := by
  simp only [EpochStage.middleStages, EpochStage.tailStages, List.cons_append,
    List.nil_append] at trace
  cases trace with | cons paid trace =>
  cases trace with | cons updated rest =>
  have payEdge := EpochStage.action_cases.mp paid
  simp only [EpochStage.Edge] at payEdge
  split at payEdge
  · rename_i late
    exact absurd (Nat.lt_of_le_of_lt late early) (Nat.lt_irrefl _)
  subst payEdge
  have updatedOk : processEffectiveBalanceUpdates _ = .ok _ :=
    EpochStage.action_cases.mp updated
  have late := balanceDrift_late rest
  exact ⟨_, updatedOk, late.1, late.2.trans (processEffectiveBalanceUpdates_balances updatedOk)⟩

/-- `reservedReplay_epochNext`, followed by the lowering at its end state `z`.

Its header is unchanged.

This wrapper appends `reservedFrame_lowerOriginal` at `z` to its replay and to its suffix frame.

The last conjunct is the effective bound read by the carried `OriginalDown`.

Without a drop, the lowered value is at most the old one.

A drop rounds the balance down.

So the lowered value is below the new effective balance plus one increment. -/
private theorem reservedReplay_epochNext_lowered {fork : Fork}
    {s justified scored rewarded registered slashed reset deposited consolidated z :
      BeaconState preset fork}
    {recorded : List (BalanceEvent preset)} {limit : Nat} {next : Epoch}
    (electra : .pectra ≤ fork) (early : fork < .glamsterdam) (matched : BalancesMatch s)
    (justifiedOk : EpochStage.Edge config checks .justification s justified)
    (scoredOk : EpochStage.Edge config checks .inactivity justified scored)
    (rewardsOk : processRewardsAndPenalties config scored = .ok rewarded)
    (replay : replayRewards (config := config) (scored, []) = .ok (rewarded, recorded))
    (registry : processRegistryUpdates config rewarded = .ok registered)
    (slashings : processSlashings registered = .ok slashed)
    (limitOk : delayedSlashingLimit registered = .ok limit)
    (resetOk : EpochStage.Edge config checks .eth1Reset slashed reset)
    (depositsOk : EpochStage.Edge config checks .pendingDeposits reset deposited)
    (consolidationsOk : EpochStage.Edge config checks .pendingConsolidations deposited consolidated)
    (trace : EpochTrace (EpochStage.action config checks)
      (EpochStage.middleStages ++ EpochStage.tailStages) consolidated z)
    (reserve : ReserveCut x high ⟨fork, s⟩ (getCurrentEpoch s) (queue.map (·.entry)) owned)
    (assignment : AssignmentCut rounding queue owned)
    (erasure : QueueErasure queue (pendingQueue ⟨fork, s⟩))
    (prior : OwnershipBefore eventPosition paymentPosition owned)
    (retired : RetiredActivated s owned.retired)
    (startCover : EndpointCoverAll x ⟨fork, s⟩ owned)
    (startFuture : FutureEffectiveCover x ⟨fork, s⟩ owned)
    (startLife : RegistryLifecycle x.state s)
    (startFinite : getCurrentEpoch x.state < FAR_FUTURE_EPOCH)
    (startCurrent : getCurrentEpoch x.state ≤ getCurrentEpoch s)
    (ordered : PendingConsolidationsOrdered config (getCurrentEpoch s).toNat s)
    (exits : ExitsOrdered s) (finite : getCurrentEpoch s < FAR_FUTURE_EPOCH)
    (delayed : ∀ (i : Nat) (v : Validator), s.validators.data[i]? = some v →
      v.exitEpoch ≠ FAR_FUTURE_EPOCH →
        v.exitEpoch.toNat + config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat ≤
          v.withdrawableEpoch.toNat)
    (delayTwo : 2 ≤ config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    (activationOrder : ∀ v ∈ s.validators.data, v.activationEpoch ≤ v.exitEpoch)
    (nextOk : Uint64.addChecked (getCurrentEpoch s) 1 = .ok next)
    (twoSlots : 2 ≤ preset.SLOTS_PER_EPOCH.toNat)
    (caps : ∀ v ∈ s.validators.data,
      v.effectiveBalance ≤ withdrawalMaxEffectiveBalance preset fork v)
    (unique : (queue.map (fun tag => tag.entry.sourceIndex)).Nodup)
    (apart : ∀ tag ∈ queue, tag.entry.sourceIndex ≠ tag.entry.targetIndex)
    (sources : ∀ tag ∈ queue, ∃ w, s.validators.data[tag.entry.sourceIndex.toNat]? = some w ∧
      w.activationEpoch ≠ FAR_FUTURE_EPOCH)
    (initialZero : ∀ tag ∈ queue, ∀ n, tag.tag = .initial n →
      owned.original tag.entry.sourceIndex.toNat = 0)
    (slashedSpan : ∀ (i : Nat) (v w : Validator), x.state.validators.data[i]? = some v →
      deposited.validators.data[i]? = some w → v.slashed = true →
      v.exitEpoch ≠ FAR_FUTURE_EPOCH →
        w.slashed = true ∧ w.exitEpoch ≠ FAR_FUTURE_EPOCH ∧
          v.withdrawableEpoch ≤ w.withdrawableEpoch)
    (horizon : next.toNat ≤ horizonEnd x high)
    (orderedX : PendingConsolidationsOrdered config (getCurrentEpoch x.state).toNat x.state)
    (slashedExit : ∀ (i : Nat) (v : Validator), x.state.validators.data[i]? = some v →
      v.slashed = true → v.exitEpoch ≠ FAR_FUTURE_EPOCH)
    (provenance : ∀ c ∈ queue.map (·.entry), c ∈ pendingQueue x ∨
      (x.state.validators.data[c.sourceIndex.toNat]?).all (·.exitEpoch == FAR_FUTURE_EPOCH)) :
        ∃ u suffix consumed payments allocations final,
          TaggedPass next deposited queue u suffix consumed payments ∧
          consolidated.validators = u.validators ∧ consolidated.balances = u.balances ∧
          ReservedReplay (config := config) (checks := checks) x high rounding
            ⟨fork, s⟩ (getCurrentEpoch s) ⟨fork, z⟩ next eventPosition paymentPosition
            callPosition
            (recorded ++ [⟨.slashings, ⟨fork, registered⟩, ⟨fork, slashed⟩, 0, limit⟩] ++
              if electra : .pectra ≤ fork then
                [⟨.deposits, ⟨fork, reset⟩, ⟨fork, deposited⟩,
                  consumedDeposits reset deposited electra, 0⟩,
                ⟨.consolidations, ⟨fork, deposited⟩, ⟨fork, consolidated⟩,
                  consumedConsolidations deposited consolidated electra,
                  consumedConsolidations deposited consolidated electra⟩]
              else [])
            queue suffix payments allocations [] owned
              (lowerOriginal final ⟨fork, z⟩) ∧
          ReservedFrame (config := config) (checks := checks) x high rounding
            ⟨fork, consolidated⟩ ⟨fork, z⟩ next next suffix final
              (lowerOriginal final ⟨fork, z⟩) ∧
          OwnershipBefore (eventPosition + (recorded.length + 3))
            (paymentPosition + payments.length) (lowerOriginal final ⟨fork, z⟩) ∧
          RetiredActivated z (lowerOriginal final ⟨fork, z⟩).retired ∧
          EndpointCoverAll x ⟨fork, z⟩ (lowerOriginal final ⟨fork, z⟩) ∧
          FutureEffectiveCover x ⟨fork, z⟩ (lowerOriginal final ⟨fork, z⟩) ∧
          (0 < preset.EFFECTIVE_BALANCE_INCREMENT.toNat → ∀ down : Nat → Prop,
            (∀ i, owned.original i ≤ effectiveAt ⟨fork, s⟩ i +
              (if down i then preset.EFFECTIVE_BALANCE_INCREMENT.toNat else 0)) →
            ∀ i, (lowerOriginal final ⟨fork, z⟩).original i ≤ effectiveAt ⟨fork, z⟩ i +
              (if down i ∨ effectiveAt ⟨fork, z⟩ i < effectiveAt ⟨fork, s⟩ i then
                preset.EFFECTIVE_BALANCE_INCREMENT.toNat else 0)) := by
  obtain ⟨u, suffix, consumed, payments, allocations, final, pass, validators, balances, history,
      frame, counted, retiredZ, coverZ, futureZ⟩ :=
    reservedReplay_epochNext (callPosition := callPosition) electra early matched justifiedOk
      scoredOk rewardsOk replay registry slashings limitOk resetOk depositsOk consolidationsOk
      trace reserve assignment erasure prior retired startCover startFuture startLife startFinite
      startCurrent ordered exits finite delayed delayTwo activationOrder nextOk twoSlots caps
      unique apart sources initialZero slashedSpan horizon orderedX slashedExit provenance
  have lower := reservedFrame_lowerOriginal (config := config) (checks := checks)
    frame.2.2.2.2.2.2.2.2 frame.2.2.2.2.1 frame.2.2.2.2.2.2.1
  refine ⟨u, suffix, consumed, payments, allocations, final, pass, validators, balances, ?_,
    frame.trans lower, counted, retiredZ, coverZ, futureZ, ?_⟩
  · simpa only [List.append_nil] using history.append (ReservedReplay.nil lower)
  · intro increment down before i
    -- The prefix keeps effective balances and caps up to the consolidation output.
    have prefixOk : epochBeforePayments config checks s = .ok consolidated := by
      rw [epochBeforePayments_eq_run]
      exact EpochTrace.run_ok_iff.mpr ((EpochTrace.append_iff
        (xs := [.justification, .inactivity, .rewards, .registry, .slashings, .eth1Reset,
          .pendingDeposits]) (ys := [.pendingConsolidations])).mpr
        ⟨deposited, epochDepositTrace justifiedOk scoredOk rewardsOk registry slashings resetOk
          depositsOk, .cons (EpochStage.action_cases.mpr consolidationsOk) .nil⟩)
    have kept := effectiveKept_epochBeforePayments prefixOk
    have capsC := capped_epochBeforePayments prefixOk caps
    obtain ⟨q, updated, zValidators, zBalances⟩ := epochSuffix_effective early trace
    have lowered : final.original i ≤ owned.original i := history.counters_original.2.2.1 i
    have zEffective : effectiveAt ⟨fork, z⟩ i = effectiveAt ⟨fork, q⟩ i := by
      simp only [effectiveAt, zValidators]
    have zBalance : actualBalanceAt ⟨fork, z⟩ i = actualBalanceAt ⟨fork, consolidated⟩ i := by
      simp only [actualBalanceAt, zBalances]
    have prior := before i
    show min (final.original i) (max (effectiveAt ⟨fork, z⟩ i) (actualBalanceAt ⟨fork, z⟩ i)) ≤ _
    by_cases drop : effectiveAt ⟨fork, z⟩ i < effectiveAt ⟨fork, s⟩ i
    · have inside : i < s.validators.data.size := by
        by_contra outside
        have none : s.validators.data[i]? = none :=
          Array.getElem?_eq_none_iff.mpr (Nat.le_of_not_lt outside)
        simp [effectiveAt, none] at drop
      have same := kept i inside
      have dropC : effectiveAt ⟨fork, q⟩ i < effectiveAt ⟨fork, consolidated⟩ i := by omega
      have bound := effective_drop_balance_lt updated capsC increment i dropC
      rw [ite_eq_left (Or.inr drop)]
      omega
    · by_cases flagged : down i
      · rw [ite_eq_left (Or.inl flagged)]
        rw [ite_eq_left flagged] at prior
        omega
      · rw [ite_eq_right (fun h => h.elim flagged drop)]
        rw [ite_eq_right flagged] at prior
        omega

/-! ## The carried bound and `assigned` -/

/-- The carried bound: `original <= eff + (FirstDown ?

EBI : 0)` at the run's end. -/
private def OriginalDown {x y : ForkedBeaconState preset} (tail : Run config checks x y)
    (o : Ownership) : Prop :=
  ∀ i, o.original i ≤ effectiveAt y i +
    (if FirstDown tail i then preset.EFFECTIVE_BALANCE_INCREMENT.toNat else 0)

/-- A first drop is any drop: the earliest one has no drop before it. -/
private theorem firstDown_iff_pathDrop {x y : ForkedBeaconState preset}
    (tail : Run config checks x y) (i : Nat) :
    FirstDown tail i ↔ PathDrop tail.balancePath i := by
  constructor
  · rintro ⟨j, a, b, one, two, less, _⟩
    exact ⟨j, a, b, one, two, less⟩
  · intro exists'
    obtain ⟨a, b, one, two, less⟩ := Nat.find_spec exists'
    refine ⟨Nat.find exists', a, b, one, two, less, ?_⟩
    intro k u v earlier ku kv
    by_contra up
    exact Nat.find_min exists' earlier ⟨u, v, ku, kv, by omega⟩

private theorem pathDrop_append_left {path more : List (ForkedBeaconState preset)} {i : Nat}
    (drop : PathDrop path i) : PathDrop (path ++ more) i := by
  obtain ⟨j, a, b, one, two, less⟩ := drop
  obtain ⟨inside, _⟩ := List.getElem?_eq_some_iff.mp two
  refine ⟨j, a, b, ?_, ?_, less⟩
  · rw [List.getElem?_append_left (by omega)]
    exact one
  · rw [List.getElem?_append_left inside]
    exact two

/-- Two paths that meet at one state drop together exactly where one of them drops. -/
private theorem pathDrop_append_iff {path more : List (ForkedBeaconState preset)} {i : Nat}
    {c : ForkedBeaconState preset} (last : path.getLast? = some c) (head : more.head? = some c) :
    PathDrop (path ++ more) i ↔ PathDrop path i ∨ PathDrop more i := by
  constructor
  · rintro ⟨j, a, b, one, two, less⟩
    have lastAt : path[path.length - 1]? = some c := by
      rw [← List.getLast?_eq_getElem?]
      exact last
    have headAt : more[0]? = some c := by
      rw [← List.head?_eq_getElem?]
      exact head
    have nonempty : 0 < path.length := by
      cases path with
      | nil => simp at last
      | cons _ _ => simp
    by_cases early : j + 1 < path.length
    · left
      refine ⟨j, a, b, ?_, ?_, less⟩
      · rwa [List.getElem?_append_left (by omega)] at one
      · rwa [List.getElem?_append_left early] at two
    · by_cases late : path.length ≤ j
      · right
        refine ⟨j - path.length, a, b, ?_, ?_, less⟩
        · rwa [List.getElem?_append_right late] at one
        · rw [List.getElem?_append_right (by omega)] at two
          rwa [show j + 1 - path.length = j - path.length + 1 by omega] at two
      · exfalso
        have atJ : j = path.length - 1 := by omega
        rw [List.getElem?_append_left (by omega), atJ, lastAt] at one
        rw [List.getElem?_append_right (by omega),
          show j + 1 - path.length = 0 by omega, headAt] at two
        cases one
        cases two
        exact Nat.lt_irrefl _ less
  · rintro (drop | ⟨j, a, b, one, two, less⟩)
    · exact pathDrop_append_left drop
    · refine ⟨path.length + j, a, b, ?_, ?_, less⟩
      · rw [List.getElem?_append_right (by omega), Nat.add_sub_cancel_left]
        exact one
      · rw [List.getElem?_append_right (by omega),
          show path.length + j + 1 - path.length = j + 1 by omega]
        exact two

/-- A first drop of a prefix is a first drop of every extension. -/
private theorem firstDown_append {x m y : ForkedBeaconState preset}
    (pre : Run config checks x m) (rest : Run config checks m y) (i : Nat)
    (drop : FirstDown pre i) : FirstDown (pre.append rest) i := by
  rw [firstDown_iff_pathDrop] at drop ⊢
  rw [Run.balancePath_append]
  exact pathDrop_append_left drop

/-- A drop in the whole run is a drop in the prefix or in the last step. -/
private theorem firstDown_snoc_iff {x m n : ForkedBeaconState preset}
    (pre : Run config checks x m) (step : Step config checks m n) (i : Nat) :
    FirstDown (pre.snoc step) i ↔ FirstDown pre i ∨ StepDrop step i := by
  rw [firstDown_iff_pathDrop, firstDown_iff_pathDrop]
  exact pathDrop_append_iff (Run.balancePath_ends pre).2 (Step.balancePath_ends step).1

/-- Base of the carried bound, from the OwnedInitial equation. -/
private theorem originalDown_initial {x : ForkedBeaconState preset} {high : Nat} {o : Ownership}
    (initial : OwnedInitial x high o) : OriginalDown (Run.nil : Run config checks x x) o := by
  intro i
  rw [initial.2.2.2.2.2 i]
  split <;> (split <;> omega)

/-- A block step keeps the bound: effective balances are kept and `original` only drops. -/
private theorem originalDown_block {x : ForkedBeaconState preset} {fork : Fork}
    {m n : BeaconState preset fork}
    (pre : Run config checks x ⟨fork, m⟩) (step : Step config checks ⟨fork, m⟩ ⟨fork, n⟩)
    {o o' : Ownership} (down : OriginalDown pre o) (kept : EffectiveKept m n)
    (lower : ∀ i, o'.original i ≤ o.original i) : OriginalDown (pre.snoc step) o' := by
  intro i
  have d := down i
  have l := lower i
  have effective : effectiveAt ⟨fork, m⟩ i ≤ effectiveAt ⟨fork, n⟩ i := by
    by_cases inside : i < m.validators.data.size
    · exact (kept i inside).ge
    · have none : m.validators.data[i]? = none :=
        Array.getElem?_eq_none_iff.mpr (Nat.le_of_not_lt inside)
      simp [effectiveAt, none]
  by_cases f : FirstDown pre i
  · rw [ite_eq_left f] at d
    rw [ite_eq_left ((firstDown_snoc_iff pre step i).mpr (.inl f))]
    omega
  · rw [ite_eq_right f] at d
    split <;> omega

/-- A slot step keeps the bound, given the effective-balance bound of the slot replay. -/
private theorem originalDown_slot {x m n : ForkedBeaconState preset}
    (pre : Run config checks x m) (step : Step config checks m n) {o o' : Ownership}
    (down : OriginalDown pre o)
    (bound : ∀ down : Nat → Prop,
      (∀ i, o.original i ≤ effectiveAt m i +
        (if down i then preset.EFFECTIVE_BALANCE_INCREMENT.toNat else 0)) →
      ∀ i, o'.original i ≤ effectiveAt n i +
        (if down i ∨ StepDrop step i then preset.EFFECTIVE_BALANCE_INCREMENT.toNat else 0)) :
    OriginalDown (pre.snoc step) o' := by
  intro i
  have h := bound (FirstDown pre) down i
  by_cases f : FirstDown pre i ∨ StepDrop step i
  · rw [ite_eq_left f] at h
    rw [ite_eq_left ((firstDown_snoc_iff pre step i).mpr f)]
    exact h
  · rw [ite_eq_right f] at h
    omega

/-- A key whose exit a step assigns, after a first drop, is a source-falling key.

Its stop holds a charge, since its exit goes from FAR at `x` to assigned at `y`.

The stop's assigning step cannot lie inside `pre`, where the exit is still FAR at its end.

Nor can it be `pre` itself.

So `pre` is a prefix of the stop's run.

The key is unslashed at its stop state, since its exit is still FAR there. -/
private theorem RoundLedger.sourceFalling_of_firstDown
    {g x y m n : ForkedBeaconState preset} {high : Nat} {tail : Run config checks x y}
    (ledger : RoundLedger tail high) (shared : Run config checks g x)
    (supported : Supported shared tail high)
    (delay : 0 < config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    (pre : Run config checks x m) (step : Step config checks m n)
    (rest : Run config checks n y) (split : (pre.snoc step).append rest = tail)
    (i : Nat) (v w : Validator) (before : m.state.validators.data[i]? = some v)
    (after : n.state.validators.data[i]? = some w)
    (unset : v.exitEpoch = FAR_FUTURE_EPOCH) (assigned : w.exitEpoch ≠ FAR_FUTURE_EPOCH)
    (reference : NewReference x i) (drop : FirstDown pre i) : i ∈ ledger.sourceFalling := by
  obtain ⟨initial, initialFound, initialUnset⟩ : ∃ u, x.state.validators.data[i]? = some u ∧
      u.exitEpoch = FAR_FUTURE_EPOCH := by
    unfold NewReference at reference
    cases h : x.state.validators.data[i]? with
    | none => simp [h] at reference
    | some u =>
      simp only [h, Option.any_some, Bool.and_eq_true, beq_iff_eq] at reference
      exact ⟨u, rfl, reference.2⟩
  obtain ⟨final, finalFound, finalLife⟩ := rest.registryLifecycle.validators i w after
  have finalAssigned : final.exitEpoch ≠ FAR_FUTURE_EPOCH := by
    rw [finalLife.exitEpoch assigned]
    exact assigned
  obtain ⟨c, chosen, _⟩ :=
    (ledger.stops i).charge_of_new_exit initialFound finalFound initialUnset finalAssigned
  have selected := (ledger.stops i).selected
  rw [chosen] at selected
  obtain ⟨_, _, _, next, assigning, remaining, split₂, _, v', w', atStop, atNext, unset',
    assigned', _⟩ := selected
  have caps := supported.2.2.1
  have early : (ledger.stops i).state.fork < .glamsterdam :=
    Nat.lt_of_le_of_lt (fork_le_of_chainSteps (ledger.stops i).post.chainSteps)
      supported.2.2.2.2.1
  have clean : v'.slashed = false := by
    cases flag : v'.slashed
    · rfl
    · exact absurd unset' (run_slashed_exit_assigned (shared.append (ledger.stops i).pre)
        supported.1 caps.activation caps.compounding early delay i v' atStop flag)
  have split₁ : pre.append (((Run.nil : Run config checks m m).snoc step).append rest) = tail := by
    rw [Run.append_assoc]
    exact split
  have firstDown : FirstDown (ledger.stops i).pre i := by
    rcases Run.prefix_total pre _ ((ledger.stops i).pre.snoc assigning) remaining split₁ split₂
      with ⟨r, extended⟩ | ⟨r, inside⟩
    · rcases Run.prefix_snoc pre r (ledger.stops i).pre assigning extended with
        ⟨same, _⟩ | ⟨r', earlier⟩
      · subst same
        obtain rfl := Option.some.inj (before.symm.trans atNext)
        exact absurd unset assigned'
      · rw [← earlier]
        exact firstDown_append pre r' i drop
    · obtain ⟨later, laterFound, life⟩ := r.registryLifecycle.validators i w' atNext
      obtain rfl := Option.some.inj (laterFound.symm.trans before)
      exact absurd ((life.exitEpoch assigned').symm.trans unset) assigned'
  refine (ledger.exactSourceCarrier i).mpr ⟨(Array.getElem?_eq_some_iff.mp initialFound).1,
    reference, ?_, firstDown⟩
  simp [atStop, clean]

/-- This is the `assigned` premise of `reservedReplay_consolidationRequest`.

It is the form after the approved weakening.

It covers only keys with exit FAR at `s` whose exit is assigned at `t`. -/
private def RequestAssigned (rounding : Nat → Nat) {fork : Fork} (s t : BeaconState preset fork)
    (owned : Ownership) : Prop :=
  ∀ (i : Nat) (v : Validator), s.validators.data[i]? = some v →
    v.exitEpoch = FAR_FUTURE_EPOCH →
    (∃ w, t.validators.data[i]? = some w ∧ w.exitEpoch ≠ FAR_FUTURE_EPOCH) →
    owned.original i ≤ v.effectiveBalance.toNat + rounding i

/-- The block assignment bound at a block input, from the carried bound and the rounding premise.

A key above its effective balance has a positive original.

So it is a new reference key, and it had a first drop. -/
private theorem blockAssigned_of_originalDown {x : ForkedBeaconState preset} {high : Nat}
    {rounding : Nat → Nat} {fork : Fork} {m n : BeaconState preset fork}
    (pre : Run config checks x ⟨fork, m⟩)
    {epoch : Epoch} {suffix : List PendingConsolidation} {o : Ownership}
    (down : OriginalDown pre o) (reserve : ReserveCut x high ⟨fork, m⟩ epoch suffix o)
    (roundingAt : ∀ (i : Nat) (v w : Validator), m.validators.data[i]? = some v →
      n.validators.data[i]? = some w →
      v.exitEpoch = FAR_FUTURE_EPOCH → w.exitEpoch ≠ FAR_FUTURE_EPOCH →
      NewReference x i → FirstDown pre i →
      rounding i = preset.EFFECTIVE_BALANCE_INCREMENT.toNat) :
    BlockAssigned rounding m n o := by
  intro i v w found later unset assigned
  have d := down i
  have effective : effectiveAt ⟨fork, m⟩ i = v.effectiveBalance.toNat := by
    simp [effectiveAt, found]
  rw [effective] at d
  by_cases small : o.original i ≤ v.effectiveBalance.toNat
  · omega
  · have ref : NewReference x i := by
      by_contra notReference
      have zero := (reserve.2.2.1 i).2 notReference
      omega
    by_cases f : FirstDown pre i
    · rw [roundingAt i v w found later unset assigned ref f]
      rw [ite_eq_left f] at d
      exact d
    · rw [ite_eq_right f] at d
      omega

/-- Inside a block from `m` to `n`, at a request from `s` to `t`. -/
private theorem requestAssigned_of_block {x : ForkedBeaconState preset} {high : Nat}
    {rounding : Nat → Nat} {fork : Fork} {m s t n : BeaconState preset fork} {epoch : Epoch}
    {suffix : List PendingConsolidation} {ownedM owned : Ownership}
    (block : BlockAssigned rounding m n ownedM)
    (lifeMS : RegistryLifecycle m s) (kept : EffectiveKept m s) (lifeTN : RegistryLifecycle t n)
    (lower : ∀ i, owned.original i ≤ ownedM.original i)
    (reserve : ReserveCut x high ⟨fork, s⟩ epoch suffix owned)
    (sizeX : x.state.validators.data.size ≤ m.validators.data.size) :
    RequestAssigned rounding s t owned := by
  rintro i v found unset ⟨w, later, assigned⟩
  have l := lower i
  by_cases inside : i < m.validators.data.size
  · have uFound : m.validators.data[i]? = some m.validators.data[i] :=
      Array.getElem?_eq_getElem inside
    obtain ⟨v', vFound, uLife⟩ := lifeMS.validators i _ uFound
    obtain rfl := Option.some.inj (vFound.symm.trans found)
    have uUnset : m.validators.data[i].exitEpoch = FAR_FUTURE_EPOCH := by
      by_contra set
      exact set ((uLife.exitEpoch set).symm.trans unset)
    have same := kept i inside
    simp only [effectiveAt, found, uFound, Option.map_some, Option.getD_some] at same
    obtain ⟨w', wFound, wLife⟩ := lifeTN.validators i w later
    have b := block i _ w' uFound wFound uUnset (by rw [wLife.exitEpoch assigned]; exact assigned)
    omega
  · have none : x.state.validators.data[i]? = none :=
      Array.getElem?_eq_none_iff.mpr (by omega)
    have zero := (reserve.2.2.1 i).1
    simp only [effectiveAt, none, Option.map_none, Option.getD_none] at zero
    omega

end Apriori.Internal
end
end EthLib.Consensus.DirectSafety
end

section
namespace EthLib.Consensus.DirectSafety
open Apriori
open Base Classical Cryptography.Bls Uint64
variable {preset : Preset} {config : Config} {checks : SignatureChecks}
noncomputable section
namespace Apriori.Internal

/-- A change of BLS credentials to an execution address is quiet.

Neither credential is compounding, so the largest effective balance stays.

Nothing else that a registry step reads changes. -/
private theorem QuietStep.blsChange {fork : Fork} {electra : .pectra ≤ fork}
    {s t : BeaconState preset fork} {signed : SignedBLSToExecutionChange}
    (ok : processBlsToExecutionChange config checks s signed = .ok t)
    (delay : 0 < config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    (ordered : ExitsOrdered s) : QuietStep electra s t := by
  have held := processBlsToExecutionChange_slashed_exit_assigned ok delay
  -- The index bounds below must not read the delay, or `decide` rejects their goals.
  clear delay
  obtain ⟨v, found, bls, _, _, set⟩ := processBlsToExecutionChange_ok ok
  have read : s.validators.data[signed.message.validatorIndex.toNat]? = some v :=
    getValidator_eq_ok_iff.mp found
  have old : (v.withdrawalCredentials[0] == COMPOUNDING_WITHDRAWAL_PREFIX[0]) = false := by
    rw [bls]
    decide
  have first : (executionCredentials signed.message.toExecutionAddress)[0] =
      ETH1_ADDRESS_WITHDRAWAL_PREFIX[0] := by
    simp [executionCredentials]
  have new : ((executionCredentials signed.message.toExecutionAddress)[0] ==
      COMPOUNDING_WITHDRAWAL_PREFIX[0]) = false := by
    rw [first]
    decide
  -- An opaque name for the new credentials keeps unification from computing them.
  generalize executionCredentials signed.message.toExecutionAddress = credentials at set new
  have cap : withdrawalMaxEffectiveBalance preset fork
        { v with withdrawalCredentials := credentials } =
      withdrawalMaxEffectiveBalance preset fork v := by
    simp only [withdrawalMaxEffectiveBalance, getMaxEffectiveBalance,
      hasCompoundingWithdrawalCredential, isCompoundingWithdrawalCredential, old, new]
  have registry := RegistryStep.set read set rfl rfl cap id ⟨fun _ => rfl, fun _ => rfl⟩
    (.inl rfl) (fun _ _ => rfl) (ordered v (Array.mem_of_getElem? read)) ordered
  obtain ⟨_, rfl⟩ := setValidator_ok set
  exact ⟨registry, rfl, rfl, rfl, rfl, held⟩

/-- The BLS credential changes of a block record nothing. -/
private theorem operationReplay_blsChanges (x : ForkedBeaconState preset) (high : Nat)
    (rounding : Nat → Nat) {fork : Fork} (electra : .pectra ≤ fork)
    (delay : 0 < config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    {s t : BeaconState preset fork} (body : BeaconBlockBody preset fork)
    (ok : processBlsToExecutionChanges config checks s body = .ok t) :
    OperationReplay (config := config) (checks := checks) x high rounding electra s t [] [] := by
  unfold processBlsToExecutionChanges at ok
  split at ok
  · rename_i capella
    have folded : (body.blsToExecutionChanges capella).data.toList.foldlM
        (processBlsToExecutionChange config checks) s = .ok t := by
      simpa only [Array.foldlM_toList] using ok
    exact operationReplay_quiet
      (foldlM_framePath _ _ folded fun _ _ _ _ eq => .credentials eq)
      (foldlM_step (QuietStep electra) (fun _ => .refl) .trans (·.1.2.2.2.2.2.2) (·.1.2.2.2.1) _
        (fun _ _ _ step ordered _ => QuietStep.blsChange step delay ordered) _ folded)
  · rename_i before
    exact absurd (Nat.le_trans (by decide) electra) before

/-- The run facts of one block step.

The current epoch stays.

The balance match, the order of exits and withdrawals and the lifecycle from `x` carry. -/
private theorem runFacts_of_frame {x : ForkedBeaconState preset} {fork : Fork}
    {a b : BeaconState preset fork} (frame : BlockFrame a b) (life : RegistryLifecycle a b) :
    getCurrentEpoch b = getCurrentEpoch a ∧
    (BalancesMatch a → ExitsOrdered a → RegistryLifecycle x.state a →
      BalancesMatch b ∧ ExitsOrdered b ∧ RegistryLifecycle x.state b) :=
  ⟨by simp only [getCurrentEpoch, frame.slot], fun matched ordered start =>
    ⟨frame.balancesMatch matched, frame.exitsOrdered ordered, start.trans life⟩⟩

private theorem runFacts_proposerSlashing {x : ForkedBeaconState preset} {fork : Fork}
    {a b : BeaconState preset fork} {slashing : ProposerSlashing}
    (ok : processProposerSlashing config checks a slashing = .ok b) :
    getCurrentEpoch b = getCurrentEpoch a ∧
    (BalancesMatch a → ExitsOrdered a → RegistryLifecycle x.state a →
      BalancesMatch b ∧ ExitsOrdered b ∧ RegistryLifecycle x.state b) :=
  runFacts_of_frame (frame_processProposerSlashing ok)
    (registryLifecycle_processProposerSlashing ok)

private theorem runFacts_attesterSlashing {x : ForkedBeaconState preset} {fork : Fork}
    {a b : BeaconState preset fork} {slashing : AttesterSlashing preset fork}
    (ok : processAttesterSlashing config checks a slashing = .ok b) :
    getCurrentEpoch b = getCurrentEpoch a ∧
    (BalancesMatch a → ExitsOrdered a → RegistryLifecycle x.state a →
      BalancesMatch b ∧ ExitsOrdered b ∧ RegistryLifecycle x.state b) :=
  runFacts_of_frame (frame_processAttesterSlashing ok)
    (registryLifecycle_processAttesterSlashing ok)

private theorem runFacts_voluntaryExits {x : ForkedBeaconState preset} {fork : Fork}
    {a b : BeaconState preset fork} {exits : List SignedVoluntaryExit}
    (ok : exits.foldlM (processVoluntaryExit config checks) a = .ok b) :
    getCurrentEpoch b = getCurrentEpoch a ∧
    (BalancesMatch a → ExitsOrdered a → RegistryLifecycle x.state a →
      BalancesMatch b ∧ ExitsOrdered b ∧ RegistryLifecycle x.state b) := by
  exact runFacts_of_frame (BlockFrame.foldlM (fun _ _ _ one => frame_processVoluntaryExit one) ok)
    (RegistryLifecycle.foldlM (fun _ _ _ one => registryLifecycle_processVoluntaryExit one) ok)

private theorem runFacts_withdrawalRequests {x : ForkedBeaconState preset} {fork : Fork}
    {electra : .pectra ≤ fork} {a b : BeaconState preset fork}
    {requests : List WithdrawalRequest}
    (ok : requests.foldlM (processWithdrawalRequest config · electra ·) a = .ok b) :
    getCurrentEpoch b = getCurrentEpoch a ∧
    (BalancesMatch a → ExitsOrdered a → RegistryLifecycle x.state a →
      BalancesMatch b ∧ ExitsOrdered b ∧ RegistryLifecycle x.state b) := by
  exact runFacts_of_frame
      (BlockFrame.foldlM (fun _ _ _ one => frame_processWithdrawalRequest one) ok)
    (RegistryLifecycle.foldlM (fun _ _ _ one => registryLifecycle_processWithdrawalRequest one) ok)

private theorem runFacts_blsChanges {x : ForkedBeaconState preset} {fork : Fork}
    {a b : BeaconState preset fork} {body : BeaconBlockBody preset fork}
    (ok : processBlsToExecutionChanges config checks a body = .ok b) :
    getCurrentEpoch b = getCurrentEpoch a ∧
    (BalancesMatch a → ExitsOrdered a → RegistryLifecycle x.state a →
      BalancesMatch b ∧ ExitsOrdered b ∧ RegistryLifecycle x.state b) := by
  unfold processBlsToExecutionChanges at ok
  split at ok
  · rename_i capella
    have folded : (body.blsToExecutionChanges capella).data.toList.foldlM
        (processBlsToExecutionChange config checks) a = .ok b := by
      simpa only [Array.foldlM_toList] using ok
    exact runFacts_of_frame
        (BlockFrame.foldlM (fun _ _ _ one => frame_processBlsToExecutionChange one) folded)
      (RegistryLifecycle.foldlM (fun _ _ _ one => registryLifecycle_processBlsToExecutionChange one)
            folded)
  · cases ok
    exact runFacts_of_frame (.refl a) (.refl a)

private theorem runFacts_consolidationRequest {x : ForkedBeaconState preset} {fork : Fork}
    {electra : .pectra ≤ fork} {a b : BeaconState preset fork} {request : ConsolidationRequest}
    (ok : processConsolidationRequest config a electra request = .ok b) :
    getCurrentEpoch b = getCurrentEpoch a ∧
    (BalancesMatch a → ExitsOrdered a → RegistryLifecycle x.state a →
      BalancesMatch b ∧ ExitsOrdered b ∧ RegistryLifecycle x.state b) :=
  runFacts_of_frame (frame_processConsolidationRequest ok)
    (registryLifecycle_processConsolidationRequest ok)

end Apriori.Internal
end
end EthLib.Consensus.DirectSafety
end

namespace EthLib.Consensus.DirectSafety.Apriori.Internal
open EthLib.Consensus.DirectSafety.Apriori
open Base Classical
variable {preset : Preset} {config : Config} {checks : SignatureChecks}

/-- The tags of an initial queue are distinct initial positions. -/
private theorem initialTags_tags (queue : List PendingConsolidation) :
    (initialTags queue).map (·.tag) = (List.range' 0 queue.length).map QueueTag.initial := by
  have spread := List.zipIdx_map_snd 0 queue
  simp only [initialTags, List.map_map]
  rw [← spread, List.map_map]
  rfl

/-- A reserved history from `x`, paying only between distinct keys, gives the selected inputs. -/
private theorem selectedInputs_of_history {g x y : ForkedBeaconState preset}
    (shared : Run config checks g x) (tail : Run config checks x y) {high : Nat}
    (supported : Supported shared tail high) {events : List (BalanceEvent preset)}
    (replayed : tail.balanceEvents high = .ok events) (electra : .pectra ≤ x.fork)
    {rounding : Nat → Nat} {before after : Ownership} {queue : List TaggedEntry}
    {payments : List (TaggedEntry × Payment preset)} {allocations : List OwnedRelease}
    {calls : List (IndexedDepartureCall preset config)}
    (history : ReservedReplay (config := config) (checks := checks) x high rounding
      x (getCurrentEpoch x.state) y (getCurrentEpoch y.state) 0 0 0 events
      (initialTags (x.state.pendingConsolidations electra).data.toList) queue
      payments allocations calls before after)
    (paying : ∀ pair ∈ payments, Paying pair.2) :
    ∃ calls : List (IndexedDepartureCall preset config),
    ∃ final consumed paidTags : List TaggedEntry,
    ∃ selected : List SelectedCharge, ∃ payments : List (Payment preset),
      FreshPaymentCoverage (config := config) events
        (initialTags (x.state.pendingConsolidations electra).data.toList)
        final consumed paidTags payments calls ∧
      FreshTags (config := config) (consumed ++ final) calls ∧
      paidTags.Sublist consumed ∧ SelectedPayments selected payments paidTags ∧
      ActualPaymentCoverage events payments
        (x.state.pendingConsolidations electra).data.toList := by
  obtain ⟨genesis, _, _, _, early, endEpoch, guard⟩ := id supported
  have delay : 0 < config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat := by
    obtain ⟨_, _, _, _, _, _, _, _, _, delayTwo, _⟩ := id guard
    omega
  have xEarly : x.fork < .glamsterdam :=
    Nat.lt_of_le_of_lt (fork_le_of_chainSteps tail.chainSteps) early
  obtain ⟨consumed, appended, replay, paidSub, pairs, perm, sizes, facts⟩ :=
    history.counters_original.2.2.2.2.2.2.2
  let isFresh : TaggedEntry × Payment preset → Bool := fun pair =>
    match pair.1.tag with | .fresh _ => true | .initial _ => false
  let fresh := payments.filter isFresh
  have freshMember : ∀ pair ∈ fresh, pair ∈ payments ∧ ∃ n, pair.1.tag = .fresh n := by
    intro pair member
    obtain ⟨inside, chosen⟩ := List.mem_filter.mp member
    refine ⟨inside, ?_⟩
    cases kind : pair.1.tag with
    | fresh n => exact ⟨n, rfl⟩
    | initial p => simp [isFresh, kind] at chosen
  refine ⟨calls, queue, consumed, fresh.map Prod.fst,
    fresh.map (fun pair => ⟨pair.2.source, pair.1.amount, pair.1.epoch, pair.2.epoch⟩),
    fresh.map Prod.snd, ⟨payments, replay, rfl, rfl⟩, ⟨?_, ?_⟩,
    ((List.filter_sublist).map _).trans paidSub, ⟨by simp, by simp, fun i => ?_⟩, ?_⟩
  · -- Initial tags are distinct initial positions; appended tags are distinct fresh positions.
    have appendedTags : appended.map (·.tag) =
        (List.range' 0 appended.length).map QueueTag.fresh := by
      apply List.ext_getElem (by simp)
      intro k inside _
      simpa using (facts k (by simpa using inside)).1
    have nodup : ((initialTags (x.state.pendingConsolidations electra).data.toList ++
        appended).map (·.tag)).Nodup := by
      rw [List.map_append, initialTags_tags, appendedTags, List.nodup_append]
      refine ⟨(List.nodup_range').map fun _ _ same => QueueTag.initial.inj same,
        (List.nodup_range').map fun _ _ same => QueueTag.fresh.inj same, ?_⟩
      intro a left b right same
      obtain ⟨_, _, rfl⟩ := List.mem_map.mp left
      obtain ⟨_, _, rfl⟩ := List.mem_map.mp right
      cases same
    exact (perm.map _).nodup_iff.mpr nodup
  · -- A fresh tag is an appended tag, pointing at its call.
    intro tag member n kind
    rcases List.mem_append.mp (perm.subset member) with initial | added
    · obtain ⟨_, _, rfl⟩ := List.mem_map.mp initial
      cases kind
    · obtain ⟨k, inside, rfl⟩ := List.getElem_of_mem added
      obtain ⟨tagEq, called, found, index, amount, epoch⟩ := facts k inside
      rw [kind, Nat.zero_add] at tagEq
      cases tagEq
      exact ⟨called, found, index, amount, epoch⟩
  · -- Each selected charge reads its payment and its fresh tag.
    have inside : i.val < fresh.length := by simpa using i.isLt
    obtain ⟨member, n, kind⟩ := freshMember _ (List.getElem_mem inside)
    obtain ⟨source, target⟩ := pairs _ member
    refine ⟨(fresh[i.val]).2, (fresh[i.val]).1, by simp [inside], by simp [inside],
      paying _ member, ⟨n, kind⟩, source.symm, target.symm, ?_, ?_, ?_, ?_⟩ <;> simp
  · -- The fresh payments are the payments from sources outside the initial queue.
    have lifecycle : ∀ e ∈ events, RegistryLifecycle x.state e.before.state := fun e member =>
      (replay_event_provenance shared tail genesis early high endEpoch events replayed e
        member).1
    have notInitial := history.fresh_not_initial shared genesis electra xEarly delay lifecycle
    have covered := history.actual_payment_coverage electra notInitial
    rw [show (((payments.zip allocations).filter fun pair =>
        match pair.1.1.tag with | .fresh _ => true | .initial _ => false).map
          fun pair => pair.1.2) = fresh.map Prod.snd from
      zip_filter_fst_map isFresh Prod.snd payments allocations
        history.paired_rounds.length_eq] at covered
    exact covered

end EthLib.Consensus.DirectSafety.Apriori.Internal
section
namespace EthLib.Consensus.DirectSafety
open Apriori
open Base Classical Cryptography.Bls
variable {preset : Preset} {config : Config} {checks : SignatureChecks}
noncomputable section
namespace Apriori.Internal

/-- The facts at the epoch input of a slot step, read from the run and its cache step.

The cache step writes only roots and the latest header.

So every fact of the run's end state holds at the epoch input as well. -/
private theorem epochInput_facts {g x u : ForkedBeaconState preset}
    {s : BeaconState preset u.fork}
    (shared : Run config checks g x) (pre : Run config checks x u)
    (genesis : Genesis (config := config) (checks := checks) g) (caps : CapOrder preset)
    (delay : 0 < config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    (twoSlots : 2 ≤ preset.SLOTS_PER_EPOCH.toNat)
    (early : u.fork < .glamsterdam)
    (cached : processSlot u.state = .ok s) :
    BalancesMatch s ∧ ExitsOrdered s ∧
      PendingConsolidationsOrdered config (getCurrentEpoch s).toNat s ∧
      (∀ (i : Nat) (v : Validator), s.validators.data[i]? = some v →
        v.exitEpoch ≠ FAR_FUTURE_EPOCH →
          v.exitEpoch.toNat + config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat ≤
            v.withdrawableEpoch.toNat) ∧
      (∀ v ∈ s.validators.data, v.activationEpoch ≤ v.exitEpoch) ∧
      (∀ v ∈ s.validators.data,
        v.effectiveBalance ≤ withdrawalMaxEffectiveBalance preset u.fork v) ∧
      (∀ electra : .pectra ≤ u.fork, ∀ c ∈ (s.pendingConsolidations electra).data.toList,
        c.sourceIndex ≠ c.targetIndex) ∧
      RegistryLifecycle x.state s ∧ getCurrentEpoch x.state ≤ getCurrentEpoch s ∧
      getCurrentEpoch s < FAR_FUTURE_EPOCH := by
  have run := shared.append pre
  have invariant := (run_justified_separated run genesis).1
  have start := currentEpoch_le_of_chainSteps pre.chainSteps
  have bounded := getCurrentEpoch_succ_lt_farFuture twoSlots u.state
  obtain ⟨_, _, _, _, rfl⟩ := processSlot_ok cached
  exact ⟨invariant.balancesMatch, invariant.exitsOrdered,
    run.pendingConsolidationsOrdered genesis early delay,
    run.exit_withdrawable_delay genesis,
    run.activationExitOrder genesis,
    run.effectiveBalance_capped genesis caps.activation caps.compounding early,
    run.pendingConsolidations_apart genesis early delay,
    pre.registryLifecycle.trans (.of_data rfl), start,
    UInt64.lt_iff_toNat_lt.mpr (by
      change (getCurrentEpoch u.state).toNat < FAR_FUTURE_EPOCH.toNat
      omega)⟩

/-- Fresh tags keep their source exits along a registry lifecycle, for any sublist of tags. -/
private theorem FreshExits.lifecycle {f h : Fork} {s : BeaconState preset f}
    {t : BeaconState preset h} {queue suffix : List TaggedEntry}
    (held : FreshExits s queue) (life : RegistryLifecycle s t)
    (within : ∀ tag ∈ suffix, tag ∈ queue) : FreshExits t suffix := by
  intro tag member n tagged
  obtain ⟨v, found, epochEq, assigned⟩ := held tag (within tag member) n tagged
  obtain ⟨w, located, kept⟩ := life.validators _ v found
  have same := kept.exitEpoch assigned
  exact ⟨w, located, same ▸ epochEq, same ▸ assigned⟩

end Apriori.Internal
end
end EthLib.Consensus.DirectSafety
end
section
namespace EthLib.Consensus.DirectSafety
open Apriori
open Base Classical Cryptography.Bls Uint64
variable {preset : Preset} {config : Config} {checks : SignatureChecks}
noncomputable section
namespace Apriori.Internal

/-- A slot step inside an epoch records no balance event and moves only the slot and roots.

So the replay over it is one frame, and the retired set and both covers carry over. -/
private theorem reservedReplay_slot_inside {x u v : ForkedBeaconState preset} {high : Nat}
    {rounding : Nat → Nat} {queue : List TaggedEntry} {owned : Ownership}
    {eventPosition paymentPosition callPosition : Nat}
    (ok : advanceSlotAcross config checks u = .ok v)
    {events : List (BalanceEvent preset)}
    (replayed : (Step.slot ok).balanceEvents = .ok events)
    (nonlast : ∀ next, addChecked u.state.slot 1 = .ok next →
      next % preset.SLOTS_PER_EPOCH ≠ 0)
    (reserve : ReserveCut x high u (getCurrentEpoch u.state) (queue.map (·.entry)) owned)
    (assignment : AssignmentCut rounding queue owned)
    (erasure : QueueErasure queue (pendingQueue u))
    (retired : RetiredActivated u.state owned.retired)
    (cover : EndpointCoverAll x u owned) (future : FutureEffectiveCover x u owned) :
    events = [] ∧
      ReservedReplay (config := config) (checks := checks) x high rounding
        u (getCurrentEpoch u.state) v (getCurrentEpoch v.state)
        eventPosition paymentPosition callPosition [] queue queue [] [] [] owned owned ∧
      RetiredActivated v.state owned.retired ∧ EndpointCoverAll x v owned ∧
      FutureEffectiveCover x v owned ∧ ∀ i, effectiveAt v i = effectiveAt u i := by
  obtain ⟨fork, s⟩ := u
  obtain ⟨advanced, advanceOk, upgrades⟩ := bind_ok_iff.mp ok
  have frame := reservedFrame_advanceSlot_inside (config := config) (checks := checks)
    (rounding := rounding) advanceOk nonlast reserve assignment erasure
  obtain ⟨next, cached, epoched, sum, cachedOk, epochedOk, advancedEq⟩ :=
    advanceSlot_ok advanceOk
  change next.toNat = s.slot.toNat + 1 at sum
  have checked : addChecked s.slot 1 = .ok next :=
    addChecked_ok_iff.mpr ⟨by
      change s.slot.toNat + 1 < 2 ^ 64
      have small := next.toNat_lt
      omega, sum⟩
  have notLast := nonlast next checked
  simp only [epochIfLast, notLast, ↓reduceIte, pure, Except.pure, Except.ok.injEq] at epochedOk
  subst epoched
  -- No upgrade is due off the first slot of an epoch.
  have notDue : upgradeDue config (⟨fork, advanced⟩ : ForkedBeaconState preset) = false := by
    simp [upgradeDue, advancedEq, notLast]
  have stays : v = ⟨fork, advanced⟩ := by
    rw [processUpgrades.eq_def] at upgrades
    simp only [notDue, Bool.false_eq_true, pure, Except.pure] at upgrades
    exact (Except.ok.inj upgrades).symm
  subst stays
  have noCrossing : upgradeBalanceReplay (config := config) (checks := checks)
      (⟨fork, advanced⟩ : ForkedBeaconState preset) = .ok [] := by
    rw [upgradeBalanceReplay.eq_def]
    simp only [notDue, Bool.false_eq_true, ↓reduceIte, pure, Except.pure]
  have nextOk : liftAccessor (liftArith (Uint64.addChecked s.slot 1)) =
      (Except.ok next : Except TransitionError Slot) := by
    rw [checked]; rfl
  simp only [Step.balanceEvents, cachedOk, nextOk, notLast, ↓reduceIte, advanceOk, noCrossing,
    bind, Except.bind, pure, Except.pure, List.append_nil, Except.ok.injEq] at replayed
  have sameEpoch : getCurrentEpoch advanced = getCurrentEpoch s := by
    apply UInt64.toNat_inj.mp
    rw [getCurrentEpoch_toNat, getCurrentEpoch_toNat, advancedEq]
    exact nextSlot_epoch_of_inside sum notLast
  obtain ⟨_, _, _, _, rfl⟩ := processSlot_ok cachedOk
  subst advancedEq
  refine ⟨replayed.symm, .nil frame, retired.lifecycle (.of_data rfl), ?_,
    futureCover_records (u := s) rfl (UInt64.le_of_eq sameEpoch.symm) future, ?_⟩
  · simpa only [EndpointCoverAll, actualBalanceAt, sameEpoch] using cover
  · intro i
    rfl

end Apriori.Internal
end
end EthLib.Consensus.DirectSafety
end
section
namespace EthLib.Consensus.DirectSafety
open Apriori
open Base Classical Cryptography.Bls Uint64
variable {preset : Preset} {config : Config} {checks : SignatureChecks}
noncomputable section
namespace Apriori.Internal

/-- The last slot of an epoch, before any upgrade.

It runs the cache, the epoch through its pending consolidations and suffix, and the slot write. -/
private theorem reservedReplay_slot_last {g x : ForkedBeaconState preset} {fork : Fork}
    {s cached epoched middle : BeaconState preset fork} {nextSlot : Slot}
    {recorded : List (BalanceEvent preset)} {high : Nat} {rounding : Nat → Nat}
    {queue : List TaggedEntry} {owned : Ownership}
    {eventPosition paymentPosition callPosition : Nat}
    (shared : Run config checks g x) (pre : Run config checks x ⟨fork, s⟩)
    (genesis : Genesis (config := config) (checks := checks) g) (caps : CapOrder preset)
    (twoSlots : 2 ≤ preset.SLOTS_PER_EPOCH.toNat)
    (delayTwo : 2 ≤ config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    (electra : .pectra ≤ fork) (early : fork < .glamsterdam)
    (endEpoch : (getCurrentEpoch s).toNat ≤ high + 1)
    (cachedOk : processSlot s = .ok cached)
    (epochOk : processEpoch config checks cached = .ok epoched)
    (sum : nextSlot.toNat = s.slot.toNat + 1) (last : nextSlot % preset.SLOTS_PER_EPOCH = 0)
    (middleOk : epochBeforePayments config checks cached = .ok middle)
    (recordOk : epochBalanceReplay (config := config) (checks := checks) cached =
      .ok (middle, recorded))
    (reserve : ReserveCut x high ⟨fork, s⟩ (getCurrentEpoch s) (queue.map (·.entry)) owned)
    (assignment : AssignmentCut rounding queue owned)
    (erasure : QueueErasure queue (pendingQueue ⟨fork, s⟩))
    (prior : OwnershipBefore eventPosition paymentPosition owned)
    (retired : RetiredActivated s owned.retired)
    (cover : EndpointCoverAll x ⟨fork, s⟩ owned)
    (future : FutureEffectiveCover x ⟨fork, s⟩ owned)
    (fresh : FreshExits s queue)
    (provenance : ∀ c ∈ queue.map (·.entry), c ∈ pendingQueue x ∨
      (x.state.validators.data[c.sourceIndex.toNat]?).all (·.exitEpoch == FAR_FUTURE_EPOCH))
    (initialZero : ∀ tag ∈ queue, ∀ n, tag.tag = .initial n →
      owned.original tag.entry.sourceIndex.toNat = 0) :
    ∃ (queue' : List TaggedEntry) (payments : List (TaggedEntry × Payment preset))
      (allocations : List OwnedRelease) (owned' : Ownership),
      ReservedReplay (config := config) (checks := checks) x high rounding
        ⟨fork, s⟩ (getCurrentEpoch s) ⟨fork, { epoched with slot := nextSlot }⟩
        (getCurrentEpoch { epoched with slot := nextSlot })
        eventPosition paymentPosition callPosition recorded queue queue' payments allocations []
        owned owned' ∧
      ReservedFrame (config := config) (checks := checks) x high rounding
        ⟨fork, { epoched with slot := nextSlot }⟩ ⟨fork, { epoched with slot := nextSlot }⟩
        (getCurrentEpoch { epoched with slot := nextSlot })
        (getCurrentEpoch { epoched with slot := nextSlot }) queue' owned' owned' ∧
      OwnershipBefore (eventPosition + recorded.length) (paymentPosition + payments.length)
        owned' ∧
      RetiredActivated { epoched with slot := nextSlot } owned'.retired ∧
      EndpointCoverAll x ⟨fork, { epoched with slot := nextSlot }⟩ owned' ∧
      FutureEffectiveCover x ⟨fork, { epoched with slot := nextSlot }⟩ owned' ∧
      (∀ tag ∈ queue', tag ∈ queue) ∧
      (∀ e ∈ recorded, e.source = .consolidations →
        PendingConsolidationInvariant config e.before.state) ∧
      (∀ pair ∈ payments,
        pair.2.epoch ≤ (getCurrentEpoch { epoched with slot := nextSlot }).toNat) ∧
      (∀ pair ∈ payments, ∀ n, pair.1.tag = .fresh n → ∃ w,
        pair.2.before.state.validators.data[pair.2.source]? = some w ∧
          pair.1.epoch + config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat ≤
            w.withdrawableEpoch.toNat) ∧
      (∀ pair ∈ payments, Paying pair.2) ∧
      (0 < preset.EFFECTIVE_BALANCE_INCREMENT.toNat → ∀ down : Nat → Prop,
        (∀ i, owned.original i ≤ effectiveAt ⟨fork, s⟩ i +
          (if down i then preset.EFFECTIVE_BALANCE_INCREMENT.toNat else 0)) →
        ∀ i, owned'.original i ≤ effectiveAt ⟨fork, { epoched with slot := nextSlot }⟩ i +
          (if down i ∨ effectiveAt ⟨fork, { epoched with slot := nextSlot }⟩ i <
              effectiveAt ⟨fork, s⟩ i then
            preset.EFFECTIVE_BALANCE_INCREMENT.toNat else 0)) := by
  have delay : 0 < config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat := by omega
  have earlyX : x.fork < .glamsterdam :=
    Nat.lt_of_le_of_lt (fork_le_of_chainSteps pre.chainSteps) early
  obtain ⟨matched, exits, ordered, delayed, activationOrder, capped, apartAll, startLife,
    startCurrent, finite⟩ :=
    epochInput_facts (u := ⟨fork, s⟩) shared pre genesis caps delay twoSlots early cachedOk
  -- The cache keeps the registry, the balances, the slot and the queue.
  obtain ⟨_, _, _, _, cachedEq⟩ := processSlot_ok cachedOk
  have sameEpoch : getCurrentEpoch cached = getCurrentEpoch s := by
    simp only [getCurrentEpoch, processSlot_slot cachedOk]
  have cacheFrame : ReservedFrame (config := config) (checks := checks) x high rounding
      ⟨fork, s⟩ ⟨fork, cached⟩ (getCurrentEpoch s) (getCurrentEpoch cached) queue owned owned := by
    rw [sameEpoch]
    exact reservedFrame_cache cachedOk reserve assignment erasure
  obtain ⟨_, _, _, _, _, _, cachedErasure, _, cachedReserve⟩ := id cacheFrame
  -- The stages before the payments, as the replay records them.
  obtain ⟨justified, scored, rewarded, registered, slashed, reset, deposited, rewardEvents,
    limit, prefixTrace, justifiedOk, scoredOk, rewardsOk, registry, slashings, limitOk, resetOk,
    depositsOk, consolidationsOk, replay, recordedEq⟩ :=
    funding_epoch_site_limit middleOk recordOk
  -- The epoch's own trace runs the same prefix, so its suffix starts at `middle`.
  have suffixTrace : EpochTrace (EpochStage.action config checks)
      (EpochStage.middleStages ++ EpochStage.tailStages) middle epoched := by
    have trace := processEpoch_trace epochOk
    change EpochTrace _ (EpochStage.prefixStages ++
      (EpochStage.middleStages ++ EpochStage.tailStages)) cached epoched at trace
    obtain ⟨other, headTrace, tailTrace⟩ := EpochTrace.append_iff.mp trace
    have same : other = middle := by
      have run := EpochTrace.run_ok_iff.mpr headTrace
      rw [← epochBeforePayments_eq_run] at run
      exact Except.ok.inj (run.symm.trans middleOk)
    exact same ▸ tailTrace
  have far : FAR_FUTURE_EPOCH.toNat = 2 ^ 64 - 1 := rfl
  have finiteNat := UInt64.lt_iff_toNat_lt.mp finite
  obtain ⟨next, nextOk⟩ : ∃ next, addChecked (getCurrentEpoch cached) 1 = .ok next := by
    refine ⟨getCurrentEpoch cached + 1, addChecked_ok_iff.mpr ⟨?_, ?_⟩⟩
    · simp only [UInt64.toNat_one]
      omega
    · rw [UInt64.toNat_add, UInt64.toNat_one, Nat.mod_eq_of_lt (by omega)]
  have nextNat : next.toNat = (getCurrentEpoch cached).toNat + 1 := by
    simpa only [UInt64.toNat_one] using (addChecked_ok_iff.mp nextOk).2
  -- The cache keeps the registry, the balances and the slot.
  have cachedValidators : cached.validators = s.validators := by rw [cachedEq]
  have cachedBalances : cached.balances = s.balances := by rw [cachedEq]
  have cachedSlot : cached.slot = s.slot := processSlot_slot cachedOk
  have cachedRetired : RetiredActivated cached owned.retired :=
    retired.lifecycle (.of_data (congrArg (·.data) cachedValidators))
  have cachedCover : EndpointCoverAll x ⟨fork, cached⟩ owned :=
    endpointCoverAll_records cachedValidators cachedBalances cachedSlot cover
  have cachedFuture : FutureEffectiveCover x ⟨fork, cached⟩ owned :=
    futureCover_records cachedValidators (UInt64.le_of_eq sameEpoch.symm) future
  -- The queue is the actual pending queue, so it inherits the run's queue facts.
  have queueEq : queue.map (·.entry) = (cached.pendingConsolidations electra).data.toList := by
    rw [cachedErasure]
    simp only [pendingQueue, electra, ↓reduceDIte]
  have entryOf : ∀ tag ∈ queue, tag.entry ∈ (cached.pendingConsolidations electra).data.toList :=
    fun tag member => queueEq ▸ List.mem_map_of_mem member
  have unique : (queue.map (fun tag => tag.entry.sourceIndex)).Nodup := by
    have nodup := (ordered.1 electra).1
    rw [← queueEq, List.map_map] at nodup
    exact nodup
  have apart : ∀ tag ∈ queue, tag.entry.sourceIndex ≠ tag.entry.targetIndex :=
    fun tag member => apartAll electra _ (entryOf tag member)
  have sources : ∀ tag ∈ queue, ∃ w,
      cached.validators.data[tag.entry.sourceIndex.toNat]? = some w ∧
        w.activationEpoch ≠ FAR_FUTURE_EPOCH := by
    intro tag member
    obtain ⟨w, found, activated, _⟩ := (ordered.1 electra).2 _ (entryOf tag member)
    refine ⟨w, found, fun far' => ?_⟩
    rw [far'] at activated
    exact absurd (UInt64.lt_of_le_of_lt activated finite) (UInt64.lt_irrefl _)
  have slashedSpan := epochPrefix_slashedSpan pre caps.activation caps.compounding early
    cachedOk justifiedOk scoredOk rewardsOk registry slashings resetOk depositsOk
  have horizon : next.toNat ≤ horizonEnd x high := by
    have epochs : (getCurrentEpoch cached).toNat = (getCurrentEpoch s).toNat := by
      rw [sameEpoch]
    unfold horizonEnd driftHorizon
    omega
  obtain ⟨_, suffix, _, payments, allocations, final, pass, _, _, replayed, frameEnd, ownedEnd,
    retiredEnd, coverEnd, futureEnd, effectiveBound⟩ :=
    reservedReplay_epochNext_lowered (x := x) (high := high) (rounding := rounding)
      (eventPosition := eventPosition) (paymentPosition := paymentPosition)
      (callPosition := callPosition) electra early matched justifiedOk scoredOk rewardsOk replay
      registry slashings limitOk resetOk depositsOk consolidationsOk suffixTrace cachedReserve
      assignment cachedErasure prior cachedRetired cachedCover cachedFuture startLife
      (UInt64.lt_of_le_of_lt startCurrent finite) startCurrent ordered exits finite delayed
      delayTwo activationOrder nextOk twoSlots capped unique apart sources initialZero
      slashedSpan horizon (Run.pendingConsolidationsOrdered shared genesis earlyX delay)
      (run_slashed_exit_assigned shared genesis caps.activation caps.compounding earlyX delay)
      provenance
  -- The pass keeps a sublist of the queue, and pays from states with the pass input's registry.
  have shape := pass.pass_shape
  -- The prefix facts at the pass input: its registry lifecycle and the withdrawal delay.
  have deposits : processPendingDeposits config checks reset electra = .ok deposited := by
    simpa only [EpochStage.Edge, electra, ↓reduceDIte] using depositsOk
  obtain ⟨_, _, _, _, _, _, _, _, _, _, depositedLife, _, depositedDelay, _⟩ :=
    reservedReplay_epochPrefixDeposits_facts (x := x) (high := high) (rounding := rounding)
      (eventPosition := eventPosition) (paymentPosition := paymentPosition)
      (callPosition := callPosition) electra early matched justifiedOk scoredOk rewardsOk replay
      registry slashings limitOk resetOk deposits cachedReserve assignment cachedErasure prior
      cachedRetired startLife (UInt64.lt_of_le_of_lt startCurrent finite) ordered exits finite
      delayed delayTwo
  have freshDeposited : FreshExits deposited queue :=
    fresh.lifecycle ((RegistryLifecycle.of_data (congrArg (·.data) cachedValidators)).trans
      depositedLife) (fun _ member => member)
  have freshDelay : ∀ pair ∈ payments, ∀ n, pair.1.tag = .fresh n → ∃ w,
      pair.2.before.state.validators.data[pair.2.source]? = some w ∧
        pair.1.epoch + config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat ≤
          w.withdrawableEpoch.toNat := by
    intro pair member n tagged
    obtain ⟨inQueue, sourceEq, _, _, w, beforeEq, sameRegistry⟩ := shape.2.2.2.2.1 pair member
    obtain ⟨v, found, epochEq, assigned⟩ := freshDeposited pair.1 inQueue n tagged
    refine ⟨v, ?_, ?_⟩
    · rw [beforeEq, sourceEq]
      change w.validators.data[_]? = some v
      rw [sameRegistry]; exact found
    · have := depositedDelay _ v found assigned
      omega
  -- Only the last recorded event moves pending consolidations, from the pass input.
  have orderedDeposited : PendingConsolidationsOrdered config
      (getCurrentEpoch deposited).toNat deposited :=
    depositsOk.pendingConsolidationsOrdered
      (epochTrace_pendingConsolidationsOrdered prefixTrace ordered)
  have recordStep : ∀ (source : BalanceSource)
      (limits : BeaconState preset fork → Except TransitionError (Nat × Nat))
      (action : BeaconState preset fork → Except TransitionError (BeaconState preset fork))
      {pre post : BalanceReplay preset fork},
      recordBalance source limits action pre = .ok post → source ≠ .consolidations →
      (∀ e ∈ pre.2, e.source ≠ .consolidations) →
      ∀ e ∈ post.2, e.source ≠ .consolidations := by
    intro source limits action pre post ok notTransfer prior
    simp only [recordBalance, bind_ok_iff, pure, Except.pure, Except.ok.injEq] at ok
    obtain ⟨⟨_, _⟩, _, _, _, rfl⟩ := ok
    intro e member
    rcases List.mem_append.mp member with old | added
    · exact prior e old
    · simp only [List.mem_singleton] at added
      subst added
      exact notTransfer
  have rewardSources : ∀ e ∈ rewardEvents, e.source ≠ .consolidations :=
    replayRewards_induction (config := config)
      (fun pre : BalanceReplay preset fork => ∀ e ∈ pre.2, e.source ≠ .consolidations)
      (fun prior ok => recordStep _ _ _ ok (by simp) prior)
      (fun which prior ok => recordStep _ _ _ ok
        (by rcases which with rfl | rfl <;> simp) prior)
      (by simp) replay
  have consolidationEvents : ∀ e ∈ recorded, e.source = .consolidations →
      PendingConsolidationInvariant config e.before.state := by
    intro e member transfer
    rw [recordedEq] at member
    simp only [electra, ↓reduceDIte, List.mem_append, List.mem_cons,
      List.not_mem_nil, or_false] at member
    rcases member with (old | rfl) | rfl | rfl
    · exact absurd transfer (rewardSources e old)
    · cases transfer
    · cases transfer
    · exact orderedDeposited.1
  -- The stages before the payments record exactly the replay's events.
  rw [← recordedEq] at replayed
  have recordedLength : recorded.length = rewardEvents.length + 3 := by
    simp [recordedEq, electra]
  -- The epoch keeps the slot, so the slot write lands on the first slot of the next epoch.
  obtain ⟨justifiedState, justifiedStep, epochFrame⟩ := processEpoch_frame epochOk
  have epochedSlot : epoched.slot = s.slot :=
    epochFrame.slot.trans ((processJustificationAndFinalization_slot justifiedStep).trans
      cachedSlot)
  have checked : addChecked epoched.slot 1 = .ok nextSlot := by
    rw [epochedSlot]
    have small := nextSlot.toNat_lt
    refine addChecked_ok_iff.mpr ⟨?_, ?_⟩ <;> simp only [UInt64.toNat_one] <;> omega
  have advancedEpoch : getCurrentEpoch { epoched with slot := nextSlot } = next := by
    apply UInt64.toNat_inj.mp
    rw [nextNat, sameEpoch, getCurrentEpoch_toNat, getCurrentEpoch_toNat]
    exact nextSlot_epoch_of_boundary sum last
  have epochedEpoch : getCurrentEpoch epoched = getCurrentEpoch s := by
    simp only [getCurrentEpoch, epochedSlot]
  have later : getCurrentEpoch epoched ≤ getCurrentEpoch { epoched with slot := nextSlot } := by
    rw [advancedEpoch, epochedEpoch, ← sameEpoch]
    exact UInt64.le_iff_toNat_le.mpr (by omega)
  obtain ⟨_, _, _, _, endAssignment, _, endErasure, _, endReserve⟩ := frameEnd
  have slotFrame := reservedFrame_slot (config := config) (checks := checks)
    (rounding := rounding) checked endReserve endAssignment endErasure
  obtain ⟨_, _, _, _, _, _, slotErasure, _, slotReserve⟩ := id slotFrame
  have whole := ReservedReplay.append (.nil cacheFrame)
    (by simpa only [List.length_nil, Nat.add_zero] using replayed)
  have full := ReservedReplay.append whole (.nil (by simpa only [] using slotFrame))
  rw [advancedEpoch]
  have sameEffective : ∀ i, effectiveAt ⟨fork, cached⟩ i = effectiveAt ⟨fork, s⟩ i := by
    intro i
    simp only [effectiveAt, cachedValidators]
  refine ⟨suffix, payments, allocations, lowerOriginal final ⟨fork, epoched⟩, ?_,
    reservedFrame_refl slotReserve endAssignment slotErasure,
    by simpa only [recordedLength] using ownedEnd,
    retiredEnd.lifecycle (.of_data rfl), ?_, ?_, fun tag member => shape.1.1.subset member,
    consolidationEvents, fun pair member => ?_, freshDelay, shape.2.2.2.2.2 apart,
    fun increment down before i => ?_⟩
  · simpa only [List.nil_append, List.append_nil, List.length_nil, Nat.add_zero] using full
  · refine endpointCover_mono (u := ⟨fork, epoched⟩) ?_ (fun _ => Nat.le_refl _) coverEnd
    intro i w found clean notExited current
    exact ⟨w, found, clean, notExited, UInt64.le_trans later current, rfl, le_refl _⟩
  · exact futureCover_records (u := epoched) (v := { epoched with slot := nextSlot }) rfl later
      futureEnd
  · exact Nat.le_of_eq (shape.2.2.2.2.1 pair member).2.2.1
  · have bound := effectiveBound increment down
      (fun i => by rw [sameEffective i]; exact before i) i
    rw [sameEffective i] at bound
    exact bound

end Apriori.Internal
end
end EthLib.Consensus.DirectSafety
end
