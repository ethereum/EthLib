section
namespace EthLib.Consensus.DirectSafety
open Apriori
open Base Cryptography.Bls Uint64
variable {preset : Preset} {config : Config} {checks : SignatureChecks}
noncomputable section
open Classical

namespace Apriori.Internal

abbrev ix (x u : ForkedBeaconState preset) :=
  (getCurrentEpoch u.state).toNat - (getCurrentEpoch x.state).toNat
private theorem penalties_monotone (x : ForkedBeaconState preset) (high : Nat) :
    Monotone (windowPenalties (config := config) x high) := by
  intro a b less
  unfold windowPenalties
  have included : List.range a <+: List.range b := by
    obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le less
    rw [List.range_add]
    exact List.prefix_append _ _
  exact (included.sublist.map _).sum_le_sum (fun _ _ => Nat.zero_le _)

def commonSlashed (x y : ForkedBeaconState preset) (c : Finset BLSPubkey) :=
  Models.stake (effectiveWeight x.state) (c.filter (SlashedAt y.state ·))
def reducedDrift (x y : ForkedBeaconState preset) (c : Finset BLSPubkey) :=
  stateDriftOn (unslashedKeys x.state \ c) x y
def previousOnly (x : ForkedBeaconState preset) : Finset BLSPubkey :=
  keysAt x.state (getActiveValidatorIndices x.state (getPreviousEpoch x.state)) \ activeKeys x.state
def gainWithoutPreviousOnly (x y : ForkedBeaconState preset) : Nat :=
  ∑ k ∈ (recentKeys y.state \ previousOnly x), (effectiveWeight y.state k -
    Models.supported (unslashedKeys x.state) (effectiveWeight x.state) k)

def potential (x : ForkedBeaconState preset) (i : Nat) :=
  (x.state.validators.data[i]?.map fun v => max v.effectiveBalance.toNat
    (min (actualBalanceAt x i) (withdrawalMaxEffectiveBalance preset x.fork v).toNat)).getD 0

structure SelectedCharge where
  index : Nat
  amount : Nat
  epoch : Nat
  paidAt : Nat
inductive QueueTag where
  | initial (position : Nat)
  | fresh (callPosition : Nat)
structure TaggedEntry where
  entry : PendingConsolidation
  tag : QueueTag
  amount : Nat
  epoch : Nat
def QueueErasure (queue : List TaggedEntry) (actual : List PendingConsolidation) : Prop :=
  queue.map (·.entry) = actual
structure Payment (preset : Preset) where
  source : Nat
  target : Nat
  amount : Nat
  epoch : Nat
  before : ForkedBeaconState preset
  after : ForkedBeaconState preset
def Paying (p : Payment preset) : Prop :=
  ∃ v, p.before.state.validators.data[p.source]? = some v ∧ v.slashed = false ∧
    v.withdrawableEpoch.toNat ≤ p.epoch ∧
    p.amount = min (actualBalanceAt p.before p.source) v.effectiveBalance.toNat ∧
    actualBalanceAt p.after p.source + p.amount = actualBalanceAt p.before p.source ∧
    actualBalanceAt p.after p.target = actualBalanceAt p.before p.target + p.amount
inductive PaymentPass {fork : Fork} (next : Epoch) :
    BeaconState preset fork → List PendingConsolidation →
    BeaconState preset fork → Nat → List (Payment preset) → Prop where
  | nil : PaymentPass next s [] s 0 []
  | waiting (found : getValidator s c.sourceIndex = .ok v) (unslashed : v.slashed = false)
      (later : next < v.withdrawableEpoch) : PaymentPass next s (c :: cs) s 0 []
  | slashed (found : getValidator s c.sourceIndex = .ok v) (slashed : v.slashed = true)
      (rest : PaymentPass next s cs t n payments) :
      PaymentPass next s (c :: cs) t (n + 1) payments
  | paid (found : getValidator s c.sourceIndex = .ok v) (unslashed : v.slashed = false)
      (due : v.withdrawableEpoch ≤ next) (balance : getBalance s c.sourceIndex = .ok b)
      (debited : decreaseBalance s c.sourceIndex (min b v.effectiveBalance) = .ok d)
      (credited : increaseBalance d c.targetIndex (min b v.effectiveBalance) = .ok u)
      (rest : PaymentPass next u cs t n payments) :
      PaymentPass next s (c :: cs) t (n + 1)
        (⟨c.sourceIndex.toNat, c.targetIndex.toNat, (min b v.effectiveBalance).toNat,
          next.toNat, ⟨fork, s⟩, ⟨fork, u⟩⟩ :: payments)
def EventPayments (e : BalanceEvent preset) (payments : List (Payment preset)) : Prop :=
  if e.source = .consolidations then
    ∃ fork, ∃ s t u : BeaconState preset fork, ∃ electra : .pectra ≤ fork,
      ∃ next n, e.before = ⟨fork, s⟩ ∧ e.after = ⟨fork, t⟩ ∧
      addChecked (getCurrentEpoch s) 1 = .ok next ∧
      processPendingConsolidations s electra = .ok t ∧
      PaymentPass next s (s.pendingConsolidations electra).data.toList u n payments ∧
      t.validators = u.validators ∧ t.balances = u.balances ∧
      (t.pendingConsolidations electra).data.toList =
        (s.pendingConsolidations electra).data.toList.drop n
  else payments = []
def SelectedPayments (selected : List SelectedCharge) (payments : List (Payment preset))
    (tags : List TaggedEntry) : Prop :=
  selected.length = payments.length ∧ payments.length = tags.length ∧
  ∀ i : Fin selected.length, ∃ p tag,
    payments[i.val]? = some p ∧ tags[i.val]? = some tag ∧ Paying p ∧
    (∃ n, tag.tag = .fresh n) ∧ tag.entry.sourceIndex.toNat = p.source ∧
    tag.entry.targetIndex.toNat = p.target ∧ selected[i].index = p.source ∧
    selected[i].amount = tag.amount ∧ selected[i].epoch = tag.epoch ∧
    selected[i].paidAt = p.epoch
def FreshTags (queue : List TaggedEntry) (calls : List (IndexedDepartureCall preset config)) :
    Prop :=
  (queue.map (·.tag)).Nodup ∧ ∀ e ∈ queue, ∀ n, e.tag = .fresh n →
    ∃ called, calls[n]? = some called ∧ called.index = some e.entry.sourceIndex.toNat ∧
      called.call.amount.toNat = e.amount ∧ called.call.epoch.toNat = e.epoch
def Cutoff (x : ForkedBeaconState preset) (high : Nat) (selected : List SelectedCharge) : Prop :=
  ∀ c ∈ selected, c.epoch + config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat ≤ c.paidAt ∧
    c.paidAt ≤ horizonEnd x high
def SelectedCapacity (x : ForkedBeaconState preset) (high : Nat)
    (selected : List SelectedCharge) : Prop :=
  (selected.map (·.amount)).sum ≤ dueConsolidationCarry (config := config) x high +
      consolidationTransfers (config := config) x high
structure OwnedRelease where
  baseline : Nat
  external : Nat
  sourceRound : Nat
def ReleasePartition (selected : List SelectedCharge) (payments : List (Payment preset))
    (allocations : List OwnedRelease) : Prop :=
  allocations.length = payments.length ∧ selected.length = payments.length ∧
  ∀ i : Fin payments.length, ∃ a c,
    allocations[i.val]? = some a ∧ selected[i.val]? = some c ∧
    payments[i].amount = a.baseline + a.external ∧ a.baseline ≤ c.amount + a.sourceRound
def ActualPaymentCoverage (events : List (BalanceEvent preset))
    (payments : List (Payment preset)) (initial : List PendingConsolidation) : Prop :=
  ∃ perEvent : Fin events.length → List (Payment preset),
    (∀ j, EventPayments events[j] (perEvent j)) ∧
    payments = ((List.finRange events.length).flatMap perEvent).filter fun p =>
      !initial.any (fun c => c.sourceIndex.toNat == p.source)

def initialTags (queue : List PendingConsolidation) : List TaggedEntry :=
  (queue.zipIdx).map fun (entry, position) => ⟨entry, .initial position, 0, 0⟩
def pendingQueue (s : ForkedBeaconState preset) : List PendingConsolidation :=
  if electra : .pectra ≤ s.fork then (s.state.pendingConsolidations electra).data.toList else []
inductive TaggedPass {fork : Fork} (next : Epoch) :
    BeaconState preset fork → List TaggedEntry → BeaconState preset fork →
    List TaggedEntry → List TaggedEntry → List (TaggedEntry × Payment preset) → Prop where
  | nil : TaggedPass next s [] s [] [] []
  | waiting (found : getValidator s tag.entry.sourceIndex = .ok v)
      (unslashed : v.slashed = false) (later : next < v.withdrawableEpoch) :
      TaggedPass next s (tag :: tags) s (tag :: tags) [] []
  | slashed (found : getValidator s tag.entry.sourceIndex = .ok v)
      (slashed : v.slashed = true) (rest : TaggedPass next s tags t suffix consumed payments) :
      TaggedPass next s (tag :: tags) t suffix (tag :: consumed) payments
  | paid (found : getValidator s tag.entry.sourceIndex = .ok v)
      (unslashed : v.slashed = false) (due : v.withdrawableEpoch ≤ next)
      (balance : getBalance s tag.entry.sourceIndex = .ok b)
      (debited : decreaseBalance s tag.entry.sourceIndex (min b v.effectiveBalance) = .ok d)
      (credited : increaseBalance d tag.entry.targetIndex (min b v.effectiveBalance) = .ok u)
      (rest : TaggedPass next u tags t suffix consumed payments) :
      TaggedPass next s (tag :: tags) t suffix (tag :: consumed)
        ((tag, ⟨tag.entry.sourceIndex.toNat, tag.entry.targetIndex.toNat,
          (min b v.effectiveBalance).toNat, next.toNat, ⟨fork, s⟩, ⟨fork, u⟩⟩) :: payments)
def TagEvent (e : BalanceEvent preset) (position : Nat)
    (before after consumed : List TaggedEntry) (payments : List (TaggedEntry × Payment preset))
    (calls : List (IndexedDepartureCall preset config)) : Prop :=
  QueueErasure before (pendingQueue e.before) ∧ QueueErasure after (pendingQueue e.after) ∧
  ((e.source ≠ .consolidations ∧ after = before ∧ consumed = [] ∧ payments = [] ∧ calls = []) ∨
    (∃ fork, ∃ s t : BeaconState preset fork, ∃ electra : .pectra ≤ fork,
      ∃ request sourceIndex source targetIndex called,
      e.source = .excess ∧ e.before = ⟨fork, s⟩ ∧ e.after = ⟨fork, t⟩ ∧
      processConsolidationRequest config s electra request = .ok t ∧
      getValidator s sourceIndex = .ok source ∧
      queueConsolidation config s electra sourceIndex source targetIndex = .ok t ∧
      called.index = some sourceIndex.toNat ∧ called.call.amount = source.effectiveBalance ∧
      called.call.earliest = s.earliestConsolidationEpoch electra ∧
      called.call.available = s.consolidationBalanceToConsume electra ∧
      called.call.epoch = t.earliestConsolidationEpoch electra ∧
      called.call.left = t.consolidationBalanceToConsume electra ∧
      computeActivationExitEpoch preset (getCurrentEpoch s) = .ok called.call.first ∧
      getConsolidationChurnLimit config s = .ok called.call.rate ∧
      after = before ++ [⟨⟨sourceIndex, targetIndex⟩, .fresh position,
        called.call.amount.toNat, called.call.epoch.toNat⟩] ∧
      consumed = [] ∧ payments = [] ∧ calls = [called]) ∨
    (∃ fork, ∃ s t u : BeaconState preset fork, ∃ electra : .pectra ≤ fork, ∃ next,
      e.source = .consolidations ∧ e.before = ⟨fork, s⟩ ∧ e.after = ⟨fork, t⟩ ∧
      addChecked (getCurrentEpoch s) 1 = .ok next ∧
      processPendingConsolidations s electra = .ok t ∧
      TaggedPass next s before u after consumed payments ∧
      t.validators = u.validators ∧ t.balances = u.balances ∧ calls = []))
inductive TagReplay : Nat → List (BalanceEvent preset) → List TaggedEntry →
    List TaggedEntry → List TaggedEntry → List (TaggedEntry × Payment preset) →
    List (IndexedDepartureCall preset config) → Prop where
  | nil : TagReplay position [] queue queue [] [] []
  | cons (one : TagEvent (config := config) e position before middle consumed paidPairs calls)
      (rest : TagReplay (position + calls.length) events middle after removed payments later) :
      TagReplay position (e :: events) before after (consumed ++ removed) (paidPairs ++ payments)
        (calls ++ later)
def FreshPaymentCoverage (events : List (BalanceEvent preset))
    (initial final consumed paidTags : List TaggedEntry) (payments : List (Payment preset))
    (calls : List (IndexedDepartureCall preset config)) : Prop :=
  ∃ allPaid : List (TaggedEntry × Payment preset),
    TagReplay (config := config) 0 events initial final consumed allPaid calls ∧
    let fresh := allPaid.filter fun pair => match pair.1.tag with
      | .fresh _ => true
      | .initial _ => false
    paidTags = fresh.map Prod.fst ∧ payments = fresh.map Prod.snd

inductive TokenOrigin where
  | initial (pot index unit : Nat)
  | credit (event index unit : Nat)
  | released (payment unit : Nat)
  deriving DecidableEq
structure Ownership where
  issued : Finset TokenOrigin
  owner : TokenOrigin → Option Nat
  endpoint : Finset TokenOrigin
  original : Nat → Nat
  retired : Finset Nat
def held (o : Ownership) (i : Nat) : Finset TokenOrigin :=
  o.issued.filter fun token => o.owner token = some i
def OwnershipValid (o : Ownership) : Prop :=
  (∀ token, (o.owner token).isSome → token ∈ o.issued) ∧
    o.endpoint ⊆ o.issued ∧ ∀ token ∈ o.endpoint, (o.owner token).isSome
def OwnedTransfer (paymentPosition : Nat) (p : Payment preset) (allocation : OwnedRelease)
    (before after : Ownership) : Prop :=
  OwnershipValid before ∧ OwnershipValid after ∧
  ∃ moved minted : Finset TokenOrigin,
    moved ⊆ held before p.source ∧ moved.card = allocation.external ∧
    minted = (Finset.range allocation.baseline).image (TokenOrigin.released paymentPosition) ∧
    Disjoint before.issued minted ∧ after.issued = before.issued ∪ minted ∧
    p.amount = allocation.external + allocation.baseline ∧
    allocation.baseline ≤ before.original p.source ∧
    p.source ∉ before.retired ∧ after.retired = insert p.source before.retired ∧
    after.original p.source = 0 ∧
    (∀ i, i ≠ p.source → after.original i = before.original i) ∧
    (∀ token ∈ moved ∪ minted, after.owner token = some p.target) ∧
    (∀ token ∈ held before p.source, token ∉ moved → after.owner token = none) ∧
    (∀ token, token ∉ held before p.source → token ∉ minted →
      after.owner token = before.owner token) ∧
    after.endpoint = (before.endpoint \ held before p.source) ∪ moved ∪ minted
def OwnedCredit (eventPosition : Nat) (e : BalanceEvent preset)
    (before after : Ownership) : Prop :=
  OwnershipValid before ∧ OwnershipValid after ∧
  ∃ minted : Finset TokenOrigin,
    Disjoint before.issued minted ∧ after.issued = before.issued ∪ minted ∧
    (∀ token ∈ minted, ∃ i unit, token = .credit eventPosition i unit ∧
      unit < actualBalanceAt e.after i - actualBalanceAt e.before i ∧
      (e.source = .deposits →
        (e.before.state.validators.data[i]?.map (fun v =>
          decide (v.withdrawableEpoch.toNat ≤ (getCurrentEpoch e.before.state).toNat))).getD
          false = false) ∧
      after.owner token = some i) ∧
    minted.card ≤ (if e.source = .deposits then funding_deposit_credit e
      else if e.source = .rewards ∨ e.source = .sync then e.creditLimit else otherCredit e) ∧
    (∀ token ∈ before.issued, after.owner token = before.owner token) ∧
    after.endpoint = before.endpoint ∪ minted ∧
    after.retired = before.retired ∧
    (∀ i, after.original i ≤ before.original i)
def OwnedFrame (before after : Ownership) : Prop :=
  OwnershipValid before ∧ OwnershipValid after ∧ after.issued = before.issued ∧
  (∀ token, after.owner token = before.owner token ∨ after.owner token = none) ∧
  after.endpoint ⊆ before.endpoint ∧ after.retired = before.retired ∧
    ∀ i, after.original i ≤ before.original i
inductive OwnedPayments : Nat → List (Payment preset) → List OwnedRelease →
    Ownership → Ownership → Prop where
  | nil : OwnedPayments position [] [] o o
  | cons (one : OwnedTransfer position p allocation before middle)
      (rest : OwnedPayments (position + 1) payments allocations middle after) :
      OwnedPayments position (p :: payments) (allocation :: allocations) before after
private theorem OwnedTransfer.source_retirement
    (transfer : OwnedTransfer position p allocation before after) :
    p.source ∉ before.retired ∧ after.retired = insert p.source before.retired := by
  obtain ⟨_, _, moved, minted, _, _, _, _, _, _, _, fresh, retired, _⟩ := transfer
  exact ⟨fresh, retired⟩
private theorem OwnedPayments.source_once {payments : List (Payment preset)}
    (history : OwnedPayments position payments allocations before after) :
    (payments.map (·.source)).Nodup ∧
      ∀ p ∈ payments, p.source ∉ before.retired := by
  induction history with
  | nil => exact ⟨by simp, by simp⟩
  | @cons position p allocation before middle payments allocations after one _ ih =>
    obtain ⟨fresh, retired⟩ := one.source_retirement
    constructor
    · simp only [List.map_cons, List.nodup_cons]
      refine ⟨?_, ih.1⟩
      intro member
      obtain ⟨later, inside, same⟩ := List.mem_map.mp member
      have absent := ih.2 later inside
      rw [retired, same] at absent
      exact absent (Finset.mem_insert_self _ _)
    · intro later member
      rcases List.mem_cons.mp member with rfl | inside
      · exact fresh
      · intro wasRetired
        exact ih.2 later inside (by rw [retired]; exact Finset.mem_insert_of_mem wasRetired)
/-- A transfer zeroes its source's original and keeps every other original. -/
private theorem OwnedTransfer.original_le {position : Nat} {p : Payment preset}
    {allocation : OwnedRelease} {before after : Ownership}
    (transfer : OwnedTransfer position p allocation before after) :
    ∀ i, after.original i ≤ before.original i := by
  obtain ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, source, others, _, _, _, _⟩ := transfer
  intro i
  by_cases same : i = p.source
  · rw [same, source]
    exact Nat.zero_le _
  · rw [others i same]

/-- Owned payments only retire keys and never raise an original.

Each transfer retires its source and keeps the earlier retired keys.

So every paid source ends retired.

Each transfer zeroes its source's original and keeps the others. -/
private theorem OwnedPayments.retired_original {payments : List (Payment preset)}
    (history : OwnedPayments position payments allocations before after) :
    (before.retired ⊆ after.retired ∧ ∀ p ∈ payments, p.source ∈ after.retired) ∧
      ∀ i, after.original i ≤ before.original i := by
  induction history with
  | nil => exact ⟨⟨Finset.Subset.refl _, by simp⟩, fun _ => Nat.le_refl _⟩
  | @cons position p allocation before middle payments allocations after one _ ih =>
    have retired := one.source_retirement.2
    refine ⟨⟨?_, ?_⟩, fun i => Nat.le_trans (ih.2 i) (one.original_le i)⟩
    · intro i member
      apply ih.1.1
      rw [retired]
      exact Finset.mem_insert_of_mem member
    · intro later member
      rcases List.mem_cons.mp member with rfl | inside
      · apply ih.1.1
        rw [retired]
        exact Finset.mem_insert_self _ _
      · exact ih.1.2 later inside

private theorem OwnedPayments.retired_mono {payments : List (Payment preset)}
    (history : OwnedPayments position payments allocations before after) :
    before.retired ⊆ after.retired ∧ ∀ p ∈ payments, p.source ∈ after.retired :=
  history.retired_original.1

/-- Owned payments never raise an original. -/
private theorem OwnedPayments.original_le {payments : List (Payment preset)}
    (history : OwnedPayments position payments allocations before after) :
    ∀ i, after.original i ≤ before.original i :=
  history.retired_original.2

def OwnedEvent (eventPosition paymentPosition : Nat) (e : BalanceEvent preset)
    (tagged : List (TaggedEntry × Payment preset)) (allocations : List OwnedRelease)
    (before after : Ownership) : Prop :=
  if e.source = .consolidations then
    OwnedPayments paymentPosition (tagged.map Prod.snd) allocations before after ∧
      (∀ j : Fin tagged.length, ∃ a, allocations[j.val]? = some a ∧
        (match tagged[j].1.tag with | .initial _ => a.baseline = 0 | .fresh _ => True))
  else tagged = [] ∧ allocations = [] ∧
    (OwnedCredit eventPosition e before after ∨ OwnedFrame before after)
private theorem OwnedEvent.source_once
    {tagged : List (TaggedEntry × Payment preset)}
    (event : OwnedEvent eventPosition paymentPosition e tagged allocations before after) :
    (tagged.map (fun pair => pair.2.source)).Nodup ∧
      before.retired ⊆ after.retired ∧
      ∀ pair ∈ tagged, pair.2.source ∉ before.retired ∧ pair.2.source ∈ after.retired := by
  unfold OwnedEvent at event
  split at event
  · have once := event.1.source_once
    have mono := event.1.retired_mono
    refine ⟨?_, mono.1, ?_⟩
    · simpa only [List.map_map, Function.comp_def] using once.1
    · intro pair member
      have paid : pair.2 ∈ tagged.map Prod.snd := List.mem_map.mpr ⟨pair, member, rfl⟩
      exact ⟨once.2 pair.2 paid, mono.2 pair.2 paid⟩
  · obtain ⟨rfl, _, credit | frame⟩ := event
    · obtain ⟨_, _, minted, _, _, _, _, _, _, retired, _⟩ := credit
      exact ⟨by simp, retired ▸ Finset.Subset.refl _, by simp⟩
    · exact ⟨by simp, frame.2.2.2.2.2.1 ▸ Finset.Subset.refl _, by simp⟩
def initialPot (x : ForkedBeaconState preset) (high pot index : Nat) : Nat × Nat :=
  if pot = 0 then (index,
    if (x.state.validators.data[index]?).any
        (fun v => isActiveValidator v (getCurrentEpoch x.state))
    then actualBalanceAt x index - effectiveAt x index else 0)
  else if pot = 1 then (index,
    (x.state.validators.data[index]?.map fun v =>
      if !isActiveValidator v (getCurrentEpoch x.state) &&
          decide (getCurrentEpoch x.state < v.exitEpoch) then potential x index else 0).getD 0)
  else match (pendingQueue x)[index]? with
    | none => (0, 0)
    | some entry =>
      let i := entry.sourceIndex.toNat
      (i, (x.state.validators.data[i]?.map fun v =>
        if v.withdrawableEpoch.toNat ≤ horizonEnd x high then
          if pot = 2 then min (actualBalanceAt x i) v.effectiveBalance.toNat
          else if pot = 3 && !isActiveValidator v (getCurrentEpoch x.state) then
            min (actualBalanceAt x i) (withdrawalMaxEffectiveBalance preset x.fork v).toNat -
              v.effectiveBalance.toNat
          else 0
        else 0).getD 0)
def OwnedInitial (x : ForkedBeaconState preset) (high : Nat) (o : Ownership) : Prop :=
  OwnershipValid o ∧ o.retired = ∅ ∧
    o.issued.card ≤ initialExcess x + preActiveStake x +
        dueConsolidationCredits x (driftHorizon x high) + pendingSourceExcess x high ∧
    (∀ token ∈ o.issued, ∃ pot index unit, token = .initial pot index unit ∧ pot < 4 ∧
      unit < (initialPot x high pot index).2 ∧
      o.owner token = some (initialPot x high pot index).1) ∧
    (∀ token ∈ o.endpoint, ∃ pot index unit, token = .initial pot index unit ∧ pot < 2) ∧
    (∀ i, o.original i = if (x.state.validators.data[i]?).any (fun v =>
      isActiveValidator v (getCurrentEpoch x.state) && !v.slashed &&
        v.exitEpoch == FAR_FUTURE_EPOCH) then effectiveAt x i else 0)
def NewReference (x : ForkedBeaconState preset) (i : Nat) : Prop :=
  (x.state.validators.data[i]?).any (fun v => isActiveValidator v (getCurrentEpoch x.state) &&
    !v.slashed && v.exitEpoch == FAR_FUTURE_EPOCH)
def InitialPending (x : ForkedBeaconState preset) (high i : Nat) : Prop :=
  ∃ c ∈ pendingQueue x, c.sourceIndex.toNat = i ∧
    (x.state.validators.data[i]?.map (·.withdrawableEpoch.toNat)).getD (horizonEnd x high + 1) ≤
        horizonEnd x high
def SupportedAt (epoch : Epoch) (v : Validator) : Prop :=
  v.slashed = false ∧
    (isActiveValidator v epoch ∨ isActiveValidator v (epoch - 1))
def FundingRelevant (u : ForkedBeaconState preset) (epoch : Epoch)
    (suffix : List PendingConsolidation) (i : Nat) : Prop :=
  ∃ v, u.state.validators.data[i]? = some v ∧
    (SupportedAt epoch v ∨ epoch < v.withdrawableEpoch ∨
      ∃ c ∈ suffix, c.sourceIndex.toNat = i)
def ReserveCut (x : ForkedBeaconState preset) (high : Nat)
    (u : ForkedBeaconState preset) (demandEpoch : Epoch)
    (suffix : List PendingConsolidation) (o : Ownership) : Prop :=
  OwnershipValid o ∧
    (∀ i ∈ o.retired, ∀ v, u.state.validators.data[i]? = some v →
      (∀ epoch, demandEpoch ≤ epoch → ¬ SupportedAt epoch v) ∧
        ¬ ∃ c ∈ suffix, c.sourceIndex.toNat = i) ∧
    (∀ i, o.original i ≤ effectiveAt x i ∧ (¬ NewReference x i → o.original i = 0)) ∧
    (∀ i, NewReference x i → i ∉ o.retired → FundingRelevant u demandEpoch suffix i →
      max (effectiveAt u i) (actualBalanceAt u i) ≤ o.original i + (held o i).card) ∧
    (∀ i initial v, x.state.validators.data[i]? = some initial →
      isActiveValidator initial (getCurrentEpoch x.state) → initial.slashed = false →
      initial.exitEpoch ≠ FAR_FUTURE_EPOCH → u.state.validators.data[i]? = some v →
      (∃ epoch, demandEpoch ≤ epoch ∧ SupportedAt epoch v) →
      max (effectiveAt u i)
        (min (actualBalanceAt u i) (withdrawalMaxEffectiveBalance preset u.fork v).toNat) ≤
          effectiveAt x i + (held o i ∩ o.endpoint).card) ∧
    (∀ i, InitialPending x high i → i ∉ o.retired →
      FundingRelevant u demandEpoch suffix i → ∀ v,
      u.state.validators.data[i]? = some v →
      min (actualBalanceAt u i) (withdrawalMaxEffectiveBalance preset u.fork v).toNat ≤
        (held o i).card) ∧
    (∀ c ∈ suffix, ∀ v, u.state.validators.data[c.sourceIndex.toNat]? = some v →
      v.withdrawableEpoch ≤ demandEpoch → ¬ NewReference x c.sourceIndex.toNat →
      min (actualBalanceAt u c.sourceIndex.toNat)
        (withdrawalMaxEffectiveBalance preset u.fork v).toNat ≤
          (held o c.sourceIndex.toNat).card) ∧
    (∀ i v, u.state.validators.data[i]? = some v → ¬ NewReference x i →
      (¬ ∃ c ∈ pendingQueue x, c.sourceIndex.toNat = i) →
      (x.state.validators.data[i]?).all (fun initial =>
        !isActiveValidator initial (getCurrentEpoch x.state) &&
          !isActiveValidator initial (getPreviousEpoch x.state)) →
      (SupportedAt demandEpoch v ∨ demandEpoch < v.activationEpoch ∧ demandEpoch < v.exitEpoch ∨
        (∃ c ∈ suffix, c.sourceIndex.toNat = i) ∧
          (¬ ∃ c ∈ pendingQueue x, c.sourceIndex.toNat = i)) →
      max (effectiveAt u i)
        (min (actualBalanceAt u i) (withdrawalMaxEffectiveBalance preset u.fork v).toNat) ≤
          (held o i).card) ∧
    (∀ i, InitialPending x high i → ∀ v initial,
      u.state.validators.data[i]? = some v → x.state.validators.data[i]? = some initial →
      isActiveValidator initial (getCurrentEpoch x.state) → i ∉ o.retired →
      FundingRelevant u demandEpoch suffix i →
      min (actualBalanceAt u i) (withdrawalMaxEffectiveBalance preset u.fork v).toNat ≤
        effectiveAt x i + (held o i ∩ o.endpoint).card ∧
      effectiveAt u i ≤ effectiveAt x i + (held o i ∩ o.endpoint).card) ∧
    (∀ i v, u.state.validators.data[i]? = some v → SupportedAt demandEpoch v →
      v.pubkey ∉ previousOnly x →
      effectiveAt u i ≤ Models.supported (unslashedKeys x.state) (effectiveWeight x.state)
        v.pubkey + (held o i ∩ o.endpoint).card)
def AssignmentCut (rounding : Nat → Nat) (queue : List TaggedEntry) (o : Ownership) : Prop :=
  ∀ tag ∈ queue, ∀ position, tag.tag = .fresh position →
    o.original tag.entry.sourceIndex.toNat ≤ tag.amount + rounding tag.entry.sourceIndex.toNat
private theorem assignmentCut_transport
    (cut : AssignmentCut rounding queue before)
    (decreasing : ∀ i, after.original i ≤ before.original i)
    (retained : suffix.Sublist queue) : AssignmentCut rounding suffix after := by
  intro tag member position fresh
  exact (decreasing _).trans (cut tag (retained.subset member) position fresh)
inductive ReservedPayments (x : ForkedBeaconState preset) (high : Nat) (rounding : Nat → Nat)
    {fork : Fork} (next : Epoch) : Nat → BeaconState preset fork → List TaggedEntry →
    BeaconState preset fork → List TaggedEntry → List (TaggedEntry × Payment preset) →
    List OwnedRelease → Ownership → Ownership → Prop where
  | nil (reserve : ReserveCut x high ⟨fork, s⟩ next [] o) :
      ReservedPayments x high rounding next position s [] s [] [] [] o o
  | waiting (found : getValidator s tag.entry.sourceIndex = .ok v)
      (unslashed : v.slashed = false) (later : next < v.withdrawableEpoch)
      (reserve : ReserveCut x high ⟨fork, s⟩ next ((tag :: tags).map (·.entry)) o)
      (assignment : AssignmentCut rounding (tag :: tags) o) :
      ReservedPayments x high rounding next position s (tag :: tags) s (tag :: tags) [] [] o o
  | slashed (found : getValidator s tag.entry.sourceIndex = .ok v)
      (slashed : v.slashed = true)
      (reserve : ReserveCut x high ⟨fork, s⟩ next ((tag :: tags).map (·.entry)) before)
      (assignment : AssignmentCut rounding (tag :: tags) before)
      (rest : ReservedPayments x high rounding next position s tags t suffix payments allocations
        before after) :
      ReservedPayments x high rounding next position s (tag :: tags) t suffix payments allocations
        before after
  | paid (found : getValidator s tag.entry.sourceIndex = .ok v)
      (unslashed : v.slashed = false) (due : v.withdrawableEpoch ≤ next)
      (balance : getBalance s tag.entry.sourceIndex = .ok b)
      (debited : decreaseBalance s tag.entry.sourceIndex (min b v.effectiveBalance) = .ok d)
      (credited : increaseBalance d tag.entry.targetIndex (min b v.effectiveBalance) = .ok u)
      (reserve : ReserveCut x high ⟨fork, s⟩ next ((tag :: tags).map (·.entry)) before)
      (assignment : AssignmentCut rounding (tag :: tags) before)
      (round : allocation.sourceRound = rounding tag.entry.sourceIndex.toNat)
      (moved : OwnedTransfer position
        ⟨tag.entry.sourceIndex.toNat, tag.entry.targetIndex.toNat,
          (min b v.effectiveBalance).toNat, next.toNat, ⟨fork, s⟩, ⟨fork, u⟩⟩
        allocation before middle)
      (initialNoRelease : match tag.tag with
        | .initial _ => allocation.baseline = 0
        | .fresh _ => allocation.baseline ≤ tag.amount + allocation.sourceRound ∧
            before.original tag.entry.sourceIndex.toNat ≤ tag.amount + allocation.sourceRound)
      (rest : ReservedPayments x high rounding next (position + 1) u tags t suffix payments
            allocations
        middle after) :
      ReservedPayments x high rounding next position s (tag :: tags) t suffix
        ((tag, ⟨tag.entry.sourceIndex.toNat, tag.entry.targetIndex.toNat,
          (min b v.effectiveBalance).toNat, next.toNat, ⟨fork, s⟩, ⟨fork, u⟩⟩) :: payments)
        (allocation :: allocations) before after
def ReservedEvent (x : ForkedBeaconState preset) (high eventPosition paymentPosition : Nat)
    (rounding : Nat → Nat)
    (e : BalanceEvent preset) (queue suffix : List TaggedEntry)
    (tagged : List (TaggedEntry × Payment preset)) (allocations : List OwnedRelease)
    (before after : Ownership) : Prop :=
  OwnedEvent eventPosition paymentPosition e tagged allocations before after ∧
    AssignmentCut rounding queue before ∧ AssignmentCut rounding suffix after ∧
    if e.source = .consolidations then
      ∃ fork, ∃ s t u : BeaconState preset fork, ∃ electra : .pectra ≤ fork, ∃ next,
        e.before = ⟨fork, s⟩ ∧ e.after = ⟨fork, t⟩ ∧
        addChecked (getCurrentEpoch s) 1 = .ok next ∧
        processPendingConsolidations s electra = .ok t ∧
        t.validators = u.validators ∧ t.balances = u.balances ∧
        ReservedPayments x high rounding next paymentPosition s queue u suffix tagged allocations
            before after
    else ReserveCut x high e.before (getCurrentEpoch e.before.state) (queue.map (·.entry)) before ∧
      ReserveCut x high e.after (getCurrentEpoch e.after.state) (suffix.map (·.entry)) after
inductive SilentStage : EpochStage → Prop where
  | justification : SilentStage .justification
  | inactivity : SilentStage .inactivity
  | registry : SilentStage .registry
  | eth1Reset : SilentStage .eth1Reset
  | payments : SilentStage .payments
  | effectiveBalances : SilentStage .effectiveBalances
  | slashingsReset : SilentStage .slashingsReset
  | randaoReset : SilentStage .randaoReset
  | history : SilentStage .history
  | participation : SilentStage .participation
  | syncCommittees : SilentStage .syncCommittees
  | proposerLookahead : SilentStage .proposerLookahead
  | ptcWindow : SilentStage .ptcWindow
inductive FrameStep (config : Config) (checks : SignatureChecks) :
    ForkedBeaconState preset → ForkedBeaconState preset → Prop where
  | cache {fork : Fork} {s t : BeaconState preset fork}
      (ok : processSlot s = .ok t) : FrameStep config checks ⟨fork, s⟩ ⟨fork, t⟩
  | epoch {fork : Fork} {s t : BeaconState preset fork}
      (silent : SilentStage stage) (ok : EpochStage.action config checks stage s = .ok t) :
      FrameStep config checks ⟨fork, s⟩ ⟨fork, t⟩
  | slot {fork : Fork} {s : BeaconState preset fork} (checked : addChecked s.slot 1 = .ok next) :
      FrameStep config checks ⟨fork, s⟩ ⟨fork, { s with slot := next }⟩
  | upgrade (ok : upgradeNext config checks s = .ok t)
      (silent : s.fork ≠ .dencun) : FrameStep config checks s t.val
  | header {fork : Fork} {s t : BeaconState preset fork} {block : BeaconBlock preset fork}
      (ok : processBlockHeader s block = .ok t) : FrameStep config checks ⟨fork, s⟩ ⟨fork, t⟩
  | randao {fork : Fork} {s t : BeaconState preset fork} {body : BeaconBlockBody preset fork}
      (ok : processRandao config checks s body = .ok t) :
      FrameStep config checks ⟨fork, s⟩ ⟨fork, t⟩
  | eth1 {fork : Fork} {s t : BeaconState preset fork} {body : BeaconBlockBody preset fork}
      (early : fork < .hegota) (ok : processEth1Data early s body = .ok t) :
      FrameStep config checks ⟨fork, s⟩ ⟨fork, t⟩
  | exit {fork : Fork} {s t : BeaconState preset fork} {exit : SignedVoluntaryExit}
      (ok : processVoluntaryExit config checks s exit = .ok t) :
      FrameStep config checks ⟨fork, s⟩ ⟨fork, t⟩
  | credentials {fork : Fork} {s t : BeaconState preset fork} {change : SignedBLSToExecutionChange}
      (ok : processBlsToExecutionChange config checks s change = .ok t) :
      FrameStep config checks ⟨fork, s⟩ ⟨fork, t⟩
  | depositRequest {fork : Fork} {s t : BeaconState preset fork} {request : DepositRequest}
      (electra : .pectra ≤ fork) (ok : processDepositRequest s electra request = .ok t) :
      FrameStep config checks ⟨fork, s⟩ ⟨fork, t⟩
  | withdrawalRequest {fork : Fork} {s t : BeaconState preset fork} {request : WithdrawalRequest}
      (electra : .pectra ≤ fork)
      (ok : processWithdrawalRequest config s electra request = .ok t) :
      FrameStep config checks ⟨fork, s⟩ ⟨fork, t⟩
inductive FramePath (config : Config) (checks : SignatureChecks) :
    ForkedBeaconState preset → ForkedBeaconState preset → Prop where
  | nil : FramePath config checks s s
  | cons (step : FrameStep config checks s u)
      (rest : FramePath config checks u t) : FramePath config checks s t
private theorem FramePath.trans (one : FramePath config checks s u)
    (two : FramePath config checks u t) : FramePath config checks s t := by
  induction one with
  | nil => exact two
  | cons step _ ih => exact .cons step (ih two)
private theorem epochTrace_framePath {fork : Fork} {s t : BeaconState preset fork}
    (trace : EpochTrace (EpochStage.action config checks) stages s t)
    (silent : ∀ stage ∈ stages, SilentStage stage) :
    FramePath config checks ⟨fork, s⟩ ⟨fork, t⟩ := by
  induction trace with
  | nil => exact .nil
  | cons first rest ih =>
    exact .cons (.epoch (silent _ List.mem_cons_self) first)
      (ih (fun stage member => silent stage (List.mem_cons_of_mem _ member)))
private theorem epochSuffix_framePath {fork : Fork} {s t : BeaconState preset fork}
    (trace : EpochTrace (EpochStage.action config checks)
      (EpochStage.middleStages ++ EpochStage.tailStages) s t) :
    FramePath config checks ⟨fork, s⟩ ⟨fork, t⟩ := by
  apply epochTrace_framePath trace
  intro stage member
  simp only [EpochStage.middleStages, EpochStage.tailStages, List.mem_append,
    List.mem_cons, List.not_mem_nil, or_false] at member
  rcases member with (h | h | h | h | h) | (h | h | h | h) <;> subst stage
  · exact .payments
  · exact .effectiveBalances
  · exact .slashingsReset
  · exact .randaoReset
  · exact .history
  · exact .participation
  · exact .syncCommittees
  · exact .proposerLookahead
  · exact .ptcWindow
private theorem foldlM_framePath {α : Type} {fork : Fork}
    (action : BeaconState preset fork → α → Except TransitionError (BeaconState preset fork))
    (items : List α) {s t : BeaconState preset fork}
    (ok : items.foldlM action s = .ok t)
    (native : ∀ item ∈ items, ∀ a b, action a item = .ok b →
      FrameStep config checks ⟨fork, a⟩ ⟨fork, b⟩) :
    FramePath config checks ⟨fork, s⟩ ⟨fork, t⟩ :=
  foldlM_ok_invariant_of_mem (fun u => FramePath config checks ⟨fork, s⟩ ⟨fork, u⟩)
    (fun u item v member path computed => path.trans (.cons (native item member u v computed) .nil))
    .nil ok
private theorem processEpoch_suffix_framePath {fork : Fork} {s t : BeaconState preset fork}
    (ok : processEpoch config checks s = .ok t) :
    ∃ middle, EpochTrace (EpochStage.action config checks) EpochStage.prefixStages s middle ∧
      FramePath config checks ⟨fork, middle⟩ ⟨fork, t⟩ := by
  have trace := processEpoch_trace ok
  change EpochTrace _ (EpochStage.prefixStages ++
    (EpochStage.middleStages ++ EpochStage.tailStages)) s t at trace
  obtain ⟨middle, headTrace, tailTrace⟩ := EpochTrace.append_iff.mp trace
  exact ⟨middle, headTrace, epochSuffix_framePath tailTrace⟩
def ReservedFrame (x : ForkedBeaconState preset) (high : Nat) (rounding : Nat → Nat)
    (u v : ForkedBeaconState preset) (fromEpoch toEpoch : Epoch)
    (queue : List TaggedEntry) (before after : Ownership) : Prop :=
  FramePath (config := config) (checks := checks) u v ∧
    fromEpoch ≤ toEpoch ∧ OwnedFrame before after ∧
    AssignmentCut rounding queue before ∧ AssignmentCut rounding queue after ∧
    QueueErasure queue (pendingQueue u) ∧ QueueErasure queue (pendingQueue v) ∧
    ReserveCut x high u fromEpoch (queue.map (·.entry)) before ∧
    ReserveCut x high v toEpoch (queue.map (·.entry)) after
private theorem OwnedFrame.trans (one : OwnedFrame before middle)
    (two : OwnedFrame middle after) : OwnedFrame before after := by
  obtain ⟨validBefore, _, issuedOne, ownersOne, endpointOne, retiredOne, originalOne⟩ := one
  obtain ⟨_, validAfter, issuedTwo, ownersTwo, endpointTwo, retiredTwo, originalTwo⟩ := two
  refine ⟨validBefore, validAfter, issuedTwo.trans issuedOne, ?_,
    endpointTwo.trans endpointOne, retiredTwo.trans retiredOne, ?_⟩
  · intro token
    rcases ownersTwo token with same | erased
    · rcases ownersOne token with kept | erased
      · exact Or.inl (same.trans kept)
      · exact Or.inr (same.trans erased)
    · exact Or.inr erased
  · intro i
    exact (originalTwo i).trans (originalOne i)
private theorem ReservedFrame.trans
    (one : ReservedFrame (config := config) (checks := checks) x high rounding
      u v fromEpoch middleEpoch queue before middle)
    (two : ReservedFrame (config := config) (checks := checks) x high rounding
      v w middleEpoch toEpoch queue middle after) :
    ReservedFrame (config := config) (checks := checks) x high rounding
      u w fromEpoch toEpoch queue before after := by
  obtain ⟨pathOne, epochOne, frameOne, assignmentBefore, _, erasureBefore, _,
    reserveBefore, _⟩ := one
  obtain ⟨pathTwo, epochTwo, frameTwo, _, assignmentAfter, _, erasureAfter, _,
    reserveAfter⟩ := two
  exact ⟨pathOne.trans pathTwo, UInt64.le_trans epochOne epochTwo, frameOne.trans frameTwo,
    assignmentBefore, assignmentAfter, erasureBefore, erasureAfter, reserveBefore, reserveAfter⟩
private theorem reserveCut_slot {fork : Fork} {s : BeaconState preset fork}
    (reserve : ReserveCut x high ⟨fork, s⟩ epoch suffix owned) :
    ReserveCut x high ⟨fork, { s with slot := next }⟩ epoch suffix owned := by
  simpa only [ReserveCut, FundingRelevant, effectiveAt, actualBalanceAt, pendingQueue]
    using reserve
private theorem reservedFrame_slot {fork : Fork} {s : BeaconState preset fork}
    (checked : addChecked s.slot 1 = .ok next)
    (reserve : ReserveCut x high ⟨fork, s⟩ epoch (queue.map (·.entry)) owned)
    (assignment : AssignmentCut rounding queue owned)
    (erasure : QueueErasure queue (pendingQueue ⟨fork, s⟩)) :
    ReservedFrame (config := config) (checks := checks) x high rounding
      ⟨fork, s⟩ ⟨fork, { s with slot := next }⟩ epoch epoch queue owned owned := by
  have identity : OwnedFrame owned owned :=
    ⟨reserve.1, reserve.1, rfl, fun _ => Or.inl rfl,
      Finset.Subset.refl _, rfl, fun _ => Nat.le_refl _⟩
  exact ⟨.cons (.slot checked) .nil, UInt64.le_refl _, identity, assignment, assignment,
    erasure, erasure, reserve, reserveCut_slot reserve⟩
private theorem reserveCut_cache {fork : Fork} {s t : BeaconState preset fork}
    (ok : processSlot s = .ok t)
    (reserve : ReserveCut x high ⟨fork, s⟩ epoch suffix owned) :
    ReserveCut x high ⟨fork, t⟩ epoch suffix owned := by
  obtain ⟨_, _, _, _, rfl⟩ := processSlot_ok ok
  simpa only [ReserveCut, FundingRelevant, effectiveAt, actualBalanceAt,
    getCurrentEpoch, pendingQueue] using reserve
private theorem reserveCut_justification {fork : Fork} {s t : BeaconState preset fork}
    (ok : processJustificationAndFinalization s = .ok t)
    (reserve : ReserveCut x high ⟨fork, s⟩ epoch suffix owned) :
    ReserveCut x high ⟨fork, t⟩ epoch suffix owned := by
  obtain rfl | ⟨_, _, _, weighed⟩ := processJustificationAndFinalization_ok ok
  · exact reserve
  · obtain ⟨_, _, _, rest⟩ := weighJustificationAndFinalization_checkpoints weighed
    rw [← rest] at reserve
    simpa only [ReserveCut, FundingRelevant, effectiveAt, actualBalanceAt,
      getCurrentEpoch, pendingQueue] using reserve
private theorem reserveCut_inactivity {fork : Fork} {s t : BeaconState preset fork}
    {altair : .altair ≤ fork} (ok : processInactivityUpdates config s altair = .ok t)
    (reserve : ReserveCut x high ⟨fork, s⟩ epoch suffix owned) :
    ReserveCut x high ⟨fork, t⟩ epoch suffix owned := by
  unfold processInactivityUpdates at ok
  split at ok
  · simp only [pure, Except.pure, Except.ok.injEq] at ok
    exact ok ▸ reserve
  · simp only [bind_ok_iff, pure, Except.pure, Except.ok.injEq] at ok
    obtain ⟨_, _, _, _, rfl⟩ := ok
    simpa only [ReserveCut, FundingRelevant, effectiveAt, actualBalanceAt,
      getCurrentEpoch, pendingQueue] using reserve
private theorem reservedFrame_cache {fork : Fork} {s t : BeaconState preset fork}
    (ok : processSlot s = .ok t)
    (reserve : ReserveCut x high ⟨fork, s⟩ epoch (queue.map (·.entry)) owned)
    (assignment : AssignmentCut rounding queue owned)
    (erasure : QueueErasure queue (pendingQueue ⟨fork, s⟩)) :
    ReservedFrame (config := config) (checks := checks) x high rounding
      ⟨fork, s⟩ ⟨fork, t⟩ epoch epoch queue owned owned := by
  have sameQueue : pendingQueue ⟨fork, t⟩ = pendingQueue ⟨fork, s⟩ := by
    obtain ⟨_, _, _, _, rfl⟩ := processSlot_ok ok
    rfl
  have identity : OwnedFrame owned owned := by
    exact ⟨reserve.1, reserve.1, rfl, fun _ => Or.inl rfl,
      Finset.Subset.refl _, rfl, fun _ => Nat.le_refl _⟩
  exact ⟨.cons (.cache ok) .nil, UInt64.le_refl _, identity, assignment, assignment,
    erasure, sameQueue ▸ erasure, reserve, reserveCut_cache ok reserve⟩
private theorem reservedFrame_advanceSlot_nonlast {fork : Fork} {s t : BeaconState preset fork}
    (ok : advanceSlot config checks s = .ok t)
    (nonlast : ∀ next, addChecked s.slot 1 = .ok next →
      next % preset.SLOTS_PER_EPOCH ≠ 0)
    (reserve : ReserveCut x high ⟨fork, s⟩ epoch (queue.map (·.entry)) owned)
    (assignment : AssignmentCut rounding queue owned)
    (erasure : QueueErasure queue (pendingQueue ⟨fork, s⟩)) :
    ReservedFrame (config := config) (checks := checks) x high rounding
      ⟨fork, s⟩ ⟨fork, t⟩ epoch epoch queue owned owned := by
  simp only [advanceSlot, bind_ok_iff, liftAccessor_ok, liftArith, mapError_ok_iff,
    pure, Except.pure, Except.ok.injEq] at ok
  obtain ⟨next, nextOk, cached, cacheOk, epoched, epochOk, rfl⟩ := ok
  have notLast := nonlast next nextOk
  simp only [epochIfLast, notLast, ↓reduceIte, pure, Except.pure, Except.ok.injEq] at epochOk
  subst epoched
  have checked : addChecked cached.slot 1 = .ok next := by
    rw [processSlot_slot cacheOk]
    exact nextOk
  have first := reservedFrame_cache (config := config) (checks := checks)
    cacheOk reserve assignment erasure
  have last := reservedFrame_slot (config := config) (checks := checks)
    checked first.2.2.2.2.2.2.2.2 first.2.2.2.2.1 first.2.2.2.2.2.2.1
  exact first.trans last
private theorem reservedFrame_advanceSlot_inside {fork : Fork} {s t : BeaconState preset fork}
    (ok : advanceSlot config checks s = .ok t)
    (nonlast : ∀ next, addChecked s.slot 1 = .ok next →
      next % preset.SLOTS_PER_EPOCH ≠ 0)
    (reserve : ReserveCut x high ⟨fork, s⟩ (getCurrentEpoch s) (queue.map (·.entry)) owned)
    (assignment : AssignmentCut rounding queue owned)
    (erasure : QueueErasure queue (pendingQueue ⟨fork, s⟩)) :
    ReservedFrame (config := config) (checks := checks) x high rounding
      ⟨fork, s⟩ ⟨fork, t⟩ (getCurrentEpoch s) (getCurrentEpoch t) queue owned owned := by
  have sameEpoch : getCurrentEpoch t = getCurrentEpoch s := by
    obtain ⟨next, cached, epoched, sum, cachedOk, epochedOk, rfl⟩ := advanceSlot_ok ok
    have checked : addChecked s.slot 1 = .ok next :=
      addChecked_ok_iff.mpr ⟨by
        change s.slot.toNat + 1 < 2 ^ 64
        have small := next.toNat_lt
        omega, sum⟩
    have notLast := nonlast next checked
    simp only [epochIfLast, notLast, ↓reduceIte, pure, Except.pure, Except.ok.injEq] at epochedOk
    subst epoched
    apply UInt64.toNat_inj.mp
    rw [getCurrentEpoch_toNat, getCurrentEpoch_toNat]
    exact nextSlot_epoch_of_inside sum notLast
  rw [sameEpoch]
  exact reservedFrame_advanceSlot_nonlast ok nonlast reserve assignment erasure
private theorem reservedFrame_justification {fork : Fork} {s t : BeaconState preset fork}
    (ok : processJustificationAndFinalization s = .ok t)
    (reserve : ReserveCut x high ⟨fork, s⟩ epoch (queue.map (·.entry)) owned)
    (assignment : AssignmentCut rounding queue owned)
    (erasure : QueueErasure queue (pendingQueue ⟨fork, s⟩)) :
    ReservedFrame (config := config) (checks := checks) x high rounding
      ⟨fork, s⟩ ⟨fork, t⟩ epoch epoch queue owned owned := by
  have sameQueue : pendingQueue ⟨fork, t⟩ = pendingQueue ⟨fork, s⟩ := by
    obtain rfl | ⟨_, _, _, weighed⟩ := processJustificationAndFinalization_ok ok
    · rfl
    · obtain ⟨_, _, _, rest⟩ := weighJustificationAndFinalization_checkpoints weighed
      rw [← rest]
      rfl
  have identity : OwnedFrame owned owned :=
    ⟨reserve.1, reserve.1, rfl, fun _ => Or.inl rfl,
      Finset.Subset.refl _, rfl, fun _ => Nat.le_refl _⟩
  exact ⟨.cons (.epoch .justification ok) .nil, UInt64.le_refl _, identity,
    assignment, assignment, erasure, sameQueue ▸ erasure, reserve,
    reserveCut_justification ok reserve⟩
private theorem reservedFrame_inactivity {fork : Fork} {s t : BeaconState preset fork}
    (ok : EpochStage.action config checks .inactivity s = .ok t)
    (reserve : ReserveCut x high ⟨fork, s⟩ epoch (queue.map (·.entry)) owned)
    (assignment : AssignmentCut rounding queue owned)
    (erasure : QueueErasure queue (pendingQueue ⟨fork, s⟩)) :
    ReservedFrame (config := config) (checks := checks) x high rounding
      ⟨fork, s⟩ ⟨fork, t⟩ epoch epoch queue owned owned := by
  have transport : ReserveCut x high ⟨fork, t⟩ epoch (queue.map (·.entry)) owned ∧
      pendingQueue ⟨fork, t⟩ = pendingQueue ⟨fork, s⟩ := by
    simp only [EpochStage.action] at ok
    split at ok
    · constructor
      · exact reserveCut_inactivity ok reserve
      · unfold processInactivityUpdates at ok
        split at ok
        · simp only [pure, Except.pure, Except.ok.injEq] at ok
          subst t
          rfl
        · simp only [bind_ok_iff, pure, Except.pure, Except.ok.injEq] at ok
          obtain ⟨_, _, _, _, rfl⟩ := ok
          rfl
    · simp only [pure, Except.pure, Except.ok.injEq] at ok
      subst t
      exact ⟨reserve, rfl⟩
  have identity : OwnedFrame owned owned :=
    ⟨reserve.1, reserve.1, rfl, fun _ => Or.inl rfl,
      Finset.Subset.refl _, rfl, fun _ => Nat.le_refl _⟩
  exact ⟨.cons (.epoch .inactivity ok) .nil, UInt64.le_refl _, identity,
    assignment, assignment, erasure, transport.2 ▸ erasure, reserve, transport.1⟩
def eventDemandEpoch (e : BalanceEvent preset) : Epoch :=
  if e.source = .consolidations then getCurrentEpoch e.before.state + 1
  else getCurrentEpoch e.after.state
inductive ReservedReplay (x : ForkedBeaconState preset) (high : Nat) (rounding : Nat → Nat) :
    ForkedBeaconState preset → Epoch → ForkedBeaconState preset → Epoch →
    Nat → Nat → Nat → List (BalanceEvent preset) → List TaggedEntry → List TaggedEntry →
    List (TaggedEntry × Payment preset) → List OwnedRelease →
    List (IndexedDepartureCall preset config) → Ownership → Ownership → Prop where
  | nil (frame : ReservedFrame (config := config) (checks := checks)
        x high rounding start finish startEpoch finishEpoch queue before after) :
      ReservedReplay x high rounding start startEpoch finish finishEpoch
        eventPosition paymentPosition callPosition [] queue queue [] [] [] before after
  | cons (frame : ReservedFrame (config := config) (checks := checks) x high rounding start e.before
        startEpoch
        (getCurrentEpoch e.before.state) queue before eventOwned)
      (taggedEvent : TagEvent (config := config) e callPosition queue middle consumed tagged calls)
      (ownedEvent : ReservedEvent x high eventPosition paymentPosition rounding e queue middle
        tagged allocations eventOwned midOwned)
      (rest : ReservedReplay x high rounding e.after (eventDemandEpoch e) finish finishEpoch
        (eventPosition + 1) (paymentPosition + tagged.length)
        (callPosition + calls.length) events middle final payments restAllocations restCalls
        midOwned after) :
      ReservedReplay x high rounding start startEpoch finish finishEpoch
        eventPosition paymentPosition callPosition (e :: events) queue final
        (tagged ++ payments) (allocations ++ restAllocations) (calls ++ restCalls) before after
private theorem ReservedPayments.paired_rounds
    {tagged : List (TaggedEntry × Payment preset)}
    (history : ReservedPayments x high rounding next position s queue t
      suffix tagged allocations before after) :
    List.Forall₂ (fun pair allocation => allocation.sourceRound = rounding pair.2.source)
      tagged allocations := by
  induction history with
  | nil => exact .nil
  | waiting => exact .nil
  | slashed _ _ _ _ _ ih => exact ih
  | paid _ _ _ _ _ _ _ _ round _ _ _ ih => exact .cons round ih
private theorem ReservedEvent.paired_rounds
    {tagged : List (TaggedEntry × Payment preset)}
    (event : ReservedEvent x high eventPosition paymentPosition rounding e
      queue suffix tagged allocations before after) :
    List.Forall₂ (fun pair allocation => allocation.sourceRound = rounding pair.2.source)
      tagged allocations := by
  by_cases consolidation : e.source = .consolidations
  · have pass := event.2.2.2
    simp only [consolidation, ↓reduceIte] at pass
    obtain ⟨_, _, _, _, _, _, _, _, _, _, _, _, pass⟩ := pass
    exact pass.paired_rounds
  · have empty := event.1
    unfold OwnedEvent at empty
    simp only [consolidation, ↓reduceIte] at empty
    rw [empty.1, empty.2.1]
    exact .nil
private theorem ReservedReplay.paired_rounds
    {tagged : List (TaggedEntry × Payment preset)}
    (history : ReservedReplay (config := config) (checks := checks) x high rounding
      start startEpoch finish finishEpoch eventPosition paymentPosition callPosition
      events queue final tagged allocations calls before after) :
    List.Forall₂ (fun pair allocation => allocation.sourceRound = rounding pair.2.source)
      tagged allocations := by
  induction history with
  | nil => exact .nil
  | cons _ _ event _ ih => exact List.rel_append event.paired_rounds ih
private theorem ReservedPayments.paired_releases
    {tagged : List (TaggedEntry × Payment preset)}
    (history : ReservedPayments x high rounding next position s queue t
      suffix tagged allocations before after) :
    List.Forall₂ (fun pair allocation => (match pair.1.tag with
      | .initial _ => allocation.baseline = 0
      | .fresh _ => allocation.baseline ≤ pair.1.amount + allocation.sourceRound) ∧
        pair.2.amount = allocation.external + allocation.baseline)
      tagged allocations := by
  induction history with
  | nil => exact .nil
  | waiting => exact .nil
  | slashed _ _ _ _ _ ih => exact ih
  | paid _ _ _ _ _ _ _ _ _ moved baseline _ ih =>
    refine .cons ⟨?_, moved.2.2.choose_spec.choose_spec.2.2.2.2.2.1⟩ ih
    split <;> simp_all
private theorem ReservedEvent.paired_releases
    {tagged : List (TaggedEntry × Payment preset)}
    (event : ReservedEvent x high eventPosition paymentPosition rounding e
      queue suffix tagged allocations before after) :
    List.Forall₂ (fun pair allocation => (match pair.1.tag with
      | .initial _ => allocation.baseline = 0
      | .fresh _ => allocation.baseline ≤ pair.1.amount + allocation.sourceRound) ∧
        pair.2.amount = allocation.external + allocation.baseline)
      tagged allocations := by
  by_cases consolidation : e.source = .consolidations
  · have pass := event.2.2.2
    simp only [consolidation, ↓reduceIte] at pass
    obtain ⟨_, _, _, _, _, _, _, _, _, _, _, _, pass⟩ := pass
    exact pass.paired_releases
  · have empty := event.1
    unfold OwnedEvent at empty
    simp only [consolidation, ↓reduceIte] at empty
    rw [empty.1, empty.2.1]
    exact .nil
private theorem ReservedReplay.paired_releases
    {tagged : List (TaggedEntry × Payment preset)}
    (history : ReservedReplay (config := config) (checks := checks) x high rounding
      start startEpoch finish finishEpoch eventPosition paymentPosition callPosition
      events queue final tagged allocations calls before after) :
    List.Forall₂ (fun pair allocation => (match pair.1.tag with
      | .initial _ => allocation.baseline = 0
      | .fresh _ => allocation.baseline ≤ pair.1.amount + allocation.sourceRound) ∧
        pair.2.amount = allocation.external + allocation.baseline)
      tagged allocations := by
  induction history with
  | nil => exact .nil
  | cons _ _ event _ ih => exact List.rel_append event.paired_releases ih
private theorem ReservedReplay.paired_baselines
    {tagged : List (TaggedEntry × Payment preset)}
    (history : ReservedReplay (config := config) (checks := checks) x high rounding
      start startEpoch finish finishEpoch eventPosition paymentPosition callPosition
      events queue final tagged allocations calls before after) :
    List.Forall₂ (fun pair allocation => match pair.1.tag with
      | .initial _ => allocation.baseline = 0
      | .fresh _ => allocation.baseline ≤ pair.1.amount + allocation.sourceRound)
      tagged allocations :=
  history.paired_releases.imp fun _ _ both => both.1
private theorem ReservedReplay.source_once
    {tagged : List (TaggedEntry × Payment preset)}
    (history : ReservedReplay (config := config) (checks := checks) x high rounding
      start startEpoch finish finishEpoch eventPosition paymentPosition callPosition
      events queue final tagged allocations calls before after) :
    (tagged.map (fun pair => pair.2.source)).Nodup ∧
      before.retired ⊆ after.retired ∧
      ∀ pair ∈ tagged, pair.2.source ∉ before.retired ∧ pair.2.source ∈ after.retired := by
  induction history with
  | nil frame =>
    have retired := frame.2.2.1.2.2.2.2.2.1
    exact ⟨by simp, retired ▸ Finset.Subset.refl _, by simp⟩
  | cons frame _ ownedEvent _ ih =>
    have retired := frame.2.2.1.2.2.2.2.2.1
    have first := ownedEvent.1.source_once
    rw [retired] at first
    refine ⟨?_, first.2.1.trans ih.2.1, ?_⟩
    · simp only [List.map_append, List.nodup_append]
      refine ⟨first.1, ih.1, ?_⟩
      intro source headMember target tailMember same
      obtain ⟨head, headInside, headEq⟩ := List.mem_map.mp headMember
      obtain ⟨later, laterInside, laterEq⟩ := List.mem_map.mp tailMember
      have retiredHead := (first.2.2 head headInside).2
      have fresh := (ih.2.2 later laterInside).1
      rw [headEq] at retiredHead
      rw [laterEq, ← same] at fresh
      exact fresh retiredHead
    · intro pair member
      rcases List.mem_append.mp member with head | later
      · exact ⟨(first.2.2 pair head).1, ih.2.1 (first.2.2 pair head).2⟩
      · exact ⟨fun old => (ih.2.2 pair later).1 (first.2.1 old), (ih.2.2 pair later).2⟩
private theorem source_round_sum_le (sources : List Nat) (carrier : Finset Nat) (increment : Nat)
    (unique : sources.Nodup) :
    (sources.map fun i => if i ∈ carrier then increment else 0).sum ≤ increment * carrier.card := by
  have exactSum : (sources.map fun i => if i ∈ carrier then increment else 0).sum =
      increment * (sources.filter (fun i => decide (i ∈ carrier))).length := by
    clear unique
    induction sources with
    | nil => simp
    | cons i rest ih =>
      by_cases inside : i ∈ carrier <;> simp [inside, ih, Nat.mul_add, Nat.add_comm]
  rw [exactSum]
  have sub : (sources.filter (fun i => decide (i ∈ carrier))).toFinset ⊆ carrier := by
    intro i member
    exact of_decide_eq_true (List.mem_filter.mp (List.mem_toFinset.mp member)).2
  have count := Finset.card_le_card sub
  rw [List.toFinset_card_of_nodup (unique.filter _)] at count
  exact Nat.mul_le_mul_left increment count
private theorem zip_fst_sublist {α β : Type} (left : List α) (right : List β) :
    ((left.zip right).map Prod.fst).Sublist left := by
  induction left generalizing right with
  | nil => simp
  | cons a left ih =>
    cases right with
    | nil => simp
    | cons b right => exact (ih right).cons_cons a
private theorem ReservedReplay.selected_allocation_round_sum_le
    {tagged : List (TaggedEntry × Payment preset)}
    (history : ReservedReplay (config := config) (checks := checks) x high rounding
      start startEpoch finish finishEpoch eventPosition paymentPosition callPosition
      events queue final tagged allocations calls before after)
    (select : (TaggedEntry × Payment preset) × OwnedRelease → Bool)
    (carrier : Finset Nat) (increment : Nat)
    (rounds : ∀ pair ∈ (tagged.zip allocations).filter select,
      pair.2.sourceRound = if pair.1.2.source ∈ carrier then increment else 0) :
    (((tagged.zip allocations).filter select).map fun pair => pair.2.sourceRound).sum ≤
      increment * carrier.card := by
  have selectedSub : (((tagged.zip allocations).filter select).map Prod.fst).Sublist tagged :=
    (List.filter_sublist.map _).trans (zip_fst_sublist tagged allocations)
  have unique := history.source_once.1.sublist (selectedSub.map (fun pair => pair.2.source))
  have count := source_round_sum_le _ carrier increment unique
  simp only [List.map_map, Function.comp_def] at count
  have same := List.map_congr_left rounds
  rw [same]
  exact count
private theorem ReservedReplay.selected_round_sum_le
    {tagged : List (TaggedEntry × Payment preset)}
    (carrier : Finset Nat) (increment : Nat)
    (history : ReservedReplay (config := config) (checks := checks) x high
      (fun i => if i ∈ carrier then increment else 0)
      start startEpoch finish finishEpoch eventPosition paymentPosition callPosition
      events queue final tagged allocations calls before after)
    (select : (TaggedEntry × Payment preset) × OwnedRelease → Bool) :
    tagged.length = allocations.length ∧
      (((tagged.zip allocations).filter select).map fun pair => pair.2.sourceRound).sum ≤
        increment * carrier.card := by
  refine ⟨history.paired_rounds.length_eq,
    history.selected_allocation_round_sum_le select carrier increment ?_⟩
  intro pair member
  exact List.forall₂_zip history.paired_rounds (List.mem_filter.mp member).1
def EndpointDemand (x y : ForkedBeaconState preset) (o : Ownership) : Prop :=
  ∀ k ∈ recentKeys y.state \ previousOnly x,
    ∃ i, y.state.validators.data[i]?.any (fun v => v.pubkey == k) ∧
      effectiveWeight y.state k - Models.supported (unslashedKeys x.state)
        (effectiveWeight x.state) k ≤ (held o i ∩ o.endpoint).card
def CumulativeFunding (x y : ForkedBeaconState preset) (high : Nat)
    (events : List (BalanceEvent preset)) (selected : List SelectedCharge)
    (allocations : List OwnedRelease) (before after : Ownership) : Prop :=
  let initial := after.issued.filter fun token => match token with
    | .initial _ _ _ => true | _ => false
  let credits := after.issued.filter fun token => match token with
    | .credit _ _ _ => true | _ => false
  let releases := after.issued.filter fun token => match token with
    | .released _ _ => true | _ => false
  initial = before.issued ∧
    credits.card ≤ (events.map funding_deposit_credit).sum +
      sourceCredits .rewards events + sourceCredits .sync events + (events.map otherCredit).sum ∧
    releases.card = (allocations.map (·.baseline)).sum ∧
    (events.map funding_deposit_credit).sum + fundingCarry y ≤
      fundingCarry x +
          ((List.range (driftHorizon x high + 1)).map (exitFlowAt (config := config) x high)).sum ∧
    sourceCredits .rewards events + sourceCredits .sync events ≤
        windowIssuance (config := config) x high ∧
    (events.map otherCredit).sum ≤ whistleblowerAllowanceAt (config := config) x high ∧
    (selected.map (·.amount)).sum ≤ dueConsolidationCarry (config := config) x high +
        consolidationTransfers (config := config) x high ∧
    releases.card ≤ (selected.map (·.amount)).sum + roundingBudget (config := config) x high ∧
    after.issued.card = initial.card + credits.card + releases.card
private theorem cumulativeFunding_bound
    (electra : .pectra ≤ x.fork) (initial : OwnedInitial x high before)
    (funding : CumulativeFunding (config := config) x y high events selected allocations before
          after) :
    after.issued.card ≤ gainBudget (config := config) x high := by
  obtain ⟨same, credit, _released, deposits, rewards, other, charges, release, total⟩ := funding
  have start := initial.2.2.1
  unfold gainBudget activationBudget creditBudget
  simp only [ite_eq_left electra]
  have noCrossing : preElectraEpochs config x high = 0 := by
    have notBefore : ¬ x.fork < .pectra := Nat.not_lt_of_ge electra
    simp only [preElectraEpochs, notBefore, ↓reduceIte]
  simp only [noCrossing, Nat.lt_irrefl, ↓reduceIte, Nat.add_zero]
  rw [same] at total
  omega
def TerminalAllocation (x y : ForkedBeaconState preset) (o : Ownership)
    (tokens : BLSPubkey → Finset TokenOrigin) : Prop :=
    (∀ k ∈ recentKeys y.state \ previousOnly x,
      tokens k ⊆ o.endpoint ∧
      ∃ i, y.state.validators.data[i]?.any (fun v => v.pubkey == k) ∧
        tokens k ⊆ held o i ∧
        (tokens k).card = effectiveWeight y.state k -
          Models.supported (unslashedKeys x.state) (effectiveWeight x.state) k) ∧
    (∀ k ∈ recentKeys y.state \ previousOnly x,
      ∀ l ∈ recentKeys y.state \ previousOnly x, k ≠ l → Disjoint (tokens k) (tokens l)) ∧
    (∑ k ∈ (recentKeys y.state \ previousOnly x) ∩ unslashedKeys x.state,
      (tokens k).card) +
      (∑ k ∈ (recentKeys y.state \ previousOnly x) \ unslashedKeys x.state,
        (tokens k).card) ≤ o.issued.card
private theorem new_reference_loss_boundary_le
    (U supported boundary departed : Finset Nat) (e w a d : Nat → Nat)
    (boundary_supported : boundary ⊆ supported) (boundary_U : boundary ⊆ U)
    (departed_U : departed ⊆ U)
    (departed_iff : ∀ i ∈ U, i ∈ departed ↔ i ∉ supported)
    (stopped : ∀ i ∈ boundary ∪ departed, e i ≤ a i + d i)
    (retained : ∀ i ∈ U, i ∈ supported → i ∉ boundary → e i ≤ w i + d i) :
    (∑ i ∈ U, (e i - (if i ∈ supported then w i else 0))) +
      (∑ i ∈ boundary, w i) ≤
    (∑ i ∈ boundary ∪ departed, a i) + (∑ i ∈ U, d i) +
      (∑ i ∈ boundary, (w i - e i)) := by
  have subset : boundary ∪ departed ⊆ U := Finset.union_subset boundary_U departed_U
  have pointwise : ∀ i ∈ U,
      e i - (if i ∈ supported then w i else 0) + (if i ∈ boundary then w i else 0) ≤
      (if i ∈ boundary ∪ departed then a i else 0) + d i +
        (if i ∈ boundary then w i - e i else 0) := by
    intro i inside
    by_cases b : i ∈ boundary
    · have s := boundary_supported b
      have stop := stopped i (Finset.mem_union_left _ b)
      simp only [s, b, Finset.mem_union, true_or, ↓reduceIte]
      omega
    · by_cases s : i ∈ supported
      · have notDeparted : i ∉ departed := fun h => (departed_iff i inside).mp h s
        have keep := retained i inside s b
        simp only [s, b, notDeparted, Finset.mem_union, or_self, ↓reduceIte]
        omega
      · have dep := (departed_iff i inside).mpr s
        have stop := stopped i (Finset.mem_union_right _ dep)
        simp only [s, b, dep, Finset.mem_union, or_true, ↓reduceIte, Nat.sub_zero]
        exact stop
  have bound := Finset.sum_le_sum pointwise
  simpa only [Finset.sum_add_distrib, ← Finset.sum_filter,
    Finset.filter_mem_eq_inter, Finset.inter_eq_right.mpr boundary_U,
    Finset.inter_eq_right.mpr subset] using bound
structure Stop {x y : ForkedBeaconState preset} (tail : Run config checks x y) (i : Nat) where
  state : ForkedBeaconState preset
  pre : Run config checks x state
  post : Run config checks state y
  split : pre.append post = tail
  charge : Option DepartureCharge
  selected : match charge with
    | none => state = y ∧ ∀ c ∈ tail.departureCharges, c.index ≠ i
    | some c => c ∈ tail.departureCharges ∧ c.index = i ∧
        c.amount = effectiveAt state i ∧
        ∃ next, ∃ step : Step config checks state next,
          ∃ remaining : Run config checks next y,
            (pre.snoc step).append remaining = tail ∧ c ∈ step.departureCharges ∧
            ∃ v w, state.state.validators.data[i]? = some v ∧
              next.state.validators.data[i]? = some w ∧ v.exitEpoch = FAR_FUTURE_EPOCH ∧
              w.exitEpoch ≠ FAR_FUTURE_EPOCH ∧ w.exitEpoch.toNat = c.epoch
private theorem Stop.selected_prefix_exit_unset {x y m : ForkedBeaconState preset}
    {tail : Run config checks x y} (stop : Stop tail i)
    (chosen : stop.charge = some c) (rest : Run config checks m stop.state)
    (v : Validator) (found : m.state.validators.data[i]? = some v) :
    v.exitEpoch = FAR_FUTURE_EPOCH := by
  have actual := stop.selected
  rw [chosen] at actual
  obtain ⟨next, step, remaining, fullSplit, occurs, before, after,
    atStop, atNext, unset, assigned, epoch⟩ := actual.2.2.2
  obtain ⟨last, located, kept⟩ := rest.registryLifecycle.validators i v found
  have same := Option.some.inj (located.symm.trans atStop)
  subst last
  by_contra set
  have fixed := kept.exitEpoch set
  exact set (fixed.symm.trans unset)
private theorem Stop.selected_prefix_exit_gt {x y m : ForkedBeaconState preset}
    {tail : Run config checks x y} (stop : Stop tail i)
    (chosen : stop.charge = some c) (rest : Run config checks m stop.state)
    (v : Validator) (found : m.state.validators.data[i]? = some v)
    (finite : cutoff < FAR_FUTURE_EPOCH.toNat) : cutoff < v.exitEpoch.toNat := by
  rw [stop.selected_prefix_exit_unset chosen rest v found]
  exact finite
private theorem prefix_exit_gt_of_endpoint
    {i cutoff : Nat}
    (rest : Run config checks m y) (v w : Validator)
    (before : m.state.validators.data[i]? = some v)
    (after : y.state.validators.data[i]? = some w)
    (retained : cutoff < w.exitEpoch.toNat) : cutoff < v.exitEpoch.toNat := by
  obtain ⟨last, found, life⟩ := rest.registryLifecycle.validators i v before
  have same := Option.some.inj (found.symm.trans after)
  subst last
  exact retained.trans_le (floor_exit_le life)
private theorem Stop.exists {x y : ForkedBeaconState preset}
    (tail : Run config checks x y) (i : Nat) : Nonempty (Stop tail i) := by
  induction tail with
  | nil =>
    exact ⟨⟨x, .nil, .nil, rfl, none, by simp [Run.departureCharges]⟩⟩
  | @snoc middle last pre step ih =>
    obtain ⟨stop⟩ := ih
    cases chosen : stop.charge with
    | some c =>
      have selected := stop.selected
      rw [chosen] at selected
      obtain ⟨member, index, amount, next, assignedStep, rest, split, charged,
        v, w, before, after, unset, assigned, epoch⟩ := selected
      refine ⟨⟨stop.state, stop.pre, stop.post.snoc step,
        congrArg (fun r => r.snoc step) stop.split, some c, ?_⟩⟩
      exact ⟨List.mem_append_left _ member, index, amount, next, assignedStep,
        rest.snoc step, congrArg (fun r => r.snoc step) split, charged,
        v, w, before, after, unset, assigned, epoch⟩
    | none =>
      have absent := stop.selected
      rw [chosen] at absent
      by_cases latest : ∃ c ∈ step.departureCharges, c.index = i
      · obtain ⟨c, member, index⟩ := latest
        obtain ⟨⟨v, j⟩, present, added⟩ := List.mem_filterMap.mp member
        dsimp only at added
        split at added
        · cases added
        · rename_i w after
          split at added
          · rename_i exits
            cases Option.some.inj added
            change j = i at index
            subst j
            have before := List.mem_zipIdx_iff_getElem?.mp present
            rw [Array.getElem?_toList] at before
            simp only [Bool.and_eq_true, beq_iff_eq, bne_iff_ne] at exits
            refine ⟨⟨middle, pre, Run.nil.snoc step, rfl,
              some ⟨i, w.exitEpoch.toNat, v.effectiveBalance.toNat⟩, ?_⟩⟩
            exact ⟨List.mem_append_right _ member, rfl,
              by simp [effectiveAt, before], last, step, .nil, rfl, member,
              v, w, before, after, exits.1, exits.2, rfl⟩
          · cases added
      · refine ⟨⟨last, pre.snoc step, .nil, rfl, none, rfl, ?_⟩⟩
        intro c member index
        rcases List.mem_append.mp member with prior | current
        · exact absent.2 c prior index
        · exact latest ⟨c, current, index⟩
section RunContracts
variable {g x y : ForkedBeaconState preset}

def Supported (_shared : Run config checks g x) (_tail : Run config checks x y) (high : Nat) :
    Prop :=
  Genesis (config := config) (checks := checks) g ∧ Parameters preset ∧ CapOrder preset ∧
    MaxEffectiveBalancesAligned preset ∧ y.fork < .glamsterdam ∧
    (getCurrentEpoch y.state).toNat ≤ high + 1 ∧ aprioriGuardAt config x high
def FirstDown (tail : Run config checks x y) (i : Nat) : Prop :=
  ∃ j before after, tail.balancePath[j]? = some before ∧
    tail.balancePath[j + 1]? = some after ∧ effectiveAt after i < effectiveAt before i ∧
    ∀ k u v, k < j → tail.balancePath[k]? = some u →
      tail.balancePath[k + 1]? = some v → effectiveAt u i ≤ effectiveAt v i
private theorem FloorTrace.unslashed_balance_floor
    {low base quotient : Nat} {a b : FloorAccount}
    (trace : FloorTrace low base quotient a b)
    (initial : low ≤ a.balance + a.debt) (unslashed : b.slashedHigh = none) :
    low ≤ b.balance + b.debt := by
  induction trace with
  | nil => exact initial
  | credit prior paid ih =>
    have bound := ih unslashed
    dsimp only at *
    omega
  | debit prior paid ih =>
    have bound := ih unslashed
    dsimp only at *
    omega
  | sweep prior paid ih =>
    dsimp only at *
    omega
  | update prior backed ih => exact ih unslashed
  | slash prior unused paid cap ih => cases unslashed
private theorem FloorTrace.unslashed_high_deficit
    {low base quotient : Nat} {a b : FloorAccount}
    (trace : FloorTrace low base quotient a b) (unslashed : b.slashedHigh = none) :
    b.high - b.balance ≤ (a.high - a.balance) + b.debt := by
  induction trace with
  | nil => omega
  | credit prior paid ih =>
    have bound := ih unslashed
    dsimp only at *
    omega
  | debit prior paid ih =>
    have bound := ih unslashed
    dsimp only at *
    omega
  | sweep prior paid ih =>
    dsimp only at *
    omega
  | update prior backed ih =>
    have bound := ih unslashed
    dsimp only at *
    omega
  | slash prior unused paid cap ih => cases unslashed
private theorem FloorTrace.replay_deficit_resources
    {x middle : ForkedBeaconState preset} {i old : Nat}
    {prefixEvents events : List (BalanceEvent preset)}
    {low base quotient : Nat} {account : FloorAccount}
    (trace : FloorTrace low base quotient
      ⟨actualBalanceAt x i, 0, effectiveAt x i, none⟩ account)
    (clean : account.slashedHigh = none)
    (balance : account.balance = actualBalanceAt middle i)
    (effective : old ≤ account.high)
    (debt : account.debt =
      ((prefixEvents ++ events).map (floorPenaltyDebit i)).sum +
      ((prefixEvents ++ events).map (floorPartialDebit (UInt64.ofNat i))).sum) :
    old - actualBalanceAt middle i ≤ (effectiveAt x i - actualBalanceAt x i) +
      ((prefixEvents ++ events).map (floorPenaltyDebit i)).sum +
      ((prefixEvents ++ events).map (floorPartialDebit (UInt64.ofNat i))).sum := by
  have bound := FloorTrace.unslashed_high_deficit trace clean
  dsimp only at bound
  rw [balance, debt] at bound
  omega
private theorem floor_slot_before_update {g x m y : ForkedBeaconState preset}
    (shared : Run config checks g x) (pre : Run config checks x m)
    (genesis : Genesis (config := config) (checks := checks) g) (caps : CapOrder preset)
    (ok : advanceSlotAcross config checks m = .ok y) (early : y.fork < .glamsterdam)
    (delay : 0 < config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    {events : List (BalanceEvent preset)} (replayed : (Step.slot ok).balanceEvents = .ok events)
    (i : ValidatorIndex) (v u w : Validator)
    (initial : x.state.validators.data[i.toNat]? = some v)
    (middle : m.state.validators.data[i.toNat]? = some u)
    (final : y.state.validators.data[i.toNat]? = some w)
    (unslashed : v.slashed = false)
    (short : (getCurrentEpoch m.state).toNat < (getCurrentEpoch x.state).toNat +
      preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat -
        (preset.EPOCHS_PER_SLASHINGS_VECTOR / 2).toNat)
    (high : Nat) (endEpoch : (getCurrentEpoch y.state).toNat ≤ high + 1)
    (retained : high + 1 < w.exitEpoch.toNat)
    (noCrossing : ∀ e ∈ events, e.source ≠ .crossing)
    {low base quotient : Nat} {a b : FloorAccount} (trace : FloorTrace low base quotient a b)
    (balance : b.balance = actualBalanceAt m i.toNat)
    (budget : (if b.slashedHigh.isSome then 1 else 0) +
      events.countP (floorSlash i.toNat) ≤ 1)
    (capped : max low b.high ≤ (withdrawalMaxEffectiveBalance preset m.fork u).toNat) :
    ∃ before advanced, FloorTrace low base quotient a before ∧
      advanceSlot config checks m.state = .ok advanced ∧
      before.balance = actualBalanceAt ⟨m.fork, advanced⟩ i.toNat ∧
      before.debt = b.debt + (events.map (floorPenaltyDebit i.toNat)).sum +
        (events.map (floorPartialDebit i)).sum ∧
      before.high = b.high ∧
      (if before.slashedHigh.isSome then 1 else 0) =
        (if b.slashedHigh.isSome then 1 else 0) + events.countP (floorSlash i.toNat) := by
  let step := Step.slot ok
  have holds := (run_justified_separated (shared.append pre) genesis).1
  obtain ⟨advanced, advanceOk, upgrades⟩ := bind_ok_iff.mp ok
  obtain ⟨p, first, second, path, split, empty, start, ends, linked,
    _empty', _, _, _, crossed⟩ := step.balanceChain early replayed
  have pathEq : step.balancePath = [m, ⟨m.fork, advanced⟩, y] := by
    simp [step, Step.balancePath, advanceOk, Except.toOption]
  have point : p = ⟨m.fork, advanced⟩ := by
    rw [pathEq] at path
    rcases path with ⟨impossible, _⟩ | same
    · simp at impossible
    · simpa using same.symm
  subst p
  have none : second = [] := List.eq_nil_iff_forall_not_mem.mpr (fun e member =>
    noCrossing e (split ▸ List.mem_append_right first member) (crossed pathEq e member))
  subst second
  simp only [List.append_nil] at split
  subst first
  have sites := step.balanceEvents_sites early holds caps.compounding replayed
  have slash := slot_delayed_slashing_nondebit pre ok caps early holds delay replayed
    i v u initial middle unslashed short
  obtain ⟨before, folded, nil, finish, debt, kept, used⟩ := FloorTrace.step_events step caps early
    holds replayed i u w middle final high
    (fun e member => (sites e member).2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1.trans endEpoch)
    (fun e member pending => by
      have bound := (sites e member).2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 pending
      omega) retained noCrossing (List.Sublist.refl events)
    (linked.imp (fun _ _ h => h i.toNat))
    trace (fun e member => balance.trans (start e member i.toNat).symm) budget capped
    (fun e member source c prior balance _ _ => by
      obtain ⟨paid, validators⟩ := slash e member source
      have zero : floorSlash i.toNat e = false := by
        simp only [floorSlash, validators]
        cases found : e.before.state.validators.data[i.toNat]? with
        | none => simp
        | some z => cases z.slashed <;> simp
      exact ⟨{ c with balance := actualBalanceAt e.after i.toNat },
        prior.credit (by omega), rfl, by simp [floorPenaltyDebit, penaltyDebit,
          floorPartialDebit, source], rfl, by simp [zero]⟩)
  have atBefore : before.balance = actualBalanceAt ⟨m.fork, advanced⟩ i.toNat := by
    cases events with
    | nil => exact (nil rfl).trans (balance.trans (empty rfl i.toNat).symm)
    | cons e rest =>
      have found := List.getLast?_eq_some_getLast (l := e :: rest) (by simp)
      exact (finish _ found).trans (ends _ found i.toNat)
  exact ⟨before, advanced, folded, advanceOk, atBefore, debt, kept, used⟩
private theorem slot_update_deficit_resources {g x m y : ForkedBeaconState preset}
    (shared : Run config checks g x) (pre : Run config checks x m)
    (genesis : Genesis (config := config) (checks := checks) g) (caps : CapOrder preset)
    (ok : advanceSlotAcross config checks m = .ok y) (early : y.fork < .glamsterdam)
    (delay : 0 < config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    {prefixEvents events : List (BalanceEvent preset)}
    (replayed : (Step.slot ok).balanceEvents = .ok events)
    (i : ValidatorIndex) (v u w : Validator)
    (initial : x.state.validators.data[i.toNat]? = some v)
    (located : m.state.validators.data[i.toNat]? = some u)
    (final : y.state.validators.data[i.toNat]? = some w)
    (unslashed : v.slashed = false) (clean : w.slashed = false)
    (short : (getCurrentEpoch m.state).toNat < (getCurrentEpoch x.state).toNat +
      preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat -
        (preset.EPOCHS_PER_SLASHINGS_VECTOR / 2).toNat)
    (high : Nat) (endEpoch : (getCurrentEpoch y.state).toNat ≤ high + 1)
    (retained : high + 1 < w.exitEpoch.toNat)
    (noCrossing : ∀ e ∈ events, e.source ≠ .crossing)
    {low base quotient : Nat} {account : FloorAccount}
    (trace : FloorTrace low base quotient
      ⟨actualBalanceAt x i.toNat, 0, effectiveAt x i.toNat, none⟩ account)
    (balance : account.balance = actualBalanceAt m i.toNat)
    (unmarked : account.slashedHigh = none)
    (debt : account.debt = (prefixEvents.map (floorPenaltyDebit i.toNat)).sum +
      (prefixEvents.map (floorPartialDebit i)).sum)
    (capped : max low account.high ≤ (withdrawalMaxEffectiveBalance preset m.fork u).toNat)
    (covered : effectiveAt m i.toNat ≤ account.high)
    {advanced middle : BeaconState preset m.fork}
    (advanceOk : advanceSlot config checks m.state = .ok advanced)
    (middleBalance : advanced.balances = middle.balances) :
    effectiveAt m i.toNat - actualBalanceAt ⟨m.fork, middle⟩ i.toNat ≤
      (effectiveAt x i.toNat - actualBalanceAt x i.toNat) +
        ((prefixEvents ++ events).map (floorPenaltyDebit i.toNat)).sum +
        ((prefixEvents ++ events).map (floorPartialDebit i)).sum := by
  have holds := (run_justified_separated (shared.append pre) genesis).1
  have count := floorSlash_step_bound (.slot ok) caps early holds replayed
    i.toNat u w located final
  have zero : events.countP (floorSlash i.toNat) = 0 := by
    simp only [clean, Bool.false_eq_true, ↓reduceIte] at count
    omega
  have budget : (if account.slashedHigh.isSome then 1 else 0) +
      events.countP (floorSlash i.toNat) ≤ 1 := by simp [unmarked, zero]
  obtain ⟨before, actual, folded, actualOk, atBefore, exactDebt, sameHigh, used⟩ :=
    floor_slot_before_update shared pre genesis caps ok early delay replayed i v u w
      initial located final unslashed short high endEpoch retained noCrossing trace balance
      budget capped
  have same : actual = advanced := Except.ok.inj (actualOk.symm.trans advanceOk)
  subst actual
  have beforeClean : before.slashedHigh = none := by
    simp only [unmarked, Option.isSome_none, Bool.false_eq_true, ↓reduceIte, zero,
      Nat.zero_add] at used
    cases flag : before.slashedHigh with
    | none => rfl
    | some n => simp [flag] at used
  have atMiddle : before.balance = actualBalanceAt ⟨m.fork, middle⟩ i.toNat := by
    simpa only [actualBalanceAt, middleBalance] using atBefore
  have totalDebt : before.debt =
      ((prefixEvents ++ events).map (floorPenaltyDebit i.toNat)).sum +
      ((prefixEvents ++ events).map (floorPartialDebit (UInt64.ofNat i.toNat))).sum := by
    simp only [UInt64.ofNat_toNat, List.map_append, List.sum_append]
    omega
  have bound := FloorTrace.replay_deficit_resources folded beforeClean atMiddle
    (covered.trans (Nat.le_of_eq sameHigh.symm)) totalDebt
  simpa only [UInt64.ofNat_toNat] using bound
private theorem effective_loss_le_of_routed_floor
    (shared : Run config checks g x) (tail : Run config checks x y)
    (genesis : Genesis (config := config) (checks := checks) g) (caps : CapOrder preset)
    (increment : 0 < preset.EFFECTIVE_BALANCE_INCREMENT.toNat) (early : y.fork < .glamsterdam)
    (v : Validator) (found : x.state.validators.data[i]? = some v)
    (activated : v.activationEpoch ≠ FAR_FUTURE_EPOCH) (debt : Nat)
    (floor : ∀ p ∈ tail.balancePath,
      min (effectiveAt x i) (actualBalanceAt x i) ≤ actualBalanceAt p i + debt) :
    effectiveAt x i ≤ effectiveAt y i + (effectiveAt x i - actualBalanceAt x i) + debt +
      (preset.EFFECTIVE_BALANCE_INCREMENT.toNat - 1) := by
  let amount := min (effectiveAt x i) (actualBalanceAt x i) - debt
  let rounded := amount - amount % preset.EFFECTIVE_BALANCE_INCREMENT.toNat
  have amount_le : amount ≤ v.effectiveBalance.toNat := by
    have effective : effectiveAt x i = v.effectiveBalance.toNat := by simp [effectiveAt, found]
    dsimp [amount]
    omega
  have rounded_le : rounded ≤ amount := Nat.sub_le _ _
  have small : rounded < 2 ^ 64 := lt_of_le_of_lt (rounded_le.trans amount_le)
    v.effectiveBalance.toNat_lt
  let reference : Gwei := rounded.toUInt64
  have value : reference.toNat = rounded := by
    dsimp [reference]
    rw [Nat.toUInt64_eq, UInt64.toNat_ofNat_of_lt' small]
  have capped := shared.effectiveBalance_capped genesis caps.activation caps.compounding
    (Nat.lt_of_le_of_lt (fork_le_of_chainSteps tail.chainSteps) early) v
    (Array.mem_of_getElem? found)
  have bound := tail.effectiveAt_ge_of_balanceFloor caps early i v found activated reference
    (by
      rw [value]
      dsimp [rounded]
      have division := Nat.mod_add_div amount preset.EFFECTIVE_BALANCE_INCREMENT.toNat
      have equal : amount - amount % preset.EFFECTIVE_BALANCE_INCREMENT.toNat =
          preset.EFFECTIVE_BALANCE_INCREMENT.toNat *
            (amount / preset.EFFECTIVE_BALANCE_INCREMENT.toNat) := by omega
      rw [equal, Nat.mul_mod_right])
    (fun p member => by
      have funded := floor p member
      rw [value]
      dsimp [rounded, amount]
      omega)
    (by rw [value]; dsimp [rounded, amount]; omega)
    (UInt64.le_iff_toNat_le.mpr (by
      have cap := UInt64.le_iff_toNat_le.mp capped
      rw [value]
      omega))
  have remainder := Nat.mod_lt amount increment
  rw [value] at bound
  dsimp [rounded, amount] at *
  omega
private theorem balanceEvents_eq_of_endpoint_le
    (tail : Run config checks x y)
    (one : (getCurrentEpoch y.state).toNat ≤ high + 1)
    (two : (getCurrentEpoch y.state).toNat ≤ localHigh + 1) :
    tail.balanceEvents high = tail.balanceEvents localHigh := by
  induction tail with
  | nil => rfl
  | @snoc m n pre step ih =>
    have order := UInt64.le_iff_toNat_le.mp
      (currentEpoch_le_of_chainSteps (Run.nil.snoc step).chainSteps)
    have first := order.trans one
    have second := order.trans two
    simp only [Run.balanceEvents, ih first second, first, second, ↓reduceIte]
private theorem retained_local_replay
    {i : Nat} (tail : Run config checks x y)
    (positive : 0 < (getCurrentEpoch y.state).toNat)
    (endpoint : (getCurrentEpoch y.state).toNat ≤ high + 1)
    (replayed : tail.balanceEvents high = .ok events)
    (w : Validator) (final : y.state.validators.data[i]? = some w)
    (active : (getCurrentEpoch y.state).toNat < w.exitEpoch.toNat) :
    tail.balanceEvents ((getCurrentEpoch y.state).toNat - 1) = .ok events ∧
      ∀ {m : ForkedBeaconState preset} (_rest : Run config checks m y) (v : Validator),
        m.state.validators.data[i]? = some v →
        (getCurrentEpoch y.state).toNat - 1 + 1 < v.exitEpoch.toNat := by
  constructor
  · rw [← balanceEvents_eq_of_endpoint_le tail endpoint (by omega)]
    exact replayed
  · intro m rest v found
    have cutoff := prefix_exit_gt_of_endpoint rest v w found final active
    omega
private theorem Stop.selected_local_replay
    {tail : Run config checks x y} (stop : Stop tail i)
    (chosen : stop.charge = some c)
    (twoSlots : 2 ≤ preset.SLOTS_PER_EPOCH.toNat)
    (endpoint : (getCurrentEpoch stop.state.state).toNat ≤ high + 1)
    (replayed : stop.pre.balanceEvents high = .ok events) :
    stop.pre.balanceEvents (getCurrentEpoch stop.state.state).toNat = .ok events ∧
      ∀ {m : ForkedBeaconState preset} (_rest : Run config checks m stop.state)
        (v : Validator), m.state.validators.data[i]? = some v →
        (getCurrentEpoch stop.state.state).toNat + 1 < v.exitEpoch.toNat := by
  constructor
  · rw [← balanceEvents_eq_of_endpoint_le stop.pre endpoint (by omega)]
    exact replayed
  · intro m rest v found
    exact stop.selected_prefix_exit_gt chosen rest v found
      (getCurrentEpoch_succ_lt_farFuture twoSlots stop.state.state)
/-- The per-key accounting trace of a branch, through any slashing of the key.

Each step extends the trace by `FloorTrace.step`.

The trace is marked slashed only if the key ends the branch slashed. -/
private theorem FloorTrace.run
    (shared : Run config checks g x) (tail : Run config checks x y)
    (genesis : Genesis (config := config) (checks := checks) g) (caps : CapOrder preset)
    (delay : 0 < config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    (early : y.fork < .glamsterdam) (high : Nat)
    (endEpoch : (getCurrentEpoch y.state).toNat ≤ high + 1)
    (i : ValidatorIndex) (v : Validator)
    (initial : x.state.validators.data[i.toNat]? = some v)
    (unslashed : v.slashed = false) (activated : v.activationEpoch ≠ FAR_FUTURE_EPOCH)
    (low base quotient : Nat) (low_le : low ≤ effectiveAt x i.toNat)
    (positive : 0 < quotient)
    (guards : ∀ {m n : ForkedBeaconState preset} (pre : Run config checks x m)
      (step : Step config checks m n) (post : Run config checks n y),
      (pre.snoc step).append post = tail → ∀ w, n.state.validators.data[i.toNat]? = some w →
      high + 1 < w.exitEpoch.toNat ∧
      (getCurrentEpoch m.state).toNat < (getCurrentEpoch x.state).toNat +
        preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat -
          (preset.EPOCHS_PER_SLASHINGS_VECTOR / 2).toNat ∧
      quotient ≤ (EthLib.Consensus.parameters preset m.fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat ∧
      ∀ events, step.balanceEvents = .ok events → ∀ e ∈ events, e.source ≠ .crossing)
    (replayed : tail.balanceEvents high = .ok events) :
    ∃ last, FloorTrace low base quotient
        ⟨actualBalanceAt x i.toNat, 0, effectiveAt x i.toNat, none⟩ last ∧
      last.balance = actualBalanceAt y i.toNat ∧
      last.debt = (events.map (floorPenaltyDebit i.toNat)).sum +
        (events.map (floorPartialDebit i)).sum ∧
      effectiveAt y i.toNat ≤ last.high ∧
      ∃ w, y.state.validators.data[i.toNat]? = some w ∧
        max low last.high ≤ (withdrawalMaxEffectiveBalance preset y.fork w).toNat ∧
        (if last.slashedHigh.isSome then 1 else 0) ≤ (if w.slashed then 1 else 0) ∧
        ∀ p ∈ tail.balancePath, ∃ c, FloorTrace low base quotient
            ⟨actualBalanceAt x i.toNat, 0, effectiveAt x i.toNat, none⟩ c ∧
          c.balance = actualBalanceAt p i.toNat ∧ c.debt ≤ last.debt ∧
          (if c.slashedHigh.isSome then 1 else 0) ≤ (if w.slashed then 1 else 0) := by
  induction tail generalizing events with
  | nil =>
    have empty : events = [] := Except.ok.inj replayed.symm
    subst events
    have cap := shared.effectiveBalance_capped genesis caps.activation caps.compounding
      early v (Array.mem_of_getElem? initial)
    have capped : max low (effectiveAt x i.toNat) ≤
        (withdrawalMaxEffectiveBalance preset x.fork v).toNat := by
      have atStart : effectiveAt x i.toNat = v.effectiveBalance.toNat := by
        simp [effectiveAt, initial]
      have numeric := UInt64.le_iff_toNat_le.mp cap
      omega
    refine ⟨⟨actualBalanceAt x i.toNat, 0, effectiveAt x i.toNat, none⟩,
      .nil, rfl, by simp, le_rfl, v, initial, capped, by simp, ?_⟩
    intro p member
    have same : p = x := List.mem_singleton.mp member
    subst p
    exact ⟨_, .nil, rfl, le_rfl, by simp⟩
  | @snoc m n pre step ih =>
    have middleEpoch := (UInt64.le_iff_toNat_le.mp
      (currentEpoch_le_of_chainSteps (Run.nil.snoc step).chainSteps)).trans endEpoch
    have middleEarly := Nat.lt_of_le_of_lt step.chainStep.fork_le early
    obtain ⟨prior, priorOk, _⟩ := pre.balanceEvents_prefix (Run.nil.snoc step) high events
      (by simpa [Run.append] using replayed)
    obtain ⟨added, addedOk⟩ := step.balanceEvents_ok early
    have exactEvents : events = prior ++ added := by
      simp only [Run.balanceEvents, priorOk, middleEpoch, ↓reduceIte, addedOk,
        bind, Except.bind, pure, Except.pure, Except.ok.injEq] at replayed
      exact replayed.symm
    have priorGuards : ∀ {a b : ForkedBeaconState preset} (head : Run config checks x a)
        (edge : Step config checks a b) (rest : Run config checks b m),
        (head.snoc edge).append rest = pre → ∀ w,
        b.state.validators.data[i.toNat]? = some w →
        high + 1 < w.exitEpoch.toNat ∧
        (getCurrentEpoch a.state).toNat < (getCurrentEpoch x.state).toNat +
          preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat -
            (preset.EPOCHS_PER_SLASHINGS_VECTOR / 2).toNat ∧
        quotient ≤ (EthLib.Consensus.parameters preset a.fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat ∧
        ∀ events, edge.balanceEvents = .ok events → ∀ e ∈ events, e.source ≠ .crossing := by
      intro a b head edge rest split w found
      apply guards head edge (rest.snoc step)
      · simp only [Run.append, split]
      · exact found
    obtain ⟨before, trace, balance, debt, effective, u, middle, capped, flagged, earlier⟩ :=
      ih middleEarly middleEpoch priorGuards priorOk
    obtain ⟨w, final, _⟩ := (Run.nil.snoc step).registryLifecycle.validators i.toNat u middle
    obtain ⟨retained, short, quotient_le, noCrossing⟩ := guards pre step .nil rfl w final
    obtain ⟨old, located, life⟩ := pre.registryLifecycle.validators i.toNat v initial
    have same := Option.some.inj (located.symm.trans middle)
    subst old
    have assigned : u.activationEpoch ≠ FAR_FUTURE_EPOCH := by
      rwa [life.activationEpoch activated]
    obtain ⟨last, done, atEnd, exactDebt, highBound, capBound, used, later⟩ :=
      FloorTrace.step shared pre genesis caps step early delay addedOk i v u w
        initial middle final unslashed assigned short high endEpoch retained
        (noCrossing added addedOk) trace balance flagged capped effective positive quotient_le
    -- A key slashed by `m` stays slashed at `n`.
    have persists : (if u.slashed then 1 else 0) ≤ (if w.slashed then 1 else 0) := by
      cases flag : u.slashed with
      | false => simp
      | true =>
        obtain ⟨z, located, marked⟩ :=
          (Run.nil.snoc step).slashedPersistence i.toNat u middle flag
        have equal := Option.some.inj (located.symm.trans final)
        subst z
        simp [marked]
    refine ⟨last, done, atEnd, ?_, highBound, w, final, capBound, used, ?_⟩
    · simp only [exactEvents, List.map_append, List.sum_append]
      omega
    · intro p member
      rcases List.mem_append.mp member with member | member
      · obtain ⟨c, traced, atState, spent, flag⟩ := earlier p member
        exact ⟨c, traced, atState, by omega, flag.trans persists⟩
      · obtain ⟨c, traced, atState, spent, flag⟩ := later p member
        exact ⟨c, traced, atState, spent, flag.trans used⟩

private theorem unslashed_floor_run
    (shared : Run config checks g x) (tail : Run config checks x y)
    (genesis : Genesis (config := config) (checks := checks) g) (caps : CapOrder preset)
    (delay : 0 < config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    (early : y.fork < .glamsterdam) (high : Nat)
    (endEpoch : (getCurrentEpoch y.state).toNat ≤ high + 1)
    (i : ValidatorIndex) (v : Validator)
    (initial : x.state.validators.data[i.toNat]? = some v)
    (unslashed : v.slashed = false) (activated : v.activationEpoch ≠ FAR_FUTURE_EPOCH)
    (low base quotient : Nat) (low_le : low ≤ effectiveAt x i.toNat)
    (positive : 0 < quotient)
    (guards : ∀ {m n : ForkedBeaconState preset} (pre : Run config checks x m)
      (step : Step config checks m n) (post : Run config checks n y),
      (pre.snoc step).append post = tail → ∀ w, n.state.validators.data[i.toNat]? = some w →
      w.slashed = false ∧ high + 1 < w.exitEpoch.toNat ∧
      (getCurrentEpoch m.state).toNat < (getCurrentEpoch x.state).toNat +
        preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat -
          (preset.EPOCHS_PER_SLASHINGS_VECTOR / 2).toNat ∧
      quotient ≤ (EthLib.Consensus.parameters preset m.fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat ∧
      ∀ events, step.balanceEvents = .ok events → ∀ e ∈ events, e.source ≠ .crossing)
    (replayed : tail.balanceEvents high = .ok events) :
    ∃ last, FloorTrace low base quotient
        ⟨actualBalanceAt x i.toNat, 0, effectiveAt x i.toNat, none⟩ last ∧
      last.balance = actualBalanceAt y i.toNat ∧
      last.debt = (events.map (floorPenaltyDebit i.toNat)).sum +
        (events.map (floorPartialDebit i)).sum ∧
      effectiveAt y i.toNat ≤ last.high ∧ last.slashedHigh = none ∧
      (∃ w, y.state.validators.data[i.toNat]? = some w ∧
        max low last.high ≤ (withdrawalMaxEffectiveBalance preset y.fork w).toNat) ∧
      ∀ p ∈ tail.balancePath, ∃ c, FloorTrace low base quotient
          ⟨actualBalanceAt x i.toNat, 0, effectiveAt x i.toNat, none⟩ c ∧
        c.balance = actualBalanceAt p i.toNat ∧ c.debt ≤ last.debt ∧ c.slashedHigh = none := by
  have noFlag {account : FloorAccount} {w : Validator} (clean : w.slashed = false)
      (bound : (if account.slashedHigh.isSome then 1 else 0) ≤ (if w.slashed then 1 else 0)) :
      account.slashedHigh = none := by
    cases flag : account.slashedHigh with
    | none => rfl
    | some value => simp [flag, clean] at bound
  obtain ⟨last, trace, balance, debt, effective, w, final, capped, used, path⟩ :=
    FloorTrace.run shared tail genesis caps delay early high endEpoch i v initial unslashed
      activated low base quotient low_le positive
      (fun pre step post split w found => (guards pre step post split w found).2) replayed
  -- The key ends the branch unslashed: at `x` itself, or after a step that keeps it clean.
  have clean : w.slashed = false := by
    cases tail with
    | nil =>
      have same := Option.some.inj (initial.symm.trans final)
      subst w
      exact unslashed
    | snoc pre step => exact (guards pre step .nil rfl w final).1
  refine ⟨last, trace, balance, debt, effective, noFlag clean used, ⟨w, final, capped⟩, ?_⟩
  intro p member
  obtain ⟨c, traced, atState, spent, flag⟩ := path p member
  exact ⟨c, traced, atState, spent, noFlag clean flag⟩

/-- A step of a pre-Gloas run is pre-Gloas, and its input epoch is at most the run's end epoch. -/
private theorem Run.contains_step_facts {x y u v : ForkedBeaconState preset}
    {tail : Run config checks x y} {step : Step config checks u v} (member : tail.Contains step)
    (early : y.fork < .glamsterdam) :
    ∃ (pre : Run config checks x u) (post : Run config checks v y),
      tail = (pre.snoc step).append post ∧ u.fork < .glamsterdam ∧
        (getCurrentEpoch u.state).toNat ≤ (getCurrentEpoch y.state).toNat := by
  obtain ⟨pre, post, split⟩ := tail.contains_split step member
  exact ⟨pre, post, split, Nat.lt_of_le_of_lt
    (Nat.le_trans step.chainStep.fork_le (fork_le_of_chainSteps post.chainSteps)) early,
    UInt64.le_iff_toNat_le.mp
      (currentEpoch_le_of_chainSteps ((Run.nil.snoc step).append post).chainSteps)⟩

private theorem effectiveAt_le_of_not_firstDown
    (tail : Run config checks x y) (none : ¬ FirstDown tail i) :
    effectiveAt x i ≤ effectiveAt y i := by
  have ordered (j : Nat) (before after : ForkedBeaconState preset)
      (one : tail.balancePath[j]? = some before)
      (two : tail.balancePath[j + 1]? = some after) :
      effectiveAt before i ≤ effectiveAt after i := by
    by_contra decrease
    have existsDrop : ∃ j, ∃ before after, tail.balancePath[j]? = some before ∧
        tail.balancePath[j + 1]? = some after ∧ effectiveAt after i < effectiveAt before i :=
      ⟨j, before, after, one, two, by omega⟩
    obtain ⟨before, after, one, two, less⟩ := Nat.find_spec existsDrop
    apply none
    refine ⟨Nat.find existsDrop, before, after, one, two, less, ?_⟩
    intro k u v earlier atU atV
    have absent := Nat.find_min existsDrop earlier
    by_contra bad
    exact absent ⟨u, v, atU, atV, by omega⟩
  have starts : ∃ rest, tail.balancePath = x :: rest := by
    clear none ordered
    induction tail with
    | nil => exact ⟨[], rfl⟩
    | snoc pre step ih =>
      obtain ⟨rest, path⟩ := ih
      exact ⟨rest ++ step.balancePath, by simp [Run.balancePath, path]⟩
  obtain ⟨rest, starts⟩ := starts
  obtain ⟨pre, ends⟩ := Run.balancePath_last tail
  have first : tail.balancePath[0]? = some x := by simp [starts]
  have last : tail.balancePath[pre.length]? = some y := by simp [ends]
  have bound (n : Nat) : ∀ state, tail.balancePath[n]? = some state →
      effectiveAt x i ≤ effectiveAt state i := by
    induction n with
    | zero =>
      intro state atState
      have same := Option.some.inj (first.symm.trans atState)
      subst state
      exact le_rfl
    | succ n ih =>
      intro state atState
      have length : n < tail.balancePath.length := by
        obtain ⟨inside, _⟩ := List.getElem?_eq_some_iff.mp atState
        omega
      have atBefore : tail.balancePath[n]? = some tail.balancePath[n] :=
        List.getElem?_eq_getElem length
      exact (ih _ atBefore).trans (ordered n _ state atBefore atState)
  exact bound _ y last
private theorem adjacent_decrease_append
    (left right : List (ForkedBeaconState preset))
    (last : left[left.length - 1]? = some middle)
    (start : right[0]? = some middle)
    (one : (left ++ right)[j]? = some before)
    (two : (left ++ right)[j + 1]? = some after)
    (decreases : effectiveAt after i < effectiveAt before i) :
    (j + 1 < left.length ∧ left[j]? = some before ∧ left[j + 1]? = some after) ∨
      (left.length ≤ j ∧ right[j - left.length]? = some before ∧
        right[j - left.length + 1]? = some after) := by
  by_cases within : j + 1 < left.length
  · exact Or.inl ⟨within, (List.getElem?_append_left (by omega)).symm.trans one,
      (List.getElem?_append_left within).symm.trans two⟩
  · by_cases beyond : left.length ≤ j
    · right
      refine ⟨beyond, (List.getElem?_append_right beyond).symm.trans one, ?_⟩
      have found := (List.getElem?_append_right (l₁ := left) (l₂ := right)
        (i := j + 1) (by omega)).symm.trans two
      have offset : j + 1 - left.length = j - left.length + 1 := by omega
      simpa only [offset] using found
    · have boundary : j + 1 = left.length := by omega
      have atBefore : left[left.length - 1]? = some before := by
        have found :=
            (List.getElem?_append_left (l₂ := right) (by omega : j < left.length)).symm.trans one
        simpa only [← boundary, Nat.add_sub_cancel] using found
      have atAfter : right[0]? = some after := by
        have found := (List.getElem?_append_right (l₁ := left) (l₂ := right)
          (i := j + 1) (by omega)).symm.trans two
        simpa only [boundary, Nat.sub_self] using found
      have equalBefore := Option.some.inj (last.symm.trans atBefore)
      have equalAfter := Option.some.inj (start.symm.trans atAfter)
      rw [← equalBefore, ← equalAfter] at decreases
      exact False.elim (Nat.lt_irrefl _ decreases)
private theorem adjacent_decrease_step
    (tail : Run config checks x y)
    (one : tail.balancePath[j]? = some before)
    (two : tail.balancePath[j + 1]? = some after)
    (decreases : effectiveAt after i < effectiveAt before i) :
    ∃ m n, ∃ (pre : Run config checks x m) (step : Step config checks m n),
      ∃ (post : Run config checks n y) (k : Nat),
      (pre.snoc step).append post = tail ∧ j = pre.balancePath.length + k ∧
      step.balancePath[k]? = some before ∧ step.balancePath[k + 1]? = some after := by
  induction tail generalizing j with
  | nil =>
    have impossible := two
    simp [Run.balancePath] at impossible
  | @snoc m n pre step ih =>
    obtain ⟨rest, path⟩ := Run.balancePath_last pre
    have last : pre.balancePath[pre.balancePath.length - 1]? = some m := by
      simp [path]
    have start : step.balancePath[0]? = some m := by
      cases step with
      | block => rfl
      | slot ok =>
        obtain ⟨advanced, advanceOk, _⟩ := bind_ok_iff.mp ok
        simp [Step.balancePath, advanceOk, Except.toOption]
    rcases adjacent_decrease_append pre.balancePath step.balancePath last start one two decreases
        with
      earlier | latest
    · obtain ⟨a, b, head, actual, post, k, split, offset, found, next⟩ := ih earlier.2.1 earlier.2.2
      exact ⟨a, b, head, actual, post.snoc step, k,
        by simp only [Run.append, split], offset, found, next⟩
    · exact ⟨m, n, pre, step, Run.nil, j - pre.balancePath.length,
        rfl, by omega, latest.2.1, latest.2.2⟩
private theorem step_decrease_of_regime
    (step : Step config checks m n) (regime : .pectra ≤ m.fork ∨ n.fork < .pectra)
    (early : n.fork < .glamsterdam) (inside : i < m.state.validators.data.size)
    (one : step.balancePath[k]? = some before)
    (two : step.balancePath[k + 1]? = some after)
    (decreases : effectiveAt after i < effectiveAt before i) :
    ∃ (ok : advanceSlotAcross config checks m = .ok n),
      step = Step.slot ok ∧ ∃ advanced,
        advanceSlot config checks m.state = .ok advanced ∧
        k = 0 ∧ before = m ∧ after = ⟨m.fork, advanced⟩ := by
  cases step with
  | block engine signed due ok =>
    have index : k = 0 := by
      have length := (List.getElem?_eq_some_iff.mp two).1
      simp only [Step.balancePath, List.length_cons, List.length_nil] at length
      omega
    subst k
    simp only [Step.balancePath, List.getElem?_cons_zero, Option.some.injEq] at one
    simp only [Step.balancePath, List.getElem?_cons_succ, List.getElem?_cons_zero,
      Option.some.injEq] at two
    subst before
    subst after
    have kept := effectiveKept_block early (applySignedBlock_ok ok).2.1 i inside
    dsimp only at kept
    omega
  | slot ok =>
    obtain ⟨advanced, advanceOk, upgraded⟩ := bind_ok_iff.mp ok
    have path : (Step.slot ok).balancePath = [m, ⟨m.fork, advanced⟩, n] := by
      simp [Step.balancePath, advanceOk, Except.toOption]
    have bound : k ≤ 1 := by
      have length := (List.getElem?_eq_some_iff.mp two).1
      rw [path] at length
      simp only [List.length_cons, List.length_nil] at length
      omega
    have zero : k = 0 := by
      by_contra nonzero
      have index : k = 1 := by omega
      rw [path, index] at one two
      simp only [List.getElem?_cons_succ, List.getElem?_cons_zero, Option.some.injEq] at one two
      subst before
      subst after
      have kept : effectiveAt n i = effectiveAt ⟨m.fork, advanced⟩ i := by
        rcases regime with electra | preElectra
        · have target : .pectra ≤ n.fork := Nat.le_trans electra
            (processUpgrades_fork_le (forked := ⟨m.fork, advanced⟩) upgraded)
          have data := processUpgrades_retained_data (s := ⟨m.fork, advanced⟩)
            electra early upgraded target
          simp only [effectiveAt, data]
        · have data := upgrades_validators upgraded preElectra
          simp only [effectiveAt, data]
      omega
    refine ⟨ok, rfl, advanced, advanceOk, zero, ?_, ?_⟩
    · simpa only [path, zero, List.getElem?_cons_zero, Option.some.injEq] using one.symm
    · simpa only [path, zero, List.getElem?_cons_succ, List.getElem?_cons_zero,
        Option.some.injEq] using two.symm
private theorem advanceSlot_decrease_last
    {fork : Fork} {s t : BeaconState preset fork}
    (ok : advanceSlot config checks s = .ok t)
    (decreases : effectiveAt ⟨fork, t⟩ i < effectiveAt ⟨fork, s⟩ i) :
    ∃ next cached epoched,
      addChecked s.slot 1 = .ok next ∧ next % preset.SLOTS_PER_EPOCH = 0 ∧
      processSlot s = .ok cached ∧ processEpoch config checks cached = .ok epoched ∧
      t = { epoched with slot := next } := by
  obtain ⟨next, cached, epoched, sum, cachedOk, epochOk, rfl⟩ := advanceSlot_ok ok
  have checked : addChecked s.slot 1 = .ok next :=
    addChecked_ok_iff.mpr ⟨by
      change s.slot.toNat + 1 < 2 ^ 64
      have small := next.toNat_lt
      omega, sum⟩
  have last : next % preset.SLOTS_PER_EPOCH = 0 := by
    by_contra nonlast
    simp only [epochIfLast, nonlast, ↓reduceIte, pure, Except.pure, Except.ok.injEq] at epochOk
    subst epoched
    obtain ⟨_, _, _, _, rfl⟩ := processSlot_ok cachedOk
    simp only [effectiveAt, Nat.lt_irrefl] at decreases
  simp only [epochIfLast, last, ↓reduceIte] at epochOk
  exact ⟨next, cached, epoched, checked, last, cachedOk, epochOk, rfl⟩
private theorem slot_epoch_events_eq
    {m y : ForkedBeaconState preset}
    (ok : advanceSlotAcross config checks m = .ok y)
    {cached middle advanced : BeaconState preset m.fork} {next : Slot}
    {events : List (BalanceEvent preset)}
    (cachedOk : processSlot m.state = .ok cached)
    (nextOk : addChecked m.state.slot 1 = .ok next)
    (last : next % preset.SLOTS_PER_EPOCH = 0)
    (replayed : epochBalanceReplay (config := config) (checks := checks) cached =
      .ok (middle, events))
    (advancedOk : advanceSlot config checks m.state = .ok advanced)
    (noCrossing : ∀ found, (Step.slot ok).balanceEvents = .ok found →
      ∀ e ∈ found, e.source ≠ .crossing) :
    (Step.slot ok).balanceEvents = .ok events := by
  obtain ⟨actual, advance, upgrades⟩ := bind_ok_iff.mp ok
  have same : actual = advanced := Except.ok.inj (advance.symm.trans advancedOk)
  subst actual
  obtain ⟨crossings, crossed, _bounded⟩ := upgradeBalanceReplay_bounded upgrades
  have checked : liftAccessor (liftArith (addChecked m.state.slot 1)) =
      (Except.ok next : Except TransitionError Slot) := by
    simp [nextOk, liftArith, liftAccessor, Except.mapError]
  have full := Step.balanceEvents_epoch_slot ok cachedOk checked last replayed advancedOk crossed
  have empty : crossings = [] := List.eq_nil_iff_forall_not_mem.mpr (by
    intro e member
    exact noCrossing _ full e (List.mem_append_right events member)
      (upgradeBalanceReplay_crossing crossed e member))
  simpa only [empty, List.append_nil] using full
private theorem effectiveKept_epoch_replay_middle
    {fork : Fork} {s t middle : BeaconState preset fork}
    (early : fork < .glamsterdam) (ok : processEpoch config checks s = .ok t)
    (replayed : epochBalanceReplay (config := config) (checks := checks) s =
      .ok (middle, events)) : EffectiveKept s middle := by
  obtain ⟨actual, updated, recorded, replay, _update, _validators, _balances, processed⟩ :=
    epochBalanceReplay_result_before s t early ok
  have same := Except.ok.inj (replay.symm.trans replayed)
  have stateEq : actual = middle := congrArg Prod.fst same
  subst actual
  exact effectiveKept_epochBeforePayments processed
private theorem capped_epoch_replay_middle
    {fork : Fork} {s t middle : BeaconState preset fork}
    (early : fork < .glamsterdam) (ok : processEpoch config checks s = .ok t)
    (replayed : epochBalanceReplay (config := config) (checks := checks) s =
      .ok (middle, events))
    (capped : ∀ v ∈ s.validators.data,
      v.effectiveBalance ≤ withdrawalMaxEffectiveBalance preset fork v) :
    ∀ v ∈ middle.validators.data,
      v.effectiveBalance ≤ withdrawalMaxEffectiveBalance preset fork v := by
  obtain ⟨actual, updated, recorded, replay, _update, _validators, _balances, processed⟩ :=
    epochBalanceReplay_result_before s t early ok
  have same := Except.ok.inj (replay.symm.trans replayed)
  have stateEq : actual = middle := congrArg Prod.fst same
  subst actual
  exact capped_epochBeforePayments processed capped
private theorem slot_replay_middle_effective
    {fork : Fork} {s cached epoched middle : BeaconState preset fork}
    (early : fork < .glamsterdam) (cachedOk : processSlot s = .ok cached)
    (epochOk : processEpoch config checks cached = .ok epoched)
    (replayed : epochBalanceReplay (config := config) (checks := checks) cached =
      .ok (middle, events)) : EffectiveKept s middle := by
  have kept := effectiveKept_epoch_replay_middle early epochOk replayed
  have same : cached.validators = s.validators := by
    obtain ⟨_, _, _, _, rfl⟩ := processSlot_ok cachedOk
    rfl
  intro i inside
  have valid : i < cached.validators.data.size := by simpa only [same] using inside
  simpa only [effectiveAt, same] using kept i valid
private theorem reachable_replay_middle_bounds
    {g outer : ForkedBeaconState preset}
    (shared : Run config checks g outer)
    (genesis : Genesis (config := config) (checks := checks) g)
    (caps : CapOrder preset) (aligned : MaxEffectiveBalancesAligned preset)
    {cached epoched middle : BeaconState preset outer.fork}
    (early : outer.fork < .glamsterdam)
    (cachedOk : processSlot outer.state = .ok cached)
    (epochOk : processEpoch config checks cached = .ok epoched)
    (replayed : epochBalanceReplay (config := config) (checks := checks) cached =
      .ok (middle, events))
    (inside : i < outer.state.validators.data.size)
    (found : middle.validators.data[i]? = some v) :
    v.effectiveBalance.toNat % preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0 ∧
      v.effectiveBalance ≤ withdrawalMaxEffectiveBalance preset outer.fork v := by
  have same : cached.validators = outer.state.validators := by
    obtain ⟨_, _, _, _, rfl⟩ := processSlot_ok cachedOk
    rfl
  have originalCaps := shared.effectiveBalance_capped genesis caps.activation caps.compounding early
  have middleCaps := capped_epoch_replay_middle early epochOk replayed
    (by simpa only [same] using originalCaps)
  refine ⟨?_, middleCaps v (Array.mem_of_getElem? found)⟩
  have kept := slot_replay_middle_effective early cachedOk epochOk replayed i inside
  have original := reachable_effective_alignment shared genesis aligned
    outer.state.validators.data[i] (by simp)
  have originalRead := Array.getElem?_eq_getElem inside
  simp only [effectiveAt, found, originalRead, Option.map_some, Option.getD_some] at kept
  rw [kept]
  exact original
private theorem effective_update_input_reads
    {fork : Fork} {middle updated : BeaconState preset fork}
    (update : processEffectiveBalanceUpdates middle = .ok updated)
    (inside : i < middle.validators.data.size) :
    ∃ v amount, middle.validators.data[i]? = some v ∧
      middle.balances.data[i]? = some amount := by
  have stepBalances : ∀ {s t : BeaconState preset fork} {j : Nat},
      updateEffectiveBalance s j = .ok t → t.balances = s.balances := by
    intro s t j step
    simp only [updateEffectiveBalance, bind_ok_iff, liftAccessor_ok] at step
    obtain ⟨validator, _found, balance, _read, effective, _scalar, set⟩ := step
    obtain ⟨_valid, rfl⟩ := setValidatorAt_ok set
    rfl
  unfold processEffectiveBalanceUpdates at update
  obtain ⟨atState, next, prefixOk, atIndex, _rest⟩ :=
    (foldlM_ok_steps (fun _ _ => True) (fun _ => trivial) (fun _ _ => trivial)
      (fun _ _ _ _ => trivial) update).2 i (by simpa using inside)
  simp only [List.getElem_range] at atIndex
  have balances : atState.balances = middle.balances :=
    foldlM_ok_invariant (fun current : BeaconState preset fork =>
      current.balances = middle.balances)
      (fun _ _ _ kept step => (stepBalances step).trans kept) rfl prefixOk
  simp only [updateEffectiveBalance, bind_ok_iff, liftAccessor_ok] at atIndex
  obtain ⟨validator, _found, amount, read, _effective, _scalar, _set⟩ := atIndex
  refine ⟨middle.validators.data[i], amount, Array.getElem?_eq_getElem inside, ?_⟩
  rw [getBalanceAt_eq_ok_iff, balances] at read
  exact read
private theorem effective_update_decrease_reads
    {fork : Fork} {s middle updated : BeaconState preset fork}
    (kept : EffectiveKept s middle)
    (update : processEffectiveBalanceUpdates middle = .ok updated)
    (inside : i < s.validators.data.size)
    (decreases : effectiveAt ⟨fork, updated⟩ i < effectiveAt ⟨fork, s⟩ i) :
    ∃ v amount, middle.validators.data[i]? = some v ∧
      middle.balances.data[i]? = some amount := by
  have preserved := kept i inside
  have valid : i < middle.validators.data.size := by
    by_contra missing
    have absent : middle.validators.data[i]? = none :=
      Array.getElem?_eq_none (by omega)
    have zero : effectiveAt ⟨fork, middle⟩ i = 0 := by
      simp only [effectiveAt, absent, Option.map_none, Option.getD_none]
    rw [zero] at preserved
    omega
  exact effective_update_input_reads update valid
private theorem effective_update_decrease_at
    {fork : Fork} {s middle updated : BeaconState preset fork}
    (kept : EffectiveKept s middle)
    (update : processEffectiveBalanceUpdates middle = .ok updated)
    (found : middle.validators.data[i]? = some v)
    (balance : middle.balances.data[i]? = some amount)
    (inside : i < s.validators.data.size)
    (decreases : effectiveAt ⟨fork, updated⟩ i < effectiveAt ⟨fork, s⟩ i) :
    ∃ effective,
      updated.validators.data[i]? = some { v with effectiveBalance := effective } ∧
      updatedEffectiveBalance preset (withdrawalMaxEffectiveBalance preset fork v)
        amount v.effectiveBalance = .ok effective ∧
      effective < v.effectiveBalance ∧ v.effectiveBalance.toNat = effectiveAt ⟨fork, s⟩ i := by
  obtain ⟨effective, after, computed⟩ :=
    processEffectiveBalanceUpdates_effectiveBalance_eq update found balance
  have before := kept i inside
  simp only [effectiveAt, found, Option.map_some, Option.getD_some] at before
  have lower : effective.toNat < v.effectiveBalance.toNat := by
    simpa only [effectiveAt, after, Option.map_some, Option.getD_some, ← before] using decreases
  exact ⟨effective, after, computed, UInt64.lt_iff_toNat_lt.mpr lower, before⟩
private theorem effective_update_decrease_witness
    {fork : Fork} {s middle updated : BeaconState preset fork}
    (kept : EffectiveKept s middle)
    (update : processEffectiveBalanceUpdates middle = .ok updated)
    (inside : i < s.validators.data.size)
    (decreases : effectiveAt ⟨fork, updated⟩ i < effectiveAt ⟨fork, s⟩ i) :
    ∃ v amount effective,
      middle.validators.data[i]? = some v ∧
      middle.balances.data[i]? = some amount ∧
      updated.validators.data[i]? = some { v with effectiveBalance := effective } ∧
      updatedEffectiveBalance preset (withdrawalMaxEffectiveBalance preset fork v)
        amount v.effectiveBalance = .ok effective ∧
      effective < v.effectiveBalance ∧ v.effectiveBalance.toNat = effectiveAt ⟨fork, s⟩ i := by
  obtain ⟨v, amount, found, balance⟩ :=
    effective_update_decrease_reads kept update inside decreases
  obtain ⟨effective, after, scalar, lower, before⟩ :=
    effective_update_decrease_at kept update found balance inside decreases
  exact ⟨v, amount, effective, found, balance, after, scalar, lower, before⟩
private theorem scalar_decrease_gap {largest amount old effective : Gwei}
    (aligned : old.toNat % preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0)
    (capped : old ≤ largest)
    (computed : updatedEffectiveBalance preset largest amount old = .ok effective)
    (lower : effective < old) :
    preset.downwardBand < old.toNat - amount.toNat := by
  have lowerNat := UInt64.lt_iff_toNat_lt.mp lower
  have cappedNat := UInt64.le_iff_toNat_le.mp capped
  rcases updatedEffectiveBalance_split computed with ⟨same, _⟩ | ⟨rounded, down | up⟩
  · subst effective
    omega
  · omega
  · have below : old.toNat ≤ amount.toNat := by omega
    have quotient : old.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤
        amount.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat := Nat.div_le_div_right below
    have product := Nat.mul_le_mul_right preset.EFFECTIVE_BALANCE_INCREMENT.toNat quotient
    rw [Nat.mul_comm (old.toNat / _), Nat.mul_comm (amount.toNat / _)] at product
    have oldDiv := Nat.mod_add_div old.toNat preset.EFFECTIVE_BALANCE_INCREMENT.toNat
    have amountDiv := Nat.mod_add_div amount.toNat preset.EFFECTIVE_BALANCE_INCREMENT.toNat
    have roundedNat := toNat_rounded (preset := preset) (balance := amount)
    have roundedLower : old ≤ amount - amount % preset.EFFECTIVE_BALANCE_INCREMENT := by
      rw [UInt64.le_iff_toNat_le, roundedNat]
      omega
    have resultLower : old ≤ effective := by
      rw [rounded, UInt64.min_def]
      split
      · exact roundedLower
      · exact capped
    exact False.elim (by have := UInt64.le_iff_toNat_le.mp resultLower; omega)
private theorem reachable_update_decrease_gap
    {g outer : ForkedBeaconState preset}
    (shared : Run config checks g outer)
    (genesis : Genesis (config := config) (checks := checks) g)
    (caps : CapOrder preset) (aligned : MaxEffectiveBalancesAligned preset)
    {cached epoched middle updated : BeaconState preset outer.fork}
    (early : outer.fork < .glamsterdam)
    (cachedOk : processSlot outer.state = .ok cached)
    (epochOk : processEpoch config checks cached = .ok epoched)
    (replayed : epochBalanceReplay (config := config) (checks := checks) cached =
      .ok (middle, events))
    (update : processEffectiveBalanceUpdates middle = .ok updated)
    (inside : i < outer.state.validators.data.size)
    (decreases : effectiveAt ⟨outer.fork, updated⟩ i < effectiveAt outer i) :
    ∃ v amount effective,
      middle.validators.data[i]? = some v ∧
      middle.balances.data[i]? = some amount ∧
      updated.validators.data[i]? = some { v with effectiveBalance := effective } ∧
      updatedEffectiveBalance preset (withdrawalMaxEffectiveBalance preset outer.fork v)
        amount v.effectiveBalance = .ok effective ∧
      effective < v.effectiveBalance ∧ v.effectiveBalance.toNat = effectiveAt outer i ∧
      preset.downwardBand < v.effectiveBalance.toNat - amount.toNat := by
  have kept := slot_replay_middle_effective early cachedOk epochOk replayed
  obtain ⟨v, amount, effective, found, balance, after, scalar, lower, before⟩ :=
    effective_update_decrease_witness kept update inside decreases
  obtain ⟨whole, capped⟩ := reachable_replay_middle_bounds shared genesis caps aligned early
    cachedOk epochOk replayed inside found
  exact ⟨v, amount, effective, found, balance, after, scalar, lower, before,
    scalar_decrease_gap whole capped scalar lower⟩
private theorem noEarlier_of_localized_decrease
    (tail : Run config checks x y) (pre : Run config checks x m)
    (step : Step config checks m n) (post : Run config checks n y)
    (split : (pre.snoc step).append post = tail)
    (offset : j = pre.balancePath.length + k)
    (ordered : ∀ q u v, q < j → tail.balancePath[q]? = some u →
      tail.balancePath[q + 1]? = some v → effectiveAt u i ≤ effectiveAt v i) :
    ∀ q u v, pre.balancePath[q]? = some u → pre.balancePath[q + 1]? = some v →
      effectiveAt u i ≤ effectiveAt v i := by
  have path := Run.balancePath_append (pre.snoc step) post
  rw [split, Run.balancePath, List.append_assoc] at path
  intro q u v one two
  have within : q + 1 < pre.balancePath.length := (List.getElem?_eq_some_iff.mp two).1
  apply ordered q u v (by omega)
  · rw [path, List.getElem?_append_left (by omega)]
    exact one
  · rw [path, List.getElem?_append_left within]
    exact two
/-- Take a key whose balance minus a debt stays above a lower bound at `x`.

That bound is the smaller of the key's effective balance and balance at `x`.

Then its effective balance drops by at most its slack, the debt and one increment. -/
private theorem effective_loss_le_of_floor
    (shared : Run config checks g x) (tail : Run config checks x y)
    (genesis : Genesis (config := config) (checks := checks) g) (caps : CapOrder preset)
    (increment : 0 < preset.EFFECTIVE_BALANCE_INCREMENT.toNat) (early : y.fork < .glamsterdam)
    (v : Validator) (found : x.state.validators.data[i]? = some v)
    (activated : v.activationEpoch ≠ FAR_FUTURE_EPOCH) (debt : Nat)
    (floor : ∀ p ∈ tail.balancePath,
      min (effectiveAt x i) (actualBalanceAt x i) ≤ actualBalanceAt p i + debt) :
    effectiveAt x i ≤ effectiveAt y i + (effectiveAt x i - actualBalanceAt x i) + debt +
      (if FirstDown tail i then preset.EFFECTIVE_BALANCE_INCREMENT.toNat else 0) := by
  by_cases drop : FirstDown tail i
  · have bound := effective_loss_le_of_routed_floor shared tail genesis caps increment early
      v found activated debt floor
    simp only [drop, ↓reduceIte]
    omega
  · have bound := effectiveAt_le_of_not_firstDown tail drop
    simp only [drop, ↓reduceIte]
    omega
private theorem effective_loss_le_of_unslashed_traces
    (shared : Run config checks g x) (tail : Run config checks x y)
    (genesis : Genesis (config := config) (checks := checks) g) (caps : CapOrder preset)
    (increment : 0 < preset.EFFECTIVE_BALANCE_INCREMENT.toNat) (early : y.fork < .glamsterdam)
    (v : Validator) (found : x.state.validators.data[i]? = some v)
    (activated : v.activationEpoch ≠ FAR_FUTURE_EPOCH) (debt base quotient : Nat)
    (traces : ∀ p ∈ tail.balancePath, ∃ c,
      FloorTrace (min (effectiveAt x i) (actualBalanceAt x i)) base quotient
        ⟨actualBalanceAt x i, 0, effectiveAt x i, none⟩ c ∧
      c.balance = actualBalanceAt p i ∧ c.debt ≤ debt ∧ c.slashedHigh = none) :
    effectiveAt x i ≤ effectiveAt y i + (effectiveAt x i - actualBalanceAt x i) + debt +
      (if FirstDown tail i then preset.EFFECTIVE_BALANCE_INCREMENT.toNat else 0) :=
  effective_loss_le_of_floor shared tail genesis caps increment early v found activated debt
    fun p member => by
      obtain ⟨c, trace, balance, used, clean⟩ := traces p member
      have lower := FloorTrace.unslashed_balance_floor trace (by dsimp only; omega) clean
      rw [balance] at lower
      omega
private theorem Stop.selected_effective_loss
    {tail : Run config checks x y} (stop : Stop tail i.toNat)
    (chosen : stop.charge = some c) (shared : Run config checks g x)
    (genesis : Genesis (config := config) (checks := checks) g) (caps : CapOrder preset)
    (increment : 0 < preset.EFFECTIVE_BALANCE_INCREMENT.toNat)
    (twoSlots : 2 ≤ preset.SLOTS_PER_EPOCH.toNat)
    (delay : 0 < config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    (early : stop.state.fork < .glamsterdam)
    (v w : Validator) (initial : x.state.validators.data[i.toNat]? = some v)
    (final : stop.state.state.validators.data[i.toNat]? = some w)
    (unslashed : v.slashed = false) (clean : w.slashed = false)
    (activated : v.activationEpoch ≠ FAR_FUTURE_EPOCH)
    (endpoint : (getCurrentEpoch stop.state.state).toNat ≤ high + 1)
    (replayed : stop.pre.balanceEvents high = .ok events)
    (base quotient : Nat) (positive : 0 < quotient)
    (guards : ∀ {m n : ForkedBeaconState preset} (pre : Run config checks x m)
      (step : Step config checks m n) (post : Run config checks n stop.state),
      (pre.snoc step).append post = stop.pre →
      (getCurrentEpoch m.state).toNat < (getCurrentEpoch x.state).toNat +
        preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat -
          (preset.EPOCHS_PER_SLASHINGS_VECTOR / 2).toNat ∧
      quotient ≤ (EthLib.Consensus.parameters preset m.fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat ∧
      ∀ events, step.balanceEvents = .ok events → ∀ e ∈ events, e.source ≠ .crossing) :
    effectiveAt x i.toNat ≤ effectiveAt stop.state i.toNat +
      (effectiveAt x i.toNat - actualBalanceAt x i.toNat) +
      ((events.map (floorPenaltyDebit i.toNat)).sum + (events.map (floorPartialDebit i)).sum) +
      (if FirstDown stop.pre i.toNat then preset.EFFECTIVE_BALANCE_INCREMENT.toNat else 0) := by
  obtain ⟨localReplay, exits⟩ := stop.selected_local_replay chosen twoSlots endpoint replayed
  have localGuards : ∀ {m n : ForkedBeaconState preset} (pre : Run config checks x m)
      (step : Step config checks m n) (post : Run config checks n stop.state),
      (pre.snoc step).append post = stop.pre → ∀ u,
      n.state.validators.data[i.toNat]? = some u →
      u.slashed = false ∧ (getCurrentEpoch stop.state.state).toNat + 1 < u.exitEpoch.toNat ∧
      (getCurrentEpoch m.state).toNat < (getCurrentEpoch x.state).toNat +
        preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat -
          (preset.EPOCHS_PER_SLASHINGS_VECTOR / 2).toNat ∧
      quotient ≤ (EthLib.Consensus.parameters preset m.fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat ∧
      ∀ events, step.balanceEvents = .ok events → ∀ e ∈ events, e.source ≠ .crossing := by
    intro m n pre step post split u found
    obtain ⟨short, quotientBound, noCrossing⟩ := guards pre step post split
    have unmarked : u.slashed = false := by
      cases flag : u.slashed with
      | false => rfl
      | true =>
        obtain ⟨last, located, marked⟩ := post.slashedPersistence i.toNat u found flag
        have same := Option.some.inj (located.symm.trans final)
        subst last
        simp [clean] at marked
    exact ⟨unmarked, exits post u found, short, quotientBound, noCrossing⟩
  obtain ⟨last, _, _, debt, _, _, _, path⟩ := unslashed_floor_run shared stop.pre
    genesis caps delay early (getCurrentEpoch stop.state.state).toNat (by omega)
    i v initial unslashed activated (min (effectiveAt x i.toNat) (actualBalanceAt x i.toNat))
    base quotient (Nat.min_le_left _ _) positive localGuards localReplay
  apply effective_loss_le_of_unslashed_traces shared stop.pre genesis caps increment early
    v initial activated _ base quotient
  simpa only [debt] using path
private theorem Stop.clean_read_of_endpoint
    {tail : Run config checks x y} (stop : Stop tail i)
    (v w : Validator) (initial : x.state.validators.data[i]? = some v)
    (final : y.state.validators.data[i]? = some w) (clean : w.slashed = false) :
    ∃ u, stop.state.state.validators.data[i]? = some u ∧ u.slashed = false := by
  obtain ⟨u, found, _⟩ := stop.pre.registryLifecycle.validators i v initial
  refine ⟨u, found, ?_⟩
  cases flag : u.slashed with
  | false => rfl
  | true =>
    obtain ⟨last, located, marked⟩ := stop.post.slashedPersistence i u found flag
    have same := Option.some.inj (located.symm.trans final)
    subst last
    simp [clean] at marked
private theorem Stop.selected_charge_loss
    {tail : Run config checks x y} (stop : Stop tail i.toNat)
    (chosen : stop.charge = some c) (shared : Run config checks g x)
    (genesis : Genesis (config := config) (checks := checks) g) (caps : CapOrder preset)
    (increment : 0 < preset.EFFECTIVE_BALANCE_INCREMENT.toNat)
    (twoSlots : 2 ≤ preset.SLOTS_PER_EPOCH.toNat)
    (delay : 0 < config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    (early : stop.state.fork < .glamsterdam)
    (v w : Validator) (initial : x.state.validators.data[i.toNat]? = some v)
    (final : y.state.validators.data[i.toNat]? = some w)
    (unslashed : v.slashed = false) (clean : w.slashed = false)
    (activated : v.activationEpoch ≠ FAR_FUTURE_EPOCH)
    (endpoint : (getCurrentEpoch stop.state.state).toNat ≤ high + 1)
    (replayed : stop.pre.balanceEvents high = .ok events)
    (base quotient : Nat) (positive : 0 < quotient)
    (guards : ∀ {m n : ForkedBeaconState preset} (pre : Run config checks x m)
      (step : Step config checks m n) (post : Run config checks n stop.state),
      (pre.snoc step).append post = stop.pre →
      (getCurrentEpoch m.state).toNat < (getCurrentEpoch x.state).toNat +
        preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat -
          (preset.EPOCHS_PER_SLASHINGS_VECTOR / 2).toNat ∧
      quotient ≤ (EthLib.Consensus.parameters preset m.fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat ∧
      ∀ events, step.balanceEvents = .ok events → ∀ e ∈ events, e.source ≠ .crossing) :
    effectiveAt x i.toNat ≤ c.amount + (effectiveAt x i.toNat - actualBalanceAt x i.toNat) +
      ((events.map (floorPenaltyDebit i.toNat)).sum + (events.map (floorPartialDebit i)).sum) +
      (if FirstDown stop.pre i.toNat then preset.EFFECTIVE_BALANCE_INCREMENT.toNat else 0) := by
  obtain ⟨u, found, unmarked⟩ := stop.clean_read_of_endpoint v w initial final clean
  have bound := stop.selected_effective_loss chosen shared genesis caps increment twoSlots
    delay early v u initial found unslashed unmarked activated endpoint replayed
    base quotient positive guards
  have selected := stop.selected
  rw [chosen] at selected
  rwa [← selected.2.2.1] at bound
structure FirstUpdate {x y : ForkedBeaconState preset}
    (tail : Run config checks x y) (high i : Nat) where
  outer : ForkedBeaconState preset
  after : ForkedBeaconState preset
  pre : Run config checks x outer
  post : Run config checks after y
  advanced : BeaconState preset outer.fork
  cached : BeaconState preset outer.fork
  middle : BeaconState preset outer.fork
  updated : BeaconState preset outer.fork
  next : Slot
  stepOk : advanceSlotAcross config checks outer = .ok after
  split : (pre.snoc (.slot stepOk)).append post = tail
  nextOk : addChecked outer.state.slot 1 = .ok next
  last : next % preset.SLOTS_PER_EPOCH = 0
  advancedOk : advanceSlot config checks outer.state = .ok advanced
  cachedOk : processSlot outer.state = .ok cached
  events : List (BalanceEvent preset)
  replay : epochBalanceReplay (config := config) (checks := checks) cached = .ok (middle, events)
  updateOk : processEffectiveBalanceUpdates middle = .ok updated
  finalValidators : advanced.validators = updated.validators
  beforeValidator : Validator
  afterValidator : Validator
  foundBefore : middle.validators.data[i]? = some beforeValidator
  foundAfter : updated.validators.data[i]? = some afterValidator
  actualUpdate : updatedEffectiveBalance preset
    (withdrawalMaxEffectiveBalance preset outer.fork beforeValidator)
    ((middle.balances.data[i]?).getD 0) beforeValidator.effectiveBalance =
      .ok afterValidator.effectiveBalance
  decreases : afterValidator.effectiveBalance < beforeValidator.effectiveBalance
  noEarlier : ∀ j a b, pre.balancePath[j]? = some a →
    pre.balancePath[j + 1]? = some b → effectiveAt a i ≤ effectiveAt b i
  beforeFrame : beforeValidator.effectiveBalance.toNat = effectiveAt outer i
  prefixEvents : List (BalanceEvent preset)
  prefixReplay : pre.balanceEvents high = .ok prefixEvents
  gap : preset.downwardBand < beforeValidator.effectiveBalance.toNat -
    ((middle.balances.data[i]?.map UInt64.toNat).getD 0)
  resources : beforeValidator.effectiveBalance.toNat -
      ((middle.balances.data[i]?.map UInt64.toNat).getD 0) ≤
    (effectiveAt x i - actualBalanceAt x i) +
      ((prefixEvents ++ events).map (floorPenaltyDebit i)).sum +
      ((prefixEvents ++ events).map (floorPartialDebit (UInt64.ofNat i))).sum
private theorem firstUpdate_of_slot_replay
    {g x outer after y : ForkedBeaconState preset} {tail : Run config checks x y}
    (shared : Run config checks g x) (pre : Run config checks x outer)
    (post : Run config checks after y)
    (ok : advanceSlotAcross config checks outer = .ok after)
    (split : (pre.snoc (.slot ok)).append post = tail)
    (genesis : Genesis (config := config) (checks := checks) g)
    (caps : CapOrder preset) (aligned : MaxEffectiveBalancesAligned preset)
    (early : after.fork < .glamsterdam)
    (delay : 0 < config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    (i : ValidatorIndex) (v u w : Validator)
    (initial : x.state.validators.data[i.toNat]? = some v)
    (located : outer.state.validators.data[i.toNat]? = some u)
    (final : after.state.validators.data[i.toNat]? = some w)
    (unslashed : v.slashed = false) (clean : w.slashed = false)
    {advanced : BeaconState preset outer.fork}
    (advanceOk : advanceSlot config checks outer.state = .ok advanced)
    (decreases : effectiveAt ⟨outer.fork, advanced⟩ i.toNat < effectiveAt outer i.toNat)
    (ordered : ∀ j a b, pre.balancePath[j]? = some a →
      pre.balancePath[j + 1]? = some b → effectiveAt a i.toNat ≤ effectiveAt b i.toNat)
    {prefixEvents : List (BalanceEvent preset)}
    (prefixReplay : pre.balanceEvents replayHigh = .ok prefixEvents)
    (short : (getCurrentEpoch outer.state).toNat < (getCurrentEpoch x.state).toNat +
      preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat -
        (preset.EPOCHS_PER_SLASHINGS_VECTOR / 2).toNat)
    (endEpoch : (getCurrentEpoch after.state).toNat ≤ high + 1)
    (retained : high + 1 < w.exitEpoch.toNat)
    (noCrossing : ∀ found, (Step.slot ok).balanceEvents = .ok found →
      ∀ e ∈ found, e.source ≠ .crossing)
    {low base quotient : Nat} {account : FloorAccount}
    (trace : FloorTrace low base quotient
      ⟨actualBalanceAt x i.toNat, 0, effectiveAt x i.toNat, none⟩ account)
    (balance : account.balance = actualBalanceAt outer i.toNat)
    (unmarked : account.slashedHigh = none)
    (debt : account.debt = (prefixEvents.map (floorPenaltyDebit i.toNat)).sum +
      (prefixEvents.map (floorPartialDebit i)).sum)
    (capped : max low account.high ≤ (withdrawalMaxEffectiveBalance preset outer.fork u).toNat)
    (covered : effectiveAt outer i.toNat ≤ account.high) :
    Nonempty (FirstUpdate tail replayHigh i.toNat) := by
  have outerEarly := Nat.lt_of_le_of_lt (Step.slot ok).chainStep.fork_le early
  obtain ⟨next, cached, epoched, checked, last, cachedOk, epochOk, _finalSlot⟩ :=
    advanceSlot_decrease_last advanceOk decreases
  obtain ⟨middle, updated, events, replay, update, validators, balances⟩ :=
    epochBalanceReplay_result cached epoched outerEarly epochOk
  have finalValidators : advanced.validators = updated.validators := by
    rw [_finalSlot]
    exact validators.symm
  have finalBalances : advanced.balances = middle.balances := by
    rw [_finalSlot]
    exact balances.symm
  have lower : effectiveAt ⟨outer.fork, updated⟩ i.toNat < effectiveAt outer i.toNat := by
    simpa only [effectiveAt, finalValidators] using decreases
  obtain ⟨before, amount, effective, found, owned, afterRead, scalar, smaller, frame, gap⟩ :=
    reachable_update_decrease_gap (shared.append pre) genesis caps aligned outerEarly cachedOk
      epochOk replay update (Array.getElem?_eq_some_iff.mp located).1 lower
  have stepReplay := slot_epoch_events_eq ok cachedOk checked last replay advanceOk noCrossing
  have resource := slot_update_deficit_resources shared pre genesis caps ok early delay
    stepReplay i v u w initial located final unslashed clean short high endEpoch retained
    (noCrossing _ stepReplay) trace balance unmarked debt capped covered advanceOk finalBalances
  refine ⟨{
    outer := outer, after := after, pre := pre, post := post,
    advanced := advanced, cached := cached, middle := middle, updated := updated,
    next := next, stepOk := ok, split := split, nextOk := checked, last := last,
    advancedOk := advanceOk, cachedOk := cachedOk, events := events, replay := replay,
    updateOk := update, finalValidators := finalValidators, beforeValidator := before,
    afterValidator := { before with effectiveBalance := effective }, foundBefore := found,
    foundAfter := afterRead, actualUpdate := ?_, decreases := smaller, noEarlier := ordered,
    beforeFrame := frame, prefixEvents := prefixEvents, prefixReplay := prefixReplay,
    gap := ?_, resources := ?_ }⟩
  · simpa only [owned, Option.getD_some] using scalar
  · simpa only [owned, Option.map_some, Option.getD_some] using gap
  · simpa only [actualBalanceAt, owned, Option.map_some, Option.getD_some, ← frame,
      UInt64.ofNat_toNat] using resource
private theorem FirstUpdate.events_prefix
    {x y : ForkedBeaconState preset} {tail : Run config checks x y}
    {events : List (BalanceEvent preset)}
    (first : FirstUpdate tail high i)
    (endEpoch : (getCurrentEpoch y.state).toNat ≤ high + 1)
    (replayed : tail.balanceEvents high = .ok events) :
    (first.prefixEvents ++ first.events) <+: events := by
  obtain ⟨advanced, advanceOk, upgrades⟩ := bind_ok_iff.mp first.stepOk
  have same : advanced = first.advanced := Except.ok.inj (advanceOk.symm.trans first.advancedOk)
  subst advanced
  obtain ⟨crossings, crossingOk, _⟩ := upgradeBalanceReplay_bounded upgrades
  have checked : liftAccessor (liftArith (Uint64.addChecked first.outer.state.slot 1)) =
      (Except.ok first.next : Except TransitionError Slot) := by
    simp [first.nextOk, liftArith, liftAccessor, Except.mapError]
  have stepEvents := Step.balanceEvents_epoch_slot first.stepOk first.cachedOk checked
    first.last first.replay first.advancedOk crossingOk
  have outerEpoch : (getCurrentEpoch first.outer.state).toNat ≤ high + 1 :=
    (UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps
      ((Run.nil.snoc (.slot first.stepOk)).append first.post).chainSteps)).trans endEpoch
  have prefixOk : (first.pre.snoc (.slot first.stepOk)).balanceEvents high =
      .ok (first.prefixEvents ++ (first.events ++ crossings)) := by
    simp only [Run.balanceEvents, first.prefixReplay, outerEpoch, ↓reduceIte,
      stepEvents, bind, Except.bind, pure, Except.pure]
  rw [← first.split] at replayed
  obtain ⟨before, beforeOk, initial⟩ :=
    (first.pre.snoc (.slot first.stepOk)).balanceEvents_prefix first.post high events replayed
  have equal := Except.ok.inj (beforeOk.symm.trans prefixOk)
  rw [equal, ← List.append_assoc] at initial
  exact (List.prefix_append _ _).trans initial
private theorem prefix_resource_sum_le {α : Type} (carrier : Finset Nat)
    (parts : Nat → List α) (events : List α) (debit : Nat → α → Nat)
    (included : ∀ i ∈ carrier, parts i <+: events) :
    (∑ i ∈ carrier, ((parts i).map (debit i)).sum) ≤
      (events.map fun event => ∑ i ∈ carrier, debit i event).sum := by
  have point : (∑ i ∈ carrier, ((parts i).map (debit i)).sum) ≤
      ∑ i ∈ carrier, (events.map (debit i)).sum := by
    apply Finset.sum_le_sum
    intro i member
    exact ((included i member).sublist.map _).sum_le_sum (fun _ _ => Nat.zero_le _)
  have swap : (∑ i ∈ carrier, (events.map (debit i)).sum) =
      (events.map fun event => ∑ i ∈ carrier, debit i event).sum := by
    clear included point
    induction events with
    | nil => simp
    | cons event events ih => simp [Finset.sum_add_distrib, ih]
  exact point.trans_eq swap
structure LedgerCuts {x y : ForkedBeaconState preset}
    (tail : Run config checks x y) where
  stops : (i : Nat) → Stop tail i
  cut : Nat → ForkedBeaconState preset
  headRun : (i : Nat) → Run config checks x (cut i)
  suffix : (i : Nat) → Run config checks (cut i) y
  split : ∀ i, (headRun i).append (suffix i) = tail
  retainedCut : ∀ i, (y.state.validators.data[i]?).any (fun v =>
    isActiveValidator v (getCurrentEpoch y.state)) → cut i = y ∧ HEq (headRun i) tail
  stoppedCut : ∀ i, ¬ (y.state.validators.data[i]?).any (fun v =>
    isActiveValidator v (getCurrentEpoch y.state)) →
    cut i = (stops i).state ∧ HEq (headRun i) (stops i).pre
private def LedgerCuts.ofStops {x y : ForkedBeaconState preset}
    (tail : Run config checks x y) (stops : (i : Nat) → Stop tail i) : LedgerCuts tail := by
  let cuts (i : Nat) : (s : ForkedBeaconState preset) ×
      (pre : Run config checks x s) × {post : Run config checks s y // pre.append post = tail} :=
    if (y.state.validators.data[i]?).any (fun v =>
        isActiveValidator v (getCurrentEpoch y.state)) then
      ⟨y, tail, .nil, rfl⟩
    else ⟨(stops i).state, (stops i).pre, (stops i).post, (stops i).split⟩
  exact {
    stops := stops
    cut := fun i => (cuts i).1
    headRun := fun i => (cuts i).2.1
    suffix := fun i => (cuts i).2.2.val
    split := fun i => (cuts i).2.2.property
    retainedCut := fun i active => by
      dsimp only [cuts]
      rw [ite_eq_left active]
      exact ⟨rfl, HEq.rfl⟩
    stoppedCut := fun i inactive => by
      dsimp only [cuts]
      rw [ite_eq_right inactive]
      exact ⟨rfl, HEq.rfl⟩ }
structure RoundLedger {x y : ForkedBeaconState preset}
    (tail : Run config checks x y) (high : Nat) extends LedgerCuts tail where
  falling : Finset Nat
  exactCarrier : ∀ i, i ∈ falling ↔ i < x.state.validators.data.size ∧
    (x.state.validators.data[i]?).any (fun v => isActiveValidator v (getCurrentEpoch x.state) &&
      !v.slashed && decide (v.exitEpoch = FAR_FUTURE_EPOCH ∨ horizonEnd x high < v.exitEpoch.toNat))
        ∧
    ((cut i).state.validators.data[i]?.map (·.slashed)).getD true = false ∧
    FirstDown (headRun i) i
  first : ∀ i, i ∈ falling → FirstUpdate (headRun i) high i
  a : Nat → Nat
  p : Nat → Nat
  exactA : ∀ i (member : i ∈ falling), a i = (effectiveAt x i - actualBalanceAt x i) +
    (((first i member).prefixEvents ++ (first i member).events).map (floorPenaltyDebit i)).sum
  exactP : ∀ i (member : i ∈ falling), p i =
    (((first i member).prefixEvents ++ (first i member).events).map
      (floorPartialDebit (UInt64.ofNat i))).sum
  aBound : (∑ i ∈ falling, a i) ≤
    startSlack x + windowPenalties (config := config) x high (driftHorizon x high + 1)
  pBound : (∑ i ∈ falling, p i) ≤ withdrawalBudget (config := config) x high
  countBound : falling.card ≤
    finalKeyCount preset (referenceStake x) (referenceCount x)
        (stakeCeilingAt config x high (driftHorizon x high + 1))
  roundBound : preset.EFFECTIVE_BALANCE_INCREMENT.toNat * falling.card ≤
    roundingBudget (config := config) x high
  sourceFalling : Finset Nat
  exactSourceCarrier : ∀ i, i ∈ sourceFalling ↔ i < x.state.validators.data.size ∧
    NewReference x i ∧
    ((stops i).state.state.validators.data[i]?.map (·.slashed)).getD true = false ∧
    FirstDown (stops i).pre i
  sourceFirst : ∀ i, i ∈ sourceFalling → FirstUpdate (stops i).pre high i
  sourceA : Nat → Nat
  sourceP : Nat → Nat
  exactSourceA : ∀ i (member : i ∈ sourceFalling), sourceA i =
    (effectiveAt x i - actualBalanceAt x i) +
      (((sourceFirst i member).prefixEvents ++ (sourceFirst i member).events).map
        (floorPenaltyDebit i)).sum
  exactSourceP : ∀ i (member : i ∈ sourceFalling), sourceP i =
    (((sourceFirst i member).prefixEvents ++ (sourceFirst i member).events).map
      (floorPartialDebit (UInt64.ofNat i))).sum
  sourceABound : (∑ i ∈ sourceFalling, sourceA i) ≤
    startSlack x + windowPenalties (config := config) x high (driftHorizon x high + 1)
  sourcePBound : (∑ i ∈ sourceFalling, sourceP i) ≤ withdrawalBudget (config := config) x high
  sourceCountBound : sourceFalling.card ≤
    finalKeyCount preset (referenceStake x) (referenceCount x)
        (stakeCeilingAt config x high (driftHorizon x high + 1))
  sourceRoundBound : preset.EFFECTIVE_BALANCE_INCREMENT.toNat * sourceFalling.card ≤
    roundingBudget (config := config) x high
/-- A sum over keys active at `x` is at most the sum over the active indices. -/
private theorem initial_active_sum_le
    {x : ForkedBeaconState preset} (carrier : Finset Nat) (early : x.fork < .glamsterdam)
    (active : ∀ i ∈ carrier, ∃ v, x.state.validators.data[i]? = some v ∧
      isActiveValidator v (getCurrentEpoch x.state) = true) (f : Nat → Nat) :
    (∑ i ∈ carrier, f i) ≤
      ((getActiveValidatorIndices x.state (getCurrentEpoch x.state)).map fun i =>
        f i.toNat).sum := by
  have within := x.state.validators.bound early
  have numeric : ∀ i ∈ carrier, (UInt64.ofNat i).toNat = i := by
    intro i member
    obtain ⟨v, found, _⟩ := active i member
    exact toNat_toUInt64_of_lt within (Array.getElem?_eq_some_iff.mp found).1
  have subset : carrier.image UInt64.ofNat ⊆
      (getActiveValidatorIndices x.state (getCurrentEpoch x.state)).toFinset := by
    intro index member
    obtain ⟨i, inside, rfl⟩ := Finset.mem_image.mp member
    obtain ⟨v, found, enabled⟩ := active i inside
    apply List.mem_toFinset.mpr
    exact (mem_getActiveValidatorIndices within).mpr
      ⟨v, by simpa only [numeric i inside] using found, enabled⟩
  have unique := (getActiveValidatorIndices_sorted within (getCurrentEpoch x.state)).imp
    (fun {a b} less (same : a = b) => by subst same; exact UInt64.lt_irrefl _ less)
  rw [← List.sum_toFinset _ unique]
  have sumImage : (carrier.image UInt64.ofNat).sum (fun idx => f idx.toNat) =
      ∑ i ∈ carrier, f i := by
    rw [Finset.sum_image]
    · apply Finset.sum_congr rfl
      intro i member
      rw [numeric i member]
    · intro i hi j hj same
      have equal := congrArg UInt64.toNat same
      simpa only [numeric i hi, numeric j hj] using equal
  rw [← sumImage]
  exact Finset.sum_le_sum_of_subset subset
private theorem initial_active_slack_le
    {x : ForkedBeaconState preset} (carrier : Finset Nat) (early : x.fork < .glamsterdam)
    (active : ∀ i ∈ carrier, ∃ v, x.state.validators.data[i]? = some v ∧
      isActiveValidator v (getCurrentEpoch x.state) = true) :
    (∑ i ∈ carrier, (effectiveAt x i - actualBalanceAt x i)) ≤ startSlack x :=
  initial_active_sum_le carrier early active fun i => effectiveAt x i - actualBalanceAt x i
private theorem initial_unslashed_debit_le
    {x : ForkedBeaconState preset} (carrier : Finset Nat) (early : x.fork < .glamsterdam)
    (active : ∀ i ∈ carrier, ∃ v, x.state.validators.data[i]? = some v ∧
      isActiveValidator v (getCurrentEpoch x.state) = true ∧ v.slashed = false)
    (debit : Nat → Nat) :
    (∑ i ∈ carrier, debit i) ≤
      ((getActiveValidatorIndices x.state (getCurrentEpoch x.state)).map fun i =>
        if (x.state.validators.data[i.toNat]?.map (·.slashed)).getD true then 0
          else debit i.toNat).sum := by
  have within := x.state.validators.bound early
  have numeric : ∀ i ∈ carrier, (UInt64.ofNat i).toNat = i := by
    intro i member
    obtain ⟨v, found, _⟩ := active i member
    exact toNat_toUInt64_of_lt within (Array.getElem?_eq_some_iff.mp found).1
  have subset : carrier.image UInt64.ofNat ⊆
      (getActiveValidatorIndices x.state (getCurrentEpoch x.state)).toFinset := by
    intro index member
    obtain ⟨i, inside, rfl⟩ := Finset.mem_image.mp member
    obtain ⟨v, found, enabled, _⟩ := active i inside
    apply List.mem_toFinset.mpr
    exact (mem_getActiveValidatorIndices within).mpr
      ⟨v, by simpa only [numeric i inside] using found, enabled⟩
  have unique := (getActiveValidatorIndices_sorted within (getCurrentEpoch x.state)).imp
    (fun {a b} less (same : a = b) => by subst same; exact UInt64.lt_irrefl _ less)
  rw [← List.sum_toFinset _ unique]
  have sumImage : (carrier.image UInt64.ofNat).sum (fun idx =>
      if (x.state.validators.data[idx.toNat]?.map (·.slashed)).getD true then 0
        else debit idx.toNat) = ∑ i ∈ carrier, debit i := by
    rw [Finset.sum_image]
    · apply Finset.sum_congr rfl
      intro i member
      obtain ⟨v, found, _, unslashed⟩ := active i member
      simp [numeric i member, found, unslashed]
    · intro i hi j hj same
      have equal := congrArg UInt64.toNat same
      simpa only [numeric i hi, numeric j hj] using equal
  rw [← sumImage]
  exact Finset.sum_le_sum_of_subset subset
private theorem slot_partial_sum {x y : ForkedBeaconState preset}
    (ok : advanceSlotAcross config checks x = .ok y) (early : y.fork < .glamsterdam)
    {events : List (BalanceEvent preset)}
    (replayed : (Step.slot ok).balanceEvents = .ok events) :
    (events.map fun e => ∑ i ∈ Finset.range e.before.state.validators.data.size,
      floorPartialDebit (UInt64.ofNat i) e).sum = 0 := by
  have absent : ∀ e ∈ events, e.source ≠ .withdrawals := by
    obtain ⟨advanced, cached, crossings, _, _, _, crossingOk, split⟩ :=
      Step.balanceEvents_slot ok early replayed
    rcases split with ⟨_, rfl⟩ |
      ⟨middle, _, recorded, recordedOk, _, _, _, shape, _, _, _, _, _⟩
    · intro e member source
      have crossed := upgradeBalanceReplay_crossing crossingOk e member
      rw [crossed] at source
      cases source
    · intro e member source
      rw [shape] at member
      rcases List.mem_append.mp member with recordedMember | crossingMember
      · exact epochBalanceReplay_no_withdrawals recordedOk e recordedMember source
      · have crossed := upgradeBalanceReplay_crossing crossingOk e crossingMember
        rw [crossed] at source
        cases source
  have each : ∀ e ∈ events,
      (∑ i ∈ Finset.range e.before.state.validators.data.size,
        floorPartialDebit (UInt64.ofNat i) e) = 0 := by
    intro e member
    simp [floorPartialDebit, absent e member]
  exact List.sum_eq_zero (by
    intro n member
    obtain ⟨e, present, rfl⟩ := List.mem_map.mp member
    exact each e present)
private theorem partial_calls_le_window (calls : List (IndexedDepartureCall preset config))
    (cutoff : Nat) :
    ((calls.filter fun called => called.index.isNone &&
      decide (called.call.epoch.toNat + config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat ≤
        cutoff)).map (·.call.amount.toNat)).sum ≤
    ((calls.filter fun called => called.call.epoch.toNat ≤ cutoff).map
      (·.call.amount.toNat)).sum := by
  induction calls with
  | nil => exact Nat.le_refl _
  | cons called rest ih =>
    by_cases due : called.call.epoch.toNat +
        config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat ≤ cutoff
    · have before : called.call.epoch.toNat ≤ cutoff := by omega
      cases indexed : called.index.isNone <;> simp [due, before, indexed] <;> omega
    · by_cases before : called.call.epoch.toNat ≤ cutoff <;> simp [due, before] <;> omega
private theorem initial_partials_at_L (x : ForkedBeaconState preset) (high : Nat)
    (electra : .pectra ≤ x.fork) :
    (((x.state.pendingPartialWithdrawals electra).data.toList.filter
      (fun entry => entry.withdrawableEpoch.toNat ≤ horizonEnd x high)).map (·.amount.toNat)).sum =
      duePartialWithdrawals x (driftHorizon x high) := by
  unfold duePartialWithdrawals
  simp only [electra, ↓reduceDIte]
  generalize (x.state.pendingPartialWithdrawals electra).data.toList = entries
  induction entries with
  | nil => rfl
  | cons entry rest ih =>
    by_cases due : entry.withdrawableEpoch.toNat ≤ horizonEnd x high
    · simpa [due, horizonEnd] using congrArg (entry.amount.toNat + ·) ih
    · simpa [due, horizonEnd] using ih
private theorem initial_partials_le_Pp (x : ForkedBeaconState preset) (high : Nat)
    (electra : .pectra ≤ x.fork) :
    (((x.state.pendingPartialWithdrawals electra).data.toList.filter
      (fun entry => entry.withdrawableEpoch.toNat ≤ high + 1)).map (·.amount.toNat)).sum ≤
      duePartialWithdrawals x (driftHorizon x high) := by
  rw [← initial_partials_at_L x high electra]
  have horizon : high + 1 ≤ horizonEnd x high := by unfold horizonEnd driftHorizon; omega
  generalize (x.state.pendingPartialWithdrawals electra).data.toList = entries
  induction entries with
  | nil => exact Nat.le_refl _
  | cons entry rest ih =>
    by_cases due : entry.withdrawableEpoch.toNat ≤ high + 1
    · have later := due.trans horizon
      simp [due, later]; omega
    · by_cases later : entry.withdrawableEpoch.toNat ≤
        horizonEnd x high <;> simp [due, later] <;> omega
private theorem opened_exit_capacity_le_paid (x : ForkedBeaconState preset) (high : Nat)
    (electra : .pectra ≤ x.fork) :
    (∑ epoch ∈ Finset.Ico (max (getCurrentEpoch x.state).toNat (exitQueueStart x + 1))
        (horizonEnd x high + 1),
      exitFlowAt (config := config) x high (epoch - (getCurrentEpoch x.state).toNat)) ≤
    (((List.range (driftHorizon x high + 2)).filter
      (max (exitQueueStart x - (getCurrentEpoch x.state).toNat)
        (preElectraEpochs config x high) ≤ ·)).map (exitFlowAt (config := config) x high)).sum := by
  have notBefore : ¬ x.fork < .pectra := Nat.not_lt_of_ge electra
  have zero : preElectraEpochs config x high = 0 := by simp [preElectraEpochs, notBefore]
  have convertSum :
      (((List.range (driftHorizon x high + 2)).filter
        (max (exitQueueStart x - (getCurrentEpoch x.state).toNat)
          (preElectraEpochs config x high) ≤ ·)).map (exitFlowAt (config := config) x high)).sum =
      ∑ t ∈ Finset.range (driftHorizon x high + 2),
        if exitQueueStart x - (getCurrentEpoch x.state).toNat ≤ t then
          exitFlowAt (config := config) x high t else 0 := by
    have sums := List.sum_map_ite
      (fun t => exitQueueStart x - (getCurrentEpoch x.state).toNat ≤ t)
      (exitFlowAt (config := config) x high) (fun _ => 0) (List.range (driftHorizon x high + 2))
    rw [← List.sum_toFinset _ List.nodup_range] at sums
    simpa [zero, List.toFinset_range] using sums.symm
  rw [convertSum]
  refine Finset.sum_le_sum_of_injOn
    (s := Finset.Ico (max (getCurrentEpoch x.state).toNat (exitQueueStart x + 1))
      (horizonEnd x high + 1))
    (t := Finset.range (driftHorizon x high + 2))
    (fun epoch => epoch - (getCurrentEpoch x.state).toNat) ?_ ?_ ?_ ?_
  · intro a ha b hb same
    have ha := Finset.mem_Ico.mp ha
    have hb := Finset.mem_Ico.mp hb
    change a - (getCurrentEpoch x.state).toNat = b - (getCurrentEpoch x.state).toNat at same
    omega
  · intro epoch member
    obtain ⟨original, inside, rfl⟩ := Finset.mem_image.mp member
    have inside := Finset.mem_Ico.mp inside
    simp only [Finset.mem_range]
    unfold horizonEnd at inside
    omega
  · intro epoch member
    simp only [Finset.mem_Ico] at member
    rw [ite_eq_left (by omega)]
  · intro _ _ _
    exact Nat.zero_le _
private theorem exit_trace_le_paid (x : ForkedBeaconState preset) (high : Nat)
    (electra : .pectra ≤ x.fork) {epoch : Epoch} {left : Gwei}
    {calls : List DepartureQueueCall}
    (trace : DepartureQueueTrace (x.state.earliestExitEpoch electra)
      (x.state.exitBalanceToConsume electra) calls epoch left)
    (starts : ∀ call ∈ calls, (getCurrentEpoch x.state).toNat ≤ call.first.toNat)
    (rates : ∀ call ∈ calls, ∀ n, call.first.toNat ≤ n → call.earliest.toNat < n →
      n ≤ call.epoch.toNat → call.rate.toNat ≤
        exitFlowAt (config := config) x high (n - (getCurrentEpoch x.state).toNat)) :
    ((calls.filter fun call => call.epoch.toNat ≤ horizonEnd x high).map (·.amount.toNat)).sum ≤
      withdrawalBudget (config := config) x high -
          duePartialWithdrawals x (driftHorizon x high) := by
  have bound := trace_window_envelope_from trace
    (fun n => exitFlowAt (config := config) x high (n - (getCurrentEpoch x.state).toNat))
    (getCurrentEpoch x.state).toNat (horizonEnd x high) starts rates
  have capacity := opened_exit_capacity_le_paid (config := config) x high electra
  have start : (x.state.earliestExitEpoch electra).toNat = exitQueueStart x := by
    simp [exitQueueStart, electra]
  rw [start] at bound
  by_cases inside : exitQueueStart x ≤ horizonEnd x high
  · rw [ite_eq_left inside] at bound
    simp only
        [withdrawalBudget, dueExitCarry, inside, ↓reduceIte, exitBalanceCarry, electra, ↓reduceDIte]
    omega
  · rw [ite_eq_right inside] at bound
    exact bound.trans (Nat.zero_le _)
private theorem exit_rate_le_churn {fork : Fork} {s : BeaconState preset fork}
    (early : fork < .glamsterdam) {total rate : Gwei}
    (read : getTotalActiveBalance s = .ok total)
    (computed : exitChurnLimit config s = .ok rate) :
    rate.toNat ≤ activationExitChurn preset config total.toNat := by
  have notGloas : ¬ .glamsterdam ≤ fork := Nat.not_le_of_lt early
  have value : rate = min config.MAX_PER_EPOCH_ACTIVATION_EXIT_CHURN_LIMIT
      (roundToIncrement preset (max config.MIN_PER_EPOCH_CHURN_LIMIT_ELECTRA
        (total / config.CHURN_LIMIT_QUOTIENT))) := by
    simpa [exitChurnLimit, notGloas, getActivationExitChurnLimit,
      getBalanceChurnLimit, read, bind, Except.bind, pure, Except.pure] using computed.symm
  rw [value, Uint64.toNat_min, toNat_roundToIncrement, Uint64.toNat_max, UInt64.toNat_div]
  have share := Nat.div_add_mod (total.toNat / config.CHURN_LIMIT_QUOTIENT.toNat)
    preset.EFFECTIVE_BALANCE_INCREMENT.toNat
  have rounded :
      max config.MIN_PER_EPOCH_CHURN_LIMIT_ELECTRA.toNat
          (total.toNat / config.CHURN_LIMIT_QUOTIENT.toNat) -
        max config.MIN_PER_EPOCH_CHURN_LIMIT_ELECTRA.toNat
          (total.toNat / config.CHURN_LIMIT_QUOTIENT.toNat) %
            preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤ balanceChurn preset config total.toNat := by
    unfold balanceChurn
    rw [Nat.mul_comm (total.toNat / config.CHURN_LIMIT_QUOTIENT.toNat /
      preset.EFFECTIVE_BALANCE_INCREMENT.toNat)]
    rcases Nat.le_total config.MIN_PER_EPOCH_CHURN_LIMIT_ELECTRA.toNat
      (total.toNat / config.CHURN_LIMIT_QUOTIENT.toNat) with low | high
    · rw [Nat.max_eq_right low]
      omega
    · rw [Nat.max_eq_left high]
      omega
  exact min_le_min_left _ rounded
private theorem exit_churn_mono {low high : Nat} (less : low ≤ high) :
    activationExitChurn preset config low ≤ activationExitChurn preset config high := by
  exact min_le_min_left _
    (max_le_max_left _ (Nat.mul_le_mul_right _
      (Nat.div_le_div_right (Nat.div_le_div_right less))))
private theorem exit_site_opened_rate (x : ForkedBeaconState preset) (high : Nat)
    (electra : .pectra ≤ x.fork) {fork : Fork} {s : BeaconState preset fork}
    (early : fork < .glamsterdam) {total rate : Gwei}
    (read : getTotalActiveBalance s = .ok total)
    (computed : exitChurnLimit config s = .ok rate) (atEpoch : Nat)
    (ceiling : total.toNat ≤ stakeCeilingAt config x high atEpoch) :
    ∀ n, atEpoch ≤ n - (getCurrentEpoch x.state).toNat →
      rate.toNat ≤ exitFlowAt (config := config) x high (n - (getCurrentEpoch x.state).toNat) := by
  intro n later
  have rateBound := exit_rate_le_churn early read computed
  have stake := ceiling.trans (ceilingAt_mono (config := config) electra high later)
  have bound := rateBound.trans (exit_churn_mono (config := config) stake)
  have notBefore : ¬ x.fork < .pectra := Nat.not_lt_of_ge electra
  have zero : preElectraEpochs config x high = 0 := by simp [preElectraEpochs, notBefore]
  simpa only [exitFlowAt, exitFlow, zero, Nat.not_lt_zero, ↓reduceIte] using bound
private theorem exit_call_opened_rate (x : ForkedBeaconState preset) (high : Nat)
    (electra : .pectra ≤ x.fork) {fork : Fork} {s : BeaconState preset fork}
    (early : fork < .glamsterdam) (call : DepartureQueueCall)
    (first : computeActivationExitEpoch preset (getCurrentEpoch s) = .ok call.first)
    (computed : exitChurnLimit config s = .ok call.rate) {total : Gwei}
    (read : getTotalActiveBalance s = .ok total)
    (ceiling : total.toNat ≤ stakeCeilingAt config x high
      ((getCurrentEpoch s).toNat - (getCurrentEpoch x.state).toNat)) :
    ∀ n, call.first.toNat ≤ n → call.earliest.toNat < n → n ≤ call.epoch.toNat →
      call.rate.toNat ≤ exitFlowAt (config := config) x high
        (n - (getCurrentEpoch x.state).toNat) := by
  intro n opened _ _
  have firstEpoch := (computeActivationExitEpoch_ok_iff.mp first).2
  apply exit_site_opened_rate x high electra early read computed _ ceiling n
  omega
private theorem run_partials_le_paid (x : ForkedBeaconState preset) (high : Nat)
    (electra : .pectra ≤ x.fork) {y : ForkedBeaconState preset}
    (tail : Run config checks x y) (early : y.fork < .glamsterdam)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    (endpoint : (getCurrentEpoch y.state).toNat ≤ horizonEnd x high)
    (ceilings : ∀ {u v} (step : Step config checks u v), tail.Contains step →
      ∀ total, getTotalActiveBalance u.state = .ok total → total.toNat ≤
        stakeCeilingAt config x high
          ((getCurrentEpoch u.state).toNat - (getCurrentEpoch x.state).toNat)) :
    (events.map fun e => ∑ i ∈ Finset.range e.before.state.validators.data.size,
      floorPartialDebit (UInt64.ofNat i) e).sum ≤ withdrawalBudget (config := config) x high := by
  obtain ⟨calls, trace, firsts, rates, partials⟩ := run_partial_queue_trace
    (partialDebit := floorPartialDebit)
    (ceilingValue := stakeCeilingAt config x high)
    (exitEnvelope := exitFlowAt (config := config) x high)
    (callRate := exit_call_opened_rate x high electra)
    (partialDebit_eq := rfl) (slot_zero := slot_partial_sum)
    high (horizonEnd x high) electra tail early replayed endpoint ceilings
  rw [initial_partials_at_L x high electra] at partials
  have selected := partial_calls_le_window calls (horizonEnd x high)
  have capacity := exit_trace_le_paid x high electra trace
    (by
      intro call member
      obtain ⟨called, present, rfl⟩ := List.mem_map.mp member
      exact firsts called present)
    (by
      intro call member
      obtain ⟨called, present, rfl⟩ := List.mem_map.mp member
      exact rates called present)
  have mapped : (((calls.map (·.call)).filter fun call => call.epoch.toNat ≤ horizonEnd x high).map
      (·.amount.toNat)).sum =
      ((calls.filter fun called => called.call.epoch.toNat ≤ horizonEnd x high).map
        (·.call.amount.toNat)).sum := by
    rw [List.filter_map, List.map_map]
    rfl
  rw [mapped] at capacity
  have included : duePartialWithdrawals x (driftHorizon x high) ≤
      withdrawalBudget (config := config) x high := by
    unfold withdrawalBudget
    omega
  omega
private theorem run_partials_le_paid_of_stake (x : ForkedBeaconState preset) (high : Nat)
    (electra : .pectra ≤ x.fork) {y : ForkedBeaconState preset}
    (tail : Run config checks x y) (early : y.fork < .glamsterdam)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    (endpoint : (getCurrentEpoch y.state).toNat ≤ horizonEnd x high)
    (stake : ∀ {u v} (step : Step config checks u v), tail.Contains step →
      ∑ i ∈ (getActiveValidatorIndices u.state (getCurrentEpoch u.state)).toFinset,
        effectiveAt u i.toNat ≤ stakeCeilingAt config x high
          ((getCurrentEpoch u.state).toNat - (getCurrentEpoch x.state).toNat))
    (unit : ∀ {u v} (step : Step config checks u v), tail.Contains step →
      preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤ stakeCeilingAt config x high
        ((getCurrentEpoch u.state).toNat - (getCurrentEpoch x.state).toNat)) :
    (events.map fun e => ∑ i ∈ Finset.range e.before.state.validators.data.size,
      floorPartialDebit (UInt64.ofNat i) e).sum ≤ withdrawalBudget (config := config) x high := by
  apply run_partials_le_paid x high electra tail early replayed endpoint
  intro u v step member total read
  have value := (getTotalBalance_ok_iff_stake.mp (getTotalActiveBalance_ok read)).2.2
  rw [value]
  exact max_le (unit step member) (stake step member)
private theorem run_partials_le_paid_of_endpoint_floor
    (shared : Run config checks g x) (genesis : Genesis (config := config) (checks := checks) g)
    (tail : Run config checks x y) (electra : .pectra ≤ x.fork)
    (early : y.fork < .glamsterdam) (high : Nat)
    (endpoint : (getCurrentEpoch y.state).toNat ≤ high + 1)
    (guard : aprioriGuardAt config x high) (maxAligned : MaxEffectiveBalancesAligned preset)
    (unit : preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤ stakeCeilingAt config x high 0)
    (others : ∀ {u : ForkedBeaconState preset} (head : Run config checks x u),
      u.fork < .glamsterdam → (getCurrentEpoch u.state).toNat ≤ high + 1 → ∀ found,
        head.balanceEvents high = .ok found → (found.map otherCredit).sum ≤
          whistleblowerAllowance preset config (referenceCount x) (scheduledActivationCount x)
            (unassignedPreStake x) (fundingCarry x) (exitedSlashableCount x)
            (driftHorizon x high) (preElectraEpochs config x high))
    (floor : ∀ {u : ForkedBeaconState preset}, Run config checks x u → u.fork < .glamsterdam →
      (getCurrentEpoch u.state).toNat < (getCurrentEpoch y.state).toNat → ∀ total,
        getTotalActiveBalance u.state = .ok total →
        stakeFloorAt config x high
          ((getCurrentEpoch u.state).toNat - (getCurrentEpoch x.state).toNat) ≤ total.toNat)
    (replayed : tail.balanceEvents high = .ok events) :
    (events.map fun e => ∑ i ∈ Finset.range e.before.state.validators.data.size,
      floorPartialDebit (UInt64.ofNat i) e).sum ≤ withdrawalBudget (config := config) x high := by
  have contained {u v} (step : Step config checks u v) (member : tail.Contains step) :
      u.fork < .glamsterdam ∧
      (getCurrentEpoch u.state).toNat ≤ (getCurrentEpoch y.state).toNat ∧
      (getCurrentEpoch u.state).toNat - (getCurrentEpoch x.state).toNat ≤
        driftHorizon x high + 1 := by
    obtain ⟨_, _, _, uEarly, order⟩ := Run.contains_step_facts member early
    refine ⟨uEarly, order, ?_⟩
    unfold driftHorizon
    omega
  apply run_partials_le_paid_of_stake x high electra tail early replayed
    (endpoint.trans (by unfold horizonEnd driftHorizon; omega))
  · intro u v step member
    obtain ⟨pre, _, _⟩ := tail.contains_split step member
    have bounds := contained step member
    exact (activeStake_le_ceiling shared genesis pre electra bounds.1 high
      (bounds.2.1.trans endpoint) guard maxAligned unit others
      (fun path pathEarly earlier total read => floor path pathEarly
        (earlier.trans_le bounds.2.1) total read)).1
  · intro u v step member
    exact unit.trans (ceilingAt_mono electra high (Nat.zero_le _))
private theorem run_joint_departures_high_scalar (x : ForkedBeaconState preset) (high : Nat)
    (electra : .pectra ≤ x.fork) {y : ForkedBeaconState preset}
    (tail : Run config checks x y) (early : y.fork < .glamsterdam)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    (endpoint : (getCurrentEpoch y.state).toNat ≤ high + 1)
    (ceilings : ∀ {u v} (step : Step config checks u v), tail.Contains step →
      ∀ total, getTotalActiveBalance u.state = .ok total → total.toNat ≤
        stakeCeilingAt config x high
          ((getCurrentEpoch u.state).toNat - (getCurrentEpoch x.state).toNat)) :
    ((tail.departureCharges.filter fun charge => charge.epoch ≤ high + 1).map (·.amount)).sum +
      (events.map fun e => ∑ i ∈ Finset.range e.before.state.validators.data.size,
        floorPartialDebit (UInt64.ofNat i) e).sum ≤ duePartialWithdrawals x (driftHorizon x high) +
          queueCarry x high +
      (high + 2 - max (getCurrentEpoch x.state).toNat (exitQueueStart x)) *
        config.MAX_PER_EPOCH_ACTIVATION_EXIT_CHURN_LIMIT.toNat +
      (high + 2 - max (getCurrentEpoch x.state).toNat (consolidationQueueStart x)) *
        consolidationFlowAt (config := config) x high 0 := by
  have initial := initial_partials_le_Pp x high electra
  have notBefore : ¬ x.fork < .pectra := Nat.not_lt_of_ge electra
  have zero : preElectraEpochs config x high = 0 := by simp [preElectraEpochs, notBefore]
  have bound :=
      run_joint_partial_window (partialDebit := floorPartialDebit) (partialDebit_eq := rfl)
    (slot_zero := slot_partial_sum) tail electra early replayed endpoint
    (consolidationFlowAt (config := config) x high 0) (by
      intro u v step member _ total read rate computed
      obtain ⟨_, _, _, sourceEarly, epochOrder⟩ := Run.contains_step_facts member early
      have index : (getCurrentEpoch u.state).toNat - (getCurrentEpoch x.state).toNat ≤
          driftHorizon x high + 1 := by
        unfold driftHorizon
        omega
      have bound := (consolidationChurnLimit_le sourceEarly read computed).trans
        (consolidationChurn_mono ((ceilings step member total read).trans
          (ceilingAt_mono electra high index)))
      simpa only [consolidationFlowAt, consolidationFlow, zero, Nat.lt_irrefl, ↓reduceIte]
          using bound)
  simp only [queueCarry, exitQueueStart, consolidationQueueStart, electra, ↓reduceDIte]
  omega
private theorem run_joint_departures_high_budget (x : ForkedBeaconState preset) (high : Nat)
    (electra : .pectra ≤ x.fork) {y : ForkedBeaconState preset}
    (tail : Run config checks x y) (early : y.fork < .glamsterdam)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    (endpoint : (getCurrentEpoch y.state).toNat ≤ high + 1)
    (ceilings : ∀ {u v} (step : Step config checks u v), tail.Contains step →
      ∀ total, getTotalActiveBalance u.state = .ok total → total.toNat ≤
        stakeCeilingAt config x high
          ((getCurrentEpoch u.state).toNat - (getCurrentEpoch x.state).toNat)) :
    ((tail.departureCharges.filter fun charge => charge.epoch ≤ high + 1).map (·.amount)).sum +
      (events.map fun e => ∑ i ∈ Finset.range e.before.state.validators.data.size,
        floorPartialDebit (UInt64.ofNat i) e).sum ≤ departureBudgetAt (config := config) x high +
          duePartialWithdrawals x (driftHorizon x high) := by
  have bound :=
      run_joint_departures_high_scalar x high electra tail early replayed endpoint ceilings
  have notBefore : ¬ x.fork < .pectra := Nat.not_lt_of_ge electra
  have zero : preElectraEpochs config x high = 0 := by simp [preElectraEpochs, notBefore]
  have from_ (start : Nat) : high + 2 - max (getCurrentEpoch x.state).toNat start ≤
      driftHorizon x high + 2 - (start - (getCurrentEpoch x.state).toNat) := by
    unfold driftHorizon
    omega
  have exitTerm := Nat.mul_le_mul_right
    config.MAX_PER_EPOCH_ACTIVATION_EXIT_CHURN_LIMIT.toNat (from_ (exitQueueStart x))
  have consolidationTerm := Nat.mul_le_mul_right
    (consolidationFlowAt (config := config) x high 0) (from_ (consolidationQueueStart x))
  simp only [departureBudgetAt, departureBudget, zero, lt_self_iff_false, ↓reduceIte]
  simp only [consolidationFlowAt, consolidationFlow, zero, Nat.lt_irrefl, ↓reduceIte]
    at bound consolidationTerm
  simp only [stakeCeilingAt] at bound exitTerm consolidationTerm ⊢
  simp only [zero] at bound consolidationTerm
  omega
/-- Each step of a branch starts where the total active balance fits the ceiling of its epoch. -/
private theorem stepTotal_le_ceiling {g x y : ForkedBeaconState preset}
    (shared : Run config checks g x) (genesis : Genesis (config := config) (checks := checks) g)
    (tail : Run config checks x y) (electra : .pectra ≤ x.fork)
    (early : y.fork < .glamsterdam) (high : Nat)
    (endpoint : (getCurrentEpoch y.state).toNat ≤ high + 1)
    (guard : aprioriGuardAt config x high) (maxAligned : MaxEffectiveBalancesAligned preset)
    (unit : preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤ stakeCeilingAt config x high 0)
    (others : ∀ {u : ForkedBeaconState preset} (head : Run config checks x u),
      u.fork < .glamsterdam → (getCurrentEpoch u.state).toNat ≤ high + 1 → ∀ found,
        head.balanceEvents high = .ok found → (found.map otherCredit).sum ≤
          whistleblowerAllowance preset config (referenceCount x) (scheduledActivationCount x)
            (unassignedPreStake x) (fundingCarry x) (exitedSlashableCount x)
            (driftHorizon x high) (preElectraEpochs config x high))
    (floor : ∀ {u : ForkedBeaconState preset}, Run config checks x u → u.fork < .glamsterdam →
      (getCurrentEpoch u.state).toNat < (getCurrentEpoch y.state).toNat → ∀ total,
        getTotalActiveBalance u.state = .ok total →
        stakeFloorAt config x high
          ((getCurrentEpoch u.state).toNat - (getCurrentEpoch x.state).toNat) ≤ total.toNat)
    {u v : ForkedBeaconState preset} (step : Step config checks u v) (member : tail.Contains step)
    {total : Gwei} (read : getTotalActiveBalance u.state = .ok total) :
    total.toNat ≤ stakeCeilingAt config x high
      ((getCurrentEpoch u.state).toNat - (getCurrentEpoch x.state).toNat) := by
  obtain ⟨pre, _, _, uEarly, epochOrder⟩ := Run.contains_step_facts member early
  have stake := (activeStake_le_ceiling shared genesis pre electra uEarly high
    (epochOrder.trans endpoint) guard maxAligned unit others
    (fun path pathEarly earlier total read =>
      floor path pathEarly (earlier.trans_le epochOrder) total read)).1
  have value := (getTotalBalance_ok_iff_stake.mp (getTotalActiveBalance_ok read)).2.2
  rw [value]
  exact max_le (unit.trans (ceilingAt_mono electra high (Nat.zero_le _))) stake

private theorem run_joint_departures_budget_of_ceiling {g x y : ForkedBeaconState preset}
    (shared : Run config checks g x) (genesis : Genesis (config := config) (checks := checks) g)
    (tail : Run config checks x y) (electra : .pectra ≤ x.fork)
    (early : y.fork < .glamsterdam) (high : Nat)
    (endpoint : (getCurrentEpoch y.state).toNat ≤ high + 1)
    (guard : aprioriGuardAt config x high) (maxAligned : MaxEffectiveBalancesAligned preset)
    (unit : preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤ stakeCeilingAt config x high 0)
    (others : ∀ {u : ForkedBeaconState preset} (head : Run config checks x u),
      u.fork < .glamsterdam → (getCurrentEpoch u.state).toNat ≤ high + 1 → ∀ found,
        head.balanceEvents high = .ok found → (found.map otherCredit).sum ≤
          whistleblowerAllowance preset config (referenceCount x) (scheduledActivationCount x)
            (unassignedPreStake x) (fundingCarry x) (exitedSlashableCount x)
            (driftHorizon x high) (preElectraEpochs config x high))
    (floor : ∀ {u : ForkedBeaconState preset}, Run config checks x u → u.fork < .glamsterdam →
      (getCurrentEpoch u.state).toNat < (getCurrentEpoch y.state).toNat → ∀ total,
        getTotalActiveBalance u.state = .ok total →
        stakeFloorAt config x high
          ((getCurrentEpoch u.state).toNat - (getCurrentEpoch x.state).toNat) ≤ total.toNat)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events) :
    ((tail.departureCharges.filter fun charge => charge.epoch ≤ high + 1).map (·.amount)).sum +
      (events.map fun e => ∑ i ∈ Finset.range e.before.state.validators.data.size,
        floorPartialDebit (UInt64.ofNat i) e).sum ≤ departureBudgetAt (config := config) x high +
          duePartialWithdrawals x (driftHorizon x high) := by
  exact run_joint_departures_high_budget x high electra tail early replayed endpoint
    (fun step member _ read => stepTotal_le_ceiling shared genesis tail electra early high endpoint
      guard maxAligned unit others floor step member read)
private theorem stopped_charges_le_run {x y : ForkedBeaconState preset}
    (tail : Run config checks x y) (stops : (i : Nat) → Stop tail i)
    (carrier : Finset Nat) (charge : Nat → Nat) (cutoff : Nat)
    (selected : ∀ i ∈ carrier, ∃ c, (stops i).charge = some c ∧
      charge i = c.amount ∧ c.epoch ≤ cutoff) :
    (∑ i ∈ carrier, charge i) ≤
      ((tail.departureCharges.filter fun c => c.epoch ≤ cutoff).map (·.amount)).sum := by
  by_cases empty : carrier = ∅
  · simp [empty]
  obtain ⟨seed, seedMember⟩ := Finset.nonempty_iff_ne_empty.mpr empty
  have position (i : Nat) (member : i ∈ carrier) :
      ∃ j : Fin tail.departureCharges.length,
        tail.departureCharges[j].index = i ∧
        tail.departureCharges[j].amount = charge i ∧
        tail.departureCharges[j].epoch ≤ cutoff := by
    obtain ⟨c, chosen, amount, before⟩ := selected i member
    have actual := (stops i).selected
    rw [chosen] at actual
    obtain ⟨j, inside, atIndex⟩ := List.getElem_of_mem actual.1
    refine ⟨⟨j, inside⟩, ?_⟩
    change tail.departureCharges[j].index = i ∧
      tail.departureCharges[j].amount = charge i ∧ tail.departureCharges[j].epoch ≤ cutoff
    rw [atIndex]
    exact ⟨actual.2.1, amount.symm, before⟩
  choose pick paired using position
  let injection (i : Nat) : Fin tail.departureCharges.length :=
    if member : i ∈ carrier then pick i member else pick seed seedMember
  have bound := Finset.sum_le_sum_of_injOn
    (s := carrier) (t := Finset.univ) injection
    (f := charge)
    (g := fun j : Fin tail.departureCharges.length =>
      if tail.departureCharges[j].epoch ≤ cutoff then tail.departureCharges[j].amount else 0)
    (by
      intro i hi j hj same
      have left := (paired i hi).1
      have right := (paired j hj).1
      have hi' : i ∈ carrier := hi
      have hj' : j ∈ carrier := hj
      simp only [injection, dite_eq_left hi', dite_eq_left hj'] at same
      rw [same] at left
      exact left.symm.trans right)
    (by simp)
    (by
      intro i member
      simp only [injection, dite_eq_left member, (paired i member).2.2, ↓reduceIte,
        (paired i member).2.1]
      exact Nat.le_refl _)
    (fun _ _ _ => Nat.zero_le _)
  have sums : (∑ j : Fin tail.departureCharges.length,
      if tail.departureCharges[j].epoch ≤ cutoff then tail.departureCharges[j].amount else 0) =
      ((tail.departureCharges.filter fun c => c.epoch ≤ cutoff).map (·.amount)).sum := by
    rw [← List.sum_ofFn]
    change (List.ofFn (fun j : Fin tail.departureCharges.length =>
      if tail.departureCharges[j.val].epoch ≤ cutoff then
        tail.departureCharges[j.val].amount else 0)).sum = _
    rw [List.ofFn_getElem_eq_map tail.departureCharges
      (fun c => if c.epoch ≤ cutoff then c.amount else 0)]
    simpa using List.sum_map_ite (fun c : DepartureCharge => c.epoch ≤ cutoff)
      (·.amount) (fun _ => 0) tail.departureCharges
  exact bound.trans_eq sums
private theorem Stop.charge_endpoint {x y : ForkedBeaconState preset}
    {tail : Run config checks x y} {i : Nat} (stop : Stop tail i)
    {c : DepartureCharge} (selected : stop.charge = some c) :
    ∃ w, y.state.validators.data[i]? = some w ∧ w.exitEpoch.toNat = c.epoch := by
  have actual := stop.selected
  rw [selected] at actual
  obtain ⟨next, step, rest, _, _, v, w, _, found, _, assigned, epoch⟩ := actual.2.2.2
  obtain ⟨last, lastFound, kept⟩ := rest.registryLifecycle.validators i w found
  exact ⟨last, lastFound, by rw [kept.exitEpoch assigned]; exact epoch⟩
private theorem Stop.charge_cutoff {x y : ForkedBeaconState preset}
    {tail : Run config checks x y} {i : Nat} (stop : Stop tail i)
    {c : DepartureCharge} (selected : stop.charge = some c) (cutoff : Nat)
    (endpoint : ∃ w, y.state.validators.data[i]? = some w ∧ w.exitEpoch.toNat ≤ cutoff) :
    c.epoch ≤ cutoff := by
  obtain ⟨w, found, epoch⟩ := stop.charge_endpoint selected
  obtain ⟨v, read, before⟩ := endpoint
  have same := Option.some.inj (found.symm.trans read)
  subst v
  omega
private theorem initial_active_exit_cutoff {x y : ForkedBeaconState preset}
    (tail : Run config checks x y) {i : Nat} {v w : Validator}
    (initial : x.state.validators.data[i]? = some v)
    (active : isActiveValidator v (getCurrentEpoch x.state) = true)
    (final : y.state.validators.data[i]? = some w)
    (inactive : isActiveValidator w (getCurrentEpoch y.state) = false) :
    w.exitEpoch.toNat ≤ (getCurrentEpoch y.state).toNat := by
  obtain ⟨later, found, kept⟩ := tail.registryLifecycle.validators i v initial
  have same := Option.some.inj (found.symm.trans final)
  subst later
  have chronological := currentEpoch_le_of_chainSteps tail.chainSteps
  simp only [isActiveValidator, Bool.and_eq_true, decide_eq_true_eq] at active
  have activationStart := UInt64.le_iff_toNat_le.mp active.1
  have exitStart := UInt64.lt_iff_toNat_lt.mp active.2
  have assigned : v.activationEpoch ≠ FAR_FUTURE_EPOCH := by
    intro far
    have bound := activationStart.trans_lt exitStart
    rw [far] at bound
    have largest : v.exitEpoch.toNat ≤ FAR_FUTURE_EPOCH.toNat :=
      Nat.le_sub_one_of_lt v.exitEpoch.toNat_lt
    omega
  have activation : w.activationEpoch ≤ getCurrentEpoch y.state := by
    rw [kept.activationEpoch assigned]
    exact UInt64.le_iff_toNat_le.mpr
      (activationStart.trans (UInt64.le_iff_toNat_le.mp chronological))
  simp only [isActiveValidator, Bool.and_eq_false_iff, decide_eq_false_iff_not] at inactive
  rcases inactive with before | after
  · exact False.elim (before activation)
  · exact UInt64.le_iff_toNat_le.mp (UInt64.not_lt.mp after)
private theorem Stop.inactive_charge_cutoff {x y : ForkedBeaconState preset}
    {tail : Run config checks x y} {i : Nat} (stop : Stop tail i)
    {c : DepartureCharge} (selected : stop.charge = some c)
    (initial : ∃ v, x.state.validators.data[i]? = some v ∧
      isActiveValidator v (getCurrentEpoch x.state) = true)
    (inactive : (y.state.validators.data[i]?).any
      (fun w => isActiveValidator w (getCurrentEpoch y.state)) = false) :
    c.epoch ≤ (getCurrentEpoch y.state).toNat := by
  obtain ⟨v, before, active⟩ := initial
  obtain ⟨w, found, _⟩ := stop.charge_endpoint selected
  have noActive : isActiveValidator w (getCurrentEpoch y.state) = false := by
    simpa only [found, Option.any_some] using inactive
  exact stop.charge_cutoff selected _ ⟨w, found,
    initial_active_exit_cutoff tail before active found noActive⟩
private theorem stopped_partial_occurrences {g x y : ForkedBeaconState preset}
    (shared : Run config checks g x) (genesis : Genesis config checks g)
    (tail : Run config checks x y) (early : y.fork < .glamsterdam)
    (endEpoch : (getCurrentEpoch y.state).toNat ≤ high + 1)
    (replayed : tail.balanceEvents high = .ok events)
    (carrier : Finset Nat) (parts : Nat → List (BalanceEvent preset))
    (indices : ∀ i ∈ carrier, i < x.state.validators.data.size)
    (prefixes : ∀ i ∈ carrier, parts i <+: events) :
    (∑ i ∈ carrier, ((parts i).map (floorPartialDebit (UInt64.ofNat i))).sum) ≤
      (events.map fun e => ∑ i ∈ Finset.range e.before.state.validators.data.size,
        floorPartialDebit (UInt64.ofNat i) e).sum := by
  have prefixBound := prefix_resource_sum_le carrier parts events
    (fun i => floorPartialDebit (UInt64.ofNat i)) prefixes
  have subset (e : BalanceEvent preset) (member : e ∈ events) :
      carrier ⊆ Finset.range e.before.state.validators.data.size := by
    have life := (replay_event_provenance shared tail genesis early high endEpoch
      events replayed e member).1
    intro i inside
    exact Finset.mem_range.mpr ((indices i inside).trans_le life.size_le)
  have bound : (events.map fun e => ∑ i ∈ carrier,
      floorPartialDebit (UInt64.ofNat i) e).sum ≤
      (events.map fun e => ∑ i ∈ Finset.range e.before.state.validators.data.size,
        floorPartialDebit (UInt64.ofNat i) e).sum := by
    clear prefixes prefixBound replayed
    induction events with
    | nil => simp
    | cons e events ih =>
      simp only [List.map_cons, List.sum_cons]
      exact Nat.add_le_add (Finset.sum_le_sum_of_subset (subset e (by simp)))
        (ih (fun e member => subset e (by simp [member])))
  exact prefixBound.trans bound
private theorem stopped_joint_budget_of_ceiling {g x y : ForkedBeaconState preset}
    (shared : Run config checks g x) (genesis : Genesis (config := config) (checks := checks) g)
    (tail : Run config checks x y) (electra : .pectra ≤ x.fork)
    (early : y.fork < .glamsterdam) (high : Nat)
    (endpoint : (getCurrentEpoch y.state).toNat ≤ high + 1)
    (guard : aprioriGuardAt config x high) (maxAligned : MaxEffectiveBalancesAligned preset)
    (unit : preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤ stakeCeilingAt config x high 0)
    (others : ∀ {u : ForkedBeaconState preset} (head : Run config checks x u),
      u.fork < .glamsterdam → (getCurrentEpoch u.state).toNat ≤ high + 1 → ∀ found,
        head.balanceEvents high = .ok found → (found.map otherCredit).sum ≤
          whistleblowerAllowance preset config (referenceCount x) (scheduledActivationCount x)
            (unassignedPreStake x) (fundingCarry x) (exitedSlashableCount x)
            (driftHorizon x high) (preElectraEpochs config x high))
    (floor : ∀ {u : ForkedBeaconState preset}, Run config checks x u → u.fork < .glamsterdam →
      (getCurrentEpoch u.state).toNat < (getCurrentEpoch y.state).toNat → ∀ total,
        getTotalActiveBalance u.state = .ok total →
        stakeFloorAt config x high
          ((getCurrentEpoch u.state).toNat - (getCurrentEpoch x.state).toNat) ≤ total.toNat)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    (stops : (i : Nat) → Stop tail i) (carrier : Finset Nat) (charge : Nat → Nat)
    (selected : ∀ i ∈ carrier, ∃ c, (stops i).charge = some c ∧
      charge i = c.amount ∧ c.epoch ≤ high + 1)
    (partialTotal : Nat)
    (partialBudget : partialTotal ≤ (events.map fun e =>
      ∑ i ∈ Finset.range e.before.state.validators.data.size,
        floorPartialDebit (UInt64.ofNat i) e).sum) :
    (∑ i ∈ carrier, charge i) + partialTotal ≤ departureBudgetAt (config := config) x high +
        duePartialWithdrawals x (driftHorizon x high) := by
  have selectedBound := stopped_charges_le_run tail stops carrier charge (high + 1) selected
  have joint := run_joint_departures_budget_of_ceiling shared genesis tail electra early high
    endpoint guard maxAligned unit others floor replayed
  omega
private theorem Stop.charge_of_new_exit {x y : ForkedBeaconState preset}
    {tail : Run config checks x y} {i : Nat} (stop : Stop tail i)
    {v w : Validator} (initial : x.state.validators.data[i]? = some v)
    (final : y.state.validators.data[i]? = some w)
    (unset : v.exitEpoch = FAR_FUTURE_EPOCH) (assigned : w.exitEpoch ≠ FAR_FUTURE_EPOCH) :
    ∃ c, stop.charge = some c ∧ c.amount = effectiveAt stop.state i := by
  obtain ⟨actual, member, index, _⟩ :=
    tail.departure_charge_of_assigned i v w initial final unset assigned
  cases chosen : stop.charge with
  | none =>
    have absent := stop.selected
    rw [chosen] at absent
    exact False.elim (absent.2 actual member index)
  | some c =>
    have selected := stop.selected
    rw [chosen] at selected
    exact ⟨c, rfl, selected.2.2.1⟩
private theorem initial_active_carrier_card_le
    {x : ForkedBeaconState preset} (carrier : Finset Nat)
    (unique : PubkeysDistinct x.state) (early : x.fork < .glamsterdam)
    (active : ∀ i ∈ carrier, ∃ v, x.state.validators.data[i]? = some v ∧
      isActiveValidator v (getCurrentEpoch x.state) = true) :
    carrier.card ≤ referenceCount x := by
  let key : Nat → BLSPubkey := fun i =>
    (x.state.validators.data[i]?.map (·.pubkey)).getD default
  apply Finset.card_le_card_of_injOn key
  · intro i member
    obtain ⟨v, found, enabled⟩ := active i member
    apply (mem_keysAt_epoch early _ _).mpr
    exact ⟨i, v, found, by simp [key, found], enabled⟩
  · intro i hi j hj same
    obtain ⟨v, found, _⟩ := active i hi
    obtain ⟨w, read, _⟩ := active j hj
    exact unique.index_eq found read (by simpa [key, found, read] using same)
private theorem carrier_resource_count_le (carrier : Finset Nat) (a p : Nat → Nat)
    (band budgetA budgetP : Nat) (positive : 0 < band)
    (gap : ∀ i ∈ carrier, band < a i + p i)
    (aBound : (∑ i ∈ carrier, a i) ≤ budgetA)
    (pBound : (∑ i ∈ carrier, p i) ≤ budgetP) :
    carrier.card ≤ (budgetA + budgetP) / band := by
  apply (Nat.le_div_iff_mul_le positive).mpr
  calc
    carrier.card * band = ∑ _i ∈ carrier, band := by simp
    _ ≤ ∑ i ∈ carrier, (a i + p i) :=
      Finset.sum_le_sum fun i member => Nat.le_of_lt (gap i member)
    _ = (∑ i ∈ carrier, a i) + ∑ i ∈ carrier, p i := Finset.sum_add_distrib
    _ ≤ budgetA + budgetP := Nat.add_le_add aBound pBound
private theorem ReservedReplay.selected_source_round_bound
    {tagged : List (TaggedEntry × Payment preset)}
    {tail : Run config checks x y}
    (ledger : RoundLedger (config := config) (checks := checks) tail high)
    (history : ReservedReplay (config := config) (checks := checks) x high
      (fun i => if i ∈ ledger.sourceFalling then preset.EFFECTIVE_BALANCE_INCREMENT.toNat else 0)
      start startEpoch finish finishEpoch eventPosition paymentPosition callPosition
      events queue final tagged allocations calls before after)
    (select : (TaggedEntry × Payment preset) × OwnedRelease → Bool) :
    tagged.length = allocations.length ∧
      (((tagged.zip allocations).filter select).map fun pair => pair.2.sourceRound).sum ≤
        roundingBudget (config := config) x high := by
  have bound := history.selected_round_sum_le ledger.sourceFalling
    preset.EFFECTIVE_BALANCE_INCREMENT.toNat select
  exact ⟨bound.1, bound.2.trans ledger.sourceRoundBound⟩
private theorem ReservedReplay.fresh_source_round_bound
    {tagged : List (TaggedEntry × Payment preset)}
    {tail : Run config checks x y}
    (ledger : RoundLedger (config := config) (checks := checks) tail high)
    (history : ReservedReplay (config := config) (checks := checks) x high
      (fun i => if i ∈ ledger.sourceFalling then preset.EFFECTIVE_BALANCE_INCREMENT.toNat else 0)
      x (getCurrentEpoch x.state) y (getCurrentEpoch y.state) 0 0 0
      events queue final tagged allocations calls before after)
    (freshAllocations : List OwnedRelease)
    (projection : freshAllocations = ((tagged.zip allocations).filter fun pair =>
      match pair.1.1.tag with | .fresh _ => true | .initial _ => false).map Prod.snd) :
    (freshAllocations.map (·.sourceRound)).sum ≤ roundingBudget (config := config) x high := by
  rw [projection, List.map_map]
  exact (history.selected_source_round_bound ledger
    (fun pair => match pair.1.1.tag with | .fresh _ => true | .initial _ => false)).2
private theorem ReservedReplay.fresh_baseline_sum_le
    {tagged : List (TaggedEntry × Payment preset)}
    (history : ReservedReplay (config := config) (checks := checks) x high rounding
      start startEpoch finish finishEpoch eventPosition paymentPosition callPosition
      events queue final tagged allocations calls before after) :
    let fresh := (tagged.zip allocations).filter fun pair =>
      match pair.1.1.tag with | .fresh _ => true | .initial _ => false
    (fresh.map fun pair => pair.2.baseline).sum ≤
      (fresh.map fun pair => pair.1.1.amount).sum +
        (fresh.map fun pair => pair.2.sourceRound).sum := by
  dsimp only
  rw [← List.sum_map_add]
  apply List.sum_le_sum
  intro pair member
  have paired := List.forall₂_zip history.paired_baselines (List.mem_filter.mp member).1
  have selected := (List.mem_filter.mp member).2
  cases tagEq : pair.1.1.tag <;> simp_all
def base (x : ForkedBeaconState preset) (i : Nat) :=
  if x.fork < .pectra then min (max (effectiveAt x i) (actualBalanceAt x i))
    preset.MAX_EFFECTIVE_BALANCE.toNat else max (effectiveAt x i) (actualBalanceAt x i)
structure ScheduledAllocation (x y : ForkedBeaconState preset) (high : Nat) where
  scheduled : Finset Nat
  exactScheduled : scheduled = (Finset.range x.state.validators.data.size).filter fun i =>
    (x.state.validators.data[i]?).any (fun v =>
      isActiveValidator v (getCurrentEpoch x.state) && !v.slashed &&
        decide (v.exitEpoch ≠ FAR_FUTURE_EPOCH ∧ v.exitEpoch.toNat ≤ horizonEnd x high))
  loss : Nat → Nat
  growth : Nat → Nat
  commonReserve : Nat → Nat
  exactLoss : ∀ i ∈ scheduled, ∀ v, y.state.validators.data[i]? = some v →
    loss i = if v.slashed then 0 else effectiveAt x i -
      (if v.pubkey ∈ recentKeys y.state then effectiveAt y i else 0)
  exactGrowth : ∀ i ∈ scheduled, ∀ v, y.state.validators.data[i]? = some v →
    growth i = if v.pubkey ∈ recentKeys y.state \ activeKeys y.state then
      min (effectiveAt y i - effectiveAt x i) (effectiveAt x i) else 0
  exactCommon : ∀ i ∈ scheduled, ∀ v initial,
    x.state.validators.data[i]? = some initial → y.state.validators.data[i]? = some v →
    commonReserve i = if v.slashed ∧ initial.pubkey ∉ recentKeys y.state then effectiveAt x i else 0
  endpointReads : ∀ i ∈ scheduled, ∃ initial v,
    x.state.validators.data[i]? = some initial ∧ y.state.validators.data[i]? = some v ∧
    initial.pubkey = v.pubkey ∧ (v.pubkey ∈ recentKeys y.state → v.slashed = false)
  total : (∑ i ∈ scheduled, effectiveAt x i) ≤ scheduledExitStake x (driftHorizon x high)
private theorem ScheduledAllocation.per_key
    (allocation : ScheduledAllocation x y high) (member : i ∈ allocation.scheduled) :
    allocation.loss i + allocation.growth i + allocation.commonReserve i ≤ effectiveAt x i := by
  obtain ⟨initial, v, foundInitial, found, key, unslashed⟩ := allocation.endpointReads i member
  rw [allocation.exactLoss i member v found, allocation.exactGrowth i member v found,
    allocation.exactCommon i member v initial foundInitial found, key]
  by_cases recent : v.pubkey ∈ recentKeys y.state
  · have clean := unslashed recent
    by_cases active : v.pubkey ∈ activeKeys y.state
    · simp [recent, active, clean]
    · simp [recent, active, clean]
      omega
  · simp only [recent, Finset.mem_sdiff, false_and, ↓reduceIte, not_false_eq_true, and_true]
    cases v.slashed <;> simp
private theorem ScheduledAllocation.reservation_bound
    (allocation : ScheduledAllocation x y high) :
    (∑ i ∈ allocation.scheduled, allocation.loss i) +
      (∑ i ∈ allocation.scheduled, allocation.growth i) +
      (∑ i ∈ allocation.scheduled, allocation.commonReserve i) ≤
          scheduledExitStake x (driftHorizon x high) := by
  have bound := Finset.sum_le_sum (fun i member => allocation.per_key member)
  simpa only [Finset.sum_add_distrib] using bound.trans allocation.total
structure NewCohortCuts {x y : ForkedBeaconState preset}
    (tail : Run config checks x y) (high : Nat) (ledger : LedgerCuts tail) where
  cohort : Finset Nat
  supported : Finset Nat
  boundary : Finset Nat
  departed : Finset Nat
  exactUniverse : cohort = (Finset.range x.state.validators.data.size).filter fun i =>
    (x.state.validators.data[i]?).any (fun v => isActiveValidator v (getCurrentEpoch x.state) &&
      !v.slashed && decide (v.exitEpoch = FAR_FUTURE_EPOCH ∨ horizonEnd x high < v.exitEpoch.toNat))
        ∧
      (y.state.validators.data[i]?).any (fun v => !v.slashed)
  exactSupported : supported = cohort.filter fun i =>
    (y.state.validators.data[i]?).any (fun v => v.pubkey ∈ recentKeys y.state)
  exactBoundary : boundary = cohort.filter fun i =>
    (y.state.validators.data[i]?).any (fun v =>
      v.pubkey ∈ recentKeys y.state \ activeKeys y.state)
  exactDeparted : departed = cohort \ supported
  outsideWindowRetained : ∀ i ∈ cohort, ∀ initial,
    x.state.validators.data[i]? = some initial → initial.exitEpoch ≠ FAR_FUTURE_EPOCH →
      i ∈ supported ∧ i ∉ boundary
  charge : Nat → Nat
  actualCharge : ∀ i ∈ boundary ∪ departed, ∃ c,
    (ledger.stops i).charge = some c ∧ charge i = c.amount
structure NewCohortAllocation {x y : ForkedBeaconState preset}
    (tail : Run config checks x y) (high : Nat) (ledger : RoundLedger tail high)
    (owned : Ownership) (tokens : BLSPubkey → Finset TokenOrigin)
    extends NewCohortCuts tail high ledger.toLedgerCuts where
  debit : Nat → Nat
  slack : Nat → Nat
  penalty : Nat → Nat
  partialDebit : Nat → Nat
  exactDebit : ∀ i ∈ cohort, debit i = slack i + penalty i + partialDebit i +
    (if i ∈ ledger.falling then preset.EFFECTIVE_BALANCE_INCREMENT.toNat else 0)
  slackBudget : (∑ i ∈ cohort, slack i) ≤ startSlack x
  penaltyBudget : (∑ i ∈ cohort, penalty i) ≤
    windowPenalties (config := config) x high (driftHorizon x high + 1)
  stopped : ∀ i ∈ boundary ∪ departed,
    effectiveAt x i ≤ charge i + debit i
  retained : ∀ i ∈ cohort, i ∈ supported → i ∉ boundary →
    effectiveAt x i ≤ effectiveAt y i + debit i
  selected : ∀ i ∈ boundary, ∃ v, y.state.validators.data[i]? = some v ∧
    tokens v.pubkey ⊆ held owned i ∩ owned.endpoint ∧
      (tokens v.pubkey).card = effectiveAt y i - effectiveAt x i
  partialTotal : Nat
  partialBudget : (∑ i ∈ cohort, partialDebit i) ≤ partialTotal
  queueBudget : (∑ i ∈ boundary ∪ departed, charge i) + partialTotal ≤
    departureBudgetAt (config := config) x high + duePartialWithdrawals x (driftHorizon x high)
  debitBudget : (∑ i ∈ cohort, debit i) ≤ partialTotal + startSlack x +
    windowPenalties (config := config) x high (driftHorizon x high + 1) +
        roundingBudget (config := config) x high
private theorem NewCohortCuts.exists {x y : ForkedBeaconState preset}
    (tail : Run config checks x y) (ledger : LedgerCuts tail) (high : Nat)
    (unique : PubkeysDistinct y.state) (early : y.fork < .glamsterdam)
    (twoSlots : 2 ≤ preset.SLOTS_PER_EPOCH.toNat)
    (endpoint : (getCurrentEpoch y.state).toNat ≤ high + 1) :
    Nonempty (NewCohortCuts tail high ledger) := by
  let cohort := (Finset.range x.state.validators.data.size).filter fun i =>
    (x.state.validators.data[i]?).any (fun v => isActiveValidator v (getCurrentEpoch x.state) &&
      !v.slashed && decide (v.exitEpoch = FAR_FUTURE_EPOCH ∨ horizonEnd x high < v.exitEpoch.toNat))
        ∧
      (y.state.validators.data[i]?).any (fun v => !v.slashed)
  let supported := cohort.filter fun i =>
    (y.state.validators.data[i]?).any (fun v => v.pubkey ∈ recentKeys y.state)
  let boundary := cohort.filter fun i =>
    (y.state.validators.data[i]?).any (fun v =>
      v.pubkey ∈ recentKeys y.state \ activeKeys y.state)
  let departed := cohort \ supported
  have reads (i : Nat) (member : i ∈ cohort) : ∃ v w,
      x.state.validators.data[i]? = some v ∧ y.state.validators.data[i]? = some w ∧
      isActiveValidator v (getCurrentEpoch x.state) = true ∧ w.slashed = false ∧
      (v.exitEpoch = FAR_FUTURE_EPOCH ∨ horizonEnd x high < v.exitEpoch.toNat) := by
    have selected := Finset.mem_filter.mp member
    have index := Finset.mem_range.mp selected.1
    let v := x.state.validators.data[i]
    have before : x.state.validators.data[i]? = some v := by simp [v, index]
    obtain ⟨w, after, _⟩ := tail.registryLifecycle.validators i v before
    have first := selected.2.1
    simp only [before, Option.any_some, Bool.and_eq_true, decide_eq_true_eq] at first
    exact ⟨v, w, before, after, first.1.1, by simpa [after] using selected.2.2, first.2⟩
  have keyRecent (i : Nat) (w : Validator) (after : y.state.validators.data[i]? = some w)
      (clean : w.slashed = false) (active : isActiveValidator w (getCurrentEpoch y.state) = true) :
      w.pubkey ∈ recentKeys y.state := by
    unfold recentKeys
    exact Finset.mem_filter.mpr ⟨Finset.mem_union_left _
      ((intervalGain_active_key y.state early unique i w after).mpr active),
      not_slashedAt unique (by simpa using Array.mem_of_getElem? after) clean⟩
  have retained (i : Nat) (member : i ∈ cohort) (v : Validator)
      (before : x.state.validators.data[i]? = some v) (assigned : v.exitEpoch ≠ FAR_FUTURE_EPOCH) :
      i ∈ supported ∧ i ∉ boundary := by
    obtain ⟨initial, w, first, after, active, clean, window⟩ := reads i member
    have same := Option.some.inj (first.symm.trans before)
    subst initial
    have outside : horizonEnd x high < v.exitEpoch.toNat := window.resolve_left assigned
    obtain ⟨last, lastFound, life⟩ := tail.registryLifecycle.validators i v before
    have same := Option.some.inj (lastFound.symm.trans after)
    subst last
    have finalActive : isActiveValidator w (getCurrentEpoch y.state) = true := by
      cases activeEnd : isActiveValidator w (getCurrentEpoch y.state) with
      | true => rfl
      | false =>
        have cutoff := initial_active_exit_cutoff tail before active after activeEnd
        rw [life.exitEpoch assigned] at cutoff
        have horizon : high + 1 ≤ horizonEnd x high := by unfold horizonEnd driftHorizon; omega
        omega
    have inActive := (intervalGain_active_key y.state early unique i w after).mpr finalActive
    constructor
    · simp only [supported, Finset.mem_filter, after, Option.any_some, decide_eq_true_eq]
      exact ⟨member, keyRecent i w after clean finalActive⟩
    · simp only [boundary, Finset.mem_filter, after, Option.any_some,
        decide_eq_true_eq, Finset.mem_sdiff]
      tauto
  have charged (i : Nat) (member : i ∈ boundary ∪ departed) :
      ∃ c, (ledger.stops i).charge = some c ∧ c.amount = effectiveAt (ledger.stops i).state i := by
    have inCohort : i ∈ cohort := by
      rcases Finset.mem_union.mp member with h | h
      · exact (Finset.mem_filter.mp h).1
      · exact (Finset.mem_sdiff.mp h).1
    obtain ⟨v, w, before, after, active, clean, _⟩ := reads i inCohort
    have unset : v.exitEpoch = FAR_FUTURE_EPOCH := by
      by_contra assigned
      have kept := retained i inCohort v before assigned
      rcases Finset.mem_union.mp member with h | h
      · exact kept.2 h
      · exact (Finset.mem_sdiff.mp h).2 kept.1
    have inactive : isActiveValidator w (getCurrentEpoch y.state) = false := by
      apply Bool.eq_false_iff.mpr
      intro enabled
      rcases Finset.mem_union.mp member with h | h
      · have selected := (Finset.mem_filter.mp h).2
        simp only [after, Option.any_some, decide_eq_true_eq, Finset.mem_sdiff] at selected
        exact selected.2 ((intervalGain_active_key y.state early unique i w after).mpr enabled)
      · apply (Finset.mem_sdiff.mp h).2
        exact Finset.mem_filter.mpr ⟨inCohort, by
          simpa only [after, Option.any_some, decide_eq_true_eq] using
            keyRecent i w after clean enabled⟩
    have assigned : w.exitEpoch ≠ FAR_FUTURE_EPOCH := by
      intro far
      have cutoff := initial_active_exit_cutoff tail before active after inactive
      rw [far] at cutoff
      have epochBound : (getCurrentEpoch y.state).toNat < FAR_FUTURE_EPOCH.toNat := by
        simp only [getCurrentEpoch, computeEpochAtSlot, UInt64.toNat_div]
        have slotBound := y.state.slot.toNat_lt
        have quotient : y.state.slot.toNat / preset.SLOTS_PER_EPOCH.toNat ≤
            y.state.slot.toNat / 2 := Nat.div_le_div_left twoSlots (by omega)
        change y.state.slot.toNat / preset.SLOTS_PER_EPOCH.toNat < 2 ^ 64 - 1
        omega
      omega
    exact (ledger.stops i).charge_of_new_exit before after unset assigned
  refine ⟨⟨cohort, supported, boundary, departed, rfl, rfl, rfl, rfl, retained,
    fun i => effectiveAt (ledger.stops i).state i, ?_⟩⟩
  intro i member
  obtain ⟨c, chosen, amount⟩ := charged i member
  exact ⟨c, chosen, amount.symm⟩
private theorem NewCohortCuts.charged_cohort
    {x y : ForkedBeaconState preset} {tail : Run config checks x y}
    {ledger : LedgerCuts tail}
    (allocation : NewCohortCuts tail high ledger)
    (unique : PubkeysDistinct y.state) (early : y.fork < .glamsterdam)
    {i : Nat} (member : i ∈ allocation.boundary ∪ allocation.departed) :
    i < x.state.validators.data.size ∧
      ∃ v w, x.state.validators.data[i]? = some v ∧
        y.state.validators.data[i]? = some w ∧
        isActiveValidator v (getCurrentEpoch x.state) = true ∧
        v.exitEpoch = FAR_FUTURE_EPOCH ∧ w.exitEpoch ≠ FAR_FUTURE_EPOCH ∧
        isActiveValidator w (getCurrentEpoch y.state) = false := by
  have cohort : i ∈ allocation.cohort := by
    rcases Finset.mem_union.mp member with boundary | departed
    · rw [allocation.exactBoundary] at boundary
      exact (Finset.mem_filter.mp boundary).1
    · rw [allocation.exactDeparted] at departed
      exact (Finset.mem_sdiff.mp departed).1
  have initial := cohort
  rw [allocation.exactUniverse, Finset.mem_filter] at initial
  have index := Finset.mem_range.mp initial.1
  let v := x.state.validators.data[i]
  have found : x.state.validators.data[i]? = some v :=
    Array.getElem?_eq_some_iff.mpr ⟨index, rfl⟩
  have first := initial.2.1
  simp only [found, Option.any_some, Bool.and_eq_true,
    decide_eq_true_eq] at first
  obtain ⟨w, final, life⟩ := tail.registryLifecycle.validators i v found
  have clean : w.slashed = false := by
    simpa [final] using initial.2.2
  have unset : v.exitEpoch = FAR_FUTURE_EPOCH := by
    by_contra assigned
    have retained := allocation.outsideWindowRetained i cohort v found assigned
    rcases Finset.mem_union.mp member with boundary | departed
    · exact retained.2 boundary
    · rw [allocation.exactDeparted] at departed
      exact (Finset.mem_sdiff.mp departed).2 retained.1
  have inactive : isActiveValidator w (getCurrentEpoch y.state) = false := by
    apply Bool.eq_false_iff.mpr
    intro active
    have keyActive := (intervalGain_active_key y.state early unique i w final).mpr active
    rcases Finset.mem_union.mp member with boundary | departed
    · rw [allocation.exactBoundary] at boundary
      have selected := (Finset.mem_filter.mp boundary).2
      simp only [final, Option.any_some, Finset.mem_sdiff, decide_eq_true_eq] at selected
      exact selected.2 keyActive
    · rw [allocation.exactDeparted] at departed
      apply (Finset.mem_sdiff.mp departed).2
      rw [allocation.exactSupported]
      apply Finset.mem_filter.mpr ⟨cohort, ?_⟩
      simp only [final, Option.any_some, decide_eq_true_eq]
      unfold recentKeys
      exact Finset.mem_filter.mpr ⟨Finset.mem_union_left _ keyActive,
        not_slashedAt unique (by simpa using Array.mem_of_getElem? final) clean⟩
  have assigned : w.exitEpoch ≠ FAR_FUTURE_EPOCH := by
    obtain ⟨c, chosen, _⟩ := allocation.actualCharge i member
    have actual := (ledger.stops i).selected
    rw [chosen] at actual
    obtain ⟨next, step, rest, _, _, before, after, _, located, _, assigned, _⟩ :=
      actual.2.2.2
    obtain ⟨last, lastFound, kept⟩ := rest.registryLifecycle.validators i after located
    have same := Option.some.inj (lastFound.symm.trans final)
    subst last
    rw [kept.exitEpoch assigned]
    exact assigned
  exact ⟨index, v, w, found, final, first.1.1, unset, assigned, inactive⟩
private theorem NewCohortCuts.stopped_inputs
    {x y : ForkedBeaconState preset} {tail : Run config checks x y}
    {ledger : LedgerCuts tail} (cohort : NewCohortCuts tail high ledger)
    (unique : PubkeysDistinct y.state) (early : y.fork < .glamsterdam)
    (endpoint : (getCurrentEpoch y.state).toNat ≤ high + 1)
    (member : i ∈ cohort.boundary ∪ cohort.departed) :
    (UInt64.ofNat i).toNat = i ∧
      ∃ c v w u, (ledger.stops i).charge = some c ∧ cohort.charge i = c.amount ∧
        x.state.validators.data[i]? = some v ∧ y.state.validators.data[i]? = some w ∧
        (ledger.stops i).state.state.validators.data[i]? = some u ∧
        v.slashed = false ∧ w.slashed = false ∧ u.slashed = false ∧
        v.activationEpoch ≠ FAR_FUTURE_EPOCH ∧
        (getCurrentEpoch (ledger.stops i).state.state).toNat ≤ high + 1 := by
  obtain ⟨inside, v, w, before, after, active, _, _, _⟩ :=
    cohort.charged_cohort unique early member
  have numeric := toNat_toUInt64_of_lt
    (x.state.validators.bound (Nat.lt_of_le_of_lt
      (fork_le_of_chainSteps tail.chainSteps) early)) inside
  have inCohort : i ∈ cohort.cohort := by
    rcases Finset.mem_union.mp member with boundary | departed
    · rw [cohort.exactBoundary] at boundary
      exact (Finset.mem_filter.mp boundary).1
    · rw [cohort.exactDeparted] at departed
      exact (Finset.mem_sdiff.mp departed).1
  rw [cohort.exactUniverse, Finset.mem_filter] at inCohort
  have clean : w.slashed = false := by simpa [after] using inCohort.2.2
  have unslashed : v.slashed = false := by
    have selected := inCohort.2.1
    simp only [before, Option.any_some, Bool.and_eq_true] at selected
    cases flag : v.slashed <;> simp_all
  have assigned : v.activationEpoch ≠ FAR_FUTURE_EPOCH := by
    simp only [isActiveValidator, Bool.and_eq_true, decide_eq_true_eq] at active
    intro far
    have lower := UInt64.le_iff_toNat_le.mp active.1
    have upper := UInt64.lt_iff_toNat_lt.mp active.2
    have largest := v.exitEpoch.toNat_lt
    rw [far] at lower
    change 2 ^ 64 - 1 ≤ _ at lower
    omega
  obtain ⟨c, chosen, amount⟩ := cohort.actualCharge i member
  obtain ⟨u, found, unmarked⟩ := (ledger.stops i).clean_read_of_endpoint v w before after clean
  exact ⟨numeric, c, v, w, u, chosen, amount, before, after, found, unslashed, clean,
    unmarked, assigned, (UInt64.le_iff_toNat_le.mp
      (currentEpoch_le_of_chainSteps (ledger.stops i).post.chainSteps)).trans endpoint⟩
private theorem slashing_quotient_of_electra
    (pre : Run config checks x m) (electra : .pectra ≤ x.fork) :
    minSlashingPenaltyQuotient preset (preElectraEpochs config x high) =
      (EthLib.Consensus.parameters preset m.fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat := by
  have later : .pectra ≤ m.fork := Nat.le_trans electra (fork_le_of_chainSteps pre.chainSteps)
  have notBefore : ¬ x.fork < .pectra := Nat.not_lt_of_ge electra
  simp only [preElectraEpochs, notBefore, ↓reduceIte, minSlashingPenaltyQuotient, Nat.lt_irrefl,
    EthLib.Consensus.parameters, later]
/-- Let a step start at Electra or end before it.

Then no balance event of the step is the Electra upgrade crossing. -/
private theorem no_crossing_of_regime
    (shared : Run config checks g x) (pre : Run config checks x m)
    (genesis : Genesis (config := config) (checks := checks) g) (caps : CapOrder preset)
    (step : Step config checks m n) (early : n.fork < .glamsterdam)
    (regime : .pectra ≤ m.fork ∨ n.fork < .pectra)
    (replayed : step.balanceEvents = .ok events) :
    ∀ e ∈ events, e.source ≠ .crossing := by
  have holds := (run_justified_separated (shared.append pre) genesis).1
  intro e member crossing
  have facts := step.balanceEvents_sites early holds caps.compounding replayed e member
  obtain ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, crossingWindow⟩ := facts
  have window := crossingWindow.2 crossing
  rcases regime with later | before
  · exact Nat.not_lt_of_ge later window.1
  · exact Nat.not_lt_of_ge window.2 before
/-- A guarded branch starts at Electra or ends before it. -/
private theorem regime_of_supported (shared : Run config checks g x)
    (tail : Run config checks x y) (supported : Supported shared tail high) :
    .pectra ≤ x.fork ∨ y.fork < .pectra :=
  (guarded_fork_regime (shared.append tail) supported.1 high supported.2.2.2.2.2.1
    supported.2.2.2.2.2.2).2
/-- A step inside a branch that starts at Electra or ends before it does the same. -/
private theorem step_regime (regime : .pectra ≤ x.fork ∨ y.fork < .pectra)
    (pre : Run config checks x m) (post : Run config checks n y) :
    .pectra ≤ m.fork ∨ n.fork < .pectra := by
  rcases regime with electra | before
  · exact .inl (Nat.le_trans electra (fork_le_of_chainSteps pre.chainSteps))
  · exact .inr (Nat.lt_of_le_of_lt (fork_le_of_chainSteps post.chainSteps) before)
/-- The guarded slashing quotient is at most the quotient of every state of the branch. -/
private theorem slashing_quotient_le_of_regime (reached : Run config checks g u)
    (genesis : Genesis (config := config) (checks := checks) g)
    (endEpoch : (getCurrentEpoch u.state).toNat ≤ high + 1)
    (guard : aprioriGuardAt config x high) (pre : Run config checks x m)
    (regime : .pectra ≤ x.fork ∨ m.fork < .pectra) :
    minSlashingPenaltyQuotient preset (preElectraEpochs config x high) ≤
      (EthLib.Consensus.parameters preset m.fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat := by
  by_cases electra : .pectra ≤ x.fork
  · exact (slashing_quotient_of_electra pre electra).le
  · have positive := (guarded_fork_regime reached genesis high endEpoch guard).1.mpr
      (Nat.lt_of_not_le electra)
    have mBefore : ¬ m.fork ≥ .pectra := Nat.not_le_of_gt (regime.resolve_left electra)
    simp only
        [minSlashingPenaltyQuotient, positive, ↓reduceIte, EthLib.Consensus.parameters, mBefore]
    split_ifs <;> omega
/-- A prefix of a branch that starts at Electra or ends before it does the same. -/
private theorem regime_prefix (regime : .pectra ≤ x.fork ∨ y.fork < .pectra)
    (post : Run config checks m y) : .pectra ≤ x.fork ∨ m.fork < .pectra :=
  regime.imp_right fun before => Nat.lt_of_le_of_lt (fork_le_of_chainSteps post.chainSteps) before
private theorem short_window_of_guard
    (guard : aprioriGuardAt config x high)
    (endpoint : (getCurrentEpoch y.state).toNat ≤ high + 1)
    (rest : Run config checks m y) :
    (getCurrentEpoch m.state).toNat < (getCurrentEpoch x.state).toNat +
      preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat -
        (preset.EPOCHS_PER_SLASHINGS_VECTOR / 2).toNat := by
  obtain ⟨_, _, _, _, _, _, _, _, _, _, short, _⟩ := guard
  have order := UInt64.le_iff_toNat_le.mp
    (currentEpoch_le_of_chainSteps rest.chainSteps)
  change high + 2 - (getCurrentEpoch x.state).toNat + 2 <
    preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat / 2 at short
  simp only [UInt64.toNat_div, UInt64.reduceToNat]
  omega
private theorem prefix_account_regime
    (shared : Run config checks g x) (pre : Run config checks x outer)
    (genesis : Genesis (config := config) (checks := checks) g) (caps : CapOrder preset)
    (guard : aprioriGuardAt config x high) (regime : .pectra ≤ x.fork ∨ outer.fork < .pectra)
    (early : outer.fork < .glamsterdam)
    (endpoint : (getCurrentEpoch outer.state).toNat ≤ high + 1)
    (localEndpoint : (getCurrentEpoch outer.state).toNat ≤ localHigh + 1)
    (i : ValidatorIndex) (v u : Validator)
    (initial : x.state.validators.data[i.toNat]? = some v)
    (final : outer.state.validators.data[i.toNat]? = some u)
    (unslashed : v.slashed = false) (clean : u.slashed = false)
    (activated : v.activationEpoch ≠ FAR_FUTURE_EPOCH)
    (retained : localHigh + 1 < u.exitEpoch.toNat)
    (replayed : pre.balanceEvents high = .ok events) :
    ∃ account, FloorTrace
        (min (effectiveAt x i.toNat) (actualBalanceAt x i.toNat)) 0
        (minSlashingPenaltyQuotient preset (preElectraEpochs config x high))
        ⟨actualBalanceAt x i.toNat, 0, effectiveAt x i.toNat, none⟩ account ∧
      account.balance = actualBalanceAt outer i.toNat ∧
      account.debt = (events.map (floorPenaltyDebit i.toNat)).sum +
        (events.map (floorPartialDebit i)).sum ∧
      effectiveAt outer i.toNat ≤ account.high ∧ account.slashedHigh = none ∧
      max (min (effectiveAt x i.toNat) (actualBalanceAt x i.toNat)) account.high ≤
        (withdrawalMaxEffectiveBalance preset outer.fork u).toNat := by
  have parameters := guard
  obtain ⟨_, _, _, _, _, _, _, positive, _, delay, _⟩ := parameters
  have localReplay : pre.balanceEvents localHigh = .ok events := by
    rw [← balanceEvents_eq_of_endpoint_le pre endpoint localEndpoint]
    exact replayed
  have guards : ∀ {m n : ForkedBeaconState preset} (head : Run config checks x m)
      (step : Step config checks m n) (post : Run config checks n outer),
      (head.snoc step).append post = pre → ∀ w,
      n.state.validators.data[i.toNat]? = some w →
      w.slashed = false ∧ localHigh + 1 < w.exitEpoch.toNat ∧
      (getCurrentEpoch m.state).toNat < (getCurrentEpoch x.state).toNat +
        preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat -
          (preset.EPOCHS_PER_SLASHINGS_VECTOR / 2).toNat ∧
      minSlashingPenaltyQuotient preset (preElectraEpochs config x high) ≤
        (EthLib.Consensus.parameters preset m.fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat ∧
      ∀ added, step.balanceEvents = .ok added → ∀ e ∈ added, e.source ≠ .crossing := by
    intro m n head step post _split w found
    have unmarked : w.slashed = false := by
      cases flag : w.slashed with
      | false => rfl
      | true =>
        obtain ⟨last, located, marked⟩ := post.slashedPersistence i.toNat w found flag
        have same := Option.some.inj (located.symm.trans final)
        subst last
        simp [clean] at marked
    refine ⟨unmarked, prefix_exit_gt_of_endpoint post w u found final retained,
      short_window_of_guard guard endpoint ((Run.nil.snoc step).append post),
      slashing_quotient_le_of_regime (shared.append pre) genesis endpoint guard head
        (regime_prefix regime ((Run.nil.snoc step).append post)), ?_⟩
    intro added addedOk
    exact no_crossing_of_regime shared head genesis caps step
      (Nat.lt_of_le_of_lt (fork_le_of_chainSteps post.chainSteps) early)
      (step_regime regime head post) addedOk
  obtain ⟨account, trace, balance, debt, covered, unmarked, cap, _path⟩ :=
    unslashed_floor_run shared pre genesis caps (by omega) early localHigh localEndpoint
      i v initial unslashed activated
      (min (effectiveAt x i.toNat) (actualBalanceAt x i.toNat)) 0
      (minSlashingPenaltyQuotient preset (preElectraEpochs config x high)) (Nat.min_le_left _ _)
          positive
      guards localReplay
  obtain ⟨last, located, capped⟩ := cap
  have same := Option.some.inj (located.symm.trans final)
  subst last
  exact ⟨account, trace, balance, debt, covered, unmarked, capped⟩
private theorem firstUpdate_of_guarded_slot_regime
    {g x outer after y : ForkedBeaconState preset} {tail : Run config checks x y}
    (shared : Run config checks g x) (pre : Run config checks x outer)
    (post : Run config checks after y)
    (ok : advanceSlotAcross config checks outer = .ok after)
    (split : (pre.snoc (.slot ok)).append post = tail)
    (genesis : Genesis (config := config) (checks := checks) g)
    (caps : CapOrder preset) (aligned : MaxEffectiveBalancesAligned preset)
    (guard : aprioriGuardAt config x high) (regime : .pectra ≤ x.fork ∨ after.fork < .pectra)
    (early : after.fork < .glamsterdam)
    (endpoint : (getCurrentEpoch after.state).toNat ≤ high + 1)
    (localEndpoint : (getCurrentEpoch after.state).toNat ≤ localHigh + 1)
    (i : ValidatorIndex) (v u w : Validator)
    (initial : x.state.validators.data[i.toNat]? = some v)
    (located : outer.state.validators.data[i.toNat]? = some u)
    (final : after.state.validators.data[i.toNat]? = some w)
    (unslashed : v.slashed = false) (clean : w.slashed = false)
    (activated : v.activationEpoch ≠ FAR_FUTURE_EPOCH)
    (retained : localHigh + 1 < w.exitEpoch.toNat)
    {advanced : BeaconState preset outer.fork}
    (advanceOk : advanceSlot config checks outer.state = .ok advanced)
    (decreases : effectiveAt ⟨outer.fork, advanced⟩ i.toNat < effectiveAt outer i.toNat)
    (ordered : ∀ j a b, pre.balancePath[j]? = some a →
      pre.balancePath[j + 1]? = some b → effectiveAt a i.toNat ≤ effectiveAt b i.toNat)
    {prefixEvents : List (BalanceEvent preset)}
    (prefixReplay : pre.balanceEvents high = .ok prefixEvents) :
    Nonempty (FirstUpdate tail high i.toNat) := by
  have edge : Run config checks outer after := Run.nil.snoc (.slot ok)
  have outerEpoch := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps edge.chainSteps)
  have outerEarly := Nat.lt_of_le_of_lt (Step.slot ok).chainStep.fork_le early
  have unmarked : u.slashed = false := by
    cases flag : u.slashed with
    | false => rfl
    | true =>
      obtain ⟨last, found, marked⟩ := edge.slashedPersistence i.toNat u located flag
      have same := Option.some.inj (found.symm.trans final)
      subst last
      simp [clean] at marked
  obtain ⟨account, trace, balance, debt, covered, unflagged, capped⟩ :=
    prefix_account_regime shared pre genesis caps guard
      (regime_prefix regime (Run.nil.snoc (.slot ok))) outerEarly
      (outerEpoch.trans endpoint) (outerEpoch.trans localEndpoint) i v u initial located
      unslashed unmarked activated
      (prefix_exit_gt_of_endpoint edge u w located final retained) prefixReplay
  have parameters := guard
  obtain ⟨_, _, _, _, _, _, _, _, _, delay, _⟩ := parameters
  obtain ⟨first⟩ := firstUpdate_of_slot_replay shared pre post ok split genesis caps aligned
    early (by omega) i v u w initial located final unslashed clean advanceOk decreases
    ordered prefixReplay (short_window_of_guard guard endpoint edge) localEndpoint retained
    (fun found replay => no_crossing_of_regime shared pre genesis caps (.slot ok) early
      (step_regime regime pre .nil) replay) trace balance unflagged debt capped covered
  exact ⟨first⟩
private theorem firstUpdate_of_firstDown_regime
    (shared : Run config checks g x) (tail : Run config checks x y)
    (supported : Supported shared tail high) (regime : .pectra ≤ x.fork ∨ y.fork < .pectra)
    (i : ValidatorIndex) (v w : Validator)
    (initial : x.state.validators.data[i.toNat]? = some v)
    (final : y.state.validators.data[i.toNat]? = some w)
    (unslashed : v.slashed = false) (clean : w.slashed = false)
    (activated : v.activationEpoch ≠ FAR_FUTURE_EPOCH)
    (localEndpoint : (getCurrentEpoch y.state).toNat ≤ localHigh + 1)
    (retained : localHigh + 1 < w.exitEpoch.toNat)
    (replayed : tail.balanceEvents high = .ok events)
    (drop : FirstDown tail i.toNat) : Nonempty (FirstUpdate tail high i.toNat) := by
  obtain ⟨genesis, _parameters, caps, aligned, early, endpoint, guard⟩ := supported
  obtain ⟨j, before, after, one, two, decreases, ordered⟩ := drop
  obtain ⟨m, n, pre, step, post, k, split, offset, left, right⟩ :=
    adjacent_decrease_step tail one two decreases
  obtain ⟨u, located, _life⟩ := pre.registryLifecycle.validators i.toNat v initial
  have nEarly := Nat.lt_of_le_of_lt (fork_le_of_chainSteps post.chainSteps) early
  obtain ⟨ok, same, advanced, advanceOk, _zero, atBefore, atAfter⟩ :=
    step_decrease_of_regime step (step_regime regime pre post) nEarly
      (Array.getElem?_eq_some_iff.mp located).1 left right decreases
  subst step
  have lower : effectiveAt ⟨m.fork, advanced⟩ i.toNat < effectiveAt m i.toNat := by
    simpa only [atBefore, atAfter] using decreases
  obtain ⟨nextValidator, found, _⟩ :=
    (Run.nil.snoc (.slot ok)).registryLifecycle.validators i.toNat u located
  have unmarked : nextValidator.slashed = false := by
    cases flag : nextValidator.slashed with
    | false => rfl
    | true =>
      obtain ⟨last, atEnd, marked⟩ := post.slashedPersistence i.toNat nextValidator found flag
      have equal := Option.some.inj (atEnd.symm.trans final)
      subst last
      simp [clean] at marked
  have epochOrder := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps post.chainSteps)
  have prefixOk : (pre.snoc (.slot ok)).append post = tail := split
  rw [← split] at replayed
  obtain ⟨prefixEvents, prefixReplay, _⟩ :=
    pre.balanceEvents_prefix ((Run.nil.snoc (.slot ok)).append post) high events
      (by simpa only [Run.append_assoc, Run.append] using replayed)
  exact firstUpdate_of_guarded_slot_regime shared pre post ok prefixOk genesis caps aligned guard
    (regime_prefix regime post)
    nEarly (epochOrder.trans endpoint) (epochOrder.trans localEndpoint) i v u nextValidator
    initial located found unslashed unmarked activated
    (prefix_exit_gt_of_endpoint post nextValidator w found final retained) advanceOk lower
    (noEarlier_of_localized_decrease tail pre (.slot ok) post split offset ordered) prefixReplay
private theorem Stop.firstUpdate_of_firstDown_regime
    {i : ValidatorIndex} {tail : Run config checks x y} (stop : Stop tail i.toNat)
    (chosen : stop.charge = some c)
    (shared : Run config checks g x) (supported : Supported shared tail high)
    (regime : .pectra ≤ x.fork ∨ y.fork < .pectra) (twoSlots : 2 ≤ preset.SLOTS_PER_EPOCH.toNat)
    (v u : Validator) (initial : x.state.validators.data[i.toNat]? = some v)
    (final : stop.state.state.validators.data[i.toNat]? = some u)
    (unslashed : v.slashed = false) (clean : u.slashed = false)
    (activated : v.activationEpoch ≠ FAR_FUTURE_EPOCH)
    (replayed : stop.pre.balanceEvents high = .ok events)
    (drop : FirstDown stop.pre i.toNat) : Nonempty (FirstUpdate stop.pre high i.toNat) := by
  obtain ⟨genesis, parameters, caps, aligned, early, endpoint, guard⟩ := supported
  have stopEpoch := (UInt64.le_iff_toNat_le.mp
    (currentEpoch_le_of_chainSteps stop.post.chainSteps)).trans endpoint
  have stopEarly := Nat.lt_of_le_of_lt (fork_le_of_chainSteps stop.post.chainSteps) early
  have localSupported : Supported shared stop.pre high :=
    ⟨genesis, parameters, caps, aligned, stopEarly, stopEpoch, guard⟩
  exact Internal.firstUpdate_of_firstDown_regime shared stop.pre localSupported
    (regime_prefix regime stop.post) i v u
    initial final unslashed clean activated
    (localHigh := (getCurrentEpoch stop.state.state).toNat) (by omega)
    (stop.selected_prefix_exit_gt chosen Run.nil u final
      (getCurrentEpoch_succ_lt_farFuture twoSlots stop.state.state)) replayed drop
private theorem effectiveAt_eq_of_epoch_zero
    (tail : Run config checks x y)
    (early : y.fork < .glamsterdam) (zero : (getCurrentEpoch y.state).toNat = 0)
    (inside : i < x.state.validators.data.size) : effectiveAt y i = effectiveAt x i := by
  have order := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps tail.chainSteps)
  have same : getCurrentEpoch y.state = getCurrentEpoch x.state :=
    UInt64.toNat_inj.mp (by omega)
  exact run_same_epoch_effective tail early same i inside
private theorem firstUpdate_of_retained_firstDown_regime
    (shared : Run config checks g x) (tail : Run config checks x y)
    (supported : Supported shared tail high) (regime : .pectra ≤ x.fork ∨ y.fork < .pectra)
    (i : ValidatorIndex) (v w : Validator)
    (initial : x.state.validators.data[i.toNat]? = some v)
    (final : y.state.validators.data[i.toNat]? = some w)
    (unslashed : v.slashed = false) (clean : w.slashed = false)
    (activated : v.activationEpoch ≠ FAR_FUTURE_EPOCH)
    (active : (getCurrentEpoch y.state).toNat < w.exitEpoch.toNat)
    (replayed : tail.balanceEvents high = .ok events)
    (drop : FirstDown tail i.toNat) : Nonempty (FirstUpdate tail high i.toNat) := by
  by_cases zero : (getCurrentEpoch y.state).toNat = 0
  · obtain ⟨j, before, after, one, two, decreases, _ordered⟩ := drop
    obtain ⟨m, n, pre, step, post, k, _split, _offset, left, right⟩ :=
      adjacent_decrease_step tail one two decreases
    have early := supported.2.2.2.2.1
    have nEarly := Nat.lt_of_le_of_lt (fork_le_of_chainSteps post.chainSteps) early
    obtain ⟨u, located, _life⟩ := pre.registryLifecycle.validators i.toNat v initial
    obtain ⟨ok, same, advanced, advanceOk, _zeroIndex, atBefore, atAfter⟩ :=
      step_decrease_of_regime step (step_regime regime pre post)
        nEarly (Array.getElem?_eq_some_iff.mp located).1 left right decreases
    subst step
    have order := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps post.chainSteps)
    have nZero : (getCurrentEpoch n.state).toNat = 0 := by omega
    have equal := run_same_epoch_effective (Run.nil.snoc (.slot ok)) nEarly
      (UInt64.toNat_inj.mp (by
        have previous := UInt64.le_iff_toNat_le.mp
          (currentEpoch_le_of_chainSteps (Run.nil.snoc (.slot ok)).chainSteps)
        omega)) i.toNat (Array.getElem?_eq_some_iff.mp located).1
    obtain ⟨actual, actualOk, upgrades⟩ := bind_ok_iff.mp ok
    have identical := Except.ok.inj (actualOk.symm.trans advanceOk)
    subst actual
    have frame : effectiveAt n i.toNat = effectiveAt ⟨m.fork, advanced⟩ i.toNat := by
      rcases step_regime regime pre post with later | preElectra
      · have kept := processUpgrades_retained_data (s := ⟨m.fork, advanced⟩)
          later nEarly upgrades
          (Nat.le_trans later (processUpgrades_fork_le (forked := ⟨m.fork, advanced⟩) upgrades))
        simp only [effectiveAt, kept]
      · have kept := upgrades_validators upgrades preElectra
        simp only [effectiveAt, kept]
    have lower : effectiveAt ⟨m.fork, advanced⟩ i.toNat < effectiveAt m i.toNat := by
      simpa only [atBefore, atAfter] using decreases
    omega
  · have positive : 0 < (getCurrentEpoch y.state).toNat := by omega
    exact firstUpdate_of_firstDown_regime shared tail supported regime i v w
      initial final unslashed clean activated
      (localHigh := (getCurrentEpoch y.state).toNat - 1) (by omega) (by omega) replayed drop
private theorem retained_effective_loss_positive_regime
    (shared : Run config checks g x) (tail : Run config checks x y)
    (supported : Supported shared tail high) (regime : .pectra ≤ x.fork ∨ y.fork < .pectra)
    (positiveEpoch : 0 < (getCurrentEpoch y.state).toNat)
    (i : ValidatorIndex) (v w : Validator)
    (initial : x.state.validators.data[i.toNat]? = some v)
    (final : y.state.validators.data[i.toNat]? = some w)
    (unslashed : v.slashed = false) (clean : w.slashed = false)
    (activated : v.activationEpoch ≠ FAR_FUTURE_EPOCH)
    (active : (getCurrentEpoch y.state).toNat < w.exitEpoch.toNat)
    (replayed : tail.balanceEvents high = .ok events) :
    effectiveAt x i.toNat ≤ effectiveAt y i.toNat +
      (effectiveAt x i.toNat - actualBalanceAt x i.toNat) +
      ((events.map (floorPenaltyDebit i.toNat)).sum + (events.map (floorPartialDebit i)).sum) +
      (if FirstDown tail i.toNat then preset.EFFECTIVE_BALANCE_INCREMENT.toNat else 0) := by
  obtain ⟨genesis, _parameters, caps, _aligned, early, endpoint, guard⟩ := supported
  obtain ⟨localReplay, exits⟩ :=
      retained_local_replay tail positiveEpoch endpoint replayed w final active
  have positive := guard
  obtain ⟨increment, _, _, _, _, _, _, quotient, _, delay, _⟩ := positive
  have guards : ∀ {m n : ForkedBeaconState preset} (pre : Run config checks x m)
      (step : Step config checks m n) (post : Run config checks n y),
      (pre.snoc step).append post = tail → ∀ u,
      n.state.validators.data[i.toNat]? = some u →
      u.slashed = false ∧ (getCurrentEpoch y.state).toNat - 1 + 1 < u.exitEpoch.toNat ∧
      (getCurrentEpoch m.state).toNat < (getCurrentEpoch x.state).toNat +
        preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat -
          (preset.EPOCHS_PER_SLASHINGS_VECTOR / 2).toNat ∧
      minSlashingPenaltyQuotient preset (preElectraEpochs config x high) ≤
        (EthLib.Consensus.parameters preset m.fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat ∧
      ∀ added, step.balanceEvents = .ok added → ∀ e ∈ added, e.source ≠ .crossing := by
    intro m n pre step post _split u found
    have unmarked : u.slashed = false := by
      cases flag : u.slashed with
      | false => rfl
      | true =>
        obtain ⟨last, located, marked⟩ := post.slashedPersistence i.toNat u found flag
        have same := Option.some.inj (located.symm.trans final)
        subst last
        simp [clean] at marked
    refine ⟨unmarked, exits post u found,
      short_window_of_guard guard endpoint ((Run.nil.snoc step).append post),
      slashing_quotient_le_of_regime (shared.append tail) genesis endpoint guard pre
        (regime_prefix regime ((Run.nil.snoc step).append post)), ?_⟩
    intro added addedOk
    exact no_crossing_of_regime shared pre genesis caps step
      (Nat.lt_of_le_of_lt (fork_le_of_chainSteps post.chainSteps) early)
      (step_regime regime pre post) addedOk
  obtain ⟨last, _, _, debt, _, _, _, path⟩ := unslashed_floor_run shared tail genesis caps
    (by omega) early ((getCurrentEpoch y.state).toNat - 1) (by omega)
    i v initial unslashed activated (min (effectiveAt x i.toNat) (actualBalanceAt x i.toNat))
    0 (minSlashingPenaltyQuotient preset (preElectraEpochs config x high)) (Nat.min_le_left _ _)
        quotient
    guards localReplay
  apply effective_loss_le_of_unslashed_traces shared tail genesis caps increment early
    v initial activated _ 0 (minSlashingPenaltyQuotient preset (preElectraEpochs config x high))
  simpa only [debt] using path
private theorem retained_effective_loss_regime
    (shared : Run config checks g x) (tail : Run config checks x y)
    (supported : Supported shared tail high) (regime : .pectra ≤ x.fork ∨ y.fork < .pectra)
    (i : ValidatorIndex) (v w : Validator)
    (initial : x.state.validators.data[i.toNat]? = some v)
    (final : y.state.validators.data[i.toNat]? = some w)
    (unslashed : v.slashed = false) (clean : w.slashed = false)
    (activated : v.activationEpoch ≠ FAR_FUTURE_EPOCH)
    (active : (getCurrentEpoch y.state).toNat < w.exitEpoch.toNat)
    (replayed : tail.balanceEvents high = .ok events) :
    effectiveAt x i.toNat ≤ effectiveAt y i.toNat +
      (effectiveAt x i.toNat - actualBalanceAt x i.toNat) +
      ((events.map (floorPenaltyDebit i.toNat)).sum + (events.map (floorPartialDebit i)).sum) +
      (if FirstDown tail i.toNat then preset.EFFECTIVE_BALANCE_INCREMENT.toNat else 0) := by
  by_cases zero : (getCurrentEpoch y.state).toNat = 0
  · have early := supported.2.2.2.2.1
    have inside : i.toNat < x.state.validators.data.size :=
        (Array.getElem?_eq_some_iff.mp initial).1
    have same := effectiveAt_eq_of_epoch_zero tail early zero inside
    omega
  · exact retained_effective_loss_positive_regime shared tail supported regime (by omega)
      i v w initial final unslashed clean activated active replayed
private theorem replay_and_drop_of_heq
    {a b : ForkedBeaconState preset} (one : Run config checks x a)
    (two : Run config checks x b) (endpoint : a = b) (same : HEq one two) :
    one.balanceEvents high = two.balanceEvents high ∧ (FirstDown one i ↔ FirstDown two i) := by
  subst b
  have equal := eq_of_heq same
  subst two
  exact ⟨rfl, Iff.rfl⟩
private theorem NewCohortCuts.stopped_replay
    {x y : ForkedBeaconState preset} {tail : Run config checks x y}
    {ledger : LedgerCuts tail} (cohort : NewCohortCuts tail high ledger)
    (unique : PubkeysDistinct y.state) (early : y.fork < .glamsterdam)
    (member : i ∈ cohort.boundary ∪ cohort.departed) :
    (ledger.headRun i).balanceEvents high = (ledger.stops i).pre.balanceEvents high ∧
      (FirstDown (ledger.headRun i) i ↔ FirstDown (ledger.stops i).pre i) := by
  obtain ⟨_, v, w, _before, after, _active, _unset, _assigned, inactive⟩ :=
    cohort.charged_cohort unique early member
  have absent : ¬ (y.state.validators.data[i]?).any (fun v =>
      isActiveValidator v (getCurrentEpoch y.state)) := by
    simpa only [after, Option.any_some, inactive] using Bool.false_ne_true
  exact replay_and_drop_of_heq (ledger.headRun i) (ledger.stops i).pre
    (ledger.stoppedCut i absent).1 (ledger.stoppedCut i absent).2
private theorem NewCohortCuts.retained_replay
    {x y : ForkedBeaconState preset} {tail : Run config checks x y}
    {ledger : LedgerCuts tail} (cohort : NewCohortCuts tail high ledger)
    (unique : PubkeysDistinct y.state) (early : y.fork < .glamsterdam)
    (member : i ∈ cohort.cohort) (supported : i ∈ cohort.supported)
    (notBoundary : i ∉ cohort.boundary) :
    (∃ w, y.state.validators.data[i]? = some w ∧ w.slashed = false ∧
      isActiveValidator w (getCurrentEpoch y.state) = true ∧
      (getCurrentEpoch y.state).toNat < w.exitEpoch.toNat) ∧
    (ledger.headRun i).balanceEvents high = tail.balanceEvents high ∧
      (FirstDown (ledger.headRun i) i ↔ FirstDown tail i) := by
  have endpoint := member
  rw [cohort.exactUniverse, Finset.mem_filter] at endpoint
  obtain ⟨w, found⟩ : ∃ w, y.state.validators.data[i]? = some w := by
    cases read : y.state.validators.data[i]? with
    | none => simp [read] at endpoint
    | some w => exact ⟨w, rfl⟩
  have clean : w.slashed = false := by simpa [found] using endpoint.2.2
  have recent := supported
  rw [cohort.exactSupported, Finset.mem_filter] at recent
  have keyRecent : w.pubkey ∈ recentKeys y.state := by
    simpa only [found, Option.any_some, decide_eq_true_eq] using recent.2
  have activeKey : w.pubkey ∈ activeKeys y.state := by
    by_contra absent
    apply notBoundary
    rw [cohort.exactBoundary]
    exact Finset.mem_filter.mpr ⟨member, by simp [found, keyRecent, absent]⟩
  have active := (intervalGain_active_key y.state early unique i w found).mp activeKey
  have cutoff : (getCurrentEpoch y.state).toNat < w.exitEpoch.toNat := by
    have enabled := active
    simp only [isActiveValidator, Bool.and_eq_true, decide_eq_true_eq] at enabled
    exact UInt64.lt_iff_toNat_lt.mp enabled.2
  have cut := ledger.retainedCut i (by simpa [found] using active)
  exact ⟨⟨w, found, clean, active, cutoff⟩,
    replay_and_drop_of_heq (ledger.headRun i) tail cut.1 cut.2⟩
private theorem Stop.source_firstUpdate_regime
    {i : ValidatorIndex} {tail : Run config checks x y} (stop : Stop tail i.toNat)
    (shared : Run config checks g x) (supported : Supported shared tail high)
    (regime : .pectra ≤ x.fork ∨ y.fork < .pectra) (twoSlots : 2 ≤ preset.SLOTS_PER_EPOCH.toNat)
    (v u : Validator) (initial : x.state.validators.data[i.toNat]? = some v)
    (final : stop.state.state.validators.data[i.toNat]? = some u)
    (unslashed : v.slashed = false) (clean : u.slashed = false)
    (activated : v.activationEpoch ≠ FAR_FUTURE_EPOCH)
    (unset : v.exitEpoch = FAR_FUTURE_EPOCH)
    (replayed : stop.pre.balanceEvents high = .ok events)
    (drop : FirstDown stop.pre i.toNat) : Nonempty (FirstUpdate stop.pre high i.toNat) := by
  cases chosen : stop.charge with
  | some c =>
    exact stop.firstUpdate_of_firstDown_regime chosen shared supported regime twoSlots
      v u initial final unslashed clean activated replayed drop
  | none =>
    have selected := stop.selected
    rw [chosen] at selected
    have same := selected.1
    change stop.state = y at same
    have exit : u.exitEpoch = FAR_FUTURE_EPOCH := by
      by_contra assigned
      obtain ⟨c, present, index, _⟩ := tail.departure_charge_of_assigned i.toNat v u
        initial ((congrArg (fun s : ForkedBeaconState preset =>
          s.state.validators.data[i.toNat]?) same).symm.trans final) unset assigned
      exact selected.2 c present index
    have endpoint := (UInt64.le_iff_toNat_le.mp
      (currentEpoch_le_of_chainSteps stop.post.chainSteps)).trans supported.2.2.2.2.2.1
    have early := Nat.lt_of_le_of_lt (fork_le_of_chainSteps stop.post.chainSteps)
      supported.2.2.2.2.1
    have localSupported : Supported shared stop.pre high :=
      ⟨supported.1, supported.2.1, supported.2.2.1, supported.2.2.2.1,
        early, endpoint, supported.2.2.2.2.2.2⟩
    apply firstUpdate_of_retained_firstDown_regime shared stop.pre localSupported
      (regime_prefix regime stop.post) i v u
      initial final unslashed clean activated _ replayed drop
    rw [exit]
    exact Nat.lt_trans (Nat.lt_succ_self _) (getCurrentEpoch_succ_lt_farFuture twoSlots stop.state.state)
private theorem Stop.source_firstUpdate_of_reference_regime
    {tail : Run config checks x y} (stop : Stop tail i)
    (shared : Run config checks g x) (supported : Supported shared tail high)
    (regime : .pectra ≤ x.fork ∨ y.fork < .pectra) (twoSlots : 2 ≤ preset.SLOTS_PER_EPOCH.toNat)
    (inside : i < x.state.validators.data.size) (reference : NewReference x i)
    (clean : ((stop.state.state.validators.data[i]?).map (·.slashed)).getD true = false)
    (replayed : stop.pre.balanceEvents high = .ok events)
    (drop : FirstDown stop.pre i) : Nonempty (FirstUpdate stop.pre high i) := by
  obtain ⟨v, initial⟩ : ∃ v, x.state.validators.data[i]? = some v :=
    ⟨x.state.validators.data[i], Array.getElem?_eq_some_iff.mpr ⟨inside, rfl⟩⟩
  obtain ⟨u, final, _life⟩ := stop.pre.registryLifecycle.validators i v initial
  unfold NewReference at reference
  simp only [initial, Option.any_some, Bool.and_eq_true, beq_iff_eq] at reference
  have unslashed : v.slashed = false := by
    cases flag : v.slashed <;> simp_all
  have activated : v.activationEpoch ≠ FAR_FUTURE_EPOCH := by
    have active := reference.1.1
    simp only [isActiveValidator, Bool.and_eq_true, decide_eq_true_eq] at active
    intro far
    have lower := UInt64.le_iff_toNat_le.mp active.1
    have upper := UInt64.lt_iff_toNat_lt.mp active.2
    have largest := v.exitEpoch.toNat_lt
    rw [far] at lower
    change 2 ^ 64 - 1 ≤ _ at lower
    omega
  have cleanU : u.slashed =
      false := by simpa only [final, Option.map_some, Option.getD_some] using clean
  have early := Nat.lt_of_le_of_lt (fork_le_of_chainSteps tail.chainSteps) supported.2.2.2.2.1
  have numeric : (UInt64.ofNat i).toNat = i :=
    toNat_toUInt64_of_lt (x.state.validators.bound early) inside
  generalize indexEq : UInt64.ofNat i = index at *
  subst i
  exact stop.source_firstUpdate_regime (i := index) shared supported regime twoSlots v u
    initial final unslashed cleanU activated reference.2 replayed drop
private theorem source_falling_resources_regime
    {tail : Run config checks x y} (stops : (i : Nat) → Stop tail i)
    (shared : Run config checks g x) (supported : Supported shared tail high)
    (regime : .pectra ≤ x.fork ∨ y.fork < .pectra) (twoSlots : 2 ≤ preset.SLOTS_PER_EPOCH.toNat)
    (replayed : tail.balanceEvents high = .ok events) :
    let falling := (Finset.range x.state.validators.data.size).filter (fun i =>
      NewReference x i ∧
      ((stops i).state.state.validators.data[i]?.map (·.slashed)).getD true = false ∧
      FirstDown (stops i).pre i)
    ∃ (first : ∀ i, i ∈ falling → FirstUpdate (stops i).pre high i) (a p : Nat → Nat),
      (∀ i (member : i ∈ falling), a i = (effectiveAt x i - actualBalanceAt x i) +
        (((first i member).prefixEvents ++ (first i member).events).map (floorPenaltyDebit i)).sum)
          ∧
      (∀ i (member : i ∈ falling), p i =
        (((first i member).prefixEvents ++ (first i member).events).map
          (floorPartialDebit (UInt64.ofNat i))).sum) ∧
      (∀ i ∈ falling, preset.downwardBand < a i + p i) ∧
      (∀ i (member : i ∈ falling), ((first i member).prefixEvents ++ (first i member).events)
        <+: events) := by
  dsimp only
  let falling := (Finset.range x.state.validators.data.size).filter (fun i =>
    NewReference x i ∧
    ((stops i).state.state.validators.data[i]?.map (·.slashed)).getD true = false ∧
    FirstDown (stops i).pre i)
  have prefixes (i : Nat) : ∃ part, (stops i).pre.balanceEvents high = .ok part ∧
      part <+: events := by
    have replay := replayed
    rw [← (stops i).split] at replay
    exact (stops i).pre.balanceEvents_prefix (stops i).post high events replay
  choose parts reads included using prefixes
  have existsFirst (i : Nat) (member : i ∈ falling) :
      Nonempty (FirstUpdate (stops i).pre high i) := by
    obtain ⟨inside, reference, clean, drop⟩ := Finset.mem_filter.mp member
    exact (stops i).source_firstUpdate_of_reference_regime shared supported regime twoSlots
      (Finset.mem_range.mp inside) reference clean (reads i) drop
  let first := fun i member => Classical.choice (existsFirst i member)
  let a := fun i => if member : i ∈ falling then
    (effectiveAt x i - actualBalanceAt x i) +
      (((first i member).prefixEvents ++ (first i member).events).map (floorPenaltyDebit i)).sum
    else 0
  let p := fun i => if member : i ∈ falling then
    (((first i member).prefixEvents ++ (first i member).events).map
      (floorPartialDebit (UInt64.ofNat i))).sum else 0
  refine ⟨first, a, p, ?_, ?_, ?_, ?_⟩
  · intro i member
    simp only [a, falling, dite_eq_left member]
  · intro i member
    simp only [p, falling, dite_eq_left member]
  · intro i member
    simpa only [a, p, falling, dite_eq_left member] using
      (first i member).gap.trans_le (first i member).resources
  · intro i member
    exact ((first i member).events_prefix
      ((UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps
        (stops i).post.chainSteps)).trans supported.2.2.2.2.2.1) (reads i)).trans (included i)
private theorem source_resource_budgets
    {tail : Run config checks x y} (shared : Run config checks g x)
    (supported : Supported shared tail high) (replayed : tail.balanceEvents high = .ok events)
    (carrier : Finset Nat) (parts : Nat → List (BalanceEvent preset)) (a p : Nat → Nat)
    (indices : ∀ i ∈ carrier, i < x.state.validators.data.size)
    (active : ∀ i ∈ carrier, ∃ v, x.state.validators.data[i]? = some v ∧
      isActiveValidator v (getCurrentEpoch x.state) = true ∧ v.slashed = false)
    (included : ∀ i ∈ carrier, parts i <+: events)
    (exactA : ∀ i ∈ carrier, a i = (effectiveAt x i - actualBalanceAt x i) +
      ((parts i).map (floorPenaltyDebit i)).sum)
    (exactP : ∀ i ∈ carrier, p i = ((parts i).map (floorPartialDebit (UInt64.ofNat i))).sum)
    (penaltyBound : (events.map fun e =>
      ((getActiveValidatorIndices x.state (getCurrentEpoch x.state)).map fun i =>
        if (x.state.validators.data[i.toNat]?.map (·.slashed)).getD true then 0
          else floorPenaltyDebit i.toNat e).sum).sum ≤
      windowPenalties (config := config) x high (driftHorizon x high + 1))
    (partialBound : (events.map fun e =>
      ∑ i ∈ Finset.range e.before.state.validators.data.size,
        floorPartialDebit (UInt64.ofNat i) e).sum ≤ withdrawalBudget (config := config) x high) :
    (∑ i ∈ carrier, a i) ≤ startSlack x +
        windowPenalties (config := config) x high (driftHorizon x high + 1) ∧
      (∑ i ∈ carrier, p i) ≤ withdrawalBudget (config := config) x high ∧ carrier.card ≤
          referenceCount x := by
  have early := supported.2.2.2.2.1
  have startEarly := Nat.lt_of_le_of_lt (fork_le_of_chainSteps tail.chainSteps) early
  have activeOnly (i : Nat) (member : i ∈ carrier) : ∃ v,
      x.state.validators.data[i]? = some v ∧
      isActiveValidator v (getCurrentEpoch x.state) = true := by
    obtain ⟨v, found, enabled, _⟩ := active i member
    exact ⟨v, found, enabled⟩
  have slack := initial_active_slack_le carrier startEarly activeOnly
  have prefixPenalty := prefix_resource_sum_le carrier parts events
    (fun i => floorPenaltyDebit i) included
  have allPenalty : (events.map fun e => ∑ i ∈ carrier, floorPenaltyDebit i e).sum ≤
      (events.map fun e => ((getActiveValidatorIndices x.state (getCurrentEpoch x.state)).map
        fun i => if (x.state.validators.data[i.toNat]?.map (·.slashed)).getD true then 0
          else floorPenaltyDebit i.toNat e).sum).sum := by
    clear included prefixPenalty replayed penaltyBound partialBound
    induction events with
    | nil => simp
    | cons e events ih =>
      simp only [List.map_cons, List.sum_cons]
      exact Nat.add_le_add (initial_unslashed_debit_le carrier startEarly active
        (fun i => floorPenaltyDebit i e)) ih
  refine ⟨?_, ?_, initial_active_carrier_card_le carrier
    (shared.pubkeysDistinct supported.1) startEarly activeOnly⟩
  · calc
      (∑ i ∈ carrier, a i) = ∑ i ∈ carrier,
          ((effectiveAt x i - actualBalanceAt x i) + ((parts i).map (floorPenaltyDebit i)).sum) :=
        Finset.sum_congr rfl exactA
      _ = (∑ i ∈ carrier, (effectiveAt x i - actualBalanceAt x i)) +
          ∑ i ∈ carrier, ((parts i).map (floorPenaltyDebit i)).sum := Finset.sum_add_distrib
      _ ≤ _ := Nat.add_le_add slack (prefixPenalty.trans (allPenalty.trans penaltyBound))
  · have partials := stopped_partial_occurrences shared supported.1 tail early
      supported.2.2.2.2.2.1 replayed carrier parts indices included
    rw [Finset.sum_congr rfl exactP]
    exact partials.trans partialBound
private theorem source_rounding_of_resources
    {tail : Run config checks x y} (shared : Run config checks g x)
    (supported : Supported shared tail high) (replayed : tail.balanceEvents high = .ok events)
    (carrier : Finset Nat) (parts : Nat → List (BalanceEvent preset)) (a p : Nat → Nat)
    (indices : ∀ i ∈ carrier, i < x.state.validators.data.size)
    (active : ∀ i ∈ carrier, ∃ v, x.state.validators.data[i]? = some v ∧
      isActiveValidator v (getCurrentEpoch x.state) = true ∧ v.slashed = false)
    (included : ∀ i ∈ carrier, parts i <+: events)
    (exactA : ∀ i ∈ carrier, a i = (effectiveAt x i - actualBalanceAt x i) +
      ((parts i).map (floorPenaltyDebit i)).sum)
    (exactP : ∀ i ∈ carrier, p i = ((parts i).map (floorPartialDebit (UInt64.ofNat i))).sum)
    (gap : ∀ i ∈ carrier, preset.downwardBand < a i + p i)
    (penaltyBound : (events.map fun e =>
      ((getActiveValidatorIndices x.state (getCurrentEpoch x.state)).map fun i =>
        if (x.state.validators.data[i.toNat]?.map (·.slashed)).getD true then 0
          else floorPenaltyDebit i.toNat e).sum).sum ≤
      windowPenalties (config := config) x high (driftHorizon x high + 1))
    (partialBound : (events.map fun e =>
      ∑ i ∈ Finset.range e.before.state.validators.data.size,
        floorPartialDebit (UInt64.ofNat i) e).sum ≤ withdrawalBudget (config := config) x high) :
    (∑ i ∈ carrier, a i) ≤ startSlack x +
        windowPenalties (config := config) x high (driftHorizon x high + 1) ∧
      (∑ i ∈ carrier, p i) ≤ withdrawalBudget (config := config) x high ∧
      carrier.card ≤
          finalKeyCount preset (referenceStake x) (referenceCount x)
          (stakeCeilingAt config x high (driftHorizon x high + 1)) ∧
      preset.EFFECTIVE_BALANCE_INCREMENT.toNat * carrier.card ≤
          roundingBudget (config := config) x high := by
  obtain ⟨aBound, pBound, count⟩ := source_resource_budgets shared supported replayed
    carrier parts a p indices active included exactA exactP penaltyBound partialBound
  have guard := supported.2.2.2.2.2.2
  have positive : 0 < preset.downwardBand := by
    unfold aprioriGuardAt aprioriGuard at guard
    exact guard.2.2.2.2.2.1
  have resource := carrier_resource_count_le carrier a p _ _ _ positive gap aBound pBound
  have finalCountBound : carrier.card ≤
      finalKeyCount preset (referenceStake x) (referenceCount x)
          (stakeCeilingAt config x high (driftHorizon x high + 1)) :=
    count.trans (by unfold finalKeyCount; exact Nat.le_add_right _ _)
  refine ⟨aBound, pBound, finalCountBound, ?_⟩
  apply Nat.mul_le_mul_left
  exact le_min finalCountBound (le_min resource (count.trans (Nat.le_add_left _ _)))
private theorem source_numeric_ledger_regime
    {tail : Run config checks x y} (stops : (i : Nat) → Stop tail i)
    (shared : Run config checks g x) (supported : Supported shared tail high)
    (regime : .pectra ≤ x.fork ∨ y.fork < .pectra) (twoSlots : 2 ≤ preset.SLOTS_PER_EPOCH.toNat)
    (replayed : tail.balanceEvents high = .ok events)
    (penaltyBound : (events.map fun e =>
      ((getActiveValidatorIndices x.state (getCurrentEpoch x.state)).map fun i =>
        if (x.state.validators.data[i.toNat]?.map (·.slashed)).getD true then 0
          else floorPenaltyDebit i.toNat e).sum).sum ≤
      windowPenalties (config := config) x high (driftHorizon x high + 1))
    (partialBound : (events.map fun e =>
      ∑ i ∈ Finset.range e.before.state.validators.data.size,
        floorPartialDebit (UInt64.ofNat i) e).sum ≤ withdrawalBudget (config := config) x high) :
    let falling := (Finset.range x.state.validators.data.size).filter (fun i =>
      NewReference x i ∧
      ((stops i).state.state.validators.data[i]?.map (·.slashed)).getD true = false ∧
      FirstDown (stops i).pre i)
    ∃ (first : ∀ i, i ∈ falling → FirstUpdate (stops i).pre high i) (a p : Nat → Nat),
      (∀ i (member : i ∈ falling), a i = (effectiveAt x i - actualBalanceAt x i) +
        (((first i member).prefixEvents ++ (first i member).events).map (floorPenaltyDebit i)).sum)
          ∧
      (∀ i (member : i ∈ falling), p i =
        (((first i member).prefixEvents ++ (first i member).events).map
          (floorPartialDebit (UInt64.ofNat i))).sum) ∧
      (∑ i ∈ falling, a i) ≤ startSlack x +
          windowPenalties (config := config) x high (driftHorizon x high + 1) ∧
      (∑ i ∈ falling, p i) ≤ withdrawalBudget (config := config) x high ∧
      falling.card ≤
          finalKeyCount preset (referenceStake x) (referenceCount x)
          (stakeCeilingAt config x high (driftHorizon x high + 1)) ∧
      preset.EFFECTIVE_BALANCE_INCREMENT.toNat * falling.card ≤
          roundingBudget (config := config) x high := by
  dsimp only
  let falling := (Finset.range x.state.validators.data.size).filter (fun i =>
    NewReference x i ∧
    ((stops i).state.state.validators.data[i]?.map (·.slashed)).getD true = false ∧
    FirstDown (stops i).pre i)
  obtain ⟨first, a, p, exactA, exactP, gap, included⟩ :=
    source_falling_resources_regime stops shared supported regime twoSlots replayed
  let parts := fun i => if member : i ∈ falling then
    (first i member).prefixEvents ++ (first i member).events else []
  have bounds := source_rounding_of_resources shared supported replayed falling parts a p
    (fun i member => Finset.mem_range.mp (Finset.mem_filter.mp member).1)
    (fun i member => by
      have selected := (Finset.mem_filter.mp member).2.1
      unfold NewReference at selected
      cases found : x.state.validators.data[i]? with
      | none => simp [found] at selected
      | some v =>
        refine ⟨v, rfl, ?_⟩
        simp only [found, Option.any_some, Bool.and_eq_true] at selected
        exact ⟨selected.1.1, by cases clean : v.slashed <;> simp_all⟩)
    (fun i member => by simpa only [parts, dite_eq_left member] using included i member)
    (fun i member => by simpa only [parts, dite_eq_left member] using exactA i member)
    (fun i member => by simpa only [parts, dite_eq_left member] using exactP i member)
    gap penaltyBound partialBound
  exact ⟨first, a, p, exactA, exactP, bounds⟩
private theorem firstUpdate_of_heq
    {a b : ForkedBeaconState preset} (one : Run config checks x a)
    (two : Run config checks x b) (endpoint : a = b) (same : HEq one two)
    (first : Nonempty (FirstUpdate two high i)) : Nonempty (FirstUpdate one high i) := by
  subst b
  have equal := eq_of_heq same
  subst two
  exact first
private theorem LedgerCuts.firstUpdate_regime
    {tail : Run config checks x y} (ledger : LedgerCuts tail)
    (shared : Run config checks g x) (supported : Supported shared tail high)
    (regime : .pectra ≤ x.fork ∨ y.fork < .pectra) (twoSlots : 2 ≤ preset.SLOTS_PER_EPOCH.toNat)
    (inside : i < x.state.validators.data.size)
    (reference : (x.state.validators.data[i]?).any (fun v =>
      isActiveValidator v (getCurrentEpoch x.state) && !v.slashed &&
      decide (v.exitEpoch = FAR_FUTURE_EPOCH ∨ horizonEnd x high < v.exitEpoch.toNat)))
    (clean : ((ledger.cut i).state.validators.data[i]?.map (·.slashed)).getD true = false)
    (replayed : (ledger.headRun i).balanceEvents high = .ok events)
    (drop : FirstDown (ledger.headRun i) i) :
    Nonempty (FirstUpdate (ledger.headRun i) high i) := by
  obtain ⟨v, initial⟩ : ∃ v, x.state.validators.data[i]? = some v :=
    ⟨x.state.validators.data[i], Array.getElem?_eq_some_iff.mpr ⟨inside, rfl⟩⟩
  obtain ⟨w, final, life⟩ := tail.registryLifecycle.validators i v initial
  simp only [initial, Option.any_some, Bool.and_eq_true, decide_eq_true_eq] at reference
  have unslashed : v.slashed = false := by cases flag : v.slashed <;> simp_all
  by_cases enabled : (y.state.validators.data[i]?).any (fun v =>
      isActiveValidator v (getCurrentEpoch y.state))
  · have cut := (ledger.retainedCut i enabled).1
    obtain ⟨u, located, _⟩ := (ledger.headRun i).registryLifecycle.validators i v initial
    have sameRead : (ledger.cut i).state.validators.data[i]? = some w := by
      rw [cut]
      exact final
    have identical := Option.some.inj (located.symm.trans sameRead)
    subst u
    have cleanW : w.slashed =
        false := by simpa only [sameRead, Option.map_some, Option.getD_some] using clean
    have activeW : isActiveValidator w (getCurrentEpoch y.state) = true := by
      simpa only [final, Option.any_some] using enabled
    have cutoff : (getCurrentEpoch (ledger.cut i).state).toNat < w.exitEpoch.toNat := by
      rw [cut]
      simp only [isActiveValidator, Bool.and_eq_true, decide_eq_true_eq] at activeW
      exact UInt64.lt_iff_toNat_lt.mp activeW.2
    have activated : v.activationEpoch ≠ FAR_FUTURE_EPOCH := by
      have active := reference.1.1
      simp only [isActiveValidator, Bool.and_eq_true, decide_eq_true_eq] at active
      intro far
      have lower := UInt64.le_iff_toNat_le.mp active.1
      have upper := UInt64.lt_iff_toNat_lt.mp active.2
      have largest := v.exitEpoch.toNat_lt
      rw [far] at lower
      change 2 ^ 64 - 1 ≤ _ at lower
      omega
    have localSupported : Supported shared (ledger.headRun i) high :=
      ⟨supported.1, supported.2.1, supported.2.2.1, supported.2.2.2.1,
        Nat.lt_of_le_of_lt (fork_le_of_chainSteps (ledger.suffix i).chainSteps) supported.2.2.2.2.1,
        (UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps
          (ledger.suffix i).chainSteps)).trans supported.2.2.2.2.2.1, supported.2.2.2.2.2.2⟩
    have numeric : (UInt64.ofNat i).toNat = i := toNat_toUInt64_of_lt
      (x.state.validators.bound (Nat.lt_of_le_of_lt (fork_le_of_chainSteps tail.chainSteps)
        supported.2.2.2.2.1)) inside
    generalize indexEq : UInt64.ofNat i = index at *
    subst i
    exact firstUpdate_of_retained_firstDown_regime shared (ledger.headRun index.toNat)
      localSupported (regime_prefix regime (ledger.suffix index.toNat)) index v w initial located
      unslashed cleanW activated cutoff replayed drop
  · have inactive : isActiveValidator w (getCurrentEpoch y.state) = false := by
      cases active : isActiveValidator w (getCurrentEpoch y.state) <;> simp_all
    have unset : v.exitEpoch = FAR_FUTURE_EPOCH := by
      by_contra assigned
      have outside := reference.2.resolve_left assigned
      have cutoff := initial_active_exit_cutoff tail initial reference.1.1 final inactive
      rw [life.exitEpoch assigned] at cutoff
      have horizon : high + 1 ≤ horizonEnd x high := by unfold horizonEnd driftHorizon; omega
      have endpoint := supported.2.2.2.2.2.1
      omega
    have source : NewReference x i := by
      unfold NewReference
      simp only [initial, Option.any_some, Bool.and_eq_true, beq_iff_eq]
      exact ⟨reference.1, unset⟩
    have cut := ledger.stoppedCut i enabled
    have reads := replay_and_drop_of_heq (high := high) (i := i)
      (ledger.headRun i) (ledger.stops i).pre cut.1 cut.2
    have stopClean : ((ledger.stops i).state.state.validators.data[i]?.map (·.slashed)).getD true =
        false := by
      rw [← cut.1]
      exact clean
    exact firstUpdate_of_heq _ _ cut.1 cut.2
      ((ledger.stops i).source_firstUpdate_of_reference_regime shared supported regime twoSlots
        inside source stopClean (reads.1 ▸ replayed) (reads.2.mp drop))
