/-!
# The quorum of a call drifts by at most its pin reserve, on another branch

A call of the fast confirmation rule reads the pulled-up head state R of an honest store.

A counting state C of another honest store may lie on another branch since the finalized checkpoint.

The two branches leave one split state, at or after the finalized checkpoint's epoch.

This file bounds the drift of the quorum from R to C by `pinReserve`.

## Keys active only in the previous epoch of the counting state

A key that counts in C's quorum but is not active at C's epoch exits by the epoch after R's.

When activity up to C's epoch is fixed at the split, R reads that exit exactly.

So `pinReserve` charges such a key in its `exiting` term.

A slashed key there was slashed after the split, since C does not hold the slashing.

A slashing sets the withdrawable epoch at least `EPOCHS_PER_SLASHINGS_VECTOR` after it.

## The penalties of one key over several epochs

A key pays penalties only in the rewards pass at the end of each epoch.

The pass reads the total, the key's effective balance and its score at the epoch's last state.

So a bound on that rate at each such state bounds the key's penalties over the branch.

## The band of totals

The reserve reads its rates at the call's total, so it needs every total on both branches nearby.

`aprioriGuardAt` at the finalized state bounds each total of a branch from it.

It bounds each such total by a floor and a ceiling.

Before Gloas, twice the last ceiling of the window is at most three times its last floor.

So two totals of the window are within three halves of each other.
-/

@[expose] public section

namespace EthLib.Consensus.Models.Network

open Base Uint64

variable {preset : Preset} {fork : Fork} {config : Config} {checks : SignatureChecks}

/-- A run from a state without a property to a state with it splits at a step that gains it. -/
private theorem Run.split_at_flip {x y : ForkedBeaconState preset} (tail : Run config checks x y)
    (P : ForkedBeaconState preset → Prop) (missing : ¬P x) (held : P y) :
    ∃ (m n : ForkedBeaconState preset) (pre : Run config checks x m)
      (step : Step config checks m n) (post : Run config checks n y),
      tail = (pre.snoc step).append post ∧ ¬P m ∧ P n := by
  induction tail with
  | nil => exact absurd held missing
  | @snoc middle last pre step ih =>
    by_cases inside : P middle
    · obtain ⟨m, n, a, one, rest, split, hm, hn⟩ := ih inside
      refine ⟨m, n, a, one, rest.snoc step, ?_, hm, hn⟩
      rw [split]
      rfl
    · exact ⟨middle, last, pre, step, .nil, rfl, inside, held⟩

/-- The key of a step's slashing evidence is the key of a validator of the step's first state. -/
private theorem slashingEvidence_key {x y : ForkedBeaconState preset} (st : Step config checks x y)
    {key : Cryptography.Bls.BLSPubkey} (evidence : st.SlashingEvidence key) :
    ∃ (j : ℕ) (v : Validator), x.state.validators.data[j]? = some v ∧ v.pubkey = key := by
  cases st with
  | slot _ => exact False.elim evidence
  | block engine signed due ok =>
    rcases evidence with ⟨_, _, v, found, key⟩ | ⟨_, _, i, _, v, found, key⟩
    · exact ⟨_, v, found, key⟩
    · exact ⟨_, v, found, key⟩

/-- A validator that first appears in a step, at a position the first state lacks, is unslashed.

A slashed validator of the last state has a slashed key at the first state.

Otherwise the step carries a slashing that names its key.

Either way a validator of the first state holds that key.

The keys of a run from genesis are distinct. -/
private theorem fresh_unslashed {g m n : ForkedBeaconState preset}
    (toM : Run config checks g m) (step : Step config checks m n)
    (genesis : Genesis config checks g) {i : ℕ} (fresh : m.state.validators.data.size ≤ i)
    {w : Validator} (found : n.state.validators.data[i]? = some w) : w.slashed = false := by
  by_contra not
  have slashed : w.slashed = true := by simpa using not
  have unique : PubkeysDistinct n.state := (toM.snoc step).pubkeysDistinct genesis
  have kept := (validatorKeys_prefix_and_distinct_of_chainSteps
    (Relation.ReflTransGen.single step.chainStep)).1
  have taken : ∀ (j : ℕ) (v : Validator), m.state.validators.data[j]? = some v →
      v.pubkey = w.pubkey → False := by
    intro j v read key
    obtain ⟨current, currentRead, currentKey⟩ :=
      validators_getElem?_of_validatorKeys_prefix kept read
    have same := unique.index_eq currentRead found (currentKey.trans key)
    have inside := (Array.getElem?_eq_some_iff.mp read).1
    omega
  have member : w ∈ n.state.validators.data.toList := Array.mem_toList_iff.mpr
    (Array.mem_of_getElem? found)
  rcases (Run.nil.snoc step).slashed_evidence w member slashed with
    ⟨v, memberV, key, -⟩ | ⟨a, b, st, contained, evidence⟩
  · obtain ⟨j, read⟩ := List.mem_iff_getElem?.mp memberV
    exact taken j v (by simpa using read) key
  · cases contained with
    | last =>
      obtain ⟨j, v, read, key⟩ := slashingEvidence_key step evidence
      exact taken j v read key
    | earlier inner _ => cases inner

/-- A key that R slashed and C did not has waited the slashings vector.

The key may be one of the split's registry, or one that joined the registry after the split.

It is slashed on R's branch after the split, or after it joined.

So its withdrawable epoch is at least the split's epoch plus `EPOCHS_PER_SLASHINGS_VECTOR`.

A run keeps every slashing, so the counting state would hold a key slashed at the split slashed. -/
private theorem slashed_waits {g : ForkedBeaconState preset}
    {split pulled counted : BeaconState preset fork}
    (toSplit : Run config checks g ⟨fork, split⟩) (genesis : Genesis config checks g)
    (toPulled : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩)
    (toCounted : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩)
    (early : fork < .glamsterdam) (caps : CapOrder preset)
    (withdrawDelay : 0 < config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    {i : ℕ} {validator : Validator} (found : pulled.validators.data[i]? = some validator)
    (slashed : validator.slashed = true)
    (unslashedC : ((counted.validators.data[i]?).map (·.slashed)).getD true = false) :
    (getCurrentEpoch split).toNat + preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat ≤
      validator.withdrawableEpoch.toNat := by
  by_cases inside : i < split.validators.data.size
  · have oldFound := Array.getElem?_eq_getElem inside
    cases oldSlashed : split.validators.data[i].slashed
    · exact (toPulled.newly_slashed_withdrawableEpoch caps.activation caps.compounding early
        withdrawDelay i _ validator oldFound found oldSlashed slashed).2
    · obtain ⟨now, nowFound, nowSlashed⟩ :=
        toCounted.slashedPersistence i _ oldFound oldSlashed
      simp [nowFound, nowSlashed] at unslashedC
  · -- The key joined the registry in R's run, and it was not slashed when it first appeared.
    obtain ⟨m, n, pre, step, post, -, notYet, arrived⟩ := Run.split_at_flip toPulled
      (fun z => i < z.state.validators.data.size) inside
      (Array.getElem?_eq_some_iff.mp found).1
    obtain ⟨w, arrivedFound⟩ : ∃ w, n.state.validators.data[i]? = some w :=
      ⟨_, Array.getElem?_eq_getElem arrived⟩
    have unslashedAtN := fresh_unslashed (toSplit.append pre) step genesis
      (Nat.le_of_not_lt notYet) arrivedFound
    have delayed := (post.newly_slashed_withdrawableEpoch caps.activation caps.compounding early
      withdrawDelay i w validator arrivedFound found unslashedAtN slashed).2
    have forward : (getCurrentEpoch split).toNat ≤ (getCurrentEpoch n.state).toNat :=
      UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps (pre.snoc step).chainSteps)
    omega

open DirectSafety DirectSafety.Apriori.Internal

/-- The rate at which one rewards pass can debit a key, read at the last state of the epoch.

It reads the total active balance, the key's effective balance and its score there.

The pass reads the score after its update, which adds at most the score bias. -/
private def passPenaltyRate (config : Config) (z : ForkedBeaconState preset) (v : ℕ) : ℕ :=
  let total := activeBalanceTotal z.state
  let score := if altair : .altair ≤ z.fork then
      (((z.state.inactivityScores altair).data[v]?).map (·.toNat)).getD 0 else 0
  (TIMELY_SOURCE_WEIGHT.toNat + TIMELY_TARGET_WEIGHT.toNat) * preset.BASE_REWARD_FACTOR.toNat *
      effectiveAt z v / (WEIGHT_DENOMINATOR.toNat * total.sqrt) +
    effectiveAt z v * (score + config.INACTIVITY_SCORE_BIAS.toNat) /
      (config.INACTIVITY_SCORE_BIAS.toNat *
        (parameters preset z.fork).INACTIVITY_PENALTY_QUOTIENT.toNat)

/-- The penalties of one key in one segment of a branch fit its pass rate.

This holds if the segment ends an epoch, and the penalties are zero otherwise.

The rate is asked only at the last pass state.

It is asked only when that state reads a total active balance and a base reward per increment.

Every step of the segment starts at the epoch of its start `m`.

Inside the epoch only blocks run, and they record no penalty.

The slot that ends the epoch runs the rewards pass, read at its last state.

So a segment that stays in its epoch pays nothing. -/
private theorem segment_passDebit_le_guarded {m n : ForkedBeaconState preset}
    (mid : Run config checks m n) (early : n.fork < .glamsterdam) (altair : .altair ≤ m.fork)
    (high : ℕ) (endEpoch : (getCurrentEpoch n.state).toNat ≤ high + 1)
    (starts : ∀ {u w : ForkedBeaconState preset} (step : Step config checks u w),
      mid.Contains step → getCurrentEpoch u.state = getCurrentEpoch m.state)
    {v : ℕ} (inside : v < m.state.validators.data.size) (pen : ℕ)
    (rate : ∀ {z : ForkedBeaconState preset} (pre : Run config checks m z)
      (ok : advanceSlotAcross config checks z = .ok n), mid = pre.snoc (Step.slot ok) →
      (getCurrentEpoch z.state).toNat < (getCurrentEpoch n.state).toNat →
      (∃ total perIncrement, getTotalActiveBalance z.state = .ok total ∧
        getBaseRewardPerIncrement preset total = .ok perIncrement) →
      passPenaltyRate config z v ≤ pen)
    {found : List (BalanceEvent preset)} (replayed : mid.balanceEvents high = .ok found) :
    (found.map (penaltyDebit v)).sum ≤
      if getCurrentEpoch m.state < getCurrentEpoch n.state then pen else 0 := by
  rcases DirectSafety.Apriori.Internal.segment_events_cases mid early altair high endEpoch starts
      replayed with same | ⟨u, inner, boundary, during, crossings, cached, rfl, uEarly, uEpoch,
      crossing, duringOk, cachedOk, crossingsFree, -, kind⟩
  · -- A segment inside its epoch runs only blocks, which record no penalty.
    have free := (epoch_sync_data mid altair early same high replayed).2.1
    rw [penaltyDebit_sum_zero_of_free free]
    exact Nat.zero_le _
  rw [ite_eq_left (uEpoch ▸ crossing)]
  have free := (epoch_sync_data inner altair uEarly uEpoch high duringOk).2.1
  rcases kind with rfl | ⟨just, pass, rewarded, later, justified, scored, rewardedOk, rfl,
    laterSources, -⟩
  · simp only [List.map_append, List.sum_append, penaltyDebit_sum_zero_of_free free,
      penaltyDebit_sum_zero_of_free crossingsFree]
    exact Nat.zero_le _
  have altairU : .altair ≤ u.fork := Nat.le_trans altair (fork_le_of_chainSteps inner.chainSteps)
  have laterFree : PenaltyFree later := fun e member => by
    rcases laterSources e member with s | s | s <;> simp [s]
  simp only [List.map_append, List.sum_append, penaltyDebit_sum_zero_of_free free,
    penaltyDebit_sum_zero_of_free laterFree, penaltyDebit_sum_zero_of_free crossingsFree,
    Nat.zero_add, Nat.add_zero]
  -- The pass reads the registry, the slot and the scores of `u`, after one update of the scores.
  obtain ⟨_, _, _, _, rfl⟩ := processSlot_ok cachedOk
  have one := justified.records ⟨nofun, nofun, nofun, nofun, nofun, nofun⟩
  have two := scored.records ⟨nofun, nofun, nofun, nofun, nofun, nofun⟩
  have validators : pass.validators = u.state.validators := two.1.trans one.1
  have slot : pass.slot = u.state.slot := two.2.2.2.2.trans one.2.2.2.2
  have passEpoch : getCurrentEpoch pass = getCurrentEpoch u.state := by
    simp only [getCurrentEpoch, slot]
  have scoredOk : processInactivityUpdates config just altairU = .ok pass := by
    simpa only [EpochStage.Edge, altairU, ↓reduceDIte] using scored
  have justScores := processJustificationAndFinalization_inactivityScores justified
  have grows := registryGrows_of_chainSteps inner.chainSteps
  have insidePass : v < pass.validators.data.size := by rw [validators]; omega
  rcases replayRewards_penalty_scalar_cases altairU (pass.validators.bound uEarly) rewardedOk {v}
      (fun j member => by rw [Finset.mem_singleton.mp member]; exact insidePass) with
    ⟨total, perIncrement, passTotal, perOk⟩ | quiet
  swap
  · simp only [Finset.sum_singleton] at quiet
    rw [quiet]
    exact Nat.zero_le _
  set score := (if later : .altair ≤ u.fork then
      (((u.state.inactivityScores later).data[v]?).map (·.toNat)).getD 0 else 0) with scoreDef
  have bound := passPenalties_le altairU (pass.validators.bound uEarly) rewardedOk passTotal {v}
    (fun j member => by rw [Finset.mem_singleton.mp member]; exact insidePass)
    (maxScore := score + config.INACTIVITY_SCORE_BIAS.toNat) (fun j member found' updated => by
      rw [Finset.mem_singleton.mp member] at updated
      obtain ⟨old, olds, raised⟩ := processInactivityUpdates_score_le scoredOk updated
      rw [justScores] at olds
      have : old.toNat = score := by simp [scoreDef, altairU, olds]
      omega)
  simp only [Finset.sum_singleton] at bound
  have totalU : getTotalActiveBalance u.state = .ok total := by
    simpa only [getTotalActiveBalance, getActiveValidatorIndicesChecked, getTotalBalance,
      validators, passEpoch] using passTotal
  refine bound.trans (le_trans ?_ (rate inner boundary rfl
    (UInt64.lt_iff_toNat_lt.mp crossing) ⟨total, perIncrement, totalU, perOk⟩))
  -- The pass's reads are those of `u`.
  have weight : eligibleWeight pass v ≤ effectiveAt u v := by
    unfold eligibleWeight
    simp only [validators, effectiveAt]
    split <;> [split <;> simp_all; simp]
  unfold passPenaltyRate
  dsimp only
  rw [← getTotalActiveBalance_toNat totalU, ← scoreDef]
  apply Nat.add_le_add
  · apply Nat.div_le_div_right
    exact Nat.mul_le_mul_left _ weight
  · apply Nat.div_le_div_right
    exact Nat.mul_le_mul_right _ weight

/-- The penalties of one key over a branch from Altair are at most its pass rate per epoch ended.

The rate must hold at each state of the branch before the epoch of its end.

The branch ends `epoch y - epoch x` epochs, and each runs one rewards pass.

The cut induction of the a priori bound, `run_cuts_le`, sums the segments. -/
private theorem Run.passDebit_le {x y : ForkedBeaconState preset} (tail : Run config checks x y)
    (early : y.fork < .glamsterdam) (altair : .altair ≤ x.fork) (high : ℕ)
    (endEpoch : (getCurrentEpoch y.state).toNat ≤ high + 1)
    {v : ℕ} (inside : v < x.state.validators.data.size) (pen : ℕ)
    (rate : ∀ {z : ForkedBeaconState preset} (pre : Run config checks x z)
      (post : Run config checks z y), tail = pre.append post →
      (getCurrentEpoch z.state).toNat < (getCurrentEpoch y.state).toNat →
      (∃ total perIncrement, getTotalActiveBalance z.state = .ok total ∧
        getBaseRewardPerIncrement preset total = .ok perIncrement) →
      passPenaltyRate config z v ≤ pen)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events) :
    (events.map (penaltyDebit v)).sum ≤
      ((getCurrentEpoch y.state).toNat - (getCurrentEpoch x.state).toNat) * pen := by
  have total := run_cuts_le high tail early
    (fun z => (∃ total perIncrement, getTotalActiveBalance z.state = .ok total ∧
        getBaseRewardPerIncrement preset total = .ok perIncrement) →
      passPenaltyRate config z v ≤ pen)
    (penaltyDebit v) (fun t => if t < ix x y then pen else 0) rate
    (fun {m n} toM mid rest starts rates {found} found_ok => by
      have nEarly := Nat.lt_of_le_of_lt (fork_le_of_chainSteps rest.chainSteps) early
      have ny := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps rest.chainSteps)
      have segment := segment_passDebit_le_guarded mid nEarly
        (Nat.le_trans altair (fork_le_of_chainSteps toM.chainSteps)) high (by omega) starts
        (Nat.lt_of_lt_of_le inside (registryGrows_of_chainSteps toM.chainSteps)) pen
        (fun {z} preZ ok split before totals =>
          rates preZ (Run.nil.snoc (Step.slot ok)) split before totals)
        found_ok
      refine segment.trans ?_
      split
      · rename_i before
        have := UInt64.lt_iff_toNat_lt.mp before
        have xm := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps toM.chainSteps)
        simp only [ix]
        rw [ite_eq_left (by omega)]
      · exact Nat.zero_le _)
    (ix x y + 1) (fun step member => steps_before_end tail step member) replayed
  -- Each epoch that the branch ends counts `pen`, and the epoch of its end counts nothing.
  rw [List.range_succ, List.map_append, List.sum_append,
    List.map_congr_left (g := fun _ => pen)
      (fun t member => ite_eq_left (List.mem_range.mp member)),
    List.map_const', List.sum_replicate, List.length_range] at total
  simpa [ix] using total

/-- The sync debit of one key in one event. -/
private def syncDebit (v : ℕ) (event : BalanceEvent preset) : ℕ :=
  if event.source = .sync then actualBalanceAt event.before v - actualBalanceAt event.after v else 0

/-- The sync credit of a key in one event. -/
private def syncCredit (v : ℕ) (event : BalanceEvent preset) : ℕ :=
  if event.source = .sync then actualBalanceAt event.after v - actualBalanceAt event.before v else 0

/-- The balance of a key that stays unslashed falls over a branch only by its debits, as events.

It starts from the smaller of its balance and its largest effective balance.

The debits are the penalties, the sync penalties and the partial withdrawals of its events.

The guards are those of the per-key floor of the a priori bound.

A key with no activation epoch is allowed if the branch starts from Fulu or later. -/
private theorem Run.balanceFloor_events_or_fulu {g x y : ForkedBeaconState preset}
    (shared : Run config checks g x) (tail : Run config checks x y)
    (genesis : Genesis (config := config) (checks := checks) g) (caps : CapOrder preset)
    (delay : 0 < config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    (early : y.fork < .glamsterdam) (high : ℕ)
    (endEpoch : (getCurrentEpoch y.state).toNat ≤ high + 1)
    (v : ValidatorIndex) (val : Validator) (initial : x.state.validators.data[v.toNat]? = some val)
    (unslashed : val.slashed = false)
    (activated : val.activationEpoch ≠ FAR_FUTURE_EPOCH ∨ .fusaka ≤ x.fork)
    (quotient : ℕ) (positive : 0 < quotient)
    (guards : ∀ {m n : ForkedBeaconState preset} (pre : Run config checks x m)
      (step : Step config checks m n) (post : Run config checks n y),
      (pre.snoc step).append post = tail → ∀ w, n.state.validators.data[v.toNat]? = some w →
      (high + 1 < w.exitEpoch.toNat ∨
        ∀ u, m.state.validators.data[v.toNat]? = some u → high + 1 < u.withdrawableEpoch.toNat) ∧
      (getCurrentEpoch m.state).toNat < (getCurrentEpoch x.state).toNat +
        preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat -
          (preset.EPOCHS_PER_SLASHINGS_VECTOR / 2).toNat ∧
      quotient ≤ (EthLib.Consensus.parameters preset m.fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat ∧
      ∀ events, step.balanceEvents = .ok events → ∀ e ∈ events, e.source ≠ .crossing)
    (stays : ∀ w, y.state.validators.data[v.toNat]? = some w → w.slashed = false)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events) :
    min (actualBalanceAt x v.toNat) (withdrawalMaxEffectiveBalance preset x.fork val).toNat ≤
      actualBalanceAt y v.toNat + (events.map (penaltyDebit v.toNat)).sum +
        (events.map (syncDebit v.toNat)).sum + (events.map (floorPartialDebit v)).sum := by
  obtain ⟨last, trace, balance, debt, -, w, final, -, used, -⟩ :=
    FloorTrace.run_of_le_cap_or_fulu shared tail genesis caps delay early high endEpoch v val
      initial
      unslashed
      activated (min (actualBalanceAt x v.toNat)
        (withdrawalMaxEffectiveBalance preset x.fork val).toNat) 0 quotient
      (Nat.min_le_right _ _) positive guards replayed
  have clean : last.slashedHigh = none := by
    cases flag : last.slashedHigh with
    | none => rfl
    | some _ => simp [flag, stays w final] at used
  have floor := FloorTrace.unslashed_balance_floor trace (by simp) clean
  have split : (events.map (floorPenaltyDebit v.toNat)).sum =
      (events.map (penaltyDebit v.toNat)).sum + (events.map (syncDebit v.toNat)).sum := by
    rw [← List.sum_map_add]
    rfl
  rw [balance, debt, split] at floor
  omega

/-- The partial payments to one key are a cost that selects that key's queued entries. -/
private theorem partialCost_key (v : ValidatorIndex) :
    PartialCost (config := config) (checks := checks) (floorPartialDebit (preset := preset) v)
      (fun entry => decide (entry.validatorIndex = v)) where
  quiet e source := by simp [floorPartialDebit, source]
  paid := by
    intro _ _ _ electra _ _ _ _ _ _ computed
    simpa [floorPartialDebit, electra, computed] using
      (getPendingPartialWithdrawals_taken computed).2 v
  slot ok early _ replayed := List.sum_eq_zero fun _ member => by
    obtain ⟨e, present, rfl⟩ := List.mem_map.mp member
    simp [floorPartialDebit, slot_events_no_withdrawals ok early replayed e present]

/-- The partial payments to one key, plus its entries left queued, fit its entries at the start.

The branch is from Electra.

The entries counted are those due by the cutoff.

The cutoff is within the withdrawal delay of the start.

An entry appended along the branch is due no earlier than the delay after the start. -/
private theorem Run.partialDebit_net {x y : ForkedBeaconState preset}
    (tail : Run config checks x y) (electra : .pectra ≤ x.fork) (early : y.fork < .glamsterdam)
    (high cutoff : ℕ) (endpoint : (getCurrentEpoch y.state).toNat ≤ cutoff)
    (short : cutoff < (getCurrentEpoch x.state).toNat +
      config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    (v : ValidatorIndex) {events : List (BalanceEvent preset)}
    (replayed : tail.balanceEvents high = .ok events) :
    (events.map (floorPartialDebit v)).sum +
        ((((y.state.pendingPartialWithdrawals
          (Nat.le_trans electra (fork_le_of_chainSteps tail.chainSteps))).data.toList.filter
            fun entry => decide (entry.validatorIndex = v)).filter
              (fun entry => entry.withdrawableEpoch.toNat ≤ cutoff)).map (·.amount.toNat)).sum ≤
      ((((x.state.pendingPartialWithdrawals electra).data.toList.filter
        fun entry => decide (entry.validatorIndex = v)).filter
          (fun entry => entry.withdrawableEpoch.toNat ≤ cutoff)).map (·.amount.toNat)).sum := by
  obtain ⟨added, late, bound⟩ :=
    run_partial_queue_net (partialCost_key v) high cutoff electra tail early replayed endpoint
  have none : ((added.filter fun entry => decide (entry.validatorIndex = v)).filter
      (fun entry => entry.withdrawableEpoch.toNat ≤ cutoff)) = [] := by
    apply List.filter_eq_nil_iff.mpr
    intro entry member
    have := late entry (List.mem_of_mem_filter member)
    simp only [decide_eq_true_eq]
    omega
  rw [none] at bound
  simpa using bound

/-- The partial payments to one key over a branch from Electra fit its entries due by the cutoff.

These are its entries of the queue at the start.

The cutoff is within the withdrawal delay of the start.

An entry appended along the branch is due no earlier than the delay after the start. -/
private theorem Run.partialDebit_le {x y : ForkedBeaconState preset}
    (tail : Run config checks x y) (electra : .pectra ≤ x.fork) (early : y.fork < .glamsterdam)
    (high cutoff : ℕ) (endpoint : (getCurrentEpoch y.state).toNat ≤ cutoff)
    (short : cutoff < (getCurrentEpoch x.state).toNat +
      config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    (v : ValidatorIndex) {events : List (BalanceEvent preset)}
    (replayed : tail.balanceEvents high = .ok events) :
    (events.map (floorPartialDebit v)).sum ≤
      ((((x.state.pendingPartialWithdrawals electra).data.toList.filter
        fun entry => decide (entry.validatorIndex = v)).filter
          (fun entry => entry.withdrawableEpoch.toNat ≤ cutoff)).map (·.amount.toNat)).sum :=
  Nat.le_of_add_right_le (Run.partialDebit_net tail electra early high cutoff endpoint short v
    replayed)

/-! ## The band of totals from the guard at the finalized state -/

section Band

open DirectSafety.Apriori

/-- From Electra, the ceiling of a window grows with the epoch of the window. -/
private theorem stakeCeilingAt_mono {x : ForkedBeaconState preset} {high : ℕ}
    (electra : .pectra ≤ x.fork) {s t : ℕ} (le : s ≤ t) :
    stakeCeilingAt config x high s ≤ stakeCeilingAt config x high t := by
  have notBefore : ¬ x.fork < .pectra := Nat.not_lt_of_ge electra
  have zero : preElectraEpochs config x high = 0 := by simp [preElectraEpochs, notBefore]
  induction le with
  | refl => exact Nat.le_refl _
  | step _ ih =>
    refine ih.trans ?_
    simp only [stakeCeilingAt, stakeCeiling, zero, Nat.lt_irrefl, false_and, ↓reduceIte]
    omega

/-- The floor of a window falls with the epoch of the window. -/
private theorem stakeFloorAt_anti {x : ForkedBeaconState preset} {high : ℕ} {s t : ℕ}
    (le : s ≤ t) : stakeFloorAt config x high t ≤ stakeFloorAt config x high s := by
  induction le with
  | refl => exact Nat.le_refl _
  | step _ ih =>
    refine Nat.le_trans ?_ ih
    simp only [stakeFloorAt, stakeFloor, stakeFloorPath]
    omega

/-- From Electra, the guard bounds twice the window's last ceiling by three times its last floor.

The window's last index is the epoch after `high`, counted from the guarded state's epoch. -/
private theorem ratio_of_guard {x : ForkedBeaconState preset} {high : ℕ}
    (electra : .pectra ≤ x.fork) (guard : aprioriGuardAt config x high) :
    2 * stakeCeilingAt config x high (high + 1 - (getCurrentEpoch x.state).toNat) ≤
      3 * stakeFloorAt config x high (high + 1 - (getCurrentEpoch x.state).toNat) := by
  have notBefore : ¬ x.fork < .pectra := Nat.not_lt_of_ge electra
  have zero : preElectraEpochs config x high = 0 := by simp [preElectraEpochs, notBefore]
  obtain ⟨-, -, -, -, -, -, -, -, -, -, -, -, ratioGuard, -⟩ := id guard
  rw [zero] at ratioGuard
  have ratio := ratioGuard (high + 1 - (getCurrentEpoch x.state).toNat) (Nat.zero_le _)
    (by unfold driftHorizon; omega)
  simpa [stakeCeilingAt, stakeFloorAt, zero] using ratio

/-- From Electra and before Gloas, take a state reached from a guarded state within its window.

Its total is between the floor and the ceiling of the window at the state's index. -/
private theorem total_within_guard {g x z : ForkedBeaconState preset} {high : ℕ}
    (shared : Run config checks g x) (genesis : Genesis (config := config) (checks := checks) g)
    (parameters : DirectSafety.Parameters preset) (caps : CapOrder preset)
    (aligned : MaxEffectiveBalancesAligned preset) (twoSlots : 2 ≤ preset.SLOTS_PER_EPOCH.toNat)
    (electra : .pectra ≤ x.fork) (guard : aprioriGuardAt config x high)
    (run : Run config checks x z) (early : z.fork < .glamsterdam)
    (within : (getCurrentEpoch z.state).toNat ≤ high + 1) {total : Gwei}
    (totalOk : getTotalActiveBalance z.state = .ok total) :
    stakeFloorAt config x high (ix x z) ≤ total.toNat ∧
      total.toNat ≤ stakeCeilingAt config x high (ix x z) := by
  obtain ⟨ceiling, -, floor⟩ := ceilingFloor_electra shared run high
    ⟨genesis, parameters, caps, aligned, early, within, guard⟩ twoSlots electra
  have xEarly := Nat.lt_of_le_of_lt (fork_le_of_chainSteps run.chainSteps) early
  have unit := (ceiling_unit_of_guard shared genesis aligned xEarly electra guard).trans
    (stakeCeilingAt_mono electra (Nat.zero_le (ix x z)))
  refine ⟨floor total totalOk, ?_⟩
  obtain ⟨-, -, value⟩ := getTotalBalance_ok_iff_stake.mp (getTotalActiveBalance_ok totalOk)
  rw [value]
  exact max_le unit ceiling

/-- From Electra and before Gloas, take two states reached from a guarded state in its window.

Their totals are within three halves of each other.

Both lie between the window's last floor and ceiling.

The guard asks that twice that ceiling be at most three times that floor.

So the band follows from the guard, and nothing assumes it. -/
private theorem total_band_of_guard {g x y z : ForkedBeaconState preset} {high : ℕ}
    (shared : Run config checks g x) (genesis : Genesis (config := config) (checks := checks) g)
    (parameters : DirectSafety.Parameters preset) (caps : CapOrder preset)
    (aligned : MaxEffectiveBalancesAligned preset) (twoSlots : 2 ≤ preset.SLOTS_PER_EPOCH.toNat)
    (electra : .pectra ≤ x.fork) (guard : aprioriGuardAt config x high)
    (toY : Run config checks x y) (yEarly : y.fork < .glamsterdam)
    (yWithin : (getCurrentEpoch y.state).toNat ≤ high + 1)
    (toZ : Run config checks x z) (zEarly : z.fork < .glamsterdam)
    (zWithin : (getCurrentEpoch z.state).toNat ≤ high + 1) {yTotal zTotal : Gwei}
    (yOk : getTotalActiveBalance y.state = .ok yTotal)
    (zOk : getTotalActiveBalance z.state = .ok zTotal) :
    2 * zTotal.toNat ≤ 3 * yTotal.toNat := by
  have ratio := ratio_of_guard electra guard
  obtain ⟨yLow, -⟩ := total_within_guard shared genesis parameters caps aligned twoSlots electra
    guard toY yEarly yWithin yOk
  obtain ⟨-, zHigh⟩ := total_within_guard shared genesis parameters caps aligned twoSlots electra
    guard toZ zEarly zWithin zOk
  -- Both indices are at most the window's last index.
  have yAnti := stakeFloorAt_anti (config := config) (x := x) (high := high)
    (show ix x y ≤ high + 1 - (getCurrentEpoch x.state).toNat by simp only [ix]; omega)
  have zMono := stakeCeilingAt_mono (config := config) (x := x) (high := high) electra
    (show ix x z ≤ high + 1 - (getCurrentEpoch x.state).toNat by simp only [ix]; omega)
  omega

/-- The preset facts that the pin's drift bound needs.

Each field is a fact about the preset alone, and a deployed preset has it. -/
structure PinPresetFacts (preset : Preset) : Prop where
  /-- (preset fact) An increment is at least 900 times the slashings vector. -/
  rounding : 900 * preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat ≤
    preset.EFFECTIVE_BALANCE_INCREMENT.toNat
  /-- (preset fact) An increment is at least 14 times the slashing quotient. -/
  slash : 14 * (EthLib.Consensus.parameters preset .fusaka).MIN_SLASHING_PENALTY_QUOTIENT.toNat ≤
    preset.EFFECTIVE_BALANCE_INCREMENT.toNat
  /-- (preset fact) The slashings vector has at least four epochs. -/
  vector : 4 ≤ preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat
  /-- (preset fact) The slashing quotient is at least two. -/
  quotient : 2 ≤ (EthLib.Consensus.parameters preset .fusaka).MIN_SLASHING_PENALTY_QUOTIENT.toNat
  /-- (preset fact) The margin leaves room for the climb after a third of the stake is lost.

  It reads the maximum effective balance, the band, and the slashing quotient. -/
  margin : 2400 * (2 * preset.MAX_EFFECTIVE_BALANCE.toNat / 3 -
      preset.MAX_EFFECTIVE_BALANCE.toNat /
        (EthLib.Consensus.parameters preset .fusaka).MIN_SLASHING_PENALTY_QUOTIENT.toNat -
      preset.downwardBand - 1) + 2400 * preset.downwardBand +
    2400 * ((preset.MAX_EFFECTIVE_BALANCE.toNat + preset.downwardBand +
      (EthLib.Consensus.parameters preset .fusaka).MIN_SLASHING_PENALTY_QUOTIENT.toNat - 1) /
        (EthLib.Consensus.parameters preset .fusaka).MIN_SLASHING_PENALTY_QUOTIENT.toNat) ≤
    1591 * (preset.MAX_EFFECTIVE_BALANCE.toNat + preset.downwardBand)
  /-- (preset fact) Ten upward bands fit in the maximum effective balance. -/
  band : 10 * preset.upwardBand ≤ preset.MAX_EFFECTIVE_BALANCE.toNat
  /-- (preset fact) The upward band is at most the downward band and one increment. -/
  upward : preset.upwardBand ≤ preset.downwardBand + preset.EFFECTIVE_BALANCE_INCREMENT.toNat
  /-- (preset fact) The largest slashing penalty and the downward band fit in an increment. -/
  slashBand : preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat /
      preset.MIN_SLASHING_PENALTY_QUOTIENT_ELECTRA.toNat + preset.downwardBand ≤
    preset.EFFECTIVE_BALANCE_INCREMENT.toNat
  /-- (preset fact) At every fork the floor of a new key is at least an increment. -/
  newKey : ∀ fork : Fork, preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤
    2 * preset.MAX_EFFECTIVE_BALANCE.toNat / 3 -
      preset.MAX_EFFECTIVE_BALANCE.toNat /
        (EthLib.Consensus.parameters preset fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat -
      preset.downwardBand - preset.EFFECTIVE_BALANCE_INCREMENT.toNat
  /-- (preset fact) At every fork the whistleblower quotient is at least thirty. -/
  whistleblower : ∀ fork : Fork,
    30 ≤ (EthLib.Consensus.parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat
  /-- (preset fact) The increment times the base reward factor is `2 ^ 35` or more, never small. -/
  rewardScale : 2 ^ 35 ≤ preset.EFFECTIVE_BALANCE_INCREMENT.toNat * preset.BASE_REWARD_FACTOR.toNat
  /-- (preset fact) An increment is at least `10 ^ 8` gwei, which rules out a small increment. -/
  incrementSize : 10 ^ 8 ≤ preset.EFFECTIVE_BALANCE_INCREMENT.toNat
  /-- (preset fact) A sync committee period has at least one epoch. -/
  syncPeriod : preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD ≠ 0
  /-- (preset fact) Four downward bands fit in an increment. -/
  quarterBand : 4 * preset.downwardBand ≤ preset.EFFECTIVE_BALANCE_INCREMENT.toNat
  /-- (preset fact) The proposer lookahead ends before activity stops being fixed. -/
  covers : preset.MIN_SEED_LOOKAHEAD.toNat + 1 ≤ preset.MAX_SEED_LOOKAHEAD.toNat
  /-- (preset fact) The increment times the base reward factor does not overflow a `Gwei`. -/
  fits : preset.EFFECTIVE_BALANCE_INCREMENT.toNat * preset.BASE_REWARD_FACTOR.toNat < 2 ^ 64
  /-- (preset fact) An increment is at most four downward bands, which rules out a tiny band. -/
  bandLow : preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤ 4 * preset.downwardBand
  /-- (preset fact) The activation balance is at most the largest effective balance before Electra.

  With the cap order, the two are equal, as the upgrade to Electra needs. -/
  activation : ActivationWithinMaxEffective preset

/-- The downward band is below an increment.

Four bands fit in an increment, and an increment is positive. -/
private theorem PinPresetFacts.below (facts : PinPresetFacts preset) :
    preset.downwardBand < preset.EFFECTIVE_BALANCE_INCREMENT.toNat := by
  have := facts.quarterBand
  have := facts.incrementSize
  omega

/-- The base reward factor is positive, since its product with an increment is at least `2 ^ 35`. -/
private theorem PinPresetFacts.reward (facts : PinPresetFacts preset) :
    1 ≤ preset.BASE_REWARD_FACTOR.toNat := by
  have scale := facts.rewardScale
  rcases Nat.eq_zero_or_pos preset.BASE_REWARD_FACTOR.toNat with zero | positive
  · rw [zero, Nat.mul_zero] at scale
    exact absurd scale (by decide)
  · exact positive

/-- Forty-four slashings vectors fit in three increments.

It compares epochs with gwei, since the unit gain adds two gwei of rounding for each epoch.

An increment is at least 900 slashings vectors. -/
private theorem PinPresetFacts.vectorSmall (facts : PinPresetFacts preset) :
    44 * preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat ≤
      3 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat := by
  have := facts.rounding
  omega

/-- The mainnet preset has the preset facts of the pin. -/
theorem PinPresetFacts.mainnet : PinPresetFacts Preset.mainnet :=
  ⟨by decide, by decide, by decide, by decide, by decide, by decide, by decide, by decide,
    fun fork => by cases fork <;> decide, fun fork => by cases fork <;> decide, by decide,
    by decide, by decide, by decide, by decide, by decide, by decide,
    ActivationWithinMaxEffective.mainnet⟩

/-- The minimal preset has the preset facts of the pin. -/
theorem PinPresetFacts.minimal : PinPresetFacts Preset.minimal :=
  ⟨by decide, by decide, by decide, by decide, by decide, by decide, by decide, by decide,
    fun fork => by cases fork <;> decide, fun fork => by cases fork <;> decide, by decide,
    by decide, by decide, by decide, by decide, by decide, by decide,
    ActivationWithinMaxEffective.minimal⟩

/-- From Electra and before Gloas, the floor of the window at its start leaves room for the window.

The guard asks that twice the last ceiling be at most three times the last floor.

The ceiling is at least an increment, and the floor falls with the epoch of the window.

So the first floor is at least two thirds of an increment.

The window is shorter than the slashings vector, and an increment is at least 900 vectors.

An increment is also at least 14 slashing quotients, so the first floor is at least 9 quotients. -/
private theorem first_floor_of_guard {g x : ForkedBeaconState preset} {high : ℕ}
    (shared : Run config checks g x) (genesis : Genesis (config := config) (checks := checks) g)
    (aligned : MaxEffectiveBalancesAligned preset)
    (xEarly : x.fork < .glamsterdam)
    (electra : .pectra ≤ x.fork) (guard : aprioriGuardAt config x high)
    (facts : PinPresetFacts preset) :
    600 * (high + 2 - (getCurrentEpoch x.state).toNat) ≤ stakeFloorAt config x high 0 ∧
      9 * (EthLib.Consensus.parameters preset .fusaka).MIN_SLASHING_PENALTY_QUOTIENT.toNat ≤
        stakeFloorAt config x high 0 := by
  have notBefore : ¬ x.fork < .pectra := Nat.not_lt_of_ge electra
  have zero : preElectraEpochs config x high = 0 := by simp [preElectraEpochs, notBefore]
  obtain ⟨-, -, -, -, -, -, -, -, -, -, window, -⟩ := id guard
  have ratio := ratio_of_guard electra guard
  have unit := (ceiling_unit_of_guard shared genesis aligned xEarly electra guard).trans
    (stakeCeilingAt_mono electra (Nat.zero_le (high + 1 - (getCurrentEpoch x.state).toNat)))
  have anti := stakeFloorAt_anti (config := config) (x := x) (high := high)
    (Nat.zero_le (high + 1 - (getCurrentEpoch x.state).toNat))
  have rounding := facts.rounding
  have slash := facts.slash
  simp only [stakeCeilingAt, stakeFloorAt, zero] at unit anti ratio ⊢
  unfold driftHorizon at window
  constructor <;> omega

end Band


/-! ## Credits to exiting keys -/

/-- A pending deposit leaves a balance alone unless its key is first found at that position.

The validators only grow at the end. -/
private theorem applyPendingDeposit_frame {s s' : BeaconState preset fork}
    {deposit : PendingDeposit}
    (altair : .altair ≤ fork)
    (computed : applyPendingDeposit config checks s deposit = .ok s') {i : ℕ}
    (inside : i < s.validators.data.size)
    (other : s.validators.data.findIdx? (·.pubkey == deposit.pubkey) ≠ some i) :
    s'.balances.data[i]? = s.balances.data[i]? ∧
      ∃ suffix : List Validator,
        s'.validators.data.toList = s.validators.data.toList ++ suffix := by
  cases hf : s.validators.data.findIdx? (·.pubkey == deposit.pubkey) with
  | some j =>
    have ne : i ≠ j := fun same => other (same ▸ hf)
    exact ⟨(applyPendingDeposit_known_balances hf computed).2 i ne, [], by
      rw [(applyPendingDeposit_known hf computed).2, List.append_nil]⟩
  | none =>
    refine ⟨DirectSafety.Apriori.Internal.applyPendingDeposit_absent_balances altair hf computed
      inside, ?_⟩
    rcases applyPendingDeposit_cases computed with rfl | ⟨_, raised⟩ | ⟨_, added⟩
    · exact ⟨[], by simp⟩
    · exact ⟨[], by rw [increaseBalance_validators raised, List.append_nil]⟩
    · exact ⟨[getValidatorFromDeposit preset fork deposit.pubkey deposit.withdrawalCredentials
        deposit.amount], by rw [addValidatorToRegistry_validators_eq_push added, Array.toList_push]⟩

/-- From Electra, the pending deposits of an epoch leave a key's balance alone.

This holds while the key exits and is not yet withdrawable.

Such a key's deposits are postponed (`processPendingDeposits_postponed_epochs`). -/
private theorem processPendingDeposits_exited_balance {state after : BeaconState preset fork}
    {electra : .pectra ≤ fork}
    (computed : processPendingDeposits config checks state electra = .ok after)
    {i : ℕ} {v : Validator} (found : state.validators.data[i]? = some v)
    (exited : v.exitEpoch.toNat < 2 ^ 64 - 1)
    (held : (getCurrentEpoch state).toNat < v.withdrawableEpoch.toNat) :
    after.balances.data[i]? = state.balances.data[i]? := by
  obtain ⟨read, rest, next, pending, carried, -, -, -, folded, rfl⟩ :=
    processPendingDeposits_postponed_epochs computed
  have inside : i < state.validators.data.size := (Array.getElem?_eq_some_iff.mp found).1
  have vAt : state.validators.data[i] = v := (Array.getElem?_eq_some_iff.mp found).2
  let P : BeaconState preset fork → Prop := fun s =>
    s.balances.data[i]? = state.balances.data[i]? ∧
      ∃ suffix : List Validator, s.validators.data.toList = state.validators.data.toList ++ suffix
  have final : P next := by
    refine foldlM_ok_invariant_of_mem P (fun s d s' member ⟨bal, suffix, pre⟩ step => ?_)
      ⟨rfl, [], by simp⟩ folded
    have sizeV : state.validators.data.size ≤ s.validators.data.size := by
      have := congrArg List.length pre
      simp only [Array.length_toList, List.length_append] at this
      omega
    have get : ∀ j (hj : j < state.validators.data.size) (hs : j < s.validators.data.size),
        s.validators.data[j] = state.validators.data[j] := by
      intro j hj hs
      have := congrArg (·[j]?) pre
      rw [List.getElem?_append_left (by rw [Array.length_toList]; exact hj),
        Array.getElem?_toList, Array.getElem?_toList, Array.getElem?_eq_getElem hs,
        Array.getElem?_eq_getElem hj] at this
      exact Option.some.inj this
    -- The deposit does not go to position `i`: its key would find `v`, which is postponed.
    have other : s.validators.data.findIdx? (·.pubkey == d.pubkey) ≠ some i := by
      intro hit
      obtain ⟨h, hitMatch, before⟩ := Array.findIdx?_eq_some_iff_getElem.mp hit
      have atI : s.validators.data[i] = v := (get i inside h).trans vAt
      have firstMatch : state.validators.data.find? (·.pubkey == d.pubkey) = some v := by
        rw [← Array.find?_toList, List.find?_eq_some_iff_getElem]
        refine ⟨atI ▸ hitMatch, i, by rw [Array.length_toList]; exact inside,
          by simp [vAt], fun j hj => ?_⟩
        have hjs : j < state.validators.data.size := by omega
        have := before j hj
        rw [get j hjs (by omega)] at this
        simpa using this
      have kept := (List.mem_filter.mp member).2
      rw [firstMatch] at kept
      simp only [Option.any_some, Bool.not_eq_true', Bool.and_eq_false_iff,
        decide_eq_false_iff_not] at kept
      omega
    obtain ⟨bal', suffix', pre2⟩ := applyPendingDeposit_frame
      (Nat.le_trans (show Fork.altair ≤ Fork.pectra by decide) electra) step
      (Nat.lt_of_lt_of_le inside sizeV) other
    exact ⟨bal'.trans bal, suffix ++ suffix', by rw [pre2, pre, List.append_assoc]⟩
  exact final.1

end EthLib.Consensus.Models.Network

namespace EthLib.Consensus.Models.Network

section

/-! ## The credits of one key along a run -/

namespace PinKeys

open Base Uint64 Models DirectSafety

variable {preset : Preset} {fork : Fork} {config : Config} {checks : SignatureChecks}

/-- The credit of key `i` in one replayed event. -/
private def keyCredit (i : ℕ) (e : BalanceEvent preset) : ℕ :=
  actualBalanceAt e.after i - actualBalanceAt e.before i

/-- The credits to the key in one step, from the sources that count at that kind of step. -/
private def stepCredit (blockP slotP : BalanceSource → Bool) (v : ℕ)
    {x y : ForkedBeaconState preset} (step : Step config checks x y) : ℕ :=
  let events := step.balanceEvents.toOption.getD []
  match step with
  | .slot _ => ((events.filter (slotP ·.source)).map (keyCredit v)).sum
  | .block .. => ((events.filter (blockP ·.source)).map (keyCredit v)).sum

/-- The credits to the key over a run.

The steps count from the one whose start epoch is at most `high + 1`, as in `Run.balanceEvents`. -/
private def creditScan (blockP slotP : BalanceSource → Bool) (v high : ℕ)
    {x : ForkedBeaconState preset} :
    {y : ForkedBeaconState preset} → Run config checks x y → ℕ
  | _, .nil => 0
  | _, .snoc (middle := m) pre step =>
    let before := creditScan blockP slotP v high pre
    if (getCurrentEpoch m.state).toNat ≤ high + 1 then
      before + stepCredit blockP slotP v step
    else before

/-- The credits that a scan reads from a run, after one more step. -/
private theorem creditScan_snoc (blockP slotP : BalanceSource → Bool) (v high : ℕ)
    {x m y : ForkedBeaconState preset} (pre : Run config checks x m)
    (step : Step config checks m y) :
    creditScan blockP slotP v high (pre.snoc step) =
      if (getCurrentEpoch m.state).toNat ≤ high + 1 then
        creditScan blockP slotP v high pre + stepCredit blockP slotP v step
      else creditScan blockP slotP v high pre := rfl

/-- The credits of a run to a key, read as a scan, add over `append`. -/
private theorem creditScan_append (blockP slotP : BalanceSource → Bool) (v high : ℕ)
    {x m y : ForkedBeaconState preset} (pre : Run config checks x m)
    (post : Run config checks m y) :
    (creditScan blockP slotP v high (pre.append post)) =
      (creditScan blockP slotP v high pre) + (creditScan blockP slotP v high post) := by
  induction post with
  | nil => rfl
  | snoc post step ih =>
    change (creditScan blockP slotP v high ((pre.append post).snoc step)) = _
    rw [creditScan_snoc, creditScan_snoc]
    split
    · omega
    · exact ih

/-- The credits that a scan reads are 0 if each step of the run credits 0. -/
private theorem creditScan_eq_zero_of_steps (blockP slotP : BalanceSource → Bool) (v high : ℕ)
    {x y : ForkedBeaconState preset} (tail : Run config checks x y)
    (zero : ∀ {m n : ForkedBeaconState preset} (step : Step config checks m n),
      tail.Contains step → stepCredit blockP slotP v step = 0) :
    (creditScan blockP slotP v high tail) = 0 := by
  induction tail with
  | nil => rfl
  | @snoc m n pre step ih =>
    have prior := ih fun inner member => zero inner (.earlier member step)
    have here := zero step (.last pre step)
    rw [creditScan_snoc]
    split <;> omega

/-- The credits of a list of events from one source set are at most those from a larger set. -/
private theorem sum_filter_credit_le (p q : BalanceSource → Bool)
    (sub : ∀ s, p s = true → q s = true) (v : ℕ) (L : List (BalanceEvent preset)) :
    ((L.filter (p ·.source)).map (keyCredit v)).sum ≤
      ((L.filter (q ·.source)).map (keyCredit v)).sum := by
  induction L with
  | nil => simp
  | cons e rest ih =>
    by_cases inP : p e.source = true
    · have inQ := sub _ inP
      simp only [List.filter_cons, inP, inQ, ↓reduceIte, List.map_cons, List.sum_cons]
      omega
    · by_cases inQ : q e.source = true
      · simp only [List.filter_cons, inP, inQ, Bool.false_eq_true, ↓reduceIte, List.map_cons,
          List.sum_cons]
        omega
      · simp only [List.filter_cons, inP, inQ, Bool.false_eq_true, ↓reduceIte]
        exact ih

/-- The credits of a set of keys over a run, read as a scan, fit one bound for each replayed event.

A block step counts the events of `blockP`.

A slot step counts the events of `slotP`.

So an event of the run is counted at most once.

The credits of a key from a source set `src` over the events are at most its scan.

Each kind of step either counts all of `src`, or records no credit from `src`.

That holds for a run from Electra to before Glamsterdam. -/
private theorem creditScan_bounds {ι : Type} (S : Finset ι) (key : ι → ℕ)
    (blockP slotP : BalanceSource → Bool) (high : ℕ) (T : BalanceEvent preset → ℕ)
    {x y : ForkedBeaconState preset}
    (tail : Run config checks x y) {events : List (BalanceEvent preset)}
    (replayed : tail.balanceEvents high = .ok events)
    (each : ∀ e ∈ events, (blockP e.source = true ∨ slotP e.source = true) →
      ∑ v ∈ S, keyCredit (key v) e ≤ T e) :
    (∑ v ∈ S, (creditScan blockP slotP (key v) high tail) ≤
      (events.map fun e =>
        if blockP e.source = true ∨ slotP e.source = true then T e else 0).sum) ∧
    (∀ src : BalanceSource → Bool,
      ((∀ s, src s = true → blockP s = true) ∨
        ∀ {f : Fork} {u w : BeaconState preset f} {engine : ExecutionEngine preset f}
          {signed : SignedBeaconBlock preset f} {due : upgradeDue config ⟨f, u⟩ = false}
          {ok : applySignedBlock config checks engine u signed true = .ok w}
          {es : List (BalanceEvent preset)}, .pectra ≤ f → f < .glamsterdam →
          (Step.block engine signed due ok : Step config checks ⟨f, u⟩ ⟨f, w⟩).balanceEvents =
            .ok es → ∀ i, ((es.filter (src ·.source)).map (keyCredit i)).sum = 0) →
      ((∀ s, src s = true → slotP s = true) ∨
        ∀ {u w : ForkedBeaconState preset} (ok : advanceSlotAcross config checks u = .ok w)
          {es : List (BalanceEvent preset)}, .pectra ≤ u.fork → w.fork < .glamsterdam →
          (Step.slot ok : Step config checks u w).balanceEvents = .ok es →
            ∀ i, ((es.filter (src ·.source)).map (keyCredit i)).sum = 0) →
      .pectra ≤ x.fork → y.fork < .glamsterdam →
      ∀ v, ((events.filter (src ·.source)).map (keyCredit v)).sum ≤
        (creditScan blockP slotP v high tail)) := by
  induction tail generalizing events with
  | nil =>
    simp only [Run.balanceEvents, pure, Except.pure, Except.ok.injEq] at replayed
    subst replayed
    exact ⟨Nat.le_zero.mpr (Finset.sum_eq_zero fun v _ => rfl), fun _ _ _ _ _ v => by simp⟩
  | @snoc middle last pre step ih =>
    simp only [Run.balanceEvents, bind_ok_iff] at replayed
    obtain ⟨prior, priorOk, rest⟩ := replayed
    by_cases selected : (getCurrentEpoch middle.state).toNat ≤ high + 1
    · simp only [selected, ↓reduceIte, bind_ok_iff, pure, Except.pure, Except.ok.injEq] at rest
      obtain ⟨added, addedOk, rfl⟩ := rest
      obtain ⟨previous, previousSrc⟩ :=
        ih priorOk fun e member => each e (List.mem_append_left _ member)
      have swap (L : List (BalanceEvent preset)) : ∑ v ∈ S, (L.map (keyCredit (key v))).sum =
          (L.map fun e => ∑ v ∈ S, keyCredit (key v) e).sum := by
        simpa using (Multiset.sum_map_sum (m := (L : Multiset (BalanceEvent preset)))
          (s := S) (f := fun e v => keyCredit (key v) e)).symm
      have part (p : BalanceSource → Bool)
          (sub : ∀ s, p s = true → blockP s = true ∨ slotP s = true) :
          ∑ v ∈ S, ((added.filter fun x => p x.source).map (keyCredit (key v))).sum ≤
            (added.map fun e =>
              if blockP e.source = true ∨ slotP e.source = true then T e else 0).sum := by
        rw [swap]
        calc ((added.filter fun x => p x.source).map fun e => ∑ v ∈ S, keyCredit (key v) e).sum
            ≤ ((added.filter fun x => p x.source).map T).sum := List.sum_le_sum fun e member =>
              each e (List.mem_append_right _ (List.mem_filter.mp member).1)
                (sub _ (by simpa using (List.mem_filter.mp member).2))
          _ = (added.map fun e => if p e.source = true then T e else 0).sum := by
              rw [List.sum_map_ite (fun e : BalanceEvent preset => p e.source = true) T
                (fun _ => 0)]
              simp
          _ ≤ _ := List.sum_le_sum fun e _ => by
              by_cases hp : p e.source = true
              · have := sub _ hp
                simp [hp, this]
              · simp [hp]
      have step_le : ∑ v ∈ S, stepCredit blockP slotP (key v) step ≤
          (added.map fun e =>
            if blockP e.source = true ∨ slotP e.source = true then T e else 0).sum := by
        cases step with
        | slot ok =>
          simp only [stepCredit, addedOk, Except.toOption, Option.getD_some]
          exact part slotP fun _ h => Or.inr h
        | block engine signed due ok =>
          simp only [stepCredit, addedOk, Except.toOption, Option.getD_some]
          exact part blockP fun _ h => Or.inl h
      refine ⟨?_, fun src blockKind slotKind electra early v => ?_⟩
      · simp only [creditScan_snoc, selected, ↓reduceIte, Finset.sum_add_distrib,
          List.map_append, List.sum_append]
        omega
      · have prior := previousSrc src blockKind slotKind electra
          (Nat.lt_of_le_of_lt step.chainStep.fork_le early) v
        have stepSrc : ((added.filter (src ·.source)).map (keyCredit v)).sum ≤
            stepCredit blockP slotP v step := by
          have inRun := Nat.le_trans electra (fork_le_of_chainSteps pre.chainSteps)
          cases step with
          | slot ok =>
            simp only [stepCredit, addedOk, Except.toOption, Option.getD_some]
            rcases slotKind with covered | quiet
            · exact sum_filter_credit_le src slotP covered v added
            · rw [quiet ok inRun early addedOk v]
              exact Nat.zero_le _
          | block engine signed due ok =>
            simp only [stepCredit, addedOk, Except.toOption, Option.getD_some]
            rcases blockKind with covered | quiet
            · exact sum_filter_credit_le src blockP covered v added
            · rw [quiet inRun early addedOk v]
              exact Nat.zero_le _
        simp only [creditScan_snoc, selected, ↓reduceIte, List.filter_append, List.map_append,
          List.sum_append]
        omega
    · simp only [selected, ↓reduceIte, pure, Except.pure, Except.ok.injEq] at rest
      obtain rfl := rest
      obtain ⟨previous, previousSrc⟩ := ih priorOk each
      refine ⟨?_, fun src blockKind slotKind electra early v => ?_⟩
      · simp only [creditScan_snoc, selected, ↓reduceIte]
        exact previous
      · simp only [creditScan_snoc, selected, ↓reduceIte]
        exact previousSrc src blockKind slotKind electra
          (Nat.lt_of_le_of_lt step.chainStep.fork_le early) v

/-- The credits of a set of keys over a run, read as a scan, fit one bound for each replayed event.

A block step counts the events of `blockP`.

A slot step counts the events of `slotP`.

So an event of the run is counted at most once. -/
private theorem creditScan_sum_le {ι : Type} (S : Finset ι) (key : ι → ℕ)
    (blockP slotP : BalanceSource → Bool) (high : ℕ) (T : BalanceEvent preset → ℕ)
    {x y : ForkedBeaconState preset}
    (tail : Run config checks x y) {events : List (BalanceEvent preset)}
    (replayed : tail.balanceEvents high = .ok events)
    (each : ∀ e ∈ events, (blockP e.source = true ∨ slotP e.source = true) →
      ∑ v ∈ S, keyCredit (key v) e ≤ T e) :
    ∑ v ∈ S, (creditScan blockP slotP (key v) high tail) ≤
      (events.map fun e =>
        if blockP e.source = true ∨ slotP e.source = true then T e else 0).sum :=
  (creditScan_bounds S key blockP slotP high T tail replayed each).1

/-- The net rise of a key in one step.

A block step counts the rise of the key's balance across it, and a slot step counts nothing. -/
private def stepNet (v : ℕ) {x y : ForkedBeaconState preset} (step : Step config checks x y) : ℕ :=
  match step with
  | .block .. => actualBalanceAt y v - actualBalanceAt x v
  | .slot _ => 0

/-- The net credits to the key in the block steps of a run.

A block step counts the rise of the key's balance across the whole step.

A credit that the same step takes back counts for nothing.

The steps count from the one whose start epoch is at most `high + 1`, as in `Run.balanceEvents`. -/
private def netScan (v high : ℕ) {x : ForkedBeaconState preset} :
    {y : ForkedBeaconState preset} → Run config checks x y → ℕ
  | _, .nil => 0
  | _, .snoc (middle := m) pre step =>
    if (getCurrentEpoch m.state).toNat ≤ high + 1 then
      netScan v high pre + stepNet v step
    else netScan v high pre

/-- The net credits to a key in the block steps of a run, after one more step. -/
private theorem netScan_snoc (v high : ℕ) {x m y : ForkedBeaconState preset}
    (pre : Run config checks x m) (step : Step config checks m y) :
    netScan v high (pre.snoc step) =
      if (getCurrentEpoch m.state).toNat ≤ high + 1 then
        netScan v high pre + stepNet v step
      else netScan v high pre := rfl

/-- A run with no step has no net credits. -/
private theorem netScan_nil (v high : ℕ) {x : ForkedBeaconState preset} :
    netScan v high (Run.nil : Run config checks x x) = 0 := rfl

/-- A run with no step has no credits to scan. -/
private theorem creditScan_nil (blockP slotP : BalanceSource → Bool) (v high : ℕ)
    {x : ForkedBeaconState preset} :
    (creditScan blockP slotP v high (Run.nil : Run config checks x x)) = 0 := rfl

/-- Events within their credit limits credit the slashing events at most their limits. -/
private theorem slashing_credits_le_limits (events : List (BalanceEvent preset))
    (bounded : ∀ e ∈ events, e.credits ≤ e.creditLimit) :
    ((events.filter (·.source = .slashings)).map BalanceEvent.credits).sum ≤
      (events.map fun e => if e.source = .slashings then e.creditLimit else 0).sum := by
  induction events with
  | nil => simp
  | cons head rest ih =>
    have tailLe := ih fun e member => bounded e (List.mem_cons_of_mem _ member)
    have headLe := bounded head List.mem_cons_self
    by_cases source : head.source = .slashings
    · simp only [List.filter_cons, source, decide_true, ↓reduceIte, List.map_cons, List.sum_cons]
      omega
    · simp only [List.filter_cons, source, decide_false, Bool.false_eq_true, ↓reduceIte,
        List.map_cons, List.sum_cons]
      omega

end PinKeys

/-! ## A floor and a ceiling on one key's effective balance -/

namespace PinKeyFloor

open Base Uint64 Models

variable {preset : Preset} {config : Config} {checks : SignatureChecks}

/-- A successful update of the effective balances applies the scalar update at each index.

It reads the balance of the index, which it keeps. -/
private theorem effective_update_at {f : Fork} {s t : BeaconState preset f}
    (ok : processEffectiveBalanceUpdates s = .ok t) {i : ℕ}
    (inside : i < s.validators.data.size) :
    ∃ (v : Validator) (balance new : Gwei), s.validators.data[i]? = some v ∧
      s.balances.data[i]? = some balance ∧
      t.validators.data[i]? = some { v with effectiveBalance := new } ∧
      updatedEffectiveBalance preset (withdrawalMaxEffectiveBalance preset f v) balance
        v.effectiveBalance = .ok new := by
  have found : ∃ v, s.validators.data[i]? = some v :=
    ⟨_, Array.getElem?_eq_getElem inside⟩
  obtain ⟨v, found⟩ := found
  obtain ⟨balance, owned⟩ := processEffectiveBalanceUpdates_owned ok found
  obtain ⟨new, read, updated⟩ := processEffectiveBalanceUpdates_effectiveBalance_eq ok found owned
  exact ⟨v, balance, new, found, owned, read, updated⟩

/-- The update of the effective balances keeps a lower bound on the effective balance of a key.

Suppose the update changes the effective balance only if the balance rounded down is at least `low`.

Suppose also that the cap is at least `capLow`, and `low` is at most `capLow`.

The new value is the old one, or the balance rounded down to an increment, at most the cap. -/
private theorem effective_floor_update {f : Fork} {s t : BeaconState preset f}
    (ok : processEffectiveBalanceUpdates s = .ok t) (i capLow low : ℕ)
    (inside : i < s.validators.data.size) (lowCap : low ≤ capLow)
    (reach : (actualBalanceAt ⟨f, s⟩ i + preset.downwardBand < effectiveAt ⟨f, s⟩ i ∨
        effectiveAt ⟨f, s⟩ i + preset.upwardBand < actualBalanceAt ⟨f, s⟩ i) →
      low ≤ actualBalanceAt ⟨f, s⟩ i - actualBalanceAt ⟨f, s⟩ i %
        preset.EFFECTIVE_BALANCE_INCREMENT.toNat)
    (previous : low ≤ effectiveAt ⟨f, s⟩ i)
    (cap : ∀ v, t.validators.data[i]? = some v →
      capLow ≤ (withdrawalMaxEffectiveBalance preset f v).toNat) :
    low ≤ effectiveAt ⟨f, t⟩ i := by
  obtain ⟨v, balance, new, found, owned, read, updated⟩ := effective_update_at ok inside
  have capped := cap _ read
  change capLow ≤ (withdrawalMaxEffectiveBalance preset f v).toNat at capped
  simp only [actualBalanceAt, owned, Option.map_some, Option.getD_some] at reach
  simp only [effectiveAt, found, Option.map_some, Option.getD_some] at reach previous
  simp only [effectiveAt, read, Option.map_some, Option.getD_some]
  rcases updatedEffectiveBalance_split updated with ⟨rfl, -⟩ | ⟨rfl, fires⟩
  · exact previous
  · rw [Base.Uint64.toNat_min, toNat_rounded]
    exact Nat.le_min.mpr ⟨reach fires, Nat.le_trans lowCap capped⟩

/-- One slot step keeps the lower bound, given the balance and the cap after it.

Only the epoch transition changes an effective balance, in its update. -/
private theorem effective_floor_slot {f : Fork} {s t : BeaconState preset f}
    (ok : advanceSlot config checks s = .ok t) (i capLow low : ℕ)
    (inside : i < s.validators.data.size) (lowCap : low ≤ capLow)
    (reach : (actualBalanceAt ⟨f, t⟩ i + preset.downwardBand < effectiveAt ⟨f, s⟩ i ∨
        effectiveAt ⟨f, s⟩ i + preset.upwardBand < actualBalanceAt ⟨f, t⟩ i) →
      low ≤ actualBalanceAt ⟨f, t⟩ i - actualBalanceAt ⟨f, t⟩ i %
        preset.EFFECTIVE_BALANCE_INCREMENT.toNat)
    (previous : low ≤ effectiveAt ⟨f, s⟩ i)
    (cap : ∀ v, t.validators.data[i]? = some v →
      capLow ≤ (withdrawalMaxEffectiveBalance preset f v).toNat) :
    low ≤ effectiveAt ⟨f, t⟩ i := by
  have life := (registryLifecycle_advanceSlot ok).size_le
  simp only [advanceSlot, bind_ok_iff, pure, Except.pure, Except.ok.injEq] at ok
  obtain ⟨next, _, cached, cache, advanced, advance, rfl⟩ := ok
  obtain ⟨_, _, _, _, rfl⟩ := processSlot_ok cache
  unfold epochIfLast at advance
  split at advance
  · obtain ⟨before, after, kept, updated, validators, balances⟩ := balanceDrift_epoch advance
    have insideTail : i < advanced.validators.data.size := Nat.lt_of_lt_of_le inside life
    have insideBefore : i < before.validators.data.size := by
      rw [← (sameSizes_processEffectiveBalanceUpdates updated).1]
      rw [validators] at insideTail
      exact insideTail
    have prior : low ≤ effectiveAt ⟨f, before⟩ i := by
      rw [kept i inside]
      exact previous
    have bound := effective_floor_update updated i capLow low insideBefore lowCap
      (by
        rw [kept i inside]
        have reach' := reach
        simp only [actualBalanceAt, balances] at reach' ⊢
        exact reach') prior
      (fun v read => cap v (by rw [validators]; exact read))
    simpa only [effectiveAt, validators] using bound
  · cases advance
    exact previous

/-- The update of the effective balances keeps an upper bound on the effective balance of a key.

The smaller of the balance and `capHigh` must be at most `ceil`, and the cap at most `capHigh`.

The cap bound is a whole number of increments, and the old effective balance is at most it.

The new value is at most `ceil` plus the downward band.

It is also at most the old one, or the balance rounded down to an increment, at most the cap. -/
private theorem effective_ceiling_update {f : Fork} {s t : BeaconState preset f}
    (ok : processEffectiveBalanceUpdates s = .ok t) (i ceil capHigh : ℕ)
    (inside : i < s.validators.data.size)
    (alignedHigh : capHigh % preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0)
    (old : effectiveAt ⟨f, s⟩ i ≤ capHigh)
    (funded : min (actualBalanceAt ⟨f, s⟩ i) capHigh ≤ ceil)
    (cap : ∀ v, t.validators.data[i]? = some v →
      (withdrawalMaxEffectiveBalance preset f v).toNat ≤ capHigh) :
    effectiveAt ⟨f, t⟩ i ≤ ceil + preset.downwardBand ∧
    effectiveAt ⟨f, t⟩ i ≤ max (effectiveAt ⟨f, s⟩ i)
      (min (ceil - ceil % preset.EFFECTIVE_BALANCE_INCREMENT.toNat) capHigh) := by
  obtain ⟨v, balance, new, found, owned, read, updated⟩ := effective_update_at ok inside
  have capped := cap _ read
  change (withdrawalMaxEffectiveBalance preset f v).toNat ≤ capHigh at capped
  simp only [actualBalanceAt, owned, Option.map_some, Option.getD_some] at funded
  simp only [effectiveAt, found, Option.map_some, Option.getD_some] at old
  simp only [effectiveAt, read, found, Option.map_some, Option.getD_some]
  have add := updatedEffectiveBalance_le_add updated
  refine ⟨?_, ?_⟩
  · by_cases small : balance.toNat ≤ capHigh
    · omega
    · have newHigh : new.toNat ≤ capHigh := by
        rcases updatedEffectiveBalance_cases updated with rfl | rfl
        · exact old
        · rw [Base.Uint64.toNat_min, toNat_rounded]
          exact Nat.le_trans (Nat.min_le_right _ _) capped
      omega
  · rcases updatedEffectiveBalance_cases updated with rfl | rfl
    · exact Nat.le_max_left _ _
    · refine Nat.le_trans ?_ (Nat.le_max_right _ _)
      rw [Base.Uint64.toNat_min, toNat_rounded]
      by_cases small : balance.toNat ≤ capHigh
      · have funded' : balance.toNat ≤ ceil := by omega
        exact Nat.le_min.mpr ⟨Nat.le_trans (Nat.min_le_left _ _) (rounded_mono _ funded'),
          Nat.le_trans (Nat.min_le_right _ _) capped⟩
      · have ceilHigh : capHigh ≤ ceil := by omega
        have r := rounded_mono preset.EFFECTIVE_BALANCE_INCREMENT.toNat ceilHigh
        rw [alignedHigh, Nat.sub_zero] at r
        exact Nat.le_min.mpr ⟨Nat.le_trans (Nat.le_trans (Nat.min_le_right _ _) capped) r,
          Nat.le_trans (Nat.min_le_right _ _) capped⟩

/-- One slot step keeps an upper bound on the effective balance, given the balance and cap after it.

The step either keeps the effective balance and the epoch.

Or it moves to a later epoch, and the effective balance is at most `ceil` plus the band. -/
private theorem effective_ceiling_slot {f : Fork} {s t : BeaconState preset f}
    (ok : advanceSlot config checks s = .ok t) (i ceil capHigh : ℕ)
    (inside : i < s.validators.data.size)
    (alignedHigh : capHigh % preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0)
    (old : effectiveAt ⟨f, s⟩ i ≤ capHigh)
    (funded : min (actualBalanceAt ⟨f, t⟩ i) capHigh ≤ ceil)
    (cap : ∀ v, t.validators.data[i]? = some v →
      (withdrawalMaxEffectiveBalance preset f v).toNat ≤ capHigh) :
    effectiveAt ⟨f, t⟩ i ≤ max (effectiveAt ⟨f, s⟩ i)
      (min (ceil - ceil % preset.EFFECTIVE_BALANCE_INCREMENT.toNat) capHigh) ∧
    ((effectiveAt ⟨f, t⟩ i = effectiveAt ⟨f, s⟩ i ∧
        (getCurrentEpoch t).toNat = (getCurrentEpoch s).toNat) ∨
      (effectiveAt ⟨f, t⟩ i ≤ ceil + preset.downwardBand ∧
        (getCurrentEpoch s).toNat < (getCurrentEpoch t).toNat)) := by
  obtain ⟨next, cached, epoched, sum, cache, edge, rfl⟩ := advanceSlot_ok ok
  obtain ⟨_, _, _, _, rfl⟩ := processSlot_ok cache
  rw [getCurrentEpoch_toNat, getCurrentEpoch_toNat]
  have cases : ∀ c : BeaconState preset f, epochIfLast config checks next c = .ok epoched →
      next % preset.SLOTS_PER_EPOCH = 0 ∧ processEpoch config checks c = .ok epoched ∨
      next % preset.SLOTS_PER_EPOCH ≠ 0 ∧ epoched = c := by
    intro c edge
    unfold epochIfLast at edge
    split at edge
    · exact .inl ⟨‹_›, edge⟩
    · exact .inr ⟨‹_›, (Except.ok.inj edge).symm⟩
  rcases cases _ edge with ⟨boundary, epoch⟩ | ⟨inner, rfl⟩
  · obtain ⟨before, after, kept, updated, validators, balances⟩ := balanceDrift_epoch epoch
    have insideTail : i < epoched.validators.data.size := by
      have := (registryLifecycle_advanceSlot ok).size_le
      simpa using Nat.lt_of_lt_of_le inside this
    have insideBefore : i < before.validators.data.size := by
      rw [← (sameSizes_processEffectiveBalanceUpdates updated).1]
      rw [validators] at insideTail
      exact insideTail
    have bound := effective_ceiling_update updated i ceil capHigh insideBefore alignedHigh
      (by rw [kept i inside]; exact old)
      (by simpa only [actualBalanceAt, balances] using funded)
      (fun v read => cap v (by rw [validators]; exact read))
    have e := nextSlot_epoch_of_boundary sum boundary
    refine ⟨?_, .inr ⟨?_, ?_⟩⟩
    · have := bound.2
      rw [kept i inside] at this
      simpa only [effectiveAt, validators] using this
    · simpa only [effectiveAt, validators] using bound.1
    · simp only
      omega
  · refine ⟨?_, .inl ⟨rfl, ?_⟩⟩
    · exact Nat.le_max_left _ _
    · simp only
      rw [nextSlot_epoch_of_inside sum inner]

section Rewards

open DirectSafety PinKeys

/-! ### One key's reward in an epoch pass -/

/-- The epoch-pass reward credits to the key in one step.

A slot step's events are those of its epoch pass and its upgrades.

So its `.rewards` events are the epoch's rewards.

A block step has none counted: its proposer credits are charged elsewhere. -/
private def epochRewards (v : ℕ) {x y : ForkedBeaconState preset}
    (step : Step config checks x y) : ℕ :=
  match step with
  | .slot ok =>
    ((((Step.slot (config := config) (checks := checks) ok).balanceEvents.toOption.getD []).filter
      (·.source = .rewards)).map (keyCredit v)).sum
  | .block .. => 0

/-- The reward credits of a list of events are those of the events, read at one position. -/
private theorem sum_filter_rewards (events : List (BalanceEvent preset)) (v : ℕ) :
    ((events.filter (·.source = .rewards)).map (keyCredit v)).sum =
      (events.map (DirectSafety.Apriori.Internal.rewardCredit v)).sum := by
  induction events with
  | nil => rfl
  | cons e rest ih =>
    by_cases rewards : e.source = .rewards
    · simp [rewards, keyCredit, DirectSafety.Apriori.Internal.rewardCredit, ih]
    · simp [rewards, DirectSafety.Apriori.Internal.rewardCredit, ih]

/-- A flag pays a key at most its base reward times the weight of the flag, over the active stake.

The increments that set the flag in the previous epoch are at most those active then.

The rate read there is at most `P` times the active increments.

A key that is not active in the previous epoch earns nothing, so it needs no rate.

That is also stated outright, as its reward being 0. -/
private theorem flagReward_le {f : Fork} (altair : .altair ≤ f) {state : BeaconState preset f}
    (within : state.RegistryWithinLimit) {flag : Fin PARTICIPATION_FLAG_WEIGHTS.length}
    {rewards penalties : Array Gwei}
    (computed : getFlagIndexDeltas state altair flag = .ok (rewards, penalties))
    {total : Gwei} (active : getTotalActiveBalance state = .ok total) (P v : ℕ)
    (inside : v < state.validators.data.size)
    (rate : v.toUInt64 ∉ getActiveValidatorIndices state (getPreviousEpoch state) ∨
      ∀ perIncrement : Gwei, getBaseRewardPerIncrement preset total = .ok perIncrement →
        perIncrement.toNat *
            ((∑ i ∈ (getActiveValidatorIndices state (getPreviousEpoch state)).toFinset,
              balanceAt state i.toNat) / preset.EFFECTIVE_BALANCE_INCREMENT.toNat) ≤
          P * (total.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat)) :
    (rewards.getD v 0).toNat *
        (total.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat * WEIGHT_DENOMINATOR.toNat) ≤
      balanceAt state v / preset.EFFECTIVE_BALANCE_INCREMENT.toNat *
        PARTICIPATION_FLAG_WEIGHTS[flag].toNat *
        (P * (total.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat)) ∧
    (total.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0 →
      (rewards.getD v 0).toNat = 0) ∧
    (v.toUInt64 ∉ getActiveValidatorIndices state (getPreviousEpoch state) →
      (rewards.getD v 0).toNat = 0) := by
  obtain ⟨participating, participatingBalance, total', flaggedOk, weighed, totalOk, perKey⟩ :=
    getFlagIndexDeltas_getD within computed
  obtain rfl : total = total' := Except.ok.inj (active.symm.trans totalOk)
  obtain ⟨eligible, -, notEligible, eligibleCase⟩ := perKey v inside
  have zero (h : (rewards.getD v 0).toNat = 0) :
      (rewards.getD v 0).toNat *
        (total.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat * WEIGHT_DENOMINATOR.toNat) ≤
      balanceAt state v / preset.EFFECTIVE_BALANCE_INCREMENT.toNat *
        PARTICIPATION_FLAG_WEIGHTS[flag].toNat *
        (P * (total.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat)) ∧
      (total.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0 →
        (rewards.getD v 0).toNat = 0) ∧
      (v.toUInt64 ∉ getActiveValidatorIndices state (getPreviousEpoch state) →
        (rewards.getD v 0).toNat = 0) :=
    ⟨by rw [h, Nat.zero_mul]; exact Nat.zero_le _, fun _ => h, fun _ => h⟩
  by_cases isEligible : eligible = true
  swap
  · exact zero (by simp [(notEligible (by simpa using isEligible)).1])
  obtain ⟨base, baseOk, member⟩ := eligibleCase isEligible
  by_cases present : v.toUInt64 ∈ participating
  swap
  · exact zero (by simp [(member.2 present).1])
  have rate := rate.resolve_left fun idle =>
    idle (mem_getUnslashedParticipatingIndices flaggedOk _ present).1
  obtain ⟨leak, leakOk, formula, -⟩ := member.1 present
  cases leak
  swap
  · simp only [↓reduceIte] at formula
    exact zero formula
  simp only [Bool.false_eq_true, ↓reduceIte] at formula
  have index : v.toUInt64.toNat = v := toNat_toUInt64_of_lt within inside
  obtain ⟨per, perOk⟩ : ∃ per, getBaseRewardPerIncrement preset total = .ok per := by
    simp only [getBaseReward, altair, ↓reduceIte, bind_ok_iff] at baseOk
    obtain ⟨_, -, per, perOk, -⟩ := baseOk
    exact ⟨per, perOk⟩
  obtain ⟨validator, found, baseEq⟩ := getBaseReward_eq_mul_of_altair altair perOk baseOk
  rw [index] at found
  have stakeV : balanceAt state v = validator.effectiveBalance.toNat := by
    simp [balanceAt, found]
  have increments : (rewards.getD v 0).toNat *
      (total.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat * WEIGHT_DENOMINATOR.toNat) ≤
      base.toNat * PARTICIPATION_FLAG_WEIGHTS[flag].toNat *
        (participatingBalance.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat) := by
    rw [formula]
    exact Nat.div_mul_le_self _ _
  refine ⟨?_, fun none => by rw [formula, none, Nat.zero_mul, Nat.div_zero],
    fun idle => absurd (mem_getUnslashedParticipatingIndices flaggedOk _ present).1 idle⟩
  -- A key with less than one increment has no base reward.
  by_cases small : balanceAt state v / preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0
  · have noBase : base.toNat = 0 := by rw [baseEq, ← stakeV, small, Nat.zero_mul]
    rw [noBase, Nat.zero_mul, Nat.zero_mul] at increments
    rw [small, Nat.zero_mul, Nat.zero_mul]
    exact increments
  -- The key sets the flag and is active in the previous epoch, so both stakes hold its balance.
  have stakeParticipating : balanceAt state v ≤
      ∑ i ∈ participating.toFinset, balanceAt state i.toNat := by
    have := Finset.single_le_sum (f := fun i : ValidatorIndex => balanceAt state i.toNat)
      (fun _ _ => Nat.zero_le _) (List.mem_toFinset.mpr present)
    simpa only [index] using this
  have subset : ∑ i ∈ participating.toFinset, balanceAt state i.toNat ≤
      ∑ i ∈ (getActiveValidatorIndices state (getPreviousEpoch state)).toFinset,
        balanceAt state i.toNat :=
    Finset.sum_le_sum_of_subset fun i member =>
      List.mem_toFinset.mpr (mem_getUnslashedParticipatingIndices flaggedOk i
        (List.mem_toFinset.mp member)).1
  obtain ⟨-, -, balanceEq⟩ := getTotalBalance_ok_iff_stake.mp weighed
  have positive : 0 < balanceAt state v / preset.EFFECTIVE_BALANCE_INCREMENT.toNat :=
    Nat.pos_of_ne_zero small
  have incPos : 0 < preset.EFFECTIVE_BALANCE_INCREMENT.toNat := by
    refine Nat.pos_of_ne_zero fun zero => ?_
    rw [zero, Nat.div_zero] at positive
    exact Nat.lt_irrefl _ positive
  have one : 1 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤ balanceAt state v :=
    (Nat.le_div_iff_mul_le incPos).mp positive
  rw [Nat.one_mul] at one
  have participatingLe : participatingBalance.toNat ≤
      ∑ i ∈ (getActiveValidatorIndices state (getPreviousEpoch state)).toFinset,
        balanceAt state i.toNat := by
    rw [balanceEq]
    exact max_le (Nat.le_trans (Nat.le_trans one stakeParticipating) subset) subset
  have share : participatingBalance.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤
      (∑ i ∈ (getActiveValidatorIndices state (getPreviousEpoch state)).toFinset,
        balanceAt state i.toNat) / preset.EFFECTIVE_BALANCE_INCREMENT.toNat :=
    Nat.div_le_div_right participatingLe
  have bound := rate per perOk
  calc (rewards.getD v 0).toNat *
        (total.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat * WEIGHT_DENOMINATOR.toNat)
      ≤ base.toNat * PARTICIPATION_FLAG_WEIGHTS[flag].toNat *
        (participatingBalance.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat) := increments
    _ ≤ base.toNat * PARTICIPATION_FLAG_WEIGHTS[flag].toNat *
        ((∑ i ∈ (getActiveValidatorIndices state (getPreviousEpoch state)).toFinset,
          balanceAt state i.toNat) / preset.EFFECTIVE_BALANCE_INCREMENT.toNat) :=
        Nat.mul_le_mul_left _ share
    _ = balanceAt state v / preset.EFFECTIVE_BALANCE_INCREMENT.toNat *
        PARTICIPATION_FLAG_WEIGHTS[flag].toNat *
        (per.toNat * ((∑ i ∈ (getActiveValidatorIndices state (getPreviousEpoch state)).toFinset,
          balanceAt state i.toNat) / preset.EFFECTIVE_BALANCE_INCREMENT.toNat)) := by
        rw [baseEq, stakeV]
        ring
    _ ≤ balanceAt state v / preset.EFFECTIVE_BALANCE_INCREMENT.toNat *
        PARTICIPATION_FLAG_WEIGHTS[flag].toNat *
        (P * (total.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat)) :=
        Nat.mul_le_mul_left _ bound

/-- The three flags pay a key, in a rewards replay of a state, at most its stake times `P`.

The credit is scaled by `64` and by the active increments.

It is at most the key's increments times `54`, `P` and the active increments.

A state with no active increment pays nothing.

A key that is not active in the previous epoch is paid nothing. -/
private theorem replayRewards_credit_le {f : Fork} (altair : .altair ≤ f)
    {pass : BeaconState preset f} (within : pass.RegistryWithinLimit)
    {rewarded : BalanceReplay preset f}
    (replayed : replayRewards (config := config) (pass, []) = .ok rewarded) (P v : ℕ)
    (inside : v < pass.validators.data.size)
    (rate : v.toUInt64 ∉ getActiveValidatorIndices pass (getPreviousEpoch pass) ∨
      ∀ total perIncrement : Gwei, getTotalActiveBalance pass = .ok total →
        getBaseRewardPerIncrement preset total = .ok perIncrement →
        perIncrement.toNat *
            ((∑ i ∈ (getActiveValidatorIndices pass (getPreviousEpoch pass)).toFinset,
              balanceAt pass i.toNat) / preset.EFFECTIVE_BALANCE_INCREMENT.toNat) ≤
          P * (total.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat)) :
    (rewarded.2.map (DirectSafety.Apriori.Internal.rewardCredit v)).sum = 0 ∨
      ∃ total : Gwei,
        (rewarded.2.map (DirectSafety.Apriori.Internal.rewardCredit v)).sum *
            (total.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat * 64) ≤
          balanceAt pass v / preset.EFFECTIVE_BALANCE_INCREMENT.toNat * 54 *
            (P * (total.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat)) ∧
        (total.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0 →
          (rewarded.2.map (DirectSafety.Apriori.Internal.rewardCredit v)).sum = 0) ∧
        (v.toUInt64 ∉ getActiveValidatorIndices pass (getPreviousEpoch pass) →
          (rewarded.2.map (DirectSafety.Apriori.Internal.rewardCredit v)).sum = 0) := by
  by_cases genesis : getCurrentEpoch pass = GENESIS_EPOCH
  · simp only [replayRewards, genesis, ↓reduceIte, pure, Except.pure, Except.ok.injEq] at replayed
    subst replayed
    exact .inl rfl
  obtain ⟨source, target, head, inactivity, first, second, third, sourceOk, targetOk, headOk,
    inactivityOk, firstOk, secondOk, thirdOk, last⟩ :=
    DirectSafety.Apriori.Internal.replayRewards_passes altair genesis replayed
  obtain ⟨-, -, total, -, -, active, -⟩ := getFlagIndexDeltas_getD within sourceOk
  have wd : WEIGHT_DENOMINATOR.toNat = 64 := by decide
  have flagBound (flag : Fin PARTICIPATION_FLAG_WEIGHTS.length) {deltas : Array Gwei × Array Gwei}
      (computed : getFlagIndexDeltas pass altair flag = .ok deltas) :=
    flagReward_le altair within (flag := flag) (rewards := deltas.1) (penalties := deltas.2)
      computed active P v inside (rate.imp_right fun rate per perOk => rate total per active perOk)
  have one := flagBound ⟨0, by decide⟩ sourceOk
  have two := flagBound ⟨1, by decide⟩ targetOk
  have three := flagBound ⟨2, by decide⟩ headOk
  have flows (deltas : Array Gwei × Array Gwei) {pre post : BalanceReplay preset f}
      (src : BalanceSource) (ok : replayDeltas src deltas pre = .ok post) :=
    (DirectSafety.Apriori.Internal.replayDeltas_flows src deltas ok v).2
  have s1 := flows source .penalties firstOk
  have s2 := flows target .penalties secondOk
  have s3 := flows head .penalties thirdOk
  have s4 := flows inactivity .inactivity last
  have noReward : (inactivity.1.getD v 0).toNat = 0 := by
    simp [getInactivityPenaltyDeltas_rewards inactivityOk]
  simp only [List.map_nil, List.sum_nil, Nat.zero_add] at s1
  have weights : PARTICIPATION_FLAG_WEIGHTS[(⟨0, by decide⟩ : Fin 3)].toNat +
      PARTICIPATION_FLAG_WEIGHTS[(⟨1, by decide⟩ : Fin 3)].toNat +
      PARTICIPATION_FLAG_WEIGHTS[(⟨2, by decide⟩ : Fin 3)].toNat = 54 := rfl
  have sum : (rewarded.2.map (DirectSafety.Apriori.Internal.rewardCredit v)).sum ≤
      (source.1.getD v 0).toNat + (target.1.getD v 0).toNat + (head.1.getD v 0).toNat := by
    omega
  rw [wd] at one two three
  obtain ⟨b1, z1, i1⟩ := one
  obtain ⟨b2, z2, i2⟩ := two
  obtain ⟨b3, z3, i3⟩ := three
  refine .inr ⟨total, ?_, fun none => ?_, fun idle => ?_⟩
  · have scaled := Nat.mul_le_mul_right
      (total.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat * 64) sum
    simp only [Nat.add_mul] at scaled
    rw [← weights]
    simp only [Nat.mul_add, Nat.add_mul]
    omega
  · have := z1 none
    have := z2 none
    have := z3 none
    omega
  · have := i1 idle
    have := i2 idle
    have := i3 idle
    omega

/-- Quotients of the reward bound: the rewards of a pass are at most a rate for each increment. -/
private theorem reward_sum_le (S A K Ke P : ℕ)
    (bound : S * (A * 64) ≤ K * 54 * (P * A)) (none : A = 0 → S = 0) (small : K ≤ Ke) :
    S ≤ Ke * P * 54 / 64 := by
  by_cases zero : A = 0
  · rw [none zero]
    exact Nat.zero_le _
  have positive : 0 < A := Nat.pos_of_ne_zero zero
  have times : S * 64 * A ≤ K * 54 * P * A := by
    calc S * 64 * A = S * (A * 64) := by ring
      _ ≤ K * 54 * (P * A) := bound
      _ = K * 54 * P * A := by ring
  have cancelled : S * 64 ≤ K * 54 * P := Nat.le_of_mul_le_mul_right times positive
  rw [Nat.le_div_iff_mul_le (by decide : 0 < 64)]
  calc S * 64 ≤ K * 54 * P := cancelled
    _ ≤ Ke * 54 * P := Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ small)
    _ = Ke * P * 54 := by ring

/-- The rewards replay credits no key past the registry.

It records an increase or a decrease at an index that the registry holds, and keeps its sizes. -/
private theorem replayRewards_absent {f : Fork} {pass : BeaconState preset f}
    {rewarded : BalanceReplay preset f}
    (replayed : replayRewards (config := config) (pass, []) = .ok rewarded)
    (matched : BalancesMatch pass) {v : ℕ} (outside : pass.validators.data.size ≤ v) :
    (rewarded.2.map (DirectSafety.Apriori.Internal.rewardCredit v)).sum = 0 := by
  have final := replayRewards_induction (config := config)
    (fun pre : BalanceReplay preset f => BalancesMatch pre.1 ∧
      pre.1.validators = pass.validators ∧
        (pre.2.map (DirectSafety.Apriori.Internal.rewardCredit v)).sum = 0)
    (fun {pre post index reward} held ok => by
      simp only [recordBalance, bind_ok_iff, pure, Except.pure, Except.ok.injEq] at ok
      obtain ⟨_, _, after, actionOk, rfl⟩ := ok
      have increased := liftAccessor_ok.mp actionOk
      have same := sameSizes_increaseBalance increased
      have registry := increaseBalance_validators increased
      obtain ⟨preMatched, preSame, preSum⟩ := held
      have preSize : pre.1.balances.data.size ≤ v := by
        unfold BalancesMatch at preMatched
        rw [preMatched, preSame]
        exact outside
      refine ⟨balancesMatch_of_sameSizes same preMatched, registry.trans preSame, ?_⟩
      simp only [List.map_append, List.sum_append, List.map_cons, List.map_nil, List.sum_cons,
        List.sum_nil, preSum, DirectSafety.Apriori.Internal.rewardCredit, ↓reduceIte,
        actualBalanceAt, Array.getElem?_eq_none preSize,
        Array.getElem?_eq_none (show after.balances.data.size ≤ v by rw [same.2]; exact preSize),
        Option.map_none,
        Option.getD_none, Nat.sub_self, Nat.add_zero])
    (fun {source pre post index penalty} sourceCases held ok => by
      simp only [recordBalance, bind_ok_iff, pure, Except.pure, Except.ok.injEq] at ok
      obtain ⟨_, _, after, actionOk, rfl⟩ := ok
      have decreased := liftAccessor_ok.mp actionOk
      have same := sameSizes_decreaseBalance decreased
      have registry := decreaseBalance_validators decreased
      obtain ⟨preMatched, preSame, preSum⟩ := held
      refine ⟨balancesMatch_of_sameSizes same preMatched, registry.trans preSame, ?_⟩
      rcases sourceCases with rfl | rfl <;>
        simp [List.map_append, List.sum_append, preSum,
          DirectSafety.Apriori.Internal.rewardCredit])
    ⟨matched, rfl, rfl⟩ replayed
  exact final.2.2

open DirectSafety.Apriori.Internal in
/-- One key's rewards credit in a step is at most a rate for each epoch that the step ends.

The step is a slot, and it ends an epoch exactly when it runs the epoch's pass.

The key's stake at the start is at most `E`.

`P` bounds the rate read at the active stake, scaled by the previous epoch's share of it.

A key past the registry of a state with matched balances gets no reward. -/
private theorem epochRewards_le {m n : ForkedBeaconState preset}
    (step : Step config checks m n) (altair : .altair ≤ m.fork) (early : n.fork < .glamsterdam)
    (v : ℕ) (known : v < m.state.validators.data.size ∨ BalancesMatch m.state) (E P : ℕ)
    (envelope : v.toUInt64 ∉ getActiveValidatorIndices m.state (getPreviousEpoch m.state) ∨
      effectiveAt m v ≤ E)
    (rate : v.toUInt64 ∉ getActiveValidatorIndices m.state (getPreviousEpoch m.state) ∨
      ∀ total perIncrement : Gwei, getTotalActiveBalance m.state = .ok total →
        getBaseRewardPerIncrement preset total = .ok perIncrement →
        perIncrement.toNat *
            ((∑ i ∈ (getActiveValidatorIndices m.state (getPreviousEpoch m.state)).toFinset,
              effectiveAt m i.toNat) / preset.EFFECTIVE_BALANCE_INCREMENT.toNat) ≤
          P * (total.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat)) :
    epochRewards v step ≤ ((getCurrentEpoch n.state).toNat - (getCurrentEpoch m.state).toNat) *
      (E / preset.EFFECTIVE_BALANCE_INCREMENT.toNat * P *
        (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum / WEIGHT_DENOMINATOR.toNat) := by
  cases step with
  | block engine signed due ok => simp [epochRewards]
  | slot ok =>
    have mEarly : m.fork < .glamsterdam :=
      Nat.lt_of_le_of_lt (Step.slot ok).chainStep.fork_le early
    simp only [epochRewards]
    cases hev : (Step.slot (config := config) (checks := checks) ok).balanceEvents with
    | error err => simp [Except.toOption]
    | ok events =>
      simp only [Except.toOption, Option.getD_some]
      rw [sum_filter_rewards]
      obtain ⟨advanced, cached, crossings, -, upgrades, cachedOk, crossingOk, kind⟩ :=
        Step.balanceEvents_slot ok early hev
      have crossed := upgradeBalanceReplay_crossing crossingOk
      have crossingsQuiet : (crossings.map (rewardCredit v)).sum = 0 :=
        List.sum_eq_zero fun x member => by
          obtain ⟨e, mem, rfl⟩ := List.mem_map.mp member
          simp [rewardCredit, crossed e mem]
      rcases kind with ⟨-, eventsEq⟩ |
        ⟨middle, updated, recorded, recordOk, -, -, -, eventsEq, next, nextEq, advSlot, last, -⟩
      · subst eventsEq
        rw [crossingsQuiet]
        exact Nat.zero_le _
      subst eventsEq
      obtain ⟨just, pass, rewarded, later, justified, scored, rewardedOk, recordedEq,
        laterSources, -⟩ := epochReplay_events altair (epochBalanceReplay_trace recordOk)
      simp only at recordedEq
      subst recordedEq
      have laterQuiet : (later.map (rewardCredit v)).sum = 0 :=
        List.sum_eq_zero fun x member => by
          obtain ⟨e, mem, rfl⟩ := List.mem_map.mp member
          rcases laterSources e mem with s | s | s <;> simp [rewardCredit, s]
      simp only [List.map_append, List.sum_append, laterQuiet, crossingsQuiet, Nat.add_zero]
      -- The slot ends one epoch.
      have nSlot : n.state.slot = next := (processUpgrades_slot upgrades).trans advSlot
      have epochs : (getCurrentEpoch n.state).toNat - (getCurrentEpoch m.state).toNat = 1 := by
        have boundary := nextSlot_epoch_of_boundary nextEq last
        rw [getCurrentEpoch_toNat, getCurrentEpoch_toNat, nSlot, boundary]
        exact Nat.add_sub_cancel_left _ _
      rw [epochs, Nat.one_mul]
      -- The pass reads the registry and the epoch of the start.
      obtain ⟨-, effectiveEq, -, validatorsEq, slotEq⟩ :=
        pass_kept_of_effective (config := config) (checks := checks)
          (inner := (Run.nil : Run config checks m m)) (effectiveKept_refl m.state) rfl
          cachedOk justified scored
      -- A key past the registry gets no reward, as the replay keeps the sizes of the balances.
      by_cases inside : v < m.state.validators.data.size
      swap
      · have matched := known.resolve_left inside
        have passBalances : pass.balances = m.state.balances := by
          have first := justified.records ⟨nofun, nofun, nofun, nofun, nofun, nofun⟩
          have second := scored.records ⟨nofun, nofun, nofun, nofun, nofun, nofun⟩
          obtain ⟨_, _, _, _, rfl⟩ := processSlot_ok cachedOk
          exact second.2.1.trans first.2.1
        rw [replayRewards_absent rewardedOk (by
          unfold BalancesMatch at matched ⊢
          rw [passBalances, validatorsEq]
          exact matched) (by rw [validatorsEq]; omega)]
        exact Nat.zero_le _
      have within : pass.RegistryWithinLimit := pass.validators.bound mEarly
      have insidePass : v < pass.validators.data.size := by
        rw [validatorsEq]
        exact inside
      have balanceAtEq (i : ℕ) : balanceAt pass i = effectiveAt m i := by
        simp [balanceAt, effectiveAt, validatorsEq]
      have totalEq : getTotalActiveBalance pass = getTotalActiveBalance m.state := by
        simp only [getTotalActiveBalance, getActiveValidatorIndicesChecked, getCurrentEpoch,
          slotEq, validatorsEq, getTotalBalance]
        rfl
      have prevEpoch : getPreviousEpoch pass = getPreviousEpoch m.state := by
        simp only [getPreviousEpoch, getCurrentEpoch, slotEq]
      have prevEq : getActiveValidatorIndices pass (getPreviousEpoch pass) =
          getActiveValidatorIndices m.state (getPreviousEpoch m.state) := by
        rw [prevEpoch]
        simp only [getActiveValidatorIndices, validatorsEq]
      have ratePass : v.toUInt64 ∉ getActiveValidatorIndices pass (getPreviousEpoch pass) ∨
          ∀ total perIncrement : Gwei, getTotalActiveBalance pass = .ok total →
            getBaseRewardPerIncrement preset total = .ok perIncrement →
            perIncrement.toNat *
                ((∑ i ∈ (getActiveValidatorIndices pass (getPreviousEpoch pass)).toFinset,
                  balanceAt pass i.toNat) / preset.EFFECTIVE_BALANCE_INCREMENT.toNat) ≤
              P * (total.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat) := by
        rw [prevEq]
        refine rate.imp_right fun rate total perIncrement totalOk perOk => ?_
        have sums : (∑ i ∈ (getActiveValidatorIndices m.state (getPreviousEpoch m.state)).toFinset,
            balanceAt pass i.toNat) =
            ∑ i ∈ (getActiveValidatorIndices m.state (getPreviousEpoch m.state)).toFinset,
              effectiveAt m i.toNat :=
          Finset.sum_congr rfl fun i _ => balanceAtEq i.toNat
        rw [sums]
        exact rate total perIncrement (totalEq.symm.trans totalOk) perOk
      have bound := replayRewards_credit_le altair within rewardedOk P v insidePass ratePass
      have flagSum : (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum = 54 := rfl
      have wd : WEIGHT_DENOMINATOR.toNat = 64 := by decide
      rw [flagSum, wd]
      rcases bound with zero | ⟨total, scaled, none, idle⟩
      · rw [zero]
        exact Nat.zero_le _
      rcases envelope with inactive | envelope
      · rw [idle (by rw [prevEq]; exact inactive)]
        exact Nat.zero_le _
      · exact reward_sum_le _ _ _ _ P scaled none (Nat.div_le_div_right (by
          rw [balanceAtEq]
          exact envelope))

/-- A step raises the balance of a key by at most the credits of its events. -/
private theorem step_balance_le_events {m n : ForkedBeaconState preset}
    (step : Step config checks m n) (early : n.fork < .glamsterdam) (i : ℕ)
    {events : List (BalanceEvent preset)} (ok : step.balanceEvents = .ok events) :
    actualBalanceAt n i ≤ actualBalanceAt m i + (events.map (keyCredit i)).sum := by
  have run := DirectSafety.Apriori.Internal.single_balanceEvents step ok
  have cover := coverage_run (Run.nil.snoc step) early (getCurrentEpoch n.state).toNat
    (Nat.le_succ _) run false i
  have ends := Run.balancePath_ends (Run.nil.snoc step)
  have rise := Apriori.Internal.balance_le_pathCredits i _ m n ends.1 ends.2
  simp only [coveragePath, Bool.false_eq_true, ↓reduceIte, coverageDelta] at cover
  exact le_trans rise (Nat.add_le_add_left cover _)

/-- A step raises the balance of a key by at most its epoch rewards and its other credits.

A block step counts the rise of the key's balance across the whole step.

A slot step counts the credits of its events from the sources other than the epoch rewards. -/
private theorem step_balance_le {m n : ForkedBeaconState preset} (step : Step config checks m n)
    (early : n.fork < .glamsterdam) (i : ℕ) :
    actualBalanceAt n i ≤ actualBalanceAt m i + epochRewards i step +
      stepNet i step + stepCredit (fun _ => false) (fun s => decide (s ≠ .rewards)) i step := by
  cases step with
  | block engine signed due okb =>
    simp only [epochRewards, stepNet]
    omega
  | slot oks =>
    obtain ⟨events, ok⟩ := (Step.slot oks : Step config checks m n).balanceEvents_ok early
    have base := step_balance_le_events (Step.slot oks : Step config checks m n) early i ok
    simp only [epochRewards, stepNet, stepCredit, ok, Except.toOption, Option.getD_some] at base ⊢
    have split := List.sum_map_filter_add_sum_map_filter_not
      (fun e : BalanceEvent preset => e.source = .rewards) (keyCredit i) events
    simp only [ne_eq] at split ⊢
    omega

/-- The bound on a key's balance below a cap along a run.

It is the start, the epoch rewards and the other credits.

The start and the balance count only up to the cap.

The epoch rewards are those of the epochs that the run ends, at the rate given by `E` and `P`.

The other credits are the net rises of its block steps and the credits of its slot steps.

The slot-step credits leave out the epoch rewards. -/
private def creditBound {x y : ForkedBeaconState preset} (tail : Run config checks x y)
    (i high E P capHigh : ℕ) : ℕ :=
  min (actualBalanceAt x i) capHigh +
    ((getCurrentEpoch y.state).toNat - (getCurrentEpoch x.state).toNat) *
      (E / preset.EFFECTIVE_BALANCE_INCREMENT.toNat * P *
        (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum / WEIGHT_DENOMINATOR.toNat) +
    netScan i high tail +
      (creditScan (fun _ => false) (fun s => decide (s ≠ .rewards)) i high tail)

end Rewards

/-- A balance ceiling, an envelope or a floor on a key's balance bounds its effective balance.

First, suppose a key's balance stays at least `floor` at every state of the run.

Suppose also that its cap stays at least `capLow`.

Then its effective balance at the end is at least the least of three values.

They are its effective balance at the start, `capLow`, and `floor` rounded down to an increment.

Second, suppose the effective balance at the start is a whole number of increments.

Suppose a step that could lower it leaves a balance of at least that effective balance.

A step could lower it when the balance after it plus the downward band is below it.

Suppose also that its cap stays at least its effective balance at the start.

Then the effective balance at the end is at least that at the start.

A downward update sets it to the balance rounded down.

That is at least the effective balance at the start, which is a whole number of increments.

An update moves the effective balance only at an epoch's first slot.

It moves it down to the balance rounded to an increment, and up to at most the cap.

It never moves it up below where it was.

Third, suppose the smaller of the balance and `capHigh` stays at most `ceil`.

Suppose also that the cap stays at most `capHigh`.

The bound `capHigh` is a whole number of increments.

The effective balance at the start is at most `capHigh`.

Then the effective balance at the end is at most the greater of two values.

They are its effective balance at the start, and the ceiling rounded down, at most the cap.

If no epoch boundary is crossed, it is the effective balance at the start.

After a boundary, it is at most `ceil` plus the downward band.

The epoch never moves back.

Fourth, suppose the cap stays at most `capHigh`, as in the third.

Suppose the rate of the rewards at every state is at most `P`.

Suppose also that the run ends by the epoch `high + 1`.

Suppose also that `E` is at least the greatest effective balance that the bound below allows.

Then the balance at every state is at most its start, plus the epoch rewards at the rate of `E`.

It also adds the other credits that the events of the run give the key. -/
private theorem Run.effective_floor_pair {x y : ForkedBeaconState preset}
    (tail : Run config checks x y) (early : y.fork < .glamsterdam) (fulu : .fusaka ≤ x.fork)
    (i : ℕ) (inside : i < x.state.validators.data.size)
    (floor capLow capHigh high E P : ℕ) :
    ((∀ z ∈ tail.balancePath, floor ≤ actualBalanceAt z i) →
      (∀ z ∈ tail.balancePath, capLow ≤ PinTerms.capAt z i) →
      min (effectiveAt x i)
        (min capLow (floor - floor % preset.EFFECTIVE_BALANCE_INCREMENT.toNat)) ≤
          effectiveAt y i) ∧
    (effectiveAt x i % preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0 →
      (∀ {m n : ForkedBeaconState preset} (before : Run config checks x m)
          (step : Step config checks m n) (after : Run config checks n y),
        (before.snoc step).append after = tail →
        actualBalanceAt n i + preset.downwardBand < effectiveAt m i →
        effectiveAt x i ≤ actualBalanceAt n i) →
      (∀ z ∈ tail.balancePath, effectiveAt x i ≤ PinTerms.capAt z i) →
      effectiveAt x i ≤ effectiveAt y i) ∧
    (∀ ceil : ℕ, capHigh % preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0 →
      effectiveAt x i ≤ capHigh →
      (∀ z ∈ tail.balancePath, min (actualBalanceAt z i) capHigh ≤ ceil) →
      (∀ z ∈ tail.balancePath, PinTerms.capAt z i ≤ capHigh) →
      effectiveAt y i ≤ max (effectiveAt x i)
        (min (ceil - ceil % preset.EFFECTIVE_BALANCE_INCREMENT.toNat) capHigh) ∧
      ((getCurrentEpoch y.state).toNat ≤ (getCurrentEpoch x.state).toNat →
        effectiveAt y i = effectiveAt x i) ∧
      ((getCurrentEpoch x.state).toNat < (getCurrentEpoch y.state).toNat →
        effectiveAt y i ≤ ceil + preset.downwardBand) ∧
      (getCurrentEpoch x.state).toNat ≤ (getCurrentEpoch y.state).toNat) ∧
    (capHigh % preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0 → effectiveAt x i ≤ capHigh →
      (∀ z ∈ tail.balancePath, PinTerms.capAt z i ≤ capHigh) →
      (∀ z ∈ tail.balancePath,
        i.toUInt64 ∉ getActiveValidatorIndices z.state (getPreviousEpoch z.state) ∨
        ∀ total perIncrement : Gwei,
          getTotalActiveBalance z.state = .ok total →
          getBaseRewardPerIncrement preset total = .ok perIncrement →
          perIncrement.toNat * ((∑ j ∈ (getActiveValidatorIndices z.state
            (getPreviousEpoch z.state)).toFinset, effectiveAt z j.toNat) /
              preset.EFFECTIVE_BALANCE_INCREMENT.toNat) ≤
            P * (total.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat)) →
      (getCurrentEpoch y.state).toNat ≤ high + 1 →
      max (effectiveAt x i) (min capHigh (creditBound tail i high E P capHigh -
        creditBound tail i high E P capHigh % preset.EFFECTIVE_BALANCE_INCREMENT.toNat)) ≤ E →
      ∀ z ∈ tail.balancePath, min (actualBalanceAt z i) capHigh ≤
        creditBound tail i high E P capHigh) := by
  induction tail with
  | nil => exact ⟨fun _ _ => Nat.min_le_left _ _, fun _ _ _ => Nat.le_refl _,
      fun _ _ _ _ _ => ⟨Nat.le_max_left _ _, fun _ => rfl, fun h => absurd h (Nat.lt_irrefl _),
        Nat.le_refl _⟩,
      fun _ _ _ _ _ _ z hz => by
        rw [Run.balancePath, List.mem_singleton] at hz
        subst hz
        simp [creditBound, PinKeys.netScan_nil, PinKeys.creditScan_nil]⟩
  | @snoc middle last pre step ih =>
    have middleEarly := Nat.lt_of_le_of_lt step.chainStep.fork_le early
    obtain ⟨ihFloor, ihEnvelope, ihCeiling, ihCredit⟩ := ih middleEarly
    have room : i < middle.state.validators.data.size :=
      Nat.lt_of_lt_of_le inside pre.registryLifecycle.size_le
    have atMiddle : middle ∈ pre.balancePath :=
      List.mem_of_mem_getLast? (Run.balancePath_ends pre).2
    have altair : .altair ≤ middle.fork :=
      Nat.le_trans (by decide) (Nat.le_trans fulu (fork_le_of_chainSteps pre.chainSteps))
    have key : capHigh % preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0 → effectiveAt x i ≤ capHigh →
        (∀ z ∈ (pre.snoc step).balancePath, PinTerms.capAt z i ≤ capHigh) →
        (∀ z ∈ (pre.snoc step).balancePath,
          i.toUInt64 ∉ getActiveValidatorIndices z.state (getPreviousEpoch z.state) ∨
          ∀ total perIncrement : Gwei,
            getTotalActiveBalance z.state = .ok total →
            getBaseRewardPerIncrement preset total = .ok perIncrement →
            perIncrement.toNat * ((∑ j ∈ (getActiveValidatorIndices z.state
              (getPreviousEpoch z.state)).toFinset, effectiveAt z j.toNat) /
                preset.EFFECTIVE_BALANCE_INCREMENT.toNat) ≤
              P * (total.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat)) →
        (getCurrentEpoch last.state).toNat ≤ high + 1 →
        max (effectiveAt x i) (min capHigh (creditBound (pre.snoc step) i high E P capHigh -
          creditBound (pre.snoc step) i high E P capHigh %
            preset.EFFECTIVE_BALANCE_INCREMENT.toNat)) ≤ E →
        (∀ z ∈ step.balancePath, z = middle ∨ z = last) →
        ∀ z ∈ (pre.snoc step).balancePath,
          min (actualBalanceAt z i) capHigh ≤ creditBound (pre.snoc step) i high E P capHigh := by
      intro alignedHigh startCap capC rate endEp closed pathCases z hz
      have xm : (getCurrentEpoch x.state).toNat ≤ (getCurrentEpoch middle.state).toNat :=
        UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps pre.chainSteps)
      have ml : (getCurrentEpoch middle.state).toNat ≤ (getCurrentEpoch last.state).toNat :=
        UInt64.le_iff_toNat_le.mp step.chainStep.currentEpoch_le
      have within : (getCurrentEpoch middle.state).toNat ≤ high + 1 := by omega
      have scan := PinKeys.creditScan_snoc (fun _ => false) (fun s => decide (s ≠ .rewards))
        i high pre step
      have net := PinKeys.netScan_snoc i high pre step
      simp only [within, ↓reduceIte] at scan net
      have tailEq : creditBound (pre.snoc step) i high E P capHigh =
          creditBound pre i high E P capHigh +
            ((getCurrentEpoch last.state).toNat - (getCurrentEpoch middle.state).toNat) *
              (E / preset.EFFECTIVE_BALANCE_INCREMENT.toNat * P *
                (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum / WEIGHT_DENOMINATOR.toNat) +
            (PinKeys.stepNet i step +
              PinKeys.stepCredit (fun _ => false) (fun s => decide (s ≠ .rewards)) i step) := by
        unfold creditBound
        rw [scan, net]
        generalize E / preset.EFFECTIVE_BALANCE_INCREMENT.toNat * P *
          (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum / WEIGHT_DENOMINATOR.toNat = G
        have split : ((getCurrentEpoch last.state).toNat - (getCurrentEpoch x.state).toNat) * G =
            ((getCurrentEpoch middle.state).toNat - (getCurrentEpoch x.state).toNat) * G +
              ((getCurrentEpoch last.state).toNat - (getCurrentEpoch middle.state).toNat) * G := by
          rw [← Nat.add_mul]
          congr 1
          omega
        rw [split]
        omega
      have closedPre : max (effectiveAt x i) (min capHigh (creditBound pre i high E P capHigh -
          creditBound pre i high E P capHigh % preset.EFFECTIVE_BALANCE_INCREMENT.toNat)) ≤ E :=
        le_trans (max_le_max le_rfl (min_le_min le_rfl (rounded_mono _ (by omega)))) closed
      have ihPre := ihCredit alignedHigh startCap
        (fun p member => capC p (List.mem_append_left _ member))
        (fun p member => rate p (List.mem_append_left _ member)) within closedPre
      rcases List.mem_append.mp hz with old | stepMember
      · exact (ihPre z old).trans (by omega)
      · rcases pathCases z stepMember with rfl | rfl
        · exact (ihPre _ atMiddle).trans (by omega)
        · have ceilings : ∀ p ∈ pre.balancePath,
              min (actualBalanceAt p i) capHigh ≤ creditBound (pre.snoc step) i high E P capHigh :=
            fun p member => (ihPre p member).trans (by omega)
          obtain ⟨c1, -, -, -⟩ := ihCeiling (creditBound (pre.snoc step) i high E P capHigh)
            alignedHigh startCap ceilings
            (fun p member => capC p (List.mem_append_left _ member))
          rw [Nat.min_comm] at c1
          have envelope : effectiveAt middle i ≤ E := c1.trans closed
          have rewards := epochRewards_le step altair early i (Or.inl room) E P (.inr envelope)
            (rate middle (List.mem_append_left _ atMiddle))
          have stepBound := step_balance_le step early i
          have mid := ihPre _ atMiddle
          rw [tailEq]
          omega
    cases step with
    | @block fork before after engine signed due ok =>
      have kept := effectiveKept_processBlock (applySignedBlock_ok ok).2.1 i room
      have epoch : (getCurrentEpoch after).toNat = (getCurrentEpoch before).toNat := by
        simp only [getCurrentEpoch, processBlock_slot (applySignedBlock_ok ok).2.1]
      refine ⟨fun balanceFloor capFloor => ?_, fun aligned downs capFloor => ?_,
        fun ceil alignedHigh startCap balanceCeil capCeil => ?_,
        fun alignedHigh startCap capC rate endEp closed =>
          key alignedHigh startCap capC rate endEp closed
            (fun z hz => by simpa [Step.balancePath] using hz)⟩
      · rw [kept]
        exact ihFloor (fun p member => balanceFloor p (List.mem_append_left _ member))
          (fun p member => capFloor p (List.mem_append_left _ member))
      · rw [kept]
        exact ihEnvelope aligned
          (fun r1 st r2 cut => downs r1 st (r2.snoc (Step.block engine signed due ok))
            (congrArg (fun r => Run.snoc r (Step.block engine signed due ok)) cut))
          (fun p member => capFloor p (List.mem_append_left _ member))
      · obtain ⟨c1, c2, c3, c4⟩ := ihCeiling ceil alignedHigh startCap
          (fun p member => balanceCeil p (List.mem_append_left _ member))
          (fun p member => capCeil p (List.mem_append_left _ member))
        simp only at epoch c2 c3 c4 ⊢
        rw [kept, epoch]
        exact ⟨c1, c2, c3, c4⟩
    | slot ok =>
      obtain ⟨next, advanced, upgraded⟩ := bind_ok_iff.mp ok
      have onPath : (⟨middle.fork, next⟩ : ForkedBeaconState preset) ∈
          (Step.slot ok).balancePath := by
        simp [Step.balancePath, advanced, Except.toOption]
      have fuluMiddle : Fork.fusaka ≤ middle.fork :=
        Nat.le_trans fulu (fork_le_of_chainSteps pre.chainSteps)
      have same := DirectSafety.Apriori.Internal.processUpgrades_eq_of_window upgraded
        fuluMiddle early
      subst same
      refine ⟨fun balanceFloor capFloor => ?_, fun aligned downs capFloor => ?_,
        fun ceil alignedHigh startCap balanceCeil capCeil => ?_,
        fun alignedHigh startCap capC rate endEp closed =>
          key alignedHigh startCap capC rate endEp closed
            (fun z hz => by simpa [Step.balancePath, advanced, Except.toOption] using hz)⟩
      · have funded := balanceFloor _ (List.mem_append_right _ onPath)
        have capped := capFloor _ (List.mem_append_right _ onPath)
        have prior := ihFloor (fun p member => balanceFloor p (List.mem_append_left _ member))
          (fun p member => capFloor p (List.mem_append_left _ member))
        refine effective_floor_slot advanced i capLow _ room
          (Nat.le_trans (Nat.min_le_right _ _) (Nat.min_le_left _ _)) (fun _ => ?_) prior
          (fun v read => by simpa [PinTerms.capAt, read] using capped)
        exact (Nat.min_le_right _ _).trans ((Nat.min_le_right _ _).trans (rounded_mono _ funded))
      · have capped := capFloor _ (List.mem_append_right _ onPath)
        have prior := ihEnvelope aligned
          (fun r1 st r2 cut => downs r1 st (r2.snoc (Step.slot ok))
            (congrArg (fun r => Run.snoc r (Step.slot ok)) cut))
          (fun p member => capFloor p (List.mem_append_left _ member))
        refine effective_floor_slot advanced i (PinTerms.capAt ⟨middle.fork, next⟩ i) _ room capped
          (fun fires => ?_) prior (fun v read => by simp [PinTerms.capAt, read])
        have eta : effectiveAt (⟨middle.fork, middle.state⟩ : ForkedBeaconState preset) i =
            effectiveAt middle i := rfl
        rw [eta] at fires
        have reach : effectiveAt x i ≤ actualBalanceAt ⟨middle.fork, next⟩ i := by
          rcases fires with below | above
          · exact downs pre (Step.slot ok) Run.nil rfl below
          · omega
        have lift := rounded_mono preset.EFFECTIVE_BALANCE_INCREMENT.toNat reach
        rw [aligned, Nat.sub_zero] at lift
        exact lift
      · have funded := balanceCeil _ (List.mem_append_right _ onPath)
        have capped := capCeil _ (List.mem_append_right _ onPath)
        obtain ⟨c1, c2, c3, c4⟩ := ihCeiling ceil alignedHigh startCap
          (fun p member => balanceCeil p (List.mem_append_left _ member))
          (fun p member => capCeil p (List.mem_append_left _ member))
        have oldHigh : effectiveAt (⟨middle.fork, middle.state⟩ : ForkedBeaconState preset) i ≤
            capHigh := by
          have eta : effectiveAt (⟨middle.fork, middle.state⟩ : ForkedBeaconState preset) i =
              effectiveAt middle i := rfl
          rw [eta]
          omega
        obtain ⟨d1, d2⟩ := effective_ceiling_slot advanced i ceil capHigh room alignedHigh oldHigh
          funded (fun v read => by simpa [PinTerms.capAt, read] using capped)
        simp only at c1 c2 c3 c4 d1 d2 ⊢
        have eta : effectiveAt (⟨middle.fork, middle.state⟩ : ForkedBeaconState preset) i =
            effectiveAt middle i := rfl
        rw [eta] at d1 d2
        generalize min (ceil - ceil % preset.EFFECTIVE_BALANCE_INCREMENT.toNat) capHigh = bound
          at c1 d1 ⊢
        rcases d2 with ⟨keep, same⟩ | ⟨rise, later⟩
        · refine ⟨by omega, fun h => ?_, fun h => ?_, by omega⟩
          · rw [keep]
            exact c2 (by omega)
          · rw [keep]
            exact c3 (by omega)
        · refine ⟨by omega, fun h => by omega, fun _ => rise, by omega⟩

/-- A balance floor and a cap floor along a run give an effective-balance floor, rounded.

Its effective balance at the end is at least the least of three values.

They are its effective balance at the start, `capLow`, and `floor` rounded down to an increment. -/
private theorem Run.effective_floor_rounded {x y : ForkedBeaconState preset}
    (tail : Run config checks x y) (early : y.fork < .glamsterdam) (fulu : .fusaka ≤ x.fork)
    (i : ℕ) (inside : i < x.state.validators.data.size) (floor capLow : ℕ)
    (balanceFloor : ∀ z ∈ tail.balancePath, floor ≤ actualBalanceAt z i)
    (capFloor : ∀ z ∈ tail.balancePath, capLow ≤ PinTerms.capAt z i) :
    min (effectiveAt x i) (min capLow (floor - floor % preset.EFFECTIVE_BALANCE_INCREMENT.toNat)) ≤
      effectiveAt y i :=
  (Run.effective_floor_pair tail early fulu i inside floor capLow 0 0 0 0).1 balanceFloor
    capFloor

/-- A balance floor and a cap floor along a run give an effective-balance floor.

Suppose a key's balance stays at least `floor` at every state of a run.

Suppose also that its cap stays at least `capLow`.

Then its effective balance at the end is at least the least of three values.

They are its effective balance at the start, `capLow`, and `floor` less one increment of rounding.

This follows from `Run.effective_floor_rounded`.

The floor rounded down to an increment is at least `floor + 1 - inc`. -/
private theorem Run.effective_floor_of_balance_floor {x y : ForkedBeaconState preset}
    (tail : Run config checks x y) (early : y.fork < .glamsterdam) (fulu : .fusaka ≤ x.fork)
    (incPos : 0 < preset.EFFECTIVE_BALANCE_INCREMENT.toNat) (i : ℕ)
    (inside : i < x.state.validators.data.size) (floor capLow : ℕ)
    (balanceFloor : ∀ z ∈ tail.balancePath, floor ≤ actualBalanceAt z i)
    (capFloor : ∀ z ∈ tail.balancePath, capLow ≤ PinTerms.capAt z i) :
    min (effectiveAt x i) (min capLow (floor + 1 - preset.EFFECTIVE_BALANCE_INCREMENT.toNat)) ≤
      effectiveAt y i := by
  have remainder := Nat.mod_lt floor incPos
  refine Nat.le_trans ?_
    (Run.effective_floor_rounded tail early fulu i inside floor capLow balanceFloor capFloor)
  omega

/-- A balance ceiling and a cap ceiling along a run give an effective-balance ceiling.

Suppose the smaller of a key's balance and `capHigh` stays at most `ceil` along a run.

Suppose also that its cap stays at most `capHigh`.

The bound `capHigh` is a whole number of increments.

The effective balance at the start is at most `capHigh`.

Then its effective balance at the end is at most the greater of two values.

They are its effective balance at the start, and the ceiling rounded down, at most the cap.

If no epoch boundary is crossed, it is the effective balance at the start.

After a boundary, it is at most `ceil` plus the downward band.

The epoch never moves back. -/
private theorem Run.effective_ceiling_of_balance_ceiling {x y : ForkedBeaconState preset}
    (tail : Run config checks x y) (early : y.fork < .glamsterdam) (fulu : .fusaka ≤ x.fork)
    (i : ℕ) (inside : i < x.state.validators.data.size) (ceil capHigh : ℕ)
    (alignedHigh : capHigh % preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0)
    (startCap : effectiveAt x i ≤ capHigh)
    (balanceCeil : ∀ z ∈ tail.balancePath, min (actualBalanceAt z i) capHigh ≤ ceil)
    (capCeil : ∀ z ∈ tail.balancePath, PinTerms.capAt z i ≤ capHigh) :
    effectiveAt y i ≤ max (effectiveAt x i)
      (min (ceil - ceil % preset.EFFECTIVE_BALANCE_INCREMENT.toNat) capHigh) ∧
    ((getCurrentEpoch y.state).toNat ≤ (getCurrentEpoch x.state).toNat →
      effectiveAt y i = effectiveAt x i) ∧
    ((getCurrentEpoch x.state).toNat < (getCurrentEpoch y.state).toNat →
      effectiveAt y i ≤ ceil + preset.downwardBand) ∧
    (getCurrentEpoch x.state).toNat ≤ (getCurrentEpoch y.state).toNat :=
  (Run.effective_floor_pair tail early fulu i inside 0 0 capHigh 0 0 0).2.2.1 ceil
    alignedHigh startCap balanceCeil capCeil

end PinKeyFloor

end

section

/-! ## The penalty rate of one key in a rewards pass -/

namespace PinKeyFloor

open Base Uint64 Models

variable {preset : Preset} {config : Config}

/-- One rewards pass debits a key at a state at a rate of at most the pin reserve's leak rate.

The rate is taken at the key's effective balance at the state.

`pulledTotal` is R's total read.

The `quarter` is a quarter of it from 18 increments, and a fifth of an increment below.

The reserve reads the base reward per increment at the quarter.

The state's total is at least two thirds of R's, so its square root is at least the quarter's.

The score bound `scoreBound` covers the pass's score after its update.

That score is the score plus one bias.

Effective balances are whole increments.

`roomy` makes the rounding of the per-increment reward lose less than its fraction.

The flag term is `40 / 64` of a base reward per increment for each increment.

It fits in `2 * (increments * perIncrement)`.

The floor of a quotient that is at least one is at least half of it. -/
private theorem passPenaltyRate_le_leak (z : ForkedBeaconState preset) (v : ℕ) (pulledTotal : ℕ)
    (scoreBound : ℕ) (facts : PinPresetFacts preset)
    (pulledFits : pulledTotal < 2 ^ 64)
    (aligned : preset.EFFECTIVE_BALANCE_INCREMENT.toNat ∣ effectiveAt z v)
    (band : 2 * pulledTotal ≤ 3 * activeBalanceTotal z.state)
    (scored : (if altair : .altair ≤ z.fork then
        (((z.state.inactivityScores altair).data[v]?).map (·.toNat)).getD 0 else 0) +
      config.INACTIVITY_SCORE_BIAS.toNat ≤ scoreBound) :
    let inc := preset.EFFECTIVE_BALANCE_INCREMENT.toNat
    let quarter := if 18 * inc ≤ pulledTotal then pulledTotal / 4 else inc / 5
    let perIncrement := inc * preset.BASE_REWARD_FACTOR.toNat / quarter.sqrt
    passPenaltyRate config z v ≤
      2 * (effectiveAt z v / inc * perIncrement) +
        effectiveAt z v * scoreBound /
          (config.INACTIVITY_SCORE_BIAS.toNat *
            (parameters preset z.fork).INACTIVITY_PENALTY_QUOTIENT.toNat) := by
  intro inc quarter perIncrement
  unfold passPenaltyRate
  let total := activeBalanceTotal z.state
  let score := if altair : .altair ≤ z.fork then
    (((z.state.inactivityScores altair).data[v]?).map (·.toNat)).getD 0 else 0
  have sizeInc : 10 ^ 8 ≤ inc := facts.incrementSize
  have roomy := Nat.le_trans (show 2 ^ 33 ≤ 2 ^ 35 by decide) facts.rewardScale
  have positive : 0 < inc := by omega
  have weights : TIMELY_SOURCE_WEIGHT.toNat + TIMELY_TARGET_WEIGHT.toNat = 40 := by decide
  have denominator : WEIGHT_DENOMINATOR.toNat = 64 := by decide
  rw [weights, denominator]
  obtain ⟨k, hk⟩ := aligned
  have hinc : inc ≤ total := le_max_left _ _
  -- the numerator of the per-increment reward, `X`, dominates the square root of the quarter
  obtain ⟨X, hX⟩ : ∃ X, inc * preset.BASE_REWARD_FACTOR.toNat = X := ⟨_, rfl⟩
  rw [hX] at roomy
  have hp : perIncrement = X / quarter.sqrt := by
    simp only [perIncrement, hX]
  have incX : inc ≤ X := by
    rw [← hX]
    exact Nat.le_mul_of_pos_right _ facts.reward
  have quarterLe : quarter ≤ X ^ 2 := by
    by_cases big : 18 * inc ≤ pulledTotal
    · have : 2 ^ 66 ≤ X ^ 2 := by
        calc 2 ^ 66 = (2 ^ 33) ^ 2 := by norm_num
          _ ≤ X ^ 2 := Nat.pow_le_pow_left roomy 2
      have : pulledTotal / 4 < 2 ^ 62 := by omega
      simp only [quarter, big, ↓reduceIte]
      omega
    · simp only [quarter, big, ↓reduceIte]
      exact Nat.le_trans (Nat.div_le_self _ _)
        (Nat.le_trans incX (Nat.le_self_pow (by decide) _))
  have quarterTotal : quarter ≤ total := by
    by_cases big : 18 * inc ≤ pulledTotal
    · simp only [quarter, big, ↓reduceIte]
      have : 2 * pulledTotal ≤ 3 * total := band
      omega
    · simp only [quarter, big, ↓reduceIte]
      exact Nat.le_trans (Nat.div_le_self _ _) hinc
  have quarterPositive : 0 < quarter.sqrt := by
    refine Nat.sqrt_pos.mpr ?_
    by_cases big : 18 * inc ≤ pulledTotal
    · simp only [quarter, big, ↓reduceIte]
      omega
    · simp only [quarter, big, ↓reduceIte]
      omega
  have quarterRoot : quarter.sqrt ≤ X := by
    have := Nat.sqrt_le_sqrt quarterLe
    rwa [Nat.sqrt_eq'] at this
  have totalRoot : quarter.sqrt ≤ total.sqrt := Nat.sqrt_le_sqrt quarterTotal
  have perOne : 1 ≤ X / quarter.sqrt := (Nat.le_div_iff_mul_le quarterPositive).mpr (by omega)
  have rewardRate : 40 * preset.BASE_REWARD_FACTOR.toNat * effectiveAt z v / (64 * total.sqrt) ≤
      2 * (effectiveAt z v / inc * perIncrement) := by
    have increments : effectiveAt z v / inc = k := by
      rw [hk, Nat.mul_div_cancel_left _ positive]
    have numerator : 40 * preset.BASE_REWARD_FACTOR.toNat * effectiveAt z v = 40 * (k * X) := by
      rw [hk, ← hX]
      ring
    have totalPositive : 0 < total.sqrt := Nat.lt_of_lt_of_le quarterPositive totalRoot
    rw [increments, numerator]
    calc 40 * (k * X) / (64 * total.sqrt)
        ≤ 40 * (k * X) / (40 * total.sqrt) :=
          Nat.div_le_div_left (Nat.mul_le_mul_right _ (by decide)) (by positivity)
      _ = k * X / total.sqrt := Nat.mul_div_mul_left _ _ (by decide)
      _ ≤ k * X / quarter.sqrt := Nat.div_le_div_left totalRoot quarterPositive
      _ ≤ 2 * (k * perIncrement) := by
        refine Nat.div_le_of_le_mul ?_
        have split : X < (X / quarter.sqrt + 1) * quarter.sqrt := by
          have := Nat.lt_mul_div_succ X quarterPositive
          rwa [Nat.mul_comm] at this
        have step : X ≤ 2 * perIncrement * quarter.sqrt := by
          have : (X / quarter.sqrt + 1) ≤ 2 * (X / quarter.sqrt) := by omega
          rw [hp]
          exact Nat.le_of_lt (Nat.lt_of_lt_of_le split (Nat.mul_le_mul_right _ this))
        calc k * X ≤ k * (2 * perIncrement * quarter.sqrt) := Nat.mul_le_mul_left _ step
          _ = quarter.sqrt * (2 * (k * perIncrement)) := by ring
  have scoreRate : effectiveAt z v * (score + config.INACTIVITY_SCORE_BIAS.toNat) /
        (config.INACTIVITY_SCORE_BIAS.toNat *
          (parameters preset z.fork).INACTIVITY_PENALTY_QUOTIENT.toNat) ≤
      effectiveAt z v * scoreBound /
        (config.INACTIVITY_SCORE_BIAS.toNat *
          (parameters preset z.fork).INACTIVITY_PENALTY_QUOTIENT.toNat) :=
    Nat.div_le_div_right (Nat.mul_le_mul_left _ scored)
  exact Nat.add_le_add rewardRate scoreRate

end PinKeyFloor

/-! ## PinEventsKept -/

namespace PinEventsKept

open Base Uint64 Models DirectSafety

variable {preset : Preset} {config : Config} {checks : SignatureChecks}

/-- What a chain of steps keeps of the registry, at any forks.

Assigned exits stay, and a slash stays.

The withdrawable epoch of a key with an exit set only rises, and only for a slashed key. -/
private structure Kept {f g : Fork} (s : BeaconState preset f) (t : BeaconState preset g) :
    Prop where
  life : RegistryLifecycle s t
  slashed : SlashedPersistence s t
  withdrawable : WithdrawableKept s t

/-- Two steps keep what one keeps.

The exit of the first comes from its lifecycle, and the slash of the second from its persistence. -/
private theorem Kept.trans {f g h : Fork} {s : BeaconState preset f} {t : BeaconState preset g}
    {u : BeaconState preset h} (one : Kept s t) (two : Kept t u) : Kept s u where
  life := one.life.trans two.life
  slashed := one.slashed.trans two.slashed
  withdrawable i v w found read far := by
    obtain ⟨m, mFound, step⟩ := one.life.validators i v found
    have mFar : m.exitEpoch ≠ FAR_FUTURE_EPOCH := by rw [step.exitEpoch far]; exact far
    obtain ⟨le1, moved1⟩ := one.withdrawable i v m found mFound far
    obtain ⟨le2, moved2⟩ := two.withdrawable i m w mFound read mFar
    refine ⟨UInt64.le_trans le1 le2, ?_⟩
    rcases moved2 with flag | same
    · exact .inl flag
    · rcases moved1 with flag | same1
      · obtain ⟨w', read', marked⟩ := two.slashed i m mFound flag
        rw [read, Option.some.injEq] at read'
        subst read'
        exact .inl marked
      · exact .inr (same.trans same1)

/-- A state with the same validators keeps everything. -/
private theorem Kept.of_data {f g : Fork} {s : BeaconState preset f} {t : BeaconState preset g}
    (same : t.validators.data = s.validators.data) : Kept s t where
  life := .of_data same
  slashed := .of_data same
  withdrawable i v w found read _ := by
    rw [same, found, Option.some.injEq] at read
    subst read
    exact ⟨UInt64.le_refl _, .inr rfl⟩

/-- A step that keeps the lifecycle, the slashes and each withdrawable epoch keeps everything. -/
private theorem Kept.of_withdrawable {f g : Fork} {s : BeaconState preset f}
    {t : BeaconState preset g} (life : RegistryLifecycle s t) (slashed : SlashedPersistence s t)
    (same : ∀ (i : ℕ) (v : Validator), s.validators.data[i]? = some v →
      ∃ w, t.validators.data[i]? = some w ∧ w.withdrawableEpoch = v.withdrawableEpoch) :
    Kept s t where
  life := life
  slashed := slashed
  withdrawable i v w found read _ := by
    obtain ⟨w', read', equal⟩ := same i v found
    rw [read, Option.some.injEq] at read'
    subst read'
    exact ⟨UInt64.le_of_eq equal.symm, .inr equal⟩

/-- The pending deposits keep every validator of the registry before them as it was. -/
private theorem pendingDeposits_entries {fork : Fork} {s t : BeaconState preset fork}
    {electra : .pectra ≤ fork} (ok : processPendingDeposits config checks s electra = .ok t)
    (i : ℕ) (v : Validator) (found : s.validators.data[i]? = some v) :
    t.validators.data[i]? = some v := by
  obtain ⟨_, _, applied, _, next, _, _, _, _, _, _, _, _, appliedOk, rfl⟩ :=
    processPendingDeposits_applied ok
  have kept := foldlM_ok_invariant
    (fun u : BeaconState preset fork => u.validators.data[i]? = some v)
    (fun u deposit u' previous step => by
      rcases applyPendingDeposit_cases step with rfl | ⟨index, raised⟩ | ⟨_, added⟩
      · exact previous
      · rw [increaseBalance_validators raised]
        exact previous
      · have inside := (Array.getElem?_eq_some_iff.mp previous).1
        rw [addValidatorToRegistry_validators_eq_push added, Array.getElem?_push]
        simp only [Nat.ne_of_lt inside, ↓reduceIte]
        exact previous)
    found appliedOk
  exact kept

/-- The update of the effective balances keeps the withdrawable epoch of each validator. -/
private theorem effectiveUpdates_withdrawable {fork : Fork} {s t : BeaconState preset fork}
    (ok : processEffectiveBalanceUpdates s = .ok t) (i : ℕ) (v : Validator)
    (found : s.validators.data[i]? = some v) :
    ∃ w, t.validators.data[i]? = some w ∧ w.withdrawableEpoch = v.withdrawableEpoch := by
  unfold processEffectiveBalanceUpdates at ok
  refine foldlM_ok_invariant (fun u : BeaconState preset fork =>
    ∃ w, u.validators.data[i]? = some w ∧ w.withdrawableEpoch = v.withdrawableEpoch)
    (fun u j u' previous step => ?_) ⟨v, found, rfl⟩ ok
  obtain ⟨w, read, equal⟩ := previous
  simp only [updateEffectiveBalance, bind_ok_iff, liftAccessor_ok] at step
  obtain ⟨validator, validatorOk, balance, _, next, _, set⟩ := step
  obtain ⟨inside, rfl⟩ := setValidatorAt_ok set
  by_cases same : i = j
  · subst same
    rw [getValidatorAt_eq_ok_iff.mp validatorOk, Option.some.injEq] at read
    subst read
    exact ⟨{ validator with effectiveBalance := next },
      by simp [BeaconState.putValidator, Serialization.Ssz.RootedForkList.data_set], equal⟩
  · refine ⟨w, ?_, equal⟩
    simpa [BeaconState.putValidator, Serialization.Ssz.RootedForkList.data_set, Ne.symm same,
      same] using read

/-- From Electra, every stage of an epoch keeps the registry. -/
private theorem kept_stage {fork : Fork} {k : EpochStage} {s t : BeaconState preset fork}
    (electra : .pectra ≤ fork) (edge : EpochStage.Edge config checks k s t) : Kept s t := by
  cases k
  case registry =>
    simp only [EpochStage.Edge] at edge
    exact ⟨registryLifecycle_processRegistryUpdates edge,
      .of_frame (frame_processRegistryUpdates edge).toFrame,
      withdrawableKept_processRegistryUpdates electra edge⟩
  case pendingDeposits =>
    simp only [EpochStage.Edge, electra, ↓reduceDIte] at edge
    exact Kept.of_withdrawable (registryLifecycle_processPendingDeposits edge)
      (.of_frame (frame_processPendingDeposits edge).toFrame)
      fun i v found => ⟨v, pendingDeposits_entries edge i v found, rfl⟩
  case effectiveBalances =>
    simp only [EpochStage.Edge] at edge
    exact Kept.of_withdrawable (registryLifecycle_processEffectiveBalanceUpdates edge)
      (.of_frame (frame_processEffectiveBalanceUpdates edge).toFrame)
      (effectiveUpdates_withdrawable edge)
  all_goals exact Kept.of_data (congrArg (·.data) (edge.validators_eq ⟨nofun, nofun, nofun⟩))

/-- From Electra, a whole epoch transition keeps the registry. -/
private theorem kept_processEpoch {fork : Fork} {s t : BeaconState preset fork}
    (electra : .pectra ≤ fork) (ok : processEpoch config checks s = .ok t) : Kept s t :=
  (processEpoch_trace ok).transport (fun a b => Kept a b) (fun _ => Kept.of_data rfl)
    (fun one two => one.trans two)
    (fun _ _ _ _ computed => kept_stage electra (EpochStage.action_cases.mp computed))

/-- From Electra, a slot of a run keeps the registry. -/
private theorem kept_slot {u w : ForkedBeaconState preset} (electra : .pectra ≤ u.fork)
    (ok : advanceSlotAcross config checks u = .ok w) : Kept u.state w.state := by
  obtain ⟨advanced, slotOk, upgrades⟩ := bind_ok_iff.mp ok
  obtain ⟨_, cached, epoched, _, cachedOk, epochedOk, afterEq⟩ := advanceSlot_ok slotOk
  have cachedKept : Kept u.state cached := by
    obtain ⟨_, _, _, _, rfl⟩ := processSlot_ok cachedOk
    exact Kept.of_data rfl
  have epochKept : Kept cached epoched := by
    unfold epochIfLast at epochedOk
    split at epochedOk
    · exact kept_processEpoch electra epochedOk
    · simp only [pure, Except.pure, Except.ok.injEq] at epochedOk
      exact epochedOk ▸ Kept.of_data rfl
  have advancedKept : Kept u.state advanced := by
    rw [afterEq]
    exact cachedKept.trans (epochKept.trans (Kept.of_data rfl))
  exact (processUpgrades_induction (forked := ⟨u.fork, advanced⟩)
    (property := fun z => .pectra ≤ z.fork ∧ Kept u.state z.state)
    (fun {_ post} held more => ⟨Nat.le_trans held.1 (Nat.le_of_lt post.property),
      held.2.trans (Kept.of_data (upgradeNext_validators_of_electra held.1 more))⟩)
    ⟨electra, advancedKept⟩ upgrades).2

/-- From Fulu and before Gloas, a block keeps the registry. -/
private theorem kept_block {fork : Fork} {a t : BeaconState preset fork}
    {engine : ExecutionEngine preset fork} {signed : SignedBeaconBlock preset fork}
    {due : upgradeDue config ⟨fork, a⟩ = false}
    {ok : applySignedBlock config checks engine a signed true = .ok t}
    (fulu : .fusaka ≤ fork) (early : fork < .glamsterdam) (matched : BalancesMatch a) :
    Kept a t := by
  have processed := (applySignedBlock_ok ok).2.1
  have frame := frame_processBlock processed
  refine ⟨registryLifecycle_processBlock processed, .of_frame frame, ?_⟩
  exact Run.withdrawableKept_of_same_epoch (Run.nil.snoc (Step.block engine signed due ok)) early
    fulu (by simp only [getCurrentEpoch, frame.slot]) matched

/-- From Fulu and before Gloas, a run keeps the registry. -/
private theorem kept_run {g x y : ForkedBeaconState preset}
    (shared : Run config checks g x) (genesis : Genesis (config := config) (checks := checks) g)
    (fulu : .fusaka ≤ x.fork) (tail : Run config checks x y) (early : y.fork < .glamsterdam) :
    Kept x.state y.state := by
  induction tail with
  | nil => exact Kept.of_data rfl
  | @snoc middle last pre step ih =>
    have earlyMiddle : middle.fork < .glamsterdam :=
      Nat.lt_of_le_of_lt step.chainStep.fork_le early
    have fuluMiddle : .fusaka ≤ middle.fork :=
      Nat.le_trans fulu (fork_le_of_chainSteps pre.chainSteps)
    refine (ih earlyMiddle).trans ?_
    cases step with
    | slot ok =>
      exact kept_slot (Nat.le_trans (by decide) fuluMiddle) ok
    | block engine signed due ok =>
      exact kept_block (engine := engine) (signed := signed) (due := due) (ok := ok)
        fuluMiddle early
        (run_justified_separated (shared.append pre) genesis).1.balancesMatch

/-- A replay step keeps the registry and the slot, and records no deposit event. -/
private structure Grew {f : Fork} (p q : BalanceReplay preset f) : Prop where
  kept : Kept p.1 q.1
  slot : q.1.slot = p.1.slot
  size : q.1.validators.data.size = p.1.validators.data.size
  events : ∀ e ∈ q.2, e ∈ p.2 ∨ e.source ≠ .deposits

/-- A replay step that does nothing grows the replay. -/
private theorem Grew.refl {f : Fork} (p : BalanceReplay preset f) : Grew p p :=
  ⟨Kept.of_data rfl, rfl, rfl, fun _ member => .inl member⟩

/-- Two growing replay steps in a row grow the replay. -/
private theorem Grew.trans {f : Fork} {p q r : BalanceReplay preset f} (one : Grew p q)
    (two : Grew q r) : Grew p r where
  kept := one.kept.trans two.kept
  slot := two.slot.trans one.slot
  size := two.size.trans one.size
  events e member := by
    rcases two.events e member with old | other
    · exact one.events e old
    · exact .inr other

/-- A recorded pass appends one event of its source to the events, after its action. -/
private theorem recordBalance_cases {f : Fork} {source : BalanceSource}
    {limits : BeaconState preset f → Except TransitionError (Nat × Nat)}
    {action : BeaconState preset f → Except TransitionError (BeaconState preset f)}
    {p q : BalanceReplay preset f} (ok : recordBalance source limits action p = .ok q) :
    action p.1 = .ok q.1 ∧ (∀ e ∈ q.2, e ∈ p.2 ∨ e.source = source) ∧
      ∃ credit debit, q.2 = p.2 ++ [⟨source, ⟨f, p.1⟩, ⟨f, q.1⟩, credit, debit⟩] := by
  simp only [recordBalance, bind_ok_iff, pure, Except.pure, Except.ok.injEq] at ok
  obtain ⟨⟨credit, debit⟩, _, after, computed, rfl⟩ := ok
  refine ⟨computed, fun e member => ?_, credit, debit, rfl⟩
  rcases List.mem_append.mp member with old | added
  · exact .inl old
  · exact .inr (by rw [List.mem_singleton.mp added])

/-- A carried pass changes the state by its action and records nothing. -/
private theorem carryBalance_cases {f : Fork}
    {action : BeaconState preset f → Except TransitionError (BeaconState preset f)}
    {p q : BalanceReplay preset f} (ok : carryBalance action p = .ok q) :
    action p.1 = .ok q.1 ∧ q.2 = p.2 := by
  simp only [carryBalance, bind_ok_iff, pure, Except.pure, Except.ok.injEq] at ok
  obtain ⟨after, computed, rfl⟩ := ok
  exact ⟨computed, rfl⟩

/-- A replay of reward and penalty deltas keeps the registry and records no deposit. -/
private theorem replayDeltas_grew {f : Fork} {source : BalanceSource}
    {deltas : Array Gwei × Array Gwei} {p q : BalanceReplay preset f}
    (notDeposit : source ≠ .deposits) (ok : replayDeltas source deltas p = .ok q) : Grew p q := by
  unfold replayDeltas at ok
  refine foldlM_ok_invariant (fun r => Grew p r) (fun r i r' previous step => ?_) (Grew.refl p) ok
  refine previous.trans ?_
  simp only [bind_ok_iff] at step
  obtain ⟨index, _, raised, raisedOk, loweredOk⟩ := step
  obtain ⟨raisedAction, raisedEvents, -⟩ := recordBalance_cases raisedOk
  obtain ⟨loweredAction, loweredEvents, -⟩ := recordBalance_cases loweredOk
  have raisedAction := liftAccessor_ok.mp raisedAction
  have loweredAction := liftAccessor_ok.mp loweredAction
  have first : Grew r raised :=
    ⟨Kept.of_data (congrArg (·.data) (increaseBalance_validators raisedAction)),
      (frame_increaseBalance raisedAction).toFrame.slot,
      congrArg Array.size (congrArg (·.data) (increaseBalance_validators raisedAction)),
      fun e member => by
        rcases raisedEvents e member with old | new
        · exact .inl old
        · exact .inr (by rw [new]; decide)⟩
  have second : Grew raised r' :=
    ⟨Kept.of_data (congrArg (·.data) (decreaseBalance_validators loweredAction)),
      (frame_decreaseBalance loweredAction).toFrame.slot,
      congrArg Array.size (congrArg (·.data) (decreaseBalance_validators loweredAction)),
      fun e member => by
        rcases loweredEvents e member with old | new
        · exact .inl old
        · exact .inr (by rw [new]; exact notDeposit)⟩
  exact first.trans second

/-- The replay of the rewards and penalties keeps the registry and records no deposit. -/
private theorem replayRewards_grew {f : Fork} {p q : BalanceReplay preset f}
    (ok : replayRewards (config := config) p = .ok q) : Grew p q := by
  unfold replayRewards at ok
  split at ok
  · simp only [pure, Except.pure, Except.ok.injEq] at ok
    subst ok
    exact Grew.refl _
  · simp only [bind_ok_iff] at ok
    obtain ⟨ordinary, _, inactivity, _, ok⟩ := ok
    split at ok
    · obtain ⟨middle, middleOk, lastOk⟩ := bind_ok_iff.mp ok
      have first : Grew p middle := foldlM_ok_invariant (fun r => Grew p r)
        (fun _ _ _ previous step => previous.trans (replayDeltas_grew (by decide) step))
        (Grew.refl p) middleOk
      exact first.trans (replayDeltas_grew (by decide) lastOk)
    · obtain ⟨_, _, ok⟩ := bind_ok_iff.mp ok
      obtain ⟨one, oneOk, ok⟩ := bind_ok_iff.mp ok
      obtain ⟨two, twoOk, lastOk⟩ := bind_ok_iff.mp ok
      have middle : Grew one two := foldlM_ok_invariant (fun r => Grew one r)
        (fun _ _ _ previous step => previous.trans (replayDeltas_grew (by decide) step))
        (Grew.refl one) twoOk
      exact ((replayDeltas_grew (by decide) oneOk).trans middle).trans
        (replayDeltas_grew (by decide) lastOk)

/-- From Electra, each stage of an epoch before the pending deposits keeps the registry. -/
private theorem replay_stage {f : Fork} (electra : .pectra ≤ f) {k : EpochStage}
    (member : k ∈ [EpochStage.justification, .inactivity, .rewards, .registry, .slashings,
      .eth1Reset]) {p q : BalanceReplay preset f}
    (ok : epochReplayAction (config := config) (checks := checks) k p = .ok q) : Grew p q := by
  have sizeOf : ∀ {k' : EpochStage} (e : EpochStage.Edge config checks k' p.1 q.1),
      (k' ≠ .registry ∧ k' ≠ .pendingDeposits ∧ k' ≠ .effectiveBalances) →
        q.1.validators.data.size = p.1.validators.data.size := fun e other =>
    congrArg Array.size (congrArg (·.data) (e.validators_eq other))
  have ofEdge (edge : EpochStage.Edge config checks k p.1 q.1) (same : q.2 = p.2)
      (size : q.1.validators.data.size = p.1.validators.data.size) : Grew p q :=
    ⟨kept_stage electra edge, edge.slot_eq, size, fun e member => .inl (same ▸ member)⟩
  simp only [List.mem_cons, List.not_mem_nil, or_false] at member
  rcases member with rfl | rfl | rfl | rfl | rfl | rfl
  · simp only [epochReplayAction] at ok
    obtain ⟨action, same⟩ := carryBalance_cases ok
    exact ofEdge action same (sizeOf (k' := .justification) action ⟨nofun, nofun, nofun⟩)
  · simp only [epochReplayAction] at ok
    split at ok
    · obtain ⟨action, same⟩ := carryBalance_cases ok
      rename_i h
      have edge : EpochStage.Edge config checks .inactivity p.1 q.1 := by
        simp only [EpochStage.Edge, h, ↓reduceDIte]; exact action
      exact ofEdge edge same (sizeOf edge ⟨nofun, nofun, nofun⟩)
    · simp only [pure, Except.pure, Except.ok.injEq] at ok
      subst ok
      exact Grew.refl _
  · simp only [epochReplayAction] at ok
    exact replayRewards_grew ok
  · simp only [epochReplayAction] at ok
    obtain ⟨action, same⟩ := carryBalance_cases ok
    exact ofEdge action same (sameSizes_processRegistryUpdates (config := config)
      (by simpa only [EpochStage.Edge] using action)).1
  · simp only [epochReplayAction] at ok
    obtain ⟨action, events, -⟩ := recordBalance_cases ok
    have edge : EpochStage.Edge config checks .slashings p.1 q.1 := action
    exact ⟨kept_stage electra edge, edge.slot_eq, sizeOf edge ⟨nofun, nofun, nofun⟩,
      fun e member => by
        rcases events e member with old | new
        · exact .inl old
        · exact .inr (by rw [new]; decide)⟩
  · simp only [epochReplayAction] at ok
    split at ok
    · obtain ⟨action, same⟩ := carryBalance_cases ok
      rename_i h
      have edge : EpochStage.Edge config checks .eth1Reset p.1 q.1 := by
        simp only [EpochStage.Edge, h, ↓reduceDIte]; exact action
      exact ofEdge edge same (sizeOf edge ⟨nofun, nofun, nofun⟩)
    · simp only [pure, Except.pure, Except.ok.injEq] at ok
      subst ok
      exact Grew.refl _

/-- A later state has the exit and withdrawable epochs of an earlier one at its indices. -/
private def ExitsStay {f g : Fork} (s : BeaconState preset f) (t : BeaconState preset g) : Prop :=
  ∀ (i : ℕ) (v : Validator), s.validators.data[i]? = some v →
    ∃ w, t.validators.data[i]? = some w ∧ w.exitEpoch = v.exitEpoch ∧
      w.withdrawableEpoch = v.withdrawableEpoch

/-- Two states in a row that keep the exits and withdrawable epochs keep them together. -/
private theorem ExitsStay.trans {f g h : Fork} {s : BeaconState preset f} {t : BeaconState preset g}
    {u : BeaconState preset h} (one : ExitsStay s t) (two : ExitsStay t u) : ExitsStay s u :=
  fun i v found => by
    obtain ⟨m, mFound, exit, wd⟩ := one i v found
    obtain ⟨w, wFound, exit', wd'⟩ := two i m mFound
    exact ⟨w, wFound, exit'.trans exit, wd'.trans wd⟩

/-- A state with the same validators has the same exits. -/
private theorem ExitsStay.of_data {f g : Fork} {s : BeaconState preset f} {t : BeaconState preset g}
    (same : t.validators.data = s.validators.data) : ExitsStay s t :=
  fun i v found => ⟨v, by rw [same]; exact found, rfl, rfl⟩

/-- The state at the input of a slot step's pending deposits, for a deposit event of the step.

It keeps the registry of the step's start, at its epoch and with at most its size.

The step's end state has the exit and withdrawable epochs of that input.

A step with a deposit event ends in a later epoch. -/
private theorem Step.deposit_input {u w : ForkedBeaconState preset}
    (ok : advanceSlotAcross config checks u = .ok w) (fulu : .fusaka ≤ u.fork)
    (early : w.fork < .glamsterdam) {events : List (BalanceEvent preset)}
    (replayed : (Step.slot ok : Step config checks u w).balanceEvents = .ok events) :
    ∀ e ∈ events, e.source = .deposits →
      Kept u.state e.before.state ∧
      e.before.state.validators.data.size ≤ u.state.validators.data.size ∧
      getCurrentEpoch e.before.state = getCurrentEpoch u.state ∧
      ExitsStay e.before.state w.state ∧
      (getCurrentEpoch u.state).toNat < (getCurrentEpoch w.state).toNat := by
  intro e member source
  have electraU : .pectra ≤ u.fork := Nat.le_trans (by decide) fulu
  obtain ⟨advanced, cached, crossings, advanceOk, upgrades, cachedOk, crossingOk, branch⟩ :=
    Step.balanceEvents_slot ok early replayed
  have noCrossings : crossings = [] :=
    DirectSafety.Apriori.Internal.upgradeBalanceReplay_electra_nil
      (u := ⟨u.fork, advanced⟩) electraU crossingOk
  rcases branch with ⟨_, eventsEq⟩ | ⟨middle, updated, recorded, recordOk, updatedOk,
      validatorsEq, _, eventsEq, next, nextNat, nextSlot, nextMod, -⟩
  · rw [eventsEq, noCrossings] at member
    cases member
  rw [eventsEq, noCrossings, List.append_nil] at member
  have cachedKept : Kept u.state cached := by
    obtain ⟨_, _, _, _, rfl⟩ := processSlot_ok cachedOk
    exact Kept.of_data rfl
  have cachedSlot : cached.slot = u.state.slot := (frame_processSlot cachedOk).slot
  have trace := epochBalanceReplay_trace recordOk
  change EpochTrace _ ([EpochStage.justification, .inactivity, .rewards, .registry, .slashings,
    .eth1Reset] ++ [.pendingDeposits, .pendingConsolidations]) _ _ at trace
  obtain ⟨six, head, rest⟩ := EpochTrace.append_iff.mp trace
  have grew : Grew (cached, []) six := head.transport (fun p q => Grew p q) Grew.refl Grew.trans
    (fun _ member _ _ computed => replay_stage electraU member computed)
  cases rest with
  | cons first rest =>
    cases rest with
    | cons second rest =>
      cases rest
      simp only [epochReplayAction, electraU, ↓reduceDIte, bind_ok_iff, pure, Except.pure,
        Except.ok.injEq] at first second
      obtain ⟨deposited, depositOk, rfl⟩ := first
      obtain ⟨consolidated, consolidatedOk, same⟩ := second
      simp only [Prod.mk.injEq] at same
      obtain ⟨rfl, rfl⟩ := same
      rcases List.mem_append.mp member with old | last
      · rcases List.mem_append.mp old with old | added
        · rcases grew.events e old with listed | other
          · cases listed
          · exact absurd source other
        · rw [List.mem_singleton.mp added]
          have cachedSize : cached.validators.data.size = u.state.validators.data.size := by
            obtain ⟨_, _, _, _, rfl⟩ := processSlot_ok cachedOk
            rfl
          have same : getCurrentEpoch six.1 = getCurrentEpoch u.state := by
            simp only [getCurrentEpoch, grew.slot, cachedSlot]
          have deposits : ExitsStay six.1 deposited := fun i v found =>
            ⟨v, pendingDeposits_entries depositOk i v found, rfl, rfl⟩
          have consolidations : ExitsStay deposited consolidated :=
            .of_data (congrArg (·.data) (processPendingConsolidations_fields consolidatedOk).1)
          have updates : ExitsStay consolidated updated := fun i v found => by
            obtain ⟨balance, owned⟩ := processEffectiveBalanceUpdates_owned updatedOk found
            obtain ⟨_, read, -⟩ :=
              processEffectiveBalanceUpdates_effectiveBalance_eq updatedOk found owned
            exact ⟨_, read, rfl, rfl⟩
          have upgraded : ExitsStay updated w.state := .of_data
            ((processUpgrades_validators_of_electra (s := ⟨u.fork, advanced⟩) electraU early
              upgrades).trans (congrArg (·.data) validatorsEq))
          have crossed : (getCurrentEpoch u.state).toNat < (getCurrentEpoch w.state).toNat := by
            rw [getCurrentEpoch_toNat, getCurrentEpoch_toNat,
              (processUpgrades_slot upgrades).trans nextSlot,
              nextSlot_epoch_of_boundary nextNat nextMod]
            omega
          exact ⟨cachedKept.trans grew.kept, (grew.size.trans cachedSize).le, same,
            deposits.trans (consolidations.trans (updates.trans upgraded)), crossed⟩
      · rw [List.mem_singleton.mp last] at source
        cases source

/-- Every deposit event of a slot step of the run starts at a state that keeps the registry.

A slot step records a deposit event only for the pending deposits of its epoch pass.

So the event starts at the input of that pass.

That input is the state after the first six stages of the epoch.

They are justification, inactivity, rewards, registry updates, slashings and the eth1 reset.

The steps of the run before the slot keep the registry, and so does each of those stages.

Block deposits are not covered.

From Electra they credit no existing key.

The registry at the event's start has at most the size of the one at the slot step's start.

A slashed key at the slot step's start is slashed at the event's start, and their epochs agree. -/
private theorem Run.events_kept {g x y : ForkedBeaconState preset}
    (shared : Run config checks g x) (genesis : Genesis (config := config) (checks := checks) g)
    (tail : Run config checks x y) (fulu : .fusaka ≤ x.fork) (early : y.fork < .glamsterdam)
    {u w : ForkedBeaconState preset} (ok : advanceSlotAcross config checks u = .ok w)
    (contained : tail.Contains (Step.slot ok))
    {events : List (BalanceEvent preset)}
    (replayed : (Step.slot ok : Step config checks u w).balanceEvents = .ok events) :
    ∀ e ∈ events, e.source = .deposits →
      RegistryLifecycle x.state e.before.state ∧
      WithdrawableKept x.state e.before.state ∧
      getCurrentEpoch e.before.state ≤ getCurrentEpoch y.state ∧
      e.before.state.validators.data.size ≤ u.state.validators.data.size ∧
      SlashedPersistence u.state e.before.state ∧
      getCurrentEpoch e.before.state = getCurrentEpoch u.state := by
  intro e member source
  obtain ⟨pre, post, rfl⟩ := Run.contains_split tail (Step.slot ok) contained
  have stepFork := (Step.slot ok : Step config checks u w).chainStep.fork_le
  have earlyW : w.fork < .glamsterdam :=
    Nat.lt_of_le_of_lt (fork_le_of_chainSteps post.chainSteps) early
  have earlyU : u.fork < .glamsterdam := Nat.lt_of_le_of_lt stepFork earlyW
  have fuluU : .fusaka ≤ u.fork := Nat.le_trans fulu (fork_le_of_chainSteps pre.chainSteps)
  have run : Kept x.state u.state := kept_run shared genesis fulu pre earlyU
  have epochLe : getCurrentEpoch u.state ≤ getCurrentEpoch y.state :=
    currentEpoch_le_of_chainSteps
      (Relation.ReflTransGen.head (Step.slot ok : Step config checks u w).chainStep
        post.chainSteps)
  obtain ⟨kept, size, same, -, -⟩ := Step.deposit_input ok fuluU earlyW replayed e member source
  have total := run.trans kept
  exact ⟨total.life, total.withdrawable, same ▸ epochLe, size, kept.slashed, same⟩

end PinEventsKept

end

section

/-! ## Credits to exiting keys along a run -/

namespace PinKeys

open Base Uint64 Models DirectSafety

variable {preset : Preset} {fork : Fork} {config : Config} {checks : SignatureChecks}

/-! ## Deposits leave the balance of an exiting key alone -/

/-- Every exiting key of the first state keeps its balance in the second state. -/
private def KeepsExiting {f g : Fork} (s : BeaconState preset f) (t : BeaconState preset g) :
    Prop :=
  ∀ (i : ℕ) (v : Validator), s.validators.data[i]? = some v → v.exitEpoch.toNat < 2 ^ 64 - 1 →
    (getCurrentEpoch s).toNat < v.withdrawableEpoch.toNat →
    t.balances.data[i]? = s.balances.data[i]?

/-- Every deposit event of the list leaves the balance of an exiting key alone. -/
private def Quiet (events : List (BalanceEvent preset)) : Prop :=
  ∀ e ∈ events, e.source = .deposits → KeepsExiting e.before.state e.after.state

/-- The event raises no balance of the registry. -/
private def Unconditional (e : BalanceEvent preset) : Prop :=
  ∀ i, actualBalanceAt e.after i ≤ actualBalanceAt e.before i

/-- The empty list of events is quiet. -/
private theorem quiet_nil : Quiet ([] : List (BalanceEvent preset)) := fun _ mem => by
  simp at mem

/-- A pass that records no event keeps the events quiet. -/
private theorem quiet_carry {f : Fork}
    {action : BeaconState preset f → Except TransitionError (BeaconState preset f)}
    {pre post : BalanceReplay preset f} (initial : Quiet pre.2)
    (ok : carryBalance action pre = .ok post) : Quiet post.2 := by
  rw [(PinEventsKept.carryBalance_cases ok).2]
  exact initial

/-- A recorded pass keeps the events quiet when its deposit action keeps exiting balances. -/
private theorem quiet_record {f : Fork} {source : BalanceSource}
    {limits : BeaconState preset f → Except TransitionError (Nat × Nat)}
    {action : BeaconState preset f → Except TransitionError (BeaconState preset f)}
    {pre post : BalanceReplay preset f} (initial : Quiet pre.2)
    (keeps : source = .deposits → ∀ t, action pre.1 = .ok t → KeepsExiting pre.1 t)
    (ok : recordBalance source limits action pre = .ok post) : Quiet post.2 := by
  obtain ⟨actionOk, -, credit, debit, events⟩ := PinEventsKept.recordBalance_cases ok
  rw [events]
  intro e member sourceEq
  rcases List.mem_append.mp member with old | new
  · exact initial e old sourceEq
  · obtain rfl := List.mem_singleton.mp new
    exact keeps sourceEq _ actionOk

/-- A new validator with no balance never raises a balance. -/
private theorem addValidatorToRegistry_zero_balance {f : Fork} {s t : BeaconState preset f}
    (altair : .altair ≤ f) {pubkey : Cryptography.Bls.BLSPubkey} {credentials : Bytes32}
    (ok : addValidatorToRegistry s pubkey credentials 0 = .ok t) (i : ℕ) :
    ((t.balances.data[i]?).map (·.toNat)).getD 0 ≤
      ((s.balances.data[i]?).map (·.toNat)).getD 0 := by
  unfold addValidatorToRegistry at ok
  simp only [altair, ↓reduceDIte, addValidatorToRegistryAltair, liftAccessor_ok, bind_ok_iff,
    pure, Except.pure, Except.ok.injEq] at ok
  obtain ⟨_, _, _, _, _, balancesOk, _, _, _, _, _, _, rfl⟩ := ok
  show ((_ : Option Gwei).map (·.toNat)).getD 0 ≤ _
  rw [setOrAppendList_getElem? balancesOk]
  split <;> simp

/-- From Electra, a block deposit raises no balance. -/
private theorem processDeposit_balance_le {f : Fork} {s t : BeaconState preset f}
    (electra : .pectra ≤ f) {before : f < .hegota} {dep : Deposit}
    (ok : processDeposit config checks before s dep = .ok t) (i : ℕ) :
    actualBalanceAt ⟨f, t⟩ i ≤ actualBalanceAt ⟨f, s⟩ i := by
  obtain ⟨-, -, next, -, applied⟩ := processDeposit_ok ok
  rcases applyDeposit_cases applied with rfl | ⟨_, middle, pending, rfl | added, rfl⟩ |
      ⟨early, _⟩
  · exact Nat.le_refl _
  · exact Nat.le_refl _
  · exact addValidatorToRegistry_zero_balance (Nat.le_trans (by decide) electra) added i
  · exact absurd (Nat.lt_of_lt_of_le early electra) (Nat.lt_irrefl _)

/-- A property of the events of a block replay that each recorded event keeps.

Every operation of a block records an event of its own source.

The deposits of the block are the only events of the source `.deposits`.

No operation of a block records the source `.consolidations`. -/
private theorem blockReplay_invariant {f : Fork} (electra : .pectra ≤ f) (early : f < .glamsterdam)
    (P : List (BalanceEvent preset) → Prop) (nil : P [])
    (ordinary : ∀ (l : List (BalanceEvent preset)) (e : BalanceEvent preset),
      e.source ≠ .deposits → e.source ≠ .consolidations → P l → P (l ++ [e]))
    (deposit : ∀ (l : List (BalanceEvent preset)) (s t : BeaconState preset f)
      (before : f < .hegota) (dep : Deposit) (credit debit : ℕ), P l →
      processDeposit config checks before s dep = .ok t →
      P (l ++ [⟨.deposits, ⟨f, s⟩, ⟨f, t⟩, credit, debit⟩]))
    (engine : ExecutionEngine preset f) (s : BeaconState preset f)
    (block : BeaconBlock preset f) {post : BalanceReplay preset f}
    (ok : blockBalanceReplay (config := config) (checks := checks)
      early engine s block = .ok post) : P post.2 := by
  have carry {pre post : BalanceReplay preset f}
      {action : BeaconState preset f → Except TransitionError (BeaconState preset f)}
      (initial : P pre.2) (ok : carryBalance action pre = .ok post) : P post.2 := by
    rw [(PinEventsKept.carryBalance_cases ok).2]
    exact initial
  have record {pre post : BalanceReplay preset f} {source : BalanceSource}
      {limits : BeaconState preset f → Except TransitionError (Nat × Nat)}
      {action : BeaconState preset f → Except TransitionError (BeaconState preset f)}
      (notDeposit : source ≠ .deposits) (notConsolidation : source ≠ .consolidations)
      (initial : P pre.2) (ok : recordBalance source limits action pre = .ok post) :
      P post.2 := by
    obtain ⟨-, -, credit, debit, events⟩ := PinEventsKept.recordBalance_cases ok
    rw [events]
    exact ordinary _ _ notDeposit notConsolidation initial
  have altair : .altair ≤ f := Nat.le_trans (by decide) electra
  have bellatrix : .bellatrix ≤ f := Nat.le_trans (by decide) electra
  unfold blockBalanceReplay at ok
  obtain ⟨headed, headedOk, rest⟩ := bind_ok_iff.mp ok
  have headedQuiet := carry nil headedOk
  simp only [bellatrix, ↓reduceDIte] at rest
  obtain ⟨executed, executedOk, rest⟩ := bind_ok_iff.mp rest
  have executedQuiet := record (by decide : BalanceSource.withdrawals ≠ .deposits)
    (by decide) headedQuiet executedOk
  simp only [bind_ok_iff] at rest
  obtain ⟨randao, randaoOk, voted, votedOk, expected, _, _, _,
    proposed, proposedOk, attested, attestedOk, rewarded, rewardedOk, deposited, depositOk,
    exited, exitOk, changed, changedOk, rest⟩ := rest
  have randaoQuiet := carry executedQuiet randaoOk
  have votedQuiet := carry randaoQuiet votedOk
  have proposedQuiet := foldlM_ok_invariant (fun p => P p.2)
    (fun _ _ _ h ok => record (by decide : BalanceSource.slashings ≠ .deposits) (by decide) h ok)
    votedQuiet proposedOk
  have attestedQuiet := foldlM_ok_invariant (fun p => P p.2)
    (fun _ _ _ h ok => record (by decide : BalanceSource.slashings ≠ .deposits) (by decide) h ok)
    proposedQuiet attestedOk
  have rewardedQuiet := foldlM_ok_invariant (fun p => P p.2)
    (fun _ _ _ h ok => record (by decide : BalanceSource.rewards ≠ .deposits) (by decide) h ok)
    attestedQuiet rewardedOk
  have depositedQuiet := foldlM_ok_invariant (fun p => P p.2)
    (fun pre dep post h ok => by
      obtain ⟨actionOk, -, credit, debit, events⟩ := PinEventsKept.recordBalance_cases ok
      rw [events]
      exact deposit _ _ _ _ _ _ _ h actionOk)
    rewardedQuiet depositOk
  have exitedQuiet := carry depositedQuiet exitOk
  have changedQuiet := carry exitedQuiet changedOk
  simp only [electra, ↓reduceDIte, bind_ok_iff] at rest
  obtain ⟨deposits, depositRequestOk, withdrawals, withdrawalOk,
    requested, consolidations, rest⟩ := rest
  have depositsQuiet := carry changedQuiet depositRequestOk
  have withdrawalsQuiet := carry depositsQuiet withdrawalOk
  have requestedQuiet := foldlM_ok_invariant (fun p => P p.2)
    (fun _ _ _ h ok => record (by decide : BalanceSource.excess ≠ .deposits) (by decide) h ok)
    withdrawalsQuiet consolidations
  simp only [altair, ↓reduceDIte] at rest
  exact record (by decide : BalanceSource.sync ≠ .deposits) (by decide) requestedQuiet rest

/-- From Electra, the deposit events of a block replay raise no balance. -/
private theorem blockReplay_unconditional {f : Fork} (electra : .pectra ≤ f)
    (early : f < .glamsterdam)
    (engine : ExecutionEngine preset f) (s : BeaconState preset f)
    (block : BeaconBlock preset f) {post : BalanceReplay preset f}
    (ok : blockBalanceReplay (config := config) (checks := checks)
      early engine s block = .ok post) :
    ∀ e ∈ post.2, e.source = .deposits → Unconditional e :=
  blockReplay_invariant electra early (fun l => ∀ e ∈ l, e.source = .deposits → Unconditional e)
    (fun _ h => by simp at h)
    (fun l e notDeposit _ held e' member sourceEq => by
      rcases List.mem_append.mp member with old | new
      · exact held e' old sourceEq
      · exact absurd ((List.mem_singleton.mp new) ▸ sourceEq) notDeposit)
    (fun l s t _ dep credit debit held computed e' member sourceEq => by
      rcases List.mem_append.mp member with old | new
      · exact held e' old sourceEq
      · obtain rfl := List.mem_singleton.mp new
        exact fun i => processDeposit_balance_le electra computed i)
    engine s block ok

/-- No operation of a block records a consolidation event. -/
private theorem blockReplay_noConsolidations {f : Fork} (electra : .pectra ≤ f)
    (early : f < .glamsterdam) (engine : ExecutionEngine preset f) (s : BeaconState preset f)
    (block : BeaconBlock preset f) {post : BalanceReplay preset f}
    (ok : blockBalanceReplay (config := config) (checks := checks)
      early engine s block = .ok post) : ∀ e ∈ post.2, e.source ≠ .consolidations :=
  blockReplay_invariant electra early (fun l => ∀ e ∈ l, e.source ≠ .consolidations)
    (fun _ h => by simp at h)
    (fun l e _ notConsolidation held e' member => by
      rcases List.mem_append.mp member with old | new
      · exact held e' old
      · exact (List.mem_singleton.mp new) ▸ notConsolidation)
    (fun l s t _ dep credit debit held _ e' member => by
      rcases List.mem_append.mp member with old | new
      · exact held e' old
      · obtain rfl := List.mem_singleton.mp new
        exact fun eq => by cases eq)
    engine s block ok

/-- The deposit events of an epoch replay leave the balance of an exiting key alone.

The pending deposits of an epoch are the only deposit events of the replay. -/
private theorem epochReplay_quiet {f : Fork} {s : BeaconState preset f}
    {post : BalanceReplay preset f}
    (ok : epochBalanceReplay (config := config) (checks := checks) s = .ok post) :
    Quiet post.2 := by
  refine (epochBalanceReplay_trace ok).transport
    (fun a b : BalanceReplay preset f => Quiet a.2 → Quiet b.2)
    (fun _ => id) (fun one two held => two (one held)) ?_ quiet_nil
  intro k member pre after step held
  cases k <;> simp only [epochReplayAction] at step
  case justification | registry => exact quiet_carry held step
  case inactivity | eth1Reset =>
    split at step
    · exact quiet_carry held step
    · cases step; exact held
  case rewards =>
    exact replayRewards_induction (fun pre => Quiet pre.2)
      (fun prior ok => quiet_record prior (fun eq => by cases eq) ok)
      (fun penalty prior ok => quiet_record prior
        (fun eq => by rcases penalty with rfl | rfl <;> cases eq) ok) held step
  case slashings => exact quiet_record held (fun eq => by cases eq) step
  case pendingDeposits =>
    split at step
    · simp only [bind_ok_iff, pure, Except.pure, Except.ok.injEq] at step
      obtain ⟨deposited, depositedOk, rfl⟩ := step
      intro e member sourceEq
      rcases List.mem_append.mp member with old | new
      · exact held e old sourceEq
      · obtain rfl := List.mem_singleton.mp new
        intro i v found exited withdrawable
        exact processPendingDeposits_exited_balance depositedOk found exited withdrawable
    · cases step; exact held
  case pendingConsolidations =>
    split at step
    · simp only [bind_ok_iff, pure, Except.pure, Except.ok.injEq] at step
      obtain ⟨consolidated, consolidatedOk, rfl⟩ := step
      intro e member sourceEq
      rcases List.mem_append.mp member with old | new
      · exact held e old sourceEq
      · obtain rfl := List.mem_singleton.mp new
        cases sourceEq
    · cases step; exact held
  all_goals simp [EpochStage.prefixStages] at member

/-- The deposit events of a slot step leave the balance of an exiting key alone. -/
private theorem slot_quiet {x y : ForkedBeaconState preset}
    (ok : advanceSlotAcross config checks x = .ok y)
    (early : y.fork < .glamsterdam)
    {events : List (BalanceEvent preset)} (replayed : (Step.slot ok).balanceEvents = .ok events) :
    Quiet events := by
  obtain ⟨advanced, cached, crossings, -, -, -, crossingOk, split⟩ :=
    Step.balanceEvents_slot ok early replayed
  have crossed : Quiet crossings := fun e member sourceEq => by
    cases (upgradeBalanceReplay_crossing crossingOk e member).symm.trans sourceEq
  rcases split with ⟨-, rfl⟩ | ⟨middle, updated, recorded, recordOk, -, -, -, rfl, -⟩
  · exact crossed
  · intro e member sourceEq
    rcases List.mem_append.mp member with old | new
    · exact epochReplay_quiet recordOk e old sourceEq
    · exact crossed e new sourceEq

/-- A deposit event of a run raises no balance, or it is an epoch's deposit event of a slot step.

Then it leaves the balance of an exiting key alone. -/
private def Located {x y : ForkedBeaconState preset} (tail : Run config checks x y)
    (e : BalanceEvent preset) : Prop :=
  Unconditional e ∨ ∃ (u w : ForkedBeaconState preset)
    (ok : advanceSlotAcross config checks u = .ok w) (es : List (BalanceEvent preset)),
    tail.Contains (Step.slot ok) ∧ (Step.slot ok : Step config checks u w).balanceEvents = .ok es ∧
      e ∈ es ∧ KeepsExiting e.before.state e.after.state

/-- Locate each deposit event and each consolidation event of a run.

A deposit event raises no balance, or it is in the events of a slot step of the run.

A consolidation event is in the events of a slot step of the run, since no block records one. -/
private theorem run_located {x y : ForkedBeaconState preset} (tail : Run config checks x y)
    (electra : .pectra ≤ x.fork) (early : y.fork < .glamsterdam) (high : ℕ)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events) :
    (∀ e ∈ events, e.source = .deposits → Located tail e) ∧
      (∀ e ∈ events, e.source = .consolidations →
        ∃ (u w : ForkedBeaconState preset) (ok : advanceSlotAcross config checks u = .ok w)
          (es : List (BalanceEvent preset)), tail.Contains (Step.slot ok) ∧
          (Step.slot ok : Step config checks u w).balanceEvents = .ok es ∧ e ∈ es) := by
  induction tail generalizing events with
  | nil =>
    cases replayed
    exact ⟨fun e member => by simp at member, fun e member => by simp at member⟩
  | @snoc middle last pre step ih =>
    simp only [Run.balanceEvents, bind_ok_iff] at replayed
    obtain ⟨prior, priorOk, rest⟩ := replayed
    obtain ⟨priorLocated, priorSlot⟩ := ih (Nat.lt_of_le_of_lt step.chainStep.fork_le early) priorOk
    have lift : ∀ e, Located pre e → Located (pre.snoc step) e := by
      rintro e (unconditional | ⟨u, w, ok, es, contains, replayedEs, member, keeps⟩)
      · exact .inl unconditional
      · exact .inr ⟨u, w, ok, es, .earlier contains step, replayedEs, member, keeps⟩
    have liftSlot : ∀ e, (∃ (u w : ForkedBeaconState preset)
        (ok : advanceSlotAcross config checks u = .ok w) (es : List (BalanceEvent preset)),
        pre.Contains (Step.slot ok) ∧
          (Step.slot ok : Step config checks u w).balanceEvents = .ok es ∧ e ∈ es) →
        ∃ (u w : ForkedBeaconState preset) (ok : advanceSlotAcross config checks u = .ok w)
          (es : List (BalanceEvent preset)), (pre.snoc step).Contains (Step.slot ok) ∧
          (Step.slot ok : Step config checks u w).balanceEvents = .ok es ∧ e ∈ es := by
      rintro e ⟨u, w, ok, es, contains, replayedEs, member⟩
      exact ⟨u, w, ok, es, .earlier contains step, replayedEs, member⟩
    by_cases selected : (getCurrentEpoch middle.state).toNat ≤ high + 1
    · simp only [selected, ↓reduceIte, bind_ok_iff, pure, Except.pure,
        Except.ok.injEq] at rest
      obtain ⟨added, addedOk, rfl⟩ := rest
      have inFork : .pectra ≤ middle.fork :=
        Nat.le_trans electra (fork_le_of_chainSteps pre.chainSteps)
      refine ⟨fun e member sourceEq => ?_, fun e member sourceEq => ?_⟩
      · rcases List.mem_append.mp member with old | new
        · exact lift e (priorLocated e old sourceEq)
        · cases step with
          | block engine signed due ok =>
            exact .inl (blockReplay_unconditional inFork early engine _ _
              (Step.balanceEvents_block early addedOk) e new sourceEq)
          | slot ok =>
            exact .inr ⟨_, _, ok, added, .last pre _, addedOk, new,
              slot_quiet ok early addedOk e new sourceEq⟩
      · rcases List.mem_append.mp member with old | new
        · exact liftSlot e (priorSlot e old sourceEq)
        · cases step with
          | block engine signed due ok =>
            exact absurd sourceEq (blockReplay_noConsolidations inFork early engine _ _
              (Step.balanceEvents_block early addedOk) e new)
          | slot ok => exact ⟨_, _, ok, added, .last pre _, addedOk, new⟩
    · simp only [selected, ↓reduceIte, pure, Except.pure, Except.ok.injEq] at rest
      subst rest
      exact ⟨fun e member sourceEq => lift e (priorLocated e member sourceEq),
        fun e member sourceEq => liftSlot e (priorSlot e member sourceEq)⟩

/-! ## Consolidation credits of one pass -/

/-- The stake that a pending consolidation can move at a pass: the source's effective balance.

It counts only a source that is unslashed and can withdraw by the next epoch.

A pass reads the other sources without moving anything. -/
private def sourceBound {f : Fork} (s : BeaconState preset f) (next : Epoch)
    (c : PendingConsolidation) : ℕ :=
  match s.validators.data[c.sourceIndex.toNat]? with
  | some v => if v.slashed = false ∧ v.withdrawableEpoch ≤ next then v.effectiveBalance.toNat else 0
  | none => 0

/-- The credits of the balances at some positions, from one state to another. -/
private def creditedAt {f : Fork} (T : Finset ℕ) (s t : BeaconState preset f) : ℕ :=
  ∑ j ∈ T, (actualBalanceAt ⟨f, t⟩ j - actualBalanceAt ⟨f, s⟩ j)

/-- The credits at some positions telescope along two steps. -/
private theorem creditedAt_trans {f : Fork} (T : Finset ℕ) {a b c : BeaconState preset f} :
    creditedAt T a c ≤ creditedAt T a b + creditedAt T b c := by
  unfold creditedAt
  rw [← Finset.sum_add_distrib]
  exact Finset.sum_le_sum fun j _ => by omega

/-- One transfer of a pass credits at most the amount moved, and only at its target. -/
private theorem creditedAt_transfer {f : Fork} (T : Finset ℕ)
    {s lowered raised : BeaconState preset f} {source target : ValidatorIndex} {moved : Gwei}
    (lowerOk : decreaseBalance s source moved = .ok lowered)
    (raiseOk : increaseBalance lowered target moved = .ok raised) :
    creditedAt T s raised ≤ if target.toNat ∈ T then moved.toNat else 0 := by
  have sizes := (sameSizes_increaseBalance raiseOk).2.trans (sameSizes_decreaseBalance lowerOk).2
  unfold creditedAt
  have pointwise : ∀ j, actualBalanceAt ⟨f, raised⟩ j - actualBalanceAt ⟨f, s⟩ j ≤
      if target.toNat = j then moved.toNat else 0 := by
    intro j
    by_cases inside : j < s.balances.data.size
    · obtain ⟨balance, found⟩ : ∃ balance, s.balances.data[j]? = some balance :=
        ⟨_, Array.getElem?_eq_getElem inside⟩
      obtain ⟨down, downFound, downEq⟩ := balance_decreaseBalance lowerOk found
      obtain ⟨up, upFound, upEq⟩ := balance_increaseBalance raiseOk downFound
      simp only [actualBalanceAt, found, upFound, Option.map_some, Option.getD_some]
      split at downEq <;> split at upEq <;> split <;> omega
    · have missing : s.balances.data[j]? = Option.none := Array.getElem?_eq_none (by omega)
      have outside : raised.balances.data[j]? = Option.none := Array.getElem?_eq_none (by omega)
      simp [actualBalanceAt, missing, outside]
  calc ∑ j ∈ T, (actualBalanceAt ⟨f, raised⟩ j - actualBalanceAt ⟨f, s⟩ j)
      ≤ ∑ j ∈ T, if target.toNat = j then moved.toNat else 0 :=
        Finset.sum_le_sum fun j _ => pointwise j
    _ = if target.toNat ∈ T then moved.toNat else 0 := by rw [Finset.sum_ite_eq]

/-- A pass credits the targets in `T` at most the effective balances of the due sources it reads.

The sources are those of the entries whose target is in `T`.

It keeps the registry and the number of balances. -/
private theorem pass_credits_le_targets {f : Fork} (next : Epoch) (T : Finset ℕ) :
    ∀ (items : List PendingConsolidation) {s t : BeaconState preset f} {read : ℕ},
      passPendingConsolidations next s items = .ok (t, read) →
      t.validators = s.validators ∧ t.balances.data.size = s.balances.data.size ∧
        creditedAt T s t ≤
          (((items.take read).filter fun c => c.targetIndex.toNat ∈ T).map
            (sourceBound s next)).sum
  | [], s, t, read, computed => by
    simp only [passPendingConsolidations, pure, Except.pure, Except.ok.injEq,
      Prod.mk.injEq] at computed
    obtain ⟨rfl, rfl⟩ := computed
    refine ⟨rfl, rfl, ?_⟩
    simp [creditedAt, actualBalanceAt]
  | c :: rest, s, t, read, computed => by
    simp only [passPendingConsolidations, liftAccessor, bind_ok_iff, mapError_ok_iff] at computed
    obtain ⟨source, sourceRead, computed⟩ := computed
    have found := getValidator_eq_ok_iff.mp sourceRead
    have bound : sourceBound s next c = if source.slashed = false ∧ source.withdrawableEpoch ≤ next
        then source.effectiveBalance.toNat else 0 := by
      simp [sourceBound, found]
    by_cases slashed : source.slashed = true
    · simp only [slashed, ↓reduceIte, bind_ok_iff, pure, Except.pure, Except.ok.injEq,
        Prod.mk.injEq] at computed
      obtain ⟨⟨state', read'⟩, passed, rfl, rfl⟩ := computed
      obtain ⟨validators, sizes, credits⟩ := pass_credits_le_targets next T rest passed
      refine ⟨validators, sizes, ?_⟩
      by_cases inT : c.targetIndex.toNat ∈ T <;>
        simpa [bound, slashed, List.take_succ_cons, List.filter_cons, inT] using credits
    · replace slashed : source.slashed = false := by simpa using slashed
      by_cases early : next < source.withdrawableEpoch
      · simp only [slashed, early, Bool.false_eq_true, ↓reduceIte, pure, Except.pure,
          Except.ok.injEq, Prod.mk.injEq] at computed
        obtain ⟨rfl, rfl⟩ := computed
        refine ⟨rfl, rfl, ?_⟩
        simp [creditedAt, actualBalanceAt]
      · simp only [slashed, early, Bool.false_eq_true, ↓reduceIte, bind_ok_iff,
          mapError_ok_iff, pure, Except.pure, Except.ok.injEq, Prod.mk.injEq] at computed
        obtain ⟨balance, balanceOk, lowered, loweredOk, raised, raisedOk,
          ⟨state', read'⟩, passed, rfl, rfl⟩ := computed
        obtain ⟨validators, sizes, credits⟩ := pass_credits_le_targets next T rest passed
        have sameValidators := (increaseBalance_validators raisedOk).trans
          (decreaseBalance_validators loweredOk)
        have step := creditedAt_transfer T loweredOk raisedOk
        have sizeStep := (sameSizes_increaseBalance raisedOk).2.trans
          (sameSizes_decreaseBalance loweredOk).2
        have moved : (min balance source.effectiveBalance).toNat ≤
            source.effectiveBalance.toNat := by
          rw [Uint64.toNat_min]; exact Nat.min_le_right _ _
        have restBound : (((rest.take read').filter fun c => c.targetIndex.toNat ∈ T).map
            (sourceBound raised next)) =
            (((rest.take read').filter fun c => c.targetIndex.toNat ∈ T).map
              (sourceBound s next)) := by
          congr 1
          funext d
          simp only [sourceBound, sameValidators]
        refine ⟨validators.trans sameValidators, sizes.trans sizeStep, ?_⟩
        have total := creditedAt_trans T (a := s) (b := raised) (c := state')
        rw [restBound] at credits
        have isDue : sourceBound s next c = source.effectiveBalance.toNat := by
          rw [bound]; simp [slashed, UInt64.not_lt.mp early]
        by_cases inT : c.targetIndex.toNat ∈ T
        · simp only [inT, ↓reduceIte] at step
          simp only [List.take_succ_cons, List.filter_cons, inT, decide_true, ↓reduceIte,
            List.map_cons, List.sum_cons, isDue]
          omega
        · simp only [inT, ↓reduceIte] at step
          simp only [List.take_succ_cons, List.filter_cons, inT, decide_false,
            Bool.false_eq_true, ↓reduceIte]
          omega

/-! ## The queue of a run from X, and the stake a pass can move -/

/-- From Electra on, the funding sources are the pending consolidations. -/
private theorem fundingSources_eq {f : Fork} (electra : .pectra ≤ f) (s : BeaconState preset f) :
    fundingSources s = (s.pendingConsolidations electra).data.toList := by
  simp [fundingSources, electra]

/-- The queue is the unread part of X's queue, then entries that are new since X.

Every new entry has a source whose exit was assigned after `e0`, the epoch of X. -/
private def Shape (L : List PendingConsolidation) (e0 : Epoch) (n : ℕ) {f : Fork}
    (z : BeaconState preset f) : Prop :=
  ∃ N : List PendingConsolidation, fundingSources z = L.drop n ++ N ∧
    ∀ c ∈ N, ∃ w, z.validators.data[c.sourceIndex.toNat]? = some w ∧
      e0 < w.exitEpoch ∧ w.exitEpoch ≠ FAR_FUTURE_EPOCH

/-- An assigned exit stays fixed, so its queue entry still has a source that exited after `e0`. -/
private theorem carry_source_exit {e0 : Epoch} {i : ℕ} {f g : Fork}
    {a : BeaconState preset f} {b : BeaconState preset g} (life : RegistryLifecycle a b)
    (source : ∃ w, a.validators.data[i]? = some w ∧
      e0 < w.exitEpoch ∧ w.exitEpoch ≠ FAR_FUTURE_EPOCH) :
    ∃ w, b.validators.data[i]? = some w ∧
      e0 < w.exitEpoch ∧ w.exitEpoch ≠ FAR_FUTURE_EPOCH := by
  obtain ⟨w, read, later, assigned⟩ := source
  obtain ⟨w', read', kept⟩ := life.validators i w read
  exact ⟨w', read', by rw [kept.exitEpoch assigned]; exact ⟨later, assigned⟩⟩

/-- A state of any fork with the same queue and a later life of its validators has the shape. -/
private theorem Shape.carry {L : List PendingConsolidation} {e0 : Epoch} {n : ℕ} {f g : Fork}
    {a : BeaconState preset f} {b : BeaconState preset g} (shape : Shape L e0 n a)
    (queue : fundingSources b = fundingSources a) (life : RegistryLifecycle a b) :
    Shape L e0 n b := by
  obtain ⟨N, eq, new⟩ := shape
  exact ⟨N, queue.trans eq, fun c member => carry_source_exit life (new c member)⟩

/-- A block that grows the queue keeps the shape. -/
private theorem Shape.grow {L : List PendingConsolidation} {e0 : Epoch} {n : ℕ} {f : Fork}
    {a b : BeaconState preset f} (electra : .pectra ≤ f) (shape : Shape L e0 n a)
    (grows : ConsolidationQueueRise.Appends a b) (life : RegistryLifecycle a b)
    (started : e0 ≤ getCurrentEpoch a) :
    Shape L e0 n b := by
  obtain ⟨N, eq, new⟩ := shape
  obtain ⟨added, queue, fresh⟩ := grows electra
  refine ⟨N ++ added, by rw [fundingSources_eq electra, queue, ← fundingSources_eq electra, eq,
    List.append_assoc], fun c member => ?_⟩
  rcases List.mem_append.mp member with old | recent
  · exact carry_source_exit life (new c old)
  · obtain ⟨w, read, later, assigned⟩ := fresh c recent
    exact ⟨w, read, UInt64.lt_of_le_of_lt started later, assigned⟩

/-- A pass that reads `r` entries moves the shape on by `r`. -/
private theorem Shape.pass {L : List PendingConsolidation} {e0 : Epoch} {n r : ℕ} {f : Fork}
    {a b : BeaconState preset f} (shape : Shape L e0 n a)
    (queue : fundingSources b = (fundingSources a).drop r) (life : RegistryLifecycle a b) :
    Shape L e0 (n + r) b := by
  obtain ⟨N, eq, new⟩ := shape
  refine ⟨N.drop (r - (L.length - n)), ?_, fun c member => ?_⟩
  · rw [queue, eq, List.drop_append, List.drop_drop]
    simp [List.length_drop]
  · exact carry_source_exit life (new c (List.mem_of_mem_drop member))

/-- The stake that X lets a pending consolidation move: the cap of its source at X.

It counts only a source that is unslashed at X and can withdraw by `high + 1`. -/
private def capBound (x : ForkedBeaconState preset) (high : ℕ) (c : PendingConsolidation) : ℕ :=
  match x.state.validators.data[c.sourceIndex.toNat]? with
  | some v =>
    if v.slashed = false ∧ v.withdrawableEpoch.toNat ≤ high + 1 then
      (withdrawalMaxEffectiveBalance preset x.fork v).toNat
    else 0
  | none => 0

/-- A key that cannot switch to compounding credentials has a cap that does not rise. -/
private theorem withdrawalMax_le {f g : Fork} (hf : .pectra ≤ f) (hg : .pectra ≤ g)
    (caps : CapOrder preset) {v w : Validator}
    (frozen : hasCompoundingWithdrawalCredential w = true →
      hasCompoundingWithdrawalCredential v = true) :
    withdrawalMaxEffectiveBalance preset f w ≤ withdrawalMaxEffectiveBalance preset g v := by
  simp only [withdrawalMaxEffectiveBalance, hf, hg, ↓reduceIte, getMaxEffectiveBalance]
  by_cases hw : hasCompoundingWithdrawalCredential w = true
  · simp [hw, frozen hw]
  · by_cases hv : hasCompoundingWithdrawalCredential v = true
    · simp only [hw, hv, Bool.false_eq_true, ↓reduceIte]
      exact caps.compounding
    · simp only [hw, hv, Bool.false_eq_true, ↓reduceIte]
      exact UInt64.le_refl _

/-- What a run from X, at a state `p` of the epoch pass, knows about the pending consolidations. -/
private structure PassFacts (x : ForkedBeaconState preset) (high : ℕ) {f : Fork}
    (p : BeaconState preset f) : Prop where
  electraX : .pectra ≤ x.fork
  electraP : .pectra ≤ f
  caps : CapOrder preset
  delay : 0 < config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat
  within : high + 2 ≤ (getCurrentEpoch x.state).toNat +
    config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat
  life : RegistryLifecycle x.state p
  cap : Internal.CapStep config x.state p
  orderedX : PendingConsolidationsOrdered config (getCurrentEpoch x.state).toNat x.state
  invariantP : PendingConsolidationInvariant config p
  cappedX : ∀ v ∈ x.state.validators.data,
    v.effectiveBalance ≤ withdrawalMaxEffectiveBalance preset x.fork v
  next : (getCurrentEpoch p).toNat + 1 ≤ high + 1
  nextNat : (getCurrentEpoch p + 1).toNat = (getCurrentEpoch p).toNat + 1

/-- An entry of X's queue, still queued at the pass, moves at most its cap at X. -/
private theorem old_entry_bound {x : ForkedBeaconState preset} {high : ℕ} {f : Fork}
    {p : BeaconState preset f} (facts : PassFacts (config := config) x high p)
    {c : PendingConsolidation}
    (inX : c ∈ (x.state.pendingConsolidations facts.electraX).data.toList)
    (inP : c ∈ (p.pendingConsolidations facts.electraP).data.toList) :
    sourceBound p (getCurrentEpoch p + 1) c ≤ capBound x high c := by
  obtain ⟨v, foundX, -, -, assignedX⟩ := (facts.orderedX.1 facts.electraX).2 c inX
  obtain ⟨-, unslashedX, -⟩ := (facts.orderedX.2 facts.electraX).2 c inX v foundX
  obtain ⟨wP, foundP', -, exitDelayP, -⟩ := (facts.invariantP facts.electraP).2 c inP
  obtain ⟨w, foundP, lifecycle⟩ := facts.life.validators _ v foundX
  obtain rfl : w = wP := Option.some.inj (foundP.symm.trans foundP')
  simp only [sourceBound, capBound, foundP, foundX]
  split
  · rename_i due
    have exitEq := lifecycle.exitEpoch assignedX
    have slashedX : v.slashed = false := by
      cases flag : v.slashed
      · rfl
      · have := ((facts.cap.withdrawal _ v w foundX foundP).1 flag assignedX).1
        rw [due.1] at this
        cases this
    have dueNat := UInt64.le_iff_toNat_le.mp due.2
    have withdrawX := unslashedX slashedX
    rw [facts.nextNat] at dueNat
    have exitNat := congrArg UInt64.toNat exitEq
    have exitDelay : w.exitEpoch.toNat + config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat ≤
        w.withdrawableEpoch.toNat := exitDelayP
    have dueX : v.slashed = false ∧ v.withdrawableEpoch.toNat ≤ high + 1 :=
      ⟨slashedX, by have := facts.next; omega⟩
    simp only [dueX, and_self, ↓reduceIte]
    have capped : w.effectiveBalance ≤ withdrawalMaxEffectiveBalance preset f w :=
      facts.cap.capped facts.cappedX w (Array.mem_of_getElem? foundP)
    have bounded := withdrawalMax_le facts.electraP facts.electraX facts.caps
      ((facts.cap.frozen _ v w foundX foundP assignedX).2)
    exact UInt64.le_iff_toNat_le.mp (UInt64.le_trans capped bounded)
  · exact Nat.zero_le _

/-- An entry that is new since X moves nothing at the pass.

Its source exits after X, so it withdraws after the run. -/
private theorem new_entry_zero {x : ForkedBeaconState preset} {high : ℕ} {f : Fork}
    {p : BeaconState preset f} (facts : PassFacts (config := config) x high p)
    {c : PendingConsolidation}
    (inP : c ∈ (p.pendingConsolidations facts.electraP).data.toList) {w : Validator}
    (foundW : p.validators.data[c.sourceIndex.toNat]? = some w)
    (fresh : getCurrentEpoch x.state < w.exitEpoch) :
    sourceBound p (getCurrentEpoch p + 1) c = 0 := by
  obtain ⟨w', found', -, exitDelay, -⟩ := (facts.invariantP facts.electraP).2 c inP
  obtain rfl : w' = w := Option.some.inj (found'.symm.trans foundW)
  have later := UInt64.lt_iff_toNat_lt.mp fresh
  simp only [sourceBound, foundW]
  split
  · rename_i due
    have dueNat := UInt64.le_iff_toNat_le.mp due.2
    rw [facts.nextNat] at dueNat
    have := facts.next
    have := facts.within
    have := facts.delay
    omega
  · rfl

/-- A pass, from a state with the shape, credits the targets in `T` at most the caps at X.

The caps are those of the entries it reads whose target is in `T`. -/
private theorem pass_step_targets {x : ForkedBeaconState preset} {high : ℕ} {f : Fork}
    {p t : BeaconState preset f} {n : ℕ} (facts : PassFacts (config := config) x high p)
    (shape : Shape (x.state.pendingConsolidations facts.electraX).data.toList
      (getCurrentEpoch x.state) n p)
    (computed : processPendingConsolidations p facts.electraP = .ok t) :
    ∃ r, Shape (x.state.pendingConsolidations facts.electraX).data.toList
        (getCurrentEpoch x.state) (n + r) t ∧ RegistryLifecycle p t ∧
      ∀ T : Finset ℕ, creditedAt T p t ≤
        (((((x.state.pendingConsolidations facts.electraX).data.toList.drop n).take r).filter
          fun c => c.targetIndex.toNat ∈ T).map (capBound x high)).sum := by
  obtain ⟨result, passed, balancesEq, queueEq⟩ := processPendingConsolidations_pass computed
  have sameValidators := (processPendingConsolidations_kept computed).1
  have life : RegistryLifecycle p t := .of_data (congrArg (·.data) sameValidators)
  have queue : fundingSources t = (fundingSources p).drop result.2 := by
    rw [fundingSources_eq facts.electraP, fundingSources_eq facts.electraP]
    exact queueEq
  refine ⟨result.2, shape.pass queue life, life, fun T => ?_⟩
  obtain ⟨validators, sizes, credits⟩ :=
    pass_credits_le_targets (getCurrentEpoch p + 1) T _ passed
  have creditsEq : creditedAt T p t = creditedAt T p result.1 := by
    simp [creditedAt, actualBalanceAt, balancesEq]
  rw [creditsEq]
  refine Nat.le_trans credits ?_
  obtain ⟨N, eq, new⟩ := shape
  rw [← fundingSources_eq facts.electraP, eq, List.take_append, List.filter_append,
    List.map_append, List.sum_append]
  have oldPart : (((((x.state.pendingConsolidations facts.electraX).data.toList.drop n).take
      result.2).filter fun c => c.targetIndex.toNat ∈ T).map
        (sourceBound p (getCurrentEpoch p + 1))).sum ≤
      (((((x.state.pendingConsolidations facts.electraX).data.toList.drop n).take
        result.2).filter fun c => c.targetIndex.toNat ∈ T).map (capBound x high)).sum := by
    apply List.sum_le_sum
    intro c member
    have inDrop := List.mem_of_mem_take (List.mem_of_mem_filter member)
    refine old_entry_bound facts (List.mem_of_mem_drop inDrop) ?_
    rw [← fundingSources_eq facts.electraP, eq]
    exact List.mem_append_left _ inDrop
  have newPart : (((N.take (result.2 -
      ((x.state.pendingConsolidations facts.electraX).data.toList.drop n).length)).filter
        fun c => c.targetIndex.toNat ∈ T).map
        (sourceBound p (getCurrentEpoch p + 1))).sum = 0 := by
    apply List.sum_eq_zero
    intro m member
    obtain ⟨c, inTake, rfl⟩ := List.mem_map.mp member
    have inN := List.mem_of_mem_take (List.mem_of_mem_filter inTake)
    obtain ⟨w, foundW, fresh, -⟩ := new c inN
    refine new_entry_zero facts ?_ foundW fresh
    rw [← fundingSources_eq facts.electraP, eq]
    exact List.mem_append_right _ inN
  omega

/-- The upgrades due at a slot keep the shape of the queue. -/
private theorem upgrade_shape {L : List PendingConsolidation} {e0 : Epoch} {n : ℕ}
    {pre : ForkedBeaconState preset}
    {post : {post : ForkedBeaconState preset // pre.fork < post.fork}}
    (electra : .pectra ≤ pre.fork) (shape : Shape L e0 n pre.state)
    (ok : upgradeNext config checks pre = .ok post) (early : post.val.fork < .glamsterdam) :
    .pectra ≤ post.val.fork ∧ Shape L e0 n post.val.state := by
  obtain ⟨fork, state⟩ := pre
  cases fork <;>
    simp only [upgradeNext, bind_ok_iff, pure, Except.pure, Except.ok.injEq, throw,
      throwThe, MonadExceptOf.throw, reduceCtorEq] at ok
  · exact absurd electra (Nat.not_le_of_lt (by decide : Fork.phase0 < Fork.pectra))
  · exact absurd electra (Nat.not_le_of_lt (by decide : Fork.altair < Fork.pectra))
  · exact absurd electra (Nat.not_le_of_lt (by decide : Fork.bellatrix < Fork.pectra))
  · exact absurd electra (Nat.not_le_of_lt (by decide : Fork.shapella < Fork.pectra))
  · exact absurd electra (Nat.not_le_of_lt (by decide : Fork.dencun < Fork.pectra))
  · obtain ⟨_, upgraded, rfl⟩ := ok
    refine ⟨(by decide : Fork.pectra ≤ Fork.fusaka),
      shape.carry ?_ (.of_data (upgradeToFulu_spec upgraded).1)⟩
    simp only [upgradeToFulu, bind_ok_iff, pure, Except.pure, Except.ok.injEq] at upgraded
    obtain ⟨_, -, rfl⟩ := upgraded
    simp [fundingSources, carryFields, carryList, carryRooted,
      show Fork.pectra ≤ Fork.fusaka from by decide]
  · obtain ⟨_, _, rfl⟩ := ok
    exact False.elim (Nat.lt_irrefl _ early)
  · obtain ⟨_, _, rfl⟩ := ok
    exact False.elim (Nat.not_le_of_lt early (show Fork.glamsterdam ≤ .hegota from by decide))

/-- All the upgrades of a step keep the shape of the queue, as each one does. -/
private theorem upgrades_shape {L : List PendingConsolidation} {e0 : Epoch} {n : ℕ}
    {advanced last : ForkedBeaconState preset} (electra : .pectra ≤ advanced.fork)
    (early : last.fork < .glamsterdam) (shape : Shape L e0 n advanced.state)
    (ok : processUpgrades config checks advanced = .ok last) : Shape L e0 n last.state := by
  have rest := processUpgrades_induction
    (property := fun z => z.fork < .glamsterdam → .pectra ≤ z.fork ∧ Shape L e0 n z.state)
    (fun {pre post} h ok early => by
      obtain ⟨electraPre, shapePre⟩ := h (Nat.lt_trans post.property early)
      exact upgrade_shape electraPre shapePre ok early)
    (fun _ => ⟨electra, shape⟩) ok
  exact (rest early).2

/-! ## The stages of an epoch -/

/-- The order of the pending consolidations of a state at its own epoch. -/
private abbrev OrderedAt {f : Fork} (config : Config) (s : BeaconState preset f) : Prop :=
  PendingConsolidationsOrdered config (getCurrentEpoch s).toNat s

/-- A stage other than the pass keeps the slot, the queue and the order, and the lifecycle. -/
private theorem stage_rel {f : Fork} (electra : .pectra ≤ f) {k : EpochStage}
    (notPass : k ≠ .pendingConsolidations) {a b : BeaconState preset f}
    (edge : EpochStage.Edge config checks k a b) :
    RegistryLifecycle a b ∧ b.slot = a.slot ∧ fundingSources b = fundingSources a ∧
      (OrderedAt config a → OrderedAt config b) := by
  refine ⟨edge.registryLifecycle, edge.slot_eq, ?_, edge.pendingConsolidationsOrdered⟩
  rw [fundingSources_eq electra, fundingSources_eq electra,
    show b.pendingConsolidations = a.pendingConsolidations from edge.samePendingQueue notPass]

/-- The stages before the pass, from the cached state, keep what the pass reads. -/
private theorem prefix_rel {f : Fork} (electra : .pectra ≤ f) {stages : List EpochStage}
    (notPass : ∀ k ∈ stages, k ≠ .pendingConsolidations) {a b : BeaconState preset f}
    (trace : EpochTrace (EpochStage.action config checks) stages a b) :
    RegistryLifecycle a b ∧ b.slot = a.slot ∧ fundingSources b = fundingSources a ∧
      (OrderedAt config a → OrderedAt config b) := by
  apply trace.transport
    (fun a b : BeaconState preset f => RegistryLifecycle a b ∧ b.slot = a.slot ∧
      fundingSources b = fundingSources a ∧ (OrderedAt config a → OrderedAt config b))
    (fun _ => ⟨.refl _, rfl, rfl, id⟩)
    (fun one two => ⟨one.1.trans two.1, two.2.1.trans one.2.1, two.2.2.1.trans one.2.2.1,
      two.2.2.2 ∘ one.2.2.2⟩)
  intro k member s t computed
  exact stage_rel electra (notPass k member) (EpochStage.action_cases.mp computed)

/-- The events that the replay of the rewards records are rewards, penalties or inactivity. -/
private theorem rewards_noConsolidations {f : Fork} {pre post : BalanceReplay preset f}
    (initial : ∀ e ∈ pre.2, e.source ≠ .consolidations)
    (ok : replayRewards (config := config) pre = .ok post) :
    ∀ e ∈ post.2, e.source ≠ .consolidations := by
  have record {pre post : BalanceReplay preset f} {source : BalanceSource}
      {limits : BeaconState preset f → Except TransitionError (Nat × Nat)}
      {action : BeaconState preset f → Except TransitionError (BeaconState preset f)}
      (notConsolidation : source ≠ .consolidations)
      (initial : ∀ e ∈ pre.2, e.source ≠ .consolidations)
      (ok : recordBalance source limits action pre = .ok post) :
      ∀ e ∈ post.2, e.source ≠ .consolidations := fun e member => by
    rcases (PinEventsKept.recordBalance_cases ok).2.1 e member with old | new
    · exact initial e old
    · exact new ▸ notConsolidation
  exact replayRewards_induction (fun pre => ∀ e ∈ pre.2, e.source ≠ .consolidations)
    (fun prior ok => record (by decide) prior ok)
    (fun penalty prior ok => record (by rcases penalty with rfl | rfl <;> decide) prior ok)
    initial ok

/-- The queue of X. -/
private abbrev queueX (x : ForkedBeaconState preset) (h : .pectra ≤ x.fork) :
    List PendingConsolidation :=
  (x.state.pendingConsolidations h).data.toList

/-- A slot step moves the shape of the queue on.

It credits the targets in `T` at most the caps of the entries it reads that have such a target. -/
private theorem slot_step_targets {g x m last : ForkedBeaconState preset}
    (shared : Run config checks g x) (pre : Run config checks x m)
    (genesis : Genesis (config := config) (checks := checks) g) (caps : CapOrder preset)
    (delay : 0 < config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat) (electra : .pectra ≤ x.fork)
    (high : ℕ) (within : high + 2 ≤ (getCurrentEpoch x.state).toNat +
      config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    (ok : advanceSlotAcross config checks m = .ok last) (early : last.fork < .glamsterdam)
    (endEpoch : (getCurrentEpoch last.state).toNat ≤ high + 1) {n : ℕ}
    (shape : Shape (queueX x electra) (getCurrentEpoch x.state) n m.state) :
    ∃ r, Shape (queueX x electra) (getCurrentEpoch x.state) (n + r) last.state ∧
      ∀ {events : List (BalanceEvent preset)},
        (Step.slot ok : Step config checks m last).balanceEvents = .ok events →
        ∀ T : Finset ℕ,
          (T.sum fun i => ((events.filter (·.source = .consolidations)).map (keyCredit i)).sum) ≤
            (((((queueX x electra).drop n).take r).filter fun c => c.targetIndex.toNat ∈ T).map
              (capBound x high)).sum := by
  have beforeFork : m.fork < .glamsterdam :=
    Nat.lt_of_le_of_lt (Step.slot ok).chainStep.fork_le early
  have mFork : .pectra ≤ m.fork := Nat.le_trans electra (fork_le_of_chainSteps pre.chainSteps)
  obtain ⟨advanced, slotOk, upgrades⟩ := bind_ok_iff.mp ok
  obtain ⟨crossings, crossingOk, -⟩ := upgradeBalanceReplay_bounded upgrades
  have advanceCopy := slotOk
  simp only [advanceSlot, bind_ok_iff, pure, Except.pure, Except.ok.injEq] at advanceCopy
  obtain ⟨next, nextOk, cached, cachedOk, epoched, epochOk, afterEq⟩ := advanceCopy
  have sum : next.toNat = m.state.slot.toNat + 1 :=
    (Uint64.addChecked_ok_iff.mp (mapError_ok_iff.mp (liftAccessor_ok.mp nextOk))).2
  obtain ⟨_, _, _, _, cachedEq⟩ := processSlot_ok cachedOk
  have shapeCached : Shape (queueX x electra) (getCurrentEpoch x.state) n cached := by
    rw [cachedEq]; exact shape
  by_cases boundary : next % preset.SLOTS_PER_EPOCH = 0
  · simp only [epochIfLast, boundary, ↓reduceIte] at epochOk
    obtain ⟨middle, updated, recorded, recordOk, updatedOk, validators, balances, cutOk⟩ :=
      epochBalanceReplay_result_before cached epoched beforeFork epochOk
    obtain ⟨justified, scored, rewarded, registered, slashed, reset, deposited, rewardEvents,
      limit, trace6, justifiedOk, scoredOk, rewardedOk, registeredOk, slashedOk, resetOk,
      depositedOk, consolidatedOk, rewardReplay, recordedEq⟩ := funding_epoch_site cutOk recordOk
    have trace7 : EpochTrace (EpochStage.action config checks)
        [.justification, .inactivity, .rewards, .registry, .slashings, .eth1Reset,
          .pendingDeposits] cached deposited :=
      EpochTrace.append_iff.mpr
        ⟨reset, trace6, .cons (EpochStage.action_cases.mpr depositedOk) .nil⟩
    simp only [EpochStage.Edge, mFork, ↓reduceDIte] at consolidatedOk
    simp only [mFork, ↓reduceDIte] at recordedEq
    -- The facts about the run before the step.
    have xEarly : x.fork < .glamsterdam :=
      Nat.lt_of_le_of_lt (fork_le_of_chainSteps pre.chainSteps) beforeFork
    have lifeXM : RegistryLifecycle x.state m.state := pre.registryLifecycle
    have capXM := (Internal.CapStep.run pre caps.activation caps.compounding beforeFork).1
    have orderedM : OrderedAt config m.state :=
      (shared.append pre).pendingConsolidationsOrdered genesis beforeFork delay
    have orderedX := shared.pendingConsolidationsOrdered genesis xEarly delay
    have cappedX := shared.effectiveBalance_capped genesis caps.activation caps.compounding xEarly
    -- The cached state is the state of the step, up to its roots.
    have lifeMC : RegistryLifecycle m.state cached := .of_data (by rw [cachedEq])
    have slotMC : cached.slot = m.state.slot := by rw [cachedEq]
    have queueMC : fundingSources cached = fundingSources m.state := by rw [cachedEq]; rfl
    have orderedC : OrderedAt config cached := by rw [cachedEq]; exact orderedM
    have capMC : Internal.CapStep config m.state cached := by
      rw [cachedEq]; exact Internal.CapStep.data
    -- The stages up to the pass.
    obtain ⟨lifeCD, slotCD, queueCD, orderedCD⟩ := prefix_rel mFork (by
      intro k member
      simp only [List.mem_cons, List.not_mem_nil, or_false] at member
      rcases member with rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> exact fun h => by cases h)
      trace7
    have capCD := Internal.CapStep.epochTrace trace7
    have epochD : getCurrentEpoch deposited = getCurrentEpoch m.state := by
      simp only [getCurrentEpoch, slotCD, slotMC]
    -- The epoch of the next state.
    have epochLast : (getCurrentEpoch last.state).toNat = (getCurrentEpoch m.state).toNat + 1 := by
      have advancedEpoch : getCurrentEpoch last.state = getCurrentEpoch
          ({ epoched with slot := next } : BeaconState preset m.fork) := by
        rw [afterEq]
        exact congrArg (computeEpochAtSlot preset) (processUpgrades_slot upgrades)
      rw [advancedEpoch]
      have nextEpoch :=
        getCurrentEpoch_toNat ({ epoched with slot := next } : BeaconState preset m.fork)
      simp only at nextEpoch
      rw [nextEpoch, getCurrentEpoch_toNat m.state]
      exact nextSlot_epoch_of_boundary sum boundary
    have nextBound : (getCurrentEpoch deposited).toNat + 1 ≤ high + 1 := by
      rw [epochD]; omega
    have nextNat :
        (getCurrentEpoch deposited + 1).toNat = (getCurrentEpoch deposited).toNat + 1 := by
      have fits := (getCurrentEpoch last.state).toNat_lt
      rw [UInt64.toNat_add, UInt64.toNat_one, Nat.mod_eq_of_lt]
      rw [epochD]; omega
    have facts : PassFacts (config := config) x high deposited :=
      { electraX := electra, electraP := mFork, caps := caps, delay := delay, within := within,
        life := lifeXM.trans (lifeMC.trans lifeCD), cap := capXM.trans (capMC.trans capCD),
        orderedX := orderedX, invariantP := (orderedCD orderedC).1, cappedX := cappedX,
        next := nextBound, nextNat := nextNat }
    have shapeD : Shape (queueX x electra) (getCurrentEpoch x.state) n deposited :=
      shapeCached.carry queueCD lifeCD
    obtain ⟨r, shapeMiddle, lifePM, credits⟩ := pass_step_targets facts shapeD consolidatedOk
    refine ⟨r, ?_, fun {events} replayed T => ?_⟩
    · have trace := processEpoch_trace epochOk
      change EpochTrace _ (EpochStage.prefixStages ++ [.payments, .effectiveBalances,
        .slashingsReset, .randaoReset, .history, .participation, .syncCommittees,
        .proposerLookahead, .ptcWindow]) _ _ at trace
      obtain ⟨middle', head, tailTrace⟩ := EpochTrace.append_iff.mp trace
      have midEq : middle' = middle := by
        have h1 : epochBeforePayments config checks cached = .ok middle' :=
          (epochBeforePayments_eq_run config checks cached).trans
            (EpochTrace.run_ok_iff.mpr head)
        rw [h1] at cutOk
        exact Except.ok.inj cutOk
      subst midEq
      obtain ⟨lifeTail, -, queueTail, -⟩ := prefix_rel mFork (by
        intro k member
        simp only [List.mem_cons, List.not_mem_nil, or_false] at member
        rcases member with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
          exact fun h => by cases h) tailTrace
      have shapeEpoched := shapeMiddle.carry queueTail lifeTail
      have shapeAdvanced : Shape (queueX x electra) (getCurrentEpoch x.state) (n + r)
          advanced := by
        rw [← afterEq]
        exact shapeEpoched.carry rfl (.of_data rfl)
      exact upgrades_shape (advanced := ⟨m.fork, advanced⟩) mFork early shapeAdvanced upgrades
    · have eventsEq : events = recorded ++ crossings :=
        Except.ok.inj (replayed.symm.trans (Step.balanceEvents_epoch_slot ok cachedOk nextOk
          boundary recordOk slotOk crossingOk))
      have rewardsNo := rewards_noConsolidations (pre := (scored, [])) (by simp) rewardReplay
      have f1 : rewardEvents.filter (fun e => decide (e.source = .consolidations)) = [] :=
        List.filter_eq_nil_iff.mpr fun e member => by simpa using rewardsNo e member
      have f2 : crossings.filter (fun e => decide (e.source = .consolidations)) = [] :=
        List.filter_eq_nil_iff.mpr fun e member => by
          simp [upgradeBalanceReplay_crossing crossingOk e member]
      rw [eventsEq, recordedEq]
      simp only [List.append_assoc, List.filter_append, f1, f2]
      simpa [List.filter_cons, creditedAt, keyCredit, actualBalanceAt] using credits T
  · simp only [epochIfLast, boundary, ↓reduceIte, pure, Except.pure, Except.ok.injEq] at epochOk
    subst epochOk
    refine ⟨0, ?_, fun {events} replayed T => ?_⟩
    · have shapeAdvanced : Shape (queueX x electra) (getCurrentEpoch x.state) (n + 0)
          advanced := by
        rw [← afterEq]
        exact shapeCached.carry rfl (.of_data rfl)
      exact upgrades_shape (advanced := ⟨m.fork, advanced⟩) mFork early shapeAdvanced upgrades
    · have eventsEq : events = crossings := by
        simpa [Step.balanceEvents, cachedOk, nextOk, boundary, slotOk, crossingOk, pure,
          Except.pure,
          bind, Except.bind] using replayed.symm
      subst eventsEq
      have none : (events.filter (·.source = .consolidations)) = [] := by
        rw [List.filter_eq_nil_iff]
        intro e member
        simp [upgradeBalanceReplay_crossing crossingOk e member]
      simp [none]

/-- A block keeps the shape of the queue: it only appends entries that are new since X. -/
private theorem block_step {f : Fork} {e0 : Epoch} {L : List PendingConsolidation} {n : ℕ}
    (electra : .pectra ≤ f) (early : f < .glamsterdam)
    (delay : 1 ≤ config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    {engine : ExecutionEngine preset f} {signed : SignedBeaconBlock preset f}
    {s t : BeaconState preset f}
    (ok : applySignedBlock config checks engine s signed true = .ok t)
    (started : e0 ≤ getCurrentEpoch s) (shape : Shape L e0 n s) : Shape L e0 n t := by
  have grown := ConsolidationQueueRise.appendStep_processBlock (Nat.le_trans (by decide) electra)
    early delay (applySignedBlock_ok ok).2.1
  exact shape.grow electra grown.2.2 grown.2.1 started

/-- The consolidation credits of a run from X to the targets in `T` are within the caps.

The caps are those of the entries it reads whose target is in `T`. -/
private theorem run_credits_targets {g x y : ForkedBeaconState preset}
    (shared : Run config checks g x) (genesis : Genesis (config := config) (checks := checks) g)
    (caps : CapOrder preset) (delay : 0 < config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    (electra : .pectra ≤ x.fork) (high : ℕ)
    (within : high + 2 ≤ (getCurrentEpoch x.state).toNat +
      config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    (tail : Run config checks x y) (early : y.fork < .glamsterdam)
    (endEpoch : (getCurrentEpoch y.state).toNat ≤ high + 1)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events) :
    ∃ n, Shape (queueX x electra) (getCurrentEpoch x.state) n y.state ∧
      ∀ T : Finset ℕ,
        (T.sum fun i => ((events.filter (·.source = .consolidations)).map (keyCredit i)).sum) ≤
          ((((queueX x electra).take n).filter fun c => c.targetIndex.toNat ∈ T).map
            (capBound x high)).sum := by
  induction tail generalizing events with
  | nil =>
    cases replayed
    refine ⟨0, ⟨[], ?_, fun c member => by simp at member⟩, fun T => by simp⟩
    rw [fundingSources_eq electra]
    simp [queueX]
  | @snoc middle last pre step ih =>
    simp only [Run.balanceEvents, bind_ok_iff] at replayed
    obtain ⟨prior, priorOk, rest⟩ := replayed
    have epochStep := UInt64.le_iff_toNat_le.mp step.chainStep.currentEpoch_le
    obtain ⟨n, shape, bound⟩ := ih (Nat.lt_of_le_of_lt step.chainStep.fork_le early)
      (by omega) priorOk
    have inFork : .pectra ≤ middle.fork :=
      Nat.le_trans electra (fork_le_of_chainSteps pre.chainSteps)
    have started : getCurrentEpoch x.state ≤ getCurrentEpoch middle.state :=
      currentEpoch_le_of_chainSteps pre.chainSteps
    have beforeFork : middle.fork < .glamsterdam :=
      Nat.lt_of_le_of_lt step.chainStep.fork_le early
    have growth : ∀ {r : ℕ} {T : Finset ℕ},
        ((((queueX x electra).take n).filter fun c => c.targetIndex.toNat ∈ T).map
          (capBound x high)).sum +
        (((((queueX x electra).drop n).take r).filter fun c => c.targetIndex.toNat ∈ T).map
          (capBound x high)).sum =
        ((((queueX x electra).take (n + r)).filter fun c => c.targetIndex.toNat ∈ T).map
          (capBound x high)).sum := by
      intro r T
      rw [List.take_add, List.filter_append, List.map_append, List.sum_append]
    have stepResult : ∃ r, Shape (queueX x electra) (getCurrentEpoch x.state) (n + r) last.state ∧
        ∀ {added : List (BalanceEvent preset)}, step.balanceEvents = .ok added → ∀ T : Finset ℕ,
          (T.sum fun i => ((added.filter (·.source = .consolidations)).map (keyCredit i)).sum) ≤
            (((((queueX x electra).drop n).take r).filter fun c => c.targetIndex.toNat ∈ T).map
              (capBound x high)).sum := by
      cases step with
      | block engine signed due ok =>
        refine ⟨0, block_step inFork early (by omega) ok started shape, fun {added} addedOk T => ?_⟩
        have none : (added.filter (·.source = .consolidations)) = [] :=
          List.filter_eq_nil_iff.mpr fun e member => by
            simpa using blockReplay_noConsolidations inFork early engine _ _
              (Step.balanceEvents_block early addedOk) e member
        simp [none]
      | slot ok =>
        obtain ⟨r, shapeLast, credits⟩ := slot_step_targets shared pre genesis caps delay electra
          high within ok early endEpoch shape
        exact ⟨r, shapeLast, fun {added} addedOk => credits addedOk⟩
    obtain ⟨r, shapeLast, credits⟩ := stepResult
    refine ⟨n + r, shapeLast, fun T => ?_⟩
    have bound := bound T
    by_cases selected : (getCurrentEpoch middle.state).toNat ≤ high + 1
    · simp only [selected, ↓reduceIte, bind_ok_iff, pure, Except.pure, Except.ok.injEq] at rest
      obtain ⟨added, addedOk, rfl⟩ := rest
      have := credits addedOk T
      have growth' := growth (r := r) (T := T)
      simp only [List.filter_append, List.map_append, List.sum_append, Finset.sum_add_distrib]
      omega
    · simp only [selected, ↓reduceIte, pure, Except.pure, Except.ok.injEq] at rest
      subst rest
      have growth' := growth (r := r) (T := T)
      omega

/-- The caps of the entries of a queue, as the caps of their sources that X lets move. -/
private theorem capBound_sum (x : ForkedBeaconState preset) (high : ℕ)
    (queue : List PendingConsolidation) :
    (queue.map (capBound x high)).sum =
      ((((queue.filterMap fun c => x.state.validators.data[c.sourceIndex.toNat]?).filter
        fun v => !v.slashed && decide (v.withdrawableEpoch.toNat ≤ high + 1)).map
          fun v => (withdrawalMaxEffectiveBalance preset x.fork v).toNat).sum) := by
  induction queue with
  | nil => simp
  | cons c rest ih =>
    cases lookup : x.state.validators.data[c.sourceIndex.toNat]? with
    | none => simpa [capBound, lookup] using ih
    | some v =>
      by_cases due : v.slashed = false ∧ v.withdrawableEpoch.toNat ≤ high + 1
      · simp [capBound, lookup, due, ih]
      · have : ¬ (!v.slashed && decide (v.withdrawableEpoch.toNat ≤ high + 1)) = true := by
          simpa [Bool.not_eq_true'] using due
        simp [capBound, lookup, due, this, ih]

/-! ## Credits to exiting keys, by pass -/

/-- No deposit credits a key that is exited and not withdrawable at each deposit event of a run.

`exitedAt` is that fact at the state before each deposit event of a slot step.

A block deposit needs none: from Electra it raises no balance. -/
private theorem Run.exiting_deposit_credit_zero_of_exited {x y : ForkedBeaconState preset}
    (tail : Run config checks x y) (electra : .pectra ≤ x.fork) (early : y.fork < .glamsterdam)
    (high : ℕ) {events : List (BalanceEvent preset)}
    (replayed : tail.balanceEvents high = .ok events) (i : ℕ)
    (exitedAt : ∀ {u w : ForkedBeaconState preset} (ok : advanceSlotAcross config checks u = .ok w),
      tail.Contains (Step.slot ok) → ∀ {es : List (BalanceEvent preset)},
        (Step.slot ok : Step config checks u w).balanceEvents = .ok es →
        ∀ e ∈ es, e.source = .deposits → ∃ v : Validator,
          e.before.state.validators.data[i]? = some v ∧ v.exitEpoch.toNat < 2 ^ 64 - 1 ∧
          (getCurrentEpoch e.before.state).toNat < v.withdrawableEpoch.toNat) :
    ((events.filter (·.source = .deposits)).map (keyCredit i)).sum = 0 := by
  have located := (run_located tail electra early high replayed).1
  apply List.sum_eq_zero
  intro n member
  obtain ⟨e, filtered, rfl⟩ := List.mem_map.mp member
  obtain ⟨inEvents, sourceEq⟩ := List.mem_filter.mp filtered
  simp only [decide_eq_true_eq] at sourceEq
  rcases located e inEvents sourceEq with unconditional | ⟨u, w, ok, es, contains, replayedEs,
      inStep, keeps⟩
  · have := unconditional i
    simp only [keyCredit]
    omega
  · obtain ⟨v, read, exited, held⟩ := exitedAt ok contains replayedEs e inStep sourceEq
    have same := keeps i v read exited held
    simp [keyCredit, actualBalanceAt, same]

/-- The deposit bound along a run.

Along C's run, no deposit credits a key that exits at the run's start.

The key stays not withdrawable through the run's end.

`kept` is the withdrawable-kept fact at the state before each deposit event of a slot step.

A block deposit needs none: from Electra it raises no balance.

It says that an assigned exit stays (`RegistryLifecycle`).

It says that once the exit is set, the withdrawable epoch only rises (`WithdrawableKept`).

It also says that the epoch of each event's state is at most the run's last epoch. -/
private theorem Run.exiting_deposit_credit_zero_of_kept {x y : ForkedBeaconState preset}
    (tail : Run config checks x y) (electra : .pectra ≤ x.fork) (early : y.fork < .glamsterdam)
    (high : ℕ) {events : List (BalanceEvent preset)}
    (replayed : tail.balanceEvents high = .ok events)
    (kept : ∀ {u w : ForkedBeaconState preset} (ok : advanceSlotAcross config checks u = .ok w),
      tail.Contains (Step.slot ok) → ∀ {es : List (BalanceEvent preset)},
        (Step.slot ok : Step config checks u w).balanceEvents = .ok es →
        ∀ e ∈ es, e.source = .deposits →
          RegistryLifecycle x.state e.before.state ∧ WithdrawableKept x.state e.before.state ∧
          getCurrentEpoch e.before.state ≤ getCurrentEpoch y.state)
    (i : ℕ) (v : Validator) (found : x.state.validators.data[i]? = some v)
    (exited : v.exitEpoch.toNat < 2 ^ 64 - 1)
    (held : (getCurrentEpoch y.state).toNat < v.withdrawableEpoch.toNat) :
    ((events.filter (·.source = .deposits)).map (keyCredit i)).sum = 0 :=
  Run.exiting_deposit_credit_zero_of_exited tail electra early high replayed i
    (by
      intro u w ok contains es replayedEs e inStep sourceEq
      obtain ⟨life, withdrawal, epoch⟩ := kept ok contains replayedEs e inStep sourceEq
      obtain ⟨w, read, lifecycle⟩ := life.validators i v found
      have assigned : v.exitEpoch ≠ FAR_FUTURE_EPOCH := fun far => by
        rw [far] at exited
        exact absurd exited (Nat.lt_irrefl _)
      have sameExit := lifecycle.exitEpoch assigned
      have later := UInt64.le_iff_toNat_le.mp (withdrawal i v w found read assigned).1
      have now := UInt64.le_iff_toNat_le.mp epoch
      exact ⟨w, read, by rw [sameExit]; exact exited, by omega⟩)

/-- Along C's run from Fulu, no deposit credits a key that exits at the run's start.

The key stays not withdrawable through the run's end.

The withdrawable-kept fact at each deposit event of a slot step is `Run.events_kept`. -/
private theorem Run.exiting_deposit_credit_zero {g x y : ForkedBeaconState preset}
    (shared : Run config checks g x) (genesis : Genesis (config := config) (checks := checks) g)
    (tail : Run config checks x y) (fulu : .fusaka ≤ x.fork) (early : y.fork < .glamsterdam)
    (high : ℕ) {events : List (BalanceEvent preset)}
    (replayed : tail.balanceEvents high = .ok events)
    (i : ℕ) (v : Validator) (found : x.state.validators.data[i]? = some v)
    (exited : v.exitEpoch.toNat < 2 ^ 64 - 1)
    (held : (getCurrentEpoch y.state).toNat < v.withdrawableEpoch.toNat) :
    ((events.filter (·.source = .deposits)).map (keyCredit i)).sum = 0 :=
  Run.exiting_deposit_credit_zero_of_kept tail (Nat.le_trans (by decide) fulu) early high replayed
    (fun {_ _} ok contained {_} replayedEs e member source =>
      let kept := PinEventsKept.Run.events_kept shared genesis tail fulu early ok contained
        replayedEs
        e member source
      ⟨kept.1, kept.2.1, kept.2.2.1⟩)
    i v found exited held

/-- A step that starts a key's exit credits no deposit to it.

A slot step's pending deposits come after its registry updates, which postpone the key.

The exit and withdrawable epochs at the step's end are those at the input of its deposits. -/
private theorem Step.charge_deposit_credit_zero {a b : ForkedBeaconState preset}
    (step : Step config checks a b) (fulu : .fusaka ≤ a.fork) (early : b.fork < .glamsterdam)
    {events : List (BalanceEvent preset)} (replayed : step.balanceEvents = .ok events)
    (i : ℕ) (inside : i < a.state.validators.data.size) (w : Validator)
    (found : b.state.validators.data[i]? = some w) (exited : w.exitEpoch.toNat < 2 ^ 64 - 1)
    (held : (getCurrentEpoch b.state).toNat < w.withdrawableEpoch.toNat) :
    ((events.filter (·.source = .deposits)).map (keyCredit i)).sum = 0 := by
  refine Run.exiting_deposit_credit_zero_of_exited (Run.nil.snoc step)
    (Nat.le_trans (by decide) fulu) early (getCurrentEpoch b.state).toNat
    (DirectSafety.Apriori.Internal.single_balanceEvents step replayed) i ?_
  intro u w' ok contains es replayedEs e member source
  cases contains with
  | last =>
    obtain ⟨kept, -, same, stay, -⟩ :=
      PinEventsKept.Step.deposit_input ok fulu early replayedEs e member source
    obtain ⟨v, readV⟩ : ∃ v, e.before.state.validators.data[i]? = some v :=
      ⟨_, Array.getElem?_eq_getElem (Nat.lt_of_lt_of_le inside kept.life.size_le)⟩
    obtain ⟨w'', read, exit, wd⟩ := stay i v readV
    rw [found, Option.some.injEq] at read
    subst read
    have epochLe := UInt64.le_iff_toNat_le.mp
      (Step.slot ok : Step config checks a b).chainStep.currentEpoch_le
    refine ⟨v, readV, by rw [← exit]; exact exited, ?_⟩
    rw [same, ← wd]
    omega
  | earlier member _ => cases member

/-- Along a run from the step that starts a key's exit, no deposit credits the key.

The key is exited and not withdrawable at the run's end.

The step is counted by the replay. -/
private theorem Run.charge_deposit_credit_zero {g a b y : ForkedBeaconState preset}
    (shared : Run config checks g a) (genesis : Genesis (config := config) (checks := checks) g)
    (step : Step config checks a b) (post : Run config checks b y) (fulu : .fusaka ≤ a.fork)
    (early : y.fork < .glamsterdam) (high : ℕ)
    (counted : (getCurrentEpoch a.state).toNat ≤ high + 1) {events : List (BalanceEvent preset)}
    (replayed : ((Run.nil.snoc step).append post).balanceEvents high = .ok events)
    (i : ℕ) (inside : i < a.state.validators.data.size) (w : Validator)
    (found : b.state.validators.data[i]? = some w) (exited : w.exitEpoch.toNat < 2 ^ 64 - 1)
    (held : (getCurrentEpoch y.state).toNat < w.withdrawableEpoch.toNat) :
    ((events.filter (·.source = .deposits)).map (keyCredit i)).sum = 0 := by
  have bEarly : b.fork < .glamsterdam :=
    Nat.lt_of_le_of_lt (fork_le_of_chainSteps post.chainSteps) early
  obtain ⟨es, replayedS⟩ := step.balanceEvents_ok bEarly
  obtain ⟨later, replayedP⟩ := post.balanceEvents_ok early high
  have one : (Run.nil.snoc step : Run config checks a b).balanceEvents high = .ok es := by
    simp [Run.balanceEvents, counted, replayedS, pure, Except.pure]
    rfl
  rw [DirectSafety.Apriori.Internal.balanceEvents_append _ _ high one replayedP] at replayed
  obtain rfl := Except.ok.inj replayed
  have heldB : (getCurrentEpoch b.state).toNat < w.withdrawableEpoch.toNat :=
    Nat.lt_of_le_of_lt (UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps post.chainSteps))
      held
  have first := Step.charge_deposit_credit_zero step fulu bEarly replayedS i inside w found exited
    heldB
  have second := Run.exiting_deposit_credit_zero (shared.append (Run.nil.snoc step)) genesis post
    (Nat.le_trans fulu step.chainStep.fork_le) early high replayedP i w found exited held
  simp only [List.filter_append, List.map_append, List.sum_append]
  omega

/-- The consolidation credits to the keys in `T` along the run.

They are at most the caps at X of the due entries of X's queue whose target is in `T`.

Each entry credits only its target, so the sum over the entries splits by target. -/
private theorem Run.consolidation_credits_le_X_targets {g x y : ForkedBeaconState preset}
    (shared : Run config checks g x) (genesis : Genesis (config := config) (checks := checks) g)
    (caps : CapOrder preset)
    (tail : Run config checks x y) (electra : .pectra ≤ x.fork) (early : y.fork < .glamsterdam)
    (high : ℕ) {events : List (BalanceEvent preset)}
    (replayed : tail.balanceEvents high = .ok events)
    (endEpoch : (getCurrentEpoch y.state).toNat ≤ high + 1)
    (withinDelay : high + 2 ≤
      (getCurrentEpoch x.state).toNat + config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    (delay : 0 < config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat) (T : Finset ℕ) :
    (T.sum fun i => ((events.filter (·.source = .consolidations)).map (keyCredit i)).sum) ≤
      ((((((x.state.pendingConsolidations electra).data.toList.filter fun c =>
          c.targetIndex.toNat ∈ T).filterMap fun c =>
        x.state.validators.data[c.sourceIndex.toNat]?).filter fun v =>
          !v.slashed && decide (v.withdrawableEpoch.toNat ≤ high + 1)).map fun v =>
            (withdrawalMaxEffectiveBalance preset x.fork v).toNat).sum) := by
  obtain ⟨n, -, bound⟩ := run_credits_targets shared genesis caps delay electra high withinDelay
    tail early endEpoch replayed
  rw [← capBound_sum]
  refine Nat.le_trans (bound T) ?_
  have split := List.take_append_drop n (x.state.pendingConsolidations electra).data.toList
  conv_rhs => rw [← split, List.filter_append, List.map_append, List.sum_append]
  exact Nat.le_add_right _ _

end PinKeys

end

section

/-! ## A validator created in a step has no exit assigned -/

namespace PinKeys

open Base Uint64 Models DirectSafety

variable {preset : Preset} {fork : Fork} {config : Config} {checks : SignatureChecks}

/-- Every validator from position `n` on has no exit epoch assigned. -/
private def ExitFarFrom (n : ℕ) {f : Fork} (s : BeaconState preset f) : Prop :=
  ∀ i v, n ≤ i → s.validators.data[i]? = some v → v.exitEpoch = FAR_FUTURE_EPOCH

/-- A state with the same registry has no exit assigned from position `n` either. -/
private theorem ExitFarFrom.of_data {n : ℕ} {f g : Fork} {s : BeaconState preset f}
    {t : BeaconState preset g} (same : t.validators.data = s.validators.data)
    (holds : ExitFarFrom n s) : ExitFarFrom n t := by
  intro i v large found
  rw [same] at found
  exact holds i v large found

/-- A registry that does not reach position `n` has no validator from there on. -/
private theorem ExitFarFrom.of_size {n : ℕ} {f : Fork} {s : BeaconState preset f}
    (small : s.validators.data.size ≤ n) : ExitFarFrom n s := by
  intro i v large found
  have := (Array.getElem?_eq_some_iff.mp found).1
  omega

/-- A write that keeps the exit epoch of its validator keeps the later validators unassigned. -/
private theorem ExitFarFrom.of_set {n position : ℕ} {f : Fork} {s t : BeaconState preset f}
    {old v : Validator} (found : getValidatorAt s position = .ok old)
    (set : s.setValidatorAt position v = .ok t) (same : v.exitEpoch = old.exitEpoch)
    (holds : ExitFarFrom n s) : ExitFarFrom n t := by
  obtain ⟨inside, rfl⟩ := setValidatorAt_ok set
  intro i w large got
  simp only [BeaconState.putValidator, Serialization.Ssz.RootedForkList.data_set,
    Array.getElem?_set] at got
  split at got
  · rename_i place
    subst place
    cases got
    rw [same]
    exact holds position old large (getValidatorAt_eq_ok_iff.mp found)
  · exact holds i w large got

/-- A pending deposit appends a validator with no exit epoch. -/
private theorem ExitFarFrom.of_apply {n : ℕ} {f : Fork} {s t : BeaconState preset f}
    {deposit : PendingDeposit}
    (ok : Consensus.applyPendingDeposit config checks s deposit = .ok t) (holds : ExitFarFrom n s) :
    ExitFarFrom n t := by
  rcases applyPendingDeposit_cases ok with rfl | ⟨index, raised⟩ | ⟨_, added⟩
  · exact holds
  · exact holds.of_data (congrArg (·.data) (increaseBalance_validators raised))
  · intro i v large found
    rw [addValidatorToRegistry_validators_eq_push added, Array.getElem?_push] at found
    split at found
    · cases found
      rfl
    · exact holds i v large found

/-- Applying the pending deposits assigns no exit from position `n` on. -/
private theorem ExitFarFrom.of_deposits {n : ℕ} {f : Fork} {s t : BeaconState preset f}
    {electra : .pectra ≤ f} (ok : Consensus.processPendingDeposits config checks s electra = .ok t)
    (holds : ExitFarFrom n s) : ExitFarFrom n t := by
  obtain ⟨_, _, _, _, next, _, _, _, _, _, _, _, _, folded, rfl⟩ :=
    processPendingDeposits_applied ok
  have kept : ExitFarFrom n next :=
    foldlM_ok_invariant (g := Consensus.applyPendingDeposit config checks)
      (fun u : BeaconState preset f => ExitFarFrom n u)
      (fun _ _ _ before step => ExitFarFrom.of_apply step before) holds folded
  exact kept

/-- The effective-balance updates write only effective balances. -/
private theorem ExitFarFrom.of_updates {n : ℕ} {f : Fork}
    {s t : BeaconState preset f} (ok : Consensus.processEffectiveBalanceUpdates s = .ok t)
    (holds : ExitFarFrom n s) : ExitFarFrom n t := by
  unfold Consensus.processEffectiveBalanceUpdates at ok
  refine foldlM_ok_invariant (fun u : BeaconState preset f => ExitFarFrom n u)
    (fun _ _ _ before step => ?_) holds ok
  simp only [updateEffectiveBalance, bind_ok_iff, liftAccessor_ok] at step
  obtain ⟨validator, found, _, _, _, _, set⟩ := step
  exact before.of_set found set rfl

/-- An epoch appends validators only in its pending deposits, after the registry updates.

So a validator that the epoch creates has no exit epoch. -/
private theorem ExitFarFrom.of_epoch {n : ℕ} {f : Fork} {s t : BeaconState preset f}
    (electra : .pectra ≤ f) (ok : Consensus.processEpoch config checks s = .ok t)
    (small : s.validators.data.size ≤ n) : ExitFarFrom n t := by
  obtain ⟨justified, scored, rewarded, registered, slashed, reset, deposited, consolidated,
    settled, updated, justifiedOk, scoredOk, rewardedOk, registeredOk, slashedOk, resetOk,
    depositedOk, consolidatedOk, settledOk, updatedOk, rest⟩ :=
    EpochTrace.through_effectiveBalances (processEpoch_trace ok)
  have keeps {k : EpochStage} {a b : BeaconState preset f}
      (other : k ≠ .rewards ∧ k ≠ .registry ∧ k ≠ .slashings ∧ k ≠ .pendingDeposits ∧
        k ≠ .pendingConsolidations ∧ k ≠ .effectiveBalances)
      (computed : EpochStage.action config checks k a = .ok b) : b.validators = a.validators :=
    (EpochStage.action_cases.mp computed).records other |>.1
  -- The first six stages keep the size of the registry.
  have size : reset.validators.data.size = s.validators.data.size := by
    have one : justified.validators.data.size = s.validators.data.size :=
      congrArg (·.data.size) (keeps (k := .justification) ⟨nofun, nofun, nofun, nofun, nofun, nofun⟩
        justifiedOk)
    have two : scored.validators.data.size = justified.validators.data.size :=
      congrArg (·.data.size) (keeps (k := .inactivity) ⟨nofun, nofun, nofun, nofun, nofun, nofun⟩
        scoredOk)
    have three := (processRewardsAndPenalties_sameSizes
      (EpochStage.action_cases.mp rewardedOk)).1
    have four := (sameSizes_processRegistryUpdates (EpochStage.action_cases.mp registeredOk)).1
    have five := (sameSizes_processSlashings (EpochStage.action_cases.mp slashedOk)).1
    have six : reset.validators.data.size = slashed.validators.data.size :=
      congrArg (·.data.size) (keeps (k := .eth1Reset) ⟨nofun, nofun, nofun, nofun, nofun, nofun⟩
        resetOk)
    omega
  have atReset : ExitFarFrom n reset := .of_size (by omega)
  -- Pending deposits append validators with no exit.
  have atDeposited : ExitFarFrom n deposited := by
    have edge := EpochStage.action_cases.mp depositedOk
    simp only [EpochStage.Edge, electra, ↓reduceDIte] at edge
    exact atReset.of_deposits edge
  have atConsolidated : ExitFarFrom n consolidated :=
    atDeposited.of_data (congrArg (·.data)
      ((EpochStage.action_cases.mp consolidatedOk).validators_eq ⟨nofun, nofun, nofun⟩))
  have atSettled : ExitFarFrom n settled :=
    atConsolidated.of_data (congrArg (·.data) ((EpochStage.action_cases.mp settledOk).validators_eq
      ⟨nofun, nofun, nofun⟩))
  have atUpdated : ExitFarFrom n updated :=
    atSettled.of_updates (EpochStage.action_cases.mp updatedOk)
  -- The seven later stages keep the validators.
  have same : t.validators = updated.validators :=
    EpochTrace.transport (fun a b : BeaconState preset f => b.validators = a.validators)
      (fun _ => rfl) (fun one two => two.trans one)
      (fun k member a b computed => by
        simp only [List.mem_cons, List.not_mem_nil, or_false] at member
        exact keeps (by rcases member with rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
          exact ⟨nofun, nofun, nofun, nofun, nofun, nofun⟩) computed) rest
  exact atUpdated.of_data (congrArg (·.data) same)

/-- From Electra, a step before Gloas leaves every validator that it creates with no exit epoch. -/
private theorem ExitFarFrom.of_chainStep {a b : ForkedBeaconState preset}
    (step : ChainStep config checks a b) (electra : .pectra ≤ a.fork)
    (early : a.fork < .glamsterdam) : ExitFarFrom a.state.validators.data.size b.state := by
  cases step with
  | slot ok =>
    obtain ⟨advanced, slotOk, upgrades⟩ := bind_ok_iff.mp ok
    obtain ⟨next, cached, epoched, _, cachedOk, epochedOk, rfl⟩ := advanceSlot_ok slotOk
    obtain ⟨_, _, _, _, cachedEq⟩ := processSlot_ok cachedOk
    have atEpoched : ExitFarFrom a.state.validators.data.size epoched := by
      unfold epochIfLast at epochedOk
      split at epochedOk
      · exact ExitFarFrom.of_epoch electra epochedOk (by rw [cachedEq])
      · cases epochedOk
        exact .of_size (by rw [cachedEq])
    have atAdvanced : ExitFarFrom a.state.validators.data.size { epoched with slot := next } :=
      atEpoched.of_data rfl
    exact (processUpgrades_induction (config := config) (checks := checks)
      (forked := ⟨a.fork, { epoched with slot := next }⟩) (after := b)
      (property := fun post => ExitFarFrom a.state.validators.data.size post.state ∧
        .pectra ≤ post.fork)
      (fun {pre post} kept ok =>
        ⟨kept.1.of_data (upgradeNext_validators_of_electra kept.2 ok),
          Nat.le_trans kept.2 (Nat.le_of_lt post.property)⟩)
      ⟨atAdvanced, electra⟩ upgrades).1
  | block engine signed validate ok =>
    obtain ⟨input, last, started, operated, -, synced⟩ :=
      processBlock_operationsInput (applySignedBlock_ok ok).2.1
    have same := OperationsInput.validators_eq early started
    have fresh := processOperations_new_validator_epochs_unassigned operated
    intro i v large found
    have lastFound : last.validators.data[i]? = some v := by
      split at synced
      · obtain ⟨_, rfl⟩ := processSyncAggregate_eq synced
        exact found
      · cases synced
        exact found
    exact (fresh i v (by rw [same]; exact large) lastFound).2

/-- Along a run from Electra, a validator can gain an exit epoch only through a departure charge.

The charge is at that exit epoch. -/
private theorem Run.charge_of_exit {x y : ForkedBeaconState preset}
    (tail : Run config checks x y) (electra : .pectra ≤ x.fork) (early : y.fork < .glamsterdam)
    (i : ℕ) (unset : ∀ v, x.state.validators.data[i]? = some v → v.exitEpoch = FAR_FUTURE_EPOCH)
    (v : Validator) (found : y.state.validators.data[i]? = some v)
    (assigned : v.exitEpoch ≠ FAR_FUTURE_EPOCH) :
    ∃ c ∈ tail.departureCharges, c.index = i ∧ c.epoch = v.exitEpoch.toNat := by
  cases initial : x.state.validators.data[i]? with
  | some w => exact tail.departure_charge_of_assigned i w v initial found (unset w initial) assigned
  | none =>
    obtain ⟨m, n, pre, step, post, rfl, absent, arrived⟩ := Run.split_at_flip tail
      (fun z => i < z.state.validators.data.size)
      (Nat.not_lt.mpr (Array.getElem?_eq_none_iff.mp initial))
      (Array.getElem?_eq_some_iff.mp found).1
    have electraM : .pectra ≤ m.fork := Nat.le_trans electra (fork_le_of_chainSteps pre.chainSteps)
    have earlyM : m.fork < .glamsterdam := Nat.lt_of_le_of_lt step.chainStep.fork_le
      (Nat.lt_of_le_of_lt (fork_le_of_chainSteps post.chainSteps) early)
    have read := Array.getElem?_eq_getElem arrived
    have pending := ExitFarFrom.of_chainStep step.chainStep electraM earlyM i _
      (Nat.le_of_not_lt absent) read
    obtain ⟨c, member, index, epoch⟩ :=
      post.departure_charge_of_assigned i _ v read found pending assigned
    exact ⟨c, by rw [Run.departureCharges_append]; exact List.mem_append_right _ member, index,
      epoch⟩

end PinKeys

end

section

/-! ## PinSeatDebits -/

namespace PinSeatDebits

open Base Uint64 Models DirectSafety

variable {preset : Preset} {config : Config} {checks : SignatureChecks}

/-- The participant reward at a state is at most the envelope of a total.

The total of the state is within three halves of that total. -/
private theorem syncReward_le_envelope {fork : Fork} {s : BeaconState preset fork}
    {reward T : Gwei} (rewardOk : syncParticipantReward s = .ok reward)
    (totalOk : getTotalActiveBalance s = .ok T) (total : ℕ) (band : 2 * T.toNat ≤ 3 * total) :
    reward.toNat ≤ PinTerms.syncEnvelope preset total := by
  simp only [syncParticipantReward, bind_ok_iff, liftAccessor_ok, liftArith,
    mapError_ok_iff] at rewardOk
  obtain ⟨read, readOk, perIncrement, perOk, rewardOk⟩ := rewardOk
  obtain rfl : T = read := Except.ok.inj (totalOk.symm.trans readOk)
  obtain ⟨increments, incrementsOk, base, baseOk, weighted, weightedOk, perWeight, perWeightOk,
    perSlot, perSlotOk, rewardOk⟩ := rewardOk
  rw [divChecked_ok_iff] at incrementsOk perWeightOk perSlotOk rewardOk
  rw [mulChecked_ok_iff] at baseOk weightedOk
  have weightValue : SYNC_REWARD_WEIGHT.toNat = 2 := rfl
  have denominator : WEIGHT_DENOMINATOR.toNat = 64 := rfl
  rw [weightValue] at weightedOk
  rw [denominator] at perWeightOk
  have rootLe : Nat.sqrt T.toNat ≤ Nat.sqrt (3 * total / 2) :=
    Nat.sqrt_le_sqrt (by omega)
  have baseLe : base.toNat ≤ preset.BASE_REWARD_FACTOR.toNat * (Nat.sqrt (3 * total / 2) + 2) := by
    rw [baseOk.2, incrementsOk.2, toNat_getBaseRewardPerIncrement perOk, Nat.mul_comm]
    rcases Nat.eq_zero_or_pos T.toNat with zero | positive
    · simp [zero]
    · exact (div_mul_div_sqrt_le positive _).trans (Nat.mul_le_mul_left _ (by omega))
  unfold PinTerms.syncEnvelope
  rw [weightValue, denominator, rewardOk.2, perSlotOk.2, perWeightOk.2, weightedOk.2]
  exact Nat.div_le_div_right (Nat.div_le_div_right (Nat.div_le_div_right
    (Nat.mul_le_mul_right 2 baseLe)))

/-- The proposer's share of a reward is at most that share of any bound on the reward. -/
private theorem syncProposer_le {reward proposer : Gwei} {bound : ℕ} (le : reward.toNat ≤ bound)
    (ok : liftAccessor (liftArith (do
        Uint64.divChecked (← Uint64.mulChecked reward PROPOSER_WEIGHT)
          (WEIGHT_DENOMINATOR - PROPOSER_WEIGHT))) = Except.ok proposer) :
    proposer.toNat ≤ bound * PROPOSER_WEIGHT.toNat /
      (WEIGHT_DENOMINATOR.toNat - PROPOSER_WEIGHT.toNat) := by
  simp only [liftAccessor_ok, liftArith, mapError_ok_iff, bind_ok_iff] at ok
  obtain ⟨product, productOk, quotientOk⟩ := ok
  rw [divChecked_ok_iff] at quotientOk
  rw [mulChecked_ok_iff] at productOk
  have difference : (WEIGHT_DENOMINATOR - PROPOSER_WEIGHT).toNat = 56 := rfl
  have proposerWeight : PROPOSER_WEIGHT.toNat = 8 := rfl
  have denominator : WEIGHT_DENOMINATOR.toNat = 64 := rfl
  rw [quotientOk.2, productOk.2, difference, proposerWeight, denominator]
  exact Nat.div_le_div_right (Nat.mul_le_mul_right _ le)

/-- The sync reward of a seat at the envelope of a total, with its proposer share. -/
private def syncSeatEnvelope (preset : Preset) (total : ℕ) : ℕ :=
  PinTerms.syncEnvelope preset total + PinTerms.syncEnvelope preset total * PROPOSER_WEIGHT.toNat /
    (WEIGHT_DENOMINATOR.toNat - PROPOSER_WEIGHT.toNat)

/-- The credits of an event over a set of keys are at most its credits over the registry. -/
private theorem keys_credits_le (S : Finset ℕ) (e : BalanceEvent preset) :
    ∑ j ∈ S, (actualBalanceAt e.after j - actualBalanceAt e.before j) ≤ e.credits := by
  unfold BalanceEvent.credits
  refine Finset.sum_le_sum_of_ne_zero fun j _ positive => Finset.mem_range.mpr ?_
  by_contra outside
  apply positive
  simp [actualBalanceAt, Array.getElem?_eq_none (Nat.le_of_not_lt outside)]

/-- The events of a replay record no sync pass. -/
private def NoSync {fork : Fork} (pre : BalanceReplay preset fork) : Prop :=
  ∀ e ∈ pre.2, e.source ≠ .sync

/-- A pass that records no event keeps the replay free of sync events. -/
private theorem NoSync.carry {fork : Fork}
    {action : BeaconState preset fork → Except TransitionError (BeaconState preset fork)}
    {p q : BalanceReplay preset fork} (held : NoSync p) (ok : carryBalance action p = .ok q) :
    NoSync q := by
  intro e member
  rw [(PinEventsKept.carryBalance_cases ok).2] at member
  exact held e member

/-- A recorded pass that is not the sync pass keeps the replay free of sync events. -/
private theorem NoSync.record {fork : Fork} {source : BalanceSource}
    {limits : BeaconState preset fork → Except TransitionError (Nat × Nat)}
    {action : BeaconState preset fork → Except TransitionError (BeaconState preset fork)}
    {p q : BalanceReplay preset fork} (held : NoSync p)
    (ok : recordBalance source limits action p = .ok q) (notSync : source ≠ .sync) :
    NoSync q := by
  intro e member
  rcases (PinEventsKept.recordBalance_cases ok).2.1 e member with old | new
  · exact held e old
  · rw [new]
    exact notSync

/-- The effective balance of a key at a state of a run from genesis is at most the largest cap. -/
private theorem effectiveAt_le_capMax {g m : ForkedBeaconState preset}
    (run : Run config checks g m) (genesis : Genesis (config := config) (checks := checks) g)
    (caps : CapOrder preset) (early : m.fork < .glamsterdam) (v : ℕ) :
    effectiveAt m v ≤ preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat := by
  cases found : m.state.validators.data[v]? with
  | none => simp [effectiveAt, found]
  | some w =>
    exact (DirectSafety.Apriori.Internal.effectiveAt_le_withdrawalMax run genesis caps early
      found).trans ((withdrawalMaxEffectiveBalance_le_largestEffectiveBalance preset m.fork w).trans
        (max_le (UInt64.le_iff_toNat_le.mp (UInt64.le_trans caps.activation caps.compounding))
          (max_le (UInt64.le_iff_toNat_le.mp caps.compounding) le_rfl)))

/-- The replay of a block from Altair ends with its one sync pass, after events of other sources.

The pass is the sync aggregate of the block, applied at the state that its other passes leave. -/
private theorem blockReplay_sync_split {fork : Fork} {a t : BeaconState preset fork}
    (early : fork < .glamsterdam) (altair : .altair ≤ fork) {engine : ExecutionEngine preset fork}
    {block : BeaconBlock preset fork} {events : List (BalanceEvent preset)}
    (replay : blockBalanceReplay (config := config) (checks := checks) early engine a block =
      .ok (t, events)) :
    ∃ (c : BeaconState preset fork) (rest : List (BalanceEvent preset))
      (aggregate : SyncAggregate preset) (credit debit : ℕ),
      events = rest ++ [⟨.sync, ⟨fork, c⟩, ⟨fork, t⟩, credit, debit⟩] ∧
      (∀ i, (rest.map (syncDebit i)).sum = 0) ∧
      (∀ i, (rest.map (syncCredit i)).sum = 0) ∧
      processSyncAggregate config checks c altair aggregate = .ok t := by
  have normalized := replay
  unfold blockBalanceReplay at normalized
  simp only [altair, ↓reduceDIte] at normalized
  simp only [← bind_assoc, DirectSafety.Apriori.Internal.except_dite_bind] at normalized
  simp only [bind_assoc] at normalized
  simp only [bind_ok_iff, ensure_ok_iff] at normalized
  obtain ⟨headed, headedOk, executed, executedOk, revealed, revealedOk, voted, votedOk, _, _, _,
    _, proposed, proposedOk, slashed, slashedOk, attested, attestedOk, deposited, depositedOk,
    exited, exitedOk, changed, changedOk, consolidated, requestsOk, syncOk⟩ := normalized
  have start : NoSync ((a, []) : BalanceReplay preset fork) := fun _ member => by cases member
  have one := start.carry headedOk
  have two : NoSync executed := by
    split at executedOk
    · exact one.record executedOk (by decide)
    · cases executedOk
      exact one
  have three := two.carry revealedOk
  have four := three.carry votedOk
  have five := foldlM_ok_invariant NoSync
    (fun _ _ _ prior computed => prior.record computed (by decide)) four proposedOk
  have six := foldlM_ok_invariant NoSync
    (fun _ _ _ prior computed => prior.record computed (by decide)) five slashedOk
  have seven := foldlM_ok_invariant NoSync
    (fun _ _ _ prior computed => prior.record computed (by decide)) six attestedOk
  have eight := foldlM_ok_invariant NoSync
    (fun _ _ _ prior computed => prior.record computed (by decide)) seven depositedOk
  have nine := eight.carry (by simpa only [← Array.foldlM_toList] using exitedOk)
  have ten := nine.carry changedOk
  have eleven : NoSync consolidated := by
    split at requestsOk
    · simp only [bind_ok_iff] at requestsOk
      obtain ⟨requested, requestedOk, withdrawn, withdrawnOk, consolidatedOk⟩ := requestsOk
      have first := ten.carry requestedOk
      have second := first.carry withdrawnOk
      exact foldlM_ok_invariant NoSync
        (fun _ _ _ prior computed => prior.record computed (by decide)) second consolidatedOk
    · cases requestsOk
      exact ten
  simp only [recordBalance, bind_ok_iff, pure, Except.pure, Except.ok.injEq,
    Prod.mk.injEq] at syncOk
  obtain ⟨⟨credit, debit⟩, limitsOk, u, synced, rfl, rfl⟩ := syncOk
  refine ⟨consolidated.1, consolidated.2, _, credit, debit, rfl, fun i => ?_, fun i => ?_, synced⟩
  · exact List.sum_eq_zero fun x member => by
      obtain ⟨e, inside, rfl⟩ := List.mem_map.mp member
      simp [syncDebit, eleven e inside]
  · exact List.sum_eq_zero fun x member => by
      obtain ⟨e, inside, rfl⟩ := List.mem_map.mp member
      simp [syncCredit, eleven e inside]

/-- The movement of two sets of keys from one state to another.

The first set counts its debits, and the second counts its credits and its debits. -/
private def moved {fork : Fork} (a b : BeaconState preset fork) (debited moving : Finset ℕ) : ℕ :=
  ∑ i ∈ debited, (actualBalanceAt ⟨fork, a⟩ i - actualBalanceAt ⟨fork, b⟩ i) +
    ∑ i ∈ moving, ((actualBalanceAt ⟨fork, b⟩ i - actualBalanceAt ⟨fork, a⟩ i) +
      (actualBalanceAt ⟨fork, a⟩ i - actualBalanceAt ⟨fork, b⟩ i))

/-- A sync reward step moves two apart sets at most one reward.

The proposer must not be in the second set.

Only the member's balance moves by the reward, and the proposer's share goes outside that set.

The first set holds debits only, which the share does not touch. -/
private theorem applySyncReward_moved_le {fork : Fork} {s t : BeaconState preset fork}
    {reward proposerReward : Gwei} {proposer : Except AccessorError ValidatorIndex}
    {member : ValidatorIndex × Bool} {debited moving : Finset ℕ}
    (apartSets : Disjoint debited moving)
    (apart : ∀ p, proposer = .ok p → p.toNat ∉ moving)
    (ok : applySyncReward reward proposerReward proposer s member = .ok t) :
    moved s t debited moving ≤ reward.toNat := by
  have single
      (le₁ : ∀ i ∈ debited, actualBalanceAt ⟨fork, s⟩ i - actualBalanceAt ⟨fork, t⟩ i ≤
        if member.1.toNat = i then reward.toNat else 0)
      (le₂ : ∀ i ∈ moving, (actualBalanceAt ⟨fork, t⟩ i - actualBalanceAt ⟨fork, s⟩ i) +
        (actualBalanceAt ⟨fork, s⟩ i - actualBalanceAt ⟨fork, t⟩ i) ≤
        if member.1.toNat = i then reward.toNat else 0) :
      moved s t debited moving ≤ reward.toNat := by
    unfold moved
    refine (Nat.add_le_add (Finset.sum_le_sum le₁) (Finset.sum_le_sum le₂)).trans ?_
    rw [← Finset.sum_union apartSets, Finset.sum_ite_eq]
    split <;> omega
  unfold applySyncReward at ok
  split at ok
  · simp only [liftAccessor_ok, bind_ok_iff] at ok
    obtain ⟨u, first, p, pOk, last⟩ := ok
    have raised (i : ℕ) := actualBalanceAt_increaseBalance first i
    have paid (i : ℕ) := actualBalanceAt_increaseBalance last i
    refine single (fun i _ => ?_) fun i hi => ?_
    · rw [paid, raised]
      omega
    · have apartAt : p.toNat ≠ i := fun same => apart p pOk (same ▸ hi)
      have paidAt := paid i
      simp only [apartAt, ↓reduceIte, Nat.add_zero] at paidAt
      rw [paidAt, raised]
      split <;> omega
  · have lowered (i : ℕ) := actualBalanceAt_decreaseBalance (liftAccessor_ok.mp ok) i
    refine single (fun i _ => ?_) fun i _ => ?_ <;> rw [lowered] <;> split <;> omega

/-- A sync aggregate moves two apart sets at most one reward for each seat.

The proposer must not be in the second set. -/
private theorem processSyncAggregate_moved_le {fork : Fork} {s t : BeaconState preset fork}
    (altair : .altair ≤ fork) (aggregate : SyncAggregate preset)
    (ok : processSyncAggregate config checks s altair aggregate = .ok t)
    {debited moving : Finset ℕ} (apartSets : Disjoint debited moving)
    (apart : ∀ p, getBeaconProposerIndex s = .ok p → p.toNat ∉ moving) :
    ∃ reward, syncParticipantReward s = .ok reward ∧
      moved s t debited moving ≤ preset.SYNC_COMMITTEE_SIZE.toNat * reward.toNat := by
  simp only [processSyncAggregate, bind_ok_iff] at ok
  obtain ⟨_, _, _, _, _, _, _, _, _, _, reward, rewardOk, proposer, proposerOk,
    members, membersOk, folded⟩ := ok
  refine ⟨reward, rewardOk, ?_⟩
  have fold (xs : List (ValidatorIndex × Bool)) (a b : BeaconState preset fork)
      (ok : xs.foldlM (applySyncReward reward proposer (getBeaconProposerIndex s)) a = .ok b) :
      moved a b debited moving ≤ xs.length * reward.toNat := by
    induction xs generalizing a with
    | nil => cases ok; simp [moved]
    | cons x xs ih =>
      obtain ⟨u, one, rest⟩ := bind_ok_iff.mp ok
      have step := applySyncReward_moved_le apartSets apart one
      have tail := ih u rest
      have triangle : moved a b debited moving ≤ moved a u debited moving +
          moved u b debited moving := by
        unfold moved
        rw [Nat.add_add_add_comm, ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
        exact Nat.add_le_add (Finset.sum_le_sum fun i _ => by omega)
          (Finset.sum_le_sum fun i _ => by omega)
      simp only [List.length_cons, Nat.add_mul, Nat.one_mul]
      omega
  have bounds := fold _ s t (by simpa only [← Array.foldlM_toList] using folded)
  have length : (members.zip aggregate.syncCommitteeBits.bits.toArray).toList.length ≤
      preset.SYNC_COMMITTEE_SIZE.toNat := by
    simp only [Array.length_toList, Array.size_zip]
    exact (Nat.min_le_right _ _).trans (by simp)
  exact bounds.trans (Nat.mul_le_mul_right _ length)

/-- The sync debits of a set of keys and the sync credits and debits of a second set of keys. -/
private def syncSeatMoves (debited moving : Finset ℕ) (events : List (BalanceEvent preset)) : ℕ :=
  ∑ i ∈ debited, (events.map (syncDebit i)).sum +
    ∑ i ∈ moving, ((events.map (syncCredit i)).sum + (events.map (syncDebit i)).sum)

/-- The movements of two sets of keys add up over the events of two replays. -/
private theorem syncSeatMoves_append (debited moving : Finset ℕ)
    (first second : List (BalanceEvent preset)) :
    syncSeatMoves debited moving (first ++ second) =
      syncSeatMoves debited moving first + syncSeatMoves debited moving second := by
  unfold syncSeatMoves
  simp only [List.map_append, List.sum_append, Finset.sum_add_distrib]
  omega

/-- The sync debits of a block over any keys fit the participant reward of the block's total.

The sync pass is the last pass of the replay, and no other pass records a sync event.

It reads the total of the state after the block, since a sync aggregate changes only balances.

If the block's proposer is not among the keys, they move at most one participant reward per seat. -/
private theorem block_syncDebits_le {fork : Fork} {a t : BeaconState preset fork}
    (early : fork < .glamsterdam) (altair : .altair ≤ fork) {engine : ExecutionEngine preset fork}
    {block : BeaconBlock preset fork} {events : List (BalanceEvent preset)}
    (replay : blockBalanceReplay (config := config) (checks := checks) early engine a block =
      .ok (t, events))
    (total : ℕ) (band : ∀ T : Gwei, getTotalActiveBalance t = .ok T → 2 * T.toNat ≤ 3 * total)
    (keys : Finset ℕ) :
    ∑ i ∈ keys, (events.map (syncDebit i)).sum ≤
      preset.SYNC_COMMITTEE_SIZE.toNat * PinTerms.syncEnvelope preset total ∧
    ∑ i ∈ keys, ((events.map (syncCredit i)).sum + (events.map (syncDebit i)).sum) ≤
      preset.SYNC_COMMITTEE_SIZE.toNat * syncSeatEnvelope preset total ∧
    (∀ debited moving : Finset ℕ, Disjoint debited moving →
      (∀ p, getBeaconProposerIndex t = .ok p → p.toNat ∉ moving) →
      syncSeatMoves debited moving events ≤
        preset.SYNC_COMMITTEE_SIZE.toNat * PinTerms.syncEnvelope preset total) := by
  obtain ⟨c, rest, aggregate, credit, debit, rfl, silent, silentCredit, synced⟩ :=
    blockReplay_sync_split early altair replay
  obtain ⟨reward, proposer, rewardOk, proposerOk, -, debits, moves⟩ :=
    sync_bounds_combined altair _ synced
  have bound := (DirectSafety.Apriori.Internal.keys_debits_le keys
    ⟨.sync, ⟨fork, c⟩, ⟨fork, t⟩, 0, 0⟩).trans debits
  have movesBound : ∑ i ∈ keys,
      ((actualBalanceAt ⟨fork, t⟩ i - actualBalanceAt ⟨fork, c⟩ i) +
        (actualBalanceAt ⟨fork, c⟩ i - actualBalanceAt ⟨fork, t⟩ i)) ≤
        preset.SYNC_COMMITTEE_SIZE.toNat * (reward.toNat + proposer.toNat) := by
    rw [Finset.sum_add_distrib]
    exact (Nat.add_le_add (keys_credits_le keys ⟨.sync, ⟨fork, c⟩, ⟨fork, t⟩, 0, 0⟩)
      (DirectSafety.Apriori.Internal.keys_debits_le keys
        ⟨.sync, ⟨fork, c⟩, ⟨fork, t⟩, 0, 0⟩)).trans moves
  obtain ⟨balances, rfl⟩ := processSyncAggregate_eq synced
  have reads := rewardOk
  simp only [syncParticipantReward, bind_ok_iff, liftAccessor_ok] at reads
  obtain ⟨T, totalEnd, -⟩ := reads
  have envelope := syncReward_le_envelope rewardOk totalEnd total (band T totalEnd)
  have share := syncProposer_le envelope proposerOk
  refine ⟨?_, ?_, fun debited moving apartSets apart => ?_⟩
  · simp only [List.map_append, List.sum_append, silent, syncDebit, ↓reduceIte, List.map_cons,
      List.map_nil, List.sum_cons, List.sum_nil, Nat.zero_add, Nat.add_zero]
    exact bound.trans (Nat.mul_le_mul_left _ envelope)
  · simp only [List.map_append, List.sum_append, silent, silentCredit, syncDebit, syncCredit,
      ↓reduceIte, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, Nat.zero_add,
      Nat.add_zero]
    refine movesBound.trans (Nat.mul_le_mul_left _ ?_)
    unfold syncSeatEnvelope
    omega
  · -- The proposer is read from the slot and the lookahead, which the sync pass leaves alone.
    have same : getBeaconProposerIndex ({ c with balances } : BeaconState preset fork) =
        getBeaconProposerIndex c := by
      rfl
    obtain ⟨reward', rewardOk', moves'⟩ := processSyncAggregate_moved_le altair _ synced
      apartSets fun p found => apart p (same.trans found)
    obtain rfl : reward' = reward := Except.ok.inj (rewardOk'.symm.trans rewardOk)
    unfold syncSeatMoves
    simp only [List.map_append, List.sum_append, silent, silentCredit, syncDebit, syncCredit,
      ↓reduceIte, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, Nat.zero_add,
      Nat.add_zero]
    exact moves'.trans (Nat.mul_le_mul_left _ envelope)

/-- The rewards passes keep the replay free of sync events. -/
private theorem replayRewards_noSync {fork : Fork} {p q : BalanceReplay preset fork}
    (held : NoSync p) (ok : replayRewards (config := config) p = .ok q) : NoSync q :=
  replayRewards_induction NoSync (fun prior ok => prior.record ok (by decide))
    (fun penalty prior ok => prior.record ok (by rcases penalty with rfl | rfl <;> decide)) held ok

/-- No stage of an epoch before the payments records a sync pass. -/
private theorem replay_stage_noSync {fork : Fork} {k : EpochStage}
    (member : k ∈ EpochStage.prefixStages) {p q : BalanceReplay preset fork}
    (ok : epochReplayAction (config := config) (checks := checks) k p = .ok q) :
    NoSync p → NoSync q := by
  intro held
  simp only [EpochStage.prefixStages, List.mem_cons, List.not_mem_nil, or_false] at member
  rcases member with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · simp only [epochReplayAction] at ok
    exact held.carry ok
  · simp only [epochReplayAction] at ok
    split at ok
    · exact held.carry ok
    · simp only [pure, Except.pure, Except.ok.injEq] at ok
      subst ok
      exact held
  · simp only [epochReplayAction] at ok
    exact replayRewards_noSync held ok
  · simp only [epochReplayAction] at ok
    exact held.carry ok
  · simp only [epochReplayAction] at ok
    exact held.record ok (by decide)
  · simp only [epochReplayAction] at ok
    split at ok
    · exact held.carry ok
    · simp only [pure, Except.pure, Except.ok.injEq] at ok
      subst ok
      exact held
  -- The pending deposits and the pending consolidations each append one event of their source.
  all_goals
    simp only [epochReplayAction] at ok
    split at ok
    · simp only [bind_ok_iff, pure, Except.pure, Except.ok.injEq] at ok
      obtain ⟨_, _, rfl⟩ := ok
      intro e member
      rcases List.mem_append.mp member with old | added
      · exact held e old
      · rw [List.mem_singleton.mp added]
        exact nofun
    · simp only [pure, Except.pure, Except.ok.injEq] at ok
      subst ok
      exact held

/-- From Electra, a slot step records no sync pass. -/
private theorem slot_noSync {x y : ForkedBeaconState preset} (electra : .pectra ≤ x.fork)
    (ok : advanceSlotAcross config checks x = .ok y) (early : y.fork < .glamsterdam)
    {events : List (BalanceEvent preset)}
    (replayed : (Step.slot ok : Step config checks x y).balanceEvents = .ok events) :
    ∀ e ∈ events, e.source ≠ .sync := by
  obtain ⟨advanced, cached, crossings, advanceOk, upgrades, cachedOk, crossingOk, branch⟩ :=
    Step.balanceEvents_slot ok early replayed
  have noCrossings : crossings = [] :=
    DirectSafety.Apriori.Internal.upgradeBalanceReplay_electra_nil
      (u := ⟨x.fork, advanced⟩) electra crossingOk
  rcases branch with ⟨_, eventsEq⟩ | ⟨middle, updated, recorded, recordOk, _, _, _, eventsEq, _⟩
  · rw [eventsEq, noCrossings]
    intro e member
    cases member
  · rw [eventsEq, noCrossings, List.append_nil]
    have trace := epochBalanceReplay_trace recordOk
    have quiet := trace.transport (fun p q => NoSync p → NoSync q) (fun _ held => held)
      (fun one two held => two (one held))
      (fun _ member _ _ computed => replay_stage_noSync member computed)
    exact quiet (fun _ member => by cases member)

/-- The sync movements of a replay over a set of keys add up over the events of two replays. -/
private theorem sum_syncMoves_append (keys : Finset ℕ) (first second : List (BalanceEvent preset)) :
    ∑ i ∈ keys, (((first ++ second).map (syncCredit i)).sum +
      ((first ++ second).map (syncDebit i)).sum) =
    ∑ i ∈ keys, ((first.map (syncCredit i)).sum + (first.map (syncDebit i)).sum) +
      ∑ i ∈ keys, ((second.map (syncCredit i)).sum + (second.map (syncDebit i)).sum) := by
  rw [← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun i _ => ?_
  simp only [List.map_append, List.sum_append]
  omega

/-- A slot step neither debits nor credits a key for the sync committee. -/
private theorem slot_syncDebit_zero {x y : ForkedBeaconState preset} (electra : .pectra ≤ x.fork)
    (ok : advanceSlotAcross config checks x = .ok y) (early : y.fork < .glamsterdam)
    {events : List (BalanceEvent preset)}
    (replayed : (Step.slot ok : Step config checks x y).balanceEvents = .ok events) (i : ℕ) :
    (events.map (syncDebit i)).sum = 0 ∧ (events.map (syncCredit i)).sum = 0 :=
  ⟨List.sum_eq_zero fun v member => by
      obtain ⟨e, inside, rfl⟩ := List.mem_map.mp member
      simp [syncDebit, slot_noSync electra ok early replayed e inside],
    List.sum_eq_zero fun v member => by
      obtain ⟨e, inside, rfl⟩ := List.mem_map.mp member
      simp [syncCredit, slot_noSync electra ok early replayed e inside]⟩

/-- From Electra, a block step records no credit from the deposits source.

In Electra, deposits are credited in the epoch processing, so in slot steps.

A block step only queues deposit requests.

So the deposit events of the step raise no balance, by `blockReplay_unconditional`. -/
private theorem block_deposit_zero {f : Fork} {u w : BeaconState preset f}
    {engine : ExecutionEngine preset f} {signed : SignedBeaconBlock preset f}
    {due : upgradeDue config ⟨f, u⟩ = false}
    {ok : applySignedBlock config checks engine u signed true = .ok w}
    {es : List (BalanceEvent preset)} (electra : .pectra ≤ f) (early : f < .glamsterdam)
    (replayed : (Step.block engine signed due ok : Step config checks ⟨f, u⟩ ⟨f, w⟩).balanceEvents =
      .ok es) (i : ℕ) :
    ((es.filter fun e => decide (e.source = .deposits)).map (PinKeys.keyCredit i)).sum = 0 := by
  refine List.sum_eq_zero fun c member => ?_
  obtain ⟨e, inFilter, rfl⟩ := List.mem_map.mp member
  obtain ⟨inList, isDeposit⟩ := List.mem_filter.mp inFilter
  have unconditional := PinKeys.blockReplay_unconditional electra early engine u signed.message
    (Step.balanceEvents_block early replayed) e inList (of_decide_eq_true isDeposit) i
  unfold PinKeys.keyCredit
  omega

/-- A block step is apart from keys if the proposer at its end is not among them.

A slot step is apart from every set of keys. -/
private def stepApart (keys : Finset ℕ) :
    {x y : ForkedBeaconState preset} → Step config checks x y → Prop
  | _, _, .slot _ => True
  | _, y, .block .. => ∀ p, getBeaconProposerIndex y.state = .ok p → p.toNat ∉ keys

/-- The sync debits of a run fit the committee size times the envelope for each block of the run.

The credits and debits together fit one envelope and proposer share for each seat and block. -/
private theorem run_syncDebits_le {x y : ForkedBeaconState preset} (tail : Run config checks x y)
    (fulu : .fusaka ≤ x.fork) (early : y.fork < .glamsterdam) (high : ℕ)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    (total : ℕ)
    (band : ∀ {u w : ForkedBeaconState preset} (step : Step config checks u w),
      tail.Contains step → ∀ t : Gwei, getTotalActiveBalance w.state = .ok t →
        2 * t.toNat ≤ 3 * total)
    (keys : Finset ℕ) :
    ∑ i ∈ keys, (events.map (syncDebit i)).sum ≤
      tail.blockCount * (preset.SYNC_COMMITTEE_SIZE.toNat * PinTerms.syncEnvelope preset total) ∧
    ∑ i ∈ keys, ((events.map (syncCredit i)).sum + (events.map (syncDebit i)).sum) ≤
      tail.blockCount * (preset.SYNC_COMMITTEE_SIZE.toNat * syncSeatEnvelope preset total) ∧
    (∀ debited moving : Finset ℕ, Disjoint debited moving →
      (∀ {u w : ForkedBeaconState preset} (step : Step config checks u w),
        tail.Contains step → stepApart moving step) →
      syncSeatMoves debited moving events ≤
        tail.blockCount *
          (preset.SYNC_COMMITTEE_SIZE.toNat * PinTerms.syncEnvelope preset total)) := by
  induction tail generalizing events with
  | nil =>
    simp only [Run.balanceEvents, pure, Except.pure, Except.ok.injEq] at replayed
    subst replayed
    simp [Run.blockCount, syncSeatMoves]
  | @snoc middle last pre step ih =>
    have earlyMiddle : middle.fork < .glamsterdam :=
      Nat.lt_of_le_of_lt step.chainStep.fork_le early
    have fuluMiddle : .fusaka ≤ middle.fork :=
      Nat.le_trans fulu (fork_le_of_chainSteps pre.chainSteps)
    simp only [Run.balanceEvents, bind_ok_iff] at replayed
    obtain ⟨prior, priorOk, rest⟩ := replayed
    obtain ⟨priorDebits, priorMoves, priorApart⟩ := ih earlyMiddle priorOk
      (fun inner member => band inner (Run.Contains.earlier member step))
    have priorApart' := fun (debited moving : Finset ℕ) (apartSets : Disjoint debited moving)
        (apart : ∀ {u w : ForkedBeaconState preset} (inner : Step config checks u w),
          (pre.snoc step).Contains inner → stepApart moving inner) =>
      priorApart debited moving apartSets fun inner member =>
        apart inner (Run.Contains.earlier member step)
    split at rest
    · simp only [bind_ok_iff, pure, Except.pure, Except.ok.injEq] at rest
      obtain ⟨added, addedOk, rfl⟩ := rest
      have debitsSplit : ∑ i ∈ keys, ((prior ++ added).map (syncDebit i)).sum =
          ∑ i ∈ keys, (prior.map (syncDebit i)).sum +
            ∑ i ∈ keys, (added.map (syncDebit i)).sum := by
        simp only [List.map_append, List.sum_append, Finset.sum_add_distrib]
      rw [debitsSplit, sum_syncMoves_append]
      cases step with
      | slot ok =>
        have zero := slot_syncDebit_zero (Nat.le_trans (by decide) fuluMiddle) ok early addedOk
        have none : ∀ debited moving : Finset ℕ, syncSeatMoves debited moving added = 0 := by
          intro debited moving
          unfold syncSeatMoves
          simp [fun i => (zero i).1, fun i => (zero i).2]
        refine ⟨?_, ?_, fun debited moving apartSets apart => ?_⟩
        · simpa [fun i => (zero i).1, fun i => (zero i).2, Run.blockCount] using priorDebits
        · simpa [fun i => (zero i).1, fun i => (zero i).2, Run.blockCount] using priorMoves
        · rw [syncSeatMoves_append, none]
          simpa [Run.blockCount] using priorApart' debited moving apartSets apart
      | @block fork before after engine signed due ok =>
        have altair : Fork.altair ≤ fork :=
          Nat.le_trans (show Fork.altair ≤ Fork.fusaka by decide) fuluMiddle
        have replay := Step.balanceEvents_block early addedOk
        obtain ⟨bound, boundMoves, boundApart⟩ := block_syncDebits_le early altair replay total
          (fun T hT => band _ (Run.Contains.last pre _) T hT) keys
        simp only [Run.blockCount, Nat.add_mul, Nat.one_mul]
        refine ⟨by omega, by omega, fun debited moving apartSets apart => ?_⟩
        have here := boundApart debited moving apartSets (apart _ (Run.Contains.last pre _))
        have before := priorApart' debited moving apartSets apart
        rw [syncSeatMoves_append]
        omega
    · simp only [pure, Except.pure, Except.ok.injEq] at rest
      subst rest
      cases step with
      | slot ok =>
        simpa [Run.blockCount] using And.intro priorDebits (And.intro priorMoves priorApart')
      | block =>
        exact ⟨priorDebits.trans (Nat.mul_le_mul_right _ (Nat.le_succ _)),
          priorMoves.trans (Nat.mul_le_mul_right _ (Nat.le_succ _)),
          fun debited moving apartSets apart => (priorApart' debited moving apartSets apart).trans
            (Nat.mul_le_mul_right _ (Nat.le_succ _))⟩

/-- A run has at most one block for each slot of the epochs that it touches. -/
private theorem Run.blockCount_le_epochs {x y : ForkedBeaconState preset}
    (tail : Run config checks x y) (positive : 0 < preset.SLOTS_PER_EPOCH.toNat) :
    tail.blockCount ≤
      ((getCurrentEpoch y.state).toNat + 1 - (getCurrentEpoch x.state).toNat) *
        preset.SLOTS_PER_EPOCH.toNat := by
  have epochLe := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps tail.chainSteps)
  rw [getCurrentEpoch_toNat, getCurrentEpoch_toNat] at epochLe ⊢
  have low : x.state.slot.toNat / preset.SLOTS_PER_EPOCH.toNat * preset.SLOTS_PER_EPOCH.toNat ≤
      x.state.slot.toNat := Nat.div_mul_le_self _ _
  have high' := Nat.lt_mul_div_succ y.state.slot.toNat positive
  have blocks := tail.blocks_le_slots low (b := preset.SLOTS_PER_EPOCH.toNat *
      (y.state.slot.toNat / preset.SLOTS_PER_EPOCH.toNat + 1) - 1) (by omega)
  have difference : (y.state.slot.toNat / preset.SLOTS_PER_EPOCH.toNat + 1 -
      x.state.slot.toNat / preset.SLOTS_PER_EPOCH.toNat) * preset.SLOTS_PER_EPOCH.toNat =
      preset.SLOTS_PER_EPOCH.toNat * (y.state.slot.toNat / preset.SLOTS_PER_EPOCH.toNat + 1) -
        x.state.slot.toNat / preset.SLOTS_PER_EPOCH.toNat * preset.SLOTS_PER_EPOCH.toNat := by
    rw [Nat.sub_mul, Nat.mul_comm (preset.SLOTS_PER_EPOCH.toNat)]
  have grows : x.state.slot.toNat / preset.SLOTS_PER_EPOCH.toNat * preset.SLOTS_PER_EPOCH.toNat <
      preset.SLOTS_PER_EPOCH.toNat * (y.state.slot.toNat / preset.SLOTS_PER_EPOCH.toNat + 1) := by
    calc x.state.slot.toNat / preset.SLOTS_PER_EPOCH.toNat * preset.SLOTS_PER_EPOCH.toNat
        ≤ y.state.slot.toNat / preset.SLOTS_PER_EPOCH.toNat * preset.SLOTS_PER_EPOCH.toNat :=
          Nat.mul_le_mul_right _ epochLe
      _ < preset.SLOTS_PER_EPOCH.toNat *
          (y.state.slot.toNat / preset.SLOTS_PER_EPOCH.toNat + 1) := by
          rw [Nat.mul_add, Nat.mul_one, Nat.mul_comm]
          omega
  have counted : tail.blockCount ≤ (y.state.slot.toNat / preset.SLOTS_PER_EPOCH.toNat + 1 -
      x.state.slot.toNat / preset.SLOTS_PER_EPOCH.toNat) * preset.SLOTS_PER_EPOCH.toNat := by
    rw [difference]
    generalize x.state.slot.toNat / preset.SLOTS_PER_EPOCH.toNat *
      preset.SLOTS_PER_EPOCH.toNat = lowest at *
    generalize preset.SLOTS_PER_EPOCH.toNat *
      (y.state.slot.toNat / preset.SLOTS_PER_EPOCH.toNat + 1) = highest at *
    omega
  exact counted

/-- The blocks of a run fit one amount per seat for each slot of the epochs that the run touches.

The run has at most one block for each slot that it covers. -/
private theorem Run.blockCount_mul_le {x y : ForkedBeaconState preset}
    (tail : Run config checks x y) (amount : ℕ)
    (zero : preset.SLOTS_PER_EPOCH.toNat = 0 → amount = 0) :
    tail.blockCount * (preset.SYNC_COMMITTEE_SIZE.toNat * amount) ≤
      ((getCurrentEpoch y.state).toNat + 1 - (getCurrentEpoch x.state).toNat) *
        preset.SLOTS_PER_EPOCH.toNat * preset.SYNC_COMMITTEE_SIZE.toNat * amount := by
  by_cases empty : preset.SLOTS_PER_EPOCH.toNat = 0
  · simp [zero empty]
  calc tail.blockCount * (preset.SYNC_COMMITTEE_SIZE.toNat * amount)
      ≤ (((getCurrentEpoch y.state).toNat + 1 - (getCurrentEpoch x.state).toNat) *
        preset.SLOTS_PER_EPOCH.toNat) * (preset.SYNC_COMMITTEE_SIZE.toNat * amount) :=
        Nat.mul_le_mul_right _ (Run.blockCount_le_epochs tail (Nat.pos_of_ne_zero empty))
    _ = _ := by ring

/-- The sync debits of any set of keys over a run from Fulu fit one envelope per seat per slot.

The slots are those of the epochs that the run touches.

Every total along the run is within three halves of `total`.

Each block debits the keys at most one participant reward per seat.

Each block moves the keys at most one participant reward and its proposer share per seat.

If no block's proposer is among the keys, each block moves them at most one participant reward.

That reward is per seat. -/
private theorem Run.syncDebits_le {x y : ForkedBeaconState preset} (tail : Run config checks x y)
    (fulu : .fusaka ≤ x.fork) (early : y.fork < .glamsterdam) (high : ℕ)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    (total : ℕ)
    (band : ∀ {u w : ForkedBeaconState preset} (step : Step config checks u w),
      tail.Contains step → ∀ t : Gwei, getTotalActiveBalance w.state = .ok t →
        2 * t.toNat ≤ 3 * total)
    (keys : Finset ℕ) :
    ∑ i ∈ keys, (events.map (syncDebit i)).sum ≤
      ((getCurrentEpoch y.state).toNat + 1 - (getCurrentEpoch x.state).toNat) *
        preset.SLOTS_PER_EPOCH.toNat * preset.SYNC_COMMITTEE_SIZE.toNat *
          PinTerms.syncEnvelope preset total ∧
    ∑ i ∈ keys, ((events.map (syncCredit i)).sum + (events.map (syncDebit i)).sum) ≤
      ((getCurrentEpoch y.state).toNat + 1 - (getCurrentEpoch x.state).toNat) *
        preset.SLOTS_PER_EPOCH.toNat * preset.SYNC_COMMITTEE_SIZE.toNat *
          syncSeatEnvelope preset total ∧
    (∀ debited moving : Finset ℕ, Disjoint debited moving →
      (∀ {u w : ForkedBeaconState preset} (step : Step config checks u w),
        tail.Contains step → stepApart moving step) →
      syncSeatMoves debited moving events ≤
        ((getCurrentEpoch y.state).toNat + 1 - (getCurrentEpoch x.state).toNat) *
          preset.SLOTS_PER_EPOCH.toNat * preset.SYNC_COMMITTEE_SIZE.toNat *
            PinTerms.syncEnvelope preset total) := by
  have empty : preset.SLOTS_PER_EPOCH.toNat = 0 → PinTerms.syncEnvelope preset total = 0 :=
      fun empty => by
    unfold PinTerms.syncEnvelope
    rw [empty]
    simp
  have bounds := run_syncDebits_le tail fulu early high replayed total band keys
  exact ⟨bounds.1.trans (Run.blockCount_mul_le tail _ empty),
    bounds.2.1.trans (Run.blockCount_mul_le tail _ fun e => by
      unfold syncSeatEnvelope
      simp [empty e]),
    fun debited moving apartSets apart =>
      (bounds.2.2 debited moving apartSets apart).trans (Run.blockCount_mul_le tail _ empty)⟩

end PinSeatDebits

end

section

/-! ## PinSlashFloor -/

namespace PinSlashFloor

open Base Uint64 Models DirectSafety DirectSafety.Apriori.Internal

variable {preset : Preset} {config : Config} {checks : SignatureChecks}

/-- Every fork from Fulu on has the slashing quotient of Electra. -/
private theorem mspq_fusaka {f : Fork} (h : .fusaka ≤ f) :
    (EthLib.Consensus.parameters preset f).MIN_SLASHING_PENALTY_QUOTIENT =
      (EthLib.Consensus.parameters preset .fusaka).MIN_SLASHING_PENALTY_QUOTIENT := by
  have pectra : .pectra ≤ f := Nat.le_trans (by decide) h
  have pectra' : .pectra ≤ Fork.fusaka := by decide
  simp [EthLib.Consensus.parameters, ge_iff_le, pectra, pectra']


/-- Epochs cannot decrease, so a step inside a same-epoch run starts in that epoch. -/
private theorem step_start_epoch_eq {m n a b : ForkedBeaconState preset}
    (r : Run config checks m n) (same : getCurrentEpoch n.state = getCurrentEpoch m.state)
    (step : Step config checks a b) (member : r.Contains step) :
    getCurrentEpoch a.state = getCurrentEpoch m.state := by
  obtain ⟨before, after, -⟩ := r.contains_split step member
  exact UInt64.le_antisymm
    (same ▸ currentEpoch_le_of_chainSteps ((Run.nil.snoc step).append after).chainSteps)
    (currentEpoch_le_of_chainSteps before.chainSteps)

/-- A final step can cross the boundary, but it still starts in the prefix's epoch. -/
private theorem snoc_step_start_epoch_eq {m z n a b : ForkedBeaconState preset}
    (pre : Run config checks m z) (last : Step config checks z n)
    (same : getCurrentEpoch z.state = getCurrentEpoch m.state)
    (step : Step config checks a b) (member : (pre.snoc last).Contains step) :
    getCurrentEpoch a.state = getCurrentEpoch m.state := by
  cases member with
  | last => exact same
  | earlier member _ => exact step_start_epoch_eq pre same step member

open Classical in
/-- The rewards pass at the last state of the first epoch debits a key at most its pass rate.

The run stays in the epoch of `m` up to `z`, and the slot step `ok` leaves it.

The pass is a debit only when it reads a total active balance at `z`.

Otherwise it records no penalty. -/
private theorem lastPass_debit_le {m z n : ForkedBeaconState preset} (pre : Run config checks m z)
    (ok : advanceSlotAcross config checks z = .ok n) (altair : .altair ≤ m.fork)
    (early : n.fork < .glamsterdam) (same : getCurrentEpoch z.state = getCurrentEpoch m.state)
    (crossed : (getCurrentEpoch z.state).toNat < (getCurrentEpoch n.state).toNat)
    (endEpoch : (getCurrentEpoch n.state).toNat ≤ (getCurrentEpoch m.state).toNat + 1)
    {i : ℕ} (inside : i < m.state.validators.data.size) {events : List (BalanceEvent preset)}
    (replayed : (pre.snoc (Step.slot ok)).balanceEvents (getCurrentEpoch m.state).toNat =
      .ok events) :
    (events.map (penaltyDebit i)).sum ≤
      if ∃ total, getTotalActiveBalance z.state = .ok total then passPenaltyRate config z i
      else 0 := by
  have bound := segment_passDebit_le_guarded (pre.snoc (Step.slot ok)) early altair
    (getCurrentEpoch m.state).toNat endEpoch
    (snoc_step_start_epoch_eq pre (Step.slot ok) same) inside
    (if ∃ total, getTotalActiveBalance z.state = .ok total then passPenaltyRate config z i
      else 0)
    (fun {z'} pre' ok' split before found => by
      obtain ⟨total, -, totalOk, -⟩ := found
      have hasTotal : ∃ total, getTotalActiveBalance z'.state = .ok total := ⟨total, totalOk⟩
      cases split
      simp [hasTotal])
    replayed
  rwa [ite_eq_left (by rw [same] at crossed; exact UInt64.lt_iff_toNat_lt.mpr crossed)] at bound

open Classical in
/-- The floor of one key over a run that crosses at most one epoch boundary.

The run starts at `m`, reached from genesis, and ends at `n`, from Fulu and before Gloas.

It stays in the epoch of `m`.

Or it ends with the slot step that leaves that epoch, at the first slot of the next epoch.

The key must be assigned an activation at `m`, and not exit by the epoch after that of `m`.

If it is slashed at `m`, its delayed slashing penalty must not be due by the epoch of `n`.

Take any `C` below the key's largest effective balance at `m`.

The least of the balance at `m` and `C` is at most the balance at `n`, plus its debits.

The first debit is the pass at the last state `z` of the first epoch, if the run crosses its end.

The pass is a debit only when it reads a total active balance there.

Otherwise it records no penalty.

The others are the key's sync debits and its payments from the queue of partial withdrawals.

The last is its initial slashing penalty, if the run slashes it.

That penalty is the effective balance at `m` over the slashing quotient.

The effective balance changes only at the boundary, after any slashing before it. -/
private theorem epochFloor {g m n : ForkedBeaconState preset} (shared : Run config checks g m)
    (genesis : Genesis (config := config) (checks := checks) g) (caps : CapOrder preset)
    (delay : 0 < config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    (vector : 4 ≤ preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat)
    (positive :
      0 < (EthLib.Consensus.parameters preset .fusaka).MIN_SLASHING_PENALTY_QUOTIENT.toNat)
    (r : Run config checks m n) (hm : .fusaka ≤ m.fork) (hn : n.fork < .glamsterdam)
    (shape : getCurrentEpoch n.state = getCurrentEpoch m.state ∨
      ∃ (z : ForkedBeaconState preset) (pre : Run config checks m z)
        (ok : advanceSlotAcross config checks z = .ok n),
        r = pre.snoc (Step.slot ok) ∧ getCurrentEpoch z.state = getCurrentEpoch m.state ∧
          (getCurrentEpoch n.state).toNat = (getCurrentEpoch m.state).toNat + 1)
    (i : ℕ) (val : Validator) (hval : m.state.validators.data[i]? = some val)
    (hact : val.activationEpoch ≠ FAR_FUTURE_EPOCH)
    (hexit : ∀ w, n.state.validators.data[i]? = some w →
      (getCurrentEpoch m.state).toNat + 1 < w.exitEpoch.toNat)
    (hslash : val.slashed = true → (getCurrentEpoch n.state).toNat +
      preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat / 2 < val.withdrawableEpoch.toNat)
    (C : ℕ) (hC : C ≤ (withdrawalMaxEffectiveBalance preset m.fork val).toNat)
    {events : List (BalanceEvent preset)}
    (replayed : r.balanceEvents (getCurrentEpoch m.state).toNat = .ok events) :
    ∃ (z : ForkedBeaconState preset) (pre : Run config checks m z) (post : Run config checks z n),
      r = pre.append post ∧ getCurrentEpoch z.state = getCurrentEpoch m.state ∧
      min (actualBalanceAt m i) C ≤ actualBalanceAt n i +
        (if getCurrentEpoch m.state < getCurrentEpoch n.state ∧
            ∃ total, getTotalActiveBalance z.state = .ok total then
          passPenaltyRate config z i else 0) +
        (events.map (syncDebit i)).sum + (events.map (floorPartialDebit i.toUInt64)).sum +
        (if val.slashed = false ∧ ∃ w, n.state.validators.data[i]? = some w ∧ w.slashed = true
          then effectiveAt m i /
            (EthLib.Consensus.parameters preset m.fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat
          else 0) := by
  have mEarly : m.fork < .glamsterdam :=
    Nat.lt_of_le_of_lt (fork_le_of_chainSteps r.chainSteps) hn
  have inside : i < m.state.validators.data.size := (Array.getElem?_eq_some_iff.mp hval).1
  obtain ⟨iv, rfl⟩ : ∃ iv : ValidatorIndex, iv.toNat = i :=
    ⟨i.toUInt64, toNat_toUInt64_of_lt (m.state.validators.bound mEarly) inside⟩
  have altair : .altair ≤ m.fork := Nat.le_trans (by decide) hm
  have mn : (getCurrentEpoch m.state).toNat ≤ (getCurrentEpoch n.state).toNat :=
    UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps r.chainSteps)
  have endEpoch : (getCurrentEpoch n.state).toNat ≤ (getCurrentEpoch m.state).toNat + 1 := by
    rcases shape with same | ⟨z, pre, ok, req, hz, h1⟩
    · rw [same]; omega
    · omega
  -- Every step of the run starts in the epoch of `m`, at a fork from Fulu.
  have starts : ∀ {a b : ForkedBeaconState preset} (pre' : Run config checks m a)
      (step : Step config checks a b) (post : Run config checks b n),
      (pre'.snoc step).append post = r → getCurrentEpoch a.state = getCurrentEpoch m.state ∧
        .fusaka ≤ a.fork ∧ b.fork < .glamsterdam := by
    intro a b pre' step post split
    have forkLo := fork_le_of_chainSteps pre'.chainSteps
    have forkHi := fork_le_of_chainSteps post.chainSteps
    refine ⟨?_, Nat.le_trans hm forkLo, Nat.lt_of_le_of_lt forkHi hn⟩
    have member : r.Contains step := by
      rw [← split, Run.contains_append]
      exact .inl (.last _ _)
    rcases shape with same | ⟨z, pre, ok, req, hz, h1⟩
    · exact step_start_epoch_eq r same step member
    · exact snoc_step_start_epoch_eq pre (Step.slot ok) hz step (req ▸ member)
  obtain ⟨z, pre, post, hsplit, hz, hpen⟩ : ∃ (z : ForkedBeaconState preset)
      (pre : Run config checks m z) (post : Run config checks z n),
      r = pre.append post ∧ getCurrentEpoch z.state = getCurrentEpoch m.state ∧
      (events.map (penaltyDebit iv.toNat)).sum ≤
        (if getCurrentEpoch m.state < getCurrentEpoch n.state ∧
            ∃ total, getTotalActiveBalance z.state = .ok total then
          passPenaltyRate config z iv.toNat else 0) := by
    rcases shape with same | ⟨z, pre, ok, req, hz, h1⟩
    · refine ⟨n, r, .nil, rfl, same, ?_⟩
      have free := (epoch_sync_data r altair hn same _ replayed).2.1
      have quiet : ¬ (getCurrentEpoch m.state < getCurrentEpoch n.state ∧
          ∃ total, getTotalActiveBalance n.state = .ok total) := fun h =>
        absurd h.1 (by simp [same])
      simp only [quiet, ↓reduceIte]
      exact Nat.le_of_eq (List.sum_eq_zero fun _ member => by
        obtain ⟨e, present, rfl⟩ := List.mem_map.mp member
        simp [penaltyDebit, (free e present).1, (free e present).2])
    · subst req
      refine ⟨z, pre, Run.nil.snoc (Step.slot ok), rfl, hz, ?_⟩
      have crossed : getCurrentEpoch m.state < getCurrentEpoch n.state :=
        UInt64.lt_iff_toNat_lt.mpr (by omega)
      have hzn : (getCurrentEpoch z.state).toNat = (getCurrentEpoch m.state).toNat := by rw [hz]
      have bound := lastPass_debit_le pre ok altair hn hz (by omega) endEpoch inside replayed
      by_cases found : ∃ total, getTotalActiveBalance z.state = .ok total
      · simpa [crossed, found] using bound
      · simpa [found] using bound
  refine ⟨z, pre, post, hsplit, hz, ?_⟩
  have effEq : ∀ {a b : ForkedBeaconState preset} (pre' : Run config checks m a)
      (step : Step config checks a b) (post' : Run config checks b n),
      (pre'.snoc step).append post' = r → effectiveAt a iv.toNat = effectiveAt m iv.toNat := by
    intro a b pre' step post' split
    obtain ⟨epoch, -, bEarly⟩ := starts pre' step post' split
    have aEarly : a.fork < .glamsterdam := Nat.lt_of_le_of_lt step.chainStep.fork_le bEarly
    exact run_same_epoch_effective pre' aEarly epoch iv.toNat inside
  have positive' :
      0 < (EthLib.Consensus.parameters preset m.fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat := by
    rw [mspq_fusaka hm]; exact positive
  have half : (preset.EPOCHS_PER_SLASHINGS_VECTOR / 2).toNat =
      preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat / 2 := by simp
  obtain ⟨last, trace, balance, debt, -, w, final, -, used, -, bounded, startSlashed⟩ :=
    FloorTrace.run_of_le_cap_general shared r genesis caps delay hn
      (getCurrentEpoch m.state).toNat endEpoch iv val hval (Or.inl hact)
      (min (actualBalanceAt m iv.toNat) C) (effectiveAt m iv.toNat)
      (EthLib.Consensus.parameters preset m.fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat
      (Nat.le_trans (Nat.min_le_right _ _) hC) positive'
      (fun {a b} pre' step post' split w found => by
        obtain ⟨epoch, fusaka, bEarly⟩ := starts pre' step post' split
        have epochs : (getCurrentEpoch a.state).toNat = (getCurrentEpoch m.state).toNat := by
          rw [epoch]
        have atMost := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps
          ((Run.nil.snoc step).append post').chainSteps)
        have inv := Run.invariant genesis.invariant (shared.append pre')
        refine ⟨Or.inl ?_, ⟨fun _ => by omega, fun slashed => ?_⟩, ?_,
          fun evs hevs e member crossing => ?_⟩
        · obtain ⟨w', found', life⟩ := post'.registryLifecycle.validators iv.toNat w found
          have kept := hexit w' found'
          have small := w'.exitEpoch.toNat_lt
          by_cases assigned : w.exitEpoch = FAR_FUTURE_EPOCH
          · rw [assigned]
            simp [FAR_FUTURE_EPOCH]
            omega
          · rw [← life.exitEpoch assigned]; exact kept
        · have := hslash slashed
          omega
        · rw [mspq_fusaka hm, mspq_fusaka fusaka]
        · have sites := (step.balanceEvents_sites bEarly inv caps.compounding hevs) e member
          obtain ⟨before, -⟩ := sites.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2 crossing
          exact Nat.not_le_of_lt before (Nat.le_trans (by decide) fusaka))
      replayed
  obtain ⟨-, slashBound⟩ := bounded (effectiveAt m iv.toNat) le_rfl
    (fun pre' step post' split => (effEq pre' step post' split).le)
  have floor := FloorTrace.balance_floor_general trace
    (by simp)
  have split : (events.map (floorPenaltyDebit iv.toNat)).sum =
      (events.map (penaltyDebit iv.toNat)).sum + (events.map (syncDebit iv.toNat)).sum := by
    rw [← List.sum_map_add]
    rfl
  have index : iv.toNat.toUInt64 = iv := by simp
  rw [balance, debt, split] at floor
  rw [index]
  cases hs : last.slashedHigh with
  | none =>
    simp only [hs, Option.elim] at floor
    omega
  | some h =>
    have atMost := slashBound h hs
    have slashed : w.slashed = true := by
      cases hw : w.slashed
      · simp [hs, hw] at used
      · rfl
    have unslashed : val.slashed = false := by
      cases hv : val.slashed
      · rfl
      · have := startSlashed hv
        rw [hs] at this
        cases this
    simp only [hs, Option.elim] at floor
    have cond : val.slashed = false ∧ ∃ w, n.state.validators.data[iv.toNat]? = some w ∧
        w.slashed = true := ⟨unslashed, w, final, slashed⟩
    simp only [cond, and_self, ↓reduceIte]
    omega

end PinSlashFloor

end

section

/-! ## The floor path of a new key's effective balance -/

namespace PinKeys

open Base Uint64 Models DirectSafety PinKeyFloor PinSlashFloor

variable {preset : Preset} {fork : Fork} {config : Config} {checks : SignatureChecks}

/-! ## A potential that retains a decreasing floor -/

/-- One epoch keeps the fraction of the potential that the floor keeps, up to a rounding error.

The floor `φj` never rises, and stays within three halves of its start `φ0`.

The potential `dj` keeps the fraction `φj1 / φj` of itself, less the error `e`.

Then `d0` keeps the fraction `φj1 / φ0` of itself after `j + 1` epochs.

It loses `3 e (j + 1) / 2` over `φ0`. -/
private theorem chain_step (φ0 φj φj1 d0 dj dj1 e j : ℕ) (pos : 0 < φj) (anti : φj1 ≤ φj)
    (band : 2 * φ0 ≤ 3 * φj) (ih : 2 * d0 * φj ≤ 2 * dj * φ0 + 3 * e * j)
    (step : dj * φj1 ≤ dj1 * φj + e) :
    2 * d0 * φj1 ≤ 2 * dj1 * φ0 + 3 * e * (j + 1) := by
  refine Nat.le_of_mul_le_mul_right ?_ pos
  calc 2 * d0 * φj1 * φj = (2 * d0 * φj) * φj1 := by ring
    _ ≤ (2 * dj * φ0 + 3 * e * j) * φj1 := Nat.mul_le_mul_right _ ih
    _ = 2 * φ0 * (dj * φj1) + 3 * e * j * φj1 := by ring
    _ ≤ 2 * φ0 * (dj1 * φj + e) + 3 * e * j * φj := by
        apply Nat.add_le_add
        · exact Nat.mul_le_mul_left _ step
        · exact Nat.mul_le_mul_left _ anti
    _ = 2 * dj1 * φ0 * φj + 2 * φ0 * e + 3 * e * j * φj := by ring
    _ ≤ 2 * dj1 * φ0 * φj + 3 * φj * e + 3 * e * j * φj := by
        have := Nat.mul_le_mul_right e band
        omega
    _ = (2 * dj1 * φ0 + 3 * e * (j + 1)) * φj := by ring

/-! ## One epoch of a key against the floor path -/

/-- The effective balance `EB` is within the band above the least of the balance and the cap.

The least of the balance and `K` is at most the least of the balance and the cap. -/
private theorem eb_le_min_band (b' cap K band EB : ℕ) (hcap : K ≤ cap)
    (hyst : EB ≤ b' + band) (hcapEB : EB ≤ cap) :
    EB ≤ min b' cap + band ∧ min b' K ≤ min b' cap := by
  refine ⟨?_, min_le_min_left _ hcap⟩
  rcases le_total b' cap with h | h
  · rw [min_eq_left h]
    exact hyst
  · rw [min_eq_right h]
    omega

/-- An epoch that starts at or above `K` keeps the potential, since the floor only falls. -/
private theorem big_arith (c K band X φt φt1 : ℕ) (hc : c ≤ K) (hφ : φt1 ≤ φt) :
    (c + band) * φt1 ≤ (K + band) * φt + (K + band) + X * φt := by
  have := Nat.mul_le_mul (Nat.add_le_add_right hc band) hφ
  nlinarith

/-- One epoch of a key keeps the fraction of its potential that the floor keeps.

The potential is the least of the balance and `K`, plus the downward band.

The epoch loses at most its pass.

The pass is charged at the effective balance `EB`.

That balance lies within the band above the balance, and below the cap.

The pass rate is at most `EB * (pen + 1) / φt`.

Here `φt = φt1 + pen` is the floor before the epoch, and `φt1` the floor after it.

The error is `K + band`, from the rounding. -/
private theorem step_arith (b' b cap K band pass X φt φt1 pen EB : ℕ)
    (hcap : K ≤ cap)
    (seg : min b' cap ≤ b + pass + X)
    (hyst : EB ≤ b' + band) (hcapEB : EB ≤ cap)
    (pr : pass * φt ≤ EB * (pen + 1))
    (ph : φt = φt1 + pen) (hφ : 1 ≤ φt1) :
    (min b' K + band) * φt1 ≤ (min b K + band) * φt + (K + band) + X * φt := by
  obtain ⟨hEB, hcle⟩ := eb_le_min_band b' cap K band EB hcap hyst hcapEB
  set C := min b' cap with hC
  -- the key's balance after the epoch, scaled
  have bound : C * φt ≤ b * φt + (C + band) * (pen + 1) + X * φt := by
    have h1 : C * φt ≤ (b + pass + X) * φt := Nat.mul_le_mul_right _ seg
    have h2 : pass * φt ≤ (C + band) * (pen + 1) :=
      pr.trans (Nat.mul_le_mul_right _ hEB)
    nlinarith
  by_cases big : K ≤ b
  · rw [min_eq_right big]
    exact big_arith _ _ _ _ _ _ (min_le_right _ _) (by omega)
  · have small : b < K := Nat.lt_of_not_ge big
    have : min b K = b := min_eq_left small.le
    rw [this]
    -- c ≤ C, and the bound on C·φt1
    set c := min b' K with hc
    have hcK : c ≤ K := min_le_right _ _
    have key : C * φt ≤ b * φt + (C + band) * (pen + 1) + X * φt := bound
    -- (C + band) * (pen + 1) = (C + band) * pen + (C + band)
    have e1 : (C + band) * (pen + 1) = (C + band) * pen + (C + band) := by ring
    -- C * φt - (C+band) pen = C * φt1 - band * pen
    have e2 : C * φt = C * φt1 + C * pen := by rw [ph]; ring
    have lower : (C + band) * φt1 ≤ (b + band) * φt + (C + band) + X * φt := by
      rw [ph] at key ⊢
      nlinarith
    -- replace C by c: C could exceed K, then use the shape of the loss
    by_cases cK : C ≤ K
    · have hcC : c = C := le_antisymm hcle (le_min (min_le_left _ _) cK)
      rw [hcC]
      have : (C + band) ≤ (K + band) := by omega
      omega
    · have above : K < C := Nat.lt_of_not_ge cK
      have h3 : C * φt1 ≤ b * φt + C + band * (pen + 1) + X * φt := by
        rw [ph] at key
        nlinarith
      have h4 : K * φt1 + C ≤ C * φt1 + K := by
        have : K * (φt1 - 1) ≤ C * (φt1 - 1) := Nat.mul_le_mul_right _ above.le
        have e1 : K * (φt1 - 1) + K = K * φt1 := by
          have := Nat.mul_le_mul_left K hφ
          rw [Nat.mul_sub]; omega
        have e2 : C * (φt1 - 1) + C = C * φt1 := by
          have := Nat.mul_le_mul_left C hφ
          rw [Nat.mul_sub]; omega
        omega
      have h5 : (c + band) * φt1 ≤ (K + band) * φt1 := Nat.mul_le_mul_right _ (by omega)
      rw [ph]
      nlinarith

/-- One epoch of a key, with the initial penalty of a slashing in it.

The penalty is at most `EB / Q`, and the epoch is charged `Bq` for it, with `K + band ≤ Q * Bq`.

The floor after the epoch stays at least `6 Q` and within three halves of the floor before. -/
private theorem step_arith_slash (b' b cap K band pass X sl Q Bq φt φt1 pen EB : ℕ)
    (hcap : K ≤ cap) (hQ : 2 ≤ Q) (hB : K + band ≤ Q * Bq)
    (seg : min b' cap ≤ b + pass + X + sl) (hsl : Q * sl ≤ EB)
    (hyst : EB ≤ b' + band) (hcapEB : EB ≤ cap)
    (pr : pass * φt ≤ EB * (pen + 1))
    (ph : φt = φt1 + pen) (hφ : 6 * Q ≤ φt1) (hband : 2 * φt ≤ 3 * φt1) :
    (min b' K + band) * φt1 ≤
      (min b K + band) * φt + (K + band) + (X + (if sl = 0 then 0 else Bq)) * φt := by
  by_cases noSlash : sl = 0
  · subst noSlash
    simp only [ite_true, Nat.add_zero, Nat.add_zero] at seg ⊢
    have := step_arith b' b cap K band pass X φt φt1 pen EB hcap (by simpa using seg) hyst
      hcapEB pr ph (by omega)
    simpa using this
  · simp only [noSlash, ite_false]
    obtain ⟨hEB, hcle⟩ := eb_le_min_band b' cap K band EB hcap hyst hcapEB
    set C := min b' cap with hC
    by_cases cK : C ≤ K
    · -- the penalty is at most `Bq`, and the case is that without slashing
      have slB : sl ≤ Bq := by
        have : Q * sl ≤ Q * Bq := by omega
        exact Nat.le_of_mul_le_mul_left this (by omega)
      have := step_arith b' b cap K band pass (X + sl) φt φt1 pen EB hcap
        (by omega) hyst hcapEB pr ph (by omega)
      have h2 : (X + sl) * φt ≤ (X + Bq) * φt := Nat.mul_le_mul_right _ (by omega)
      omega
    · have above : K < C := Nat.lt_of_not_ge cK
      by_cases big : K ≤ b
      · rw [min_eq_right big]
        exact big_arith _ _ _ _ _ _ (min_le_right _ _) (by omega)
      · have small : b < K := Nat.lt_of_not_ge big
        have : min b K = b := min_eq_left small.le
        rw [this]
        have hc : min b' K ≤ K := min_le_right _ _
        obtain ⟨h, hh⟩ : ∃ h, Q * φt1 = h + Q + φt := by
          refine ⟨Q * φt1 - Q - φt, ?_⟩
          have : 3 * (Q * φt1) ≥ 2 * Q * φt := by nlinarith
          have : Q * φt1 ≥ Q + φt := by nlinarith
          omega
        have h1 : Q * C * φt ≤ Q * b * φt + Q * (C + band) * (pen + 1) + Q * X * φt +
            (C + band) * φt := by
          have a1 : C * φt ≤ (b + pass + X + sl) * φt := Nat.mul_le_mul_right _ seg
          have a2 : pass * φt ≤ (C + band) * (pen + 1) := pr.trans (Nat.mul_le_mul_right _ hEB)
          have a3 : Q * sl ≤ C + band := hsl.trans hEB
          have a4 : Q * (sl * φt) ≤ (C + band) * φt := by
            rw [← Nat.mul_assoc]; exact Nat.mul_le_mul_right _ a3
          have a5 : Q * (pass * φt) ≤ Q * ((C + band) * (pen + 1)) := Nat.mul_le_mul_left _ a2
          have a6 : Q * (C * φt) ≤ Q * ((b + pass + X + sl) * φt) := Nat.mul_le_mul_left _ a1
          have a7 : Q * ((b + pass + X + sl) * φt) =
              Q * (b * φt) + Q * (pass * φt) + Q * (X * φt) + Q * (sl * φt) := by ring
          have a8 : Q * C * φt = Q * (C * φt) := by ring
          have a9 : Q * b * φt = Q * (b * φt) := by ring
          have a10 : Q * (C + band) * (pen + 1) = Q * ((C + band) * (pen + 1)) := by ring
          have a11 : Q * X * φt = Q * (X * φt) := by ring
          rw [a8, a9, a10, a11]
          omega
        have e1 : Q * C * φt = Q * C * φt1 + Q * C * pen := by rw [ph]; ring
        have e2 : Q * (C + band) * (pen + 1) =
            Q * C * pen + Q * C + Q * band * pen + Q * band := by ring
        have e3 : C * (Q * φt1) = C * h + C * Q + C * φt := by rw [hh]; ring
        have e4 : (C + band) * φt = C * φt + band * φt := by ring
        have hC : C * h ≤ Q * b * φt + Q * band * pen + Q * band + Q * X * φt + band * φt := by
          linarith [h1, e1, e2, e3, e4]
        have h2 : K * h ≤ C * h := Nat.mul_le_mul_right _ above.le
        have e5 : K * (Q * φt1) = K * h + K * Q + K * φt := by rw [hh]; ring
        have e6 : Q * band * φt = Q * band * φt1 + Q * band * pen := by rw [ph]; ring
        have h3 : Q * K * φt1 + Q * band * φt1 ≤
            Q * b * φt + Q * band * φt + Q * (K + band) + Q * X * φt + (K + band) * φt := by
          have e7 : (K + band) * φt = K * φt + band * φt := by ring
          have e8 : Q * (K + band) = Q * K + Q * band := by ring
          linarith [hC, h2, e5, e6, e7, e8]
        have h4 : (K + band) * φt ≤ Q * Bq * φt := Nat.mul_le_mul_right _ hB
        have h5 : (min b' K + band) * φt1 ≤ (K + band) * φt1 := Nat.mul_le_mul_right _ (by omega)
        have h6 : Q * ((K + band) * φt1) ≤
            Q * ((b + band) * φt + (K + band) + (X + Bq) * φt) := by
          have e9 : Q * ((K + band) * φt1) = Q * K * φt1 + Q * band * φt1 := by ring
          have e10 : Q * ((b + band) * φt + (K + band) + (X + Bq) * φt) =
              Q * b * φt + Q * band * φt + Q * (K + band) + Q * X * φt + Q * Bq * φt := by ring
          rw [e9, e10]
          omega
        have h7 := Nat.le_of_mul_le_mul_left h6 (by omega)
        omega

/-! ## The state before a new key is scheduled -/

/-- One step of a chain moves the current epoch on by at most one. -/
private theorem ChainStep.epoch_le_succ {a b : ForkedBeaconState preset}
    (step : ChainStep config checks a b) :
    (getCurrentEpoch b.state).toNat ≤ (getCurrentEpoch a.state).toNat + 1 := by
  cases step with
  | slot ok =>
    obtain ⟨advanced, slotOk, upgrades⟩ := bind_ok_iff.mp ok
    have kept := processUpgrades_slot upgrades
    have next := advanceSlot_slot slotOk
    rw [getCurrentEpoch_toNat, getCurrentEpoch_toNat]
    simp only at kept next ⊢
    rw [kept, next]
    by_cases zero : preset.SLOTS_PER_EPOCH.toNat = 0
    · simp [zero]
    · have positive : 1 ≤ preset.SLOTS_PER_EPOCH.toNat := Nat.pos_of_ne_zero zero
      calc (a.state.slot.toNat + 1) / preset.SLOTS_PER_EPOCH.toNat
          ≤ (a.state.slot.toNat + preset.SLOTS_PER_EPOCH.toNat) /
              preset.SLOTS_PER_EPOCH.toNat :=
            Nat.div_le_div_right (Nat.add_le_add_left positive _)
        _ = a.state.slot.toNat / preset.SLOTS_PER_EPOCH.toNat + 1 :=
            Nat.add_div_right _ positive
  | block engine signed validate ok =>
    have same := processBlock_slot (applySignedBlock_ok ok).2.1
    simp only [getCurrentEpoch, same]
    exact Nat.le_succ _

/-- A run from an epoch to a later one has a slot step that leaves a given epoch between them. -/
private theorem Run.cross_split {x y : ForkedBeaconState preset} (tail : Run config checks x y)
    (k : ℕ) (low : (getCurrentEpoch x.state).toNat ≤ k)
    (high : k < (getCurrentEpoch y.state).toNat) :
    ∃ (z n : ForkedBeaconState preset) (pre : Run config checks x z)
      (ok : advanceSlotAcross config checks z = .ok n) (rest : Run config checks n y),
      tail = (pre.snoc (Step.slot ok)).append rest ∧ (getCurrentEpoch z.state).toNat = k ∧
        (getCurrentEpoch n.state).toNat = k + 1 := by
  obtain ⟨m, n, pre, step, post, split, hm, hn⟩ :=
    Run.split_at_flip tail (fun z => k < (getCurrentEpoch z.state).toNat) (by omega) high
  have missing : ¬k < (getCurrentEpoch m.state).toNat := hm
  have gained : k < (getCurrentEpoch n.state).toNat := hn
  have bound := ChainStep.epoch_le_succ step.chainStep
  cases step with
  | slot ok => exact ⟨m, n, pre, ok, post, split, by omega, by omega⟩
  | @block fork before after engine signed due ok =>
    have same := processBlock_slot (applySignedBlock_ok ok).2.1
    have e : (getCurrentEpoch after).toNat = (getCurrentEpoch before).toNat := by
      simp only [getCurrentEpoch, same]
    simp only at missing gained
    omega

/-- A run that starts at or before an epoch and ends at or after it passes a state of that epoch. -/
private theorem Run.exists_epoch_split {x y : ForkedBeaconState preset}
    (tail : Run config checks x y) (k : ℕ)
    (low : (getCurrentEpoch x.state).toNat ≤ k) (high : k ≤ (getCurrentEpoch y.state).toNat) :
    ∃ (z : ForkedBeaconState preset) (pre : Run config checks x z) (post : Run config checks z y),
      (getCurrentEpoch z.state).toNat = k ∧ tail = pre.append post := by
  by_cases last : k = (getCurrentEpoch y.state).toNat
  · exact ⟨y, tail, .nil, last.symm, rfl⟩
  · obtain ⟨z, n, pre, ok, rest, split, hz, -⟩ := Run.cross_split tail k low (by omega)
    exact ⟨z, pre, (Run.nil.snoc (Step.slot ok)).append rest, hz, by
      rw [split, Run.append_assoc]; rfl⟩

/-- A key that is activated by the end of a run is scheduled two epochs before its activation.

The key may have exited, so long as its activation is before its exit.

It is not active by the epoch after the start of the run.

At the state `z` that the run reaches in that epoch, the key holds its activation epoch `A`.

Activity up to `A` is fixed at `z`, since the seed lookahead is at least three epochs. -/
private theorem Run.start_state {x y : ForkedBeaconState preset} (tail : Run config checks x y)
    (window : preset.SeedLookaheadAtLeastThree) (i : ℕ)
    (pending : ∀ v, x.state.validators.data[i]? = some v →
      (getCurrentEpoch x.state).toNat + 1 < v.activationEpoch.toNat)
    (activated : ∃ vy, y.state.validators.data[i]? = some vy ∧
      vy.activationEpoch ≠ FAR_FUTURE_EPOCH ∧ vy.activationEpoch ≤ getCurrentEpoch y.state)
    (ordered : ∀ vy, y.state.validators.data[i]? = some vy →
      vy.activationEpoch.toNat < vy.exitEpoch.toNat) :
    ∃ (z : ForkedBeaconState preset) (pre : Run config checks x z) (post : Run config checks z y)
      (v0 vy : Validator), tail = pre.append post ∧ z.state.validators.data[i]? = some v0 ∧
      y.state.validators.data[i]? = some vy ∧ v0.activationEpoch = vy.activationEpoch ∧
      (getCurrentEpoch z.state).toNat + 2 = vy.activationEpoch.toNat ∧
      vy.activationEpoch.toNat ≤ (getCurrentEpoch y.state).toNat := by
  obtain ⟨vy, foundY, -, activeY⟩ := activated
  have lowY := UInt64.le_iff_toNat_le.mp activeY
  have highY := ordered vy foundY
  have exitBound := vy.exitEpoch.toNat_lt
  have fixedWindow : 3 ≤ preset.MAX_SEED_LOOKAHEAD.toNat := window
  -- Activity at the epoch `A` of the key, as the end state reads it.
  have activeAtA : isActiveAt y.state vy.activationEpoch i = true := by
    refine isActiveAt_eq_true_iff.mpr ⟨vy, foundY, ?_⟩
    simp only [isActiveValidator, Bool.and_eq_true, decide_eq_true_eq]
    exact ⟨UInt64.le_refl _, UInt64.lt_iff_toNat_lt.mpr highY⟩
  have kept (h : ForkedBeaconState preset) (run : Run config checks h y)
      (le : vy.activationEpoch.toNat ≤ (getCurrentEpoch h.state).toNat +
        preset.MAX_SEED_LOOKAHEAD.toNat) :
      isActiveAt h.state vy.activationEpoch i = true := by
    have bound : vy.activationEpoch ≤ activityFixedEpoch h.state := by
      rw [UInt64.le_iff_toNat_le, activityFixedEpoch_toNat]
      omega
    rw [← activeKept_of_chainSteps run.chainSteps _ bound]
    exact activeAtA
  -- The key is not active by the epoch after the start of the run.
  have later : (getCurrentEpoch x.state).toNat + 1 < vy.activationEpoch.toNat := by
    by_contra early
    have atX := kept x tail (by omega)
    obtain ⟨vx, foundX, activeX⟩ := isActiveAt_eq_true_iff.mp atX
    simp only [isActiveValidator, Bool.and_eq_true, decide_eq_true_eq] at activeX
    have := pending vx foundX
    have := UInt64.le_iff_toNat_le.mp activeX.1
    omega
  have startEpoch := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps tail.chainSteps)
  obtain ⟨z, pre, post, epoch, split⟩ :=
    Run.exists_epoch_split tail (vy.activationEpoch.toNat - 2) (by omega) (by omega)
  have atZ := kept z post (by omega)
  obtain ⟨v0, foundZ, activeZ⟩ := isActiveAt_eq_true_iff.mp atZ
  simp only [isActiveValidator, Bool.and_eq_true, decide_eq_true_eq] at activeZ
  have assigned : v0.activationEpoch ≠ FAR_FUTURE_EPOCH := by
    intro far
    have := UInt64.le_iff_toNat_le.mp activeZ.1
    rw [far] at this
    have : FAR_FUTURE_EPOCH.toNat = 2 ^ 64 - 1 := rfl
    omega
  obtain ⟨w, foundW, life⟩ := post.registryLifecycle.validators i v0 foundZ
  have same : w = vy := Option.some.inj (foundW.symm.trans foundY)
  subst same
  exact ⟨z, pre, post, v0, w, split, foundZ, foundY, (life.activationEpoch assigned).symm,
    by omega, lowY⟩

/-! ## The pass rate against the floor path -/

section FloorPath

open DirectSafety.Apriori

/-- The base-reward part of the pass rate fits the base-reward part of the floor's penalty.

The pass reads the root of a total at least that of the floor.

The floor's penalty is read at a weight at least the floor.

The constants satisfy `a * d + b * d ≤ c * b`, which leaves room for the rounding. -/
private theorem pass_first (a b c d BRF EB φ w s T : ℕ) (hb : 0 < b) (hd : 0 < d) (hs : 0 < s)
    (sT : s ≤ T) (sφ : s ≤ φ) (hw : φ ≤ w) (hBRF : 1 ≤ BRF) (ratio : a * d + b * d ≤ c * b) :
    a * BRF * EB / (b * T) * φ ≤ EB * (c * BRF * w / (d * s)) := by
  set Q1 := a * BRF * EB / (b * T) with hQ1
  set P := c * BRF * w / (d * s) with hP
  have h1 : Q1 * (b * T) ≤ a * BRF * EB := Nat.div_mul_le_self _ _
  have h2 : c * BRF * w < (P + 1) * (d * s) := by
    have := Nat.lt_mul_div_succ (c * BRF * w) (Nat.mul_pos hd hs)
    rw [← hP] at this
    linarith
  have step1 : Q1 * φ * (b * d * s) ≤ a * d * BRF * EB * φ := by
    calc Q1 * φ * (b * d * s) = (Q1 * (b * s)) * φ * d := by ring
      _ ≤ (Q1 * (b * T)) * φ * d := by
          apply Nat.mul_le_mul_right; apply Nat.mul_le_mul_right
          exact Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ sT)
      _ ≤ (a * BRF * EB) * φ * d := by
          apply Nat.mul_le_mul_right; exact Nat.mul_le_mul_right _ h1
      _ = a * d * BRF * EB * φ := by ring
  have step2 : b * EB * (d * s) ≤ b * d * BRF * EB * φ := by
    have : d * s ≤ d * (BRF * φ) :=
      Nat.mul_le_mul_left _ (sφ.trans (Nat.le_mul_of_pos_left _ hBRF))
    calc b * EB * (d * s) ≤ b * EB * (d * (BRF * φ)) := Nat.mul_le_mul_left _ this
      _ = b * d * BRF * EB * φ := by ring
  have step3 : (a * d + b * d) * BRF * EB * φ ≤ b * EB * (c * BRF * w) := by
    calc (a * d + b * d) * BRF * EB * φ ≤ (c * b) * BRF * EB * φ := by
          apply Nat.mul_le_mul_right; apply Nat.mul_le_mul_right; apply Nat.mul_le_mul_right
          exact ratio
      _ ≤ (c * b) * BRF * EB * w := Nat.mul_le_mul_left _ hw
      _ = b * EB * (c * BRF * w) := by ring
  have step4 : b * EB * (c * BRF * w) ≤ b * EB * (P * (d * s)) + b * EB * (d * s) := by
    have : c * BRF * w ≤ P * (d * s) + d * s := by linarith
    calc b * EB * (c * BRF * w) ≤ b * EB * (P * (d * s) + d * s) := Nat.mul_le_mul_left _ this
      _ = b * EB * (P * (d * s)) + b * EB * (d * s) := by ring
  have key : Q1 * φ * (b * d * s) ≤ EB * P * (b * d * s) := by
    have e : (a * d + b * d) * BRF * EB * φ = a * d * BRF * EB * φ + b * d * BRF * EB * φ := by ring
    have e2 : b * EB * (P * (d * s)) = EB * P * (b * d * s) := by ring
    omega
  exact Nat.le_of_mul_le_mul_right key (Nat.mul_pos (Nat.mul_pos hb hd) hs)

/-- The leak part of the pass rate fits the leak part of the floor's penalty.

The divisor of the penalty is at most the divisor of the pass.

The score of the pass is at most that of the penalty, and the rounding costs one. -/
private theorem pass_second (bias IPQ IPD EB score S' φ w : ℕ) (hIPD : 0 < IPD)
    (div : IPD ≤ bias * IPQ) (sc : score + bias ≤ S') (hw : φ ≤ w) :
    EB * (score + bias) / (bias * IPQ) * φ ≤ EB * (w * S' / IPD + 1) := by
  set Q2 := EB * (score + bias) / (bias * IPQ) with hQ2
  set R := w * S' / IPD with hR
  have h0 : Q2 ≤ EB * (score + bias) / IPD := Nat.div_le_div_left div hIPD
  have h1 : (EB * (score + bias) / IPD) * IPD ≤ EB * (score + bias) := Nat.div_mul_le_self _ _
  have h2 : w * S' < (R + 1) * IPD := by
    have := Nat.lt_mul_div_succ (w * S') hIPD
    rw [← hR] at this
    linarith
  have key : Q2 * φ * IPD ≤ EB * (R + 1) * IPD := by
    calc Q2 * φ * IPD ≤ (EB * (score + bias) / IPD) * φ * IPD :=
          Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ h0)
      _ = ((EB * (score + bias) / IPD) * IPD) * φ := by ring
      _ ≤ (EB * (score + bias)) * φ := Nat.mul_le_mul_right _ h1
      _ ≤ (EB * S') * w := Nat.mul_le_mul (Nat.mul_le_mul_left _ sc) hw
      _ = EB * (w * S') := by ring
      _ ≤ EB * ((R + 1) * IPD) := Nat.mul_le_mul_left _ h2.le
      _ = EB * (R + 1) * IPD := by ring
  exact Nat.le_of_mul_le_mul_right key hIPD

/-- The floor path falls by the penalty of its epoch. -/
private theorem floor_succ (x : ForkedBeaconState preset) (high t : ℕ) :
    stakeFloorAt config x high (t + 1) = stakeFloorAt config x high t -
      epochPenalty preset config (startInactivityScore config x)
        (stakeCeilingAt config x high t + slashedUnwithdrawnStake x)
        (stakeFloorAt config x high t) t := by
  rfl

/-- The pass rate of a key against the fall of the floor path.

The floor lies below the total active balance read by the pass, and below the weight of the penalty.

The floor after the epoch is positive, so its fall is the penalty.

The score of the key at the pass, plus the bias, is within that of the penalty.

The rate times the floor is at most the key's effective balance times the fall, plus one. -/
private theorem passRate_mul_le {x z : ForkedBeaconState preset} (high t i : ℕ)
    (total : Gwei) (totalOk : getTotalActiveBalance z.state = .ok total)
    (floor : stakeFloorAt config x high t ≤ total.toNat)
    (floorLe : stakeFloorAt config x high t ≤
      stakeCeilingAt config x high t + slashedUnwithdrawnStake x)
    (positive : 0 < stakeFloorAt config x high (t + 1))
    (divisor : 0 < inactivityPenaltyDivisor preset config)
    (factor : 1 ≤ preset.BASE_REWARD_FACTOR.toNat)
    (scored : (if altair : .altair ≤ z.fork then
        (((z.state.inactivityScores altair).data[i]?).map (·.toNat)).getD 0 else 0) +
      config.INACTIVITY_SCORE_BIAS.toNat ≤
        startInactivityScore config x + config.INACTIVITY_SCORE_BIAS.toNat * (t + 1)) :
    passPenaltyRate config z i * stakeFloorAt config x high t ≤
      effectiveAt z i *
        (stakeFloorAt config x high t - stakeFloorAt config x high (t + 1) + 1) := by
  have succ := floor_succ (config := config) x high t
  have pen : stakeFloorAt config x high t - stakeFloorAt config x high (t + 1) =
      epochPenalty preset config (startInactivityScore config x)
        (stakeCeilingAt config x high t + slashedUnwithdrawnStake x)
        (stakeFloorAt config x high t) t := by omega
  rw [pen]
  have fpos : 0 < stakeFloorAt config x high t := by omega
  have rootPos : 0 < (stakeFloorAt config x high t).sqrt := Nat.sqrt_pos.mpr fpos
  have roots := Nat.sqrt_le_sqrt floor
  have quotient : inactivityPenaltyDivisor preset config ≤ config.INACTIVITY_SCORE_BIAS.toNat *
      (EthLib.Consensus.parameters preset z.fork).INACTIVITY_PENALTY_QUOTIENT.toNat := by
    unfold inactivityPenaltyDivisor
    apply Nat.mul_le_mul_left
    simp only [EthLib.Consensus.parameters]
    split_ifs <;> omega
  have first := pass_first (TIMELY_SOURCE_WEIGHT.toNat + TIMELY_TARGET_WEIGHT.toNat)
    WEIGHT_DENOMINATOR.toNat (3 + BASE_REWARDS_PER_EPOCH.toNat) BASE_REWARDS_PER_EPOCH.toNat
    preset.BASE_REWARD_FACTOR.toNat (effectiveAt z i) (stakeFloorAt config x high t)
    (stakeCeilingAt config x high t + slashedUnwithdrawnStake x)
    (stakeFloorAt config x high t).sqrt total.toNat.sqrt (by decide) (by decide) rootPos
    roots (Nat.sqrt_le_self _) floorLe factor (by decide)
  have second := pass_second config.INACTIVITY_SCORE_BIAS.toNat
    (EthLib.Consensus.parameters preset z.fork).INACTIVITY_PENALTY_QUOTIENT.toNat
    (inactivityPenaltyDivisor preset config) (effectiveAt z i) _
    (startInactivityScore config x + config.INACTIVITY_SCORE_BIAS.toNat * (t + 1))
    (stakeFloorAt config x high t)
    (stakeCeilingAt config x high t + slashedUnwithdrawnStake x) divisor quotient scored floorLe
  unfold passPenaltyRate epochPenalty
  dsimp only
  rw [← getTotalActiveBalance_toNat totalOk]
  rw [add_mul]
  linarith

end FloorPath

/-! ## One epoch of a new key -/

section Epoch

open DirectSafety.Apriori DirectSafety.Apriori.Internal

/-- One epoch with no pass, and the penalty of a slashing in it. -/
private theorem same_arith (b' b cap K band X sl Q Bq EB : ℕ)
    (hcap : K ≤ cap) (hQ : 2 ≤ Q) (hB : K + band ≤ Q * Bq)
    (seg : min b' cap ≤ b + X + sl) (hsl : Q * sl ≤ EB)
    (hyst : EB ≤ b' + band) (hcapEB : EB ≤ cap) :
    min b' K ≤ b + X + (if sl = 0 then 0 else Bq) := by
  by_cases z : sl = 0
  · subst z
    simp only [ite_true] at *
    have : min b' K ≤ min b' cap := min_le_min_left _ hcap
    omega
  · simp only [z, ite_false]
    obtain ⟨hEB, hcle⟩ := eb_le_min_band b' cap K band EB hcap hyst hcapEB
    set C := min b' cap with hC
    by_cases cK : C ≤ K
    · have slB : sl ≤ Bq := by
        have : Q * sl ≤ Q * Bq := by omega
        exact Nat.le_of_mul_le_mul_left this (by omega)
      omega
    · have above : K < C := Nat.lt_of_not_ge cK
      have : min b' K = K := by
        apply min_eq_right
        have := min_le_left b' cap
        omega
      rw [this]
      have : Q * sl ≤ Q * (Bq + (C - K)) := by
        have h1 : Q * (C - K) ≥ C - K := Nat.le_mul_of_pos_left _ (by omega)
        have : Q * (Bq + (C - K)) = Q * Bq + Q * (C - K) := by ring
        omega
      have := Nat.le_of_mul_le_mul_left this (by omega)
      omega

/-- The charge for the slashing of a key: the rounded-up initial penalty of the least stake. -/
private def newBq (preset : Preset) : ℕ :=
  (preset.MAX_EFFECTIVE_BALANCE.toNat + preset.downwardBand +
    (EthLib.Consensus.parameters preset .fusaka).MIN_SLASHING_PENALTY_QUOTIENT.toNat - 1) /
      (EthLib.Consensus.parameters preset .fusaka).MIN_SLASHING_PENALTY_QUOTIENT.toNat

/-- The standing hypotheses of the floor of a new key.

They are the guard and the facts that it reads.

They also hold the preset facts that the floor reads. -/
private structure Ctx (config : Config) (checks : SignatureChecks) {preset : Preset}
    (g x : ForkedBeaconState preset) (high : ℕ) where
  shared : Run config checks g x
  genesis : Genesis (config := config) (checks := checks) g
  parameters : DirectSafety.Parameters preset
  caps : CapOrder preset
  aligned : MaxEffectiveBalancesAligned preset
  twoSlots : 2 ≤ preset.SLOTS_PER_EPOCH.toNat
  electra : .pectra ≤ x.fork
  fulu : .fusaka ≤ x.fork
  guard : aprioriGuardAt config x high
  delay : 0 < config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat
  vector : 4 ≤ preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat
  big : 9 * (EthLib.Consensus.parameters preset .fusaka).MIN_SLASHING_PENALTY_QUOTIENT.toNat ≤
    stakeFloorAt config x high 0
  factor : 1 ≤ preset.BASE_REWARD_FACTOR.toNat
  quotientTwo :
    2 ≤ (EthLib.Consensus.parameters preset .fusaka).MIN_SLASHING_PENALTY_QUOTIENT.toNat
  margin : 2400 * (2 * preset.MAX_EFFECTIVE_BALANCE.toNat / 3 -
      preset.MAX_EFFECTIVE_BALANCE.toNat /
        (EthLib.Consensus.parameters preset .fusaka).MIN_SLASHING_PENALTY_QUOTIENT.toNat -
      preset.downwardBand - 1) + 2400 * preset.downwardBand + 2400 * newBq preset ≤
    1591 * (preset.MAX_EFFECTIVE_BALANCE.toNat + preset.downwardBand)
  room : 600 * (high + 2 - (getCurrentEpoch x.state).toNat) ≤ stakeFloorAt config x high 0
  bands : preset.IncrementWithinUpwardBand

/-- Along the window, the floor stays within three halves of its start.

The start floor is below the stake at the start, which the funded stake covers.

The funded stake is below the first ceiling, which is below the last.

The guard asks that twice the last ceiling be at most three times the last floor. -/
private theorem Ctx.ratio {g x : ForkedBeaconState preset} {high : ℕ}
    (c : Ctx config checks g x high) (early : x.fork < .glamsterdam) {s : ℕ}
    (inside : s ≤ high + 1 - (getCurrentEpoch x.state).toNat) :
    2 * stakeFloorAt config x high 0 ≤ 3 * stakeFloorAt config x high s := by
  have ratio := ratio_of_guard c.electra c.guard
  have first : stakeFloorAt config x high 0 ≤ stakeCeilingAt config x high 0 :=
    (floor_initial_le_reference x high).trans
      ((funding_active_le x early (c.shared.pubkeysDistinct c.genesis)).trans
        (funded_le_ceiling_initial c.electra))
  have anti : stakeFloorAt config x high (high + 1 - (getCurrentEpoch x.state).toNat) ≤
      stakeFloorAt config x high s := stakeFloorAt_anti inside
  have mono : stakeCeilingAt config x high 0 ≤
      stakeCeilingAt config x high (high + 1 - (getCurrentEpoch x.state).toNat) :=
    stakeCeilingAt_mono c.electra (Nat.zero_le _)
  omega

/-- The debits of key `i` in a list of events: its sync debits and its partial payments. -/
private def keyDebits (i : ℕ) (events : List (BalanceEvent preset)) : ℕ :=
  (events.map (syncDebit i)).sum + (events.map (floorPartialDebit i.toUInt64)).sum

/-- The debits of a key add up over two lists of events. -/
private theorem keyDebits_append (i : ℕ) (a b : List (BalanceEvent preset)) :
    keyDebits i (a ++ b) = keyDebits i a + keyDebits i b := by
  simp only [keyDebits, List.map_append, List.sum_append]
  omega

/-- The key is charged `newBq` once it is slashed. -/
private def slashedCharge (preset : Preset) (s : ForkedBeaconState preset) (i : ℕ) : ℕ :=
  if ∃ w, s.state.validators.data[i]? = some w ∧ w.slashed = true then newBq preset else 0

/-- The potential claim at an epoch start `m`, along a run `rm` from the start `z` of the climb.

The potential of the key keeps the fraction of the floor that the floor keeps since `z`.

The potential counts the debits of the key and its slashing charge along `rm`. -/
private def EpochClaim (x z : ForkedBeaconState preset) (high i : ℕ) {m : ForkedBeaconState preset}
    (rm : Run config checks z m) : Prop :=
  ∃ events, rm.balanceEvents high = .ok events ∧
    2 * (preset.MAX_EFFECTIVE_BALANCE.toNat + preset.downwardBand) *
        stakeFloorAt config x high
          ((getCurrentEpoch m.state).toNat - (getCurrentEpoch x.state).toNat) ≤
      2 * (min (actualBalanceAt m i) preset.MAX_EFFECTIVE_BALANCE.toNat + preset.downwardBand +
          keyDebits i events + slashedCharge preset m i) *
        stakeFloorAt config x high
          ((getCurrentEpoch z.state).toNat - (getCurrentEpoch x.state).toNat) +
      3 * (preset.MAX_EFFECTIVE_BALANCE.toNat + preset.downwardBand) *
        ((getCurrentEpoch m.state).toNat - (getCurrentEpoch z.state).toNat)

/-- The rounded-up quotient `Bq` covers its numerator. -/
private theorem ceil_div_cover (a Q : ℕ) (positive : 0 < Q) : a ≤ Q * ((a + Q - 1) / Q) := by
  have h1 := Nat.div_add_mod (a + Q - 1) Q
  have h2 := Nat.mod_lt (a + Q - 1) positive
  omega

/-- The facts on the cap and the slashing charge that each step of the floor of a key reads.

The slashing quotient is positive.

The cap lies above `MAX_EFFECTIVE_BALANCE` and above the key's effective balance.

The charge `newBq` covers `MAX_EFFECTIVE_BALANCE` and the band in units of the quotient. -/
private theorem Ctx.step_facts {g x m : ForkedBeaconState preset} {high : ℕ}
    (c : Ctx config checks g x high) (hm : Run config checks x m) (mEarly : m.fork < .glamsterdam)
    {i : ℕ} {val : Validator} (found : m.state.validators.data[i]? = some val) :
    0 < (EthLib.Consensus.parameters preset .fusaka).MIN_SLASHING_PENALTY_QUOTIENT.toNat ∧
      preset.MAX_EFFECTIVE_BALANCE.toNat ≤
        (withdrawalMaxEffectiveBalance preset m.fork val).toNat ∧
      effectiveAt m i ≤ (withdrawalMaxEffectiveBalance preset m.fork val).toNat ∧
      preset.MAX_EFFECTIVE_BALANCE.toNat + preset.downwardBand ≤
        (EthLib.Consensus.parameters preset .fusaka).MIN_SLASHING_PENALTY_QUOTIENT.toNat *
          ((preset.MAX_EFFECTIVE_BALANCE.toNat + preset.downwardBand +
            (EthLib.Consensus.parameters preset .fusaka).MIN_SLASHING_PENALTY_QUOTIENT.toNat - 1) /
            (EthLib.Consensus.parameters preset .fusaka).MIN_SLASHING_PENALTY_QUOTIENT.toNat) := by
  have positiveQ :
      0 < (EthLib.Consensus.parameters preset .fusaka).MIN_SLASHING_PENALTY_QUOTIENT.toNat := by
    have := c.quotientTwo
    omega
  refine ⟨positiveQ,
    UInt64.le_iff_toNat_le.mp (Internal.minimum_cap c.caps.activation c.caps.compounding val),
    ?_, ceil_div_cover _ _ positiveQ⟩
  have := Run.effectiveBalance_capped (c.shared.append hm) c.genesis c.caps.activation
    c.caps.compounding mEarly val (Array.mem_of_getElem? found)
  have e : effectiveAt m i = val.effectiveBalance.toNat := by simp [effectiveAt, found]
  rw [e]
  exact UInt64.le_iff_toNat_le.mp this

/-- A step is charged `Bq` for a slashing only when the key is slashed in it. -/
private theorem charge_le (P : Prop) [Decidable P] (a Q Bq : ℕ) :
    (if (if P then a / Q else 0) = 0 then 0 else Bq) ≤ (if P then Bq else 0) := by
  by_cases h : P <;> by_cases e : a / Q = 0 <;> simp [h, e]

/-- The floor of a new key over one epoch that a slot step ends.

The potential of a key is the least of its balance and `MAX_EFFECTIVE_BALANCE`, plus the band.

The potential at the start keeps the fraction of the floor, less the rounding error.

It is charged the key's sync debits, its partial payments, and its slashing, once. -/
private theorem Ctx.cross {g x m n z : ForkedBeaconState preset} {high : ℕ}
    (c : Ctx config checks g x high) (hm : Run config checks x m)
    (pre : Run config checks m z) (ok : advanceSlotAcross config checks z = .ok n)
    (early : n.fork < .glamsterdam)
    (within : (getCurrentEpoch n.state).toNat ≤ high + 1)
    (same : getCurrentEpoch z.state = getCurrentEpoch m.state)
    (step : (getCurrentEpoch n.state).toNat = (getCurrentEpoch m.state).toNat + 1)
    (i : ℕ) (val : Validator) (found : m.state.validators.data[i]? = some val)
    (activated : val.activationEpoch ≠ FAR_FUTURE_EPOCH)
    (exit : ∀ w, n.state.validators.data[i]? = some w →
      (getCurrentEpoch m.state).toNat + 1 < w.exitEpoch.toNat)
    (slashedCond : val.slashed = true → (getCurrentEpoch n.state).toNat +
      preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat / 2 < val.withdrawableEpoch.toNat)
    (hyst : effectiveAt m i ≤ actualBalanceAt m i + preset.downwardBand)
    {events : List (BalanceEvent preset)}
    (replayed : (pre.snoc (Step.slot ok)).balanceEvents (getCurrentEpoch m.state).toNat =
      .ok events) :
    (min (actualBalanceAt m i) preset.MAX_EFFECTIVE_BALANCE.toNat + preset.downwardBand) *
        stakeFloorAt config x high
          ((getCurrentEpoch m.state).toNat - (getCurrentEpoch x.state).toNat + 1) ≤
      (min (actualBalanceAt n i) preset.MAX_EFFECTIVE_BALANCE.toNat + preset.downwardBand) *
          stakeFloorAt config x high
            ((getCurrentEpoch m.state).toNat - (getCurrentEpoch x.state).toNat) +
        (preset.MAX_EFFECTIVE_BALANCE.toNat + preset.downwardBand) +
        ((events.map (syncDebit i)).sum + (events.map (floorPartialDebit i.toUInt64)).sum +
          (if val.slashed = false ∧ ∃ w, n.state.validators.data[i]? = some w ∧ w.slashed = true
            then (preset.MAX_EFFECTIVE_BALANCE.toNat + preset.downwardBand +
              (EthLib.Consensus.parameters preset .fusaka).MIN_SLASHING_PENALTY_QUOTIENT.toNat -
                1) /
              (EthLib.Consensus.parameters preset .fusaka).MIN_SLASHING_PENALTY_QUOTIENT.toNat
            else 0)) *
          stakeFloorAt config x high
            ((getCurrentEpoch m.state).toNat - (getCurrentEpoch x.state).toNat) := by
  classical
  have mz := fork_le_of_chainSteps pre.chainSteps
  have hxm := fork_le_of_chainSteps hm.chainSteps
  have zn : z.fork ≤ n.fork := (Step.slot ok).chainStep.fork_le
  have mEarly : m.fork < .glamsterdam := Nat.lt_of_le_of_lt (Nat.le_trans mz zn) early
  have fuluM : .fusaka ≤ m.fork := Nat.le_trans c.fulu hxm
  have shared' := c.shared.append hm
  have xm := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps hm.chainSteps)
  obtain ⟨positiveQ, capLe, capEB, hB⟩ := c.step_facts hm mEarly found
  obtain ⟨z', pre', post', hr, hz', ineq⟩ := epochFloor shared' c.genesis c.caps c.delay
    c.vector positiveQ (pre.snoc (Step.slot ok)) fuluM early
    (Or.inr ⟨z, pre, ok, rfl, same, step⟩) i val found activated exit slashedCond
    (withdrawalMaxEffectiveBalance preset m.fork val).toNat le_rfl replayed
  have zForkLe : z'.fork ≤ n.fork := fork_le_of_chainSteps post'.chainSteps
  have z'Early : z'.fork < .glamsterdam := Nat.lt_of_le_of_lt zForkLe early
  have z'x : Run config checks x z' := hm.append pre'
  have z'epoch : (getCurrentEpoch z'.state).toNat = (getCurrentEpoch m.state).toNat :=
    congrArg UInt64.toNat hz'
  have nz' := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps post'.chainSteps)
  have insideM : i < m.state.validators.data.size := (Array.getElem?_eq_some_iff.mp found).1
  have effEq : effectiveAt z' i = effectiveAt m i :=
    run_same_epoch_effective pre' z'Early hz' i insideM
  have altairX : .altair ≤ x.fork := Nat.le_trans (by decide) c.fulu
  have altairZ : .altair ≤ z'.fork :=
    Nat.le_trans altairX (Nat.le_trans hxm (fork_le_of_chainSteps pre'.chainSteps))
  have pass : (if getCurrentEpoch m.state < getCurrentEpoch n.state ∧
        ∃ total, getTotalActiveBalance z'.state = .ok total then
          passPenaltyRate config z' i else 0) *
      stakeFloorAt config x high
        ((getCurrentEpoch m.state).toNat - (getCurrentEpoch x.state).toNat) ≤
      effectiveAt m i * (stakeFloorAt config x high
        ((getCurrentEpoch m.state).toNat - (getCurrentEpoch x.state).toNat) -
          stakeFloorAt config x high
            ((getCurrentEpoch m.state).toNat - (getCurrentEpoch x.state).toNat + 1) + 1) := by
    by_cases h : ∃ total, getTotalActiveBalance z'.state = .ok total
    · obtain ⟨total, totalOk⟩ := h
      have lt : getCurrentEpoch m.state < getCurrentEpoch n.state :=
        UInt64.lt_iff_toNat_lt.mpr (by omega)
      rw [ite_eq_left ⟨lt, total, totalOk⟩]
      have bounds := total_within_guard c.shared c.genesis c.parameters c.caps c.aligned c.twoSlots
        c.electra c.guard z'x z'Early (by omega) totalOk
      have ixeq : ix x z' = (getCurrentEpoch m.state).toNat - (getCurrentEpoch x.state).toNat := by
        simp only [ix]
        omega
      rw [ixeq] at bounds
      have positive : 0 < stakeFloorAt config x high
          ((getCurrentEpoch m.state).toNat - (getCurrentEpoch x.state).toNat + 1) :=
        c.guard.2.2.2.2.2.2.2.2.2.2.2.1 _ (by unfold driftHorizon; omega)
      have divisor : 0 < inactivityPenaltyDivisor preset config := c.guard.2.2.2.2.2.2.1
      have scored : (if altair : .altair ≤ z'.fork then
          (((z'.state.inactivityScores altair).data[i]?).map (·.toNat)).getD 0 else 0) +
            config.INACTIVITY_SCORE_BIAS.toNat ≤ startInactivityScore config x +
          config.INACTIVITY_SCORE_BIAS.toNat * ((getCurrentEpoch m.state).toNat -
            (getCurrentEpoch x.state).toNat + 1) := by
        rw [dite_eq_left altairZ]
        have grow : config.INACTIVITY_SCORE_BIAS.toNat ≤ config.INACTIVITY_SCORE_BIAS.toNat *
            ((getCurrentEpoch m.state).toNat - (getCurrentEpoch x.state).toNat + 1) :=
          Nat.le_mul_of_pos_right _ (by omega)
        cases found' : (z'.state.inactivityScores altairZ).data[i]? with
        | none =>
          simp only [Option.map_none, Option.getD_none]
          omega
        | some score =>
          have := runScores_le z'x altairX z'Early (Or.inl c.electra) altairZ found'
          simp only [Option.map_some, Option.getD_some]
          have e : (getCurrentEpoch z'.state).toNat - (getCurrentEpoch x.state).toNat =
              (getCurrentEpoch m.state).toNat - (getCurrentEpoch x.state).toNat := by omega
          rw [e] at this
          rw [Nat.mul_add, Nat.mul_one]
          omega
      have := passRate_mul_le (config := config) (x := x) (z := z') high
        ((getCurrentEpoch m.state).toNat - (getCurrentEpoch x.state).toNat) i total totalOk
        bounds.1 (by omega) positive divisor c.factor scored
      rw [effEq] at this
      exact this
    · rw [ite_eq_right (fun h' => h h'.2)]
      simp
  rw [mspq_fusaka fuluM] at ineq
  set K := preset.MAX_EFFECTIVE_BALANCE.toNat with hK
  set Q := (EthLib.Consensus.parameters preset .fusaka).MIN_SLASHING_PENALTY_QUOTIENT.toNat
    with hQ
  set band := preset.downwardBand with hband
  set t := (getCurrentEpoch m.state).toNat - (getCurrentEpoch x.state).toNat with ht
  set Bq := (K + band + Q - 1) / Q with hBq
  have hanti : stakeFloorAt config x high (t + 1) ≤ stakeFloorAt config x high t :=
    stakeFloorAt_anti (Nat.le_succ t)
  have hzero : stakeFloorAt config x high t ≤ stakeFloorAt config x high 0 :=
    stakeFloorAt_anti (Nat.zero_le t)
  have nWithin := step
  have cxIn : (getCurrentEpoch x.state).toNat ≤ high + 1 := by omega
  have xEarly : x.fork < .glamsterdam :=
    Nat.lt_of_le_of_lt (Nat.le_trans hxm (Nat.le_trans mz zn)) early
  have ratio := c.ratio xEarly (s := t + 1) (by omega)
  have roomT := c.room
  have hφ : 6 * Q ≤ stakeFloorAt config x high (t + 1) := by
    have := c.big
    omega
  have hband' : 2 * stakeFloorAt config x high t ≤ 3 * stakeFloorAt config x high (t + 1) := by
    omega
  have bound := step_arith_slash (actualBalanceAt m i) (actualBalanceAt n i)
    (withdrawalMaxEffectiveBalance preset m.fork val).toNat K band
    (if getCurrentEpoch m.state < getCurrentEpoch n.state ∧
        ∃ total, getTotalActiveBalance z'.state = .ok total then passPenaltyRate config z' i else 0)
    ((events.map (syncDebit i)).sum + (events.map (floorPartialDebit i.toUInt64)).sum)
    (if val.slashed = false ∧ ∃ w, n.state.validators.data[i]? = some w ∧ w.slashed = true
      then effectiveAt m i / Q else 0)
    Q Bq (stakeFloorAt config x high t) (stakeFloorAt config x high (t + 1))
    (stakeFloorAt config x high t - stakeFloorAt config x high (t + 1)) (effectiveAt m i)
    capLe c.quotientTwo hB (by omega)
    (by split <;> [exact Nat.mul_div_le _ _; simp])
    hyst capEB pass (by omega) hφ hband'
  have charge := charge_le
    (val.slashed = false ∧ ∃ w, n.state.validators.data[i]? = some w ∧ w.slashed = true)
    (effectiveAt m i) Q Bq
  have mul := Nat.mul_le_mul_right (stakeFloorAt config x high t)
    (Nat.add_le_add_left charge ((events.map (syncDebit i)).sum +
      (events.map (floorPartialDebit i.toUInt64)).sum))
  linarith

/-- The floor of a new key over a run inside one epoch.

The least of its balance and `MAX_EFFECTIVE_BALANCE` at the start is at most its balance at the end.

It is charged the key's sync debits, its partial payments, and its slashing, once. -/
private theorem Ctx.inside {g x m n : ForkedBeaconState preset} {high : ℕ}
    (c : Ctx config checks g x high) (hm : Run config checks x m) (seg : Run config checks m n)
    (early : n.fork < .glamsterdam)
    (same : getCurrentEpoch n.state = getCurrentEpoch m.state)
    (i : ℕ) (val : Validator) (found : m.state.validators.data[i]? = some val)
    (activated : val.activationEpoch ≠ FAR_FUTURE_EPOCH)
    (exit : ∀ w, n.state.validators.data[i]? = some w →
      (getCurrentEpoch m.state).toNat + 1 < w.exitEpoch.toNat)
    (slashedCond : val.slashed = true → (getCurrentEpoch n.state).toNat +
      preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat / 2 < val.withdrawableEpoch.toNat)
    (hyst : effectiveAt m i ≤ actualBalanceAt m i + preset.downwardBand)
    {events : List (BalanceEvent preset)}
    (replayed : seg.balanceEvents (getCurrentEpoch m.state).toNat = .ok events) :
    min (actualBalanceAt m i) preset.MAX_EFFECTIVE_BALANCE.toNat ≤ actualBalanceAt n i +
      ((events.map (syncDebit i)).sum + (events.map (floorPartialDebit i.toUInt64)).sum +
        (if val.slashed = false ∧ ∃ w, n.state.validators.data[i]? = some w ∧ w.slashed = true
          then (preset.MAX_EFFECTIVE_BALANCE.toNat + preset.downwardBand +
            (EthLib.Consensus.parameters preset .fusaka).MIN_SLASHING_PENALTY_QUOTIENT.toNat -
              1) / (EthLib.Consensus.parameters preset .fusaka).MIN_SLASHING_PENALTY_QUOTIENT.toNat
          else 0)) := by
  classical
  have hxm := fork_le_of_chainSteps hm.chainSteps
  have mn := fork_le_of_chainSteps seg.chainSteps
  have mEarly : m.fork < .glamsterdam := Nat.lt_of_le_of_lt mn early
  have fuluM : .fusaka ≤ m.fork := Nat.le_trans c.fulu hxm
  have shared' := c.shared.append hm
  obtain ⟨positiveQ, capLe, capEB, hB⟩ := c.step_facts hm mEarly found
  obtain ⟨z', pre', post', hr, hz', ineq⟩ := epochFloor shared' c.genesis c.caps c.delay
    c.vector positiveQ seg fuluM early (Or.inl same) i val found activated exit slashedCond
    (withdrawalMaxEffectiveBalance preset m.fork val).toNat le_rfl replayed
  rw [mspq_fusaka fuluM] at ineq
  have noPass : ¬ (getCurrentEpoch m.state < getCurrentEpoch n.state ∧
      ∃ total, getTotalActiveBalance z'.state = .ok total) := by
    intro h
    rw [same] at h
    exact UInt64.lt_irrefl _ h.1
  rw [ite_eq_right noPass] at ineq
  set K := preset.MAX_EFFECTIVE_BALANCE.toNat with hK
  set Q := (EthLib.Consensus.parameters preset .fusaka).MIN_SLASHING_PENALTY_QUOTIENT.toNat
    with hQ
  set band := preset.downwardBand with hband
  set Bq := (K + band + Q - 1) / Q with hBq
  have bound := same_arith (actualBalanceAt m i) (actualBalanceAt n i)
    (withdrawalMaxEffectiveBalance preset m.fork val).toNat K band
    ((events.map (syncDebit i)).sum + (events.map (floorPartialDebit i.toUInt64)).sum)
    (if val.slashed = false ∧ ∃ w, n.state.validators.data[i]? = some w ∧ w.slashed = true
      then effectiveAt m i / Q else 0)
    Q Bq (effectiveAt m i) capLe c.quotientTwo hB (by omega)
    (by split <;> [exact Nat.mul_div_le _ _; simp]) hyst capEB
  have charge := charge_le
    (val.slashed = false ∧ ∃ w, n.state.validators.data[i]? = some w ∧ w.slashed = true)
    (effectiveAt m i) Q Bq
  omega

/-- Right after an epoch transition, the effective balance of a key is within the band.

The band lies above its balance. -/
private theorem Ctx.hyst_start {g x m : ForkedBeaconState preset} {high : ℕ}
    (c : Ctx config checks g x high) (hm : Run config checks x m)
    (hyst : Hysteresis m.state) {i : ℕ} {val : Validator}
    (found : m.state.validators.data[i]? = some val) :
    effectiveAt m i ≤ actualBalanceAt m i + preset.downwardBand := by
  have matched := (run_justified_separated (c.shared.append hm) c.genesis).1.balancesMatch
  have lt : i < m.state.validators.data.size := (Array.getElem?_eq_some_iff.mp found).1
  have lt' : i < m.state.balances.data.size := by
    unfold BalancesMatch at matched
    omega
  have bal : m.state.balances.data[i]? = some m.state.balances.data[i] :=
    Array.getElem?_eq_getElem lt'
  have := hyst.down i val _ found bal
  simp only [effectiveAt, actualBalanceAt, found, bal, Option.map_some, Option.getD_some]
  exact this

/-- The arithmetic of the last step of the floor of a new key.

The potential keeps `2/3` of its start, less the rounding, and the rounding is below the room.

The preset fact `margin` then leaves the floor of the pin. -/
private theorem final_arith (K band Bq B S C φ0 φk J J' T : ℕ)
    (h1 : 2 * (K + band) * φk ≤ 2 * (B + band + C) * φ0 + 3 * (K + band) * J)
    (h2 : 2 * φ0 ≤ 3 * φk) (hJ : J ≤ J') (room : 400 * J' ≤ φ0) (pos : 0 < φ0)
    (hC : C ≤ S + Bq)
    (margin : 2400 * T + 2400 * band + 2400 * Bq ≤ 1591 * (K + band)) : T ≤ B + S := by
  have a1 : 6 * (K + band) * φk ≤ 6 * (B + band + C) * φ0 + 9 * (K + band) * J := by nlinarith
  have a2 : 4 * (K + band) * φ0 ≤ 6 * (K + band) * φk := by nlinarith
  have a3 : 9 * (K + band) * J * 400 ≤ 9 * (K + band) * φ0 := by
    have : J * 400 ≤ φ0 := by omega
    nlinarith
  have a4 : 1600 * (K + band) * φ0 ≤ 2400 * (B + band + C) * φ0 + 9 * (K + band) * φ0 := by
    nlinarith
  have a5 : 1600 * (K + band) ≤ 2400 * (B + band + C) + 9 * (K + band) := by
    have := Nat.le_of_mul_le_mul_right (a := 1600 * (K + band))
      (b := 2400 * (B + band + C) + 9 * (K + band)) (c := φ0) (by nlinarith) pos
    exact this
  omega

/-- A key slashed on the climb is not due its delayed penalty within the window.

It was unslashed at the start `z` of the climb, so its withdrawal waits a whole slashings vector. -/
private theorem Ctx.slashed_window {g x z m : ForkedBeaconState preset} {high : ℕ}
    (c : Ctx config checks g x high) (hz : Run config checks x z) (rm : Run config checks z m)
    (mEarly : m.fork < .glamsterdam) (i : ℕ) (v0 val : Validator)
    (found0 : z.state.validators.data[i]? = some v0)
    (found : m.state.validators.data[i]? = some val)
    (unslashed0 : v0.slashed = false) (epoch : ℕ) (inside : epoch ≤ high + 1) :
    val.slashed = true →
      epoch + preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat / 2 < val.withdrawableEpoch.toNat := by
  intro flag
  have lower := rm.newly_slashed_withdrawableEpoch c.caps.activation c.caps.compounding
    mEarly c.delay i v0 val found0 found unslashed0 flag
  have window := c.guard.2.2.2.2.2.2.2.2.2.2.1
  have xz := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps hz.chainSteps)
  unfold driftHorizon at window
  omega

/-- The slashing charge of a run adds the charge of its slashing. -/
private theorem slashedCharge_run {m n : ForkedBeaconState preset} (seg : Run config checks m n)
    (i : ℕ) (val : Validator) (found : m.state.validators.data[i]? = some val) :
    slashedCharge preset n i = slashedCharge preset m i +
      (if val.slashed = false ∧ ∃ w, n.state.validators.data[i]? = some w ∧ w.slashed = true
        then newBq preset else 0) := by
  classical
  unfold slashedCharge
  by_cases flag : val.slashed = true
  · obtain ⟨w', wFound', wFlag⟩ := seg.slashedPersistence i val found flag
    have : ∃ w, n.state.validators.data[i]? = some w ∧ w.slashed = true := ⟨w', wFound', wFlag⟩
    have fm : ∃ w, m.state.validators.data[i]? = some w ∧ w.slashed = true := ⟨val, found, flag⟩
    simp [this, fm, flag]
  · have flag' : val.slashed = false := by simpa using flag
    have fm : ¬ ∃ w, m.state.validators.data[i]? = some w ∧ w.slashed = true := by
      rintro ⟨w', h, hf⟩
      rw [found] at h
      cases h
      exact flag hf
    simp [fm, flag']

/-- The potential claim passes the slot step that ends an epoch.

The step is the cross of one epoch, so the claim holds for the next epoch start, one epoch on. -/
private theorem Ctx.advance {g x z m p n : ForkedBeaconState preset} {high : ℕ}
    (c : Ctx config checks g x high) (hz : Run config checks x z) (rm : Run config checks z m)
    (ins : Run config checks m p) (ok : advanceSlotAcross config checks p = .ok n)
    (early : n.fork < .glamsterdam) (within : (getCurrentEpoch n.state).toNat ≤ high + 1)
    (same : getCurrentEpoch p.state = getCurrentEpoch m.state)
    (step : (getCurrentEpoch n.state).toNat = (getCurrentEpoch m.state).toNat + 1)
    (i : ℕ) (val : Validator) (found : m.state.validators.data[i]? = some val)
    (activated : val.activationEpoch ≠ FAR_FUTURE_EPOCH)
    (exit : ∀ w, n.state.validators.data[i]? = some w →
      (getCurrentEpoch m.state).toNat + 1 < w.exitEpoch.toNat)
    (slashedCond : val.slashed = true → (getCurrentEpoch n.state).toNat +
      preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat / 2 < val.withdrawableEpoch.toNat)
    (hyst : effectiveAt m i ≤ actualBalanceAt m i + preset.downwardBand)
    (claim : EpochClaim (config := config) (checks := checks) x z high i rm) :
    EpochClaim (config := config) (checks := checks) x z high i
      (rm.append (ins.snoc (Step.slot ok))) := by
  classical
  obtain ⟨events, replay, ih⟩ := claim
  have mp := fork_le_of_chainSteps ins.chainSteps
  have pn : p.fork ≤ n.fork := (Step.slot ok).chainStep.fork_le
  have hm : Run config checks x m := hz.append rm
  have mEarly : m.fork < .glamsterdam := Nat.lt_of_le_of_lt (Nat.le_trans mp pn) early
  have xm := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps hm.chainSteps)
  have zm := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps rm.chainSteps)
  have xz := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps hz.chainSteps)
  -- the events of the segment
  obtain ⟨eseg, hseg⟩ := (ins.snoc (Step.slot ok)).balanceEvents_ok early high
  have local_ : (ins.snoc (Step.slot ok)).balanceEvents (getCurrentEpoch m.state).toNat =
      .ok eseg := by
    rw [← balanceEvents_eq_of_endpoint_le (ins.snoc (Step.slot ok)) within (by omega)]
    exact hseg
  have whole := balanceEvents_append rm (ins.snoc (Step.slot ok)) high replay hseg
  have crossed := Ctx.cross c hm ins ok early within same step i val found activated exit
    slashedCond hyst local_
  have charge := slashedCharge_run (ins.snoc (Step.slot ok)) i val found
  have xEarly : x.fork < .glamsterdam :=
    Nat.lt_of_le_of_lt (Nat.le_trans (fork_le_of_chainSteps hm.chainSteps) (Nat.le_trans mp pn))
      early
  have cxIn : (getCurrentEpoch x.state).toNat ≤ high + 1 := by omega
  have pos : 0 < stakeFloorAt config x high
      ((getCurrentEpoch m.state).toNat - (getCurrentEpoch x.state).toNat) :=
    c.guard.2.2.2.2.2.2.2.2.2.2.2.1 _ (by unfold driftHorizon; omega)
  have hanti : stakeFloorAt config x high
      ((getCurrentEpoch m.state).toNat - (getCurrentEpoch x.state).toNat + 1) ≤
        stakeFloorAt config x high
          ((getCurrentEpoch m.state).toNat - (getCurrentEpoch x.state).toNat) :=
    stakeFloorAt_anti (Nat.le_succ _)
  have hzero : stakeFloorAt config x high
      ((getCurrentEpoch z.state).toNat - (getCurrentEpoch x.state).toNat) ≤
        stakeFloorAt config x high 0 := stakeFloorAt_anti (Nat.zero_le _)
  have ratio := c.ratio xEarly (s := (getCurrentEpoch m.state).toNat -
    (getCurrentEpoch x.state).toNat) (by omega)
  have band : 2 * stakeFloorAt config x high
      ((getCurrentEpoch z.state).toNat - (getCurrentEpoch x.state).toNat) ≤
      3 * stakeFloorAt config x high
        ((getCurrentEpoch m.state).toNat - (getCurrentEpoch x.state).toNat) := by omega
  have e1 : (getCurrentEpoch n.state).toNat - (getCurrentEpoch x.state).toNat =
      (getCurrentEpoch m.state).toNat - (getCurrentEpoch x.state).toNat + 1 := by omega
  refine ⟨events ++ eseg, whole, ?_⟩
  rw [e1, charge, keyDebits_append]
  have crossed' : (min (actualBalanceAt m i) preset.MAX_EFFECTIVE_BALANCE.toNat +
        preset.downwardBand) *
      stakeFloorAt config x high
        ((getCurrentEpoch m.state).toNat - (getCurrentEpoch x.state).toNat + 1) ≤
      (min (actualBalanceAt n i) preset.MAX_EFFECTIVE_BALANCE.toNat + preset.downwardBand) *
          stakeFloorAt config x high
            ((getCurrentEpoch m.state).toNat - (getCurrentEpoch x.state).toNat) +
        (preset.MAX_EFFECTIVE_BALANCE.toNat + preset.downwardBand) +
        (keyDebits i eseg + (if val.slashed = false ∧ ∃ w, n.state.validators.data[i]? = some w ∧
            w.slashed = true then newBq preset else 0)) *
          stakeFloorAt config x high
            ((getCurrentEpoch m.state).toNat - (getCurrentEpoch x.state).toNat) := crossed
  have mono : (keyDebits i events + slashedCharge preset m i) *
      stakeFloorAt config x high
        ((getCurrentEpoch m.state).toNat - (getCurrentEpoch x.state).toNat + 1) ≤
      (keyDebits i events + slashedCharge preset m i) *
        stakeFloorAt config x high
          ((getCurrentEpoch m.state).toNat - (getCurrentEpoch x.state).toNat) :=
    Nat.mul_le_mul_left _ hanti
  have stepIneq := chain_step (stakeFloorAt config x high
      ((getCurrentEpoch z.state).toNat - (getCurrentEpoch x.state).toNat))
    (stakeFloorAt config x high
      ((getCurrentEpoch m.state).toNat - (getCurrentEpoch x.state).toNat))
    (stakeFloorAt config x high
      ((getCurrentEpoch m.state).toNat - (getCurrentEpoch x.state).toNat + 1))
    (preset.MAX_EFFECTIVE_BALANCE.toNat + preset.downwardBand)
    (min (actualBalanceAt m i) preset.MAX_EFFECTIVE_BALANCE.toNat + preset.downwardBand +
      keyDebits i events + slashedCharge preset m i)
    (min (actualBalanceAt n i) preset.MAX_EFFECTIVE_BALANCE.toNat + preset.downwardBand +
      (keyDebits i events + keyDebits i eseg) +
      (slashedCharge preset m i + (if val.slashed = false ∧ ∃ w, n.state.validators.data[i]? =
        some w ∧ w.slashed = true then newBq preset else 0)))
    (preset.MAX_EFFECTIVE_BALANCE.toNat + preset.downwardBand)
    ((getCurrentEpoch m.state).toNat - (getCurrentEpoch z.state).toNat) pos hanti band ih
    (by nlinarith [crossed', mono])
  have e2 : (getCurrentEpoch n.state).toNat - (getCurrentEpoch z.state).toNat =
      (getCurrentEpoch m.state).toNat - (getCurrentEpoch z.state).toNat + 1 := by omega
  rw [e2]
  exact stepIneq

/-- The potential claim carries over the slot step that ends the epoch of a climb state.

The new epoch start also lies within the band of hysteresis, since the step ran the transition. -/
private theorem Ctx.inv_step {g x z y q p' m : ForkedBeaconState preset} {high : ℕ}
    (c : Ctx config checks g x high) (hz : Run config checks x z)
    (early : y.fork < .glamsterdam) (within : (getCurrentEpoch y.state).toNat ≤ high + 1)
    (i : ℕ) (v0 : Validator) (found0 : z.state.validators.data[i]? = some v0)
    (unslashed0 : v0.slashed = false) (activated0 : v0.activationEpoch ≠ FAR_FUTURE_EPOCH)
    (exitLate : ∀ (n : ForkedBeaconState preset) (_rest : Run config checks n y) (w : Validator),
      n.state.validators.data[i]? = some w → (getCurrentEpoch y.state).toNat < w.exitEpoch.toNat)
    (ok : advanceSlotAcross config checks q = .ok p') (rest : Run config checks p' y)
    (rm : Run config checks z m) (ins : Run config checks m q)
    (cm : getCurrentEpoch m.state = getCurrentEpoch q.state)
    (hyst : effectiveAt m i ≤ actualBalanceAt m i + preset.downwardBand)
    (claim : EpochClaim (config := config) (checks := checks) x z high i rm)
    (stepQ : (getCurrentEpoch p'.state).toNat = (getCurrentEpoch q.state).toNat + 1) :
    EpochClaim (config := config) (checks := checks) x z high i
      (rm.append (ins.snoc (Step.slot ok))) ∧
    effectiveAt p' i ≤ actualBalanceAt p' i + preset.downwardBand := by
  have restEpoch := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps rest.chainSteps)
  have pEarly : p'.fork < .glamsterdam :=
    Nat.lt_of_le_of_lt (fork_le_of_chainSteps rest.chainSteps) early
  have cmN : (getCurrentEpoch m.state).toNat = (getCurrentEpoch q.state).toNat :=
    congrArg UInt64.toNat cm
  obtain ⟨val, found, life⟩ := rm.registryLifecycle.validators i v0 found0
  have activated : val.activationEpoch ≠ FAR_FUTURE_EPOCH := by
    rw [life.activationEpoch activated0]
    exact activated0
  have mEarly : m.fork < .glamsterdam :=
    Nat.lt_of_le_of_lt (Nat.le_trans (fork_le_of_chainSteps ins.chainSteps)
      (Step.slot ok).chainStep.fork_le) pEarly
  have slashedCond := c.slashed_window hz rm mEarly i v0 val found0 found unslashed0
    (getCurrentEpoch p'.state).toNat (by omega)
  have sameQ : getCurrentEpoch q.state = getCurrentEpoch m.state := cm.symm
  have stepP : (getCurrentEpoch p'.state).toNat = (getCurrentEpoch m.state).toNat + 1 := by
    omega
  have exit' : ∀ w, p'.state.validators.data[i]? = some w →
      (getCurrentEpoch m.state).toNat + 1 < w.exitEpoch.toNat := fun w hw => by
    have := exitLate p' rest w hw
    omega
  have claim' := Ctx.advance c hz rm ins ok pEarly (by omega) sameQ stepP i val found
    activated exit' slashedCond hyst claim
  obtain ⟨val', found', -⟩ := (rm.append (ins.snoc (Step.slot ok))).registryLifecycle.validators
    i v0 found0
  have lt : getCurrentEpoch q.state < getCurrentEpoch p'.state :=
    UInt64.lt_iff_toNat_lt.mpr (by omega)
  have fuluQ : .fusaka ≤ q.fork :=
    Nat.le_trans c.fulu (fork_le_of_chainSteps (hz.append (rm.append ins)).chainSteps)
  exact ⟨claim', Ctx.hyst_start c (hz.append (rm.append (ins.snoc (Step.slot ok))))
    (DirectSafety.Apriori.Internal.hysteresis_of_crossing_slot ok c.bands fuluQ pEarly
      (UInt64.lt_iff_toNat_lt.mp lt)) found'⟩

/-- The potential claim holds at the start of the epoch of every state of the climb.

The climb runs from `z`, where the key holds the maximum effective balance and is unslashed.

The key never exits before the end `y` of the climb.

The state `p` reaches `y`, so it ends no later than `y`. -/
private theorem Ctx.inv {g x z y : ForkedBeaconState preset} {high : ℕ}
    (c : Ctx config checks g x high) (hz : Run config checks x z)
    (early : y.fork < .glamsterdam) (within : (getCurrentEpoch y.state).toNat ≤ high + 1)
    (i : ℕ) (v0 : Validator) (found0 : z.state.validators.data[i]? = some v0)
    (unslashed0 : v0.slashed = false) (activated0 : v0.activationEpoch ≠ FAR_FUTURE_EPOCH)
    (bal0 : preset.MAX_EFFECTIVE_BALANCE.toNat ≤ actualBalanceAt z i)
    (hystZ : effectiveAt z i ≤ actualBalanceAt z i + preset.downwardBand)
    (exitLate : ∀ (n : ForkedBeaconState preset) (_rest : Run config checks n y) (w : Validator),
      n.state.validators.data[i]? = some w → (getCurrentEpoch y.state).toNat < w.exitEpoch.toNat)
    {p : ForkedBeaconState preset} (rp : Run config checks z p) :
    ∀ (_rest : Run config checks p y), ∃ (m : ForkedBeaconState preset)
      (rm : Run config checks z m) (ins : Run config checks m p),
      rp = rm.append ins ∧ getCurrentEpoch m.state = getCurrentEpoch p.state ∧
      effectiveAt m i ≤ actualBalanceAt m i + preset.downwardBand ∧
      EpochClaim (config := config) (checks := checks) x z high i rm := by
  induction rp with
  | nil =>
    intro _
    refine ⟨z, .nil, .nil, rfl, rfl, hystZ, [], rfl, ?_⟩
    have unflagged : ¬ ∃ w, z.state.validators.data[i]? = some w ∧ w.slashed = true := by
      rintro ⟨w, h, hf⟩
      rw [found0] at h
      cases h
      rw [unslashed0] at hf
      cases hf
    have charge : slashedCharge preset z i = 0 := by simp [slashedCharge, unflagged]
    rw [charge, min_eq_right bal0]
    simp [keyDebits]
  | @snoc q p' pre step ih =>
    intro rest
    obtain ⟨m, rm, ins, eq, cm, hyst, claim⟩ := ih ((Run.nil.snoc step).append rest)
    by_cases same : getCurrentEpoch p'.state = getCurrentEpoch q.state
    · refine ⟨m, rm, ins.snoc step, ?_, cm.trans same.symm, hyst, claim⟩
      rw [eq]
      rfl
    · have bound := ChainStep.epoch_le_succ step.chainStep
      have order := UInt64.le_iff_toNat_le.mp step.chainStep.currentEpoch_le
      have differ : (getCurrentEpoch p'.state).toNat ≠ (getCurrentEpoch q.state).toNat :=
        fun h => same (UInt64.toNat_inj.mp h)
      cases step with
      | @block fork before after engine signed due ok =>
        exfalso
        apply same
        simp only [getCurrentEpoch, processBlock_slot (applySignedBlock_ok ok).2.1]
      | slot ok =>
        obtain ⟨claim', hystP⟩ := Ctx.inv_step c hz early within i v0 found0 unslashed0 activated0
          exitLate ok rest rm ins cm hyst claim (by omega)
        refine ⟨p', rm.append (ins.snoc (Step.slot ok)), .nil, ?_, rfl, hystP, claim'⟩
        rw [eq]
        rfl

/-- The arithmetic of the climb: the potential claim gives the floor of the pin.

The claim starts at the epoch `cz` and ends at the epoch `ck`, within the window. -/
private theorem Ctx.arith {g x : ForkedBeaconState preset} {high : ℕ}
    (c : Ctx config checks g x high) (xEarly : x.fork < .glamsterdam) (cz ck : ℕ)
    (xz : (getCurrentEpoch x.state).toNat ≤ cz) (zk : cz ≤ ck) (inside : ck ≤ high + 1)
    (B kd sc : ℕ) (hsc : sc ≤ newBq preset)
    (claim : 2 * (preset.MAX_EFFECTIVE_BALANCE.toNat + preset.downwardBand) *
        stakeFloorAt config x high (ck - (getCurrentEpoch x.state).toNat) ≤
      2 * (B + preset.downwardBand + (kd + sc)) *
        stakeFloorAt config x high (cz - (getCurrentEpoch x.state).toNat) +
      3 * (preset.MAX_EFFECTIVE_BALANCE.toNat + preset.downwardBand) * (ck - cz)) :
    2 * preset.MAX_EFFECTIVE_BALANCE.toNat / 3 -
        preset.MAX_EFFECTIVE_BALANCE.toNat /
          (EthLib.Consensus.parameters preset .fusaka).MIN_SLASHING_PENALTY_QUOTIENT.toNat -
        preset.downwardBand - 1 ≤ B + kd := by
  have cxIn : (getCurrentEpoch x.state).toNat ≤ high + 1 := by omega
  have ratio0 := c.ratio xEarly (s := cz - (getCurrentEpoch x.state).toNat) (by omega)
  have ratioK := c.ratio xEarly (s := ck - (getCurrentEpoch x.state).toNat) (by omega)
  have hzero : stakeFloorAt config x high (cz - (getCurrentEpoch x.state).toNat) ≤
      stakeFloorAt config x high 0 := stakeFloorAt_anti (Nat.zero_le _)
  have roomT := c.room
  have unitJ : 1 ≤ high + 2 - (getCurrentEpoch x.state).toNat := by omega
  have phi : 2 * stakeFloorAt config x high (cz - (getCurrentEpoch x.state).toNat) ≤
      3 * stakeFloorAt config x high (ck - (getCurrentEpoch x.state).toNat) := by omega
  exact final_arith preset.MAX_EFFECTIVE_BALANCE.toNat preset.downwardBand (newBq preset) B kd
    (kd + sc) (stakeFloorAt config x high (cz - (getCurrentEpoch x.state).toNat))
    (stakeFloorAt config x high (ck - (getCurrentEpoch x.state).toNat)) (ck - cz)
    (high + 2 - (getCurrentEpoch x.state).toNat) _ claim phi (by omega) (by omega) (by omega)
    (by omega) c.margin

/-- The least of a key's balance and the maximum, plus the debits, stays above the floor of the pin.

The state `p` lies on the climb, before its end `y`, so the key cannot yet have exited.

The least stake of the key is `2/3` of the maximum less the slashing quotient and the band. -/
private theorem Ctx.claimAt {g x z y p : ForkedBeaconState preset} {high : ℕ}
    (c : Ctx config checks g x high) (hz : Run config checks x z)
    (early : y.fork < .glamsterdam) (within : (getCurrentEpoch y.state).toNat ≤ high + 1)
    (i : ℕ) (v0 : Validator) (found0 : z.state.validators.data[i]? = some v0)
    (unslashed0 : v0.slashed = false) (activated0 : v0.activationEpoch ≠ FAR_FUTURE_EPOCH)
    (bal0 : preset.MAX_EFFECTIVE_BALANCE.toNat ≤ actualBalanceAt z i)
    (hystZ : effectiveAt z i ≤ actualBalanceAt z i + preset.downwardBand)
    (exitLate : ∀ (n : ForkedBeaconState preset) (_rest : Run config checks n y) (w : Validator),
      n.state.validators.data[i]? = some w → (getCurrentEpoch y.state).toNat < w.exitEpoch.toNat)
    (rp : Run config checks z p) (rest : Run config checks p y)
    (lt : (getCurrentEpoch p.state).toNat < (getCurrentEpoch y.state).toNat) :
    ∃ events, rp.balanceEvents high = .ok events ∧
      2 * preset.MAX_EFFECTIVE_BALANCE.toNat / 3 -
        preset.MAX_EFFECTIVE_BALANCE.toNat /
          (EthLib.Consensus.parameters preset .fusaka).MIN_SLASHING_PENALTY_QUOTIENT.toNat -
        preset.downwardBand - 1 ≤ actualBalanceAt p i + keyDebits i events := by
  classical
  obtain ⟨m, rm, ins, eq, cm, hyst, events, replay, ih⟩ :=
    c.inv hz early within i v0 found0 unslashed0 activated0 bal0 hystZ exitLate rp rest
  have pEarly : p.fork < .glamsterdam :=
    Nat.lt_of_le_of_lt (fork_le_of_chainSteps rest.chainSteps) early
  have mEarly : m.fork < .glamsterdam :=
    Nat.lt_of_le_of_lt (fork_le_of_chainSteps ins.chainSteps) pEarly
  have hm : Run config checks x m := hz.append rm
  obtain ⟨val, found, life⟩ := rm.registryLifecycle.validators i v0 found0
  have activated : val.activationEpoch ≠ FAR_FUTURE_EPOCH := by
    rw [life.activationEpoch activated0]
    exact activated0
  have cmN : (getCurrentEpoch m.state).toNat = (getCurrentEpoch p.state).toNat :=
    congrArg UInt64.toNat cm
  have restEpoch := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps rest.chainSteps)
  obtain ⟨eins, hins⟩ := ins.balanceEvents_ok pEarly high
  have local_ : ins.balanceEvents (getCurrentEpoch m.state).toNat = .ok eins := by
    rw [← balanceEvents_eq_of_endpoint_le (high := high)
      (localHigh := (getCurrentEpoch m.state).toNat) ins (by omega) (by omega)]
    exact hins
  have exit' : ∀ w, p.state.validators.data[i]? = some w →
      (getCurrentEpoch m.state).toNat + 1 < w.exitEpoch.toNat := fun w hw => by
    have := exitLate p rest w hw
    omega
  have slashedCond := c.slashed_window hz rm mEarly i v0 val found0 found unslashed0
    (getCurrentEpoch p.state).toNat (by omega)
  have inside := Ctx.inside c hm ins pEarly cm.symm i val found activated exit' slashedCond hyst
    local_
  have charge := slashedCharge_run ins i val found
  have whole := balanceEvents_append rm ins high replay hins
  refine ⟨events ++ eins, by rw [eq]; exact whole, ?_⟩
  -- the arithmetic of the climb
  have xz := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps hz.chainSteps)
  have zm := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps rm.chainSteps)
  have xEarly : x.fork < .glamsterdam :=
    Nat.lt_of_le_of_lt (Nat.le_trans (fork_le_of_chainSteps hz.chainSteps)
      (Nat.le_trans (fork_le_of_chainSteps rm.chainSteps) (fork_le_of_chainSteps ins.chainSteps)))
      pEarly
  have e2 : min (actualBalanceAt m i) preset.MAX_EFFECTIVE_BALANCE.toNat ≤ actualBalanceAt p i +
      (keyDebits i eins + (if val.slashed = false ∧ ∃ w, p.state.validators.data[i]? = some w ∧
        w.slashed = true then newBq preset else 0)) := by
    have := inside
    unfold keyDebits
    unfold newBq
    simpa using this
  have step : min (actualBalanceAt m i) preset.MAX_EFFECTIVE_BALANCE.toNat +
      preset.downwardBand + keyDebits i events + slashedCharge preset m i ≤
      actualBalanceAt p i + preset.downwardBand + keyDebits i (events ++ eins) +
        slashedCharge preset p i := by
    rw [keyDebits_append, charge]
    omega
  have chargeLe : slashedCharge preset p i ≤ newBq preset := by
    unfold slashedCharge
    split <;> omega
  have h1 : 2 * (preset.MAX_EFFECTIVE_BALANCE.toNat + preset.downwardBand) *
      stakeFloorAt config x high
        ((getCurrentEpoch p.state).toNat - (getCurrentEpoch x.state).toNat) ≤
      2 * (actualBalanceAt p i + preset.downwardBand +
        (keyDebits i (events ++ eins) + slashedCharge preset p i)) *
        stakeFloorAt config x high
          ((getCurrentEpoch z.state).toNat - (getCurrentEpoch x.state).toNat) +
      3 * (preset.MAX_EFFECTIVE_BALANCE.toNat + preset.downwardBand) *
        ((getCurrentEpoch p.state).toNat - (getCurrentEpoch z.state).toNat) := by
    rw [← cmN]
    refine ih.trans ?_
    have := Nat.mul_le_mul_right (stakeFloorAt config x high
      ((getCurrentEpoch z.state).toNat - (getCurrentEpoch x.state).toNat))
      (Nat.mul_le_mul_left 2 step)
    have e : actualBalanceAt p i + preset.downwardBand + keyDebits i (events ++ eins) +
        slashedCharge preset p i = actualBalanceAt p i + preset.downwardBand +
          (keyDebits i (events ++ eins) + slashedCharge preset p i) := by omega
    rw [e] at this
    omega
  exact c.arith xEarly (getCurrentEpoch z.state).toNat (getCurrentEpoch p.state).toNat xz
    (by omega) (by omega) _ _ _ chargeLe h1

/-- A state on the balance path of a run is a state of the run, or the state inside a slot step.

The state inside a slot step comes after the slot and its epoch transition, before the upgrades. -/
private theorem Run.mem_balancePath_split {z w : ForkedBeaconState preset}
    (r : Run config checks z w) {p : ForkedBeaconState preset} (member : p ∈ r.balancePath) :
    (∃ (rp : Run config checks z p) (rest : Run config checks p w), r = rp.append rest) ∨
    (∃ (q n : ForkedBeaconState preset) (rq : Run config checks z q)
      (ok : advanceSlotAcross config checks q = .ok n) (rest : Run config checks n w)
      (adv : BeaconState preset q.fork), r = (rq.snoc (Step.slot ok)).append rest ∧
        advanceSlot config checks q.state = .ok adv ∧ p = ⟨q.fork, adv⟩ ∧
        processUpgrades config checks ⟨q.fork, adv⟩ = .ok n) := by
  induction r with
  | nil =>
    simp only [Run.balancePath, List.mem_singleton] at member
    subst member
    exact .inl ⟨.nil, .nil, rfl⟩
  | @snoc q last pre step ih =>
    simp only [Run.balancePath, List.mem_append] at member
    rcases member with member | member
    · rcases ih member with ⟨rp, rest, eq⟩ | ⟨q', n, rq, ok, rest, adv, eq, adv_ok, hp, up⟩
      · exact .inl ⟨rp, rest.snoc step, by rw [eq]; rfl⟩
      · exact .inr ⟨q', n, rq, ok, rest.snoc step, adv, by rw [eq]; rfl, adv_ok, hp, up⟩
    · cases step with
      | block engine signed due ok =>
        simp only [Step.balancePath, List.mem_cons, List.not_mem_nil, or_false] at member
        rcases member with rfl | rfl
        · exact .inl ⟨pre, (Run.nil.snoc (.block engine signed due ok)), rfl⟩
        · exact .inl ⟨pre.snoc (.block engine signed due ok), .nil, rfl⟩
      | slot ok =>
        obtain ⟨adv, advOk, upgrades⟩ := bind_ok_iff.mp ok
        simp only [Step.balancePath, advOk, Except.toOption, List.mem_cons, List.not_mem_nil,
          or_false] at member
        rcases member with rfl | rfl | rfl
        · exact .inl ⟨pre, (Run.nil.snoc (.slot ok)), rfl⟩
        · exact .inr ⟨_, last, pre, ok, .nil, adv, rfl, advOk, rfl, upgrades⟩
        · exact .inl ⟨pre.snoc (.slot ok), .nil, rfl⟩

/-- A prefix of a list of events debits a key at most as much as the list. -/
private theorem keyDebits_le_of_prefix (i : ℕ) {a b : List (BalanceEvent preset)} (h : a <+: b) :
    keyDebits i a ≤ keyDebits i b := by
  obtain ⟨t, rfl⟩ := h
  rw [keyDebits_append]
  omega

/-- A state of the climb that precedes its end has the floor of the pin.

The debits are those of the run that contains it. -/
private theorem Ctx.floorRun {g x z y p w : ForkedBeaconState preset} {high : ℕ}
    (c : Ctx config checks g x high) (hz : Run config checks x z)
    (early : y.fork < .glamsterdam) (within : (getCurrentEpoch y.state).toNat ≤ high + 1)
    (i : ℕ) (v0 : Validator) (found0 : z.state.validators.data[i]? = some v0)
    (unslashed0 : v0.slashed = false) (activated0 : v0.activationEpoch ≠ FAR_FUTURE_EPOCH)
    (bal0 : preset.MAX_EFFECTIVE_BALANCE.toNat ≤ actualBalanceAt z i)
    (hystZ : effectiveAt z i ≤ actualBalanceAt z i + preset.downwardBand)
    (exitLate : ∀ (n : ForkedBeaconState preset) (_rest : Run config checks n y) (w : Validator),
      n.state.validators.data[i]? = some w → (getCurrentEpoch y.state).toNat < w.exitEpoch.toNat)
    (rp : Run config checks z p) (rest : Run config checks p w) (restY : Run config checks p y)
    (lt : (getCurrentEpoch p.state).toNat < (getCurrentEpoch y.state).toNat)
    {Ef : List (BalanceEvent preset)} (hEf : (rp.append rest).balanceEvents high = .ok Ef) :
    2 * preset.MAX_EFFECTIVE_BALANCE.toNat / 3 -
        preset.MAX_EFFECTIVE_BALANCE.toNat /
          (EthLib.Consensus.parameters preset .fusaka).MIN_SLASHING_PENALTY_QUOTIENT.toNat -
        preset.downwardBand - 1 ≤ actualBalanceAt p i + keyDebits i Ef := by
  obtain ⟨events, replay, bound⟩ := c.claimAt hz early within i v0 found0 unslashed0 activated0
    bal0 hystZ exitLate rp restY lt
  obtain ⟨before, beforeOk, prefix_⟩ := Run.balanceEvents_prefix rp rest high Ef hEf
  rw [replay] at beforeOk
  cases beforeOk
  have := keyDebits_le_of_prefix i prefix_
  omega

/-- The end of the climb, the first state of the last epoch, has the floor of the pin too. -/
private theorem Ctx.claimEnd {g x z y zz n : ForkedBeaconState preset} {high : ℕ}
    (c : Ctx config checks g x high) (hz : Run config checks x z)
    (early : y.fork < .glamsterdam) (within : (getCurrentEpoch y.state).toNat ≤ high + 1)
    (i : ℕ) (v0 : Validator) (found0 : z.state.validators.data[i]? = some v0)
    (unslashed0 : v0.slashed = false) (activated0 : v0.activationEpoch ≠ FAR_FUTURE_EPOCH)
    (bal0 : preset.MAX_EFFECTIVE_BALANCE.toNat ≤ actualBalanceAt z i)
    (hystZ : effectiveAt z i ≤ actualBalanceAt z i + preset.downwardBand)
    (exitLate : ∀ (n : ForkedBeaconState preset) (_rest : Run config checks n y) (w : Validator),
      n.state.validators.data[i]? = some w → (getCurrentEpoch y.state).toNat < w.exitEpoch.toNat)
    (pre0 : Run config checks z zz) (ok : advanceSlotAcross config checks zz = .ok n)
    (rest0 : Run config checks n y)
    (stepN : (getCurrentEpoch n.state).toNat = (getCurrentEpoch zz.state).toNat + 1)
    {Ef : List (BalanceEvent preset)}
    (hEf : (pre0.snoc (Step.slot ok)).balanceEvents high = .ok Ef) :
    2 * preset.MAX_EFFECTIVE_BALANCE.toNat / 3 -
        preset.MAX_EFFECTIVE_BALANCE.toNat /
          (EthLib.Consensus.parameters preset .fusaka).MIN_SLASHING_PENALTY_QUOTIENT.toNat -
        preset.downwardBand - 1 ≤ actualBalanceAt n i + keyDebits i Ef := by
  obtain ⟨m, rm, ins, eq, cm, hyst, claim⟩ := c.inv hz early within i v0 found0 unslashed0
    activated0 bal0 hystZ exitLate pre0 ((Run.nil.snoc (Step.slot ok)).append rest0)
  obtain ⟨claim', -⟩ := Ctx.inv_step c hz early within i v0 found0 unslashed0 activated0
    exitLate ok rest0 rm ins cm hyst claim stepN
  obtain ⟨events, replay, ineq⟩ := claim'
  have same : pre0.snoc (Step.slot ok) = rm.append (ins.snoc (Step.slot ok)) := by
    rw [eq]
    rfl
  rw [same, replay] at hEf
  cases hEf
  have nEarly : n.fork < .glamsterdam :=
    Nat.lt_of_le_of_lt (fork_le_of_chainSteps rest0.chainSteps) early
  have xz := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps hz.chainSteps)
  have zk := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps
    (pre0.snoc (Step.slot ok)).chainSteps)
  have xEarly : x.fork < .glamsterdam :=
    Nat.lt_of_le_of_lt (Nat.le_trans (fork_le_of_chainSteps hz.chainSteps)
      (fork_le_of_chainSteps (pre0.snoc (Step.slot ok)).chainSteps)) nEarly
  have restEpoch := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps rest0.chainSteps)
  have chargeLe : slashedCharge preset n i ≤ newBq preset := by
    unfold slashedCharge
    split <;> omega
  have := c.arith xEarly (getCurrentEpoch z.state).toNat (getCurrentEpoch n.state).toNat xz zk
    (by omega) (min (actualBalanceAt n i) preset.MAX_EFFECTIVE_BALANCE.toNat) (keyDebits i Ef) _
    chargeLe
    (by
      have e : min (actualBalanceAt n i) preset.MAX_EFFECTIVE_BALANCE.toNat + preset.downwardBand +
          (keyDebits i Ef + slashedCharge preset n i) =
          min (actualBalanceAt n i) preset.MAX_EFFECTIVE_BALANCE.toNat + preset.downwardBand +
            keyDebits i Ef + slashedCharge preset n i := by omega
      rw [e]
      exact ineq)
  have := Nat.min_le_left (actualBalanceAt n i) preset.MAX_EFFECTIVE_BALANCE.toNat
  omega

/-- The state inside a slot step has the registry and the balances of the state after its upgrades.

The upgrades after Electra and before Gloas keep both. -/
private theorem mid_data {s n : ForkedBeaconState preset}
    (electra : .pectra ≤ s.fork) (early : n.fork < .glamsterdam)
    (upgrades : processUpgrades config checks s = .ok n) :
    n.state.validators.data = s.state.validators.data ∧
      n.state.balances.data = s.state.balances.data := by
  have target : .pectra ≤ n.fork := Nat.le_trans electra (processUpgrades_fork_le upgrades)
  obtain ⟨validators, balances, -⟩ := processUpgrades_retained_data electra early upgrades target
  exact ⟨validators, balances⟩

/-- Every state on the balance path of the climb has the key, and the floor of the pin. -/
private theorem Ctx.floors {g x z y zz n : ForkedBeaconState preset} {high : ℕ}
    (c : Ctx config checks g x high) (hz : Run config checks x z)
    (early : y.fork < .glamsterdam) (within : (getCurrentEpoch y.state).toNat ≤ high + 1)
    (i : ℕ) (v0 : Validator) (found0 : z.state.validators.data[i]? = some v0)
    (unslashed0 : v0.slashed = false) (activated0 : v0.activationEpoch ≠ FAR_FUTURE_EPOCH)
    (bal0 : preset.MAX_EFFECTIVE_BALANCE.toNat ≤ actualBalanceAt z i)
    (hystZ : effectiveAt z i ≤ actualBalanceAt z i + preset.downwardBand)
    (exitLate : ∀ (n : ForkedBeaconState preset) (_rest : Run config checks n y) (w : Validator),
      n.state.validators.data[i]? = some w → (getCurrentEpoch y.state).toNat < w.exitEpoch.toNat)
    (pre0 : Run config checks z zz) (ok : advanceSlotAcross config checks zz = .ok n)
    (rest0 : Run config checks n y)
    (stepN : (getCurrentEpoch n.state).toNat = (getCurrentEpoch zz.state).toNat + 1)
    {Ef : List (BalanceEvent preset)}
    (hEf : (pre0.snoc (Step.slot ok)).balanceEvents high = .ok Ef) :
    ∀ p ∈ (pre0.snoc (Step.slot ok)).balancePath,
      (∃ val, p.state.validators.data[i]? = some val) ∧
        2 * preset.MAX_EFFECTIVE_BALANCE.toNat / 3 -
          preset.MAX_EFFECTIVE_BALANCE.toNat /
            (EthLib.Consensus.parameters preset .fusaka).MIN_SLASHING_PENALTY_QUOTIENT.toNat -
          preset.downwardBand - 1 ≤ actualBalanceAt p i + keyDebits i Ef := by
  have nY := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps rest0.chainSteps)
  have nEarly : n.fork < .glamsterdam :=
    Nat.lt_of_le_of_lt (fork_le_of_chainSteps rest0.chainSteps) early
  -- a state of the run before the last step
  have runState : ∀ (p : ForkedBeaconState preset) (rp : Run config checks z p)
      (rest : Run config checks p zz), pre0 = rp.append rest →
      (∃ val, p.state.validators.data[i]? = some val) ∧
        2 * preset.MAX_EFFECTIVE_BALANCE.toNat / 3 -
          preset.MAX_EFFECTIVE_BALANCE.toNat /
            (EthLib.Consensus.parameters preset .fusaka).MIN_SLASHING_PENALTY_QUOTIENT.toNat -
          preset.downwardBand - 1 ≤ actualBalanceAt p i + keyDebits i Ef := by
    intro p rp rest eq
    have pz := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps rest.chainSteps)
    obtain ⟨val, found, -⟩ := rp.registryLifecycle.validators i v0 found0
    refine ⟨⟨val, found⟩, ?_⟩
    refine c.floorRun hz early within i v0 found0 unslashed0 activated0 bal0 hystZ exitLate rp
      (rest.snoc (Step.slot ok)) ((rest.snoc (Step.slot ok)).append rest0) (by omega) ?_
    rw [eq] at hEf
    exact hEf
  intro p member
  simp only [Run.balancePath, List.mem_append] at member
  rcases member with member | member
  · rcases Run.mem_balancePath_split pre0 member with ⟨rp, rest, eq⟩ |
      ⟨q, n', rq, ok', rest, adv, eq, advOk, hp, upgrades⟩
    · exact runState p rp rest eq
    · have step := runState n' (rq.snoc (Step.slot ok')) rest eq
      have qFork : x.fork ≤ q.fork :=
        Nat.le_trans (fork_le_of_chainSteps hz.chainSteps) (fork_le_of_chainSteps rq.chainSteps)
      have n'Early : n'.fork < .glamsterdam :=
        Nat.lt_of_le_of_lt (fork_le_of_chainSteps rest.chainSteps)
          (Nat.lt_of_le_of_lt (fork_le_of_chainSteps (Run.nil.snoc (Step.slot ok)).chainSteps)
            nEarly)
      have data := mid_data (config := config) (checks := checks) (s := ⟨q.fork, adv⟩)
        (Nat.le_trans c.electra qFork) n'Early upgrades
      subst hp
      obtain ⟨⟨val, found⟩, bound⟩ := step
      refine ⟨⟨val, ?_⟩, ?_⟩
      · simpa [data.1] using found
      · have : actualBalanceAt ⟨q.fork, adv⟩ i = actualBalanceAt n' i := by
          simp only [actualBalanceAt, data.2]
        rw [this]
        exact bound
  · obtain ⟨adv, advOk, upgrades⟩ := bind_ok_iff.mp ok
    simp only [Step.balancePath, advOk, Except.toOption, List.mem_cons, List.not_mem_nil,
      or_false] at member
    rcases member with rfl | rfl | rfl
    · exact runState _ pre0 .nil rfl
    · have zzFork : .pectra ≤ zz.fork := Nat.le_trans c.electra
        (Nat.le_trans (fork_le_of_chainSteps hz.chainSteps) (fork_le_of_chainSteps pre0.chainSteps))
      have data := mid_data (config := config) (checks := checks) (s := ⟨zz.fork, adv⟩) zzFork
        nEarly upgrades
      obtain ⟨val, found, -⟩ := (pre0.snoc (Step.slot ok)).registryLifecycle.validators i v0 found0
      refine ⟨⟨val, ?_⟩, ?_⟩
      · simpa [data.1] using found
      · have := c.claimEnd hz early within i v0 found0 unslashed0 activated0 bal0 hystZ exitLate
          pre0 ok rest0 stepN hEf
        have e : actualBalanceAt ⟨zz.fork, adv⟩ i = actualBalanceAt n i := by
          simp only [actualBalanceAt, data.2]
        rw [e]
        exact this
    · obtain ⟨val, found, -⟩ := (pre0.snoc (Step.slot ok)).registryLifecycle.validators i v0 found0
      exact ⟨⟨val, found⟩, c.claimEnd hz early within i v0 found0 unslashed0 activated0 bal0 hystZ
        exitLate pre0 ok rest0 stepN hEf⟩

end Epoch

/-- The last step of the floor of a new key, in naturals.

The effective balance is at least the least of three bounds.

It is therefore at least the stake of the pin, less the increment.

The debits are added back. -/
private theorem final_floor (A inc S effZ effN K : ℕ) (hA : A ≤ K) (hZ : K ≤ effZ)
    (h : min effZ (min K (A - 1 - S + 1 - inc)) ≤ effN) : A - inc ≤ effN + S := by
  rw [min_eq_right ((min_le_left _ _).trans hZ)] at h
  simp only [Nat.min_def] at h
  split_ifs at h <;> omega

/-! ## The effective balance of a new key -/

/-- A key that has an activation epoch two epochs ahead holds the largest effective balance there.

It is funded: its balance is at least its effective balance, which is at least the maximum.

Its effective balance is at most its balance and the downward band, and it is unslashed. -/
private theorem Run.funded_at_start {g x z : ForkedBeaconState preset}
    (shared : Run config checks g x) (genesis : Genesis (config := config) (checks := checks) g)
    (caps : CapOrder preset) (aligned : MaxEffectiveBalancesAligned preset)
    (electra : .pectra ≤ x.fork) (pre : Run config checks x z) (zEarly : z.fork < .glamsterdam)
    (i : ℕ) {v0 : Validator} (found0 : z.state.validators.data[i]? = some v0)
    (actNeFar : v0.activationEpoch ≠ FAR_FUTURE_EPOCH)
    (act : (getCurrentEpoch z.state).toNat + 2 = v0.activationEpoch.toNat) :
    v0.slashed = false ∧ preset.MAX_EFFECTIVE_BALANCE.toNat ≤ actualBalanceAt z i ∧
      effectiveAt z i ≤ actualBalanceAt z i + preset.downwardBand ∧
      preset.MAX_EFFECTIVE_BALANCE.toNat ≤ effectiveAt z i := by
  have electraZ : .pectra ≤ z.fork := Nat.le_trans electra (fork_le_of_chainSteps pre.chainSteps)
  have actBound := v0.activationEpoch.toNat_lt
  have finite : getCurrentEpoch z.state < FAR_FUTURE_EPOCH :=
    UInt64.lt_iff_toNat_lt.mpr (by
      have far : FAR_FUTURE_EPOCH.toNat = 2 ^ 64 - 1 := rfl
      omega)
  have plusOne : (getCurrentEpoch z.state + 1).toNat = (getCurrentEpoch z.state).toNat + 1 := by
    rw [UInt64.toNat_add]
    have : (1 : UInt64).toNat = 1 := rfl
    rw [this]
    have far : FAR_FUTURE_EPOCH.toNat = 2 ^ 64 - 1 := rfl
    exact Nat.mod_eq_of_lt (by omega)
  have lessAct : getCurrentEpoch z.state + 1 < v0.activationEpoch :=
    UInt64.lt_iff_toNat_lt.mpr (by rw [plusOne]; omega)
  obtain ⟨funded, maxLe, unslashed⟩ := (Internal.run_eligible_balance (shared.append pre) genesis
    caps.activation caps.compounding aligned zEarly finite).2 electraZ i v0 found0
    (Or.inl actNeFar)
    (UInt64.lt_iff_toNat_lt.mpr (by have := UInt64.lt_iff_toNat_lt.mp lessAct; omega))
  obtain ⟨bal, hbal, effLe⟩ := funded (by
    have := UInt64.lt_iff_toNat_lt.mp lessAct
    omega)
  refine ⟨unslashed, ?_, ?_, ?_⟩
  · have := UInt64.le_iff_toNat_le.mp (UInt64.le_trans maxLe effLe)
    simpa [actualBalanceAt, hbal] using this
  · have := UInt64.le_iff_toNat_le.mp effLe
    simp only [effectiveAt, actualBalanceAt, found0, hbal, Option.map_some, Option.getD_some]
    omega
  · have := UInt64.le_iff_toNat_le.mp maxLe
    simpa [effectiveAt, found0] using this

open DirectSafety.Apriori.Internal in
/-- A key created on the run keeps its effective balance near two thirds of the maximum.

Under the guard at the split, the key's effective balance at the end of the window is large.

It is at least two thirds of `MAX_EFFECTIVE_BALANCE`.

The bound loses the initial slashing penalty, the downward band and an increment.

The key's sync debits and its partial payments are added back.

The key is scheduled at the split.

It is not active by the epoch after the split, and it is active at the end. -/
private theorem Run.new_key_effective_floor {g x y : ForkedBeaconState preset}
    (shared : Run config checks g x) (genesis : Genesis (config := config) (checks := checks) g)
    (parameters : DirectSafety.Parameters preset) (caps : CapOrder preset)
    (aligned : MaxEffectiveBalancesAligned preset) (twoSlots : 2 ≤ preset.SLOTS_PER_EPOCH.toNat)
    (electra : .pectra ≤ x.fork) (fulu : .fusaka ≤ x.fork) (high : ℕ)
    (guard : DirectSafety.Apriori.aprioriGuardAt config x high)
    (tail : Run config checks x y) (early : y.fork < .glamsterdam)
    (within : (getCurrentEpoch y.state).toNat ≤ high + 1)
    (window : preset.SeedLookaheadAtLeastThree)
    (delay : 0 < config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    (bands : preset.IncrementWithinUpwardBand) (facts : PinPresetFacts preset)
    (i : ℕ)
    (pending : ∀ v, x.state.validators.data[i]? = some v →
      (getCurrentEpoch x.state).toNat + 1 < v.activationEpoch.toNat)
    (active : isActiveAt y.state (getCurrentEpoch y.state) i = true)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events) :
    2 * preset.MAX_EFFECTIVE_BALANCE.toNat / 3 -
        preset.MAX_EFFECTIVE_BALANCE.toNat /
          (EthLib.Consensus.parameters preset .fusaka).MIN_SLASHING_PENALTY_QUOTIENT.toNat -
        preset.downwardBand - preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤
      effectiveAt y i + (events.map (syncDebit i)).sum +
        (events.map (floorPartialDebit i.toUInt64)).sum := by
  -- The potential, the least of balance and maximum plus the band, follows the floor path.
  classical
  obtain ⟨wa, foundA, activeA⟩ := isActiveAt_eq_true_iff.mp active
  simp only [isActiveValidator, Bool.and_eq_true, decide_eq_true_eq] at activeA
  have exitGt := UInt64.lt_iff_toNat_lt.mp activeA.2
  have lowA := UInt64.le_iff_toNat_le.mp activeA.1
  obtain ⟨z, pre, post, v0, vy, split, found0, foundY, sameAct, actEq, actLe⟩ :=
    Run.start_state tail window i pending ⟨wa, foundA, fun far => by
      have := congrArg UInt64.toNat far
      have bound := wa.exitEpoch.toNat_lt
      have : FAR_FUTURE_EPOCH.toNat = 2 ^ 64 - 1 := rfl
      omega, activeA.1⟩ fun vy found => by
      obtain rfl := Option.some.inj (found.symm.trans foundA)
      omega
  obtain rfl := Option.some.inj (foundY.symm.trans foundA)
  have farToNat : FAR_FUTURE_EPOCH.toNat = 2 ^ 64 - 1 := rfl
  have exitBound := vy.exitEpoch.toNat_lt
  have xz := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps pre.chainSteps)
  have zy := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps post.chainSteps)
  have zEarly : z.fork < .glamsterdam :=
    Nat.lt_of_le_of_lt (fork_le_of_chainSteps post.chainSteps) early
  have electraZ : .pectra ≤ z.fork := Nat.le_trans electra (fork_le_of_chainSteps pre.chainSteps)
  have fuluZ : .fusaka ≤ z.fork := Nat.le_trans fulu (fork_le_of_chainSteps pre.chainSteps)
  have actNeFar : v0.activationEpoch ≠ FAR_FUTURE_EPOCH := by
    intro h
    rw [sameAct] at h
    have := congrArg UInt64.toNat h
    omega
  have actZ : (getCurrentEpoch z.state).toNat + 2 = v0.activationEpoch.toNat := by
    rw [sameAct]
    exact actEq
  obtain ⟨unslashed, bal0, hystZ, effZ⟩ :=
    Run.funded_at_start shared genesis caps aligned electra pre zEarly i found0 actNeFar actZ
  have exitLate : ∀ (n : ForkedBeaconState preset) (_rest : Run config checks n y)
      (w : Validator), n.state.validators.data[i]? = some w →
      (getCurrentEpoch y.state).toNat < w.exitEpoch.toNat := by
    intro n rest w found
    obtain ⟨later, foundL, life⟩ := rest.registryLifecycle.validators i w found
    have same : later = vy := Option.some.inj (foundL.symm.trans foundY)
    subst same
    by_cases assigned : w.exitEpoch = FAR_FUTURE_EPOCH
    · rw [assigned, farToNat]
      omega
    · rw [← life.exitEpoch assigned]
      exact exitGt
  obtain ⟨room, big⟩ := first_floor_of_guard shared genesis aligned (Nat.lt_of_le_of_lt
    (fork_le_of_chainSteps tail.chainSteps) early) electra guard facts
  have c : Ctx config checks g x high :=
    { shared := shared, genesis := genesis, parameters := parameters, caps := caps,
      aligned := aligned, twoSlots := twoSlots, electra := electra, fulu := fulu, guard := guard,
      delay := delay, vector := facts.vector, big := big, factor := facts.reward,
      quotientTwo := facts.quotient, margin := facts.margin, room := room,
      bands := bands }
  -- the last epoch starts with a slot step
  obtain ⟨zz, n, pre0, ok, rest0, splitPost, hzz, hn⟩ :=
    Run.cross_split post ((getCurrentEpoch y.state).toNat - 1) (by omega) (by omega)
  have nY := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps rest0.chainSteps)
  have nEarly : n.fork < .glamsterdam :=
    Nat.lt_of_le_of_lt (fork_le_of_chainSteps rest0.chainSteps) early
  obtain ⟨Ef, hEf⟩ := (pre0.snoc (Step.slot ok)).balanceEvents_ok nEarly high
  have floors := c.floors pre early within i v0 found0 unslashed actNeFar bal0 hystZ exitLate pre0
    ok rest0 (by omega) hEf
  -- the debits of the climb are debits of the run
  have tailEq : tail = (pre.append (pre0.snoc (Step.slot ok))).append rest0 := by
    rw [split, splitPost, Run.append_assoc]
  obtain ⟨ePre, hePre⟩ := pre.balanceEvents_ok (Nat.lt_of_le_of_lt (fork_le_of_chainSteps
    (pre0.snoc (Step.slot ok)).chainSteps) nEarly) high
  have whole := balanceEvents_append pre (pre0.snoc (Step.slot ok)) high hePre hEf
  rw [tailEq] at replayed
  obtain ⟨before, beforeOk, isPrefix⟩ := Run.balanceEvents_prefix
    (pre.append (pre0.snoc (Step.slot ok))) rest0 high events replayed
  rw [whole] at beforeOk
  cases beforeOk
  have debits : keyDebits i Ef ≤ keyDebits i events := by
    have := keyDebits_le_of_prefix i isPrefix
    rw [keyDebits_append] at this
    omega
  -- the balance floor along the climb, and the effective balance by hysteresis
  have nIn : i < z.state.validators.data.size := (Array.getElem?_eq_some_iff.mp found0).1
  have hBal := Run.effective_floor_of_balance_floor (pre0.snoc (Step.slot ok)) nEarly fuluZ
    (Nat.lt_of_lt_of_le (by norm_num) facts.incrementSize) i nIn
    (2 * preset.MAX_EFFECTIVE_BALANCE.toNat / 3 -
        preset.MAX_EFFECTIVE_BALANCE.toNat /
          (EthLib.Consensus.parameters preset .fusaka).MIN_SLASHING_PENALTY_QUOTIENT.toNat -
        preset.downwardBand - 1 - keyDebits i events) preset.MAX_EFFECTIVE_BALANCE.toNat
    (fun p member => by
      have := (floors p member).2
      omega)
    (fun p member => by
      obtain ⟨⟨val, found⟩, -⟩ := floors p member
      have := UInt64.le_iff_toNat_le.mp
        (Internal.minimum_cap caps.activation caps.compounding (h := p.fork) val)
      simpa [PinTerms.capAt, found] using this)
  have sameEff : effectiveAt y i = effectiveAt n i := by
    have inside : i < n.state.validators.data.size := by
      obtain ⟨val, found, -⟩ := (pre0.snoc (Step.slot ok)).registryLifecycle.validators i v0 found0
      exact (Array.getElem?_eq_some_iff.mp found).1
    exact run_same_epoch_effective rest0 early (UInt64.toNat_inj.mp (by omega)) i inside
  rw [sameEff]
  have kd : keyDebits i events = (events.map (syncDebit i)).sum +
      (events.map (floorPartialDebit i.toUInt64)).sum := rfl
  have fin := final_floor
    (2 * preset.MAX_EFFECTIVE_BALANCE.toNat / 3 -
        preset.MAX_EFFECTIVE_BALANCE.toNat /
          (EthLib.Consensus.parameters preset .fusaka).MIN_SLASHING_PENALTY_QUOTIENT.toNat -
        preset.downwardBand) preset.EFFECTIVE_BALANCE_INCREMENT.toNat (keyDebits i events)
    (effectiveAt z i) (effectiveAt n i) preset.MAX_EFFECTIVE_BALANCE.toNat
    ((Nat.sub_le _ _).trans ((Nat.sub_le _ _).trans (by omega))) effZ hBal
  omega

end PinKeys

end

end EthLib.Consensus.Models.Network


namespace EthLib.Consensus.Models.Network
namespace PinDrift

open Base Uint64 Models DirectSafety PinKeys

variable {preset : Preset} {fork : Fork} {config : Config} {checks : SignatureChecks}

/-- `creditGain` is its part for compounding flows and its part for new keys past the cap. -/
private theorem creditGain_split (config : Config)
    (state ancestor finalizedState : BeaconState preset fork) :
    (pinTerms config state ancestor finalizedState).creditGain =
      (pinTerms config state ancestor finalizedState).creditLow +
        (pinTerms config state ancestor finalizedState).creditCap := rfl

/-- `exitedRB` is the filter of `exitedR`.

It keeps the keys whose exit started on this branch after the split. -/
private theorem exitedR_eq (config : Config)
    (state ancestor finalizedState : BeaconState preset fork) :
    (pinTerms config state ancestor finalizedState).exitedR =
      ∑ i ∈ (pinTerms config state ancestor finalizedState).positions with
        (pinTerms config state ancestor finalizedState).exitedRB i = true,
        (balanceAt state i + (pinTerms config state ancestor finalizedState).rise i) := rfl

/-- `slashedRB` is the filter of `slashedR`.

They are the keys slashed on this branch after the finalized epoch. -/
private theorem slashedR_eq (config : Config)
    (state ancestor finalizedState : BeaconState preset fork) :
    (pinTerms config state ancestor finalizedState).slashedR =
      ((pinTerms config state ancestor finalizedState).positions.filter fun i =>
        (pinTerms config state ancestor finalizedState).slashedRB i = true).card := rfl

/-- The copy splits `queues` into its deposit part and its exit and consolidation part. -/
private theorem queues_split (config : Config)
    (state ancestor finalizedState : BeaconState preset fork) :
    (pinTerms config state ancestor finalizedState).queues =
      (pinTerms config state ancestor finalizedState).queueDep +
        (pinTerms config state ancestor finalizedState).queueExit := rfl

/-- `queueRise` charges each key the queues let exit, at a band and the largest gain rate. -/
private theorem queueRise_unfold (config : Config)
    (state ancestor finalizedState : BeaconState preset fork) :
    (pinTerms config state ancestor finalizedState).queueRise =
      if (pinTerms config state ancestor finalizedState).tight then 0 else
        3 * (pinTerms config state ancestor finalizedState).queueKeys *
          (preset.upwardBand + (pinTerms config state ancestor finalizedState).depth *
            (pinTerms config state ancestor finalizedState).gainRateMax) := rfl

/-- `queueKeys` counts the window's churn by `exitFloor`, the ends, the low keys and new keys. -/
private theorem queueKeys_unfold (config : Config)
    (state ancestor finalizedState : BeaconState preset fork) :
    (pinTerms config state ancestor finalizedState).queueKeys =
      (pinTerms config state ancestor finalizedState).queueWindow /
          (pinTerms config state ancestor finalizedState).exitFloor + 2 +
        (pinTerms config state ancestor finalizedState).lowKeys +
        (pinTerms config state ancestor finalizedState).newKeySeats := rfl

/-- A key's fall is its effective balance less `floorC` within the delay, and all of it beyond. -/
private theorem fall_eq (config : Config) (state ancestor finalizedState : BeaconState preset fork)
    (i : ℕ) :
    (pinTerms config state ancestor finalizedState).fall i =
      if (getCurrentEpoch state).toNat + 2 - (getCurrentEpoch finalizedState).toNat ≤
          config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat then
        balanceAt state i - (pinTerms config state ancestor finalizedState).floorC i
      else balanceAt state i := rfl

/-- `lowEB` takes the drops from the least of its starting balances, capped at activation. -/
private theorem lowEB_unfold (config : Config)
    (state ancestor finalizedState : BeaconState preset fork)
    (i : ℕ) :
    (pinTerms config state ancestor finalizedState).lowEB i =
      min (min (min (balanceAt state i) (balanceAt finalizedState i))
            (((finalizedState.balances.data[i]?).map (·.toNat)).getD 0) -
          (pinTerms config state ancestor finalizedState).partialsDue i)
        preset.MIN_ACTIVATION_BALANCE.toNat -
        (pinTerms config state ancestor finalizedState).drop i := rfl

/-- `base0` of a key that the finalized block's state holds: its balance there, within its cap. -/
private theorem base0_of_found (config : Config) (pulled anc fin : BeaconState preset fork)
    {i : ℕ} {val : Validator} (initial : fin.validators.data[i]? = some val) :
    (pinTerms config pulled anc fin).base0 i =
      min (actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i)
        (withdrawalMaxEffectiveBalance preset fork val).toNat := by
  simp only [pinTerms, PinTerms.capAt, initial, Option.map_some, Option.getD_some]
  rfl

/-- `drop` of a key that the finalized block's state holds, with its carry and its leak read out. -/
private theorem drop_of_found (config : Config) (pulled anc fin : BeaconState preset fork)
    {i : ℕ} {val : Validator} (initial : fin.validators.data[i]? = some val) :
    (pinTerms config pulled anc fin).drop i =
      ((pinTerms config pulled anc fin).leakAt
          (effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) i -
            actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i +
            preset.EFFECTIVE_BALANCE_INCREMENT.toNat) i + 1) +
        ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) *
          ((pinTerms config pulled anc fin).leakAt
            ((pinTerms config pulled anc fin).base0 i +
              preset.EFFECTIVE_BALANCE_INCREMENT.toNat) i + 1) +
        preset.downwardBand + preset.EFFECTIVE_BALANCE_INCREMENT.toNat := by
  simp only [pinTerms, PinTerms.capAt, initial, Option.map_some, Option.getD_some]
  rfl

/-- `lowB` is the filter of `lowKeys`. -/
private theorem lowKeys_eq (config : Config)
    (state ancestor finalizedState : BeaconState preset fork) :
    (pinTerms config state ancestor finalizedState).lowKeys =
      ((pinTerms config state ancestor finalizedState).positions.filter fun i =>
        (pinTerms config state ancestor finalizedState).lowB i = true).card := rfl

/-! ## The setting of the pin -/

/-- The setting of the pin's drift bound for one call.

The call's own-epoch runs are left out. -/
structure Setting (config : Config) (checks : SignatureChecks) (g : ForkedBeaconState preset)
    (split fin pulled anc counted : BeaconState preset fork) (V : Finset ValidatorIndex) :
    Prop where
  genesis : Genesis config checks g
  toFin : Nonempty (Run config checks g ⟨fork, fin⟩)
  fromFin : Nonempty (Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
  toPulled : Nonempty (Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩)
  toCounted : Nonempty (Run config checks ⟨fork, split⟩ ⟨fork, counted⟩)
  early : fork < .glamsterdam
  fulu : .fusaka ≤ fork
  bands : preset.IncrementWithinUpwardBand
  caps : CapOrder preset
  window : preset.SeedLookaheadAtLeastThree
  parameters : DirectSafety.Parameters preset
  aligned : MaxEffectiveBalancesAligned preset
  twoSlots : 2 ≤ preset.SLOTS_PER_EPOCH.toNat
  shallow : (getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat ≤
    config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat
  pulledTotal : ∃ t, getTotalActiveBalance pulled = .ok t
  facts : PinPresetFacts preset
  guard : DirectSafety.Apriori.aprioriGuardAt config ⟨fork, fin⟩ (getCurrentEpoch pulled).toNat
  finalized : anc.finalizedCheckpoint.epoch ≤ getCurrentEpoch split
  later : getCurrentEpoch pulled ≤ getCurrentEpoch counted
  near : (getCurrentEpoch counted).toNat ≤ (getCurrentEpoch pulled).toNat + 1
  voting : ∀ v ∈ V, v ∈ activeVoters pulled ∧ (slashedFlagAt counted v.toNat).getD false = false

/-- The call's epoch is at or after the split's, since a run leads from one to the other. -/
private theorem Setting.called {g : ForkedBeaconState preset}
    {split fin pulled anc counted : BeaconState preset fork} {V : Finset ValidatorIndex}
    (h : Setting config checks g split fin pulled anc counted V) :
    getCurrentEpoch split ≤ getCurrentEpoch pulled := by
  obtain ⟨toPulled⟩ := h.toPulled
  exact currentEpoch_le_of_chainSteps toPulled.chainSteps

/-- The withdrawal delay is positive, since it is at least the two epochs past the finalized one. -/
private theorem Setting.delay {g : ForkedBeaconState preset}
    {split fin pulled anc counted : BeaconState preset fork} {V : Finset ValidatorIndex}
    (h : Setting config checks g split fin pulled anc counted V) :
    0 < config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat := by
  obtain ⟨fromFin⟩ := h.fromFin
  obtain ⟨toPulled⟩ := h.toPulled
  have order : (getCurrentEpoch fin).toNat ≤ (getCurrentEpoch pulled).toNat :=
    UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps (fromFin.append toPulled).chainSteps)
  have := h.shallow
  omega

/-! ## Flows of the two branches -/

/-- The deposits applied to the key on R's branch.

They are over the replayed events of the run from the split. -/
private def credDepR (events : List (BalanceEvent preset)) (v : ℕ) : ℕ :=
  ((events.filter (·.source = .deposits)).map (keyCredit v)).sum

/-- The consolidation credits to the key over the replayed events of a run.

It is the quantity that `Run.consolidation_credits_le_X_targets` bounds, summed over targets. -/
private def consAmt (events : List (BalanceEvent preset)) (v : ℕ) : ℕ :=
  ((events.filter (·.source = .consolidations)).map (keyCredit v)).sum

/-! ### The C-side credits of a key, read from the run

They are read from the run itself, as `riseQ` is.

A block step's `.rewards` events are its proposer's credits.

A slot step's `.rewards` events are the epoch's flag rewards.

So a slot step counts only the sources named below.

Sync events are in `syncF` with the seats. -/

/-- Proposer and due-consolidation credits to the key on C's branch since the split.

The rounding slack of a credited key is `bandC`, once for each key.

The consolidation bands are not here: `bud_consolidations` charges them. -/
private def propC {x y : ForkedBeaconState preset} (tail : Run config checks x y)
    (high v : ℕ) : ℕ :=
  (creditScan (fun s => decide (s = .rewards ∨ s = .consolidations))
    (fun s => decide (s = .consolidations)) v high tail)

/-- Proposer credits to the key on C's branch since the split, without the consolidation credits.

A credited stake compounds by at most a tenth.

The bounds of the terms charge an exact tenth of the keys' total, at ten times their terms.

The consolidation credits are under `consolidationsX`, so their compounding is not charged here. -/
private def propN {x y : ForkedBeaconState preset} (tail : Run config checks x y)
    (high v : ℕ) : ℕ :=
  (creditScan (fun s => decide (s = .rewards)) (fun _ => false) v high tail)

/-- Proposer and deposit credits to the key on C's branch since the split.

They are `credC` without its consolidation credits.

A credited stake compounds by at most a tenth.

The bounds of the terms charge an exact tenth of the keys' total, at ten times their terms. -/
private def credN {x y : ForkedBeaconState preset} (tail : Run config checks x y)
    (high v : ℕ) : ℕ :=
  (creditScan (fun s => decide (s = .rewards)) (fun s => decide (s = .deposits)) v high tail)

/-- The deposits credited to a key by events whose state before them does not hold it slashed.

A slashed key's whistleblower reward reads its effective balance at the slashing.

Of `credN`'s credits, only these deposits and its proposer credits can raise that balance.

This holds because a slashed key proposes no block. -/
private def depPre (events : List (BalanceEvent preset)) (v : ℕ) : ℕ :=
  ((events.filter fun e => e.source = .deposits ∧
      ¬ (slashedFlagAt e.before.state v = some true)).map (keyCredit v)).sum

/-- Non-attestation credits to the key on C's branch since the split.

Whistleblower and sync credits are excluded.

The credits are the proposer's, deposits applied and consolidations.

The rounding slack of a credited key is `bandC`, once for each key. -/
private def credC {x y : ForkedBeaconState preset} (tail : Run config checks x y)
    (high v : ℕ) : ℕ :=
  (creditScan (fun s => decide (s = .rewards ∨ s = .consolidations))
    (fun s => decide (s = .consolidations ∨ s = .deposits)) v high tail)

/-- Whistleblower credits to the key on C's branch since the split.

A whistleblower credit lands in the block of the proposer's own slot.

The rounding slack of a credited key is `bandC`, once for each key.

A slot step records only debits for a slashing. -/
private def whistC {x y : ForkedBeaconState preset} (tail : Run config checks x y)
    (high v : ℕ) : ℕ :=
  (creditScan (fun s => decide (s = .slashings)) (fun _ => false) v high tail)

/-- The entries of X's queue of pending consolidations that name a target in `T`.

They are the ones that apply by `high + 1`.

It is the set of `Run.consolidation_credits_le_X_targets`, counted instead of summed. -/
private def dueAt (X : BeaconState preset fork) (high : ℕ) (T : Finset ValidatorIndex) : ℕ :=
  if electra : .pectra ≤ fork then
    ((((X.pendingConsolidations electra).data.toList.filter fun c =>
        decide (c.targetIndex ∈ T)).filterMap fun c =>
      X.validators.data[c.sourceIndex.toNat]?).filter fun v =>
        !v.slashed && decide (v.withdrawableEpoch.toNat ≤ high + 1)).length
  else 0

/-- The debit that one balance event takes from the key at position `i`. -/
private def keyDebit (i : ℕ) (e : BalanceEvent preset) : ℕ :=
  actualBalanceAt e.before i - actualBalanceAt e.after i

/-- The sync-seat movement of the key over the replayed events of one run.

It is the key's credits and debits of the sync aggregates.

They are a seat's debit, a seat's reward, and the proposer's share of it.

The caller adds it over the two runs from the split, since both branches credit and debit seats. -/
private def syncF (events : List (BalanceEvent preset)) (v : ℕ) : ℕ :=
  ((events.filter (·.source = .sync)).map (keyCredit v)).sum +
    ((events.filter (·.source = .sync)).map (keyDebit v)).sum

/-- One increment for a key slashed on R's branch after the finalized epoch.

The effective-balance drop of R's initial penalty is at most one increment, by `slashBand`.

`branchR` charges each such key the slash charge, at least one increment. -/
private def slashR (t : PinTerms preset) (i : ℕ) : ℕ :=
  if t.slashedRB i = true then preset.EFFECTIVE_BALANCE_INCREMENT.toNat else 0

/-- The gross credits to the key in the block steps of a run, from rewards, slashings and sync.

A block step counts the credits of its events from those sources, whatever the step takes back. -/
private def grossScan (v high : ℕ) {x y : ForkedBeaconState preset} (tail : Run config checks x y) :
    ℕ :=
  (creditScan (fun s => decide (s = .rewards ∨ s = .slashings ∨ s = .sync)) (fun _ => false) v
    high tail)

/-- The gross credits of a run, after one more step. -/
private theorem grossScan_snoc (v high : ℕ) {x m y : ForkedBeaconState preset}
    (pre : Run config checks x m) (step : Step config checks m y) :
    grossScan v high (pre.snoc step) = if (getCurrentEpoch m.state).toNat ≤ high + 1 then
      grossScan v high pre + stepCredit
        (fun s => decide (s = .rewards ∨ s = .slashings ∨ s = .sync)) (fun _ => false) v step
      else grossScan v high pre := by
  unfold grossScan
  exact creditScan_snoc _ _ v high pre step

private theorem grossScan_slot_pos (i high : ℕ) {x m n : ForkedBeaconState preset}
    (pre : Run config checks x m) (ok : advanceSlotAcross config checks m = .ok n)
    (pos : 0 < grossScan i high (pre.snoc (Step.slot ok))) : 0 < grossScan i high pre := by
  rw [grossScan_snoc] at pos
  split at pos
  · simpa [stepCredit] using pos
  · exact pos

/-- The gross credits of a run add over `append`. -/
private theorem grossScan_append (v high : ℕ) {x m y : ForkedBeaconState preset}
    (pre : Run config checks x m) (post : Run config checks m y) :
    grossScan v high (pre.append post) = grossScan v high pre + grossScan v high post := by
  unfold grossScan
  exact creditScan_append _ _ v high pre post

/-- The rounding slack of a key with any C-side credit, once for each key.

The credits are the gross credits of its block steps, and an applied deposit.

A proposer reward, a whistleblower reward and a sync reward are block credits.

A consolidation credit is not here: `bud_consolidations` charges its band for each entry.

`credits` charges `upwardBand` for each credited key. -/
private def bandC {x y : ForkedBeaconState preset} (tail : Run config checks x y)
    (high v : ℕ) : ℕ :=
  if 0 < grossScan v high tail +
      (creditScan (fun _ => false) (fun s => decide (s = .deposits)) v high tail) then
    preset.upwardBand else 0

/-- A sum over the members of a list that pass one of two apart tests is the two sums. -/
private theorem sum_filter_or {α : Type} (L : List α) (p q : α → Bool)
    (apart : ∀ a, ¬ (p a = true ∧ q a = true)) (f : α → ℕ) :
    ((L.filter fun a => p a || q a).map f).sum =
      ((L.filter p).map f).sum + ((L.filter q).map f).sum := by
  induction L with
  | nil => simp
  | cons a rest ih =>
    by_cases hp : p a = true
    · have hq : q a = false := by
        cases h : q a
        · rfl
        · exact absurd ⟨hp, h⟩ (apart a)
      simp [hp, hq, ih]; omega
    · by_cases hq : q a = true
      · simp [hp, hq, ih]; omega
      · simp [hp, hq, ih]

/-- The credits of a run that a scan reads add over two apart sets of sources.

The block sources of the scan and the slot sources are each the union of two apart sources. -/
private theorem creditScan_or (blockP slotP b₁ b₂ s₁ s₂ : BalanceSource → Bool)
    (hb : ∀ s, blockP s = (b₁ s || b₂ s)) (hs : ∀ s, slotP s = (s₁ s || s₂ s))
    (apartB : ∀ s, ¬ (b₁ s = true ∧ b₂ s = true)) (apartS : ∀ s, ¬ (s₁ s = true ∧ s₂ s = true))
    (v high : ℕ) {x y : ForkedBeaconState preset} (tail : Run config checks x y) :
    (creditScan blockP slotP v high tail) =
      (creditScan b₁ s₁ v high tail) + (creditScan b₂ s₂ v high tail) := by
  obtain rfl : blockP = fun s => b₁ s || b₂ s := funext hb
  obtain rfl : slotP = fun s => s₁ s || s₂ s := funext hs
  induction tail with
  | nil => rfl
  | @snoc middle last pre step ih =>
    have split : stepCredit (fun s => b₁ s || b₂ s) (fun s => s₁ s || s₂ s) v step =
        stepCredit b₁ s₁ v step + stepCredit b₂ s₂ v step := by
      cases step with
      | slot ok =>
        simp only [stepCredit]
        exact sum_filter_or _ (fun e : BalanceEvent preset => s₁ e.source)
          (fun e => s₂ e.source) (fun e => apartS e.source) _
      | block engine signed due ok =>
        simp only [stepCredit]
        exact sum_filter_or _ (fun e : BalanceEvent preset => b₁ e.source)
          (fun e => b₂ e.source) (fun e => apartB e.source) _
    rw [creditScan_snoc, creditScan_snoc, creditScan_snoc, split]
    split_ifs <;> omega

/-- The credits of a key on C's branch are its proposer credits and the deposits it is credited. -/
private theorem credN_split {x y : ForkedBeaconState preset} (tail : Run config checks x y)
    (high v : ℕ) :
    credN tail high v = propN tail high v +
      (creditScan (fun _ => false) (fun s => decide (s = .deposits)) v high tail) :=
  creditScan_or _ _ (fun s => decide (s = .rewards)) (fun _ => false) (fun _ => false)
    (fun s => decide (s = .deposits)) (fun s => by cases s <;> decide)
    (fun s => by cases s <;> decide)
    (fun s h => by simp at h) (fun s h => by simp at h) v high tail

/-- The credits of a key with the consolidations are its `credN` and its consolidation credits. -/
private theorem credC_split {x y : ForkedBeaconState preset} (tail : Run config checks x y)
    (high v : ℕ) :
    credC tail high v = credN tail high v +
      (creditScan (fun s => decide (s = .consolidations))
        (fun s => decide (s = .consolidations)) v high tail) :=
  creditScan_or _ _ (fun s => decide (s = .rewards)) (fun s => decide (s = .consolidations))
    (fun s => decide (s = .deposits)) (fun s => decide (s = .consolidations))
    (fun s => by cases s <;> decide) (fun s => by cases s <;> decide)
    (fun s h => by simp at h; exact absurd (h.1.symm.trans h.2) (by decide))
    (fun s h => by simp at h; exact absurd (h.1.symm.trans h.2) (by decide)) v high tail

/-- The proposer credits with the consolidations are `propN` and the consolidation credits. -/
private theorem propC_split {x y : ForkedBeaconState preset} (tail : Run config checks x y)
    (high v : ℕ) :
    propC tail high v = propN tail high v +
      (creditScan (fun s => decide (s = .consolidations))
        (fun s => decide (s = .consolidations)) v high tail) :=
  creditScan_or _ _ (fun s => decide (s = .rewards)) (fun s => decide (s = .consolidations))
    (fun _ => false) (fun s => decide (s = .consolidations))
    (fun s => by cases s <;> decide) (fun s => by cases s <;> decide)
    (fun s h => by simp at h; exact absurd (h.1.symm.trans h.2) (by decide))
    (fun s h => by simp at h) v high tail

/-- The proposer credits of two runs, one after the other, add. -/
private theorem propN_append {x m y : ForkedBeaconState preset} (pre : Run config checks x m)
    (post : Run config checks m y) (high v : ℕ) :
    propN (pre.append post) high v = propN pre high v + propN post high v :=
  creditScan_append _ _ v high pre post

/-- The gain of `C` credited gwei over `depth` epochs, at the reward rate `P`.

The credits count in whole increments rounded up, and each epoch's gain is rounded down. -/
private def gainOn (preset : Preset) (depth P C : ℕ) : ℕ :=
  depth * ((((C + preset.EFFECTIVE_BALANCE_INCREMENT.toNat - 1) /
      preset.EFFECTIVE_BALANCE_INCREMENT.toNat) * P *
    (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum) / WEIGHT_DENOMINATOR.toNat)

/-- The rounding slack of a key whose balance on R's branch took a sync debit that `high` omits.

It is one increment and the downward band less one.

`branchR` charges that step for each of its keys. -/
private def bandR (events : List (BalanceEvent preset)) (v : ℕ) : ℕ :=
  if 0 < ((events.filter (·.source = .sync)).map (keyDebit v)).sum then
    preset.EFFECTIVE_BALANCE_INCREMENT.toNat + preset.downwardBand - 1 else 0

/-- The sync credits to the key over the replayed events of one run. -/
private def syncCr (events : List (BalanceEvent preset)) (v : ℕ) : ℕ :=
  (events.map (syncCredit v)).sum

/-- The sync debits of the key over the replayed events of one run. -/
private def syncD (events : List (BalanceEvent preset)) (v : ℕ) : ℕ :=
  (events.map (syncDebit v)).sum

/-- A whistleblower's share of an amount at eleven tenths of three, rounded up.

It is `⌈33·x/(10·WRQ)⌉`, with the whistleblower quotient of the fork. -/
private def wShare (preset : Preset) (fork : Fork) (x : ℕ) : ℕ :=
  (33 * x + 10 * (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat - 1) /
    (10 * (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat)

/-- The band of each due consolidation entry of the state `X` that targets the key. -/
private def bandX (X : BeaconState preset fork) (high v : ℕ) : ℕ :=
  preset.upwardBand * dueAt X high {UInt64.ofNat v}

/-- The initial slashing penalty of a key slashed on R's branch after the split, at the cap. -/
private def slashW (t : PinTerms preset) (i : ℕ) : ℕ :=
  if t.slashedRB i = true then
    preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat /
      (EthLib.Consensus.parameters preset .fusaka).MIN_SLASHING_PENALTY_QUOTIENT.toNat
  else 0

/-- The leak a key's sync debits on R's run from the finalized block induce above `ebUp`.

It is the leak at the largest effective balance on the run, less the leak at `ebUp`.

`inducedR` is 0 when the key's withdrawable epoch at R is at most R's epoch plus one.

Such a key is swept by R, so the leak is not charged. -/
private def inducedR (t : PinTerms preset) {x y : ForkedBeaconState preset}
    (tail : Run config checks x y) (i : ℕ) : ℕ :=
  if t.withdrawnRB i = true then 0
  else
    t.depthFin * (t.leakAt ((tail.balancePath.map fun z => effectiveAt z i).foldl max 0) i -
      t.leakAt (t.ebUp i) i)

/-- A key that R holds withdrawable by the next epoch has no induced leak. -/
private theorem inducedR_of_withdrawn (t : PinTerms preset) {x y : ForkedBeaconState preset}
    (tail : Run config checks x y) (i : ℕ) (withdrawn : t.withdrawnRB i = true) :
    inducedR t tail i = 0 := by
  simp [inducedR, withdrawn]

/-- A key that R does not hold withdrawable is charged the leak at its largest balance. -/
private theorem inducedR_of_not_withdrawn (t : PinTerms preset) {x y : ForkedBeaconState preset}
    (tail : Run config checks x y) (i : ℕ) (kept : t.withdrawnRB i = false) :
    inducedR t tail i =
      t.depthFin * (t.leakAt ((tail.balancePath.map fun z => effectiveAt z i).foldl max 0) i -
        t.leakAt (t.ebUp i) i) := by
  simp [inducedR, kept]

/-- The flows that can raise a key's balance on C above R's base, besides its epoch rewards.

They are its credits on C's branch and its sync debits on R's branch and on the shared segment.

They also include the initial penalty of a slashing on R's branch.

The credits `cred` default to `credC`, which counts the key's deposits.

A key of `K5` passes `propC`, which does not. -/
private def flowCredit (t : PinTerms preset) {x y : ForkedBeaconState preset}
    (tailC : Run config checks x y) (high : ℕ)
    (eventsC events eventsF : List (BalanceEvent preset)) (i : ℕ)
    (cred : ℕ := credC tailC high i) : ℕ :=
  cred + whistC tailC high i + syncCr eventsC i + syncD events i + syncD eventsF i +
    slashW t i

/-- The gain of a key's flows over the window, at eleven tenths in whole increments.

It is one floor of all the flows; the closure splits it by kind in aggregate.

Its rate is floored once, after the increments, as the gain of the credits is.

A gain-carrying run starts at the split, so the gain runs over at most the shorter window. -/
private def flowGain (t : PinTerms preset) {x y : ForkedBeaconState preset}
    (tailC : Run config checks x y) (high : ℕ)
    (eventsC events eventsF : List (BalanceEvent preset)) (i : ℕ)
    (cred : ℕ := credC tailC high i) : ℕ :=
  min t.depth t.depthFin * (11 * flowCredit t tailC high eventsC events eventsF i cred /
    (10 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat) * t.perIncrement *
      (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum / WEIGHT_DENOMINATOR.toNat)

/-- The flow gain of a key whose rise is on its kept arm, or that R's registry does not hold.

On the other arm the rise is the key's whole headroom, which holds its gains already.

A key that R's registry does not hold is charged here only in the low regime.

In the high regime `creditCap` charges it up to the cap. -/
private def flowK (t : PinTerms preset) {x y : ForkedBeaconState preset}
    (tailC : Run config checks x y) (high : ℕ)
    (eventsC events eventsF : List (BalanceEvent preset)) (i : ℕ)
    (cred : ℕ := credC tailC high i) : ℕ :=
  if t.keptArm i = true ∨ (i ∉ t.positions ∧ t.gainHigh = false) then
    flowGain t tailC high eventsC events eventsF i cred
  else 0

/-- One unit of gain for a key with any flow.

A flow can raise the key's effective balance by one more increment than its rewards alone. -/
private def unitK (t : PinTerms preset) {x y : ForkedBeaconState preset}
    (tailC : Run config checks x y) (high : ℕ)
    (eventsC events eventsF : List (BalanceEvent preset)) (i : ℕ)
    (cred : ℕ := credC tailC high i) : ℕ :=
  if 0 < flowCredit t tailC high eventsC events eventsF i cred then t.unitGain else 0

/-- The terms of a key's rise that the third window adds.

They are its sync debits on the shared segment, its flow gain and its unit.

They also include the leak that its sync debits on R's branch induce.

`bud_sync`, `flow_split_of`, `bud_units` and `bud_syncLeak` pay them, in that order. -/
private def keyExtra (t : PinTerms preset) {x y : ForkedBeaconState preset}
    (tail : Run config checks x y) {x' y' : ForkedBeaconState preset}
    (tailC : Run config checks x' y') (high : ℕ)
    (eventsC events eventsF : List (BalanceEvent preset)) (i : ℕ)
    (cred : ℕ := credC tailC high i) : ℕ :=
  syncD eventsF i + flowK t tailC high eventsC events eventsF i cred +
    unitK t tailC high eventsC events eventsF i cred + inducedR t tail i

/-- A quantity of the sync events, summed over all events with the others at zero. -/
private theorem sum_map_sync (events : List (BalanceEvent preset))
    (k : BalanceEvent preset → ℕ) :
    (events.map fun e => if e.source = .sync then k e else 0).sum =
      ((events.filter (·.source = .sync)).map k).sum := by
  induction events with
  | nil => rfl
  | cons e rest ih =>
    by_cases sync : e.source = .sync
    · simp [sync, ih]
    · simp [sync, ih]

/-- The sync debits of a key over a list of events are the debits of its sync events. -/
private theorem sum_syncDebit_eq (events : List (BalanceEvent preset)) (v : ℕ) :
    (events.map (syncDebit v)).sum =
      ((events.filter (·.source = .sync)).map (keyDebit v)).sum :=
  sum_map_sync events (keyDebit v)

/-- The rounding band of a key is the band if the key has a sync debit, and zero otherwise. -/
private theorem bandR_eq (events : List (BalanceEvent preset)) (v : ℕ) :
    bandR events v = if 0 < (events.map (syncDebit v)).sum then
      preset.EFFECTIVE_BALANCE_INCREMENT.toNat + preset.downwardBand - 1 else 0 := by
  unfold bandR
  rw [← sum_syncDebit_eq]

/-- A key's credit in an event is at most the event's credit limit. -/
private theorem keyCredit_le_creditLimit (i : ℕ) (e : BalanceEvent preset)
    (bounded : e.credits ≤ e.creditLimit) : keyCredit i e ≤ e.creditLimit := by
  refine le_trans ?_ bounded
  unfold keyCredit
  by_cases within : i < e.after.state.balances.data.size
  · exact Finset.single_le_sum (f := fun j =>
      actualBalanceAt e.after j - actualBalanceAt e.before j)
      (fun _ _ => Nat.zero_le _) (Finset.mem_range.mpr within)
  · have missing : actualBalanceAt e.after i = 0 := by
      simp [actualBalanceAt, Array.getElem?_eq_none (Nat.le_of_not_lt within)]
    omega

/-- The stages of an epoch replay record no slashing event with a credit limit. -/
private theorem epochReplayAction_slashing_credit {fork : Fork} (k : EpochStage)
    {pre post : BalanceReplay preset fork}
    (held : ∀ e ∈ pre.2, e.source = .slashings → e.creditLimit = 0)
    (ok : epochReplayAction (config := config) (checks := checks) k pre = .ok post) :
    ∀ e ∈ post.2, e.source = .slashings → e.creditLimit = 0 := by
  have carried : ∀ {a : BeaconState preset fork → Except TransitionError (BeaconState preset fork)},
      carryBalance a pre = .ok post → ∀ e ∈ post.2, e.source = .slashings → e.creditLimit = 0 := by
    intro a ok'
    simp only [carryBalance, bind_ok_iff, pure, Except.pure, Except.ok.injEq] at ok'
    obtain ⟨_, _, rfl⟩ := ok'
    exact held
  have unchanged : (pure pre : Except TransitionError (BalanceReplay preset fork)) = .ok post →
      ∀ e ∈ post.2, e.source = .slashings → e.creditLimit = 0 := by
    intro ok'
    simp only [pure, Except.pure, Except.ok.injEq] at ok'
    subst ok'
    exact held
  cases k
  case justification =>
    simp only [epochReplayAction] at ok
    exact carried ok
  case inactivity =>
    simp only [epochReplayAction] at ok
    split at ok
    · exact carried ok
    · exact unchanged ok
  case rewards =>
    simp only [epochReplayAction] at ok
    refine replayRewards_induction (config := config)
      (fun p => ∀ e ∈ p.2, e.source = .slashings → e.creditLimit = 0) ?_ ?_ held ok
    · intro pre' post' index reward held' ok'
      simp only [recordBalance, bind_ok_iff, pure, Except.pure, Except.ok.injEq] at ok'
      obtain ⟨_, _, _, _, rfl⟩ := ok'
      intro e member source
      rcases List.mem_append.mp member with old | new
      · exact held' e old source
      · obtain rfl := List.mem_singleton.mp new
        exact absurd source (by simp)
    · intro src pre' post' index penalty pen held' ok'
      simp only [recordBalance, bind_ok_iff, pure, Except.pure, Except.ok.injEq] at ok'
      obtain ⟨_, _, _, _, rfl⟩ := ok'
      intro e member source
      rcases List.mem_append.mp member with old | new
      · exact held' e old source
      · obtain rfl := List.mem_singleton.mp new
        have same : src = .slashings := source
        rcases pen with h | h <;> rw [h] at same <;> cases same
  case registry =>
    simp only [epochReplayAction] at ok
    exact carried ok
  case slashings =>
    simp only [epochReplayAction, recordBalance, bind_ok_iff, pure, Except.pure,
      Except.ok.injEq] at ok
    obtain ⟨⟨credit, debit⟩, limited, after, computed, rfl⟩ := ok
    simp only [Prod.mk.injEq] at limited
    obtain ⟨_, _, zero, _⟩ := limited
    intro e member source
    rcases List.mem_append.mp member with old | new
    · exact held e old source
    · obtain rfl := List.mem_singleton.mp new
      exact zero.symm
  case eth1Reset =>
    simp only [epochReplayAction] at ok
    split at ok
    · exact carried ok
    · exact unchanged ok
  case pendingDeposits | pendingConsolidations =>
    simp only [epochReplayAction] at ok
    split at ok
    · simp only [bind_ok_iff, pure, Except.pure, Except.ok.injEq] at ok
      obtain ⟨_, _, rfl⟩ := ok
      intro e member source
      rcases List.mem_append.mp member with old | new
      · exact held e old source
      · obtain rfl := List.mem_singleton.mp new
        exact absurd source (by simp)
    · exact unchanged ok
  all_goals
    simp only [epochReplayAction] at ok
    exact unchanged ok

/-- A slot step records no slashing event with a credit limit. -/
private theorem slot_slashing_credit {m n : ForkedBeaconState preset}
    {ok : advanceSlotAcross config checks m = .ok n} (early : n.fork < .glamsterdam)
    {events : List (BalanceEvent preset)} (replayed : (Step.slot ok).balanceEvents = .ok events) :
    ∀ e ∈ events, e.source = .slashings → e.creditLimit = 0 := by
  intro e member source
  obtain ⟨advanced, cached, crossings, -, -, -, crossingOk, split⟩ :=
    Step.balanceEvents_slot ok early replayed
  have notCrossing : e ∉ crossings := fun inside => by
    have crossing := upgradeBalanceReplay_crossing crossingOk e inside
    rw [crossing] at source
    cases source
  rcases split with ⟨-, rfl⟩ | ⟨middle, updated, recorded, recordOk, -, -, -, shape, -⟩
  · exact absurd member notCrossing
  · rw [shape] at member
    rcases List.mem_append.mp member with inside | inside
    · exact EpochTrace.induction_on
        (fun _ p => ∀ e ∈ p.2, e.source = .slashings → e.creditLimit = 0)
        (epochBalanceReplay_trace recordOk) (fun e member => by simp at member)
        (fun k _ a b ok held => epochReplayAction_slashing_credit k held ok) e inside source
    · exact absurd inside notCrossing

/-- An event of a block step credits a key only from the sources of `credC`, `whistC` and sync.

A deposit event of a block credits nothing from Electra. -/
private theorem block_event_credit {g : ForkedBeaconState preset} {fork : Fork}
    {s t : BeaconState preset fork} {engine : ExecutionEngine preset fork}
    {signed : SignedBeaconBlock preset fork} {due : upgradeDue config ⟨fork, s⟩ = false}
    {ok : applySignedBlock config checks engine s signed true = .ok t}
    (shared : Run config checks g ⟨fork, s⟩) (genesis : Genesis config checks g)
    (early : fork < .glamsterdam) (electra : .pectra ≤ fork) (i : ℕ)
    {events : List (BalanceEvent preset)}
    (replayed : (Step.block engine signed due ok).balanceEvents = .ok events)
    (bounded : ∀ e ∈ events, e.credits ≤ e.creditLimit) :
    ∀ e ∈ events, keyCredit i e ≤
      (if e.source = .rewards ∨ e.source = .consolidations then keyCredit i e else 0) +
        (if e.source = .slashings then keyCredit i e else 0) + syncCredit i e := by
  intro e member
  obtain ⟨fk, positive⟩ := Step.balanceEvents_credit_sources
    (Step.block engine signed due ok) early (run_justified_separated shared genesis).1
    replayed e member
  have limit := keyCredit_le_creditLimit i e (bounded e member)
  by_cases rc : e.source = .rewards ∨ e.source = .consolidations
  · simp only [rc, ↓reduceIte]
    omega
  by_cases sl : e.source = .slashings
  · simp [sl]
  by_cases sy : e.source = .sync
  · simp [sy, syncCredit, keyCredit]
  have zero : e.creditLimit = 0 := by
    by_contra pos
    rcases positive (Nat.pos_of_ne_zero pos) with h | h | h | h | h
    · exact rc (.inl h)
    · exact sy h
    · exact sl h
    · exact pos (funding_block_events (config := config) (checks := checks) early engine
        signed.message (Step.balanceEvents_block early replayed) e member h
        (Nat.le_trans electra fk))
    · exact rc (.inr h)
  simp only [rc, sl, ↓reduceIte]
  omega

/-- An event of a slot step, but for the epoch rewards, credits a key only from `credC` and sync. -/
private theorem slot_event_credit {g m n : ForkedBeaconState preset}
    {ok : advanceSlotAcross config checks m = .ok n}
    (shared : Run config checks g m) (genesis : Genesis config checks g)
    (early : n.fork < .glamsterdam) (i : ℕ) {events : List (BalanceEvent preset)}
    (replayed : (Step.slot ok).balanceEvents = .ok events)
    (bounded : ∀ e ∈ events, e.credits ≤ e.creditLimit) :
    ∀ e ∈ events, e.source ≠ .rewards → keyCredit i e ≤
      (if e.source = .consolidations ∨ e.source = .deposits then keyCredit i e else 0) +
        syncCredit i e := by
  intro e member notRewards
  obtain ⟨-, positive⟩ := Step.balanceEvents_credit_sources (Step.slot ok) early
    (run_justified_separated shared genesis).1 replayed e member
  have limit := keyCredit_le_creditLimit i e (bounded e member)
  by_cases cd : e.source = .consolidations ∨ e.source = .deposits
  · simp [cd]
  by_cases sy : e.source = .sync
  · simp [sy, syncCredit, keyCredit]
  have zero : e.creditLimit = 0 := by
    by_contra pos
    rcases positive (Nat.pos_of_ne_zero pos) with h | h | h | h | h
    · exact notRewards h
    · exact sy h
    · exact pos (slot_slashing_credit early replayed e member h)
    · exact cd (.inr h)
    · exact cd (.inl h)
  simp only [cd, ↓reduceIte]
  omega

/-- A bound for each selected event gives the bound for the sums of the credits that it splits. -/
private theorem sum_credits_split (events : List (BalanceEvent preset))
    (f g : BalanceEvent preset → ℕ) (r p q : BalanceSource → Bool)
    (each : ∀ e ∈ events, r e.source = true →
      f e ≤ (if p e.source = true then f e else 0) + (if q e.source = true then f e else 0) +
        g e) :
    ((events.filter (r ·.source)).map f).sum ≤ ((events.filter (p ·.source)).map f).sum +
      ((events.filter (q ·.source)).map f).sum + (events.map g).sum := by
  have ite (p : BalanceSource → Bool) : ((events.filter (p ·.source)).map f).sum =
      (events.map fun e => if p e.source = true then f e else 0).sum := by
    rw [List.sum_map_ite (fun e : BalanceEvent preset => p e.source = true) f (fun _ => 0)]
    simp
  rw [ite, ite, ite, ← List.sum_map_add, ← List.sum_map_add]
  refine List.sum_le_sum fun e member => ?_
  by_cases hr : r e.source = true
  · simp only [hr, ↓reduceIte]
    exact each e member hr
  · simp only [hr]
    exact Nat.zero_le _

/-- A filter that selects no event sums to zero. -/
private theorem sum_filter_none (events : List (BalanceEvent preset))
    (f : BalanceEvent preset → ℕ) :
    ((events.filter fun _ => false).map f).sum = 0 := by
  induction events with
  | nil => rfl
  | cons e rest ih => simp

/-- The credits of a block step to a key are within those of `credC`, `whistC` and sync. -/
private theorem block_credit_split {g : ForkedBeaconState preset} {fork : Fork}
    {s t : BeaconState preset fork} {engine : ExecutionEngine preset fork}
    {signed : SignedBeaconBlock preset fork} {due : upgradeDue config ⟨fork, s⟩ = false}
    {ok : applySignedBlock config checks engine s signed true = .ok t}
    (shared : Run config checks g ⟨fork, s⟩) (genesis : Genesis config checks g)
    (early : fork < .glamsterdam) (electra : .pectra ≤ fork) (i : ℕ)
    {events : List (BalanceEvent preset)}
    (replayed : (Step.block engine signed due ok).balanceEvents = .ok events)
    (bounded : ∀ e ∈ events, e.credits ≤ e.creditLimit) :
    (events.map (keyCredit i)).sum ≤
      ((events.filter fun x => decide (x.source = .rewards ∨ x.source = .consolidations)).map
        (keyCredit i)).sum +
      ((events.filter fun x => decide (x.source = .slashings)).map (keyCredit i)).sum +
      (events.map (syncCredit i)).sum := by
  have each := block_event_credit shared genesis early electra i replayed bounded
  simpa using sum_credits_split events (keyCredit i) (syncCredit i) (fun _ => true)
    (fun s => decide (s = .rewards ∨ s = .consolidations)) (fun s => decide (s = .slashings))
    (fun e m _ => by simpa using each e m)

/-- The slot credits of a step to a key, other than rewards, fit consolidations, deposits, sync. -/
private theorem slot_credit_split {g m n : ForkedBeaconState preset}
    {ok : advanceSlotAcross config checks m = .ok n}
    (shared : Run config checks g m) (genesis : Genesis config checks g)
    (early : n.fork < .glamsterdam) (i : ℕ) {events : List (BalanceEvent preset)}
    (replayed : (Step.slot ok).balanceEvents = .ok events)
    (bounded : ∀ e ∈ events, e.credits ≤ e.creditLimit) :
    ((events.filter fun x => decide (x.source ≠ .rewards)).map (keyCredit i)).sum ≤
      ((events.filter fun x => decide (x.source = .consolidations ∨ x.source = .deposits)).map
        (keyCredit i)).sum +
      ((events.filter fun _ => false).map (keyCredit i)).sum + (events.map (syncCredit i)).sum := by
  have each := slot_event_credit shared genesis early i replayed bounded
  exact sum_credits_split events (keyCredit i) (syncCredit i)
    (fun s => decide (s ≠ .rewards)) (fun s => decide (s = .consolidations ∨ s = .deposits))
    (fun _ => false) (fun e m notRewards => by simpa using each e m (by simpa using notRewards))

/-- The events of a step are within their credit limits. -/
private theorem step_events_bounded {g m n : ForkedBeaconState preset}
    (shared : Run config checks g m) (genesis : Genesis config checks g)
    (step : Step config checks m n) (early : n.fork < .glamsterdam)
    {events : List (BalanceEvent preset)} (ok : step.balanceEvents = .ok events) :
    ∀ e ∈ events, e.credits ≤ e.creditLimit := by
  have run := DirectSafety.Apriori.Internal.single_balanceEvents step ok
  obtain ⟨found, foundOk, bounded⟩ := Run.balanceEvents_bounded shared (Run.nil.snoc step)
    genesis early (getCurrentEpoch n.state).toNat
  rw [run] at foundOk
  cases foundOk
  exact fun e member => (bounded e member).1

/-- The credits of a block step to a key are at most those of `credC`, `whistC` and sync. -/
private theorem block_credit_le_sources {g m n : ForkedBeaconState preset}
    (shared : Run config checks g m) (genesis : Genesis config checks g)
    (step : Step config checks m n) (notSlot : ∀ ok, step ≠ Step.slot ok)
    (early : n.fork < .glamsterdam) (electra : .pectra ≤ m.fork) (i : ℕ)
    {events : List (BalanceEvent preset)} (replayed : step.balanceEvents = .ok events) :
    stepCredit (fun _ => true) (fun _ => true) i step ≤
      stepCredit (fun s => decide (s = .rewards ∨ s = .consolidations))
        (fun s => decide (s = .consolidations ∨ s = .deposits)) i step +
      stepCredit (fun s => decide (s = .slashings)) (fun _ => false) i step +
      (events.map (syncCredit i)).sum := by
  have bounded := step_events_bounded shared genesis step early replayed
  cases step with
  | block engine signed due ok =>
    have split := block_credit_split shared genesis early electra i replayed bounded
    simp only [stepCredit, replayed, Except.toOption, Option.getD_some, List.filter_true] at split ⊢
    exact split
  | slot ok => exact absurd rfl (notSlot ok)

/-- The credits of a block step to a key are at most its gross credits.

A block step has no consolidation event, and its other sources credit nothing.

The step counts all its credits on the left.

On the right it counts only those of rewards, slashings and sync. -/
private theorem block_credit_le_gross {g : ForkedBeaconState preset} {f : Fork}
    {s t : BeaconState preset f} {engine : ExecutionEngine preset f}
    {signed : SignedBeaconBlock preset f} {due : upgradeDue config ⟨f, s⟩ = false}
    {ok : applySignedBlock config checks engine s signed true = .ok t}
    (shared : Run config checks g ⟨f, s⟩) (genesis : Genesis config checks g)
    (early : f < .glamsterdam) (electra : .pectra ≤ f) (i : ℕ) :
    stepCredit (fun _ => true) (fun _ => true) i (Step.block engine signed due ok) ≤
      stepCredit (fun s => decide (s = .rewards ∨ s = .slashings ∨ s = .sync)) (fun _ => false) i
        (Step.block engine signed due ok) := by
  obtain ⟨events, replayed⟩ := (Step.block engine signed due ok :
    Step config checks ⟨f, s⟩ ⟨f, t⟩).balanceEvents_ok early
  have bounded := step_events_bounded shared genesis (Step.block engine signed due ok) early
    replayed
  have noCons := blockReplay_noConsolidations electra early engine s signed.message
    (Step.balanceEvents_block early replayed)
  have split : (events.map (keyCredit i)).sum ≤ ((events.filter fun e => decide
      (e.source = .rewards ∨ e.source = .slashings ∨ e.source = .sync)).map (keyCredit i)).sum := by
    simpa using sum_credits_split events (keyCredit i) (fun _ => 0) (fun _ => true)
      (fun s => decide (s = .rewards ∨ s = .slashings ∨ s = .sync)) (fun _ => false)
      fun e member _ => by
        have each := block_event_credit shared genesis early electra i replayed bounded e member
        by_cases kept : e.source = .rewards ∨ e.source = .slashings ∨ e.source = .sync
        · simp [kept]
        · simp only [not_or] at kept
          simp [kept.1, kept.2.1, kept.2.2, noCons e member, syncCredit] at each ⊢
          omega
  simp only [stepCredit, replayed, Except.toOption, Option.getD_some]
  simpa using split

/-- A block step raises the balance of a key by at most its gross credits. -/
private theorem block_balance_le_gross {g : ForkedBeaconState preset} {f : Fork}
    {s t : BeaconState preset f} {engine : ExecutionEngine preset f}
    {signed : SignedBeaconBlock preset f} {due : upgradeDue config ⟨f, s⟩ = false}
    {ok : applySignedBlock config checks engine s signed true = .ok t}
    (shared : Run config checks g ⟨f, s⟩) (genesis : Genesis config checks g)
    (early : f < .glamsterdam) (electra : .pectra ≤ f) (i : ℕ) :
    actualBalanceAt (⟨f, t⟩ : ForkedBeaconState preset) i ≤
      actualBalanceAt (⟨f, s⟩ : ForkedBeaconState preset) i + stepCredit
        (fun s => decide (s = .rewards ∨ s = .slashings ∨ s = .sync)) (fun _ => false) i
        (Step.block engine signed due ok) := by
  obtain ⟨events, replayed⟩ := (Step.block engine signed due ok :
    Step config checks ⟨f, s⟩ ⟨f, t⟩).balanceEvents_ok early
  have base := PinKeyFloor.step_balance_le_events (Step.block engine signed due ok :
    Step config checks ⟨f, s⟩ ⟨f, t⟩) early i replayed
  have credit := block_credit_le_gross (due := due) (ok := ok) shared genesis early electra i
  simp only [stepCredit, replayed, Except.toOption, Option.getD_some, List.filter_true] at credit ⊢
  omega

/-- The credits of a step, net for a block step, are at most those of `credC`, `whistC` and sync. -/
private theorem step_credit_le_sources {g m n : ForkedBeaconState preset}
    (shared : Run config checks g m) (genesis : Genesis config checks g)
    (step : Step config checks m n) (early : n.fork < .glamsterdam) (electra : .pectra ≤ m.fork)
    (i : ℕ) {events : List (BalanceEvent preset)} (replayed : step.balanceEvents = .ok events) :
    stepNet i step + stepCredit (fun _ => false) (fun s => decide (s ≠ .rewards)) i step ≤
      stepCredit (fun s => decide (s = .rewards ∨ s = .consolidations))
        (fun s => decide (s = .consolidations ∨ s = .deposits)) i step +
      stepCredit (fun s => decide (s = .slashings)) (fun _ => false) i step +
      (events.map (syncCredit i)).sum := by
  have bounded := step_events_bounded shared genesis step early replayed
  have base := PinKeyFloor.step_balance_le_events step early i replayed
  cases step with
  | block engine signed due ok =>
    have split := block_credit_le_sources shared genesis (Step.block engine signed due ok)
      (by intro ok' h; cases h) early electra i replayed
    simp only [stepNet, stepCredit, replayed, Except.toOption, Option.getD_some,
      sum_filter_none, List.filter_true] at base split ⊢
    omega
  | slot ok =>
    have split := slot_credit_split shared genesis early i replayed bounded
    simp only [stepNet, stepCredit, replayed, Except.toOption, Option.getD_some,
      sum_filter_none] at split ⊢
    omega

/-- The gross credits of a step, with its slot credits other than rewards, are within the sources.

The sources are `credC`, `whistC` and sync.

A block step's net rise is within its gross credits.

Its slot credits other than rewards are at most those of consolidations and deposits. -/
private theorem step_gross_le_sources {g m n : ForkedBeaconState preset}
    (shared : Run config checks g m) (genesis : Genesis config checks g)
    (step : Step config checks m n) (early : n.fork < .glamsterdam) (electra : .pectra ≤ m.fork)
    (i : ℕ) {events : List (BalanceEvent preset)} (replayed : step.balanceEvents = .ok events) :
    stepCredit (fun s => decide (s = .rewards ∨ s = .slashings ∨ s = .sync)) (fun _ => false) i
        step + stepCredit (fun _ => false) (fun s => decide (s ≠ .rewards)) i step ≤
      stepCredit (fun s => decide (s = .rewards ∨ s = .consolidations))
        (fun s => decide (s = .consolidations ∨ s = .deposits)) i step +
      stepCredit (fun s => decide (s = .slashings)) (fun _ => false) i step +
      (events.map (syncCredit i)).sum ∧
    stepNet i step ≤ stepCredit
      (fun s => decide (s = .rewards ∨ s = .slashings ∨ s = .sync)) (fun _ => false) i step ∧
    stepCredit (fun _ => false) (fun s => decide (s ≠ .rewards)) i step ≤
      stepCredit (fun _ => false)
        (fun s => decide (s = .consolidations ∨ s = .deposits)) i step := by
  have bounded := step_events_bounded shared genesis step early replayed
  cases step with
  | block engine signed due ok =>
    have split := block_credit_split shared genesis early electra i replayed bounded
    have gross := block_balance_le_gross (engine := engine) (signed := signed) (due := due)
      (ok := ok) shared genesis early electra i
    have part : ((events.filter fun x => decide
        (x.source = .rewards ∨ x.source = .slashings ∨ x.source = .sync)).map (keyCredit i)).sum ≤
        (events.map (keyCredit i)).sum :=
      (((List.filter_sublist).map _).sum_le_sum fun _ _ => Nat.zero_le _)
    simp only [stepNet, stepCredit, replayed, Except.toOption, Option.getD_some,
      sum_filter_none] at gross part split ⊢
    omega
  | slot ok =>
    have split := slot_credit_split shared genesis early i replayed bounded
    have zero := (PinSeatDebits.slot_syncDebit_zero electra ok early replayed i).2
    simp only [stepNet, stepCredit, replayed, Except.toOption, Option.getD_some,
      sum_filter_none] at split ⊢
    omega

/-- The credits of a run, gross for its block steps, are at most those of `credC`, `whistC`, sync.

A block step's net rise is within its gross credits, so the net credits of the run are too.

Its slot credits other than epoch rewards are at most those of consolidations and deposits. -/
private theorem credits_le_sources {g x y : ForkedBeaconState preset}
    (shared : Run config checks g x) (genesis : Genesis config checks g)
    (tail : Run config checks x y) (early : y.fork < .glamsterdam) (electra : .pectra ≤ x.fork)
    (i high : ℕ) {events : List (BalanceEvent preset)}
    (replayed : tail.balanceEvents high = .ok events) :
    grossScan i high tail + (creditScan (fun _ => false) (fun s => decide (s ≠ .rewards)) i high
      tail) ≤ credC tail high i + whistC tail high i + (events.map (syncCredit i)).sum ∧
    netScan i high tail ≤ grossScan i high tail ∧
    (creditScan (fun _ => false) (fun s => decide (s ≠ .rewards)) i high tail) ≤
      (creditScan (fun _ => false)
        (fun s => decide (s = .consolidations ∨ s = .deposits)) i high tail) := by
  induction tail generalizing events with
  | nil =>
    simp only [Run.balanceEvents, pure, Except.pure, Except.ok.injEq] at replayed
    subst replayed
    simp [credC, whistC, grossScan, netScan_nil, creditScan_nil]
  | @snoc middle last pre step ih =>
    simp only [Run.balanceEvents, bind_ok_iff] at replayed
    obtain ⟨prior, priorOk, rest⟩ := replayed
    obtain ⟨previous, previousNet, previousSlot⟩ :=
      ih (Nat.lt_of_le_of_lt step.chainStep.fork_le early) priorOk
    by_cases selected : (getCurrentEpoch middle.state).toNat ≤ high + 1
    · simp only [selected, ↓reduceIte, bind_ok_iff, pure, Except.pure, Except.ok.injEq] at rest
      obtain ⟨added, addedOk, rfl⟩ := rest
      obtain ⟨one, oneNet, oneSlot⟩ := step_gross_le_sources (shared.append pre) genesis step early
        (Nat.le_trans electra (fork_le_of_chainSteps pre.chainSteps)) i addedOk
      unfold credC whistC grossScan at previous ⊢
      unfold grossScan at previousNet
      simp only [netScan_snoc, creditScan_snoc, selected, ↓reduceIte, List.map_append,
        List.sum_append]
      exact ⟨by omega, by omega, by omega⟩
    · simp only [selected, ↓reduceIte, pure, Except.pure, Except.ok.injEq] at rest
      obtain rfl := rest
      unfold credC whistC grossScan at previous ⊢
      unfold grossScan at previousNet
      simp only [netScan_snoc, creditScan_snoc, selected, ↓reduceIte]
      exact ⟨previous, previousNet, previousSlot⟩

/-- The credits of a switch step, whole, and of the runs around it are at most the sources.

The credits before the step are read net, and then gross. -/
private theorem flip_credits_le_sources {g x s s' y : ForkedBeaconState preset}
    (shared : Run config checks g x) (genesis : Genesis config checks g)
    (pre : Run config checks x s) (step : Step config checks s s') (post : Run config checks s' y)
    (notSlot : ∀ ok, step ≠ Step.slot ok) (early : y.fork < .glamsterdam)
    (electra : .pectra ≤ x.fork) (i high : ℕ) (inside : (getCurrentEpoch s.state).toNat ≤ high + 1)
    {events : List (BalanceEvent preset)}
    (replayed : ((pre.snoc step).append post).balanceEvents high = .ok events) :
    (netScan i high pre + (creditScan (fun _ => false) (fun s => decide (s ≠ .rewards)) i high
        pre) + stepCredit (fun _ => true) (fun _ => true) i step +
      (netScan i high post + (creditScan (fun _ => false) (fun s => decide (s ≠ .rewards)) i high
        post)) ≤ credC ((pre.snoc step).append post) high i +
      whistC ((pre.snoc step).append post) high i + (events.map (syncCredit i)).sum) ∧
    (grossScan i high pre + (creditScan (fun _ => false) (fun s => decide (s ≠ .rewards)) i high
        pre) + stepCredit (fun _ => true) (fun _ => true) i step +
      (netScan i high post + (creditScan (fun _ => false) (fun s => decide (s ≠ .rewards)) i high
        post)) ≤ credC ((pre.snoc step).append post) high i +
      whistC ((pre.snoc step).append post) high i + (events.map (syncCredit i)).sum) := by
  have s'Early : s'.fork < .glamsterdam :=
    Nat.lt_of_le_of_lt (fork_le_of_chainSteps post.chainSteps) early
  have sEarly : s.fork < .glamsterdam := Nat.lt_of_le_of_lt step.chainStep.fork_le s'Early
  obtain ⟨e1, replayed1⟩ := pre.balanceEvents_ok sEarly high
  obtain ⟨es, replayedS⟩ := step.balanceEvents_ok s'Early
  obtain ⟨e2, replayed2⟩ := post.balanceEvents_ok early high
  have snoc : (pre.snoc step).balanceEvents high = .ok (e1 ++ es) := by
    simp [Run.balanceEvents, replayed1, replayedS, inside]
    rfl
  have whole := DirectSafety.Apriori.Internal.balanceEvents_append (pre.snoc step) post high snoc
    replayed2
  rw [whole] at replayed
  obtain rfl := Except.ok.inj replayed
  have first := credits_le_sources shared genesis pre sEarly electra i high replayed1
  have last := credits_le_sources (shared.append (pre.snoc step)) genesis post early
    (Nat.le_trans electra (fork_le_of_chainSteps (pre.snoc step).chainSteps)) i high replayed2
  have middle := block_credit_le_sources (shared.append pre) genesis step notSlot s'Early
    (Nat.le_trans electra (fork_le_of_chainSteps pre.chainSteps)) i replayedS
  unfold credC whistC
  rw [creditScan_append, creditScan_append, creditScan_snoc, creditScan_snoc]
  simp only [inside, ↓reduceIte]
  unfold credC whistC at first last
  simp only [List.map_append, List.sum_append] at first last ⊢
  exact ⟨by omega, by omega⟩

/-- The key's effective balance when its exit starts on a run, or 0.

It is the amount of the key's departure charge, which reads the effective balance at the exit call.

A key has a charge only if its exit was not assigned at the run's start.

Only a charge whose exit epoch is at most the run's last epoch counts. -/
private def exitQ {x y : ForkedBeaconState preset} (tail : Run config checks x y) (v : ℕ) : ℕ :=
  ((tail.departureCharges.find? fun c =>
      c.index == v && decide (c.epoch ≤ (getCurrentEpoch y.state).toNat)).map (·.amount)).getD 0

/-- Whether a run has the key's departure charge, and the epoch rewards of the steps from it on.

The step with the charge counts too, since the key's epoch pass in it follows its exit.

The steps count from the one whose start epoch is at most `high + 1`, as in `Run.balanceEvents`. -/
private def riseScan (v high : ℕ) {x : ForkedBeaconState preset} :
    {y : ForkedBeaconState preset} → Run config checks x y → Bool × ℕ
  | _, .nil => (false, 0)
  | _, .snoc (middle := m) pre step =>
    let before := riseScan v high pre
    (before.1 || step.departureCharges.any (·.index == v),
      if (before.1 = true ∨ step.departureCharges.any (·.index == v) = true) ∧
          (getCurrentEpoch m.state).toNat ≤ high + 1 then
        before.2 + PinKeyFloor.epochRewards v step
      else before.2)

/-- The key's rise on a run after its exit starts there.

It is one upward band for the rise of the effective balance beyond the key's epoch rewards.

It adds those rewards over the slot steps that come after the step with its departure charge.

It is 0 for a key whose exit does not start on the run. -/
private def riseQ {x y : ForkedBeaconState preset} (tail : Run config checks x y)
    (high v : ℕ) : ℕ :=
  if (riseScan v high tail).1 = true then preset.upwardBand + (riseScan v high tail).2 else 0

/-! ### The keys that a run credits -/

/-- The net credits to a key in the block steps of a run add over `append`. -/
private theorem netScan_append (v high : ℕ) {x m y : ForkedBeaconState preset}
    (pre : Run config checks x m) (post : Run config checks m y) :
    netScan v high (pre.append post) = netScan v high pre + netScan v high post := by
  induction post with
  | nil => rfl
  | snoc post step ih =>
    change netScan v high ((pre.append post).snoc step) = _
    rw [netScan_snoc, netScan_snoc, ih]
    split <;> omega

/-- A key keeps its public key at its position along a run. -/
private theorem key_persists {x y : ForkedBeaconState preset} (run : Run config checks x y)
    {i : ℕ} {w : Validator} (found : x.state.validators.data[i]? = some w) :
    ∃ w', y.state.validators.data[i]? = some w' ∧ w'.pubkey = w.pubkey :=
  validators_getElem?_of_validatorKeys_prefix
    (validatorKeys_prefix_and_distinct_of_chainSteps run.chainSteps).1 found

/-- A sync aggregate changes the balance of a position only if its key is in the committee.

The position is then the one of a validator that holds a seat, which the committee keeps.

Otherwise the position is the proposer's, and its balance rises. -/
private theorem sync_moved_seat {f : Fork} {c t : BeaconState preset f} (altair : .altair ≤ f)
    {aggregate : SyncAggregate preset}
    (synced : processSyncAggregate config checks c altair aggregate = .ok t)
    (matched : BalancesMatch t) {i : ℕ}
    (moved : actualBalanceAt (⟨f, t⟩ : ForkedBeaconState preset) i ≠
      actualBalanceAt (⟨f, c⟩ : ForkedBeaconState preset) i) :
    (∃ w, t.validators.data[i]? = some w ∧
      w.pubkey ∈ (t.currentSyncCommittee altair).value.pubkeys.toList) ∨
    ∃ proposer, getBeaconProposerIndex c = .ok proposer ∧ proposer.toNat = i ∧
      actualBalanceAt (⟨f, c⟩ : ForkedBeaconState preset) i <
        actualBalanceAt (⟨f, t⟩ : ForkedBeaconState preset) i := by
  obtain ⟨vals, comm⟩ := BlockLedger.processSyncAggregate_kept synced
  have sizes := sameSizes_processSyncAggregate synced
  have matchedC : BalancesMatch c := by
    unfold BalancesMatch at matched ⊢
    rw [← sizes.1, ← sizes.2]
    exact matched
  have inside : i < c.balances.data.size := by
    by_contra outside
    have missing : actualBalanceAt (⟨f, c⟩ : ForkedBeaconState preset) i = 0 := by
      simp [actualBalanceAt, Array.getElem?_eq_none (Nat.le_of_not_lt outside)]
    have outT : t.balances.data[i]? = none :=
      Array.getElem?_eq_none (by have := sizes.2; omega)
    have missingT : actualBalanceAt (⟨f, t⟩ : ForkedBeaconState preset) i = 0 := by
      simp [actualBalanceAt, outT]
    omega
  have insideV : i < c.validators.data.size := by
    unfold BalancesMatch at matchedC
    omega
  obtain ⟨w, found⟩ : ∃ w, c.validators.data[i]? = some w :=
    ⟨_, Array.getElem?_eq_getElem insideV⟩
  have foundT : t.validators.data[i]? = some w := by rw [vals]; exact found
  by_cases seat : w.pubkey ∈ (t.currentSyncCommittee altair).value.pubkeys.toList
  · exact .inl ⟨w, foundT, seat⟩
  refine .inr ?_
  have unseated : w.pubkey ∉ (c.currentSyncCommittee altair).value.pubkeys.toList := by
    rw [← congrFun comm altair]
    exact seat
  obtain ⟨reward, proposerReward, members, chosen, -, -, membersOk, signed, balances⟩ :=
    processSyncAggregate_balance synced
  have seatless : ∀ member ∈ (members.zip aggregate.syncCommitteeBits.bits.toArray).toList,
      member.1.toNat ≠ i := signers_elsewhere_of_unseated membersOk found unseated
  obtain ⟨b, held⟩ : ∃ b, c.balances.data[i]? = some b :=
    ⟨_, Array.getElem?_eq_getElem inside⟩
  obtain ⟨final, atFinal, value⟩ := balances i b held
  have low := (syncRewards_bounds (reward := reward.toNat)
    (proposerReward := proposerReward.toNat) (index := i) (chosen := chosen) _ b.toNat).2
    (fun member inside _ => seatless member inside)
  rw [← value] at low
  simp only [actualBalanceAt, held, atFinal, Option.map_some, Option.getD_some] at moved ⊢
  by_cases signer : ∃ member ∈ (members.zip aggregate.syncCommitteeBits.bits.toArray).toList,
      member.2 = true ∧ chosen.toNat = i
  · obtain ⟨member, inside, signedBit, same⟩ := signer
    exact ⟨chosen, signed ⟨member, inside, signedBit⟩, same, by omega⟩
  · exfalso
    have high := (syncRewards_bounds (reward := reward.toNat)
      (proposerReward := proposerReward.toNat) (index := i) (chosen := chosen) _ b.toNat).1
      (fun member inside bit => ⟨seatless member inside,
        fun same => signer ⟨member, inside, bit, same⟩⟩)
    rw [← value] at high
    omega

/-- A sync aggregate lowers the balance of a position only if its key is in the committee.

The position is then the one of a validator that holds a seat, which the committee keeps. -/
private theorem sync_debit_seat {f : Fork} {c t : BeaconState preset f} (altair : .altair ≤ f)
    {aggregate : SyncAggregate preset}
    (synced : processSyncAggregate config checks c altair aggregate = .ok t)
    (matched : BalancesMatch t) {i : ℕ}
    (lowered : actualBalanceAt (⟨f, t⟩ : ForkedBeaconState preset) i <
      actualBalanceAt (⟨f, c⟩ : ForkedBeaconState preset) i) :
    ∃ w, t.validators.data[i]? = some w ∧
      w.pubkey ∈ (t.currentSyncCommittee altair).value.pubkeys.toList := by
  rcases sync_moved_seat altair synced matched (Nat.ne_of_lt lowered) with seat | ⟨_, _, _, risen⟩
  · exact seat
  · omega

/-- The events of a block's passes credit no key but the proposer, from the sources that matter.

None of them has a sync or consolidation source.

A rewards or slashings event credits only the proposer. -/
private def PassCredits (proposer : ℕ) (events : List (BalanceEvent preset)) : Prop :=
  ∀ e ∈ events, e.source ≠ .sync ∧ e.source ≠ .consolidations ∧
    ((e.source = .rewards ∨ e.source = .slashings) →
      ∀ i, proposer ≠ i → keyCredit i e = 0)

/-- A carried pass records nothing. -/
private theorem PassCredits.carry {f : Fork} {proposer : ℕ}
    {action : BeaconState preset f → Except TransitionError (BeaconState preset f)}
    {pre post : BalanceReplay preset f} (held : PassCredits proposer pre.2)
    (ok : carryBalance action pre = .ok post) : PassCredits proposer post.2 := by
  rw [(PinEventsKept.carryBalance_cases ok).2]
  exact held

/-- A recorded pass adds an event.

A rewards or slashings event credits only the proposer. -/
private theorem PassCredits.record {f : Fork} {proposer : ℕ} {source : BalanceSource}
    {limits : BeaconState preset f → Except TransitionError (Nat × Nat)}
    {action : BeaconState preset f → Except TransitionError (BeaconState preset f)}
    {pre post : BalanceReplay preset f} (held : PassCredits proposer pre.2)
    (ok : recordBalance source limits action pre = .ok post)
    (notSync : source ≠ .sync) (notConsolidation : source ≠ .consolidations)
    (lowered : (source = .rewards ∨ source = .slashings) → ∀ t, action pre.1 = .ok t →
      ∀ i, proposer ≠ i →
        actualBalanceAt (⟨f, t⟩ : ForkedBeaconState preset) i ≤
          actualBalanceAt (⟨f, pre.1⟩ : ForkedBeaconState preset) i) :
    PassCredits proposer post.2 := by
  simp only [recordBalance, bind_ok_iff, pure, Except.pure, Except.ok.injEq] at ok
  obtain ⟨⟨credit, debit⟩, _, t, computed, rfl⟩ := ok
  intro e member
  rcases List.mem_append.mp member with old | new
  · exact held e old
  · obtain rfl := List.mem_singleton.mp new
    exact ⟨notSync, notConsolidation, fun source i other =>
      Nat.sub_eq_zero_of_le (lowered source t computed i other)⟩

/-- A pass that does not lower a balance, and keeps the sizes, does not raise it. -/
private theorem actualBalanceAt_le_of_down {f : Fork} {s u : BeaconState preset f}
    (sizes : SameSizes s u) {i : ℕ} (down : BalanceDown i s u) :
    actualBalanceAt (⟨f, u⟩ : ForkedBeaconState preset) i ≤
      actualBalanceAt (⟨f, s⟩ : ForkedBeaconState preset) i := by
  by_cases inside : i < s.balances.data.size
  · obtain ⟨b, held⟩ : ∃ b, s.balances.data[i]? = some b :=
      ⟨_, Array.getElem?_eq_getElem inside⟩
    obtain ⟨later, found, le⟩ := down b held
    simp only [actualBalanceAt, held, found, Option.map_some, Option.getD_some]
    exact UInt64.le_iff_toNat_le.mp le
  · have outS : s.balances.data[i]? = none := Array.getElem?_eq_none (Nat.le_of_not_lt inside)
    have outU : u.balances.data[i]? = none :=
      Array.getElem?_eq_none (by have := sizes.2; omega)
    simp [actualBalanceAt, outS, outU]

/-- The replay of a block ends with its sync pass, after passes that credit only its proposer.

The proposer of the block is the one that the state before the sync pass reads.

The other passes record events that `PassCredits` describes.

The mixes must span more than the seed lookahead plus two epochs. -/
private theorem blockReplay_proposer_credits {fork : Fork} {a t : BeaconState preset fork}
    (apart : preset.MIN_SEED_LOOKAHEAD.toNat + 2 < preset.EPOCHS_PER_HISTORICAL_VECTOR.toNat)
    (electra : .pectra ≤ fork) (early : fork < .glamsterdam)
    {engine : ExecutionEngine preset fork} {block : BeaconBlock preset fork}
    {events : List (BalanceEvent preset)}
    (replay : blockBalanceReplay (config := config) (checks := checks) early engine a block =
      .ok (t, events)) :
    ∃ (c : BeaconState preset fork) (rest : List (BalanceEvent preset)) (altair : .altair ≤ fork)
      (aggregate : SyncAggregate preset) (credit debit : ℕ),
      events = rest ++ [⟨.sync, ⟨fork, c⟩, ⟨fork, t⟩, credit, debit⟩] ∧
      getBeaconProposerIndex c = .ok block.proposerIndex ∧
      processSyncAggregate config checks c altair aggregate = .ok t ∧
      PassCredits block.proposerIndex.toNat rest ∧
      getBeaconProposerIndex a = .ok block.proposerIndex := by
  have altair : .altair ≤ fork := Nat.le_trans (by decide) electra
  have bellatrix : .bellatrix ≤ fork := Nat.le_trans (by decide) electra
  have before : fork < .hegota := Nat.lt_trans early (by decide)
  have notGloas : ¬ .glamsterdam ≤ fork := Nat.not_le_of_lt early
  have normalized := replay
  unfold blockBalanceReplay at normalized
  simp only [altair, bellatrix, electra, ↓reduceDIte] at normalized
  simp only [← bind_assoc] at normalized
  simp only [bind_assoc] at normalized
  simp only [bind_ok_iff, ensure_ok_iff] at normalized
  obtain ⟨headed, headedOk, executed, executedOk, revealed, revealedOk, voted, votedOk, x1, x2, x3,
    x4, proposed, proposedOk, slashed, slashedOk, attested, attestedOk, deposited, depositedOk,
    exited, exitedOk, changed, changedOk, requested, requestedOk, withdrawn, withdrawnOk,
    consolidated, consolidatedOk, syncOk⟩ := normalized
  -- The proposer of the block is read at the state before its operations.
  have headerOk : processBlockHeader a block = .ok headed.1 :=
    (PinEventsKept.carryBalance_cases headedOk).1
  have input : OperationsInput config checks engine a block voted.1 :=
    ⟨a, headed.1, executed.1, revealed.1, by simp [notGloas, pure, Except.pure], headerOk,
      by simpa only [bellatrix, ↓reduceDIte] using (PinEventsKept.recordBalance_cases executedOk).1,
      (PinEventsKept.carryBalance_cases revealedOk).1,
      by simpa only [before, ↓reduceDIte] using (PinEventsKept.carryBalance_cases votedOk).1⟩
  have read := (operationsInput_proposer apart input).1
  -- The operations apply the actions of the replay in order, so they keep that proposer.
  have operated : processOperations config checks voted.1 block.body a.latestBlockHeader.slot =
      .ok consolidated.1 := by
    have pOk := DirectSafety.Apriori.Internal.recordFold_plain _ _ _ _ _ proposedOk
    have sOk := DirectSafety.Apriori.Internal.recordFold_plain _ _ _ _ _ slashedOk
    have aOk := DirectSafety.Apriori.Internal.recordFold_plain _ _ _ _ _ attestedOk
    have dOk := DirectSafety.Apriori.Internal.recordFold_plain _ _ _ _ _ depositedOk
    have cOk := DirectSafety.Apriori.Internal.recordFold_plain _ _ _ _ _ consolidatedOk
    simp only [Array.foldlM_toList] at pOk sOk aOk dOk cOk
    unfold processOperations
    simp only [notGloas, electra, ↓reduceDIte, bind_ok_iff, ensure_ok_iff, processExecutionRequests]
    exact ⟨x1, x2, x3, x4, proposed.1, pOk, slashed.1, sOk, attested.1, aOk, deposited.1, dOk,
      exited.1, (PinEventsKept.carryBalance_cases exitedOk).1, changed.1,
      (PinEventsKept.carryBalance_cases changedOk).1, requested.1,
      (PinEventsKept.carryBalance_cases requestedOk).1, withdrawn.1,
      (PinEventsKept.carryBalance_cases withdrawnOk).1, cOk⟩
  have link := (processOperations_proposer apart operated).1.trans read
  -- The passes before the operations record no credit but the proposer's.
  have base : PassCredits block.proposerIndex.toNat ([] : List (BalanceEvent preset)) :=
    fun e member => by simp at member
  have start : PassCredits block.proposerIndex.toNat voted.2 :=
    (((base.carry headedOk).record executedOk (by decide) (by decide)
      fun h => absurd h (by decide)).carry revealedOk).carry votedOk
  have step : ∀ {source : BalanceSource}
      {limits : BeaconState preset fork → Except TransitionError (Nat × Nat)}
      {action : BeaconState preset fork → Except TransitionError (BeaconState preset fork)}
      (pre post : BalanceReplay preset fork), (source = .rewards ∨ source = .slashings) →
      (getBeaconProposerIndex pre.1 = .ok block.proposerIndex ∧
        PassCredits block.proposerIndex.toNat pre.2) →
      recordBalance source limits action pre = .ok post →
      (∀ s u, action s = .ok u → getBeaconProposerIndex s = .ok block.proposerIndex →
        SameSizes s u ∧ (∀ i, block.proposerIndex.toNat ≠ i → BalanceDown i s u) ∧
          getBeaconProposerIndex u = .ok block.proposerIndex) →
      getBeaconProposerIndex post.1 = .ok block.proposerIndex ∧
        PassCredits block.proposerIndex.toNat post.2 := by
    intro source limits action pre post src ⟨seen, held⟩ ok props
    obtain ⟨-, -, kept⟩ := props _ _ (PinEventsKept.recordBalance_cases ok).1 seen
    refine ⟨kept, held.record ok ?_ ?_ fun _ u computed i other => ?_⟩
    · rcases src with rfl | rfl <;> decide
    · rcases src with rfl | rfl <;> decide
    · obtain ⟨sizes, down, -⟩ := props _ _ computed seen
      exact actualBalanceAt_le_of_down sizes (down i other)
  have away : block.proposerIndex.toNat ≠ block.proposerIndex.toNat + 1 := by omega
  have proposedR := foldlM_ok_invariant (fun p : BalanceReplay preset fork =>
      getBeaconProposerIndex p.1 = .ok block.proposerIndex ∧
        PassCredits block.proposerIndex.toNat p.2)
    (fun pre _ post held ok => step pre post (Or.inr rfl) held ok fun s u c r =>
      ⟨sameSizes_processProposerSlashing c,
        fun i other => (processProposerSlashing_balanceDown apart c r other).1,
        ((processProposerSlashing_balanceDown apart c r away).2).trans r⟩)
    ⟨read, start⟩ proposedOk
  have slashedR := foldlM_ok_invariant (fun p : BalanceReplay preset fork =>
      getBeaconProposerIndex p.1 = .ok block.proposerIndex ∧
        PassCredits block.proposerIndex.toNat p.2)
    (fun pre _ post held ok => step pre post (Or.inr rfl) held ok fun s u c r =>
      ⟨sameSizes_processAttesterSlashing c,
        fun i other => (processAttesterSlashing_balanceDown apart c r other).1,
        ((processAttesterSlashing_balanceDown apart c r away).2).trans r⟩)
    proposedR slashedOk
  have attestedR := foldlM_ok_invariant (fun p : BalanceReplay preset fork =>
      getBeaconProposerIndex p.1 = .ok block.proposerIndex ∧
        PassCredits block.proposerIndex.toNat p.2)
    (fun pre _ post held ok => step pre post (Or.inl rfl) held ok fun s u c r =>
      ⟨sameSizes_processAttestation c,
        fun i other => (processAttestation_balanceDown apart c r other).1,
        ((processAttestation_balanceDown apart c r away).2).trans r⟩)
    slashedR attestedOk
  -- The remaining passes before the sync pass record no rewards or slashings.
  have depositedC := foldlM_ok_invariant (fun p : BalanceReplay preset fork =>
      PassCredits block.proposerIndex.toNat p.2)
    (fun _ _ _ held ok => held.record ok (by decide) (by decide) fun h => absurd h (by decide))
    attestedR.2 depositedOk
  have requestedC := ((((depositedC.carry exitedOk).carry changedOk).carry requestedOk).carry
    withdrawnOk)
  have consolidatedC := foldlM_ok_invariant (fun p : BalanceReplay preset fork =>
      PassCredits block.proposerIndex.toNat p.2)
    (fun _ _ _ held ok => held.record ok (by decide) (by decide) fun h => absurd h (by decide))
    requestedC consolidatedOk
  simp only [recordBalance, bind_ok_iff, pure, Except.pure, Except.ok.injEq,
    Prod.mk.injEq] at syncOk
  obtain ⟨⟨credit, debit⟩, -, u, synced, rfl, rfl⟩ := syncOk
  exact ⟨consolidated.1, consolidated.2, altair, _, credit, debit, rfl, link, synced,
    consolidatedC, processBlockHeader_proposer headerOk⟩

/-- A key that an event of a block step credits is its proposer, or a seat holder for a sync event.

The mixes must span more than the seed lookahead plus two epochs. -/
private theorem block_gross_keys {g : ForkedBeaconState preset}
    (genesis : Genesis config checks g)
    (apart : preset.MIN_SEED_LOOKAHEAD.toNat + 2 < preset.EPOCHS_PER_HISTORICAL_VECTOR.toNat)
    {f : Fork} {s t : BeaconState preset f} {engine : ExecutionEngine preset f}
    {signed : SignedBeaconBlock preset f} {due : upgradeDue config ⟨f, s⟩ = false}
    {ok : applySignedBlock config checks engine s signed true = .ok t}
    (shared : Run config checks g ⟨f, s⟩) (fulu : .fusaka ≤ f) (early : f < .glamsterdam)
    {events : List (BalanceEvent preset)}
    (replayed : (Step.block engine signed due ok).balanceEvents = .ok events) :
    ∃ K : Finset ℕ, K.card ≤ 1 ∧ (∀ k ∈ K, ∃ p, getBeaconProposerIndex s = .ok p ∧ p.toNat = k) ∧
      ∀ e ∈ events, ∀ i, 0 < keyCredit i e →
      i ∈ K ∨ (e.source = .sync ∧ ∃ altair : .altair ≤ f, ∃ w, t.validators.data[i]? = some w ∧
        w.pubkey ∈ (t.currentSyncCommittee altair).value.pubkeys.toList) := by
  have electra : .pectra ≤ f := Nat.le_trans (by decide) fulu
  obtain ⟨c, rest, altair, aggregate, credit, debit, split, read, synced, passes, header⟩ :=
    blockReplay_proposer_credits apart electra early (Step.balanceEvents_block early replayed)
  have bounded := step_events_bounded shared genesis (Step.block engine signed due ok) early
    replayed
  have matchedT : BalancesMatch t :=
    (frame_processBlock (applySignedBlock_ok ok).2.1).balancesMatch
      (run_justified_separated shared genesis).1.balancesMatch
  refine ⟨{signed.message.proposerIndex.toNat}, by simp,
    fun k hk => ⟨_, header, (Finset.mem_singleton.mp hk).symm⟩, fun e member i positive => ?_⟩
  have member' := member
  rw [split] at member'
  rcases List.mem_append.mp member' with inRest | inSync
  · obtain ⟨notSync, notConsolidation, only⟩ := passes e inRest
    refine .inl (Finset.mem_singleton.mpr ?_)
    by_contra other
    by_cases credited : e.source = .rewards ∨ e.source = .slashings
    · have := only credited i fun same => other same.symm
      omega
    · have each := block_event_credit shared genesis early electra i replayed bounded e member
      have noRewards : ¬ (e.source = .rewards ∨ e.source = .consolidations) := by
        rintro (h | h)
        · exact credited (.inl h)
        · exact notConsolidation h
      have noSync : syncCredit i e = 0 := by simp [syncCredit, notSync]
      have noSlash : ¬ e.source = .slashings := fun h => credited (.inr h)
      simp only [noRewards, noSlash, noSync, ↓reduceIte] at each
      omega
  · obtain rfl := List.mem_singleton.mp inSync
    simp only [keyCredit] at positive
    rcases sync_moved_seat (i := i) altair synced matchedT (by omega) with h | ⟨_, found, same, -⟩
    · exact .inr ⟨rfl, altair, h⟩
    · exact .inl (Finset.mem_singleton.mpr (by rw [read] at found; cases found; exact same.symm))

/-- A key that rewards, slashings or sync credit in a block step is a proposer or a seat holder. -/
private theorem block_step_gross_keys {g : ForkedBeaconState preset}
    (genesis : Genesis config checks g)
    (apart : preset.MIN_SEED_LOOKAHEAD.toNat + 2 < preset.EPOCHS_PER_HISTORICAL_VECTOR.toNat)
    {f : Fork} {s t : BeaconState preset f} {engine : ExecutionEngine preset f}
    {signed : SignedBeaconBlock preset f} {due : upgradeDue config ⟨f, s⟩ = false}
    {ok : applySignedBlock config checks engine s signed true = .ok t}
    (shared : Run config checks g ⟨f, s⟩) (fulu : .fusaka ≤ f) (early : f < .glamsterdam) :
    ∃ K : Finset ℕ, K.card ≤ 1 ∧ (∀ k ∈ K, ∃ p, getBeaconProposerIndex s = .ok p ∧ p.toNat = k) ∧
      ∀ i, 0 < stepCredit
        (fun s => decide (s = .rewards ∨ s = .slashings ∨ s = .sync)) (fun _ => false) i
        (Step.block engine signed due ok) →
      i ∈ K ∨ ∃ altair : .altair ≤ f, ∃ w, t.validators.data[i]? = some w ∧
        w.pubkey ∈ (t.currentSyncCommittee altair).value.pubkeys.toList := by
  cases replayed : (Step.block engine signed due ok).balanceEvents with
  | error _ =>
    exact ⟨∅, by simp, by simp, fun i pos => by simp [stepCredit, replayed, Except.toOption] at pos⟩
  | ok events =>
    obtain ⟨K, card, proposers, keys⟩ := block_gross_keys genesis apart shared fulu early replayed
    refine ⟨K, card, proposers, fun i pos => ?_⟩
    simp only [stepCredit, replayed, Except.toOption, Option.getD_some] at pos
    by_contra none
    refine absurd (List.sum_eq_zero fun x member => ?_) (Nat.pos_iff_ne_zero.mp pos)
    obtain ⟨e, inFilter, rfl⟩ := List.mem_map.mp member
    obtain ⟨inEvents, source⟩ := List.mem_filter.mp inFilter
    refine Nat.eq_zero_of_not_pos fun positive => none ?_
    rcases keys e inEvents i positive with inK | ⟨-, altair, seat⟩
    · exact .inl inK
    · exact .inr ⟨altair, seat⟩

/-- A list of at most one element has equal members. -/
private theorem list_eq_of_length_le_one {α : Type} {L : List α} (short : L.length ≤ 1) {a b : α}
    (ha : a ∈ L) (hb : b ∈ L) : a = b := by
  cases L with
  | nil => simp at ha
  | cons c rest =>
    cases rest with
    | nil =>
      rw [List.mem_singleton] at ha hb
      rw [ha, hb]
    | cons d rest => exact absurd short (by simp)

/-- The scan of a run reads the credit of each step that the run contains.

The run must end within the horizon, so that every step of it is selected. -/
private theorem stepCredit_le_creditScan (blockP slotP : BalanceSource → Bool) (v high : ℕ)
    {x y : ForkedBeaconState preset} (tail : Run config checks x y)
    (within : (getCurrentEpoch y.state).toNat ≤ high + 1)
    {a b : ForkedBeaconState preset} (step : Step config checks a b) (member : tail.Contains step) :
    stepCredit blockP slotP v step ≤ (creditScan blockP slotP v high tail) := by
  obtain ⟨pre, post, same⟩ := tail.contains_split step member
  subst same
  have selected : (getCurrentEpoch a.state).toNat ≤ high + 1 :=
    Nat.le_trans (UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps
      (Relation.ReflTransGen.head step.chainStep post.chainSteps))) within
  rw [creditScan_append, creditScan_snoc]
  simp only [selected, ↓reduceIte]
  omega

/-- A key that a deposit credits on C's run has a positive deposit scan.

A deposit event of a block raises no balance, so a deposit that credits a key is an epoch's.

The scan counts the deposits of a slot step, and the run ends within the horizon. -/
private theorem depPre_pos_scan (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    (i : ℕ) (pos : 0 < depPre eventsC i) :
    0 < (creditScan (fun _ => false) (fun s => decide (s = .deposits)) i highC tailC) := by
  classical
  obtain ⟨e, member, dep, credited⟩ : ∃ e ∈ eventsC, e.source = .deposits ∧ 0 < keyCredit i e := by
    by_contra none
    have none' : ∀ e ∈ eventsC, e.source = .deposits → keyCredit i e ≤ 0 := fun e member dep =>
      Nat.le_of_not_lt fun positive => none ⟨e, member, dep, positive⟩
    have zero : depPre eventsC i = 0 := by
      unfold depPre
      refine List.sum_eq_zero fun x mem => ?_
      obtain ⟨e, filtered, rfl⟩ := List.mem_map.mp mem
      obtain ⟨inEvents, selected⟩ := List.mem_filter.mp filtered
      exact Nat.le_zero.mp (none' e inEvents (of_decide_eq_true selected).1)
    omega
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  rcases (run_located tailC electra h.early highC replayedC).1 e member dep with
    unconditional | ⟨u, w, ok, es, contains, replayedEs, inEs, -⟩
  · exfalso
    have := unconditional i
    unfold keyCredit at credited
    omega
  · have step : keyCredit i e ≤ stepCredit (fun _ => false) (fun s => decide (s = .deposits)) i
        (Step.slot ok : Step config checks u w) := by
      simp only [stepCredit, replayedEs, Except.toOption, Option.getD_some]
      exact List.le_sum_of_mem (List.mem_map.mpr
        ⟨e, List.mem_filter.mpr ⟨inEs, by simpa using dep⟩, rfl⟩)
    have scan := stepCredit_le_creditScan (fun _ => false) (fun s => decide (s = .deposits)) i highC
      tailC endEpochC (Step.slot ok) contains
    omega

/-- The keys that one step credits by a pending-deposit pass.

An epoch pass applies at most `MAX_PENDING_DEPOSITS_PER_EPOCH` deposits, in one slot step.

So the keys are at most that many for each epoch that the step leaves. -/
private theorem step_deposit_keys {g : ForkedBeaconState preset}
    (genesis : Genesis config checks g) {x y : ForkedBeaconState preset}
    (shared : Run config checks g x) (step : Step config checks x y)
    (early : y.fork < .glamsterdam)
    (delay : 0 < config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat) :
    ∃ D : Finset ℕ, D.card ≤ preset.MAX_PENDING_DEPOSITS_PER_EPOCH.toNat *
        ((getCurrentEpoch y.state).toNat - (getCurrentEpoch x.state).toNat) ∧
      ∀ i, 0 < stepCredit (fun _ => false) (fun s => decide (s = .deposits)) i step → i ∈ D := by
  classical
  cases step with
  | block engine signed due ok =>
    refine ⟨∅, by simp, fun i here => ?_⟩
    exfalso
    have zero : stepCredit (fun _ => false) (fun s => decide (s = .deposits)) i
        (Step.block engine signed due ok : Step config checks _ _) = 0 := by
      show ((((Step.block (config := config) (checks := checks) engine signed due
        ok).balanceEvents.toOption.getD []).filter ((fun _ => false) ·.source)).map
          (keyCredit i)).sum = 0
      rw [List.filter_eq_nil_iff.mpr (fun a _ => by simp)]
      rfl
    omega
  | slot across =>
    obtain ⟨events, eventsOk⟩ :=
      (Step.slot across : Step config checks x y).balanceEvents_ok early
    -- A slot step credits a key by deposits only if one of its deposit events does.
    have quiet : ∀ i, (∀ e ∈ events, e.source = .deposits → keyCredit i e = 0) →
        stepCredit (fun _ => false) (fun s => decide (s = .deposits)) i
          (Step.slot across : Step config checks x y) = 0 := fun i none' => by
      show (((((Step.slot (config := config) (checks := checks)
        across).balanceEvents.toOption.getD []).filter
          ((fun s => decide (s = .deposits)) ·.source))).map (keyCredit i)).sum = 0
      simp only [eventsOk, Except.toOption, Option.getD_some]
      exact List.sum_eq_zero fun _ member => by
        obtain ⟨e, inside, rfl⟩ := List.mem_map.mp member
        obtain ⟨mem, test⟩ := List.mem_filter.mp inside
        exact none' e mem (by simpa using test)
    by_cases any : ∃ e ∈ events, e.source = .deposits
    · obtain ⟨sites, ends, single⟩ :=
        DirectSafety.Apriori.Internal.Step.slot_deposit_site shared genesis across early delay
          eventsOk
      have epochNext := ends any
      obtain ⟨e0, mem0, dep0⟩ := any
      obtain ⟨electra, a, b, matched, -, -, deposited, before0, after0⟩ := sites e0 mem0 dep0
      obtain ⟨-, -, rises⟩ := pending_deposit_rises a b matched electra deposited
      have oneEpoch : (getCurrentEpoch y.state).toNat - (getCurrentEpoch x.state).toNat = 1 := by
        omega
      refine ⟨(Finset.range b.balances.data.size).filter fun i =>
          actualBalanceAt (⟨x.fork, a⟩ : ForkedBeaconState preset) i <
            actualBalanceAt (⟨x.fork, b⟩ : ForkedBeaconState preset) i, ?_, fun i here => ?_⟩
      · rw [oneEpoch, Nat.mul_one]
        exact rises
      · refine Finset.mem_filter.mpr ?_
        have mono : ∃ e ∈ events, e.source = .deposits ∧ 0 < keyCredit i e := by
          by_contra none
          have none' : ∀ e ∈ events, e.source = .deposits → keyCredit i e = 0 :=
            fun e mem dep => by
              by_contra ne
              exact none ⟨e, mem, dep, Nat.pos_of_ne_zero ne⟩
          have := quiet i none'
          omega
        obtain ⟨e, mem, dep, positive⟩ := mono
        -- A slot step records one deposit event, so it is the one that the site names.
        have same : e = e0 := list_eq_of_length_le_one single
          (List.mem_filter.mpr ⟨mem, by simpa using dep⟩)
          (List.mem_filter.mpr ⟨mem0, by simpa using dep0⟩)
        subst same
        unfold keyCredit at positive
        rw [before0, after0] at positive
        refine ⟨?_, ?_⟩
        · by_contra outside
          have outside' : ¬ i < b.balances.data.size := fun h =>
            outside (Finset.mem_range.mpr h)
          have missing : actualBalanceAt (⟨x.fork, b⟩ : ForkedBeaconState preset) i = 0 := by
            simp [actualBalanceAt, Array.getElem?_eq_none (Nat.le_of_not_lt outside')]
          omega
        · omega
    · refine ⟨∅, by simp, fun i here => ?_⟩
      exfalso
      have := quiet i fun e mem dep => absurd ⟨e, mem, dep⟩ any
      omega

/-- The keys credited in the block steps of a run inside one period of sync committees.

A key credited by a block is a proposer, at most one for each block.

Otherwise it holds a seat of the committee that the run starts with. -/
private theorem credited_piece {g : ForkedBeaconState preset}
    (genesis : Genesis config checks g)
    (apart : preset.MIN_SEED_LOOKAHEAD.toNat + 2 < preset.EPOCHS_PER_HISTORICAL_VECTOR.toNat)
    {x y : ForkedBeaconState preset}
    (shared : Run config checks g x) (r : Run config checks x y)
    (fulu : .fusaka ≤ x.fork) (altair : .altair ≤ x.fork) (early : y.fork < .glamsterdam)
    (delay : 0 < config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat) (high : ℕ)
    (same : (getCurrentEpoch y.state).toNat / max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat =
      (getCurrentEpoch x.state).toNat / max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat) :
    ∃ B D : Finset ℕ, B.card ≤ r.blockCount ∧
      D.card ≤ preset.MAX_PENDING_DEPOSITS_PER_EPOCH.toNat *
        ((getCurrentEpoch y.state).toNat - (getCurrentEpoch x.state).toNat) ∧
      (∀ i, 0 < grossScan i high r →
      i ∈ B ∨ ∃ w, y.state.validators.data[i]? = some w ∧
        w.pubkey ∈ (x.state.currentSyncCommittee altair).value.pubkeys.toList) ∧
      (∀ i, 0 < (creditScan (fun _ => false) (fun s => decide (s = .deposits)) i high r) →
        i ∈ D) ∧
      (∀ events, r.balanceEvents high = .ok events → ∀ i, 0 < (events.map (syncDebit i)).sum →
        ∃ w, y.state.validators.data[i]? = some w ∧
          w.pubkey ∈ (x.state.currentSyncCommittee altair).value.pubkeys.toList) ∧
      ∀ i ∈ B, ∃ (u : ForkedBeaconState preset) (_ : Run config checks x u) (p : ValidatorIndex),
        u.fork < .glamsterdam ∧ getBeaconProposerIndex u.state = .ok p ∧ p.toNat = i := by
  classical
  induction r with
  | nil =>
    refine ⟨∅, ∅, by simp, by simp, fun i pos => (Nat.lt_irrefl 0 pos).elim,
      fun i pos => (Nat.lt_irrefl 0 pos).elim, ?_, by simp⟩
    intro events replayed i pos
    simp only [Run.balanceEvents, pure, Except.pure, Except.ok.injEq] at replayed
    subst replayed
    simp at pos
  | @snoc u l pre step ih =>
    have uEarly : u.fork < .glamsterdam := Nat.lt_of_le_of_lt step.chainStep.fork_le early
    have low := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps pre.chainSteps)
    have up := UInt64.le_iff_toNat_le.mp step.chainStep.currentEpoch_le
    have uSame : (getCurrentEpoch u.state).toNat /
        max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat =
          (getCurrentEpoch x.state).toNat /
            max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat := by
      have above := Nat.div_le_div_right
        (c := max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat) up
      have under := Nat.div_le_div_right
        (c := max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat) low
      omega
    obtain ⟨B, D, cardB, cardD, hB, hDep, hS, hP⟩ := ih uEarly uSame
    obtain ⟨Ds, cardDs, hDs⟩ := step_deposit_keys genesis (shared.append pre) step early delay
    have cardUnion : (D ∪ Ds).card ≤ preset.MAX_PENDING_DEPOSITS_PER_EPOCH.toNat *
        ((getCurrentEpoch l.state).toNat - (getCurrentEpoch x.state).toNat) := by
      have joined := Nat.mul_le_mul_left preset.MAX_PENDING_DEPOSITS_PER_EPOCH.toNat
        (show (getCurrentEpoch u.state).toNat - (getCurrentEpoch x.state).toNat +
          ((getCurrentEpoch l.state).toNat - (getCurrentEpoch u.state).toNat) ≤
            (getCurrentEpoch l.state).toNat - (getCurrentEpoch x.state).toNat by omega)
      rw [Nat.mul_add] at joined
      exact (Finset.card_union_le _ _).trans (Nat.le_trans (Nat.add_le_add cardD cardDs) joined)
    have depMem : ∀ i, 0 < (creditScan (fun _ => false) (fun s => decide (s = .deposits)) i high
        (pre.snoc step)) → i ∈ D ∪ Ds := by
      intro i pos
      rw [creditScan_snoc] at pos
      split at pos
      · by_cases prior : 0 < (creditScan (fun _ => false) (fun s => decide (s = .deposits)) i
            high pre)
        · exact Finset.mem_union_left _ (hDep i prior)
        · exact Finset.mem_union_right _ (hDs i (by omega))
      · exact Finset.mem_union_left _ (hDep i pos)
    have carry : ∀ (i : ℕ) (w : Validator), u.state.validators.data[i]? = some w →
        w.pubkey ∈ (x.state.currentSyncCommittee altair).value.pubkeys.toList →
          ∃ w', l.state.validators.data[i]? = some w' ∧
            w'.pubkey ∈ (x.state.currentSyncCommittee altair).value.pubkeys.toList := by
      intro i w found mem
      obtain ⟨w', found', same'⟩ := key_persists (Run.nil.snoc step) found
      exact ⟨w', found', same' ▸ mem⟩
    cases step with
    | slot ok =>
      have fulu' : .fusaka ≤ u.fork := Nat.le_trans fulu (fork_le_of_chainSteps pre.chainSteps)
      refine ⟨B, D ∪ Ds, cardB, cardUnion, fun i pos => ?_, depMem, ?_, hP⟩
      have prior := grossScan_slot_pos i high pre ok pos
      rcases hB i prior with member | ⟨w, found, mem⟩
      · exact .inl member
      · exact .inr (carry i w found mem)
      intro events replayed i pos
      simp only [Run.balanceEvents, bind_ok_iff] at replayed
      obtain ⟨prior, priorOk, rest⟩ := replayed
      split at rest
      · simp only [bind_ok_iff, pure, Except.pure, Except.ok.injEq] at rest
        obtain ⟨added, addedOk, rfl⟩ := rest
        have zero := (PinSeatDebits.slot_syncDebit_zero
          (Nat.le_trans (show Fork.pectra ≤ Fork.fusaka by decide) fulu') ok early addedOk i).1
        simp only [List.map_append, List.sum_append, zero, Nat.add_zero] at pos
        obtain ⟨w, found, mem⟩ := hS prior priorOk i pos
        exact carry i w found mem
      · simp only [pure, Except.pure, Except.ok.injEq] at rest
        subst rest
        obtain ⟨w, found, mem⟩ := hS _ priorOk i pos
        exact carry i w found mem
    | @block f s t engine signed due ok =>
      have fulu' : .fusaka ≤ f := Nat.le_trans fulu (fork_le_of_chainSteps pre.chainSteps)
      obtain ⟨K, cardK, hKp, hK⟩ := block_step_gross_keys (engine := engine) (signed := signed)
        (due := due) (ok := ok) genesis apart (shared.append pre) fulu' uEarly
      refine ⟨B ∪ K, D ∪ Ds, ?_, cardUnion, fun i pos => ?_, depMem, ?_, fun i hi => ?_⟩
      · exact (Finset.card_union_le _ _).trans (Nat.add_le_add cardB cardK)
      · rw [grossScan_snoc] at pos
        rcases Nat.eq_zero_or_pos (grossScan i high pre) with zero | prior
        · rcases hK i (by split at pos <;> omega) with member | ⟨altair', w, hv, mem⟩
          · exact .inl (Finset.mem_union_right _ member)
          · have committee := (Run.snoc pre (Step.block engine signed due ok)
                ).currentSyncCommittee_eq_of_same_period early same altair' altair
            exact .inr ⟨w, hv, by rw [← committee]; exact mem⟩
        · rcases hB i prior with member | ⟨w, found, mem⟩
          · exact .inl (Finset.mem_union_left _ member)
          · exact .inr (carry i w found mem)
      · intro events replayed i pos
        simp only [Run.balanceEvents, bind_ok_iff] at replayed
        obtain ⟨prior, priorOk, rest⟩ := replayed
        split at rest
        · simp only [bind_ok_iff, pure, Except.pure, Except.ok.injEq] at rest
          obtain ⟨added, addedOk, rfl⟩ := rest
          simp only [List.map_append, List.sum_append] at pos
          by_cases first : 0 < (prior.map (syncDebit i)).sum
          · obtain ⟨w, found, mem⟩ := hS prior priorOk i first
            exact carry i w found mem
          · have here : 0 < (added.map (syncDebit i)).sum := by omega
            have altair' : .altair ≤ f := Nat.le_trans (by decide) fulu'
            obtain ⟨c, rest', aggregate, credit, debit, rfl, silent, -, synced⟩ :=
              PinSeatDebits.blockReplay_sync_split (show f < .glamsterdam from uEarly) altair'
                (Step.balanceEvents_block uEarly addedOk)
            simp only [List.map_append, List.sum_append, silent, syncDebit, ↓reduceIte,
              List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, Nat.zero_add,
              Nat.add_zero] at here
            have matchedT : BalancesMatch t :=
              (frame_processBlock (applySignedBlock_ok ok).2.1).balancesMatch
                (run_justified_separated (shared.append pre) genesis).1.balancesMatch
            obtain ⟨w, hv, mem⟩ := sync_debit_seat (i := i) altair' synced matchedT (by omega)
            have committee := (Run.snoc pre (Step.block engine signed due ok)
                ).currentSyncCommittee_eq_of_same_period early same altair' altair
            refine ⟨w, hv, ?_⟩
            rw [← committee]
            exact mem
        · simp only [pure, Except.pure, Except.ok.injEq] at rest
          subst rest
          obtain ⟨w, found, mem⟩ := hS _ priorOk i pos
          exact carry i w found mem
      · -- a proposer of an earlier block, or the proposer of this one
        rcases Finset.mem_union.mp hi with earlier | here
        · exact hP i earlier
        · obtain ⟨p, found, same⟩ := hKp i here
          exact ⟨⟨f, s⟩, pre, p, uEarly, found, same⟩

/-- The positions that hold a key of a committee of a list are at most the keys of the list.

The registry has distinct keys, and each committee has at most `SYNC_COMMITTEE_SIZE` keys. -/
private theorem listed_positions_card (state : BeaconState preset fork)
    (distinct : PubkeysDistinct state) (Ls : List (List Cryptography.Bls.BLSPubkey))
    (each : ∀ L ∈ Ls, L.length ≤ preset.SYNC_COMMITTEE_SIZE.toNat) :
    ((Finset.range state.validators.data.size).filter fun i =>
        ∃ w, state.validators.data[i]? = some w ∧ ∃ L ∈ Ls, w.pubkey ∈ L).card ≤
      preset.SYNC_COMMITTEE_SIZE.toNat * Ls.length := by
  classical
  have mapped : ((Finset.range state.validators.data.size).filter fun i =>
      ∃ w, state.validators.data[i]? = some w ∧ ∃ L ∈ Ls, w.pubkey ∈ L).card ≤
        Ls.flatten.toFinset.card := by
    refine Finset.card_le_card_of_injOn (keyAt state) (fun i member => ?_)
      (fun i mi j mj eq => ?_)
    · obtain ⟨w, found, L, hL, mem⟩ := (Finset.mem_filter.mp member).2
      simp only [keyAt, found, Option.map_some, Option.getD_some]
      exact List.mem_toFinset.mpr (List.mem_flatten.mpr ⟨L, hL, mem⟩)
    · obtain ⟨w, found, -⟩ := (Finset.mem_filter.mp mi).2
      obtain ⟨w', found', -⟩ := (Finset.mem_filter.mp mj).2
      simp only [keyAt, found, found', Option.map_some, Option.getD_some] at eq
      exact distinct.index_eq found found' eq
  have total : Ls.flatten.length ≤ preset.SYNC_COMMITTEE_SIZE.toNat * Ls.length := by
    rw [List.length_flatten]
    have := List.sum_le_length_nsmul (Ls.map List.length) preset.SYNC_COMMITTEE_SIZE.toNat
      (fun a ha => by
        obtain ⟨L, hL, rfl⟩ := List.mem_map.mp ha
        exact each L hL)
    simpa [List.length_map, smul_eq_mul, Nat.mul_comm] using this
  exact mapped.trans ((List.toFinset_card_le _).trans total)

/-- The positions that hold a key of a committee are at most the size of the committee. -/
private theorem seat_positions {g : ForkedBeaconState preset}
    (genesis : Genesis config checks g) {x y : ForkedBeaconState preset}
    (shared : Run config checks g x) (r : Run config checks x y) (altair : .altair ≤ x.fork) :
    ∃ S : Finset ℕ, S.card ≤ preset.SYNC_COMMITTEE_SIZE.toNat ∧ ∀ (i : ℕ) (w : Validator),
      y.state.validators.data[i]? = some w →
        w.pubkey ∈ (x.state.currentSyncCommittee altair).value.pubkeys.toList → i ∈ S := by
  classical
  have distinct := (shared.append r).pubkeysDistinct genesis
  let L := (x.state.currentSyncCommittee altair).value.pubkeys.toList
  refine ⟨(Finset.range y.state.validators.data.size).filter fun i =>
      ∃ w, y.state.validators.data[i]? = some w ∧ w.pubkey ∈ L, ?_, ?_⟩
  · have listed := listed_positions_card y.state distinct [L] (by simp [L])
    rw [List.length_singleton, Nat.mul_one] at listed
    refine le_trans (Finset.card_le_card ?_) listed
    intro i member
    obtain ⟨inside, w, found, mem⟩ := Finset.mem_filter.mp member
    exact Finset.mem_filter.mpr ⟨inside, w, found, L, List.mem_singleton_self L, mem⟩
  · intro i w found mem
    exact Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (Array.getElem?_eq_some_iff.mp found).1,
      w, found, mem⟩

/-- A later epoch of a period is in the same period or the next one. -/
private theorem succ_div_le (a c : ℕ) : (a + 1) / c ≤ a / c + 1 := by
  rcases Nat.eq_zero_or_pos c with zero | positive
  · subst zero
    simp
  · apply Nat.div_le_of_le_mul
    have := Nat.lt_mul_div_succ a positive
    omega

/-- The empty run before a run changes nothing. -/
private theorem run_nil_append {x y : ForkedBeaconState preset} (r : Run config checks x y) :
    Run.nil.append r = r := by
  induction r with
  | nil => rfl
  | snoc r step ih => exact congrArg (fun run => run.snoc step) ih

/-- The keys credited in the block steps of a run, counted by the periods that it touches.

The keys that a sync aggregate debits hold a seat of one committee for each period of the run.

Each committee is the current one at a state of the run, in the period of its index. -/
private theorem credited_pieces_seated {g : ForkedBeaconState preset}
    (genesis : Genesis config checks g)
    (apart : preset.MIN_SEED_LOOKAHEAD.toNat + 2 < preset.EPOCHS_PER_HISTORICAL_VECTOR.toNat)
    {y : ForkedBeaconState preset}
    (early : y.fork < .glamsterdam)
    (delay : 0 < config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat) (high : ℕ) :
    ∀ (n : ℕ) {x : ForkedBeaconState preset}, Run config checks g x →
      ∀ (r : Run config checks x y), .fusaka ≤ x.fork →
    (getCurrentEpoch y.state).toNat / max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat =
      (getCurrentEpoch x.state).toNat / max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat + n →
    ∃ (Ls : ℕ → List Cryptography.Bls.BLSPubkey) (B S D : Finset ℕ), B.card ≤ r.blockCount ∧
      S.card ≤ preset.SYNC_COMMITTEE_SIZE.toNat * (n + 1) ∧
      D.card ≤ preset.MAX_PENDING_DEPOSITS_PER_EPOCH.toNat *
        ((getCurrentEpoch y.state).toNat - (getCurrentEpoch x.state).toNat) ∧
      (∀ i, 0 < grossScan i high r → i ∈ B ∨ i ∈ S) ∧
      (∀ i, 0 < (creditScan (fun _ => false) (fun s => decide (s = .deposits)) i high r) →
        i ∈ D) ∧
      (∀ i, 0 < grossScan i high r → i ∈ B ∨
        ∃ w j, y.state.validators.data[i]? = some w ∧ j ≤ n ∧ w.pubkey ∈ Ls j) ∧
      (∀ i ∈ B, ∃ (u : ForkedBeaconState preset) (_ : Run config checks x u) (p : ValidatorIndex),
        u.fork < .glamsterdam ∧ getBeaconProposerIndex u.state = .ok p ∧ p.toNat = i) ∧
      (∀ events, r.balanceEvents high = .ok events → ∀ i, 0 < (events.map (syncDebit i)).sum →
        i ∈ S ∧ ∃ w j, y.state.validators.data[i]? = some w ∧ j ≤ n ∧ w.pubkey ∈ Ls j) ∧
      ∀ j ≤ n, ∃ (z : ForkedBeaconState preset) (r1 : Run config checks x z)
        (r2 : Run config checks z y) (alt : .altair ≤ z.fork), r1.append r2 = r ∧
        (getCurrentEpoch z.state).toNat / max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat =
          (getCurrentEpoch x.state).toNat /
            max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat + j ∧
        Ls j = (z.state.currentSyncCommittee alt).value.pubkeys.toList := by
  classical
  intro n
  induction n with
  | zero =>
    intro x shared r fulu count
    have electra : .pectra ≤ x.fork := Nat.le_trans (by decide) fulu
    have altair : .altair ≤ x.fork := Nat.le_trans (by decide) electra
    obtain ⟨B, D, cardB, cardD, hB, hDep, hD, hP⟩ := credited_piece genesis apart shared r fulu
      altair early delay high (by simpa using count)
    obtain ⟨S, cardS, hS⟩ := seat_positions genesis shared r altair
    refine ⟨fun _ => (x.state.currentSyncCommittee altair).value.pubkeys.toList, B, S, D, cardB,
      by simpa using cardS, cardD, fun i pos => ?_, hDep,
      fun i pos => (hB i pos).imp id fun ⟨w, found, mem⟩ => ⟨w, 0, found, Nat.le_refl _, mem⟩, hP,
      ?_, ?_⟩
    · rcases hB i pos with member | ⟨w, found, mem⟩
      · exact .inl member
      · exact .inr (hS i w found mem)
    · intro events replayed i pos
      obtain ⟨w, found, mem⟩ := hD events replayed i pos
      exact ⟨hS i w found mem, w, 0, found, Nat.le_refl _, mem⟩
    · intro j hj
      obtain rfl : j = 0 := by omega
      exact ⟨x, Run.nil, r, altair, run_nil_append r, (Nat.add_zero _).symm, rfl⟩
  | succ n ih =>
    intro x shared r fulu count
    have electra : .pectra ≤ x.fork := Nat.le_trans (by decide) fulu
    have altair : .altair ≤ x.fork := Nat.le_trans (by decide) electra
    obtain ⟨m, v, pre, step, post, split, hm, hv⟩ := Run.split_at_flip r
      (fun z => (getCurrentEpoch x.state).toNat /
          max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat <
        (getCurrentEpoch z.state).toNat / max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat)
      (Nat.lt_irrefl _) (by omega)
    have low := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps pre.chainSteps)
    have up := PinKeys.ChainStep.epoch_le_succ step.chainStep
    have mSame : (getCurrentEpoch m.state).toNat /
        max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat =
          (getCurrentEpoch x.state).toNat /
            max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat := by
      have under := Nat.div_le_div_right
        (c := max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat) low
      omega
    have vNext : (getCurrentEpoch v.state).toNat /
        max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat =
          (getCurrentEpoch x.state).toNat /
            max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat + 1 := by
      have above := Nat.div_le_div_right
        (c := max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat) up
      have step' := succ_div_le (getCurrentEpoch m.state).toNat
        (max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat)
      omega
    have mEarly : m.fork < .glamsterdam :=
      Nat.lt_of_le_of_lt (Nat.le_trans step.chainStep.fork_le
        (fork_le_of_chainSteps post.chainSteps)) early
    have vFulu : .fusaka ≤ v.fork :=
      Nat.le_trans fulu (fork_le_of_chainSteps (pre.snoc step).chainSteps)
    obtain ⟨B₁, D₁, cardB₁, cardD₁, hB₁, hDep₁, hD₁, hP₁⟩ := credited_piece genesis apart shared pre
      fulu
      altair mEarly delay high (by simpa using mSame)
    obtain ⟨S₁, cardS₁, hS₁⟩ := seat_positions genesis shared pre altair
    obtain ⟨Ls₂, B₂, S₂, D₂, cardB₂, cardS₂, cardD₂, hB₂, hDep₂, hG₂, hP₂, hD₂, hz₂⟩ := ih (x := v)
      (shared.append (pre.snoc step)) post vFulu
      (by omega)
    -- The step leaves an epoch, so it is a slot step: a block step keeps its epoch.
    have slotStep : ∃ ok, step = Step.slot ok := by
      cases step with
      | slot ok => exact ⟨ok, rfl⟩
      | @block f before after engine signed due ok =>
        exfalso
        have same := processBlock_slot (applySignedBlock_ok ok).2.1
        have e : (getCurrentEpoch after).toNat = (getCurrentEpoch before).toNat := by
          simp only [getCurrentEpoch, same]
        have hm' : ¬ (getCurrentEpoch x.state).toNat /
            max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat <
              (getCurrentEpoch before).toNat /
                max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat := hm
        have hv' : (getCurrentEpoch x.state).toNat /
            max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat <
              (getCurrentEpoch after).toNat /
                max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat := hv
        rw [e] at hv'
        exact hm' hv'
    obtain ⟨ok, rfl⟩ := slotStep
    subst split
    have vEarly : v.fork < .glamsterdam :=
      Nat.lt_of_le_of_lt (fork_le_of_chainSteps post.chainSteps) early
    obtain ⟨Ds, cardDs, hDs⟩ := step_deposit_keys genesis (shared.append pre) (Step.slot ok)
      vEarly delay
    have stepUp := UInt64.le_iff_toNat_le.mp
      (Step.slot ok : Step config checks m v).chainStep.currentEpoch_le
    have postUp := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps post.chainSteps)
    refine ⟨fun j => if j = 0 then (x.state.currentSyncCommittee altair).value.pubkeys.toList
        else Ls₂ (j - 1), B₁ ∪ B₂, S₁ ∪ S₂, D₁ ∪ Ds ∪ D₂, ?_, ?_, ?_, fun i pos => ?_,
      fun i pos => ?_, fun i pos => ?_, fun i hi => ?_, ?_, ?_⟩
    · rw [Run.blockCount_append]
      exact (Finset.card_union_le _ _).trans (Nat.add_le_add cardB₁ cardB₂)
    · refine (Finset.card_union_le _ _).trans ?_
      calc _ ≤ preset.SYNC_COMMITTEE_SIZE.toNat +
            preset.SYNC_COMMITTEE_SIZE.toNat * (n + 1) := Nat.add_le_add cardS₁ cardS₂
        _ = _ := by ring
    · have joined := Nat.mul_le_mul_left preset.MAX_PENDING_DEPOSITS_PER_EPOCH.toNat
        (show ((getCurrentEpoch m.state).toNat - (getCurrentEpoch x.state).toNat) +
          ((getCurrentEpoch v.state).toNat - (getCurrentEpoch m.state).toNat) +
            ((getCurrentEpoch y.state).toNat - (getCurrentEpoch v.state).toNat) ≤
              (getCurrentEpoch y.state).toNat - (getCurrentEpoch x.state).toNat by omega)
      rw [Nat.mul_add, Nat.mul_add] at joined
      exact (Finset.card_union_le _ _).trans (Nat.le_trans (Nat.add_le_add
        ((Finset.card_union_le _ _).trans (Nat.add_le_add cardD₁ cardDs)) cardD₂) joined)
    · rw [grossScan_append] at pos
      by_cases first : 0 < grossScan i high (pre.snoc (Step.slot ok))
      · have prior := grossScan_slot_pos i high pre ok first
        rcases hB₁ i prior with member | ⟨w, found, mem⟩
        · exact .inl (Finset.mem_union_left _ member)
        · exact .inr (Finset.mem_union_left _ (hS₁ i w found mem))
      · have later : 0 < grossScan i high post := by omega
        rcases hB₂ i later with member | member
        · exact .inl (Finset.mem_union_right _ member)
        · exact .inr (Finset.mem_union_right _ member)
    · rw [creditScan_append] at pos
      by_cases first : 0 < (creditScan (fun _ => false) (fun s => decide (s = .deposits)) i high
          (pre.snoc (Step.slot ok)))
      · rw [creditScan_snoc] at first
        split at first
        · by_cases prior : 0 < (creditScan (fun _ => false)
              (fun s => decide (s = .deposits)) i high pre)
          · exact Finset.mem_union_left _ (Finset.mem_union_left _ (hDep₁ i prior))
          · exact Finset.mem_union_left _ (Finset.mem_union_right _ (hDs i (by omega)))
        · exact Finset.mem_union_left _ (Finset.mem_union_left _ (hDep₁ i first))
      · exact Finset.mem_union_right _ (hDep₂ i (by omega))
    · -- a credit in the first part is a proposer or a seat holder, and a seat persists
      rw [grossScan_append] at pos
      by_cases first : 0 < grossScan i high (pre.snoc (Step.slot ok))
      · have prior := grossScan_slot_pos i high pre ok first
        rcases hB₁ i prior with member | ⟨w, found, mem⟩
        · exact .inl (Finset.mem_union_left _ member)
        · have kept := (validatorKeys_prefix_and_distinct_of_chainSteps
            (Relation.ReflTransGen.head (Step.slot ok : Step config checks m v).chainStep
              post.chainSteps)).1
          obtain ⟨w', found', same⟩ := validators_getElem?_of_validatorKeys_prefix kept found
          exact .inr ⟨w', 0, found', Nat.zero_le _, by simpa [same] using mem⟩
      · rcases hG₂ i (by omega) with member | ⟨w, j, found, hj, mem⟩
        · exact .inl (Finset.mem_union_right _ member)
        · exact .inr ⟨w, j + 1, found, by omega, by simpa using mem⟩
    · rcases Finset.mem_union.mp hi with first | later
      · exact hP₁ i first
      · obtain ⟨u, q, p, early', found, same⟩ := hP₂ i later
        exact ⟨u, (pre.snoc (Step.slot ok)).append q, p, early', found, same⟩
    · intro events replayed i pos
      obtain ⟨e1, ok1⟩ := (pre.snoc (Step.slot ok)).balanceEvents_ok vEarly high
      obtain ⟨e2, ok2⟩ := post.balanceEvents_ok early high
      rw [DirectSafety.Apriori.Internal.balanceEvents_append _ _ high ok1 ok2] at replayed
      have joined := Except.ok.inj replayed
      subst joined
      simp only [List.map_append, List.sum_append] at pos
      by_cases first : 0 < ((e1.map (syncDebit i))).sum
      · have seated : ∃ w, m.state.validators.data[i]? = some w ∧
            w.pubkey ∈ (x.state.currentSyncCommittee altair).value.pubkeys.toList := by
          simp only [Run.balanceEvents, bind_ok_iff] at ok1
          obtain ⟨prior, priorOk, rest⟩ := ok1
          split at rest
          · simp only [bind_ok_iff, pure, Except.pure, Except.ok.injEq] at rest
            obtain ⟨added, addedOk, rfl⟩ := rest
            have zero := (PinSeatDebits.slot_syncDebit_zero
              (Nat.le_trans (show Fork.pectra ≤ Fork.fusaka by decide)
                (Nat.le_trans fulu (fork_le_of_chainSteps pre.chainSteps))) ok vEarly addedOk i).1
            simp only [List.map_append, List.sum_append, zero, Nat.add_zero] at first
            exact hD₁ prior priorOk i first
          · simp only [pure, Except.pure, Except.ok.injEq] at rest
            subst rest
            exact hD₁ _ priorOk i first
        obtain ⟨w, found, mem⟩ := seated
        refine ⟨Finset.mem_union_left _ (hS₁ i w found mem), ?_⟩
        have kept := (validatorKeys_prefix_and_distinct_of_chainSteps
          (Relation.ReflTransGen.head (Step.slot ok : Step config checks m v).chainStep
            post.chainSteps)).1
        obtain ⟨w', found', same⟩ := validators_getElem?_of_validatorKeys_prefix kept found
        exact ⟨w', 0, found', Nat.zero_le _, by simpa [same] using mem⟩
      · obtain ⟨inS, w, j, found, hj, mem⟩ := hD₂ e2 ok2 i (by omega)
        exact ⟨Finset.mem_union_right _ inS, w, j + 1, found, by omega, by simpa using mem⟩
    · intro j hj
      by_cases j0 : j = 0
      · subst j0
        exact ⟨x, Run.nil, (pre.snoc (Step.slot ok)).append post, altair, run_nil_append _,
          (Nat.add_zero _).symm, by simp⟩
      · obtain ⟨z, r1, r2, alt, cut, per, hL⟩ := hz₂ (j - 1) (by omega)
        refine ⟨z, (pre.snoc (Step.slot ok)).append r1, r2, alt, ?_, ?_, ?_⟩
        · rw [← Run.append_assoc, cut]
        · omega
        · simpa [j0] using hL

/-- The keys credited in the block steps of a run, counted by the periods that it touches. -/
private theorem credited_pieces {g : ForkedBeaconState preset}
    (genesis : Genesis config checks g)
    (apart : preset.MIN_SEED_LOOKAHEAD.toNat + 2 < preset.EPOCHS_PER_HISTORICAL_VECTOR.toNat)
    {y : ForkedBeaconState preset}
    (early : y.fork < .glamsterdam)
    (delay : 0 < config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat) (high : ℕ) :
    ∀ (n : ℕ) {x : ForkedBeaconState preset}, Run config checks g x →
      ∀ (r : Run config checks x y), .fusaka ≤ x.fork →
    (getCurrentEpoch y.state).toNat / max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat =
      (getCurrentEpoch x.state).toNat / max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat + n →
    ∃ B S D : Finset ℕ, B.card ≤ r.blockCount ∧
      S.card ≤ preset.SYNC_COMMITTEE_SIZE.toNat * (n + 1) ∧
      D.card ≤ preset.MAX_PENDING_DEPOSITS_PER_EPOCH.toNat *
        ((getCurrentEpoch y.state).toNat - (getCurrentEpoch x.state).toNat) ∧
      (∀ i, 0 < grossScan i high r → i ∈ B ∨ i ∈ S) ∧
      (∀ i, 0 < (creditScan (fun _ => false) (fun s => decide (s = .deposits)) i high r) →
        i ∈ D) ∧
      ∀ events, r.balanceEvents high = .ok events → ∀ i, 0 < (events.map (syncDebit i)).sum →
        i ∈ S := by
  intro n x shared r fulu count
  obtain ⟨_, B, S, D, cardB, cardS, cardD, hBS, hDep, -, -, hSD, _⟩ :=
    credited_pieces_seated genesis apart early delay high n shared r fulu count
  exact ⟨B, S, D, cardB, cardS, cardD, hBS, hDep,
    fun events replayed i pos => (hSD events replayed i pos).1⟩

/-- A key of an earlier registry has the same position in a later registry.

The later registry has distinct keys, and the earlier keys are a prefix of the later ones. -/
private theorem position_in_prefix {f f' : Fork} {x : BeaconState preset f}
    {t : BeaconState preset f'} (kept : validatorKeys x <+: validatorKeys t)
    (distinct : PubkeysDistinct t) {pk : Cryptography.Bls.BLSPubkey}
    (mem : pk ∈ validatorKeys x) {i : ℕ} {w : Validator}
    (found : t.validators.data[i]? = some w) (same : w.pubkey = pk) :
    ∃ v, x.validators.data[i]? = some v ∧ v.pubkey = pk := by
  simp only [validatorKeys] at mem
  obtain ⟨v, hv, rfl⟩ := List.mem_map.mp mem
  obtain ⟨j, hj⟩ := List.mem_iff_getElem?.mp hv
  have foundX : x.validators.data[j]? = some v := by simpa using hj
  obtain ⟨cur, foundT, same'⟩ := validators_getElem?_of_validatorKeys_prefix kept foundX
  have index := distinct.index_eq found foundT (same.trans same'.symm)
  subst index
  exact ⟨v, foundX, rfl⟩

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The keys that a sync aggregate debits on the two branches fit the committees of their periods.

The keys of C's run from the finalized block are counted in its committees.

The keys of R's run from the split hold a seat of its committees.

Its first two committees are the current and next ones at the split, which C's run holds too.

So each key counts once, and the later committees of R's run count after C's.

The next committee at the start of a run is the current one at its end, if it crosses a period. -/
private theorem seat_union_card (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (high highC : ℕ)
    {events eventsF eventsC : List (BalanceEvent preset)}
    (replayed : tail.balanceEvents high = .ok events)
    (replayedF : fromFin.balanceEvents highC = .ok eventsF)
    (replayedC : tailC.balanceEvents highC = .ok eventsC)
    (altairF : .altair ≤ fork) (AV AK : Finset ℕ)
    (debitsC : ∀ i ∈ AV, 0 < ((eventsF ++ eventsC).map (syncDebit i)).sum ∨
      (0 < grossScan i highC (fromFin.append tailC) ∧
        ∀ (u : ForkedBeaconState preset) (_ : Run config checks ⟨fork, fin⟩ u) (p : ValidatorIndex),
          u.fork < .glamsterdam → getBeaconProposerIndex u.state = .ok p → p.toNat ≠ i) ∨
      ∃ w, split.validators.data[i]? = some w ∧
        w.pubkey ∈ (split.currentSyncCommittee altairF).value.pubkeys.toList)
    (debitsR : ∀ i ∈ AK, 0 < (events.map (syncDebit i)).sum) :
    (AV ∪ AK).card ≤ preset.SYNC_COMMITTEE_SIZE.toNat *
      (((getCurrentEpoch pulled).toNat + 1) /
          max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat -
        (getCurrentEpoch fin).toNat / max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat + 1 +
      ((getCurrentEpoch pulled).toNat + 2 - anc.finalizedCheckpoint.epoch.toNat) /
        max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat) := by
  classical
  obtain ⟨toFin⟩ := h.toFin
  have apart := h.parameters.lookahead
  have finSplit := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps fromFin.chainSteps)
  have splitPulled := UInt64.le_iff_toNat_le.mp h.called
  have pulledCounted := UInt64.le_iff_toNat_le.mp h.later
  have near := h.near
  have finalized := UInt64.le_iff_toNat_le.mp h.finalized
  simp only at finSplit
  generalize hP : max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat = P at *
  -- the periods of the two runs
  have divFS := Nat.div_le_div_right (c := P) finSplit
  have divSP := Nat.div_le_div_right (c := P) splitPulled
  have divPC := Nat.div_le_div_right (c := P) pulledCounted
  have divCN := Nat.div_le_div_right (c := P) near
  have divSC : (getCurrentEpoch split).toNat / P ≤ (getCurrentEpoch counted).toNat / P :=
    Nat.div_le_div_right (Nat.le_trans splitPulled pulledCounted)
  have divRS : (getCurrentEpoch pulled).toNat / P - (getCurrentEpoch split).toNat / P ≤
      ((getCurrentEpoch pulled).toNat - (getCurrentEpoch split).toNat) / P + 1 := by
    rcases Nat.le_total (getCurrentEpoch pulled).toNat (getCurrentEpoch split).toNat with
      order | order
    · have := Nat.div_le_div_right (c := P) order
      have nonneg :=
        Nat.zero_le (((getCurrentEpoch pulled).toNat - (getCurrentEpoch split).toNat) / P)
      omega
    · obtain ⟨d, hd⟩ := Nat.exists_eq_add_of_le order
      rw [hd, Nat.add_sub_cancel_left]
      have := Nat.add_div_le_div_add_div_add_one (getCurrentEpoch split).toNat d P
      have nonneg := Nat.zero_le (d / P)
      omega
  have divDepth : ((getCurrentEpoch pulled).toNat - (getCurrentEpoch split).toNat) / P ≤
      ((getCurrentEpoch pulled).toNat + 2 - anc.finalizedCheckpoint.epoch.toNat) / P :=
    Nat.div_le_div_right (by omega)
  have periodsR : (getCurrentEpoch pulled).toNat / P =
      (getCurrentEpoch split).toNat / P +
        ((getCurrentEpoch pulled).toNat / P - (getCurrentEpoch split).toNat / P) := by omega
  have periodsC : (getCurrentEpoch counted).toNat / P =
      (getCurrentEpoch fin).toNat / P +
        ((getCurrentEpoch counted).toNat / P - (getCurrentEpoch fin).toNat / P) := by omega
  obtain ⟨LsR, BR, SR, DR, -, -, -, -, -, -, -, debitR, familyR⟩ :=
    credited_pieces_seated h.genesis apart (y := ⟨fork, pulled⟩) h.early h.delay high
      ((getCurrentEpoch pulled).toNat / max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat -
        (getCurrentEpoch split).toNat / max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat)
      (toFin.append fromFin) tail h.fulu (by rw [hP]; exact periodsR)
  obtain ⟨LsC, BC, SC, DC, -, -, -, -, -, grossC, propC, debitC, familyC⟩ :=
    credited_pieces_seated h.genesis apart (y := ⟨fork, counted⟩) h.early h.delay highC
      ((getCurrentEpoch counted).toNat / max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat -
        (getCurrentEpoch fin).toNat / max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat)
      toFin (fromFin.append tailC) h.fulu (by rw [hP]; exact periodsC)
  simp only [hP] at familyR familyC debitR debitC grossC
  have replayedRC : (fromFin.append tailC).balanceEvents highC = .ok (eventsF ++ eventsC) :=
    DirectSafety.Apriori.Internal.balanceEvents_append fromFin tailC highC replayedF replayedC
  have arith : ((getCurrentEpoch counted).toNat / P - (getCurrentEpoch fin).toNat / P + 1) +
      ((getCurrentEpoch pulled).toNat / P - (getCurrentEpoch split).toNat / P - 1) ≤
      ((getCurrentEpoch pulled).toNat + 1) / P - (getCurrentEpoch fin).toNat / P + 1 +
        ((getCurrentEpoch pulled).toNat + 2 - anc.finalizedCheckpoint.epoch.toNat) / P := by
    generalize (getCurrentEpoch counted).toNat / P = A at divCN ⊢
    generalize ((getCurrentEpoch pulled).toNat + 1) / P = B at divCN ⊢
    generalize (getCurrentEpoch fin).toNat / P = F
    generalize (getCurrentEpoch pulled).toNat / P = E at divRS ⊢
    generalize (getCurrentEpoch split).toNat / P = T at divRS ⊢
    generalize ((getCurrentEpoch pulled).toNat - (getCurrentEpoch split).toNat) / P = D1
      at divRS divDepth
    generalize ((getCurrentEpoch pulled).toNat + 2 - anc.finalizedCheckpoint.epoch.toNat) / P = D2
      at divDepth ⊢
    omega
  generalize hnR : (getCurrentEpoch pulled).toNat / P - (getCurrentEpoch split).toNat / P = nR
    at *
  generalize hnC : (getCurrentEpoch counted).toNat / P - (getCurrentEpoch fin).toNat / P = nC
    at *
  -- the current and next committees at the split
  have keysSplit := (toFin.append fromFin).syncCommittee_keys h.genesis altairF
  generalize hLcur : (split.currentSyncCommittee altairF).value.pubkeys.toList = Lcur at *
  generalize hLnext : (split.nextSyncCommittee altairF).value.pubkeys.toList = Lnext at *
  have sizeOf : ∀ {f : Fork} (alt : .altair ≤ f) (b : BeaconState preset f),
      (b.currentSyncCommittee alt).value.pubkeys.toList.length =
        preset.SYNC_COMMITTEE_SIZE.toNat := fun _ _ => Vector.length_toList
  -- R's first two committees are the current and next ones at the split
  have firstR : LsR 0 = Lcur := by
    obtain ⟨z, r1, r2, alt, cut, per, hL⟩ := familyR 0 (Nat.zero_le _)
    have earlyZ : z.fork < .glamsterdam :=
      Nat.lt_of_le_of_lt (fork_le_of_chainSteps r2.chainSteps) h.early
    rw [hL, ← hLcur]
    exact r1.currentSyncCommittee_eq_of_same_period earlyZ (by rw [hP]; simpa using per) alt
      altairF
  have secondR : 1 ≤ nR → LsR 1 = Lnext := fun one => by
    obtain ⟨z, r1, r2, alt, cut, per, hL⟩ := familyR 1 one
    have earlyZ : z.fork < .glamsterdam :=
      Nat.lt_of_le_of_lt (fork_le_of_chainSteps r2.chainSteps) h.early
    rw [hL, ← hLnext]
    exact r1.currentSyncCommittee_eq_nextSyncCommittee_of_next_period earlyZ
      h.facts.syncPeriod (by rw [hP]; simpa using per) alt altairF
  -- C's committees hold them too
  have firstC : ∃ j ≤ nC, LsC j = Lcur := by
    refine ⟨(getCurrentEpoch split).toNat / P - (getCurrentEpoch fin).toNat / P, by omega, ?_⟩
    obtain ⟨z, r1, r2, alt, cut, per, hL⟩ := familyC
      ((getCurrentEpoch split).toNat / P - (getCurrentEpoch fin).toNat / P) (by omega)
    have earlyZ : z.fork < .glamsterdam :=
      Nat.lt_of_le_of_lt (fork_le_of_chainSteps r2.chainSteps) h.early
    rw [hL, ← hLcur]
    rcases Run.prefix_total r1 r2 fromFin tailC cut rfl with ⟨r, -⟩ | ⟨r, -⟩
    · exact (r.currentSyncCommittee_eq_of_same_period h.early
        (by rw [hP]; simp only; omega) altairF alt).symm
    · exact r.currentSyncCommittee_eq_of_same_period earlyZ
        (by rw [hP]; simp only; omega) alt altairF
  have secondC : 1 ≤ nR → ∃ j ≤ nC, LsC j = Lnext := fun one => by
    refine ⟨(getCurrentEpoch split).toNat / P - (getCurrentEpoch fin).toNat / P + 1,
      by omega, ?_⟩
    obtain ⟨z, r1, r2, alt, cut, per, hL⟩ := familyC
      ((getCurrentEpoch split).toNat / P - (getCurrentEpoch fin).toNat / P + 1) (by omega)
    have earlyZ : z.fork < .glamsterdam :=
      Nat.lt_of_le_of_lt (fork_le_of_chainSteps r2.chainSteps) h.early
    rw [hL, ← hLnext]
    rcases Run.prefix_total r1 r2 fromFin tailC cut rfl with ⟨r, -⟩ | ⟨r, -⟩
    · exfalso
      have order := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps r.chainSteps)
      simp only at order
      have := Nat.div_le_div_right (c := P) order
      omega
    · exact r.currentSyncCommittee_eq_nextSyncCommittee_of_next_period earlyZ
        h.facts.syncPeriod (by rw [hP]; simp only; omega) alt altairF
  -- the positions that hold a key of the committees of each run
  have distinctR : PubkeysDistinct pulled :=
    ((toFin.append fromFin).append tail).pubkeysDistinct h.genesis
  have distinctC : PubkeysDistinct counted :=
    (toFin.append (fromFin.append tailC)).pubkeysDistinct h.genesis
  have eachC : ∀ L ∈ (List.range (nC + 1)).map LsC, L.length ≤ preset.SYNC_COMMITTEE_SIZE.toNat :=
    fun L member => by
      obtain ⟨j, hj, rfl⟩ := List.mem_map.mp member
      obtain ⟨z, r1, r2, alt, cut, per, hL⟩ := familyC j (by
        have := List.mem_range.mp hj
        omega)
      rw [hL]
      exact (sizeOf alt z.state).le
  have eachR : ∀ L ∈ (List.range' 2 (nR - 1)).map LsR,
      L.length ≤ preset.SYNC_COMMITTEE_SIZE.toNat := fun L member => by
    obtain ⟨j, hj, rfl⟩ := List.mem_map.mp member
    obtain ⟨z, r1, r2, alt, cut, per, hL⟩ := familyR j (by
      have := List.mem_range'_1.mp hj
      omega)
    rw [hL]
    exact (sizeOf alt z.state).le
  have cardC := listed_positions_card counted distinctC _ eachC
  have cardR := listed_positions_card pulled distinctR _ eachR
  rw [List.length_map, List.length_range] at cardC
  rw [List.length_map, List.length_range'] at cardR
  have keptR := (validatorKeys_prefix_and_distinct_of_chainSteps tail.chainSteps).1
  have keptC := (validatorKeys_prefix_and_distinct_of_chainSteps tailC.chainSteps).1
  have union_le := le_trans (Finset.card_union_le _ _) (Nat.add_le_add cardC cardR)
  refine le_trans (Finset.card_le_card ?_) (le_trans union_le ?_)
  · intro i member
    rcases Finset.mem_union.mp member with inV | inK
    · -- a key debited or credited on C's run holds a seat, unless it is a proposer
      obtain ⟨w, j, found, hj, mem⟩ : ∃ (w : Validator) (j : ℕ),
          counted.validators.data[i]? = some w ∧ j ≤ nC ∧ w.pubkey ∈ LsC j := by
        rcases debitsC i inV with spent | ⟨seen, notProposer⟩ | ⟨ws, foundS, memS⟩
        · obtain ⟨-, w, j, found, hj, mem⟩ := debitC (eventsF ++ eventsC) replayedRC i spent
          exact ⟨w, j, found, hj, mem⟩
        · rcases grossC i seen with proposed | ⟨w, j, found, hj, mem⟩
          · obtain ⟨u, q, p, early', found, same⟩ := propC i proposed
            exact absurd same (notProposer u q p early' found)
          · exact ⟨w, j, found, hj, mem⟩
        · -- a seat of the split's current committee, which C's committees hold
          obtain ⟨jc, hjc, e⟩ := firstC
          obtain ⟨c, foundC, sameC⟩ := validators_getElem?_of_validatorKeys_prefix keptC foundS
          exact ⟨c, jc, foundC, hjc, by rw [sameC, e]; exact memS⟩
      exact Finset.mem_union_left _ (Finset.mem_filter.mpr
        ⟨Finset.mem_range.mpr (Array.getElem?_eq_some_iff.mp found).1, w, found, LsC j,
          List.mem_map.mpr ⟨j, List.mem_range.mpr (by omega), rfl⟩, mem⟩)
    · obtain ⟨-, w, j, found, hj, mem⟩ := debitR events replayed i (debitsR i inK)
      by_cases late : 2 ≤ j
      · exact Finset.mem_union_right _ (Finset.mem_filter.mpr
          ⟨Finset.mem_range.mpr (Array.getElem?_eq_some_iff.mp found).1, w, found, LsR j,
            List.mem_map.mpr ⟨j, List.mem_range'_1.mpr (by omega), rfl⟩, mem⟩)
      · -- a seat of the first two committees: the key is at its position in the split
        have inSplit : w.pubkey ∈ validatorKeys split ∧
            ∃ L ∈ (List.range (nC + 1)).map LsC, w.pubkey ∈ L := by
          rcases Nat.lt_or_ge j 1 with zero | one
          · have j0 : j = 0 := by omega
            subst j0
            rw [firstR] at mem
            obtain ⟨L, hL, hLmem⟩ : ∃ L ∈ (List.range (nC + 1)).map LsC, L = Lcur := by
              obtain ⟨jc, hjc, e⟩ := firstC
              exact ⟨LsC jc, List.mem_map.mpr ⟨jc, List.mem_range.mpr (by omega), rfl⟩, e⟩
            exact ⟨keysSplit.1 w.pubkey mem, L, hL,
              by rw [hLmem]; exact mem⟩
          · have j1 : j = 1 := by omega
            subst j1
            have oneR : 1 ≤ nR := hj
            rw [secondR oneR] at mem
            obtain ⟨L, hL, hLmem⟩ : ∃ L ∈ (List.range (nC + 1)).map LsC, L = Lnext := by
              obtain ⟨jc, hjc, e⟩ := secondC oneR
              exact ⟨LsC jc, List.mem_map.mpr ⟨jc, List.mem_range.mpr (by omega), rfl⟩, e⟩
            exact ⟨keysSplit.2 w.pubkey mem, L, hL,
              by rw [hLmem]; exact mem⟩
        obtain ⟨inKeys, L, hL, hLmem⟩ := inSplit
        obtain ⟨v, foundS, sameS⟩ := position_in_prefix keptR distinctR inKeys found rfl
        obtain ⟨c, foundC, sameC⟩ := validators_getElem?_of_validatorKeys_prefix keptC foundS
        exact Finset.mem_union_left _ (Finset.mem_filter.mpr
          ⟨Finset.mem_range.mpr (Array.getElem?_eq_some_iff.mp foundC).1, c, foundC, L, hL,
            by rw [sameC, sameS]; exact hLmem⟩)
  · rw [← Nat.mul_add]
    exact Nat.mul_le_mul_left _ arith

/-- The keys that a run from the split credits or debits through a sync seat.

They are at most its proposers, its seat holders and its deposit recipients.

A key counts if a block step of the run nets it a rise, or an epoch pass applies a deposit to it.

A block step has one proposer, and an epoch has at most one block for each slot.

The seat holders are those of one sync committee for each period that the run touches.

An epoch pass applies at most `MAX_PENDING_DEPOSITS_PER_EPOCH` deposits.

A key that a sync aggregate debits holds a seat of the committee of its period. -/
private theorem banded_keys_le (h : Setting config checks g split fin pulled anc counted V)
    {x : BeaconState preset fork} (tail : Run config checks ⟨fork, split⟩ ⟨fork, x⟩) (high : ℕ)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    (keys : Finset ℕ) (banded : ∀ i ∈ keys, 0 < grossScan i high tail +
      (creditScan (fun _ => false) (fun s => decide (s = .deposits)) i high tail) +
        (events.map (syncDebit i)).sum) :
    keys.card ≤
      ((getCurrentEpoch x).toNat - (getCurrentEpoch split).toNat + 1) *
          (preset.SLOTS_PER_EPOCH.toNat + preset.MAX_PENDING_DEPOSITS_PER_EPOCH.toNat) +
        preset.SYNC_COMMITTEE_SIZE.toNat *
          ((getCurrentEpoch x).toNat / max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat -
            (getCurrentEpoch split).toNat / max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat +
              1) := by
  classical
  obtain ⟨toFin⟩ := h.toFin
  obtain ⟨fromFin⟩ := h.fromFin
  have apart := h.parameters.lookahead
  have shared : Run config checks g ⟨fork, split⟩ := toFin.append fromFin
  have slots := h.twoSlots
  have positive : 0 < preset.SLOTS_PER_EPOCH.toNat := by omega
  have low : (getCurrentEpoch split).toNat ≤ (getCurrentEpoch x).toNat :=
    UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps tail.chainSteps)
  have periodLe := Nat.div_le_div_right
    (c := max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat) low
  have periods : (getCurrentEpoch x).toNat / max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat =
      (getCurrentEpoch split).toNat / max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat +
        ((getCurrentEpoch x).toNat / max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat -
          (getCurrentEpoch split).toNat /
            max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat) := by omega
  obtain ⟨B, S, D, cardB, cardS, cardD, hBS, hD, hSD⟩ := credited_pieces h.genesis apart
    (y := ⟨fork, x⟩) h.early h.delay high
    ((getCurrentEpoch x).toNat / max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat -
      (getCurrentEpoch split).toNat / max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat)
    shared tail h.fulu periods
  have cardD' : D.card ≤ preset.MAX_PENDING_DEPOSITS_PER_EPOCH.toNat *
      ((getCurrentEpoch x).toNat - (getCurrentEpoch split).toNat) := cardD
  have subset : keys ⊆ B ∪ S ∪ D := fun i member => by
    have pos := banded i member
    by_cases net : 0 < grossScan i high tail
    · rcases hBS i net with inB | inS
      · exact Finset.mem_union_left _ (Finset.mem_union_left _ inB)
      · exact Finset.mem_union_left _ (Finset.mem_union_right _ inS)
    · by_cases dep : 0 < (creditScan (fun _ => false) (fun s => decide (s = .deposits)) i high
          tail)
      · exact Finset.mem_union_right _ (hD i dep)
      · exact Finset.mem_union_left _ (Finset.mem_union_right _ (hSD events replayed i (by omega)))
  -- The blocks of the run are at most one for each slot of its epochs.
  have blocks : tail.blockCount ≤
      ((getCurrentEpoch x).toNat - (getCurrentEpoch split).toNat + 1) *
        preset.SLOTS_PER_EPOCH.toNat := by
    have count : tail.blockCount ≤
        ((getCurrentEpoch x).toNat + 1 - (getCurrentEpoch split).toNat) *
          preset.SLOTS_PER_EPOCH.toNat := PinSeatDebits.Run.blockCount_le_epochs tail positive
    have same : (getCurrentEpoch x).toNat + 1 - (getCurrentEpoch split).toNat =
        (getCurrentEpoch x).toNat - (getCurrentEpoch split).toNat + 1 := by omega
    rw [same] at count
    exact count
  have total := (Finset.card_le_card subset).trans
    ((Finset.card_union_le _ _).trans (Nat.add_le_add_right (Finset.card_union_le _ _) _))
  have expand : ((getCurrentEpoch x).toNat - (getCurrentEpoch split).toNat + 1) *
      (preset.SLOTS_PER_EPOCH.toNat + preset.MAX_PENDING_DEPOSITS_PER_EPOCH.toNat) =
        ((getCurrentEpoch x).toNat - (getCurrentEpoch split).toNat + 1) *
          preset.SLOTS_PER_EPOCH.toNat + preset.MAX_PENDING_DEPOSITS_PER_EPOCH.toNat *
            ((getCurrentEpoch x).toNat - (getCurrentEpoch split).toNat) +
              preset.MAX_PENDING_DEPOSITS_PER_EPOCH.toNat := by ring
  omega

/-- The keys that a run from the split credits.

They are at most its proposers, its seat holders and its deposit recipients. -/
private theorem credited_keys_le (h : Setting config checks g split fin pulled anc counted V)
    {x : BeaconState preset fork} (tail : Run config checks ⟨fork, split⟩ ⟨fork, x⟩) (high : ℕ) :
    ((Finset.range x.validators.data.size).filter fun i =>
        0 < grossScan i high tail +
          (creditScan (fun _ => false) (fun s => decide (s = .deposits)) i high tail)).card ≤
      ((getCurrentEpoch x).toNat - (getCurrentEpoch split).toNat + 1) *
          (preset.SLOTS_PER_EPOCH.toNat + preset.MAX_PENDING_DEPOSITS_PER_EPOCH.toNat) +
        preset.SYNC_COMMITTEE_SIZE.toNat *
          ((getCurrentEpoch x).toNat / max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat -
            (getCurrentEpoch split).toNat / max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat +
              1) := by
  obtain ⟨events, replayed⟩ := tail.balanceEvents_ok h.early high
  exact banded_keys_le h tail high replayed _ fun i member => by
    have pos := (Finset.mem_filter.mp member).2
    omega

/-! ## The classes of keys and their costs -/

section Costs

variable (pulled counted : BeaconState preset fork) (V : Finset ValidatorIndex)

/-- The keys active at C. -/
private def AC := activeVoters counted

/-- The keys active at R. -/
private def AR := activeVoters pulled

/-- The keys counted in C's quorum. -/
private def Q := quorumVoters counted

/-- The keys that the costs sum over: counted at C, or active at C or R. -/
private def U := Q counted ∪ AC counted ∪ AR pulled

/-- The balance of a key at C. -/
private def eC (v : ValidatorIndex) : ℕ := balanceAt counted v.toNat

/-- The balance of a key at R. -/
private def eR (v : ValidatorIndex) : ℕ := balanceAt pulled v.toNat

/-- V keys active in C: twice their fall. -/
private def cV1 : ℤ := ∑ v ∈ U pulled counted,
  if v ∈ V ∧ v ∈ AC counted then (eR pulled v : ℤ) - eC counted v else 0

/-- V keys not active in C: twice their stake at R. -/
private def cV2 : ℤ :=
  ∑ v ∈ U pulled counted, if v ∈ V ∧ v ∉ AC counted then (eR pulled v : ℤ) else 0

/-- (K4 pulled counted V), other keys active in both and counted in C: once their rise. -/
private def cN : ℤ := ∑ v ∈ U pulled counted,
  if v ∈ AC counted ∧ v ∈ AR pulled ∧ v ∈ Q counted ∧ v ∉ V then
    (eC counted v : ℤ) - eR pulled v else 0

/-- (K5 counted V), other keys previous-epoch-only in C: three times their stake at C. -/
private def cP : ℤ := ∑ v ∈ U pulled counted,
  if v ∈ Q counted ∧ v ∉ AC counted ∧ v ∉ V then (eC counted v : ℤ) else 0

/-- (K6 pulled counted), keys counted in C and not active at R: once their stake at C. -/
private def cJ : ℤ := ∑ v ∈ U pulled counted,
  if v ∈ AC counted ∧ v ∈ Q counted ∧ v ∉ AR pulled then (eC counted v : ℤ) else 0

/-- The keys active at C and outside its quorum (slashed at C): minus twice their stake at C.

It also subtracts their stake at R if they are active there. -/
private def cK7 : ℤ := ∑ v ∈ U pulled counted,
  if v ∈ AC counted ∧ v ∉ Q counted then
    -(2 * (eC counted v : ℤ)) - (if v ∈ AR pulled then (eR pulled v : ℤ) else 0) else 0

/-- cS, other keys active at R, not at C and outside C's quorum: minus their stake at R. -/
private def cS : ℤ := ∑ v ∈ U pulled counted,
  if v ∈ AR pulled ∧ v ∉ AC counted ∧ v ∉ Q counted ∧ v ∉ V then -(eR pulled v : ℤ) else 0

/-- The keys of `V` not active at C. -/
private def VN : Finset ValidatorIndex := V.filter (· ∉ AC counted)

/-- The keys outside `V` active at C and R and counted in C's quorum. -/
private def K4 : Finset ValidatorIndex :=
  (AC counted).filter fun v => v ∈ AR pulled ∧ v ∈ Q counted ∧ v ∉ V

/-- The keys outside `V` counted in C's quorum but not active at C. -/
private def K5 : Finset ValidatorIndex := (Q counted).filter fun v => v ∉ AC counted ∧ v ∉ V

/-- The keys active and counted at C but not active at R. -/
private def K6 : Finset ValidatorIndex := (AC counted).filter fun v => v ∈ Q counted ∧ v ∉ AR pulled

/-- SC, keys of R's registry unslashed at the split and slashed at C. -/
private def SC (split : BeaconState preset fork) : Finset ValidatorIndex :=
  ((Finset.range pulled.validators.data.size).image UInt64.ofNat).filter fun v =>
    slashedFlagAt counted v.toNat = some true ∧ slashedFlagAt split v.toNat = some false

/-- Keys created beyond the split's registry and slashed at C. -/
private def CS (split : BeaconState preset fork) : Finset ValidatorIndex :=
  ((Finset.range counted.validators.data.size).image UInt64.ofNat).filter fun v =>
    split.validators.data.size ≤ v.toNat ∧ slashedFlagAt counted v.toNat = some true

end Costs

/-! ## Sums over validator indices, read at positions -/

/-- A position that holds a validator and meets a test is among the positions that meet it. -/
private theorem mem_positions_filter (config : Config)
    (state ancestor finalizedState : BeaconState preset fork) {i : ℕ} {w : Validator}
    (found : state.validators.data[i]? = some w) {p : ℕ → Prop} [DecidablePred p] (test : p i) :
    i ∈ (pinTerms config state ancestor finalizedState).positions.filter p :=
  Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (Array.getElem?_eq_some_iff.mp found).1, test⟩

/-- A flag read from the validator at a position can hold only where the position holds one.

The flag is the `any` of the validator, or its `map` read with a default of `false`. -/
private theorem validator_of_flag {state : BeaconState preset fork} {i : ℕ} {f : Validator → Bool}
    (flag : (state.validators.data[i]?).any f = true ∨
      ((state.validators.data[i]?).map f).getD false = true) :
    ∃ w, state.validators.data[i]? = some w := by
  cases found : state.validators.data[i]? with
  | none =>
    rw [found] at flag
    simp at flag
  | some w => exact ⟨w, rfl⟩

/-- A voter active at the epoch of a state holds a validator there that is active at that epoch. -/
private theorem active_of_activeVoters (early : fork < .glamsterdam)
    {s : BeaconState preset fork} {v : ValidatorIndex} (member : v ∈ activeVoters s) :
    ∃ w, s.validators.data[v.toNat]? = some w ∧
      isActiveValidator w (getCurrentEpoch s) = true := by
  have listed : v ∈ getActiveValidatorIndices s (getCurrentEpoch s) := by
    simpa [activeVoters] using member
  exact (mem_getActiveValidatorIndices (s.validators.bound early)).mp listed

/-! ## The bounds of the terms -/

section Terms
variable {g : ForkedBeaconState preset} {split fin pulled anc counted : BeaconState preset fork}
  {V : Finset ValidatorIndex}

/-- Activity up to the seed lookahead after the split is the same at R and C. -/
private theorem activity_shared {g : ForkedBeaconState preset}
    {split fin pulled anc counted : BeaconState preset fork} {V : Finset ValidatorIndex}
    (h : Setting config checks g split fin pulled anc counted V) {e : Epoch}
    (fixed : e.toNat ≤ (getCurrentEpoch split).toNat + preset.MAX_SEED_LOOKAHEAD.toNat)
    (i : ℕ) : isActiveAt pulled e i = isActiveAt counted e i := by
  obtain ⟨rp⟩ := h.toPulled
  obtain ⟨rc⟩ := h.toCounted
  have inside : e ≤ activityFixedEpoch split := by
    rw [UInt64.le_iff_toNat_le, activityFixedEpoch_toNat]
    have := e.toNat_lt
    omega
  exact (activeKept_of_chainSteps rp.chainSteps e inside i).trans
    (activeKept_of_chainSteps rc.chainSteps e inside i).symm

/-- A key active at C's epoch is activated by then at R, when that epoch is within the lookahead.

Activity up to the seed lookahead after the split is the same on both branches. -/
private theorem activation_le_of_active {g : ForkedBeaconState preset}
    {split fin pulled anc counted : BeaconState preset fork} {V : Finset ValidatorIndex}
    (h : Setting config checks g split fin pulled anc counted V)
    (bound : (getCurrentEpoch counted).toNat ≤
      anc.finalizedCheckpoint.epoch.toNat + preset.MAX_SEED_LOOKAHEAD.toNat)
    {v : ValidatorIndex} (member : v ∈ AC counted) {w : Validator}
    (found : pulled.validators.data[v.toNat]? = some w) :
    w.activationEpoch.toNat ≤ (getCurrentEpoch counted).toNat := by
  have finalized := UInt64.le_iff_toNat_le.mp h.finalized
  obtain ⟨u, foundU, activeU⟩ := active_of_activeVoters h.early member
  have activeAtC : isActiveAt counted (getCurrentEpoch counted) v.toNat = true :=
    isActiveAt_eq_true_iff.mpr ⟨u, foundU, activeU⟩
  have activeAtR : isActiveAt pulled (getCurrentEpoch counted) v.toNat = true := by
    rw [activity_shared h (e := getCurrentEpoch counted) (by omega) v.toNat]
    exact activeAtC
  obtain ⟨w', found', active⟩ := isActiveAt_eq_true_iff.mp activeAtR
  rw [found] at found'
  cases found'
  simp only [isActiveValidator, Bool.and_eq_true, decide_eq_true_eq] at active
  exact UInt64.le_iff_toNat_le.mp active.1

/-- Glue: an unslashed V key active in C counts in C's quorum. -/
private theorem glue_quorum (h : Setting config checks g split fin pulled anc counted V) :
    ∀ v ∈ V, v ∈ AC counted → v ∈ Q counted := by
  intro v member active
  have unslashed := (h.voting v member).2
  have listed : v ∈ getActiveValidatorIndices counted (getCurrentEpoch counted) := by
    simpa [AC, activeVoters] using active
  have inside := lt_size_of_mem_getActiveValidatorIndices listed
  have found : counted.validators.data[v.toNat]? = some counted.validators.data[v.toNat] :=
    Array.getElem?_eq_getElem inside
  have flag : ((counted.validators.data[v.toNat]?).map (·.slashed)).getD true = false := by
    simpa [slashedFlagAt, found] using unslashed
  simp only [Q, quorumVoters, Finset.mem_filter, List.mem_toFinset, List.mem_append]
  exact ⟨.inl listed, flag⟩

/-- The two costs of V keys are the fall of those active in C and the stake of the others. -/
private theorem cV_split (h : Setting config checks g split fin pulled anc counted V) :
    cV1 pulled counted V + cV2 pulled counted V =
      ∑ v ∈ V.filter (· ∈ AC counted), ((eR pulled v : ℤ) - eC counted v) +
        ∑ v ∈ VN counted V, (eR pulled v : ℤ) := by
  classical
  have sub : V ⊆ U pulled counted := fun v hv =>
    Finset.mem_union_right _ (h.voting v hv).1
  unfold cV1 cV2 VN
  congr 1
  · rw [← Finset.sum_filter]
    refine Finset.sum_congr ?_ fun _ _ => rfl
    ext v
    simp only [Finset.mem_filter]
    exact ⟨fun ⟨_, a, b⟩ => ⟨a, b⟩, fun ⟨a, b⟩ => ⟨sub a, a, b⟩⟩
  · rw [← Finset.sum_filter]
    refine Finset.sum_congr ?_ fun _ _ => rfl
    ext v
    simp only [Finset.mem_filter]
    exact ⟨fun ⟨_, a, b⟩ => ⟨a, b⟩, fun ⟨a, b⟩ => ⟨sub a, a, b⟩⟩

/-- The fall of the V keys, from their per-key facts.

The first fact is for a V key that is active in C: its fall and what C's floor leaves out.

The floor leaves out the key's sync debits from the finalized block, and their rounding band.

The second is for a V key that is not active in C: the same, and the charges that the sum names.

The shared run from the finalized block adds the key's sync debits to the sum.

C's tail adds its sync movement. -/
private theorem cV_le_of (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩)
    {eventsF eventsC : List (BalanceEvent preset)}
    (active : ∀ v ∈ V, v ∈ AC counted → (eR pulled v : ℤ) - eC counted v ≤
      ((pinTerms config pulled anc fin).fall v.toNat : ℤ) +
        ((eventsF.map (syncDebit v.toNat)).sum + syncF eventsC v.toNat) +
          bandR (eventsF ++ eventsC) v.toNat)
    (left : ∀ v ∈ VN counted V, (eR pulled v : ℤ) ≤
      ((pinTerms config pulled anc fin).fall v.toNat +
        ((eventsF.map (syncDebit v.toNat)).sum + syncF eventsC v.toNat) +
        bandR (eventsF ++ eventsC) v.toNat + exitQ tailC v.toNat +
        (if (pinTerms config pulled anc fin).exitingB v.toNat = true then eR pulled v else 0) +
        (if (pinTerms config pulled anc fin).lateB v.toNat = true then eR pulled v else 0) : ℕ)) :
    cV1 pulled counted V + cV2 pulled counted V ≤
      ((∑ v ∈ V, (pinTerms config pulled anc fin).fall v.toNat) +
        (∑ v ∈ V, ((eventsF.map (syncDebit v.toNat)).sum + syncF eventsC v.toNat)) +
        (∑ v ∈ V, bandR (eventsF ++ eventsC) v.toNat) +
        (∑ v ∈ (VN counted V), exitQ tailC v.toNat) +
        (∑ v ∈ (VN counted V) with (pinTerms config pulled anc fin).exitingB v.toNat = true,
          eR pulled v) +
        (∑ v ∈ (VN counted V) with (pinTerms config pulled anc fin).lateB v.toNat = true,
          eR pulled v) : ℕ) := by
  classical
  rw [cV_split h]
  -- the bound of each key that does not depend on how it left
  let P : ValidatorIndex → ℕ := fun v =>
    (pinTerms config pulled anc fin).fall v.toNat +
      ((eventsF.map (syncDebit v.toNat)).sum + syncF eventsC v.toNat) +
        bandR (eventsF ++ eventsC) v.toNat
  let X : ValidatorIndex → ℕ := fun v =>
    exitQ tailC v.toNat +
      (if (pinTerms config pulled anc fin).exitingB v.toNat = true then eR pulled v else 0) +
      (if (pinTerms config pulled anc fin).lateB v.toNat = true then eR pulled v else 0)
  have first : ∑ v ∈ V.filter (· ∈ AC counted), ((eR pulled v : ℤ) - eC counted v) ≤
      ∑ v ∈ V.filter (· ∈ AC counted), (P v : ℤ) := by
    refine Finset.sum_le_sum fun v hv => ?_
    obtain ⟨member, act⟩ := Finset.mem_filter.mp hv
    have := active v member act
    simp only [P]
    push_cast at this ⊢
    omega
  have second : ∑ v ∈ VN counted V, (eR pulled v : ℤ) ≤
      ∑ v ∈ VN counted V, ((P v : ℤ) + X v) := by
    refine Finset.sum_le_sum fun v hv => ?_
    have := left v hv
    simp only [P, X]
    push_cast at this ⊢
    omega
  have partition : ∑ v ∈ V, (P v : ℤ) =
      ∑ v ∈ V.filter (· ∈ AC counted), (P v : ℤ) + ∑ v ∈ VN counted V, (P v : ℤ) := by
    unfold VN
    exact (Finset.sum_filter_add_sum_filter_not V (· ∈ AC counted) _).symm
  have total : ∑ v ∈ V, (P v : ℤ) =
      ((∑ v ∈ V, (pinTerms config pulled anc fin).fall v.toNat) +
        (∑ v ∈ V, ((eventsF.map (syncDebit v.toNat)).sum + syncF eventsC v.toNat)) +
        (∑ v ∈ V, bandR (eventsF ++ eventsC) v.toNat) : ℕ) := by
    simp only [P]
    push_cast
    simp only [Finset.sum_add_distrib]
  have exits : ∑ v ∈ VN counted V, (X v : ℤ) =
      ((∑ v ∈ (VN counted V), exitQ tailC v.toNat) +
        (∑ v ∈ (VN counted V) with (pinTerms config pulled anc fin).exitingB v.toNat = true,
          eR pulled v) +
        (∑ v ∈ (VN counted V) with (pinTerms config pulled anc fin).lateB v.toNat = true,
          eR pulled v) : ℕ) := by
    simp only [X, Finset.sum_filter]
    push_cast
    simp only [Finset.sum_add_distrib]
  have split : ∑ v ∈ VN counted V, ((P v : ℤ) + X v) =
      ∑ v ∈ VN counted V, (P v : ℤ) + ∑ v ∈ VN counted V, (X v : ℤ) := Finset.sum_add_distrib
  push_cast at total exits ⊢
  omega

/-- A key that is unslashed at the end of a run is unslashed at its start.

A slashed validator stays slashed at its index along a run. -/
private theorem unslashed_of_run {x y : ForkedBeaconState preset} (run : Run config checks x y)
    {i : ℕ} {a : Validator} (found : x.state.validators.data[i]? = some a)
    (clean : ∀ w, y.state.validators.data[i]? = some w → w.slashed = false) :
    a.slashed = false := by
  cases flag : a.slashed
  · rfl
  · obtain ⟨u, read, marked⟩ := run.slashedPersistence i a found flag
    simp [clean u read] at marked

/-- The guards of the floor trace of a run from a state `zs` of the run from the finalized block.

The run ends at any state `y` that is at most one epoch after `pulled`.

The slashing quotient at `zs` is the guard's, which is positive.

The window of the slashing vector and the slashing quotient of each step are the guard's.

No upgrade runs from Fulu, so no step records a crossing.

It is the part of the floor of a key, on R's run and on C's, that does not read the key. -/
private theorem floor_guards (h : Setting config checks g split fin pulled anc counted V)
    {zs y : BeaconState preset fork} (pre : Run config checks ⟨fork, fin⟩ ⟨fork, zs⟩)
    (endpoint : (getCurrentEpoch y).toNat ≤ (getCurrentEpoch pulled).toNat + 1) :
    0 < DirectSafety.Apriori.minSlashingPenaltyQuotient preset
      (DirectSafety.Apriori.preElectraEpochs config ⟨fork, zs⟩ (getCurrentEpoch pulled).toNat) ∧
    ∀ {m n : ForkedBeaconState preset}, Run config checks ⟨fork, zs⟩ m →
      ∀ step : Step config checks m n, Run config checks n ⟨fork, y⟩ →
      (getCurrentEpoch m.state).toNat < (getCurrentEpoch zs).toNat +
        preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat -
          (preset.EPOCHS_PER_SLASHINGS_VECTOR / 2).toNat ∧
      DirectSafety.Apriori.minSlashingPenaltyQuotient preset
        (DirectSafety.Apriori.preElectraEpochs config ⟨fork, zs⟩
          (getCurrentEpoch pulled).toNat) ≤
        (EthLib.Consensus.parameters preset m.fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat ∧
      ∀ events, step.balanceEvents = .ok events → ∀ e ∈ events, e.source ≠ .crossing := by
  obtain ⟨toFin⟩ := h.toFin
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  have finZ : (getCurrentEpoch fin).toNat ≤ (getCurrentEpoch zs).toNat :=
    UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps pre.chainSteps)
  have atFin := DirectSafety.Apriori.Internal.slashing_quotient_of_electra (config := config)
    (checks := checks) (high := (getCurrentEpoch pulled).toNat)
    (Run.nil : Run config checks ⟨fork, fin⟩ ⟨fork, fin⟩) electra
  have atZ := DirectSafety.Apriori.Internal.slashing_quotient_of_electra (config := config)
    (checks := checks) (high := (getCurrentEpoch pulled).toNat)
    (Run.nil : Run config checks ⟨fork, zs⟩ ⟨fork, zs⟩) electra
  refine ⟨?_, fun before step after => ⟨?_, ?_, ?_⟩⟩
  · obtain ⟨_, _, _, _, _, _, _, quotient, _⟩ := h.guard
    rw [atZ, ← atFin]
    exact quotient
  · have window := DirectSafety.Apriori.Internal.short_window_of_guard h.guard endpoint
      ((Run.nil.snoc step).append after)
    simp only at window ⊢
    omega
  · exact (DirectSafety.Apriori.Internal.slashing_quotient_of_electra before electra).le
  · intro added addedOk
    exact DirectSafety.Apriori.Internal.no_crossing_of_regime (toFin.append pre) before
      h.genesis h.caps step
      (Nat.lt_of_le_of_lt (fork_le_of_chainSteps after.chainSteps) h.early)
      (.inl (Nat.le_trans electra (fork_le_of_chainSteps before.chainSteps))) addedOk

/-- R's balance of a key that does not exit in the window falls only by its debit events.

The floor starts from the smaller of the key's balance at a state `zs` of R's run and its cap.

The state `zs` lies on R's run from the finalized block, and the rest of the run leads to `pulled`.

The guards of the floor trace come from the setting's guard at the finalized block.

The window of the slashing vector and the slashing quotient are the guard's.

No upgrade runs from Fulu, so no step records a crossing. -/
private theorem key_floorR_from (h : Setting config checks g split fin pulled anc counted V)
    {zs : BeaconState preset fork} (pre : Run config checks ⟨fork, fin⟩ ⟨fork, zs⟩)
    (rest : Run config checks ⟨fork, zs⟩ ⟨fork, pulled⟩) (high : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    {events : List (BalanceEvent preset)} (replayed : rest.balanceEvents high = .ok events)
    (i : ValidatorIndex) (val : Validator)
    (initial : zs.validators.data[i.toNat]? = some val) (unslashed : val.slashed = false)
    (stays : ∀ w, pulled.validators.data[i.toNat]? = some w → w.slashed = false)
    (retained : ∀ {m n : ForkedBeaconState preset} (before : Run config checks ⟨fork, zs⟩ m)
      (step : Step config checks m n) (after : Run config checks n ⟨fork, pulled⟩),
      (before.snoc step).append after = rest → ∀ w,
      n.state.validators.data[i.toNat]? = some w → high + 1 < w.exitEpoch.toNat ∨
        ∀ u, m.state.validators.data[i.toNat]? = some u → high + 1 < u.withdrawableEpoch.toNat) :
    min (actualBalanceAt ⟨fork, zs⟩ i.toNat)
        (withdrawalMaxEffectiveBalance preset fork val).toNat ≤
      actualBalanceAt ⟨fork, pulled⟩ i.toNat +
        (events.map (DirectSafety.Apriori.Internal.penaltyDebit i.toNat)).sum +
        (events.map (syncDebit i.toNat)).sum +
        (events.map (DirectSafety.Apriori.Internal.floorPartialDebit i)).sum := by
  obtain ⟨toFin⟩ := h.toFin
  obtain ⟨positive, guards⟩ := floor_guards h pre (y := pulled) (Nat.le_succ _)
  refine Run.balanceFloor_events_or_fulu (toFin.append pre) rest h.genesis h.caps h.delay
    h.early high endEpoch i val initial unslashed (Or.inr h.fulu) _ positive ?_ stays replayed
  intro m n before step after cut w found
  exact ⟨retained before step after cut w found, guards before step after⟩

/-- From Fusaka and before Gloas, the parameters are those of Fusaka. -/
private theorem parameters_of_fusaka {fork : Fork} (fusaka : .fusaka ≤ fork)
    (early : fork < .glamsterdam) :
    EthLib.Consensus.parameters preset fork = EthLib.Consensus.parameters preset .fusaka := by
  cases fork <;> first
    | rfl
    | exact absurd fusaka (by decide)
    | exact absurd early (by decide)

/-- The floor debit of a replay is its penalties plus its sync debits. -/
private theorem floorPenaltyDebit_sum (i : ℕ) (events : List (BalanceEvent preset)) :
    (events.map (DirectSafety.Apriori.Internal.floorPenaltyDebit i)).sum =
      (events.map (DirectSafety.Apriori.Internal.penaltyDebit i)).sum +
        (events.map (syncDebit i)).sum := by
  rw [← List.sum_map_add]
  rfl

/-- The debit that a segment's potential floor leaves is at most the debits of the whole run.

The run's events are the segment's, then the rest.

The debits are the sync debits and the partial withdrawals. -/
private theorem prefix_debit_le (i : ValidatorIndex) (before rest : List (BalanceEvent preset))
    (D : ℕ) (split : D + (before.map (DirectSafety.Apriori.Internal.penaltyDebit i.toNat)).sum =
      (before.map (DirectSafety.Apriori.Internal.floorPenaltyDebit i.toNat)).sum +
        (before.map (DirectSafety.Apriori.Internal.floorPartialDebit i)).sum) :
    D ≤ ((before ++ rest).map (syncDebit i.toNat)).sum +
      ((before ++ rest).map (DirectSafety.Apriori.Internal.floorPartialDebit i)).sum := by
  have splitDebit := floorPenaltyDebit_sum i.toNat before
  simp only [List.map_append, List.sum_append]
  omega

/-- A run's debit events and one slashing penalty bound the fall of a key's balance.

The run starts at a state `zs` of R's run from the finalized block.

It ends within one epoch after the call.

The floor starts from the smaller of the key's balance at `zs` and its largest balance.

Its effective balance stays at most `top` along the run.

The key is unslashed at `zs`.

Or it is slashed there, with its withdrawal at least the slashings vector past the finalized epoch.

Then its delayed penalty is not due along the run, since the window is shorter than half the vector.

The slashing penalty is then at most `top` over the slashing quotient, whenever the run slashes it.

A key slashed at `zs` pays no slashing penalty along the run.

The guards of the floor trace are `floor_guards`, from the setting's guard at the finalized block.

Nothing in the statement needs the key to be slashed, so it holds for a key that stays unslashed.

A step may assign the key's exit within the window, if its withdrawable epoch is beyond the window.

No upgrade runs from Fulu, so no step records a crossing. -/
private theorem slashed_floor (h : Setting config checks g split fin pulled anc counted V)
    {zs e : BeaconState preset fork}
    (toZ : Run config checks ⟨fork, fin⟩ ⟨fork, zs⟩)
    (near : (getCurrentEpoch e).toNat ≤ (getCurrentEpoch pulled).toNat + 1)
    (tail : Run config checks ⟨fork, zs⟩ ⟨fork, e⟩) (high : ℕ)
    (endEpoch : (getCurrentEpoch e).toNat ≤ high + 1)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    (i : ValidatorIndex) (val : Validator)
    (initial : zs.validators.data[i.toNat]? = some val)
    (slashedLate : val.slashed = true → (getCurrentEpoch fin).toNat +
      preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat ≤ val.withdrawableEpoch.toNat)
    (top : ℕ)
    (envelope : ∀ z ∈ tail.balancePath, effectiveAt z i.toNat ≤ top)
    (retained : ∀ {m n : ForkedBeaconState preset} (pre : Run config checks ⟨fork, zs⟩ m)
      (step : Step config checks m n) (post : Run config checks n ⟨fork, e⟩),
      (pre.snoc step).append post = tail → ∀ w, n.state.validators.data[i.toNat]? = some w →
      high + 1 < w.exitEpoch.toNat ∨
        ∀ u, m.state.validators.data[i.toNat]? = some u → high + 1 < u.withdrawableEpoch.toNat) :
    min (actualBalanceAt ⟨fork, zs⟩ i.toNat)
        (withdrawalMaxEffectiveBalance preset fork val).toNat ≤
      actualBalanceAt ⟨fork, e⟩ i.toNat +
        (events.map (DirectSafety.Apriori.Internal.penaltyDebit i.toNat)).sum +
        (events.map (syncDebit i.toNat)).sum +
        (events.map (DirectSafety.Apriori.Internal.floorPartialDebit i)).sum +
        (if val.slashed = true then 0 else
          top / (parameters preset fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat) := by
  obtain ⟨toFin⟩ := h.toFin
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  obtain ⟨positive, guards⟩ := floor_guards h toZ (y := e) near
  have member : ∀ {m n : ForkedBeaconState preset} (pre : Run config checks ⟨fork, zs⟩ m)
      (step : Step config checks m n) (post : Run config checks n ⟨fork, e⟩),
      (pre.snoc step).append post = tail → m ∈ tail.balancePath := by
    intro m n pre step post cut
    obtain ⟨front, atEnd⟩ := Run.balancePath_last pre
    have path := Run.balancePath_append (pre.snoc step) post
    rw [cut] at path
    rw [path]
    simp [Run.balancePath, atEnd]
  have start : effectiveAt ⟨fork, zs⟩ i.toNat ≤ top := by
    obtain ⟨rest, atHead⟩ := Run.balancePath_head tail
    exact envelope _ (by rw [atHead]; exact List.mem_cons_self)
  obtain ⟨last, trace, balance, debt, -, w, final, -, -, -, ceiling, startNone⟩ :=
    DirectSafety.Apriori.Internal.FloorTrace.run_of_le_cap_general (toFin.append toZ) tail
      h.genesis h.caps h.delay h.early high endEpoch i val initial (Or.inr h.fulu)
      (min (actualBalanceAt ⟨fork, zs⟩ i.toNat)
        (withdrawalMaxEffectiveBalance preset fork val).toNat) top _
      (Nat.min_le_right _ _) positive
      (fun pre step post cut w found =>
        ⟨retained pre step post cut w found,
          ⟨fun _ => (guards pre step post).1, fun s => by
            have window := DirectSafety.Apriori.Internal.short_window_of_guard h.guard near
              ((Run.nil.snoc step).append post)
            have late := slashedLate s
            simp only [UInt64.toNat_div, UInt64.reduceToNat] at window ⊢
            omega⟩,
          (guards pre step post).2⟩)
      replayed
  obtain ⟨-, below⟩ := ceiling top start fun pre step post cut =>
    envelope _ (member pre step post cut)
  have floor := DirectSafety.Apriori.Internal.FloorTrace.balance_floor_general trace
    (by simp)
  have penalty : last.slashedHigh.elim 0 (fun s =>
      top / DirectSafety.Apriori.minSlashingPenaltyQuotient preset
        (DirectSafety.Apriori.preElectraEpochs config ⟨fork, zs⟩
          (getCurrentEpoch pulled).toNat) + (s - top)) ≤
      (if val.slashed = true then 0 else
        top / DirectSafety.Apriori.minSlashingPenaltyQuotient preset
          (DirectSafety.Apriori.preElectraEpochs config ⟨fork, zs⟩
            (getCurrentEpoch pulled).toNat)) := by
    by_cases startSlashed : val.slashed = true
    · rw [startNone startSlashed, ite_eq_left startSlashed]
      exact Nat.le_refl _
    · rw [ite_eq_right startSlashed]
      cases flag : last.slashedHigh with
      | none => exact Nat.zero_le _
      | some s =>
        have capped := below s flag
        simp only [Option.elim]
        omega
  rw [balance, debt, floorPenaltyDebit_sum] at floor
  have same : DirectSafety.Apriori.minSlashingPenaltyQuotient preset
      (DirectSafety.Apriori.preElectraEpochs config ⟨fork, zs⟩ (getCurrentEpoch pulled).toNat) =
        (parameters preset fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat :=
    DirectSafety.Apriori.Internal.slashing_quotient_of_electra (config := config)
      (checks := checks) (high := (getCurrentEpoch pulled).toNat)
      (Run.nil : Run config checks ⟨fork, zs⟩ ⟨fork, zs⟩) electra
  rw [← same]
  split_ifs at penalty ⊢ <;> omega

/-- A state of the balance path of a run is the end of a prefix of the run.

The state inside a slot step comes after the epoch transition and before the upgrades.

It is the end of the step, since no fork upgrade runs when the fork does not rise. -/
private theorem balancePath_endpoint {x m y : ForkedBeaconState preset}
    (rp : Run config checks x m) (rest : Run config checks m y) (back : y.fork ≤ x.fork)
    {p : ForkedBeaconState preset} (member : p ∈ rp.balancePath) :
    ∃ (r1 : Run config checks x p) (r2 : Run config checks p y),
      r1.append r2 = rp.append rest := by
  rcases PinKeys.Run.mem_balancePath_split rp member with
    ⟨rq, rest', eq⟩ | ⟨q, n, rq, ok, rest', adv, eq, -, hp, up⟩
  · subst eq
    exact ⟨rq, rest'.append rest, Run.append_assoc _ _ _⟩
  · subst eq
    have order : n.fork ≤ q.fork :=
      Nat.le_trans (fork_le_of_chainSteps rest'.chainSteps)
        (Nat.le_trans (fork_le_of_chainSteps rest.chainSteps)
          (Nat.le_trans back (fork_le_of_chainSteps rq.chainSteps)))
    have same := processUpgrades_eq_of_fork_le up order
    have pn : p = n := hp.trans same.symm
    subst pn
    exact ⟨rq.snoc (Step.slot ok), rest'.append rest, Run.append_assoc _ _ _⟩

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The guards of the floor trace of a segment of C's run.

The segment runs from `wS` to `pS`, and a run to the end `e` of C's run follows it.

The guards are `floor_guards`, with the exit guard `retained` of the segment.

The slashing quotient is the fork's, and the segment ends by the call's cutoff. -/
private theorem segment_guards (h : Setting config checks g split fin pulled anc counted V)
    {e : BeaconState preset fork}
    (near : (getCurrentEpoch e).toNat ≤ (getCurrentEpoch pulled).toNat + 1) (i : ValidatorIndex)
    {wS pS : BeaconState preset fork} (pre : Run config checks ⟨fork, fin⟩ ⟨fork, wS⟩)
    (seg : Run config checks ⟨fork, wS⟩ ⟨fork, pS⟩) (rest : Run config checks ⟨fork, pS⟩ ⟨fork, e⟩)
    (retained : ∀ {m n : ForkedBeaconState preset} (before : Run config checks ⟨fork, wS⟩ m)
      (step : Step config checks m n) (after : Run config checks n ⟨fork, pS⟩),
      (before.snoc step).append after = seg → ∀ w,
      n.state.validators.data[i.toNat]? = some w →
      ((getCurrentEpoch pulled).toNat + 1 < w.exitEpoch.toNat ∨
        ∀ u, m.state.validators.data[i.toNat]? = some u →
          (getCurrentEpoch pulled).toNat + 1 < u.withdrawableEpoch.toNat)) :
    (getCurrentEpoch pS).toNat ≤ (getCurrentEpoch pulled).toNat + 1 ∧
      ∃ quotient : ℕ, 0 < quotient ∧
        quotient = (EthLib.Consensus.parameters preset fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat ∧
        ∀ {m n : ForkedBeaconState preset} (before : Run config checks ⟨fork, wS⟩ m)
          (step : Step config checks m n) (after : Run config checks n ⟨fork, pS⟩),
          (before.snoc step).append after = seg → ∀ w,
          n.state.validators.data[i.toNat]? = some w →
          ((getCurrentEpoch pulled).toNat + 1 < w.exitEpoch.toNat ∨
            ∀ u, m.state.validators.data[i.toNat]? = some u →
              (getCurrentEpoch pulled).toNat + 1 < u.withdrawableEpoch.toNat) ∧
          (getCurrentEpoch m.state).toNat < (getCurrentEpoch wS).toNat +
            preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat -
              (preset.EPOCHS_PER_SLASHINGS_VECTOR / 2).toNat ∧
          quotient ≤
            (EthLib.Consensus.parameters preset m.fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat ∧
          ∀ events, step.balanceEvents = .ok events → ∀ e ∈ events, e.source ≠ .crossing := by
  have order := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps rest.chainSteps)
  simp only at order
  have endEpoch : (getCurrentEpoch pS).toNat ≤ (getCurrentEpoch pulled).toNat + 1 := by omega
  obtain ⟨positive, guards⟩ := floor_guards h (zs := wS) (y := pS) pre endEpoch
  exact ⟨endEpoch, _, positive,
    slashing_quotient_of_electra (high := (getCurrentEpoch pulled).toNat)
      (Run.nil : Run config checks ⟨fork, wS⟩ ⟨fork, wS⟩) (Nat.le_trans (by decide) h.fulu),
    fun before step after cut w found =>
      ⟨retained before step after cut w found, guards before step after⟩⟩

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The potential floor of a segment of C's run, read at the state where the segment starts.

The segment runs from `wS` to `pS`.

A run from the finalized block to `wS` comes before it, and a run to the end `e` after it.

The key is unslashed at the end, and its exit is after the call's cutoff at each state of the run.

The rate bounds the pass penalties of each step by a fraction of its effective balance.

The closed form reads the balance and the cap of the key at the start of the segment. -/
private theorem segment_potential (h : Setting config checks g split fin pulled anc counted V)
    {e : BeaconState preset fork}
    (near : (getCurrentEpoch e).toNat ≤ (getCurrentEpoch pulled).toNat + 1) (i : ValidatorIndex)
    (clean : ∀ w, e.validators.data[i.toNat]? = some w → w.slashed = false)
    {wS pS : BeaconState preset fork} (pre : Run config checks ⟨fork, fin⟩ ⟨fork, wS⟩)
    (seg : Run config checks ⟨fork, wS⟩ ⟨fork, pS⟩) (rest : Run config checks ⟨fork, pS⟩ ⟨fork, e⟩)
    (valW : Validator) (initialW : wS.validators.data[i.toNat]? = some valW)
    (retained : ∀ {m n : ForkedBeaconState preset} (before : Run config checks ⟨fork, wS⟩ m)
      (step : Step config checks m n) (after : Run config checks n ⟨fork, pS⟩),
      (before.snoc step).append after = seg → ∀ w,
      n.state.validators.data[i.toNat]? = some w →
      ((getCurrentEpoch pulled).toNat + 1 < w.exitEpoch.toNat ∨
        ∀ u, m.state.validators.data[i.toNat]? = some u →
          (getCurrentEpoch pulled).toNat + 1 < u.withdrawableEpoch.toNat))
    (slack ρn ρd : ℕ)
    (start : effectiveAt (⟨fork, wS⟩ : ForkedBeaconState preset) i.toNat ≤
      actualBalanceAt (⟨fork, wS⟩ : ForkedBeaconState preset) i.toNat +
        (preset.downwardBand + slack))
    (pass : ∀ {m n : ForkedBeaconState preset} (before : Run config checks ⟨fork, wS⟩ m)
      (step : Step config checks m n) (after : Run config checks n ⟨fork, pS⟩),
      (before.snoc step).append after = seg → ∀ evs, step.balanceEvents = .ok evs →
      (evs.map (penaltyDebit i.toNat)).sum ≤ ρn * effectiveAt m i.toNat / ρd)
    {segEvents : List (BalanceEvent preset)}
    (segOk : seg.balanceEvents (getCurrentEpoch pulled).toNat = .ok segEvents) :
    ∃ D, D + (segEvents.map (penaltyDebit i.toNat)).sum =
        (segEvents.map (floorPenaltyDebit i.toNat)).sum +
          (segEvents.map (floorPartialDebit i)).sum ∧
      (ρd - ρn * ((getCurrentEpoch pS).toNat - (getCurrentEpoch wS).toNat)) *
          (min (actualBalanceAt (⟨fork, wS⟩ : ForkedBeaconState preset) i.toNat)
              (withdrawalMaxEffectiveBalance preset fork valW).toNat +
            preset.downwardBand) ≤
        ρd * (actualBalanceAt (⟨fork, pS⟩ : ForkedBeaconState preset) i.toNat + D +
          preset.downwardBand) + ρn * slack := by
  obtain ⟨toFin⟩ := h.toFin
  have early : (⟨fork, pS⟩ : ForkedBeaconState preset).fork < .glamsterdam :=
    Nat.lt_of_le_of_lt (fork_le_of_chainSteps rest.chainSteps) h.early
  obtain ⟨endEpoch, quotient, positive, -, guards⟩ :=
    segment_guards h near i pre seg rest retained
  exact FloorTrace.run_potential_floor_once (toFin.append pre) seg h.genesis h.caps h.delay early
    h.fulu h.bands (getCurrentEpoch pulled).toNat endEpoch i valW initialW
    (fun w found => unslashed_of_run rest found clean) quotient positive guards segOk slack ρn ρd
    start pass

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The potential floor of a segment of C's run for a key that is unslashed at its start.

The key may be slashed at the end of the segment, or at the end of C's run.

The closed form is the one of a slash with the fork's quotient, over one more epoch.

`segment_potential` keeps the form without the slash for a key that is unslashed at the end.

The slash form cannot give that one, so the lemmas stay apart. -/
private theorem segment_potential_slash (h : Setting config checks g split fin pulled anc counted V)
    {e : BeaconState preset fork}
    (near : (getCurrentEpoch e).toNat ≤ (getCurrentEpoch pulled).toNat + 1) (i : ValidatorIndex)
    {wS pS : BeaconState preset fork} (pre : Run config checks ⟨fork, fin⟩ ⟨fork, wS⟩)
    (seg : Run config checks ⟨fork, wS⟩ ⟨fork, pS⟩) (rest : Run config checks ⟨fork, pS⟩ ⟨fork, e⟩)
    (valW : Validator) (initialW : wS.validators.data[i.toNat]? = some valW)
    (unslashed : valW.slashed = false)
    (retained : ∀ {m n : ForkedBeaconState preset} (before : Run config checks ⟨fork, wS⟩ m)
      (step : Step config checks m n) (after : Run config checks n ⟨fork, pS⟩),
      (before.snoc step).append after = seg → ∀ w,
      n.state.validators.data[i.toNat]? = some w →
      ((getCurrentEpoch pulled).toNat + 1 < w.exitEpoch.toNat ∨
        ∀ u, m.state.validators.data[i.toNat]? = some u →
          (getCurrentEpoch pulled).toNat + 1 < u.withdrawableEpoch.toNat))
    (slack ρn ρd : ℕ)
    (start : effectiveAt (⟨fork, wS⟩ : ForkedBeaconState preset) i.toNat ≤
      actualBalanceAt (⟨fork, wS⟩ : ForkedBeaconState preset) i.toNat +
        (preset.downwardBand + slack))
    (pass : ∀ {m n : ForkedBeaconState preset} (before : Run config checks ⟨fork, wS⟩ m)
      (step : Step config checks m n) (after : Run config checks n ⟨fork, pS⟩),
      (before.snoc step).append after = seg → ∀ evs, step.balanceEvents = .ok evs →
      (evs.map (penaltyDebit i.toNat)).sum ≤ ρn * effectiveAt m i.toNat / ρd)
    {segEvents : List (BalanceEvent preset)}
    (segOk : seg.balanceEvents (getCurrentEpoch pulled).toNat = .ok segEvents) :
    ∃ D, D + (segEvents.map (penaltyDebit i.toNat)).sum =
        (segEvents.map (floorPenaltyDebit i.toNat)).sum +
          (segEvents.map (floorPartialDebit i)).sum ∧
      ((EthLib.Consensus.parameters preset fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat - 1) *
          ((ρd - ρn * ((getCurrentEpoch pS).toNat - (getCurrentEpoch wS).toNat + 1)) *
            (min (actualBalanceAt (⟨fork, wS⟩ : ForkedBeaconState preset) i.toNat)
                (withdrawalMaxEffectiveBalance preset fork valW).toNat +
              preset.downwardBand)) ≤
        (EthLib.Consensus.parameters preset fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat *
          (ρd * (actualBalanceAt (⟨fork, pS⟩ : ForkedBeaconState preset) i.toNat + D +
          preset.downwardBand) + ρn * slack) + ρd * (preset.downwardBand + slack) := by
  obtain ⟨toFin⟩ := h.toFin
  have early : (⟨fork, pS⟩ : ForkedBeaconState preset).fork < .glamsterdam :=
    Nat.lt_of_le_of_lt (fork_le_of_chainSteps rest.chainSteps) h.early
  obtain ⟨endEpoch, quotient, positive, same, guards⟩ :=
    segment_guards h near i pre seg rest retained
  have two : 2 ≤ quotient := by
    rw [same, parameters_of_fusaka h.fulu h.early]
    exact h.facts.quotient
  rw [← same]
  exact FloorTrace.run_potential_floor_slash (toFin.append pre) seg h.genesis h.caps h.delay early
    h.fulu h.bands (getCurrentEpoch pulled).toNat endEpoch i valW initialW unslashed quotient two
    guards segOk slack ρn ρd start pass

/-- A state between two runs is of the fork of the start.

The end of the runs must not be of a later fork than the start.

A run never moves the fork back. -/
private theorem fork_eq_of_run {x m y : ForkedBeaconState preset} (r1 : Run config checks x m)
    (r2 : Run config checks m y) (back : y.fork ≤ x.fork) : m.fork = x.fork :=
  Fork.ctorIdx_injective (Nat.le_antisymm
    (Nat.le_trans (fork_le_of_chainSteps r2.chainSteps) back) (fork_le_of_chainSteps r1.chainSteps))

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The balance of a key at every prefix end of C's run is above `floor`.

The run is C's from the finalized block, and `floor` is below what the potential floor gives.

The potential floor is `segment_potential`, read at the end of each prefix from the finalized block.

The guards are `floor_guards`, with the exit guard `retained` and the pass rate `pass`.

The step `arith` is the arithmetic that fits the closed form of the potential floor to `floor`.

It holds for each epoch count up to C's.

It also holds for each debit that is at most the key's sync and partial debits over the run. -/
private theorem cfloor_balance (h : Setting config checks g split fin pulled anc counted V)
    (e : BeaconState preset fork) (wholeRun : Run config checks ⟨fork, fin⟩ ⟨fork, e⟩)
    (near : (getCurrentEpoch e).toNat ≤ (getCurrentEpoch pulled).toNat + 1)
    {events : List (BalanceEvent preset)}
    (replayed : wholeRun.balanceEvents (getCurrentEpoch pulled).toNat = .ok events)
    (i : ValidatorIndex) (val : Validator) (initial : fin.validators.data[i.toNat]? = some val)
    (clean : ∀ w, e.validators.data[i.toNat]? = some w → w.slashed = false)
    (retained : ∀ {m n : ForkedBeaconState preset} (before : Run config checks ⟨fork, fin⟩ m)
      (step : Step config checks m n) (after : Run config checks n ⟨fork, e⟩),
      (before.snoc step).append after = wholeRun → ∀ w,
      n.state.validators.data[i.toNat]? = some w →
      ((getCurrentEpoch pulled).toNat + 1 < w.exitEpoch.toNat ∨
        ∀ u, m.state.validators.data[i.toNat]? = some u →
          (getCurrentEpoch pulled).toNat + 1 < u.withdrawableEpoch.toNat))
    (slack ρn ρd floor : ℕ)
    (start : effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat ≤
      actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat +
        (preset.downwardBand + slack))
    (pass : ∀ {m n : ForkedBeaconState preset} (before : Run config checks ⟨fork, fin⟩ m)
      (step : Step config checks m n) (after : Run config checks n ⟨fork, e⟩),
      (before.snoc step).append after = wholeRun → ∀ evs,
      step.balanceEvents = .ok evs →
      (evs.map (penaltyDebit i.toNat)).sum ≤ ρn * effectiveAt m i.toNat / ρd)
    (arith : ∀ a D k : ℕ,
      k ≤ (getCurrentEpoch e).toNat - (getCurrentEpoch fin).toNat →
      D ≤ (events.map (syncDebit i.toNat)).sum + (events.map (floorPartialDebit i)).sum →
      (ρd - ρn * k) * (min (actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat)
          (withdrawalMaxEffectiveBalance preset fork val).toNat +
        preset.downwardBand) ≤ ρd * (a + D + preset.downwardBand) + ρn * slack →
      floor ≤ a) :
    ∀ {p : ForkedBeaconState preset} (r1 : Run config checks ⟨fork, fin⟩ p)
      (r2 : Run config checks p ⟨fork, e⟩), r1.append r2 = wholeRun →
      floor ≤ actualBalanceAt p i.toNat := by
  intro p r1 r2 whole
  obtain ⟨pFork, pState⟩ := p
  obtain rfl : fork = pFork := (fork_eq_of_run r1 r2 (Nat.le_refl _)).symm
  have order := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps r2.chainSteps)
  simp only at order
  obtain ⟨before, beforeOk, isPrefix⟩ := Run.balanceEvents_prefix r1 r2
    (getCurrentEpoch pulled).toNat events (by rw [whole]; exact replayed)
  obtain ⟨D, split, closed⟩ := segment_potential h near i clean Run.nil r1 r2 val initial
    (fun before' step after cut' w found => retained before' step (after.append r2)
      (by rw [Run.append_assoc, cut', whole]) w found)
    slack ρn ρd start
    (fun before' step after cut' evs ok => pass before' step (after.append r2)
      (by rw [Run.append_assoc, cut', whole]) evs ok)
    beforeOk
  obtain ⟨rest', rfl⟩ := isPrefix
  have window : (getCurrentEpoch pState).toNat - (getCurrentEpoch fin).toNat ≤
      (getCurrentEpoch e).toNat - (getCurrentEpoch fin).toNat :=
    Nat.sub_le_sub_right order _
  exact arith _ D _ window (prefix_debit_le i before rest' D split) closed

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The balance of a key at every prefix end of C's run is above `floor`, less `loss`.

The key is unslashed at the finalized block, and it may be slashed on C's run.

The potential floor is `segment_potential_slash`.

It is read at the end of each prefix, from the finalized block.

The step `arithS` fits its closed form to `floor`, and `loss` is the slash's share.

`cfloor_balance` has the key unslashed at the end of the run and the closed form of one epoch less.

That form is stronger than this one, so `cfloor_balance` is not a case of it. -/
private theorem cfloor_balance_slash (h : Setting config checks g split fin pulled anc counted V)
    (e : BeaconState preset fork) (wholeRun : Run config checks ⟨fork, fin⟩ ⟨fork, e⟩)
    (near : (getCurrentEpoch e).toNat ≤ (getCurrentEpoch pulled).toNat + 1)
    {events : List (BalanceEvent preset)}
    (replayed : wholeRun.balanceEvents (getCurrentEpoch pulled).toNat = .ok events)
    (i : ValidatorIndex) (val : Validator) (initial : fin.validators.data[i.toNat]? = some val)
    (unslashed : val.slashed = false)
    (retained : ∀ {m n : ForkedBeaconState preset} (before : Run config checks ⟨fork, fin⟩ m)
      (step : Step config checks m n) (after : Run config checks n ⟨fork, e⟩),
      (before.snoc step).append after = wholeRun → ∀ w,
      n.state.validators.data[i.toNat]? = some w →
      ((getCurrentEpoch pulled).toNat + 1 < w.exitEpoch.toNat ∨
        ∀ u, m.state.validators.data[i.toNat]? = some u →
          (getCurrentEpoch pulled).toNat + 1 < u.withdrawableEpoch.toNat))
    (slack ρn ρd floor loss : ℕ)
    (start : effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat ≤
      actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat +
        (preset.downwardBand + slack))
    (pass : ∀ {m n : ForkedBeaconState preset} (before : Run config checks ⟨fork, fin⟩ m)
      (step : Step config checks m n) (after : Run config checks n ⟨fork, e⟩),
      (before.snoc step).append after = wholeRun → ∀ evs,
      step.balanceEvents = .ok evs →
      (evs.map (penaltyDebit i.toNat)).sum ≤ ρn * effectiveAt m i.toNat / ρd)
    (arithS : ∀ a D k : ℕ,
      k ≤ (getCurrentEpoch e).toNat - (getCurrentEpoch fin).toNat →
      D ≤ (events.map (syncDebit i.toNat)).sum + (events.map (floorPartialDebit i)).sum →
      ((EthLib.Consensus.parameters preset fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat - 1) *
        ((ρd - ρn * (k + 1)) *
          (min (actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat)
            (withdrawalMaxEffectiveBalance preset fork val).toNat + preset.downwardBand)) ≤
        (EthLib.Consensus.parameters preset fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat *
          (ρd * (a + D + preset.downwardBand) + ρn * slack) +
          ρd * (preset.downwardBand + slack) →
      floor ≤ a + loss) :
    ∀ {p : ForkedBeaconState preset} (r1 : Run config checks ⟨fork, fin⟩ p)
      (r2 : Run config checks p ⟨fork, e⟩), r1.append r2 = wholeRun →
      floor ≤ actualBalanceAt p i.toNat + loss := by
  intro p r1 r2 whole
  obtain ⟨pFork, pState⟩ := p
  obtain rfl : fork = pFork := (fork_eq_of_run r1 r2 (Nat.le_refl _)).symm
  have order := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps r2.chainSteps)
  simp only at order
  obtain ⟨before, beforeOk, isPrefix⟩ := Run.balanceEvents_prefix r1 r2
    (getCurrentEpoch pulled).toNat events (by rw [whole]; exact replayed)
  obtain ⟨D, split, closed⟩ := segment_potential_slash h near i Run.nil r1 r2 val initial unslashed
    (fun before' step after cut' w found => retained before' step (after.append r2)
      (by rw [Run.append_assoc, cut', whole]) w found)
    slack ρn ρd start
    (fun before' step after cut' evs ok => pass before' step (after.append r2)
      (by rw [Run.append_assoc, cut', whole]) evs ok)
    beforeOk
  obtain ⟨rest', rfl⟩ := isPrefix
  have window : (getCurrentEpoch pState).toNat - (getCurrentEpoch fin).toNat ≤
      (getCurrentEpoch e).toNat - (getCurrentEpoch fin).toNat :=
    Nat.sub_le_sub_right order _
  exact arithS _ D _ window (prefix_debit_le i before rest' D split) closed

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The effective balance of a key at a prefix end of C's run is the finalized one or an update's.

An update is at a state of the prefix.

There the effective balance is aligned and at most the balance. -/
private theorem cfloor_origin (h : Setting config checks g split fin pulled anc counted V)
    (e : BeaconState preset fork) (wholeRun : Run config checks ⟨fork, fin⟩ ⟨fork, e⟩)
    (near : (getCurrentEpoch e).toNat ≤ (getCurrentEpoch pulled).toNat + 1)
    {events : List (BalanceEvent preset)}
    (replayed : wholeRun.balanceEvents (getCurrentEpoch pulled).toNat = .ok events)
    (i : ValidatorIndex) (val : Validator) (initial : fin.validators.data[i.toNat]? = some val)
    (clean : ∀ w, e.validators.data[i.toNat]? = some w → w.slashed = false)
    (retained : ∀ {m n : ForkedBeaconState preset} (before : Run config checks ⟨fork, fin⟩ m)
      (step : Step config checks m n) (after : Run config checks n ⟨fork, e⟩),
      (before.snoc step).append after = wholeRun → ∀ w,
      n.state.validators.data[i.toNat]? = some w →
      ((getCurrentEpoch pulled).toNat + 1 < w.exitEpoch.toNat ∨
        ∀ u, m.state.validators.data[i.toNat]? = some u →
          (getCurrentEpoch pulled).toNat + 1 < u.withdrawableEpoch.toNat))
    {p : ForkedBeaconState preset} (r1 : Run config checks ⟨fork, fin⟩ p)
    (r2 : Run config checks p ⟨fork, e⟩) (whole : r1.append r2 = wholeRun) :
    effectiveAt p i.toNat = effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat ∨
      ∃ (w : ForkedBeaconState preset) (pre : Run config checks ⟨fork, fin⟩ w)
          (post : Run config checks w p),
        pre.append post = r1 ∧ effectiveAt p i.toNat = effectiveAt w i.toNat ∧
          effectiveAt w i.toNat ≤ actualBalanceAt w i.toNat ∧
          effectiveAt w i.toNat % preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0 := by
  obtain ⟨toFin⟩ := h.toFin
  obtain ⟨pFork, pState⟩ := p
  obtain rfl : fork = pFork := (fork_eq_of_run r1 r2 (Nat.le_refl _)).symm
  have early : (⟨fork, pState⟩ : ForkedBeaconState preset).fork < .glamsterdam :=
    Nat.lt_of_le_of_lt (fork_le_of_chainSteps r2.chainSteps) h.early
  obtain ⟨before, beforeOk, -⟩ := Run.balanceEvents_prefix r1 r2
    (getCurrentEpoch pulled).toNat events (by rw [whole]; exact replayed)
  obtain ⟨endEpoch, quotient, positive, -, guards⟩ := segment_guards h near i
    Run.nil r1 r2 (fun before' step after cut' w found => retained before' step (after.append r2)
      (by rw [Run.append_assoc, cut', whole]) w found)
  exact FloorTrace.run_effective_origin toFin r1 h.genesis h.caps h.delay early h.fulu h.aligned
    (getCurrentEpoch pulled).toNat endEpoch i val initial (fun w found => unslashed_of_run r2 found
      clean) quotient positive guards beforeOk

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The effective balance of a key at a state of C's run is above a least value.

The balance of the key at every prefix end is above `floor`, as `endpointFloor` says.

That value is the least of its effective balance and its cap at the finalized block.

And of `floor` rounded down to an increment. -/
private theorem cfloor_endpoint_of (h : Setting config checks g split fin pulled anc counted V)
    (e : BeaconState preset fork) (wholeRun : Run config checks ⟨fork, fin⟩ ⟨fork, e⟩)
    (i : ValidatorIndex) (val : Validator) (initial : fin.validators.data[i.toNat]? = some val)
    (floor : ℕ)
    (endpointFloor : ∀ {p : ForkedBeaconState preset} (r1 : Run config checks ⟨fork, fin⟩ p)
      (r2 : Run config checks p ⟨fork, e⟩), r1.append r2 = wholeRun →
      floor ≤ actualBalanceAt p i.toNat)
    {z : ForkedBeaconState preset} (rp : Run config checks ⟨fork, fin⟩ z)
    (rest : Run config checks z ⟨fork, e⟩) (cut : rp.append rest = wholeRun) :
    min (effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat)
        (min (withdrawalMaxEffectiveBalance preset fork val).toNat
          (floor - floor % preset.EFFECTIVE_BALANCE_INCREMENT.toNat)) ≤
      effectiveAt z i.toNat := by
  have forkEnd : ∀ {p : ForkedBeaconState preset} (r2 : Run config checks p ⟨fork, e⟩),
      p.fork < .glamsterdam := fun r2 =>
    Nat.lt_of_le_of_lt (fork_le_of_chainSteps r2.chainSteps) h.early
  have pathEndpoint : ∀ {p : ForkedBeaconState preset}, p ∈ rp.balancePath →
      ∃ (r1 : Run config checks ⟨fork, fin⟩ p) (r2 : Run config checks p ⟨fork, e⟩),
        r1.append r2 = wholeRun := fun member => by
    obtain ⟨r1, r2, whole⟩ := balancePath_endpoint rp rest (Nat.le_refl _) member
    exact ⟨r1, r2, whole.trans cut⟩
  have inside : i.toNat < fin.validators.data.size := (Array.getElem?_eq_some_iff.mp initial).1
  refine PinKeyFloor.Run.effective_floor_rounded rp (forkEnd rest) h.fulu i.toNat inside floor
    (withdrawalMaxEffectiveBalance preset fork val).toNat ?_ ?_
  · intro p member
    obtain ⟨r1, r2, whole⟩ := pathEndpoint member
    exact endpointFloor r1 r2 whole
  · intro p member
    obtain ⟨r1, r2, -⟩ := pathEndpoint member
    obtain ⟨w, found, mono⟩ := r1.validatorCap_mono h.caps.activation h.caps.compounding
      (forkEnd r2) i.toNat val initial
    simpa [PinTerms.capAt, found] using UInt64.le_iff_toNat_le.mp mono

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The effective balance of a key at a state of C's run is above a least value.

The balance of the key at every prefix end is above `floor`, by `cfloor_balance`.

The effective balance of the key at the end of a prefix is then at least a least value.

That value is the least of its effective balance and its cap at the finalized block.

And of `floor` rounded down to an increment. -/
private theorem cfloor_endpoint (h : Setting config checks g split fin pulled anc counted V)
    (e : BeaconState preset fork) (wholeRun : Run config checks ⟨fork, fin⟩ ⟨fork, e⟩)
    (near : (getCurrentEpoch e).toNat ≤ (getCurrentEpoch pulled).toNat + 1)
    {events : List (BalanceEvent preset)}
    (replayed : wholeRun.balanceEvents (getCurrentEpoch pulled).toNat = .ok events)
    (i : ValidatorIndex) (val : Validator) (initial : fin.validators.data[i.toNat]? = some val)
    (clean : ∀ w, e.validators.data[i.toNat]? = some w → w.slashed = false)
    (retained : ∀ {m n : ForkedBeaconState preset} (before : Run config checks ⟨fork, fin⟩ m)
      (step : Step config checks m n) (after : Run config checks n ⟨fork, e⟩),
      (before.snoc step).append after = wholeRun → ∀ w,
      n.state.validators.data[i.toNat]? = some w →
      ((getCurrentEpoch pulled).toNat + 1 < w.exitEpoch.toNat ∨
        ∀ u, m.state.validators.data[i.toNat]? = some u →
          (getCurrentEpoch pulled).toNat + 1 < u.withdrawableEpoch.toNat))
    (slack ρn ρd floor : ℕ)
    (start : effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat ≤
      actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat +
        (preset.downwardBand + slack))
    (pass : ∀ {m n : ForkedBeaconState preset} (before : Run config checks ⟨fork, fin⟩ m)
      (step : Step config checks m n) (after : Run config checks n ⟨fork, e⟩),
      (before.snoc step).append after = wholeRun → ∀ evs,
      step.balanceEvents = .ok evs →
      (evs.map (penaltyDebit i.toNat)).sum ≤ ρn * effectiveAt m i.toNat / ρd)
    (arith : ∀ a D k : ℕ,
      k ≤ (getCurrentEpoch e).toNat - (getCurrentEpoch fin).toNat →
      D ≤ (events.map (syncDebit i.toNat)).sum + (events.map (floorPartialDebit i)).sum →
      (ρd - ρn * k) * (min (actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat)
          (withdrawalMaxEffectiveBalance preset fork val).toNat +
        preset.downwardBand) ≤ ρd * (a + D + preset.downwardBand) + ρn * slack →
      floor ≤ a)
    {z : ForkedBeaconState preset} (rp : Run config checks ⟨fork, fin⟩ z)
    (rest : Run config checks z ⟨fork, e⟩) (cut : rp.append rest = wholeRun) :
    min (effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat)
        (min (withdrawalMaxEffectiveBalance preset fork val).toNat
          (floor - floor % preset.EFFECTIVE_BALANCE_INCREMENT.toNat)) ≤
      effectiveAt z i.toNat := by
  exact cfloor_endpoint_of h e wholeRun i val initial floor
    (fun r1 r2 whole => cfloor_balance h e wholeRun near replayed i val initial clean retained
      slack ρn ρd floor start pass arith r1 r2 whole) rp rest cut

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The effective balance of a key at a state of C's run is above a least value, for a slashed key.

The balance of the key at every prefix end is above `floor`, less `loss`, by `cfloor_balance_slash`.

The least value is that of `cfloor_endpoint`, with `floor - loss` for `floor`. -/
private theorem cfloor_endpoint_slash (h : Setting config checks g split fin pulled anc counted V)
    (e : BeaconState preset fork) (wholeRun : Run config checks ⟨fork, fin⟩ ⟨fork, e⟩)
    (near : (getCurrentEpoch e).toNat ≤ (getCurrentEpoch pulled).toNat + 1)
    {events : List (BalanceEvent preset)}
    (replayed : wholeRun.balanceEvents (getCurrentEpoch pulled).toNat = .ok events)
    (i : ValidatorIndex) (val : Validator) (initial : fin.validators.data[i.toNat]? = some val)
    (unslashed : val.slashed = false)
    (retained : ∀ {m n : ForkedBeaconState preset} (before : Run config checks ⟨fork, fin⟩ m)
      (step : Step config checks m n) (after : Run config checks n ⟨fork, e⟩),
      (before.snoc step).append after = wholeRun → ∀ w,
      n.state.validators.data[i.toNat]? = some w →
      ((getCurrentEpoch pulled).toNat + 1 < w.exitEpoch.toNat ∨
        ∀ u, m.state.validators.data[i.toNat]? = some u →
          (getCurrentEpoch pulled).toNat + 1 < u.withdrawableEpoch.toNat))
    (slack ρn ρd floor loss : ℕ)
    (start : effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat ≤
      actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat +
        (preset.downwardBand + slack))
    (pass : ∀ {m n : ForkedBeaconState preset} (before : Run config checks ⟨fork, fin⟩ m)
      (step : Step config checks m n) (after : Run config checks n ⟨fork, e⟩),
      (before.snoc step).append after = wholeRun → ∀ evs,
      step.balanceEvents = .ok evs →
      (evs.map (penaltyDebit i.toNat)).sum ≤ ρn * effectiveAt m i.toNat / ρd)
    (arithS : ∀ a D k : ℕ,
      k ≤ (getCurrentEpoch e).toNat - (getCurrentEpoch fin).toNat →
      D ≤ (events.map (syncDebit i.toNat)).sum + (events.map (floorPartialDebit i)).sum →
      ((EthLib.Consensus.parameters preset fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat - 1) *
        ((ρd - ρn * (k + 1)) *
          (min (actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat)
            (withdrawalMaxEffectiveBalance preset fork val).toNat + preset.downwardBand)) ≤
        (EthLib.Consensus.parameters preset fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat *
          (ρd * (a + D + preset.downwardBand) + ρn * slack) +
          ρd * (preset.downwardBand + slack) →
      floor ≤ a + loss)
    {z : ForkedBeaconState preset} (rp : Run config checks ⟨fork, fin⟩ z)
    (rest : Run config checks z ⟨fork, e⟩) (cut : rp.append rest = wholeRun) :
    min (effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat)
        (min (withdrawalMaxEffectiveBalance preset fork val).toNat
          ((floor - loss) - (floor - loss) % preset.EFFECTIVE_BALANCE_INCREMENT.toNat)) ≤
      effectiveAt z i.toNat := by
  refine cfloor_endpoint_of h e wholeRun i val initial (floor - loss) (fun r1 r2 whole => ?_)
    rp rest cut
  have := cfloor_balance_slash h e wholeRun near replayed i val initial unslashed retained slack
    ρn ρd floor loss start pass arithS r1 r2 whole
  omega

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- A key's effective balance on C's run is above the floor of its fall.

The run starts at the finalized block, and the bound holds at each state of it.

It is above that floor less the key's sync debits and their band.

The floor starts from the smaller of the key's balance and its cap at the finalized block.

It falls by what `fall` charges, in `X`: the leak and the gain over the depth, and the partials.

The hypothesis `margin` fits the closed form of the potential floor to the floor of the fall.

The hypothesis `stay` keeps the effective balance at its finalized value if the test holds.

It is `floorC_stay`, for a key with no sync debits. -/
private theorem floorC_at (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩)
    {events : List (BalanceEvent preset)}
    (replayed : (fromFin.append tailC).balanceEvents (getCurrentEpoch pulled).toNat = .ok events)
    (i : ValidatorIndex) (val : Validator) (initial : fin.validators.data[i.toNat]? = some val)
    (clean : ∀ w, counted.validators.data[i.toNat]? = some w → w.slashed = false)
    (retained : ∀ {m n : ForkedBeaconState preset} (before : Run config checks ⟨fork, fin⟩ m)
      (step : Step config checks m n) (after : Run config checks n ⟨fork, counted⟩),
      (before.snoc step).append after = fromFin.append tailC → ∀ w,
      n.state.validators.data[i.toNat]? = some w →
      ((getCurrentEpoch pulled).toNat + 1 < w.exitEpoch.toNat ∨
        ∀ u, m.state.validators.data[i.toNat]? = some u →
          (getCurrentEpoch pulled).toNat + 1 < u.withdrawableEpoch.toNat))
    (base0 X low finEB floorC : ℕ)
    (hbase0 : base0 = min (actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat)
      (withdrawalMaxEffectiveBalance preset fork val).toNat)
    (hlow : low = base0 - X)
    (hfin : finEB = effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat)
    (hfloorC : floorC = if max finEB base0 ≤ low + preset.downwardBand then finEB
      else min finEB (low - low % preset.EFFECTIVE_BALANCE_INCREMENT.toNat))
    {z : ForkedBeaconState preset} (rp : Run config checks ⟨fork, fin⟩ z)
    (rest : Run config checks z ⟨fork, counted⟩) (cut : rp.append rest = fromFin.append tailC)
    (margin : ∃ slack ρn ρd : ℕ,
      effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat ≤
        actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat +
          (preset.downwardBand + slack) ∧
      (∀ {m n : ForkedBeaconState preset} (before : Run config checks ⟨fork, fin⟩ m)
        (step : Step config checks m n) (after : Run config checks n ⟨fork, counted⟩),
        (before.snoc step).append after = fromFin.append tailC → ∀ evs,
        step.balanceEvents = .ok evs →
        (evs.map (penaltyDebit i.toNat)).sum ≤ ρn * effectiveAt m i.toNat / ρd) ∧
      ∀ a D k : ℕ, k ≤ (getCurrentEpoch counted).toNat - (getCurrentEpoch fin).toNat →
        D ≤ (events.map (syncDebit i.toNat)).sum + (events.map (floorPartialDebit i)).sum →
        (ρd - ρn * k) * (min (actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat)
            (withdrawalMaxEffectiveBalance preset fork val).toNat +
          preset.downwardBand) ≤ ρd * (a + D + preset.downwardBand) + ρn * slack →
        low - (events.map (syncDebit i.toNat)).sum ≤ a)
    (stay : max finEB base0 ≤ low + preset.downwardBand →
      (events.map (syncDebit i.toNat)).sum = 0 → finEB ≤ effectiveAt z i.toNat) :
    floorC ≤ effectiveAt z i.toNat + (events.map (syncDebit i.toNat)).sum +
      bandR events i.toNat := by
  obtain ⟨slack, ρn, ρd, start, pass, arith⟩ := margin
  have eff := cfloor_endpoint h counted (fromFin.append tailC) h.near replayed i val initial clean
    retained slack ρn ρd
    (low - (events.map (syncDebit i.toNat)).sum) start pass arith rp rest cut
  have incPos := h.bands.1
  have bandEq := bandR_eq events i.toNat
  have lowLe : low ≤ (withdrawalMaxEffectiveBalance preset fork val).toNat := by
    have := Nat.min_le_right (actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat)
      (withdrawalMaxEffectiveBalance preset fork val).toNat
    omega
  rw [hfloorC]
  rw [← hfin] at eff
  have lowMod := Nat.mod_lt low incPos
  have lowModLe := Nat.mod_le low preset.EFFECTIVE_BALANCE_INCREMENT.toNat
  rcases Nat.eq_zero_or_pos (events.map (syncDebit i.toNat)).sum with zero | positive
  · have same : low - (events.map (syncDebit i.toNat)).sum = low := by omega
    rw [same] at eff
    have noBand : bandR events i.toNat = 0 := by
      rw [bandEq]
      simp [zero]
    split
    · next test =>
      have kept := stay test zero
      omega
    · omega
  · have mod := Nat.mod_lt (low - (events.map (syncDebit i.toNat)).sum) incPos
    have band : bandR events i.toNat =
        preset.EFFECTIVE_BALANCE_INCREMENT.toNat + preset.downwardBand - 1 := by
      rw [bandEq]
      simp [positive]
    split <;> omega

/-- The floors `q` and `P` of `X` over `a` and `b` satisfy `q * S ≤ P * K`.

This holds if `X * S * b + K * a * b ≤ K * a * X`. -/
private theorem rate_final {X a b q P K S : ℕ} (hq : q * a ≤ X) (hP : X < (P + 1) * b)
    (ha : 0 < a) (hK : 0 < K)
    (key : X * S * b + K * a * b ≤ K * a * X) : q * S ≤ P * K := by
  have hb : 0 < b := by
    rcases Nat.eq_zero_or_pos b with h | h
    · simp [h] at hP
    · exact h
  have h1 : q * S * (a * b) ≤ X * S * b := by
    calc q * S * (a * b) = (q * a) * (S * b) := by ring
      _ ≤ X * (S * b) := Nat.mul_le_mul_right _ hq
      _ = X * S * b := by ring
  have h2 : K * a * X < K * a * ((P + 1) * b) := by
    rw [Nat.mul_lt_mul_left (Nat.mul_pos hK ha)]
    exact hP
  have h3 : q * S * (a * b) < P * K * (a * b) := by nlinarith [h1, h2, key]
  exact Nat.le_of_lt (Nat.lt_of_mul_lt_mul_right h3)

/-- Below eighteen increments of the pulled total, a fifth of an increment gives the pin's rate. -/
private theorem rate_small_key {X I a b K S M : ℕ} (hI : 10 ^ 8 ≤ I) (hIX : I ≤ X)
    (hM1 : K * I ≤ M) (hM : I ≤ M) (ha' : M < (a + 1) * (a + 1))
    (hb : b * b ≤ I / 5) (hb' : I / 5 < (b + 1) * (b + 1)) (hK : 1 ≤ K)
    (hS : 2 * S ≤ 3 * K + 2) :
    X * S * b + K * a * b ≤ K * a * X := by
  have hS2 : S ≤ 2 * K := by omega
  have hb5 : 5 * (b * b) ≤ I := by omega
  have hb4472 : 4472 ≤ b := by
    by_contra h
    have : b + 1 ≤ 4472 := by omega
    have : (b + 1) * (b + 1) ≤ 4472 * 4472 := Nat.mul_le_mul this this
    omega
  have ha1e4 : 10 ^ 4 ≤ a := by
    by_contra h
    have : a + 1 ≤ 10 ^ 4 := by omega
    have : (a + 1) * (a + 1) ≤ 10 ^ 4 * 10 ^ 4 := Nat.mul_le_mul this this
    omega
  -- `a² > 4.999 K b²`
  have shift : 10 ^ 4 * (a + 1) ≤ 10001 * a := by omega
  have sq : 10 ^ 4 * (a + 1) * (10 ^ 4 * (a + 1)) ≤ 10001 * a * (10001 * a) :=
    Nat.mul_le_mul shift shift
  have kb : 5 * K * (b * b) ≤ M := by
    have : K * (5 * (b * b)) ≤ K * I := Nat.mul_le_mul_left K hb5
    nlinarith
  have big : 500000000 * K * (b * b) < 100020001 * (a * a) := by nlinarith
  have kb1 : b * b ≤ K * (b * b) := by nlinarith
  have h40 : 40 * b ≤ 19 * a := by
    by_contra h
    have h' : 19 * a < 40 * b := by omega
    have := Nat.mul_self_lt_mul_self h'
    nlinarith
  have h20 : 20 * S * b ≤ 19 * K * a := by
    calc 20 * S * b ≤ 20 * (2 * K) * b := by
          have := Nat.mul_le_mul_right b (Nat.mul_le_mul_left 20 hS2)
          exact this
      _ = K * (40 * b) := by ring
      _ ≤ K * (19 * a) := Nat.mul_le_mul_left K h40
      _ = 19 * K * a := by ring
  have h20b : 20 * b ≤ X := by
    have : 20 * b ≤ b * b := Nat.mul_le_mul_right b (by omega)
    omega
  have e1 : X * (20 * S * b) ≤ X * (19 * K * a) := Nat.mul_le_mul_left X h20
  have e2 : K * a * (20 * b) ≤ K * a * X := Nat.mul_le_mul_left (K * a) h20b
  nlinarith [e1, e2]

/-- Three of the terms that the floors leave are small against `K * a * X`, for a large total. -/
private theorem rate_big_common {X K a : ℕ} (hK : 12 ≤ K) (s2 : 1000 ≤ a) (hX : 2 ^ 35 ≤ X) :
    1000 * (144 * K * X) ≤ 144 * (K * a * X) ∧ 12000 * (96 * X) ≤ 96 * (K * a * X) ∧
      2 ^ 28 * (96 * K * a) ≤ K * a * X := by
  have Ka : 12000 ≤ K * a := by nlinarith
  refine ⟨?_, ?_, ?_⟩
  · have := Nat.mul_le_mul_left (144 * K * X) s2
    linarith
  · have := Nat.mul_le_mul_left (96 * X) Ka
    linarith
  · have h96 : 2 ^ 28 * 96 ≤ X := by omega
    have := Nat.mul_le_mul_left (K * a) h96
    linarith

/-- With at least `2 ^ 20` increments, the terms that the floors leave fit in `13 * K * a * X`. -/
private theorem rate_big_large {X K a : ℕ} (hK : 2 ^ 20 ≤ K) (s2 : 1000 ≤ a) (hX : 2 ^ 35 ≤ X)
    (s3' : 8 * a ≤ X) :
    144 * K * X + 98 * a * X + 96 * X + 98 * K * a * a + 96 * K * a ≤ 13 * K * a * X := by
  obtain ⟨f1, f2, f3⟩ := rate_big_common (K := K) (by omega) s2 hX
  have f4 : 2 ^ 20 * (98 * a * X) ≤ 98 * (K * a * X) := by
    have := Nat.mul_le_mul_right (98 * a * X) hK
    linarith
  have f5 : 8 * (98 * K * a * a) ≤ 98 * K * a * X := by
    have := Nat.mul_le_mul_left (98 * K * a) s3'
    linarith
  have hu : 0 ≤ K * a * X := Nat.zero_le _
  linarith

/-- With fewer than `2 ^ 20` increments, the terms that the floors leave fit in `13 * K * a * X`. -/
private theorem rate_big_small {X K a : ℕ} (hK : 12 ≤ K) (small : K + 1 ≤ 2 ^ 20) (s2 : 1000 ≤ a)
    (hX : 2 ^ 35 ≤ X) (s4 : a * a < (K + 1) * X) :
    144 * K * X + 98 * a * X + 96 * X + 98 * K * a * a + 96 * K * a ≤ 13 * K * a * X := by
  obtain ⟨f1, f2, f3⟩ := rate_big_common hK s2 hX
  have g4 : 12 * (98 * a * X) ≤ 98 * (K * a * X) := by
    have := Nat.mul_le_mul_right (98 * a * X) hK
    linarith
  have g5 : 490 * a ≤ 3 * X := by
    by_contra h
    have h' : 3 * X < 490 * a := by omega
    have h2 := Nat.mul_self_lt_mul_self h'
    have h3 : a * a < 2 ^ 20 * X := by
      have := Nat.mul_le_mul_right X small
      nlinarith
    have h4 : 9 * X * X < 240100 * 2 ^ 20 * X := by nlinarith
    have h5 : 9 * X < 240100 * 2 ^ 20 := by
      exact Nat.lt_of_mul_lt_mul_right h4
    omega
  have g6 : 490 * K * a * a ≤ 3 * K * a * X := by
    have := Nat.mul_le_mul_left (K * a) g5
    linarith
  have hu : 0 ≤ K * a * X := Nat.zero_le _
  linarith

/-- From eighteen increments of the pulled total, a quarter of it gives the pin's rate. -/
private theorem rate_big_key {X I a b K S M T : ℕ} (hX : 2 ^ 35 ≤ X) (hIX : I ≤ X) (hI : 10 ^ 8 ≤ I)
    (hK : 12 ≤ K) (hM1 : K * I ≤ M) (hM2 : M < (K + 1) * I) (ha : a * a ≤ M)
    (ha' : M < (a + 1) * (a + 1)) (hMhi : M < 2 ^ 64) (hb : 4 * (b * b) ≤ T)
    (hT : 2 * T ≤ 3 * M) (hS : 2 * S ≤ 3 * K + 2) :
    X * S * b + K * a * b ≤ K * a * X := by
  have s1 : 80 * b ≤ 49 * a + 48 := by
    by_contra h
    have h1 : 49 * (a + 1) ≤ 80 * b := by omega
    have h2 := Nat.mul_le_mul h1 h1
    nlinarith
  have s2 : 1000 ≤ a := by
    by_contra h
    have h1 : a + 1 ≤ 1000 := by omega
    have h2 := Nat.mul_le_mul h1 h1
    nlinarith
  have s3 : a < 2 ^ 32 := by
    by_contra h
    have h1 : 2 ^ 32 ≤ a := by omega
    have h2 := Nat.mul_le_mul h1 h1
    nlinarith
  have s3' : 8 * a ≤ X := by omega
  have s4 : a * a < (K + 1) * X := by
    have := Nat.mul_le_mul_left (K + 1) hIX
    omega
  have T2 : 144 * K * X + 98 * a * X + 96 * X + 98 * K * a * a + 96 * K * a ≤
      13 * K * a * X := by
    by_cases large : 2 ^ 20 ≤ K
    · exact rate_big_large large s2 hX s3'
    · exact rate_big_small hK (by omega) s2 hX s4
  have e1 : (3 * K + 2) * X * (80 * b) ≤ (3 * K + 2) * X * (49 * a + 48) :=
    Nat.mul_le_mul_left _ s1
  have e2 : 2 * K * a * (80 * b) ≤ 2 * K * a * (49 * a + 48) := Nat.mul_le_mul_left _ s1
  have e3 : 2 * S * (X * b) ≤ (3 * K + 2) * (X * b) := Nat.mul_le_mul_right _ hS
  nlinarith [e1, e2, e3, T2]

/-- The reward per increment at the total, times the previous stake's increments, is bounded.

It is at most the pin's rate times the total's increments. -/
private theorem rate_arith {I c M T S : ℕ} (scale : 2 ^ 35 ≤ I * c) (size : 10 ^ 8 ≤ I)
    (factor : 1 ≤ c)
    (clamp : I ≤ M) (high : M < 2 ^ 64) (band : 2 * T ≤ 3 * M) (stake : 2 * S ≤ 3 * M) :
    I * c / Nat.sqrt M * (S / I) ≤
      I * c / Nat.sqrt (if 18 * I ≤ T then T / 4 else I / 5) * (M / I) := by
  have hI : 0 < I := by omega
  have hIX : I ≤ I * c := Nat.le_mul_of_pos_right I factor
  have hK1 : M / I * I ≤ M := Nat.div_mul_le_self M I
  have hK2 : M < (M / I + 1) * I := by
    have := Nat.lt_mul_div_succ M hI
    rw [Nat.mul_comm] at this
    exact this
  have hK0 : 1 ≤ M / I := (Nat.le_div_iff_mul_le hI).mpr (by omega)
  have hS : 2 * (S / I) ≤ 3 * (M / I) + 2 := by
    have h1 : S / I * I ≤ S := Nat.div_mul_le_self S I
    have h2 : 2 * (S / I) * I < 3 * (M / I + 1) * I := by nlinarith
    have := Nat.lt_of_mul_lt_mul_right h2
    omega
  have ha := Nat.sqrt_le M
  have ha' := Nat.lt_succ_sqrt M
  have apos : 0 < Nat.sqrt M := Nat.sqrt_pos.mpr (by omega)
  by_cases big : 18 * I ≤ T
  · simp only [big, ↓reduceIte]
    have bpos : 0 < Nat.sqrt (T / 4) := Nat.sqrt_pos.mpr (by omega)
    have hb := Nat.sqrt_le (T / 4)
    have hK12 : 12 ≤ M / I := (Nat.le_div_iff_mul_le hI).mpr (by omega)
    refine rate_final (Nat.div_mul_le_self _ _) ?_ apos (by omega)
      (rate_big_key (a := Nat.sqrt M) (b := Nat.sqrt (T / 4)) scale hIX size hK12 hK1 hK2 ha
        ha' high (by omega) band hS)
    exact (Nat.lt_mul_div_succ (I * c) bpos).trans_eq (Nat.mul_comm _ _)
  · simp only [big, ↓reduceIte]
    have bpos : 0 < Nat.sqrt (I / 5) := Nat.sqrt_pos.mpr (by omega)
    have hb := Nat.sqrt_le (I / 5)
    have hb' := Nat.lt_succ_sqrt (I / 5)
    refine rate_final (Nat.div_mul_le_self _ _) ?_ apos (by omega)
      (rate_small_key (a := Nat.sqrt M) (b := Nat.sqrt (I / 5)) size hIX hK1 clamp ha' hb hb'
        hK0 hS)
    exact (Nat.lt_mul_div_succ (I * c) bpos).trans_eq (Nat.mul_comm _ _)

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- From Electra and before Gloas, take a state reached from a guarded state in its window.

Its previous epoch's active stake is within three halves of its total. -/
private theorem prevStake_band_of_guard {g x z : ForkedBeaconState preset} {high : ℕ}
    (shared : Run config checks g x) (genesis : Genesis (config := config) (checks := checks) g)
    (parameters : DirectSafety.Parameters preset) (caps : CapOrder preset)
    (aligned : MaxEffectiveBalancesAligned preset) (twoSlots : 2 ≤ preset.SLOTS_PER_EPOCH.toNat)
    (electra : .pectra ≤ x.fork) (guard : aprioriGuardAt config x high)
    (toZ : Run config checks x z) (zEarly : z.fork < .glamsterdam)
    (zWithin : (getCurrentEpoch z.state).toNat ≤ high + 1) {total : Gwei}
    (totalOk : getTotalActiveBalance z.state = .ok total) :
    2 * ∑ i ∈ (getActiveValidatorIndices z.state (getPreviousEpoch z.state)).toFinset,
        effectiveAt z i.toNat ≤ 3 * total.toNat := by
  have notBefore : ¬ x.fork < .pectra := Nat.not_lt_of_ge electra
  have zero : preElectraEpochs config x high = 0 := by
    simp [preElectraEpochs, notBefore]
  have ratio := ratio_of_guard electra guard
  obtain ⟨low, -⟩ := total_within_guard shared genesis parameters caps aligned twoSlots electra
    guard toZ zEarly zWithin totalOk
  obtain ⟨-, previous, -⟩ := ceilingFloor_electra shared toZ high
    ⟨genesis, parameters, caps, aligned, zEarly, zWithin, guard⟩ twoSlots electra
  have index : ix x z ≤ high + 1 - (getCurrentEpoch x.state).toNat := by
    simp only [ix]
    omega
  have mono := stakeCeilingAt_mono (config := config) (x := x) (high := high) electra index
  have anti := stakeFloorAt_anti (config := config) (x := x) (high := high) index
  simp only [stakeCeilingAt, stakeFloorAt, zero] at low previous mono anti ratio ⊢
  omega

private theorem total_band_of_setting (h : Setting config checks g split fin pulled anc counted V)
    {m : ForkedBeaconState preset} (toM : Run config checks ⟨fork, fin⟩ m)
    (early : m.fork < .glamsterdam)
    (inside : (getCurrentEpoch m.state).toNat ≤ (getCurrentEpoch pulled).toNat + 1)
    {total T : Gwei} (totalOk : getTotalActiveBalance m.state = .ok total)
    (pulledOk : getTotalActiveBalance pulled = .ok T) :
    2 * T.toNat ≤ 3 * total.toNat ∧ 2 * total.toNat ≤ 3 * T.toNat := by
  obtain ⟨shared⟩ := h.toFin
  obtain ⟨fromFin⟩ := h.fromFin
  obtain ⟨toPulled⟩ := h.toPulled
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  have toP := fromFin.append toPulled
  exact ⟨total_band_of_guard shared h.genesis h.parameters h.caps h.aligned h.twoSlots
      electra h.guard toM early inside toP h.early (Nat.le_succ _) totalOk pulledOk,
    total_band_of_guard shared h.genesis h.parameters h.caps h.aligned h.twoSlots
      electra h.guard toP h.early (Nat.le_succ _) toM early inside pulledOk totalOk⟩

private theorem quarter_toNat (T : Gwei) :
    ((if 18 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤ T.toNat then T / 4
      else preset.EFFECTIVE_BALANCE_INCREMENT / 5 : Gwei)).toNat =
      if 18 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤ T.toNat then T.toNat / 4
      else preset.EFFECTIVE_BALANCE_INCREMENT.toNat / 5 := by
  split <;> simp [UInt64.toNat_div]

/-- The reward per increment at a state of a run from the finalized state is at most the pin's rate.

It is read times the increments active at the previous epoch or at the current one.

The pin's rate is read times the active increments. -/
private theorem rate_of_guard
    (h : Setting config checks g split fin pulled anc counted V)
    {m : BeaconState preset fork} (toM : Run config checks ⟨fork, fin⟩ ⟨fork, m⟩)
    (inside : (getCurrentEpoch m).toNat ≤ (getCurrentEpoch pulled).toNat + 1)
    {epoch : Epoch} (which : epoch = getPreviousEpoch m ∨ epoch = getCurrentEpoch m)
    {pq : Gwei} (pqOk : getBaseRewardPerIncrement preset
      (if 18 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤
          ((getTotalActiveBalance pulled).toOption.getD 0).toNat then
        (getTotalActiveBalance pulled).toOption.getD 0 / 4
      else preset.EFFECTIVE_BALANCE_INCREMENT / 5) = .ok pq) :
    ∀ total perIncrement : Gwei, getTotalActiveBalance m = .ok total →
      getBaseRewardPerIncrement preset total = .ok perIncrement →
      perIncrement.toNat *
          ((∑ i ∈ (getActiveValidatorIndices m epoch).toFinset,
            effectiveAt (⟨fork, m⟩ : ForkedBeaconState preset) i.toNat) /
              preset.EFFECTIVE_BALANCE_INCREMENT.toNat) ≤
        pq.toNat * (total.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat) := by
  intro total perIncrement totalOk perOk
  obtain ⟨T, pulledOk⟩ := h.pulledTotal
  obtain ⟨shared⟩ := h.toFin
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  have band := (total_band_of_setting h toM h.early inside totalOk pulledOk).1
  obtain ⟨-, -, value⟩ := getTotalBalance_ok_iff_stake.mp (getTotalActiveBalance_ok totalOk)
  have stake : 2 * ∑ i ∈ (getActiveValidatorIndices m epoch).toFinset,
      effectiveAt (⟨fork, m⟩ : ForkedBeaconState preset) i.toNat ≤ 3 * total.toNat := by
    rcases which with rfl | rfl
    · exact prevStake_band_of_guard shared h.genesis h.parameters h.caps h.aligned h.twoSlots
        electra h.guard toM h.early inside totalOk
    · have current := le_max_right preset.EFFECTIVE_BALANCE_INCREMENT.toNat
        (stake (fun index => balanceAt m index.toNat)
          (getActiveValidatorIndices m (getCurrentEpoch m)).toFinset)
      rw [← value] at current
      exact Nat.le_trans (Nat.mul_le_mul_left 2 current) (Nat.mul_le_mul_right _ (by omega))
  have clamp : preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤ total.toNat := by
    rw [value]
    exact le_max_left _ _
  have high : total.toNat < 2 ^ 64 := total.toNat_lt
  rw [toNat_getBaseRewardPerIncrement perOk]
  simp only [pulledOk, Except.toOption, Option.getD_some] at pqOk
  rw [toNat_getBaseRewardPerIncrement pqOk, quarter_toNat]
  exact rate_arith h.facts.rewardScale h.facts.incrementSize h.facts.reward clamp high band stake

/-- Adding `S` to a number loses at most `U` of rounding down to a multiple of `inc`.

That holds if `S` is zero, or if `U` is at least `inc - 1`.

It also holds if `S` is below `inc` and `S + U` reaches `inc`.

A shift below `inc` moves the rounded value by `inc` or by nothing. -/
private theorem round_add_le {inc x S U : ℕ} (incPos : 0 < inc)
    (slack : S = 0 ∨ inc ≤ U + 1 ∨ (S < inc ∧ inc ≤ S + U)) :
    x + S - (x + S) % inc ≤ x - x % inc + S + U := by
  have := Nat.mod_lt x incPos
  have := Nat.mod_lt (x + S) incPos
  have := Nat.mod_le x inc
  have := Nat.mod_le (x + S) inc
  rcases slack with z | big | ⟨small, need⟩
  · subst z; simp only [Nat.add_zero]; omega
  · omega
  · have up : (x + S) / inc ≤ x / inc + 1 :=
      (Nat.div_le_div_right (by omega : x + S ≤ x + inc)).trans (Nat.add_div_right x incPos).le
    have := Nat.mul_le_mul_left inc up
    rw [Nat.mul_add, Nat.mul_one] at this
    have := Nat.div_add_mod x inc
    have := Nat.div_add_mod (x + S) inc
    omega

/-- An aligned start within the floor of the balance and the cap is within the rounded ceiling. -/
private theorem aligned_le_round {inc e a cap c : ℕ} (aligned : e % inc = 0) (capped : e ≤ cap)
    (ceiling : min a cap ≤ c) (floorA : e ≤ a - a % inc) : e ≤ c - c % inc := by
  have within : e ≤ c := by
    have : e ≤ a := Nat.le_trans floorA (Nat.sub_le _ _)
    have := Nat.le_min.mpr ⟨this, capped⟩
    omega
  have rounded := rounded_mono inc within
  rw [aligned] at rounded
  simpa using rounded

/-- A floor start is within the rounded top of R's balance and the slack, from the balance ceiling.

The start is aligned and within the floor of its balance and its cap, so it is within the ceiling.

Rounding the ceiling `H + S` down adds at most the slack, and `H` is within `H` and the band. -/
private theorem short_start_floor {inc e a cap H db S U : ℕ} (incPos : 0 < inc)
    (aligned : e % inc = 0) (capped : e ≤ cap) (ceiling : min a cap ≤ H + S)
    (floorA : e ≤ a - a % inc)
    (slack : S = 0 ∨ inc ≤ U + 1 ∨ (S < inc ∧ inc ≤ S + U)) :
    e ≤ (H + db) - (H + db) % inc + S + U := by
  have rounded := aligned_le_round aligned capped ceiling floorA
  have add := round_add_le (x := H) incPos slack
  have band := rounded_mono inc (show H ≤ H + db by omega)
  omega

/-- The effective balance of a key that stays on its path is at most the rise of the main regime.

Its `stay` has three cases: it equals R's, it ends at its start, or it is within the ceiling.

In the case where it ends at its start, `start` is within the cap and the rounded top.

The caller proves those two bounds of `start`. -/
private theorem rise_arith {inc band capFor high finEB start eR eC Bc capHigh S U : Nat}
    (incPos : 0 < inc)
    (stay : eC = eR ∨
      (eC ≤ start ∧ start ≤ capFor + S + U ∧ start ≤ (high + band) - (high + band) % inc + S + U) ∨
      (eC ≤ Bc + band ∧ eC ≤ max start (min (Bc - Bc % inc) capHigh)))
    (startLe : start ≤ max finEB ((high + S) - (high + S) % inc))
    (aligned : eC % inc = 0) (capped : eC ≤ capFor + S + U) (ceiling : Bc ≤ high + S)
    (slack : S = 0 ∨ inc ≤ U + 1 ∨ (S < inc ∧ inc ≤ S + U)) :
    eC ≤ eR + (min capFor (min (high + band - (high + band) % inc)
      (max finEB (high - high % inc))) - eR) + S + U := by
  rcases stay with same | ⟨atStart, viaCap, viaTop⟩ | ⟨boundary, update⟩
  · omega
  · have b := round_add_le (x := high) incPos slack
    omega
  · have alignedLe : ∀ x, eC ≤ x → eC ≤ x - x % inc := fun x le => by
      have := rounded_mono inc le
      rw [aligned] at this
      simpa using this
    have first := alignedLe _ (show eC ≤ high + band + S by omega)
    have second : eC ≤ max finEB (high - high % inc) + S + U := by
      have r := rounded_mono inc ceiling
      have b := round_add_le (x := high) incPos slack
      omega
    have third : eC ≤ high + band - (high + band) % inc + S + U := by
      have b := round_add_le (x := high + band) incPos slack
      omega
    omega

/-- The effective balance at the end of a run is at most the rounded bound on its balance.

The run starts at a state where the key's effective balance is within the largest one.

`Run.effective_floor_pair` bounds the balance at every state by `creditBound`, given the right `E`.

`E` is at least the effective balances that the bound allows.

Then the update of the effective balances reads that bound as its ceiling. -/
private theorem key_credit_ceiling {n y : ForkedBeaconState preset}
    (post : Run config checks n y) (early : y.fork < .glamsterdam) (fulu : .fusaka ≤ n.fork)
    (i : ℕ) (inside : i < n.state.validators.data.size) (high P E : ℕ)
    (aligned : preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat %
      preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0)
    (startCap : effectiveAt n i ≤ preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat)
    (capCeil : ∀ z ∈ post.balancePath,
      PinTerms.capAt z i ≤ preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat)
    (rate : ∀ z ∈ post.balancePath,
      i.toUInt64 ∉ getActiveValidatorIndices z.state (getPreviousEpoch z.state) ∨
      ∀ total perIncrement : Gwei,
        getTotalActiveBalance z.state = .ok total →
        getBaseRewardPerIncrement preset total = .ok perIncrement →
        perIncrement.toNat * ((∑ j ∈ (getActiveValidatorIndices z.state
          (getPreviousEpoch z.state)).toFinset, effectiveAt z j.toNat) /
            preset.EFFECTIVE_BALANCE_INCREMENT.toNat) ≤
          P * (total.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat))
    (endEpoch : (getCurrentEpoch y.state).toNat ≤ high + 1)
    (fixpoint : max (effectiveAt n i) (min preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat
      (PinKeyFloor.creditBound post i high E P preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat -
        PinKeyFloor.creditBound post i high E P preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat %
          preset.EFFECTIVE_BALANCE_INCREMENT.toNat)) ≤ E) :
    effectiveAt y i ≤ max (effectiveAt n i) (min
      (PinKeyFloor.creditBound post i high E P preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat -
        PinKeyFloor.creditBound post i high E P preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat %
          preset.EFFECTIVE_BALANCE_INCREMENT.toNat)
      preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat) := by
  obtain ⟨-, -, third, fourth⟩ := PinKeyFloor.Run.effective_floor_pair post early fulu i inside 0 0
    preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat high E P
  have balances := fourth aligned startCap capCeil rate endEpoch fixpoint
  exact (third _ aligned startCap
    (fun z member => balances z member) capCeil).1

/-- Rounding down after adding an amount adds at most its whole increments.

The base is first raised by one increment less one, which covers the rest of the amount. -/
private theorem rounded_add_floor_le (I x y : ℕ) (hI : 0 < I) :
    (x + y) - (x + y) % I ≤ (x + I - 1) - (x + I - 1) % I + I * (y / I) := by
  obtain ⟨q, r, hr, rfl⟩ : ∃ q r, r < I ∧ y = I * q + r :=
    ⟨y / I, y % I, Nat.mod_lt _ hI, (Nat.div_add_mod y I).symm⟩
  have quotient : (I * q + r) / I = q := by
    rw [Nat.mul_add_div hI, Nat.div_eq_of_lt hr, Nat.add_zero]
  have shifted : x + (I * q + r) = (x + r) + I * q := by ring
  have modulo : ((x + r) + I * q) % I = (x + r) % I := Nat.add_mul_mod_self_left _ _ _
  have mono := rounded_mono I (show x + r ≤ x + I - 1 by omega)
  rw [quotient, shifted, modulo]
  omega

/-- A cap above the activation balance belongs to a validator with compounding credentials. -/
private theorem compounding_of_cap {z : ForkedBeaconState preset} {i : ℕ}
    (electra : .pectra ≤ z.fork)
    (large : preset.MIN_ACTIVATION_BALANCE.toNat < PinTerms.capAt z i) :
    ∃ v, z.state.validators.data[i]? = some v ∧ hasCompoundingWithdrawalCredential v = true := by
  unfold PinTerms.capAt at large
  cases found : z.state.validators.data[i]? with
  | none => simp [found] at large
  | some v =>
    refine ⟨v, rfl, ?_⟩
    by_contra not
    have plain : hasCompoundingWithdrawalCredential v = false := by simpa using not
    simp [found, withdrawalMaxEffectiveBalance, electra, getMaxEffectiveBalance, plain] at large

/-- The cap of a validator is the largest effective balance if it compounds.

Otherwise it is the activation balance. -/
private theorem capAt_of_found {z : ForkedBeaconState preset} {i : ℕ} {v : Validator}
    (electra : .pectra ≤ z.fork) (found : z.state.validators.data[i]? = some v) :
    PinTerms.capAt z i = if hasCompoundingWithdrawalCredential v = true then
      preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat else preset.MIN_ACTIVATION_BALANCE.toNat := by
  unfold PinTerms.capAt
  rw [found]
  by_cases compounds : hasCompoundingWithdrawalCredential v = true <;>
    simp [withdrawalMaxEffectiveBalance, electra, getMaxEffectiveBalance, compounds]

/-- The activation balance and the largest balance are whole numbers of increments. -/
private theorem cap_values_aligned (aligned : MaxEffectiveBalancesAligned preset) :
    preset.MIN_ACTIVATION_BALANCE.toNat % preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0 ∧
    preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat % preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0 :=
  ⟨by simpa [UInt64.toNat_mod] using congrArg UInt64.toNat aligned.2.1,
    by simpa [UInt64.toNat_mod] using congrArg UInt64.toNat aligned.2.2⟩

/-- A key's cap is a whole number of increments. -/
private theorem capAt_aligned (aligned : MaxEffectiveBalancesAligned preset)
    {z : ForkedBeaconState preset} (electra : .pectra ≤ z.fork) {i : ℕ} {w : Validator}
    (found : z.state.validators.data[i]? = some w) :
    PinTerms.capAt z i % preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0 := by
  rw [capAt_of_found electra found]
  have values := cap_values_aligned aligned
  split <;> first | exact values.1 | exact values.2

/-- From Fusaka, a slot step before Gloas keeps whether each validator of its first state compounds.

It keeps the position of each such validator. -/
private theorem slot_compounding_kept {m n : ForkedBeaconState preset}
    (ok : advanceSlotAcross config checks m = .ok n) (fulu : .fusaka ≤ m.fork)
    (early : n.fork < .glamsterdam) {i : ℕ} {v : Validator}
    (found : m.state.validators.data[i]? = some v) :
    ∃ w, n.state.validators.data[i]? = some w ∧
      hasCompoundingWithdrawalCredential w = hasCompoundingWithdrawalCredential v := by
  obtain ⟨advanced, advancedOk, upgraded⟩ := bind_ok_iff.mp ok
  obtain rfl := DirectSafety.Apriori.Internal.processUpgrades_eq_of_window upgraded fulu early
  obtain ⟨_, cached, epoched, _, cachedOk, epochedOk, rfl⟩ := advanceSlot_ok advancedOk
  obtain ⟨_, _, _, _, rfl⟩ := processSlot_ok cachedOk
  rcases epochIfLast_cases epochedOk with ⟨_, epochOk⟩ | ⟨_, rfl⟩
  · have altair : .altair ≤ m.fork := Nat.le_trans (by decide) fulu
    simp only [processEpoch, altair, ↓reduceDIte] at epochOk
    obtain ⟨later, laterFound, same⟩ := processEpochAltair_credentials epochOk found
    exact ⟨later, laterFound, by unfold hasCompoundingWithdrawalCredential; rw [same]⟩
  · exact ⟨v, found, rfl⟩

/-- A consolidation request keeps whether a validator compounds.

Otherwise it makes the validator compound and leaves its balance within the activation balance. -/
private theorem consolidationRequest_flip {s t : BeaconState preset fork}
    {electra : .pectra ≤ fork} {request : ConsolidationRequest}
    (ok : processConsolidationRequest config s electra request = .ok t)
    {key : ValidatorIndex} {v : Validator} (found : s.validators.data[key.toNat]? = some v) :
    ∃ w, t.validators.data[key.toNat]? = some w ∧
      (hasCompoundingWithdrawalCredential w = hasCompoundingWithdrawalCredential v ∨
        (hasCompoundingWithdrawalCredential w = true ∧
          actualBalanceAt (⟨fork, t⟩ : ForkedBeaconState preset) key.toNat ≤
            preset.MIN_ACTIVATION_BALANCE.toNat)) := by
  obtain ⟨conv, ledger, -⟩ := BlockLedger.ledger_processConsolidationRequest ok
  by_cases member : key ∈ conv
  · obtain ⟨w, located, compounds⟩ := ledger.switched key member
    have capped := ledger.converted key member
    exact ⟨w, located, .inr ⟨compounds, by simpa using capped⟩⟩
  · obtain ⟨w, located, same⟩ := ledger.kept key v member found
    exact ⟨w, located, .inl same⟩

/-- A fold of consolidation requests that each record an excess event.

The balance of a key rises by at most the credits of the events.

The key may switch from plain to compounding credentials in the fold.

Then it ends within the activation balance plus the credits of the events. -/
private theorem excess_fold {electra : .pectra ≤ fork}
    (lim : ConsolidationRequest → BeaconState preset fork → Except TransitionError (ℕ × ℕ))
    (key : ValidatorIndex) :
    ∀ (requests : List ConsolidationRequest) (r rN : BeaconState preset fork)
      (E E' : List (BalanceEvent preset)),
      requests.foldlM (fun pre request => recordBalance .excess (lim request)
        (processConsolidationRequest config · electra request) pre) (r, E) = .ok (rN, E') →
      ∃ Ec : List (BalanceEvent preset), E' = E ++ Ec ∧
        actualBalanceAt (⟨fork, rN⟩ : ForkedBeaconState preset) key.toNat ≤
          actualBalanceAt (⟨fork, r⟩ : ForkedBeaconState preset) key.toNat +
            (Ec.map (keyCredit key.toNat)).sum ∧
        ∀ v, r.validators.data[key.toNat]? = some v →
          hasCompoundingWithdrawalCredential v = false → ∀ w,
          rN.validators.data[key.toNat]? = some w → hasCompoundingWithdrawalCredential w = true →
            actualBalanceAt (⟨fork, rN⟩ : ForkedBeaconState preset) key.toNat ≤
              preset.MIN_ACTIVATION_BALANCE.toNat + (Ec.map (keyCredit key.toNat)).sum := by
  intro requests
  induction requests with
  | nil =>
    intro r rN E E' ok
    simp only [List.foldlM_nil, pure, Except.pure, Except.ok.injEq, Prod.mk.injEq] at ok
    obtain ⟨rfl, rfl⟩ := ok
    refine ⟨[], by simp, by simp, fun v found plain w foundW switched => ?_⟩
    have same := Option.some.inj (found.symm.trans foundW)
    subst same
    exact absurd (switched.symm.trans plain) (by decide)
  | cons request rest ih =>
    intro r rN E E' ok
    rw [List.foldlM_cons, bind_ok_iff] at ok
    obtain ⟨⟨after, recorded⟩, step, others⟩ := ok
    obtain ⟨credit, debit, -, actionOk, rfl⟩ :=
      DirectSafety.Apriori.Internal.recordBalance_single step
    obtain ⟨Ec, rfl, rise, later⟩ := ih after rN _ E' others
    refine ⟨⟨.excess, ⟨fork, r⟩, ⟨fork, after⟩, credit, debit⟩ :: Ec, by simp, ?_, ?_⟩
    · simp only [List.map_cons, List.sum_cons, keyCredit]
      omega
    · intro v found plain w foundW switched
      obtain ⟨v', found', changed⟩ := consolidationRequest_flip actionOk found
      rcases changed with same | ⟨_, capped⟩
      · have bound := later v' found' (same.trans plain) w foundW switched
        simp only [List.map_cons, List.sum_cons, keyCredit]
        omega
      · simp only [List.map_cons, List.sum_cons, keyCredit]
        omega

/-- Whether each validator compounds is the same at two states. -/
private def CompKept {f : Fork} (s t : BeaconState preset f) : Prop :=
  ∀ (v : ValidatorIndex) (validator : Validator), s.validators.data[v.toNat]? = some validator →
    ∃ later, t.validators.data[v.toNat]? = some later ∧
      hasCompoundingWithdrawalCredential later = hasCompoundingWithdrawalCredential validator

/-- Compounding is kept across two steps when each step keeps it. -/
private theorem CompKept.trans {f : Fork} {s u t : BeaconState preset f} (one : CompKept s u)
    (two : CompKept u t) : CompKept s t := fun v validator located => by
  obtain ⟨middle, middleFound, same⟩ := one v validator located
  obtain ⟨later, laterFound, same'⟩ := two v middle middleFound
  exact ⟨later, laterFound, same'.trans same⟩

/-- A block ledger with no credited keys keeps compounding. -/
private theorem CompKept.of_ledger {f : Fork} {s t : BeaconState preset f}
    {paid : Finset ValidatorIndex} {sync other slash : ValidatorIndex → ℕ}
    (ledger : BlockLedger.Ledger s t paid ∅ sync other slash) : CompKept s t :=
  fun v validator located => ledger.kept v validator (Finset.notMem_empty v) located

/-- From Fulu and before Gloas, a block's replay leaves a switched key within activation balance.

The key switches by a consolidation request.

The events after the switch then add their credits. -/
private theorem block_flip_balance {engine : ExecutionEngine preset fork}
    {s t : BeaconState preset fork} {block : BeaconBlock preset fork}
    {events : List (BalanceEvent preset)} (early : fork < .glamsterdam) (fulu : .fusaka ≤ fork)
    (matched : BalancesMatch s)
    (replayed : blockBalanceReplay (config := config) (checks := checks) early engine s block =
      .ok (t, events))
    (key : ValidatorIndex) {v w : Validator} (found : s.validators.data[key.toNat]? = some v)
    (plain : hasCompoundingWithdrawalCredential v = false)
    (foundT : t.validators.data[key.toNat]? = some w)
    (switched : hasCompoundingWithdrawalCredential w = true) :
    actualBalanceAt (⟨fork, t⟩ : ForkedBeaconState preset) key.toNat ≤
      preset.MIN_ACTIVATION_BALANCE.toNat + (events.map (keyCredit key.toNat)).sum := by
  have altair : .altair ≤ fork := Nat.le_trans (by decide) fulu
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) fulu
  have bellatrix : .bellatrix ≤ fork := Nat.le_trans (by decide) fulu
  unfold blockBalanceReplay at replayed
  dsimp only at replayed
  obtain ⟨⟨u1, E1⟩, h1, replayed⟩ := bind_ok_iff.mp replayed
  rw [dite_eq_left_of_eq_true (eq_true bellatrix)] at replayed
  obtain ⟨⟨u2, E2⟩, h2, replayed⟩ := bind_ok_iff.mp replayed
  obtain ⟨⟨u3, E3⟩, h3, replayed⟩ := bind_ok_iff.mp replayed
  obtain ⟨⟨u4, E4⟩, h4, replayed⟩ := bind_ok_iff.mp replayed
  obtain ⟨_, -, replayed⟩ := bind_ok_iff.mp replayed
  obtain ⟨_, -, replayed⟩ := bind_ok_iff.mp replayed
  obtain ⟨p5, h5, replayed⟩ := bind_ok_iff.mp replayed
  obtain ⟨p6, h6, replayed⟩ := bind_ok_iff.mp replayed
  obtain ⟨p7, h7, replayed⟩ := bind_ok_iff.mp replayed
  obtain ⟨p8, h8, replayed⟩ := bind_ok_iff.mp replayed
  obtain ⟨⟨u9, E9⟩, h9, replayed⟩ := bind_ok_iff.mp replayed
  obtain ⟨⟨u10, E10⟩, h10, replayed⟩ := bind_ok_iff.mp replayed
  rw [dite_eq_left_of_eq_true (eq_true electra)] at replayed
  obtain ⟨⟨u11, E11⟩, h11, replayed⟩ := bind_ok_iff.mp replayed
  obtain ⟨⟨u12, E12⟩, h12, replayed⟩ := bind_ok_iff.mp replayed
  obtain ⟨⟨rN, E13⟩, hfold, replayed⟩ := bind_ok_iff.mp replayed
  rw [dite_eq_left_of_eq_true (eq_true altair)] at replayed
  -- The states before the consolidation requests.
  obtain ⟨hu1, -⟩ := PinEventsKept.carryBalance_cases h1
  obtain ⟨_, _, -, hu2, -⟩ := DirectSafety.Apriori.Internal.recordBalance_single h2
  obtain ⟨hu3, -⟩ := PinEventsKept.carryBalance_cases h3
  obtain ⟨hu4, -⟩ := PinEventsKept.carryBalance_cases h4
  have f5 := DirectSafety.Apriori.Internal.recordFold_plain _ _ _ _ _ h5
  have f6 := DirectSafety.Apriori.Internal.recordFold_plain _ _ _ _ _ h6
  have f7 := DirectSafety.Apriori.Internal.recordFold_plain _ _ _ _ _ h7
  have f8 := DirectSafety.Apriori.Internal.recordFold_plain _ _ _ _ _ h8
  obtain ⟨hu9, -⟩ := PinEventsKept.carryBalance_cases h9
  obtain ⟨hu10, -⟩ := PinEventsKept.carryBalance_cases h10
  obtain ⟨hu11, -⟩ := PinEventsKept.carryBalance_cases h11
  obtain ⟨hu12, -⟩ := PinEventsKept.carryBalance_cases h12
  have matchedInput : BalancesMatch u4 :=
    ((frame_processBlockHeader hu1).toFrame.trans
      ((frame_processBlockExecution hu2).toFrame.trans
        ((frame_processRandao hu3).toFrame.trans
          (frame_processEth1Data hu4).toFrame))).balancesMatch matched
  obtain ⟨_, executed, -⟩ := BlockLedger.ledger_processBlockExecution early hu2
  have toInput : CompKept s u4 :=
    (CompKept.of_ledger (BlockLedger.ledger_processBlockHeader hu1)).trans <|
      (CompKept.of_ledger executed).trans <|
        (CompKept.of_ledger (BlockLedger.ledger_processRandao hu3)).trans
          (CompKept.of_ledger (BlockLedger.ledger_processEth1Data hu4))
  have toRequests : CompKept u4 u12 := BlockCredits.compoundingKept_beforeConsolidations
    early fulu electra matchedInput f5 f6 f7 f8 (by rw [Array.foldlM_toList]; exact hu9) hu10
    (by rw [Array.foldlM_toList]; exact hu11) (by rw [Array.foldlM_toList]; exact hu12)
  obtain ⟨v0, found0, same0⟩ := (toInput.trans toRequests) key v found
  -- The consolidation requests, then the sync aggregate.
  obtain ⟨Ec, rfl, -, switchedBound⟩ := excess_fold (electra := electra) _ key _ _ _ _ _ hfold
  obtain ⟨_, _, -, hu, rfl⟩ := DirectSafety.Apriori.Internal.recordBalance_single replayed
  have kept := (BlockLedger.processSyncAggregate_kept hu).1
  rw [kept] at foundT
  have bound := switchedBound v0 found0 (same0.trans plain) w foundT switched
  simp only [List.map_append, List.sum_append, List.map_cons, List.map_nil, List.sum_cons,
    List.sum_nil, keyCredit]
  omega

/-- A step that makes a registered key compound is not a slot step.

A slot step keeps whether each validator of its first state compounds. -/
private theorem step_flip_not_slot {m n : ForkedBeaconState preset} (step : Step config checks m n)
    (early : n.fork < .glamsterdam) (fulu : .fusaka ≤ m.fork)
    (i : ℕ) (inside : i < m.state.validators.data.size)
    (flat : ¬preset.MIN_ACTIVATION_BALANCE.toNat < PinTerms.capAt m i)
    (large : preset.MIN_ACTIVATION_BALANCE.toNat < PinTerms.capAt n i) :
    ∀ ok : advanceSlotAcross config checks m = .ok n, step ≠ Step.slot ok := by
  intro ok same
  subst same
  have electraM : .pectra ≤ m.fork := Nat.le_trans (by decide) fulu
  have electraN : .pectra ≤ n.fork := Nat.le_trans electraM (Step.slot ok).chainStep.fork_le
  obtain ⟨v, found⟩ : ∃ v, m.state.validators.data[i]? = some v :=
    ⟨_, Array.getElem?_eq_getElem inside⟩
  obtain ⟨w, foundN, switched⟩ := compounding_of_cap electraN large
  have strict : preset.MIN_ACTIVATION_BALANCE.toNat <
      preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat := by
    have large' := large
    rw [capAt_of_found electraN foundN, switched] at large'
    simpa using large'
  have plain : hasCompoundingWithdrawalCredential v = false := by
    by_contra compounds
    have yes : hasCompoundingWithdrawalCredential v = true := by simpa using compounds
    rw [capAt_of_found electraM found, yes] at flat
    simp at flat
    omega
  obtain ⟨w', found', same⟩ := slot_compounding_kept ok fulu early found
  have equal := Option.some.inj (found'.symm.trans foundN)
  subst equal
  simp [switched, plain] at same

/-- A step makes a key compound.

It leaves the balance of the key within the activation balance plus the credits of the step. -/
private theorem step_flip_balance {m n : ForkedBeaconState preset} (step : Step config checks m n)
    (early : n.fork < .glamsterdam) (fulu : .fusaka ≤ m.fork) (invariant : Invariant m.state)
    (i : ℕ) (flat : ¬preset.MIN_ACTIVATION_BALANCE.toNat < PinTerms.capAt m i)
    (large : preset.MIN_ACTIVATION_BALANCE.toNat < PinTerms.capAt n i) :
    actualBalanceAt n i ≤ preset.MIN_ACTIVATION_BALANCE.toNat +
      stepCredit (fun _ => true) (fun _ => true) i step := by
  obtain ⟨events, replayed⟩ := step.balanceEvents_ok early
  have base := PinKeyFloor.step_balance_le_events step early i replayed
  have credit : stepCredit (fun _ => true) (fun _ => true) i step =
      (events.map (keyCredit i)).sum := by
    cases step <;> simp [stepCredit, replayed, Except.toOption]
  rw [credit]
  cases found : m.state.validators.data[i]? with
  | none =>
    have out := Array.getElem?_eq_none_iff.mp found
    have sizes := invariant.balancesMatch
    unfold BalancesMatch at sizes
    have zero : actualBalanceAt m i = 0 := by
      simp [actualBalanceAt,
        Array.getElem?_eq_none (show m.state.balances.data.size ≤ i by omega)]
    omega
  | some v =>
    cases step with
    | slot ok =>
      have inside := (Array.getElem?_eq_some_iff.mp found).1
      exact absurd rfl (step_flip_not_slot (Step.slot ok) early fulu i inside flat large ok)
    | @block f s t engine signed due ok =>
      have electra : .pectra ≤ f := Nat.le_trans (by decide) fulu
      obtain ⟨w, foundN, switched⟩ := compounding_of_cap electra large
      have strict : preset.MIN_ACTIVATION_BALANCE.toNat <
          preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat := by
        rw [capAt_of_found electra foundN, switched] at large
        simpa using large
      have plain : hasCompoundingWithdrawalCredential v = false := by
        by_contra compounds
        have yes : hasCompoundingWithdrawalCredential v = true := by simpa using compounds
        rw [capAt_of_found electra found, yes] at flat
        simp at flat
        omega
      have replay := Step.balanceEvents_block (fork := f) early replayed
      have inside : i < s.validators.data.size := (Array.getElem?_eq_some_iff.mp found).1
      have bound := inside.trans (BeaconState.validators_size_lt_of_lt_glamsterdam early s)
      obtain ⟨key, hkey⟩ : ∃ key : ValidatorIndex, key.toNat = i :=
        ⟨UInt64.ofNat i, UInt64.toNat_ofNat_of_lt' bound⟩
      subst hkey
      exact block_flip_balance (fork := f) early fulu invariant.balancesMatch replay key found
        plain foundN switched

/-- A step that makes a key compound leaves its balance within the smaller of two bounds.

Those are its balance before the step and the activation balance, each plus the credits of the step.

Both bounds add the same credits, so the smaller of the two bases carries them. -/
private theorem step_flip_min {m n : ForkedBeaconState preset} (step : Step config checks m n)
    (early : n.fork < .glamsterdam) (fulu : .fusaka ≤ m.fork) (invariant : Invariant m.state)
    (i : ℕ) (flat : ¬preset.MIN_ACTIVATION_BALANCE.toNat < PinTerms.capAt m i)
    (large : preset.MIN_ACTIVATION_BALANCE.toNat < PinTerms.capAt n i) :
    actualBalanceAt n i ≤ min (actualBalanceAt m i) preset.MIN_ACTIVATION_BALANCE.toNat +
      stepCredit (fun _ => true) (fun _ => true) i step := by
  obtain ⟨events, replayed⟩ := step.balanceEvents_ok early
  have base := PinKeyFloor.step_balance_le_events step early i replayed
  have credit : stepCredit (fun _ => true) (fun _ => true) i step =
      (events.map (keyCredit i)).sum := by
    cases step <;> simp [stepCredit, replayed, Except.toOption]
  have flip := step_flip_balance step early fulu invariant i flat large
  rw [credit] at flip ⊢
  omega

/-- A step that makes a registered key compound stays in its epoch.

It is a block step, and a block keeps the slot. -/
private theorem step_flip_epoch {m n : ForkedBeaconState preset} (step : Step config checks m n)
    (early : n.fork < .glamsterdam) (fulu : .fusaka ≤ m.fork)
    (i : ℕ) (inside : i < m.state.validators.data.size)
    (flat : ¬preset.MIN_ACTIVATION_BALANCE.toNat < PinTerms.capAt m i)
    (large : preset.MIN_ACTIVATION_BALANCE.toNat < PinTerms.capAt n i) :
    (getCurrentEpoch n.state).toNat = (getCurrentEpoch m.state).toNat := by
  cases step with
  | slot ok =>
    exact absurd rfl (step_flip_not_slot (Step.slot ok) early fulu i inside flat large ok)
  | @block f s t engine signed due ok =>
    obtain ⟨-, processed, -⟩ := applySignedBlock_ok ok
    have slot := (frame_processBlock processed).slot
    simp only [getCurrentEpoch, slot]

/-- A run from a key with plain credentials to a key with compounding credentials splits at a step.

The step makes the key compound.

It leaves the balance of the key within the activation balance plus the credits of the step.

If the key is in the registry of the first state, the step does not cross an epoch. -/
private theorem Run.flip_split {x y : ForkedBeaconState preset} (tail : Run config checks x y)
    (early : y.fork < .glamsterdam) (fulu : .fusaka ≤ x.fork) (invariant : Invariant x.state)
    (i : ℕ) (flat : PinTerms.capAt x i ≤ preset.MIN_ACTIVATION_BALANCE.toNat)
    (compounding : preset.MIN_ACTIVATION_BALANCE.toNat < PinTerms.capAt y i) :
    ∃ (m n : ForkedBeaconState preset) (pre : Run config checks x m) (step : Step config checks m n)
      (post : Run config checks n y),
      (pre.snoc step).append post = tail ∧
      PinTerms.capAt m i ≤ preset.MIN_ACTIVATION_BALANCE.toNat ∧
      preset.MIN_ACTIVATION_BALANCE.toNat < PinTerms.capAt n i ∧
      actualBalanceAt n i ≤ preset.MIN_ACTIVATION_BALANCE.toNat +
        stepCredit (fun _ => true) (fun _ => true) i step ∧
      (i < x.state.validators.data.size →
        (getCurrentEpoch n.state).toNat = (getCurrentEpoch m.state).toNat) := by
  obtain ⟨m, n, pre, step, post, split, notYet, arrived⟩ := Run.split_at_flip tail
    (fun z => preset.MIN_ACTIVATION_BALANCE.toNat < PinTerms.capAt z i)
    (show ¬preset.MIN_ACTIVATION_BALANCE.toNat < PinTerms.capAt x i by omega) compounding
  have before : ¬preset.MIN_ACTIVATION_BALANCE.toNat < PinTerms.capAt m i := notYet
  have after : preset.MIN_ACTIVATION_BALANCE.toNat < PinTerms.capAt n i := arrived
  have fuluM : .fusaka ≤ m.fork := Nat.le_trans fulu (fork_le_of_chainSteps pre.chainSteps)
  have earlyN : n.fork < .glamsterdam :=
    Nat.lt_of_le_of_lt (fork_le_of_chainSteps post.chainSteps) early
  exact ⟨m, n, pre, step, post, split.symm, Nat.le_of_not_lt before, after,
    step_flip_balance step earlyN fuluM (Run.invariant invariant pre) i before after,
    fun inside => step_flip_epoch step earlyN fuluM i
      (Nat.lt_of_lt_of_le inside (registryGrows_of_chainSteps pre.chainSteps)) before after⟩

/-- The penalty rate of a rewards pass at a state of a run from the finalized state is bounded.

It is at most the pin's leak rate at the key's effective balance there. -/
private theorem passRate_le_leakAt (h : Setting config checks g split fin pulled anc counted V)
    {m : BeaconState preset fork} (toM : Run config checks ⟨fork, fin⟩ ⟨fork, m⟩)
    (inside : (getCurrentEpoch m).toNat ≤ (getCurrentEpoch pulled).toNat + 1)
    {total : Gwei} (totalOk : getTotalActiveBalance m = .ok total)
    {pq : Gwei} (pqOk : getBaseRewardPerIncrement preset
      (if 18 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤
          ((getTotalActiveBalance pulled).toOption.getD 0).toNat then
        (getTotalActiveBalance pulled).toOption.getD 0 / 4
      else preset.EFFECTIVE_BALANCE_INCREMENT / 5) = .ok pq) (v : ℕ) :
    passPenaltyRate config (⟨fork, m⟩ : ForkedBeaconState preset) v ≤
      (pinTerms config pulled anc fin).leakAt (effectiveAt (⟨fork, m⟩ : ForkedBeaconState preset) v)
        v := by
  obtain ⟨T, pulledOk⟩ := h.pulledTotal
  obtain ⟨shared⟩ := h.toFin
  have altair : .altair ≤ fork := Nat.le_trans (by decide) h.fulu
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  have aligned : preset.EFFECTIVE_BALANCE_INCREMENT.toNat ∣
      effectiveAt (⟨fork, m⟩ : ForkedBeaconState preset) v :=
    Nat.dvd_of_mod_eq_zero
      (DirectSafety.Apriori.Internal.FloorTrace.effective_aligned (shared.append toM) h.genesis
        h.aligned v)
  have bandTotal := (total_band_of_setting h toM h.early inside totalOk pulledOk).1
  have band : 2 * T.toNat ≤ 3 * activeBalanceTotal m := by
    rw [← getTotalActiveBalance_toNat totalOk]
    exact bandTotal
  have fromFinEpoch := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps toM.chainSteps)
  simp only at fromFinEpoch
  have scored : (if altair : .altair ≤ fork then
        (((m.inactivityScores altair).data[v]?).map (·.toNat)).getD 0 else 0) +
      config.INACTIVITY_SCORE_BIAS.toNat ≤
      (if altair : .altair ≤ fork then
        (((fin.inactivityScores altair).data[v]?).map (·.toNat)).getD 0 else 0) +
      ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) *
        config.INACTIVITY_SCORE_BIAS.toNat := by
    simp only [altair, ↓reduceDIte]
    have depth : (getCurrentEpoch m).toNat - (getCurrentEpoch fin).toNat + 1 ≤
        (getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat := by omega
    have times := Nat.mul_le_mul_right config.INACTIVITY_SCORE_BIAS.toNat depth
    cases read : (m.inactivityScores altair).data[v]? with
    | none =>
      simp only [Option.map_none, Option.getD_none, Nat.zero_add]
      refine le_trans ?_ (Nat.le_add_left _ _)
      rw [Nat.add_mul, Nat.one_mul] at times
      omega
    | some score =>
      have grown := DirectSafety.Apriori.Internal.runScore_le_start toM altair h.early
        (.inl electra) altair (i := v) read
      simp only [Option.map_some, Option.getD_some]
      rw [Nat.add_mul, Nat.one_mul] at times
      simp only at grown
      rw [Nat.mul_comm (_ - _)] at times
      nlinarith
  have key := PinKeyFloor.passPenaltyRate_le_leak (config := config)
    (⟨fork, m⟩ : ForkedBeaconState preset) v T.toNat _ h.facts T.toNat_lt aligned band scored
  dsimp only at key
  refine Nat.le_trans key ?_
  simp only [pinTerms]
  have totalRead : (getTotalActiveBalance pulled).toOption.getD 0 = T := by
    rw [pulledOk]
    rfl
  rw [totalRead] at pqOk ⊢
  rw [pqOk]
  simp only [Except.toOption, Option.getD_some]
  have perIncrement := toNat_getBaseRewardPerIncrement pqOk
  rw [quarter_toNat] at perIncrement
  refine Nat.le_of_eq ?_
  rw [perIncrement]

/-- The pending keys of `pinTerms` are validators of R's registry.

Each is not yet eligible at R's epoch, and has no activation epoch. -/
private theorem pendingRB_iff (config : Config) (pulled anc fin : BeaconState preset fork)
    (i : ℕ) : (pinTerms config pulled anc fin).pendingRB i = true ↔
      ∃ w, pulled.validators.data[i]? = some w ∧
        (getCurrentEpoch pulled).toNat < w.activationEligibilityEpoch.toNat ∧
        w.activationEpoch = FAR_FUTURE_EPOCH := by
  simp only [pinTerms]
  cases pulled.validators.data[i]? <;> simp

/-- The late keys of `pinTerms` are validators of R's registry.

Each has an eligibility epoch by R's epoch.

Its activation epoch is beyond the seed lookahead of the finalized epoch. -/
private theorem lateB_iff (config : Config) (pulled anc fin : BeaconState preset fork) (i : ℕ) :
    (pinTerms config pulled anc fin).lateB i = true ↔ ∃ w, pulled.validators.data[i]? = some w ∧
      w.activationEligibilityEpoch.toNat ≤ (getCurrentEpoch pulled).toNat ∧
      anc.finalizedCheckpoint.epoch.toNat + preset.MAX_SEED_LOOKAHEAD.toNat <
        w.activationEpoch.toNat := by
  simp only [pinTerms]
  cases pulled.validators.data[i]? <;> simp

/-- The keys of `pinTerms` whose exit R reads are validators of R's registry.

Each is active in R's previous epoch or its current one, and unslashed or recently slashed.

Its exit epoch is at most one after R's epoch. -/
private theorem exitingB_iff (config : Config) (pulled anc fin : BeaconState preset fork)
    (i : ℕ) : (pinTerms config pulled anc fin).exitingB i = true ↔
      ∃ w, pulled.validators.data[i]? = some w ∧
        (isActiveAt pulled (getPreviousEpoch pulled) i = true ∨
          isActiveAt pulled (getCurrentEpoch pulled) i = true) ∧
        (w.slashed = false ∨ anc.finalizedCheckpoint.epoch.toNat +
          preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat ≤ w.withdrawableEpoch.toNat) ∧
        w.exitEpoch.toNat ≤ (getCurrentEpoch pulled).toNat + 1 := by
  simp only [pinTerms]
  rcases Option.eq_none_or_eq_some (pulled.validators.data[i]?) with none | ⟨w, some⟩
  · simp [none]
  · simp [some]

/-- The keys of `pinTerms` whose exit R holds are validators of R's registry.

Each exit was set after the finalized epoch, and R's epoch is past it. -/
private theorem exitedRB_iff (config : Config) (pulled anc fin : BeaconState preset fork)
    (i : ℕ) : (pinTerms config pulled anc fin).exitedRB i = true ↔
      ∃ w, pulled.validators.data[i]? = some w ∧
        anc.finalizedCheckpoint.epoch.toNat + 1 + preset.MAX_SEED_LOOKAHEAD.toNat ≤
          w.exitEpoch.toNat ∧ w.exitEpoch.toNat + 1 ≤ (getCurrentEpoch pulled).toNat := by
  simp only [pinTerms]
  cases pulled.validators.data[i]? <;> simp

/-- The finalized epoch of R is at most its current epoch. -/
private theorem finalized_le_current {g : ForkedBeaconState preset}
    {split fin pulled anc counted : BeaconState preset fork} {V : Finset ValidatorIndex}
    (h : Setting config checks g split fin pulled anc counted V) :
    pulled.finalizedCheckpoint.epoch ≤ getCurrentEpoch pulled := by
  obtain ⟨rf⟩ := h.toFin
  obtain ⟨rs⟩ := h.fromFin
  obtain ⟨rp⟩ := h.toPulled
  have valid := Run.invariant (Genesis.invariant h.genesis) ((rf.append rs).append rp)
  exact UInt64.le_trans valid.ordered.1 (UInt64.le_trans valid.ordered.2
    (UInt64.le_trans valid.settled (getPreviousEpoch_le pulled)))

/-- The epochs of the setting, as natural numbers, in the order of its runs.

The finalized epoch of the ancestor is at most the split's, which is at most R's.

C's epoch is R's or the next, and the epoch after R's is below the far future. -/
private theorem setting_epochs {g : ForkedBeaconState preset}
    {split fin pulled anc counted : BeaconState preset fork} {V : Finset ValidatorIndex}
    (h : Setting config checks g split fin pulled anc counted V) :
    anc.finalizedCheckpoint.epoch.toNat ≤ (getCurrentEpoch split).toNat ∧
      (getCurrentEpoch split).toNat ≤ (getCurrentEpoch pulled).toNat ∧
      (getCurrentEpoch pulled).toNat ≤ (getCurrentEpoch counted).toNat ∧
      (getCurrentEpoch counted).toNat ≤ (getCurrentEpoch pulled).toNat + 1 ∧
      (getCurrentEpoch pulled).toNat + 1 < FAR_FUTURE_EPOCH.toNat ∧
      FAR_FUTURE_EPOCH.toNat = 2 ^ 64 - 1 ∧
      (getCurrentEpoch pulled + 1).toNat = (getCurrentEpoch pulled).toNat + 1 ∧
      pulled.finalizedCheckpoint.epoch.toNat ≤ (getCurrentEpoch pulled).toNat := by
  have below := getCurrentEpoch_succ_lt_farFuture h.twoSlots pulled
  have farNat : FAR_FUTURE_EPOCH.toNat = 2 ^ 64 - 1 := rfl
  refine ⟨UInt64.le_iff_toNat_le.mp h.finalized, UInt64.le_iff_toNat_le.mp h.called,
    UInt64.le_iff_toNat_le.mp h.later, h.near, below, farNat, ?_,
    UInt64.le_iff_toNat_le.mp (finalized_le_current h)⟩
  have one : (1 : UInt64).toNat = 1 := rfl
  rw [UInt64.toNat_add, one]
  exact Nat.mod_eq_of_lt (by omega)

/-- A key of `K6` in R's registry has no exit, or an exit after the split's lookahead.

An exit at or before the split's epoch plus the seed lookahead is on the shared prefix of the runs.

Both runs then agree on the key's activity up to that exit, so C would not count the key.

The records of the key at R and at C, and what they say of its activity, are the premises. -/
private theorem K6_exit_late {g : ForkedBeaconState preset}
    {split fin pulled anc counted : BeaconState preset fork} {V : Finset ValidatorIndex}
    (h : Setting config checks g split fin pulled anc counted V) {v : ValidatorIndex}
    {w u : Validator} (found : pulled.validators.data[v.toNat]? = some w)
    (rActive : ∀ e : Epoch, isActiveAt pulled e v.toNat = true ↔
      (w.activationEpoch.toNat ≤ e.toNat ∧ e.toNat < w.exitEpoch.toNat))
    (cActive : ∀ e : Epoch, isActiveAt counted e v.toNat = true ↔
      (u.activationEpoch.toNat ≤ e.toNat ∧ e.toNat < u.exitEpoch.toNat))
    (uExit : (getCurrentEpoch counted).toNat < u.exitEpoch.toNat)
    (notActive : ¬ (w.activationEpoch.toNat ≤ (getCurrentEpoch pulled).toNat ∧
      (getCurrentEpoch pulled).toNat < w.exitEpoch.toNat)) :
    w.exitEpoch = FAR_FUTURE_EPOCH ∨
      (getCurrentEpoch split).toNat + preset.MAX_SEED_LOOKAHEAD.toNat < w.exitEpoch.toNat := by
  by_cases far : w.exitEpoch = FAR_FUTURE_EPOCH
  · exact .inl far
  refine .inr ?_
  by_contra early
  obtain ⟨rf⟩ := h.toFin
  obtain ⟨rs⟩ := h.fromFin
  obtain ⟨rp⟩ := h.toPulled
  have gap := Run.exit_activation_gap ((rf.append rs).append rp) h.genesis v.toNat w found far
  have called := UInt64.le_iff_toNat_le.mp h.called
  have later := UInt64.le_iff_toNat_le.mp h.later
  have shareA := activity_shared h (e := w.activationEpoch) (by omega) v.toNat
  have shareX := activity_shared h (e := w.exitEpoch) (by omega) v.toNat
  have activeA : isActiveAt pulled w.activationEpoch v.toNat = true :=
    (rActive _).mpr ⟨Nat.le_refl _, by omega⟩
  have atA := (cActive _).mp (shareA.symm.trans activeA)
  have notX : ¬ isActiveAt counted w.exitEpoch v.toNat = true := by
    rw [← shareX]
    intro active
    have := (rActive _).mp active
    omega
  have ended := mt (cActive w.exitEpoch).mpr notX
  omega

/-- A key of the split's registry that R has withdrawable by the finalized epoch is not charged.

The charge would be on C's tail.

Its exit is at most its withdrawable epoch, so R's exit is assigned by the finalized epoch.

An exit assigned after the split is at least the split's epoch plus one and the seed lookahead.

So the split already holds the exit, and a run never charges an exit twice. -/
private theorem no_charge_of_settled {g : ForkedBeaconState preset}
    {split fin pulled anc counted : BeaconState preset fork} {V : Finset ValidatorIndex}
    (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) {i : ℕ} {w : Validator}
    (inside : i < split.validators.data.size) (found : pulled.validators.data[i]? = some w)
    (settled : w.withdrawableEpoch.toNat ≤ anc.finalizedCheckpoint.epoch.toNat) :
    ∀ c ∈ tailC.departureCharges, c.index ≠ i := by
  obtain ⟨rf⟩ := h.toFin
  obtain ⟨rs⟩ := h.fromFin
  obtain ⟨rp⟩ := h.toPulled
  have valid := Run.invariant (Genesis.invariant h.genesis) ((rf.append rs).append rp)
  have ordered := UInt64.le_iff_toNat_le.mp
    (valid.exitsOrdered w (Array.mem_of_getElem? found))
  have finSplit := UInt64.le_iff_toNat_le.mp h.finalized
  have below := getCurrentEpoch_succ_lt_farFuture h.twoSlots split
  have farNat : FAR_FUTURE_EPOCH.toNat = 2 ^ 64 - 1 := rfl
  have oldFound := Array.getElem?_eq_getElem inside
  have assigned : split.validators.data[i].exitEpoch ≠ FAR_FUTURE_EPOCH := by
    intro unset
    have wAssigned : w.exitEpoch ≠ FAR_FUTURE_EPOCH := by
      intro far
      rw [far, farNat] at ordered
      omega
    obtain ⟨c, member, -, epoch⟩ := rp.departure_charge_of_assigned i _ w oldFound found unset
      wAssigned
    have late : (getCurrentEpoch split).toNat + 1 + preset.MAX_SEED_LOOKAHEAD.toNat ≤ c.epoch :=
      DirectSafety.Run.departureCharges_epoch_ge_start rp (Nat.le_trans (by decide) h.fulu)
        h.early c member
    omega
  intro c member
  exact tailC.departure_charge_ne_of_assigned i _ oldFound assigned c member

/-- A deep key of R's registry that activates after R's next epoch is late or pending.

It is deep when the seed lookahead past the finalized epoch is before R's next epoch.

Without an activation epoch it is pending, if it is not yet eligible, and otherwise late.

With one, its eligibility is by the finalized epoch, which the seed lookahead precedes. -/
private theorem late_or_pending (h : Setting config checks g split fin pulled anc counted V)
    {i : ℕ} {w : Validator} (found : pulled.validators.data[i]? = some w)
    (deep : anc.finalizedCheckpoint.epoch.toNat + preset.MAX_SEED_LOOKAHEAD.toNat <
      (getCurrentEpoch pulled).toNat + 1)
    (after : (getCurrentEpoch pulled).toNat + 1 < w.activationEpoch.toNat) :
    (pinTerms config pulled anc fin).lateB i = true ∨
      (pinTerms config pulled anc fin).pendingRB i = true := by
  obtain ⟨rf⟩ := h.toFin
  obtain ⟨rs⟩ := h.fromFin
  obtain ⟨rp⟩ := h.toPulled
  have farNat : FAR_FUTURE_EPOCH.toNat = 2 ^ 64 - 1 := rfl
  have below := getCurrentEpoch_succ_lt_farFuture h.twoSlots pulled
  by_cases far : w.activationEpoch = FAR_FUTURE_EPOCH
  · by_cases elig : (getCurrentEpoch pulled).toNat < w.activationEligibilityEpoch.toNat
    · exact .inr ((pendingRB_iff config pulled anc fin i).mpr ⟨w, found, elig, far⟩)
    · refine .inl ((lateB_iff config pulled anc fin i).mpr ⟨w, found, by omega, ?_⟩)
      rw [far, farNat]
      omega
  · have eligible := Run.eligibility_le_finalized ((rf.append rs).append rp) h.genesis i w found far
    have eligNat : w.activationEligibilityEpoch.toNat ≤ pulled.finalizedCheckpoint.epoch.toNat :=
      UInt64.le_iff_toNat_le.mp eligible
    have finCur := UInt64.le_iff_toNat_le.mp (finalized_le_current h)
    exact .inl ((lateB_iff config pulled anc fin i).mpr ⟨w, found, by omega, by omega⟩)

/-- A key counted in C and inactive at R, read at R's record, is in one of five classes.

It joins at R's next epoch.

Or it activates late, has exited at R, is exiting at R, or is not yet eligible at R. -/
private theorem K6_class {g : ForkedBeaconState preset}
    {split fin pulled anc counted : BeaconState preset fork} {V : Finset ValidatorIndex}
    (h : Setting config checks g split fin pulled anc counted V) {v : ValidatorIndex}
    (member : v ∈ K6 pulled counted) {w : Validator}
    (found : pulled.validators.data[v.toNat]? = some w) :
    (isActiveAt pulled (getCurrentEpoch pulled) v.toNat = false ∧
        isActiveAt pulled (getCurrentEpoch pulled + 1) v.toNat = true) ∨
      (pinTerms config pulled anc fin).lateB v.toNat = true ∨
      (pinTerms config pulled anc fin).exitedRB v.toNat = true ∨
      (pinTerms config pulled anc fin).exitingB v.toNat = true ∨
      (pinTerms config pulled anc fin).pendingRB v.toNat = true := by
  classical
  obtain ⟨memberAC, memberQ, notAR⟩ := Finset.mem_filter.mp member
  obtain ⟨rf⟩ := h.toFin
  obtain ⟨rs⟩ := h.fromFin
  obtain ⟨rp⟩ := h.toPulled
  obtain ⟨rc⟩ := h.toCounted
  have chain := (rf.append rs).append rp
  -- Epochs, as natural numbers.
  obtain ⟨finSplit, called, later, near, below, farNat, succNat, finCur⟩ := setting_epochs h
  -- The records of the key at R and at C, and the activity they give.
  obtain ⟨u, foundU, activeU⟩ := active_of_activeVoters h.early memberAC
  simp only [isActiveValidator, Bool.and_eq_true, decide_eq_true_eq] at activeU
  have uAct := UInt64.le_iff_toNat_le.mp activeU.1
  have uExit := UInt64.lt_iff_toNat_lt.mp activeU.2
  have uUnslashed : u.slashed = false := by
    have := (Finset.mem_filter.mp memberQ).2
    simpa [foundU] using this
  have rActive : ∀ e : Epoch, isActiveAt pulled e v.toNat = true ↔
      (w.activationEpoch.toNat ≤ e.toNat ∧ e.toNat < w.exitEpoch.toNat) := by
    intro e
    simp [isActiveAt, found, isActiveValidator, UInt64.le_iff_toNat_le, UInt64.lt_iff_toNat_lt]
  have cActive : ∀ e : Epoch, isActiveAt counted e v.toNat = true ↔
      (u.activationEpoch.toNat ≤ e.toNat ∧ e.toNat < u.exitEpoch.toNat) := by
    intro e
    simp [isActiveAt, foundU, isActiveValidator, UInt64.le_iff_toNat_le, UInt64.lt_iff_toNat_lt]
  have notActive : ¬ (w.activationEpoch.toNat ≤ (getCurrentEpoch pulled).toNat ∧
      (getCurrentEpoch pulled).toNat < w.exitEpoch.toNat) := by
    intro both
    apply notAR
    simpa [AR, activeVoters] using
      mem_getActiveValidatorIndices_of_isActiveAt ((rActive _).mpr both)
  -- The key joins at R's next epoch.
  have joins : w.activationEpoch.toNat = (getCurrentEpoch pulled).toNat + 1 →
      (w.exitEpoch = FAR_FUTURE_EPOCH ∨
        w.activationEpoch.toNat + 1 + preset.MAX_SEED_LOOKAHEAD.toNat ≤ w.exitEpoch.toNat) →
      isActiveAt pulled (getCurrentEpoch pulled) v.toNat = false ∧
        isActiveAt pulled (getCurrentEpoch pulled + 1) v.toNat = true := by
    intro first gap
    refine ⟨Bool.eq_false_iff.mpr fun active => ?_, (rActive _).mpr ⟨by omega, ?_⟩⟩
    · have := (rActive _).mp active
      omega
    · rcases gap with far | gap
      · rw [succNat, far, farNat]
        omega
      · rw [succNat]
        omega
  by_cases hA : (getCurrentEpoch pulled).toNat < w.activationEpoch.toNat
  · -- Not activated at R's epoch.
    by_cases window : (getCurrentEpoch counted).toNat ≤
        (getCurrentEpoch split).toNat + preset.MAX_SEED_LOOKAHEAD.toNat
    · -- The key's activity at C's epoch is shared, so R activates it by then.
      have shared := activity_shared h (e := getCurrentEpoch counted) window v.toNat
      have activeAtC : isActiveAt counted (getCurrentEpoch counted) v.toNat = true :=
        (cActive _).mpr ⟨uAct, uExit⟩
      have atR := (rActive _).mp (shared.trans activeAtC)
      left
      refine joins (by omega) ?_
      by_cases far : w.exitEpoch = FAR_FUTURE_EPOCH
      · exact .inl far
      · exact .inr (Run.exit_activation_gap chain h.genesis v.toNat w found far)
    · -- Beyond the shared window, the finalized epoch is before R's epoch.
      by_cases first : w.activationEpoch.toNat = (getCurrentEpoch pulled).toNat + 1
      · left
        refine joins first ?_
        by_cases farExit : w.exitEpoch = FAR_FUTURE_EPOCH
        · exact .inl farExit
        · exact .inr (Run.exit_activation_gap chain h.genesis v.toNat w found farExit)
      · rcases late_or_pending h found (by omega) (by omega) with late | pending
        · exact .inr (.inl late)
        · exact .inr (.inr (.inr (.inr pending)))
  · -- Exited at R's epoch or before.
    have exited : w.exitEpoch.toNat ≤ (getCurrentEpoch pulled).toNat := by omega
    have exitNear : w.exitEpoch ≠ FAR_FUTURE_EPOCH := by
      intro far
      rw [far, farNat] at exited
      omega
    have gap := Run.exit_activation_gap chain h.genesis v.toNat w found exitNear
    have afterFin : anc.finalizedCheckpoint.epoch.toNat + 1 +
        preset.MAX_SEED_LOOKAHEAD.toNat ≤ w.exitEpoch.toNat := by
      rcases K6_exit_late h found rActive cActive uExit notActive with far | late
      · exact absurd far exitNear
      · omega
    by_cases settled : w.exitEpoch.toNat + 1 ≤ (getCurrentEpoch pulled).toNat
    · exact .inr (.inr (.inl ((exitedRB_iff config pulled anc fin v.toNat).mpr
        ⟨w, found, afterFin, settled⟩)))
    · -- The exit is at R's epoch.
      refine .inr (.inr (.inr (.inl ((exitingB_iff config pulled anc fin v.toNat).mpr
        ⟨w, found, .inl ((rActive _).mpr ⟨?_, ?_⟩), ?_, by omega⟩))))
      · rw [getPreviousEpoch_toNat]
        omega
      · rw [getPreviousEpoch_toNat]
        omega
      · by_cases unslashed : w.slashed = false
        · exact .inl unslashed
        · right
          have slashed : w.slashed = true := by simpa using unslashed
          have delayed := slashed_waits (rf.append rs) h.genesis rp rc h.early h.caps h.delay
            found slashed (by simp [foundU, uUnslashed])
          omega

/-- The keys that join at R's next epoch are charged their rise in `joinRise`. -/
private theorem joinRise_eq (config : Config) (pulled anc fin : BeaconState preset fork) :
    (pinTerms config pulled anc fin).joinRise =
      ∑ i ∈ (pinTerms config pulled anc fin).positions with
        (isActiveAt pulled (getCurrentEpoch pulled) i = false ∧
          isActiveAt pulled (getCurrentEpoch pulled + 1) i = true),
            (pinTerms config pulled anc fin).rise i := rfl

/-- The window is tight when its depth is at most one more than the seed lookahead. -/
private theorem tight_iff (config : Config) (pulled anc fin : BeaconState preset fork) :
    (pinTerms config pulled anc fin).tight = true ↔
      (getCurrentEpoch pulled).toNat + 2 - anc.finalizedCheckpoint.epoch.toNat ≤
        1 + preset.MAX_SEED_LOOKAHEAD.toNat := by
  simp only [pinTerms, decide_eq_true_eq]

/-- Outside the tight window, `pendingR` is the stake and rise of the pending keys.

It also holds the reward of what the finalized balance exceeds them by. -/
private theorem pendingR_eq (config : Config) (pulled anc fin : BeaconState preset fork) :
    (pinTerms config pulled anc fin).pendingR =
      if (pinTerms config pulled anc fin).tight = true then 0 else
        ∑ i ∈ (pinTerms config pulled anc fin).positions with
          (pinTerms config pulled anc fin).pendingRB i = true,
          (balanceAt pulled i + (pinTerms config pulled anc fin).rise i +
            3 * ((balanceAt fin i - balanceAt pulled i - (pinTerms config pulled anc fin).rise i +
              ((parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat - 1)) /
              (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat)) := rfl

/-- The keys that `exitingB` marks have their effective balances in `exiting`. -/
private theorem sum_le_exiting (config : Config)
    (state ancestor finalizedState : BeaconState preset fork) (S : Finset ValidatorIndex)
    (member : ∀ v ∈ S, (pinTerms config state ancestor finalizedState).exitingB v.toNat = true) :
    ∑ v ∈ S, balanceAt state v.toNat ≤ (pinTerms config state ancestor finalizedState).exiting := by
  dsimp only [pinTerms]
  refine voters_sum_le (fun i => balanceAt state i) fun v hv => ?_
  have mark := of_decide_eq_true (member v hv)
  obtain ⟨w, found⟩ := validator_of_flag (state := state) (Or.inr mark.2.2)
  exact mem_positions_filter config state ancestor finalizedState found (member v hv)

/-- `exitingBands` is two bands for each key that `exitingB` marks and for each queue key. -/
private theorem exitingBands_eq (config : Config)
    (state ancestor finalizedState : BeaconState preset fork) :
    (pinTerms config state ancestor finalizedState).exitingBands =
      2 * ((((pinTerms config state ancestor finalizedState).positions.filter fun i =>
        (pinTerms config state ancestor finalizedState).exitingB i = true).card +
        (pinTerms config state ancestor finalizedState).queueKeys)) * preset.upwardBand := by
  dsimp only [pinTerms]
  simp only [decide_eq_true_eq]

/-- At most as many keys as the positions that `exitingB` marks are marked. -/
private theorem card_exitingB_le (config : Config)
    (state ancestor finalizedState : BeaconState preset fork) (S : Finset ValidatorIndex)
    (member : ∀ v ∈ S, (pinTerms config state ancestor finalizedState).exitingB v.toNat = true) :
    S.card ≤ ((pinTerms config state ancestor finalizedState).positions.filter fun i =>
      (pinTerms config state ancestor finalizedState).exitingB i = true).card := by
  refine Finset.card_le_card_of_injOn (fun v : ValidatorIndex => v.toNat) (fun v hv => ?_)
    (fun a _ b _ same => UInt64.toNat_inj.mp same)
  have mark := of_decide_eq_true (member v hv)
  obtain ⟨w, found⟩ := validator_of_flag (state := state) (Or.inr mark.2.2)
  exact mem_positions_filter config state ancestor finalizedState found
    (p := fun i => (pinTerms config state ancestor finalizedState).exitingB i = true) (member v hv)

/-- The two further bands of the keys of `K5` are at most `exitingBands`, given their charges. -/
private theorem two_bands_le_exitingBands (config : Config)
    (pulled anc fin counted : BeaconState preset fork) (V : Finset ValidatorIndex)
    {x : ForkedBeaconState preset} (tailC : Run config checks x ⟨fork, counted⟩) (highC : ℕ)
    (charged : ∀ v ∈ K5 counted V, (pinTerms config pulled anc fin).exitingB v.toNat = false →
      0 < bandC tailC highC v.toNat → ∃ c ∈ tailC.departureCharges, c.index = v.toNat)
    (count : ((K5 counted V).filter fun v => ∃ c ∈ tailC.departureCharges,
      c.index = v.toNat).card ≤ (pinTerms config pulled anc fin).queueKeys) :
    2 * (∑ v ∈ K5 counted V, bandC tailC highC v.toNat) ≤
      (pinTerms config pulled anc fin).exitingBands := by
  have bounded (v : ℕ) : bandC tailC highC v ≤ preset.upwardBand := by
    unfold bandC
    split <;> omega
  rw [exitingBands_eq]
  set A := (K5 counted V).filter fun v => (pinTerms config pulled anc fin).exitingB v.toNat = true
  set B := (K5 counted V).filter fun v => (pinTerms config pulled anc fin).exitingB v.toNat = false
  have parts : ∑ v ∈ K5 counted V, bandC tailC highC v.toNat =
      ∑ v ∈ A, bandC tailC highC v.toNat + ∑ v ∈ B, bandC tailC highC v.toNat := by
    rw [← Finset.sum_filter_add_sum_filter_not (K5 counted V)
      (fun v => (pinTerms config pulled anc fin).exitingB v.toNat = true)]
    simp [A, B]
  have first : ∑ v ∈ A, bandC tailC highC v.toNat ≤ A.card * preset.upwardBand := by
    rw [← smul_eq_mul, ← Finset.sum_const]
    exact Finset.sum_le_sum fun v _ => bounded _
  have second : ∑ v ∈ B, bandC tailC highC v.toNat ≤
      (B.filter fun v => ∃ c ∈ tailC.departureCharges, c.index = v.toNat).card *
        preset.upwardBand := by
    have pointwise : ∀ v ∈ B, bandC tailC highC v.toNat ≤
        (if ∃ c ∈ tailC.departureCharges, c.index = v.toNat then preset.upwardBand else 0) := by
      intro v hv
      by_cases hc : ∃ c ∈ tailC.departureCharges, c.index = v.toNat
      · simp only [hc, ↓reduceIte]
        exact bounded _
      · simp only [hc, ↓reduceIte]
        have notBand : ¬ 0 < bandC tailC highC v.toNat := fun pos =>
          hc (charged v (Finset.mem_filter.mp hv).1 (Finset.mem_filter.mp hv).2 pos)
        omega
    calc ∑ v ∈ B, bandC tailC highC v.toNat
        ≤ ∑ v ∈ B, (if ∃ c ∈ tailC.departureCharges, c.index = v.toNat
          then preset.upwardBand else 0) := Finset.sum_le_sum pointwise
      _ = (B.filter fun v => ∃ c ∈ tailC.departureCharges, c.index = v.toNat).card *
          preset.upwardBand := by
        rw [← Finset.sum_filter, Finset.sum_const, smul_eq_mul]
  have inA := card_exitingB_le config pulled anc fin A fun v hv => (Finset.mem_filter.mp hv).2
  have times := Nat.mul_le_mul_right preset.upwardBand inA
  have countB : (B.filter fun v => ∃ c ∈ tailC.departureCharges, c.index = v.toNat).card ≤
      (pinTerms config pulled anc fin).queueKeys :=
    (Finset.card_le_card fun v hv => Finset.mem_filter.mpr
      ⟨(Finset.mem_filter.mp (Finset.mem_filter.mp hv).1).1, (Finset.mem_filter.mp hv).2⟩).trans
        count
  have timesB := Nat.mul_le_mul_right preset.upwardBand countB
  rw [parts]
  nlinarith

/-- A key whose exit C assigned by C's epoch and that R does not read as exiting has a charge.

The key is active at R's epoch or the one before it, if R's record has the exit of C's.

The charge is on C's run, if the exit is not inherited from the split. -/
private theorem exit_charged (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) {v : ValidatorIndex}
    {u : Validator} (foundU : counted.validators.data[v.toNat]? = some u)
    (assignedC : u.exitEpoch ≠ FAR_FUTURE_EPOCH)
    (exited : u.exitEpoch.toNat ≤ (getCurrentEpoch counted).toNat)
    (unslashedC : u.slashed = false)
    (atR : ∀ w, pulled.validators.data[v.toNat]? = some w → w.exitEpoch = u.exitEpoch →
      isActiveAt pulled (getPreviousEpoch pulled) v.toNat = true ∨
        isActiveAt pulled (getCurrentEpoch pulled) v.toNat = true)
    (flag : (pinTerms config pulled anc fin).exitingB v.toNat = false) :
    ∃ c ∈ tailC.departureCharges, c.index = v.toNat := by
  obtain ⟨toPulled⟩ := h.toPulled
  obtain ⟨shared⟩ := h.toFin
  obtain ⟨fromFin⟩ := h.fromFin
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  by_cases inherited : ∃ old, split.validators.data[v.toNat]? = some old ∧
      old.exitEpoch ≠ FAR_FUTURE_EPOCH
  · exfalso
    obtain ⟨old, oldFound, oldAssigned⟩ := inherited
    obtain ⟨uC, foundUC, keptC⟩ := tailC.registryLifecycle.validators v.toNat old oldFound
    have sameU : uC = u := Option.some.inj (foundUC.symm.trans foundU)
    rw [sameU] at keptC
    obtain ⟨w, foundW, keptP⟩ := toPulled.registryLifecycle.validators v.toNat old oldFound
    have exitU : u.exitEpoch = old.exitEpoch := keptC.exitEpoch oldAssigned
    have exitW : w.exitEpoch = old.exitEpoch := keptP.exitEpoch oldAssigned
    have exitWU : w.exitEpoch = u.exitEpoch := exitW.trans exitU.symm
    have exitWNat : w.exitEpoch.toNat ≤ (getCurrentEpoch counted).toNat := by
      rw [exitWU]
      exact exited
    have nearNat := h.near
    have activeR := atR w foundW exitWU
    have notSlashed : w.slashed = false ∨ anc.finalizedCheckpoint.epoch.toNat +
        preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat ≤ w.withdrawableEpoch.toNat := by
      cases slashed : w.slashed
      · exact .inl rfl
      · have delayed := slashed_waits (shared.append fromFin) h.genesis toPulled tailC h.early
          h.caps h.delay foundW slashed (by simp [foundU, unslashedC])
        have := UInt64.le_iff_toNat_le.mp h.finalized
        exact .inr (Nat.le_trans (Nat.add_le_add_right this _) delayed)
    have marked : (pinTerms config pulled anc fin).exitingB v.toNat = true := by
      simp only [pinTerms, decide_eq_true_eq]
      refine ⟨?_, ?_, ?_⟩
      · rcases activeR with active | active <;> simp [active]
      · simpa [foundW] using notSlashed
      · simpa [foundW] using
          (show w.exitEpoch.toNat ≤ (getCurrentEpoch pulled).toNat + 1 by omega)
    rw [flag] at marked
    exact Bool.false_ne_true marked
  · obtain ⟨c, member, index, -⟩ := PinKeys.Run.charge_of_exit tailC electra h.early v.toNat
      (fun w hw => by
        by_contra far
        exact inherited ⟨w, hw, far⟩) u foundU assignedC
    exact ⟨c, member, index⟩

/-- A key of `K5` is unslashed in C's state. -/
private theorem K5_unslashed {v : ValidatorIndex} (member : v ∈ K5 counted V) :
    ∀ w, counted.validators.data[v.toNat]? = some w → w.slashed = false := by
  intro w found
  have inK5 := Finset.mem_filter.mp member
  simp only [Q, quorumVoters, Finset.mem_filter, List.mem_toFinset, List.mem_append] at inK5
  obtain ⟨⟨-, flag⟩, -, -⟩ := inK5
  simpa [slashedFlagAt, found] using flag

/-- A key of `K5` is a validator of C's registry that was active before C's epoch and is not now.

It is unslashed. -/
private theorem K5_previous_only (h : Setting config checks g split fin pulled anc counted V)
    {v : ValidatorIndex} (member : v ∈ K5 counted V) :
    ∃ u, counted.validators.data[v.toNat]? = some u ∧
      isActiveValidator u (getPreviousEpoch counted) = true ∧
      isActiveValidator u (getCurrentEpoch counted) = false := by
  have within := BeaconState.registryWithinLimit_of_lt h.early counted
  have inK5 := Finset.mem_filter.mp member
  simp only [Q, quorumVoters, Finset.mem_filter, List.mem_toFinset, List.mem_append] at inK5
  obtain ⟨⟨listed, -⟩, notActive, -⟩ := inK5
  have notCurrent : v ∉ getActiveValidatorIndices counted (getCurrentEpoch counted) := fun now =>
    notActive (by simpa [AC, activeVoters] using now)
  rcases listed with now | before
  · exact absurd now notCurrent
  obtain ⟨u, foundU, activeBefore⟩ := (mem_getActiveValidatorIndices within).mp before
  refine ⟨u, foundU, activeBefore, ?_⟩
  cases now : isActiveValidator u (getCurrentEpoch counted)
  · rfl
  · exact absurd ((mem_getActiveValidatorIndices within).mpr ⟨u, foundU, now⟩) notCurrent

/-- A key of `K5` that R does not read as exiting has a departure charge on C's run. -/
private theorem K5_charged (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) {v : ValidatorIndex}
    (member : v ∈ K5 counted V) (flag : (pinTerms config pulled anc fin).exitingB v.toNat = false) :
    ∃ c ∈ tailC.departureCharges, c.index = v.toNat := by
  obtain ⟨toPulled⟩ := h.toPulled
  obtain ⟨shared⟩ := h.toFin
  obtain ⟨fromFin⟩ := h.fromFin
  obtain ⟨u, foundU, activeBefore, notNow⟩ := K5_previous_only h member
  have unslashedC := K5_unslashed member u foundU
  have exitC := (previous_only_iff_exit counted u).mp ⟨activeBefore, notNow⟩
  have notFar := getCurrentEpoch_ne_farFuture h.twoSlots counted
  have assignedC : u.exitEpoch ≠ FAR_FUTURE_EPOCH := fun far =>
    notFar (UInt64.toNat_inj.mp (by rw [← exitC.2, far]))
  refine exit_charged h tailC foundU assignedC (Nat.le_of_eq exitC.2) unslashedC
    (fun w foundW sameExit => ?_) flag
  have gap := ((shared.append fromFin).append toPulled).exit_activation_gap h.genesis v.toNat w
    foundW (sameExit ▸ assignedC)
  have exitW : w.exitEpoch.toNat = (getCurrentEpoch counted).toNat := by
    rw [sameExit]
    exact exitC.2
  have actLt : w.activationEpoch.toNat < (getCurrentEpoch counted).toNat := by omega
  have laterNat := UInt64.le_iff_toNat_le.mp h.later
  have nearNat := h.near
  have previous := getPreviousEpoch_toNat pulled
  have activeAt (e : Epoch) (low : w.activationEpoch.toNat ≤ e.toNat)
      (high : e.toNat < w.exitEpoch.toNat) : isActiveAt pulled e v.toNat = true :=
    isActiveAt_eq_true_iff.mpr ⟨w, foundW, by
      simp only [isActiveValidator, Bool.and_eq_true, decide_eq_true_eq,
        UInt64.le_iff_toNat_le, UInt64.lt_iff_toNat_lt]
      exact ⟨low, high⟩⟩
  rcases Nat.lt_or_ge (getCurrentEpoch pulled).toNat (getCurrentEpoch counted).toNat with
    before | same
  · exact .inr (activeAt _ (by omega) (by omega))
  · exact .inl (activeAt _ (by omega) (by omega))

/-- A key of `K5` without a departure charge on C's run is one whose exit R reads.

It is the contrapositive of `K5_charged`. -/
private theorem K5_exiting_of_not_charged
    (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) {v : ValidatorIndex}
    (member : v ∈ K5 counted V) (none : ¬ ∃ c ∈ tailC.departureCharges, c.index = v.toNat) :
    (pinTerms config pulled anc fin).exitingB v.toNat = true := by
  by_contra flag
  exact none (K5_charged h tailC member (by simpa using flag))

/-- The stake of the keys whose exit R reads, against `exiting`.

The keys of `K5` are those without a departure charge on C's run. -/
private theorem bud_exiting (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) :
    (∑ v ∈ (VN counted V) with (pinTerms config pulled anc fin).exitingB v.toNat = true,
      eR pulled v) +
      (∑ v ∈ (K5 counted V) with ¬ ∃ c ∈ tailC.departureCharges, c.index = v.toNat,
        eR pulled v) +
      (∑ v ∈ (K6 pulled counted) with (pinTerms config pulled anc fin).exitingB v.toNat = true,
        eR pulled v) ≤ (pinTerms config pulled anc fin).exiting := by
  have apartVK5 : Disjoint (VN counted V) (K5 counted V) := by
    rw [Finset.disjoint_left]
    intro v inV inK5
    simp only [VN, K5, Finset.mem_filter] at inV inK5
    exact inK5.2.2 inV.1
  have apartVK6 : Disjoint (VN counted V) (K6 pulled counted) := by
    rw [Finset.disjoint_left]
    intro v inV inK6
    simp only [VN, K6, Finset.mem_filter] at inV inK6
    exact inV.2 inK6.1
  have apartK5K6 : Disjoint (K5 counted V) (K6 pulled counted) := by
    rw [Finset.disjoint_left]
    intro v inK5 inK6
    simp only [K5, K6, Finset.mem_filter] at inK5 inK6
    exact inK5.2.1 inK6.1
  rw [← Finset.sum_union (Finset.disjoint_filter_filter apartVK5),
    ← Finset.sum_union (Finset.disjoint_union_left.mpr
      ⟨Finset.disjoint_filter_filter apartVK6, Finset.disjoint_filter_filter apartK5K6⟩)]
  exact sum_le_exiting config pulled anc fin _ fun v member => by
    rcases Finset.mem_union.mp member with member | member
    · rcases Finset.mem_union.mp member with member | member
      · exact (Finset.mem_filter.mp member).2
      · exact K5_exiting_of_not_charged h tailC (Finset.mem_filter.mp member).1
          (Finset.mem_filter.mp member).2
    · exact (Finset.mem_filter.mp member).2

/-- Outside the tight window, `late` is three times the stake of the late keys and their rise.

It also holds the reward of what the finalized balance exceeds them by. -/
private theorem late_eq (config : Config) (pulled anc fin : BeaconState preset fork) :
    (pinTerms config pulled anc fin).late =
      if (pinTerms config pulled anc fin).tight = true then 0 else
        ∑ i ∈ (pinTerms config pulled anc fin).positions with
          (pinTerms config pulled anc fin).lateB i = true,
            (3 * balanceAt pulled i + (pinTerms config pulled anc fin).rise i +
              3 * ((balanceAt fin i - balanceAt pulled i - (pinTerms config pulled anc fin).rise i +
                ((parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat - 1)) /
                (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat)) := rfl

/-- Before Gloas, `queueWindow` is the depth's exit and consolidation churn and the two carries. -/
private theorem queueWindow_unfold (early : fork < .glamsterdam) (config : Config)
    (state ancestor finalizedState : BeaconState preset fork) :
    (pinTerms config state ancestor finalizedState).queueWindow =
      (pinTerms config state ancestor finalizedState).depth *
        (PinTerms.activationExitChurn preset config (PinTerms.wide state) +
          PinTerms.consolidationChurn preset config (PinTerms.wide state)) +
        max preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat
          config.MAX_PER_EPOCH_ACTIVATION_EXIT_CHURN_LIMIT.toNat +
        max (if electra : .pectra ≤ fork then
          (finalizedState.consolidationBalanceToConsume electra).toNat else 0)
          (PinTerms.consolidationChurn preset config (PinTerms.wide state)) := by
  have notGloas : ¬ .glamsterdam ≤ fork := Nat.not_le_of_lt early
  unfold pinTerms
  simp only [notGloas, PinTerms.wide, PinTerms.consolidationChurn, PinTerms.activationExitChurn,
    PinTerms.balanceChurn, ↓reduceIte]

/-- A state with a total of at most `wide` has an exit churn limit of at most the pin's. -/
private theorem exitRate_le {fork' : Fork} {s : BeaconState preset fork'}
    (early : fork' < .glamsterdam) {rate : Gwei} (wide : ℕ)
    (band : ∀ t : Gwei, getTotalActiveBalance s = .ok t → t.toNat ≤ wide)
    (computed : exitChurnLimit config s = .ok rate) :
    rate.toNat ≤ PinTerms.activationExitChurn preset config wide := by
  have notGloas : ¬ .glamsterdam ≤ fork' := Nat.not_le_of_lt early
  obtain ⟨total, read⟩ : ∃ t, getTotalActiveBalance s = .ok t := by
    cases first : getTotalActiveBalance s with
    | error e =>
      simp [exitChurnLimit, notGloas, getActivationExitChurnLimit, getBalanceChurnLimit, first,
        bind, Except.bind] at computed
    | ok t => exact ⟨t, rfl⟩
  have le := band total read
  rw [DirectSafety.Apriori.Internal.exit_rate_toNat early read computed]
  exact min_le_min_left _ (rounded_mono _ (max_le_max_left _
    (Nat.div_le_div_right le)))

/-- A state with a total of at most `wide` has a consolidation churn limit of at most the pin's.

The pin reads it at `wide`. -/
private theorem consRate_le {fork' : Fork} {s : BeaconState preset fork'}
    (early : fork' < .glamsterdam) {rate : Gwei} (wide : ℕ)
    (band : ∀ t : Gwei, getTotalActiveBalance s = .ok t → t.toNat ≤ wide)
    (computed : getConsolidationChurnLimit config s = .ok rate) :
    rate.toNat ≤ PinTerms.consolidationChurn preset config wide := by
  have notGloas : ¬ .glamsterdam ≤ fork' := Nat.not_le_of_lt early
  obtain ⟨total, read⟩ : ∃ t, getTotalActiveBalance s = .ok t := by
    cases first : getTotalActiveBalance s with
    | error e =>
      simp [getConsolidationChurnLimit, notGloas, getBalanceChurnLimit, first, bind,
        Except.bind] at computed
    | ok t => exact ⟨t, rfl⟩
  have le := band total read
  have value : rate = roundToIncrement preset (max config.MIN_PER_EPOCH_CHURN_LIMIT_ELECTRA
        (total / config.CHURN_LIMIT_QUOTIENT)) -
      min config.MAX_PER_EPOCH_ACTIVATION_EXIT_CHURN_LIMIT
        (roundToIncrement preset (max config.MIN_PER_EPOCH_CHURN_LIMIT_ELECTRA
          (total / config.CHURN_LIMIT_QUOTIENT))) := by
    simpa [getConsolidationChurnLimit, notGloas, getActivationExitChurnLimit,
      getBalanceChurnLimit, read, bind, Except.bind, pure, Except.pure] using computed.symm
  have fits : min config.MAX_PER_EPOCH_ACTIVATION_EXIT_CHURN_LIMIT
      (roundToIncrement preset (max config.MIN_PER_EPOCH_CHURN_LIMIT_ELECTRA
        (total / config.CHURN_LIMIT_QUOTIENT))) ≤
      roundToIncrement preset (max config.MIN_PER_EPOCH_CHURN_LIMIT_ELECTRA
        (total / config.CHURN_LIMIT_QUOTIENT)) :=
    UInt64.le_iff_toNat_le.mpr (by rw [Uint64.toNat_min]; exact Nat.min_le_right _ _)
  rw [value, UInt64.toNat_sub_of_le _ _ fits, Uint64.toNat_min, toNat_roundToIncrement,
    Uint64.toNat_max, UInt64.toNat_div]
  have rounded := rounded_mono preset.EFFECTIVE_BALANCE_INCREMENT.toNat (max_le_max_left
    config.MIN_PER_EPOCH_CHURN_LIMIT_ELECTRA.toNat
    (Nat.div_le_div_right (c := config.CHURN_LIMIT_QUOTIENT.toNat) le))
  unfold PinTerms.consolidationChurn PinTerms.activationExitChurn PinTerms.balanceChurn
  omega

/-- The amount that `exitQ` reads is at most the amounts of the charges at its position.

Those charges are the ones with an epoch up to a later one. -/
private theorem exitQ_amount_le (L : List DepartureCharge) (b₀ b v : ℕ) (le : b₀ ≤ b) :
    ((L.find? fun c => c.index == v && decide (c.epoch ≤ b₀)).map (·.amount)).getD 0 ≤
      ((L.filter fun c => c.epoch ≤ b).map fun c => if c.index = v then c.amount else 0).sum := by
  cases found : L.find? fun c => c.index == v && decide (c.epoch ≤ b₀) with
  | none => simp
  | some c =>
    have member := List.mem_of_find?_eq_some found
    have both := List.find?_some found
    simp only [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at both
    have kept : c ∈ L.filter fun c => c.epoch ≤ b :=
      List.mem_filter.mpr ⟨member, by simpa using both.2.trans le⟩
    have term : c.amount ∈ (L.filter fun c => c.epoch ≤ b).map
        fun c => if c.index = v then c.amount else 0 :=
      List.mem_map.mpr ⟨c, kept, by simp [both.1]⟩
    simpa using List.single_le_sum (fun _ _ => Nat.zero_le _) _ term

/-- The `exitQ` of a set of keys is at most the amounts of the charges of the run.

Those charges are the ones with an epoch up to one that the run's end does not pass. -/
private theorem sum_exitQ_le {x y : ForkedBeaconState preset} (tail : Run config checks x y)
    (b : ℕ) (le : (getCurrentEpoch y.state).toNat ≤ b) (S : Finset ValidatorIndex) :
    ∑ v ∈ S, exitQ tail v.toNat ≤
      ((tail.departureCharges.filter fun c => c.epoch ≤ b).map (·.amount)).sum := by
  classical
  have each : ∀ v ∈ S, exitQ tail v.toNat ≤
      ((tail.departureCharges.filter fun c => c.epoch ≤ b).map
        fun c => if c.index = v.toNat then c.amount else 0).sum :=
    fun v _ => exitQ_amount_le _ _ b v.toNat le
  refine (Finset.sum_le_sum each).trans ?_
  refine (voters_sum_le (voters := S)
    (positions := S.image fun v : ValidatorIndex => v.toNat)
    (fun n => ((tail.departureCharges.filter fun c => c.epoch ≤ b).map
      fun c => if c.index = n then c.amount else 0).sum)
    fun v member => Finset.mem_image_of_mem _ member).trans ?_
  have swap := Multiset.sum_map_sum
    (m := (tail.departureCharges.filter fun c => c.epoch ≤ b : List DepartureCharge))
    (s := S.image fun v : ValidatorIndex => v.toNat)
    (f := fun (c : DepartureCharge) (n : ℕ) => if c.index = n then c.amount else 0)
  simp only [Multiset.map_coe, Multiset.sum_coe, Finset.sum_ite_eq] at swap
  rw [← swap]
  exact List.sum_le_sum fun c _ => by split <;> simp

/-- The departure charges of C's branch fit the window's churn and carries.

They are the charges with an epoch up to the run's last epoch.

The bound is the churn of the window and the two carries. -/
private theorem charges_le_queueWindow (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) :
    ((tailC.departureCharges.filter fun c =>
      c.epoch ≤ (getCurrentEpoch counted).toNat - 1 + 1).map (·.amount)).sum ≤
        (pinTerms config pulled anc fin).queueWindow := by
  classical
  obtain ⟨shared⟩ := h.toFin
  obtain ⟨fromFin⟩ := h.fromFin
  obtain ⟨_, pulledOk⟩ := h.pulledTotal
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  obtain ⟨finalized, called, later, near, -⟩ := setting_epochs h
  -- the exit and consolidation churn of every state on the runs from the finalized state
  have band : ∀ (u : ForkedBeaconState preset) (run : Run config checks ⟨fork, fin⟩ u),
      u.fork < .glamsterdam →
      (getCurrentEpoch u.state).toNat ≤ (getCurrentEpoch pulled).toNat + 1 →
      ∀ t : Gwei, getTotalActiveBalance u.state = .ok t → t.toNat ≤ PinTerms.wide pulled := by
    intro u run uEarly uWithin t read
    have := (total_band_of_setting h run uEarly uWithin read pulledOk).2
    simp only [PinTerms.wide, pulledOk, Except.toOption, Option.getD_some]
    omega
  have exitBound : ∀ {u w : ForkedBeaconState preset} (step : Step config checks u w),
      tailC.Contains step → ∀ rate : Gwei, exitChurnLimit config u.state = .ok rate →
        rate.toNat ≤ PinTerms.activationExitChurn preset config (PinTerms.wide pulled) := by
    intro u w step member rate computed
    obtain ⟨pre, post, _, uEarly, uEpoch⟩ :=
      DirectSafety.Apriori.Internal.Run.contains_step_facts member h.early
    have uEpoch' : (getCurrentEpoch u.state).toNat ≤ (getCurrentEpoch counted).toNat := uEpoch
    exact exitRate_le uEarly _ (band u (fromFin.append pre) uEarly (by omega)) computed
  have consTail : ∀ site ∈ tailC.consolidationSites, ∀ (_h : .pectra ≤ site.fork) (rate : Gwei),
      getConsolidationChurnLimit config site.state = .ok rate →
        rate.toNat ≤ PinTerms.consolidationChurn preset config (PinTerms.wide pulled) := by
    intro site member _ rate computed
    obtain ⟨u, w, step, contained, _, same⟩ := consolidationSite_rate tailC h.early site member
    obtain ⟨pre, post, _, uEarly, uEpoch⟩ :=
      DirectSafety.Apriori.Internal.Run.contains_step_facts contained h.early
    have uEpoch' : (getCurrentEpoch u.state).toNat ≤ (getCurrentEpoch counted).toNat := uEpoch
    exact consRate_le uEarly _ (band u (fromFin.append pre) uEarly (by omega))
      (same rate computed)
  have consFin : ∀ site ∈ fromFin.consolidationSites, ∀ (_h : .pectra ≤ site.fork) (rate : Gwei),
      getConsolidationChurnLimit config site.state = .ok rate →
        rate.toNat ≤ PinTerms.consolidationChurn preset config (PinTerms.wide pulled) := by
    intro site member _ rate computed
    obtain ⟨u, w, step, contained, _, same⟩ := consolidationSite_rate fromFin h.early site member
    obtain ⟨pre, post, _, uEarly, uEpoch⟩ :=
      DirectSafety.Apriori.Internal.Run.contains_step_facts contained h.early
    have uEpoch' : (getCurrentEpoch u.state).toNat ≤ (getCurrentEpoch split).toNat := uEpoch
    exact consRate_le uEarly _ (band u pre uEarly (by omega)) (same rate computed)
  obtain ⟨exitCarry, consolidationCarry⟩ :
      (split.exitBalanceToConsume electra).toNat ≤
        config.MAX_PER_EPOCH_ACTIVATION_EXIT_CHURN_LIMIT.toNat ∧
      (split.consolidationBalanceToConsume electra).toNat ≤
        max (fin.consolidationBalanceToConsume electra).toNat
          (PinTerms.consolidationChurn preset config (PinTerms.wide pulled)) :=
    queueCarry_le_of_run shared h.genesis fromFin electra h.early electra _ consFin
  have window := departure_charges_le_window_electra_cap tailC electra h.early
    ((getCurrentEpoch counted).toNat - 1)
    (PinTerms.consolidationChurn preset config (PinTerms.wide pulled))
    (PinTerms.activationExitChurn preset config (PinTerms.wide pulled)) exitBound consTail
  dsimp only at window
  have depthEq : (pinTerms config pulled anc fin).depth =
      (getCurrentEpoch pulled).toNat + 2 - anc.finalizedCheckpoint.epoch.toNat := rfl
  rw [queueWindow_unfold h.early]
  simp only [electra, ↓reduceDIte]
  generalize (pinTerms config pulled anc fin).depth = depth at depthEq ⊢
  generalize PinTerms.activationExitChurn preset config (PinTerms.wide pulled) = E at *
  generalize PinTerms.consolidationChurn preset config (PinTerms.wide pulled) = C at *
  have firstLe : (getCurrentEpoch counted).toNat - 1 + 2 - max (getCurrentEpoch split).toNat
      (split.earliestExitEpoch electra).toNat ≤ depth := by omega
  have secondLe : (getCurrentEpoch counted).toNat - 1 + 2 - max (getCurrentEpoch split).toNat
      (split.earliestConsolidationEpoch electra).toNat ≤ depth := by omega
  have exitTerm : (if (split.earliestExitEpoch electra).toNat ≤
        (getCurrentEpoch counted).toNat - 1 + 1
      then (split.exitBalanceToConsume electra).toNat else 0) ≤
      max preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat
        config.MAX_PER_EPOCH_ACTIVATION_EXIT_CHURN_LIMIT.toNat := by
    split <;> omega
  have consolidationTerm : (if (split.earliestConsolidationEpoch electra).toNat ≤
        (getCurrentEpoch counted).toNat - 1 + 1
      then (split.consolidationBalanceToConsume electra).toNat else 0) ≤
      max (fin.consolidationBalanceToConsume electra).toNat C := by
    split <;> omega
  have a := Nat.mul_le_mul_right E firstLe
  have b := Nat.mul_le_mul_right C secondLe
  rw [Nat.mul_add depth E C]
  omega

/-- The keys with a charge of at least `exitFloor` are at most the window over `exitFloor`. -/
private theorem card_big_charges_le (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (S : Finset ValidatorIndex) :
    (S.filter fun v => (pinTerms config pulled anc fin).exitFloor ≤ exitQ tailC v.toNat).card ≤
      (pinTerms config pulled anc fin).queueWindow /
        (pinTerms config pulled anc fin).exitFloor := by
  classical
  have positive : 0 < (pinTerms config pulled anc fin).exitFloor := by
    unfold pinTerms
    exact lt_max_of_lt_left Nat.one_pos
  rw [Nat.le_div_iff_mul_le positive]
  have each := Finset.card_nsmul_le_sum
    (S.filter fun v => (pinTerms config pulled anc fin).exitFloor ≤ exitQ tailC v.toNat)
    (fun v => exitQ tailC v.toNat) (pinTerms config pulled anc fin).exitFloor
    fun v member => (Finset.mem_filter.mp member).2
  have subset := Finset.sum_le_sum_of_subset (f := fun v => exitQ tailC v.toNat)
    (Finset.filter_subset (fun v => (pinTerms config pulled anc fin).exitFloor ≤
      exitQ tailC v.toNat) S)
  have kept := sum_exitQ_le tailC ((getCurrentEpoch counted).toNat - 1 + 1)
    (by simp only; omega) S
  have window := charges_le_queueWindow h tailC
  simp only [smul_eq_mul] at each
  omega

/-- The exits and consolidations initiated on C's branch, against `queueExit`.

There are none in the tight window. -/
private theorem bud_queues (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) :
    3 * ((∑ v ∈ (VN counted V), exitQ tailC v.toNat) +
      (∑ v ∈ (K5 counted V) with ∃ c ∈ tailC.departureCharges, c.index = v.toNat,
        exitQ tailC v.toNat)) ≤
      (pinTerms config pulled anc fin).queueExit := by
  classical
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  have early := h.early
  obtain ⟨finalized, -, -, near, -⟩ := setting_epochs h
  -- the two sets are disjoint
  have apart : Disjoint (VN counted V)
      ((K5 counted V).filter fun v => ∃ c ∈ tailC.departureCharges, c.index = v.toNat) := by
    refine Finset.disjoint_left.mpr fun v first second => ?_
    exact (Finset.mem_filter.mp (Finset.mem_filter.mp second).1).2.2
      (Finset.mem_filter.mp first).1
  have queueExit_eq : (pinTerms config pulled anc fin).queueExit =
      if (pinTerms config pulled anc fin).tight = true then 0 else
        3 * (pinTerms config pulled anc fin).queueWindow := rfl
  rw [← Finset.sum_union apart, queueExit_eq]
  by_cases tight : (pinTerms config pulled anc fin).tight = true
  · -- the tight window has no exit of a counting key
    simp only [tight, ↓reduceIte]
    have tightLe : (pinTerms config pulled anc fin).depth ≤ 1 + preset.MAX_SEED_LOOKAHEAD.toNat :=
      of_decide_eq_true tight
    have depthEq : (pinTerms config pulled anc fin).depth =
        (getCurrentEpoch pulled).toNat + 2 - anc.finalizedCheckpoint.epoch.toNat := rfl
    rw [depthEq] at tightLe
    have none : ∀ v : ValidatorIndex, exitQ tailC v.toNat = 0 := by
      intro v
      have missing : (tailC.departureCharges.find? fun c =>
          c.index == v.toNat && decide (c.epoch ≤ (getCurrentEpoch counted).toNat)) = none := by
        rw [List.find?_eq_none]
        intro c member
        have far : (getCurrentEpoch split).toNat + 1 + preset.MAX_SEED_LOOKAHEAD.toNat ≤ c.epoch :=
          DirectSafety.Run.departureCharges_epoch_ge_start tailC electra early c member
        simp only [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq, not_and]
        intro _
        omega
      simp [exitQ, missing]
    simp [none]
  · simp only [tight, Bool.false_eq_true, ↓reduceIte]
    have window := charges_le_queueWindow h tailC
    have kept := sum_exitQ_le tailC ((getCurrentEpoch counted).toNat - 1 + 1)
      (by simp only; omega) ((VN counted V) ∪
        ((K5 counted V).filter fun v => ∃ c ∈ tailC.departureCharges, c.index = v.toNat))
    omega

/-- The deposit credits of a set of keys, as events, fit any per-event bound on them.

An event counts for a key only when `keep` holds there.

The bound reads the credits of the keys that the event keeps. -/
private theorem credDepR_sum_le (V : Finset ValidatorIndex) (events : List (BalanceEvent preset))
    (keep : BalanceEvent preset → ℕ → Prop) [∀ e i, Decidable (keep e i)]
    (T : BalanceEvent preset → ℕ)
    (each : ∀ e ∈ events, e.source = .deposits →
      ∑ v ∈ V.filter fun v => keep e v.toNat, keyCredit v.toNat e ≤ T e) :
    ∑ v ∈ V, ((events.filter fun e => e.source = .deposits ∧ keep e v.toNat).map
      (keyCredit v.toNat)).sum ≤ (events.map T).sum := by
  induction events with
  | nil => simp
  | cons e rest ih =>
    have tail := ih fun e' member => each e' (List.mem_cons_of_mem _ member)
    by_cases dep : e.source = .deposits
    · have head := each e List.mem_cons_self dep
      have split : ∑ v ∈ V, (((e :: rest).filter fun e => e.source = .deposits ∧
            keep e v.toNat).map (keyCredit v.toNat)).sum =
          ∑ v ∈ V.filter (fun v => keep e v.toNat), keyCredit v.toNat e +
            ∑ v ∈ V, ((rest.filter fun e => e.source = .deposits ∧ keep e v.toNat).map
              (keyCredit v.toNat)).sum := by
        rw [Finset.sum_filter, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun v _ => ?_
        by_cases kept : keep e v.toNat <;> simp [dep, kept]
      simp only [List.map_cons, List.sum_cons]
      omega
    · have same : ∑ v ∈ V, (((e :: rest).filter fun e => e.source = .deposits ∧
            keep e v.toNat).map (keyCredit v.toNat)).sum =
          ∑ v ∈ V, ((rest.filter fun e => e.source = .deposits ∧ keep e v.toNat).map
            (keyCredit v.toNat)).sum :=
        Finset.sum_congr rfl fun v _ => by simp [dep]
      simp only [List.map_cons, List.sum_cons]
      omega

/-- `queueDep` is three times the deposit churn of each epoch of the window, and the carry. -/
private theorem queueDep_eq (config : Config)
    (state ancestor finalizedState : BeaconState preset fork) :
    (pinTerms config state ancestor finalizedState).queueDep =
      3 * (((getCurrentEpoch state).toNat + 2 - (getCurrentEpoch finalizedState).toNat) *
          config.MAX_PER_EPOCH_ACTIVATION_EXIT_CHURN_LIMIT.toNat +
        (if electra : .pectra ≤ fork then
          (finalizedState.depositBalanceToConsume electra).toNat else 0)) := rfl

/-- The funding credits of the deposit events of a run from the split fit the deposit churn.

The run ends within one epoch of R's, and its events are read at any horizon that its end allows.

The window is the carry of the finalized block and a churn for each epoch from it. -/
private theorem deposit_events_le (h : Setting config checks g split fin pulled anc counted V)
    {e : BeaconState preset fork} (tail : Run config checks ⟨fork, split⟩ ⟨fork, e⟩)
    (within : (getCurrentEpoch e).toNat ≤ (getCurrentEpoch pulled).toNat + 1) (high : ℕ)
    (endEpoch : (getCurrentEpoch e).toNat ≤ high + 1)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events) :
    3 * (events.map DirectSafety.funding_deposit_credit).sum ≤
      (pinTerms config pulled anc fin).queueDep := by
  obtain ⟨toFin⟩ := h.toFin
  obtain ⟨fromFin⟩ := h.fromFin
  -- Every step of the run starts within the epochs of `pulled`, so `high` can be that epoch.
  have same := DirectSafety.Apriori.Internal.balanceEvents_eq_of_endpoint_le tail endEpoch within
  have tailOk : tail.balanceEvents (getCurrentEpoch pulled).toNat = .ok events := by
    rw [← same]
    exact replayed
  obtain ⟨ef, efOk⟩ := fromFin.balanceEvents_ok h.early (getCurrentEpoch pulled).toNat
  have fullOk := DirectSafety.Apriori.Internal.balanceEvents_append fromFin tail
    (getCurrentEpoch pulled).toNat efOk tailOk
  have capacity := DirectSafety.funding_deposit_capacity toFin (fromFin.append tail) h.genesis
    h.early (getCurrentEpoch pulled).toNat within (ef ++ events) fullOk
  have bound : ((ef ++ events).map DirectSafety.funding_deposit_credit).sum ≤
      (if electra : .pectra ≤ fork then (fin.depositBalanceToConsume electra).toNat else 0) +
        ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) *
          config.MAX_PER_EPOCH_ACTIVATION_EXIT_CHURN_LIMIT.toNat := capacity
  rw [List.map_append, List.sum_append] at bound
  rw [queueDep_eq]
  omega

/-- The deposit queue bound, from the per-event bound of V's deposit credits.

The credits that a deposit event gives to V keys are at most its deposit credit.

That credit leaves out the keys that are withdrawn, which V keys never are.

The deposit credits of the run from the finalized block fit its carry and a churn for each epoch. -/
private theorem bud_deposits_of (h : Setting config checks g split fin pulled anc counted V)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩) (high : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    (each : ∀ e ∈ events, e.source = .deposits →
      ∑ v ∈ V, keyCredit v.toNat e ≤ DirectSafety.funding_deposit_credit e) :
    3 * (∑ v ∈ V, credDepR events v.toNat) ≤ (pinTerms config pulled anc fin).queueDep := by
  have sum : ∑ v ∈ V, credDepR events v.toNat ≤
      (events.map DirectSafety.funding_deposit_credit).sum := by
    simpa [credDepR] using credDepR_sum_le V events (fun _ _ => True)
      DirectSafety.funding_deposit_credit (by simpa using each)
  have capacity := deposit_events_le h tail (Nat.le_succ _) high endEpoch replayed
  omega

/-- A deposit event credits a set of keys at most its funding credit, when none is withdrawable.

Each key of the set that is present before the event must not be withdrawable there.

A key absent before the event has no balance after it either, since its balances match. -/
private theorem deposit_each_le (e : BalanceEvent preset) (S : Finset ValidatorIndex)
    (dep : e.source = .deposits) (electra : .pectra ≤ e.before.fork)
    (matched : BalancesMatch e.after.state)
    (held : ∀ v ∈ S, ∀ w, e.before.state.validators.data[v.toNat]? = some w →
      (getCurrentEpoch e.before.state).toNat < w.withdrawableEpoch.toNat) :
    ∑ v ∈ S, keyCredit v.toNat e ≤ DirectSafety.funding_deposit_credit e := by
  have inj : Set.InjOn (fun v : ValidatorIndex => v.toNat) S := fun a _ b _ same =>
    UInt64.toNat_inj.mp same
  have image := selected_deposit_le (S.image fun v => v.toNat) e matched fun i member => by
    obtain ⟨v, inS, rfl⟩ := Finset.mem_image.mp member
    cases found : e.before.state.validators.data[v.toNat]? with
    | none => rfl
    | some w => simpa using held v inS w found
  rw [Finset.sum_image inj] at image
  simpa [DirectSafety.funding_deposit_credit, dep, electra, keyCredit] using image

/-- The deposits credited to two sets of keys on C's run fit the window's deposit churn.

The first set's credits are read as the scan of the deposit events.

The second set's are the deposits of events whose before-state does not hold the key slashed.

Each deposit event credits both sets together at most its funding credit. -/
private theorem deposits_scan_le (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    (S P : Finset ValidatorIndex)
    (each : ∀ e ∈ eventsC, e.source = .deposits →
      ∑ v ∈ S, keyCredit v.toNat e +
        ∑ v ∈ P.filter (fun v => ¬ slashedFlagAt e.before.state v.toNat = some true),
          keyCredit v.toNat e ≤ DirectSafety.funding_deposit_credit e) :
    3 * (∑ v ∈ S, (creditScan (fun _ => false) (fun s => decide (s = .deposits)) v.toNat highC
      tailC) + ∑ v ∈ P, depPre eventsC v.toNat) ≤ (pinTerms config pulled anc fin).queueDep := by
  obtain ⟨X, hX⟩ : ∃ X : BalanceEvent preset → ℕ, ∀ e, X e =
      ∑ v ∈ P.filter (fun v => ¬ slashedFlagAt e.before.state v.toNat = some true),
        keyCredit v.toNat e := ⟨_, fun _ => rfl⟩
  have scan := creditScan_sum_le S UInt64.toNat (fun _ => false) (fun s => decide (s = .deposits))
    highC (fun e => DirectSafety.funding_deposit_credit e - X e) tailC replayedC
    fun e member selected => by
      have := each e member (by simpa using selected)
      have := hX e
      omega
  have pre := credDepR_sum_le P eventsC (fun e i => ¬ slashedFlagAt e.before.state i = some true)
    (fun e => if e.source = .deposits then X e else 0) fun e _ dep => by simp [dep, hX e]
  have capacity := deposit_events_le h tailC h.near highC endEpochC replayedC
  have chain : (eventsC.map fun e => if (false = true ∨ decide (e.source = .deposits) = true)
        then DirectSafety.funding_deposit_credit e - X e else 0).sum +
      (eventsC.map fun e => if e.source = .deposits then X e else 0).sum ≤
        (eventsC.map DirectSafety.funding_deposit_credit).sum := by
    rw [← List.sum_map_add]
    refine List.sum_le_sum fun e member => ?_
    by_cases dep : e.source = .deposits
    · have := each e member dep
      have := hX e
      simp only [dep, decide_true, or_true, ↓reduceIte]
      omega
    · simp [dep]
  have exchange : ∑ v ∈ P, depPre eventsC v.toNat ≤
      (eventsC.map fun e => if e.source = .deposits then X e else 0).sum := pre
  omega

/-- A key that a step slashes is not yet withdrawable at the first state of that step.

A key that has exited is not withdrawable, since a withdrawable key is not slashed.

A key that has not exited has a withdrawable epoch at or after its exit, which is later. -/
private theorem newly_slashed_unwithdrawable {g m n : ForkedBeaconState preset}
    (genesis : Genesis config checks g) (caps : CapOrder preset) (toM : Run config checks g m)
    (step : Step config checks m n) (early : n.fork < .glamsterdam) {i : ℕ} {old new : Validator}
    (foundOld : m.state.validators.data[i]? = some old)
    (foundNew : n.state.validators.data[i]? = some new)
    (clean : old.slashed = false) (marked : new.slashed = true) :
    (getCurrentEpoch m.state).toNat < old.withdrawableEpoch.toNat := by
  by_cases exited : old.exitEpoch ≤ getCurrentEpoch m.state
  · exact UInt64.lt_iff_toNat_lt.mp
      ((Run.nil.snoc step).newly_slashed_initial_exited_unwithdrawable caps.activation
        caps.compounding early i old new foundOld foundNew clean marked exited)
  · have ordered := UInt64.le_iff_toNat_le.mp
      ((Run.invariant genesis.invariant toM).exitsOrdered old (Array.mem_of_getElem? foundOld))
    have before := UInt64.lt_iff_toNat_lt.mp (UInt64.not_le.mp exited)
    omega

/-- A key slashed at C and not slashed at the start of a deposit event is not withdrawable there.

The key is not slashed at the step's start, and the run from there ends with it slashed.

At the step that slashes it, the key is slashable, so it is not yet withdrawable.

Until then its withdrawable epoch is the one it has at the event's start, or its exit is far off. -/
private theorem slashed_deposit_held (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩)
    {u w : ForkedBeaconState preset} (ok : advanceSlotAcross config checks u = .ok w)
    (contained : tailC.Contains (Step.slot ok)) {es : List (BalanceEvent preset)}
    (replayedEs : (Step.slot ok : Step config checks u w).balanceEvents = .ok es)
    {e : BalanceEvent preset} (inStep : e ∈ es) (dep : e.source = .deposits)
    (ordered : ExitsOrdered e.before.state) (life : RegistryLifecycle e.before.state counted)
    {i : ℕ} (slashedC : ∃ b, counted.validators.data[i]? = some b ∧ b.slashed = true)
    {a : Validator} (found : e.before.state.validators.data[i]? = some a)
    (clean : a.slashed = false) :
    (getCurrentEpoch e.before.state).toNat < a.withdrawableEpoch.toNat := by
  obtain ⟨toFin⟩ := h.toFin
  obtain ⟨fromFin⟩ := h.fromFin
  obtain ⟨pre, post, rfl⟩ := Run.contains_split tailC (Step.slot ok) contained
  have earlyW : w.fork < .glamsterdam :=
    Nat.lt_of_le_of_lt (fork_le_of_chainSteps post.chainSteps) h.early
  have fuluU : .fusaka ≤ u.fork := Nat.le_trans h.fulu (fork_le_of_chainSteps pre.chainSteps)
  have toU := (toFin.append fromFin).append pre
  obtain ⟨-, wdKept, -, size, persist, sameEpoch⟩ := PinEventsKept.Run.events_kept toU h.genesis
    (Run.nil.snoc (Step.slot ok)) fuluU earlyW ok (.last .nil _) replayedEs e inStep dep
  obtain ⟨au, foundU⟩ : ∃ au, u.state.validators.data[i]? = some au :=
    ⟨_, Array.getElem?_eq_getElem (lt_of_lt_of_le (Array.getElem?_eq_some_iff.mp found).1 size)⟩
  have cleanU : au.slashed = false := by
    cases flag : au.slashed
    · rfl
    · obtain ⟨x, read, marked⟩ := persist i au foundU flag
      obtain rfl := Option.some.inj (read.symm.trans found)
      simp [clean] at marked
  obtain ⟨m, n, preR, step, postR, -, notM, isN⟩ := Run.split_at_flip
    ((Run.nil.snoc (Step.slot ok)).append post)
    (fun z => ∃ b, z.state.validators.data[i]? = some b ∧ b.slashed = true)
    (by
      rintro ⟨b, read, marked⟩
      obtain rfl := Option.some.inj (foundU.symm.trans read)
      simp [cleanU] at marked) slashedC
  have toM := toU.append preR
  obtain ⟨bn, foundN, slashedN⟩ := isN
  obtain ⟨bm, foundM⟩ : ∃ bm, m.state.validators.data[i]? = some bm := by
    by_cases inside : i < m.state.validators.data.size
    · exact ⟨_, Array.getElem?_eq_getElem inside⟩
    · have := fresh_unslashed toM step h.genesis (Nat.le_of_not_lt inside) foundN
      simp [this] at slashedN
  have cleanM : bm.slashed = false := by
    cases flag : bm.slashed
    · rfl
    · exact absurd ⟨bm, foundM, flag⟩ notM
  have earlyN : n.fork < .glamsterdam :=
    Nat.lt_of_le_of_lt (fork_le_of_chainSteps postR.chainSteps) h.early
  have lateM : (getCurrentEpoch m.state).toNat < bm.withdrawableEpoch.toNat :=
    newly_slashed_unwithdrawable h.genesis h.caps toM step earlyN foundM foundN cleanM slashedN
  have epochs : (getCurrentEpoch u.state).toNat ≤ (getCurrentEpoch m.state).toNat :=
    UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps preR.chainSteps)
  have sameNat := congrArg UInt64.toNat sameEpoch
  by_cases unset : au.exitEpoch = FAR_FUTURE_EPOCH
  · have bound := UInt64.le_iff_toNat_le.mp (ordered a (Array.mem_of_getElem? found))
    have far := getCurrentEpoch_succ_lt_farFuture h.twoSlots e.before.state
    by_cases assigned : a.exitEpoch = FAR_FUTURE_EPOCH
    · rw [assigned] at bound
      omega
    · obtain ⟨wc, readC, bC⟩ := slashedC
      obtain ⟨later, readL, lifeL⟩ := life.validators i a found
      obtain rfl : later = wc := Option.some.inj (readL.symm.trans readC)
      have exitC := congrArg UInt64.toNat (lifeL.exitEpoch assigned)
      obtain ⟨charge, member, -, charged⟩ := Run.departure_charge_of_assigned
        ((Run.nil.snoc (Step.slot ok)).append post) i au later foundU readC unset
        (by rw [lifeL.exitEpoch assigned]; exact assigned)
      have late := DirectSafety.Run.departureCharges_epoch_ge_start
        ((Run.nil.snoc (Step.slot ok)).append post) (Nat.le_trans (by decide) fuluU) h.early charge
        member
      omega
  · have keptM := PinEventsKept.kept_run toU h.genesis fuluU preR
      (Nat.lt_of_le_of_lt step.chainStep.fork_le earlyN)
    obtain ⟨le1, moved1⟩ := wdKept i au a foundU found unset
    obtain ⟨le2, moved2⟩ := keptM.withdrawable i au bm foundU foundM unset
    have e1 := UInt64.le_iff_toNat_le.mp le1
    have e2 := UInt64.le_iff_toNat_le.mp le2
    have eq1 : a.withdrawableEpoch = au.withdrawableEpoch := moved1.resolve_left (by simp [clean])
    have eq2 : bm.withdrawableEpoch = au.withdrawableEpoch := moved2.resolve_left (by simp [cleanM])
    have := congrArg UInt64.toNat eq1
    have := congrArg UInt64.toNat eq2
    omega

/-- The deposits credited to keys active at C's end, and to keys slashed there, fit the churn.

A key that exits after C's epoch is not withdrawable at any deposit event of C's run.

Its exit epoch is constant once set, and the exit epoch bounds the withdrawable epoch.

A key slashed at C counts only the deposits of events that do not hold it slashed.

An event that raises no balance credits nothing. -/
private theorem deposits_active_le (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    (S P : Finset ValidatorIndex) (apart : Disjoint S P)
    (active : ∀ v ∈ S, ∃ w, counted.validators.data[v.toNat]? = some w ∧
      (getCurrentEpoch counted).toNat < w.exitEpoch.toNat)
    (slashedC : ∀ v ∈ P, ∃ b, counted.validators.data[v.toNat]? = some b ∧ b.slashed = true) :
    3 * (∑ v ∈ S, (creditScan (fun _ => false) (fun s => decide (s = .deposits)) v.toNat highC
      tailC) + ∑ v ∈ P, depPre eventsC v.toNat) ≤ (pinTerms config pulled anc fin).queueDep := by
  obtain ⟨toFin⟩ := h.toFin
  obtain ⟨fromFin⟩ := h.fromFin
  have located := (run_located tailC (Nat.le_trans (by decide) h.fulu) h.early highC replayedC).1
  refine deposits_scan_le h tailC highC endEpochC replayedC S P fun e member dep => ?_
  rcases located e member dep with unconditional | ⟨u, w, ok, es, contained, replayedEs, inStep, -⟩
  · have zero (i : ℕ) : keyCredit i e = 0 := by
      have := unconditional i
      simp only [keyCredit]
      omega
    simp [zero]
  have forkLe := ((toFin.append fromFin).withdrawnConsolidationCredit_eq_zero tailC h.genesis
    h.early h.delay replayedC e member).2.2
  obtain ⟨-, life, life', ordered, matched, -, epoch⟩ := replay_event_provenance
    (toFin.append fromFin) tailC h.genesis h.early highC endEpochC _ replayedC e member
  have union := deposit_each_le e
    (S ∪ P.filter fun v => ¬ slashedFlagAt e.before.state v.toNat = some true) dep
    (Nat.le_trans (Nat.le_trans (by decide) h.fulu) forkLe) matched fun v inUnion a found => ?_
  · rwa [Finset.sum_union (Finset.disjoint_of_subset_right (Finset.filter_subset _ _) apart)]
      at union
  rcases Finset.mem_union.mp inUnion with inS | inP
  · obtain ⟨wC, foundC, late⟩ := active v inS
    obtain ⟨u, foundU, lifeU⟩ := (life.trans life').validators v.toNat a found
    obtain rfl : u = wC := Option.some.inj (foundU.symm.trans foundC)
    have epoch' : (getCurrentEpoch e.before.state).toNat ≤ (getCurrentEpoch counted).toNat := epoch
    have bound := UInt64.le_iff_toNat_le.mp (ordered a (Array.mem_of_getElem? found))
    have far := getCurrentEpoch_succ_lt_farFuture h.twoSlots e.before.state
    by_cases unset : a.exitEpoch = FAR_FUTURE_EPOCH
    · rw [unset] at bound
      omega
    · have same := congrArg UInt64.toNat (lifeU.exitEpoch unset)
      omega
  · obtain ⟨inP, clean⟩ := Finset.mem_filter.mp inP
    simp only [slashedFlagAt, found, Option.map_some, Option.some.injEq,
      Bool.not_eq_true] at clean
    exact slashed_deposit_held h tailC ok contained replayedEs inStep dep ordered
      (life.trans life') (slashedC v inP) found clean

/-- The deposits applied on R's branch to V keys, at weight 3, against `queueDep`. -/
private theorem bud_deposits (h : Setting config checks g split fin pulled anc counted V)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩) (high : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events) :
    3 * (∑ v ∈ V, credDepR events v.toNat) ≤ (pinTerms config pulled anc fin).queueDep := by
  obtain ⟨toFin⟩ := h.toFin
  obtain ⟨fromFin⟩ := h.fromFin
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  have within := BeaconState.registryWithinLimit_of_lt h.early pulled
  -- The keys of `V` are active at R's epoch, so no deposit event credits a withdrawable one.
  have recent : ∀ i ∈ V.image UInt64.toNat, ∃ w, pulled.validators.data[i]? = some w ∧
      (isActiveValidator w (getCurrentEpoch pulled) = true ∨
        isActiveValidator w (getPreviousEpoch pulled) = true) := by
    intro i hi
    obtain ⟨v, member, rfl⟩ := Finset.mem_image.mp hi
    have listed : v ∈ getActiveValidatorIndices pulled (getCurrentEpoch pulled) := by
      simpa [activeVoters] using (h.voting v member).1
    obtain ⟨u, found, active⟩ := (mem_getActiveValidatorIndices within).mp listed
    exact ⟨u, found, .inl active⟩
  refine bud_deposits_of h tail high endEpoch replayed fun e member deposit => ?_
  have forkLe := ((toFin.append fromFin).withdrawnConsolidationCredit_eq_zero tail h.genesis h.early
    h.delay replayed e member).2.2
  have credited := Run.deposit_credit_le_funding (toFin.append fromFin) tail h.genesis h.early
    h.twoSlots high endEpoch replayed (V.image UInt64.toNat) recent e member deposit
    (Nat.le_trans electra forkLe)
  rw [Finset.sum_image fun _ _ _ _ same => UInt64.toNat_inj.mp same] at credited
  exact credited

/-- A step with a key that has no exit at its start and one at its end charges that key.

It is the converse of `charge_exits`. -/
private theorem step_charges_of_exits {m n : ForkedBeaconState preset}
    (step : Step config checks m n) {i : ℕ} {u w : Validator}
    (foundM : m.state.validators.data[i]? = some u)
    (foundN : n.state.validators.data[i]? = some w) (unset : u.exitEpoch = FAR_FUTURE_EPOCH)
    (assigned : w.exitEpoch ≠ FAR_FUTURE_EPOCH) :
    step.departureCharges.any (·.index == i) = true := by
  obtain ⟨d, dMember, dIndex, -⟩ :=
    (Run.nil.snoc step).departure_charge_of_assigned i u w foundM foundN unset assigned
  exact List.any_eq_true.mpr
    ⟨d, by simpa [Run.departureCharges] using dMember, by simpa using dIndex⟩

/-- Two charges of a run at one position are the same charge. -/
private theorem charge_unique {x y : ForkedBeaconState preset} (tail : Run config checks x y)
    {c d : DepartureCharge} (hc : c ∈ tail.departureCharges) (hd : d ∈ tail.departureCharges)
    (same : c.index = d.index) : c = d :=
  List.inj_on_of_nodup_map (DirectSafety.departureCharges_run_indices tail) hc hd same

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The slashing credits of C's run are paid for each key by its envelope or its charge.

A key of the split's registry is paid by the envelope on its effective balance.

A key beyond it is paid by the charge that its exit leaves. -/
private theorem slashing_charge (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    (env cr : ℕ → ℕ)
    (registry : ∀ {a b : ForkedBeaconState preset} (step : Step config checks a b),
      tailC.Contains step → ∀ i, i < split.validators.data.size →
        (!(a.state.validators.data[i]?.map (·.slashed)).getD false &&
          (b.state.validators.data[i]?.map (·.slashed)).getD false) = true →
        effectiveAt a i ≤ env i)
    (created : ∀ {a b : ForkedBeaconState preset} (step : Step config checks a b),
      tailC.Contains step → ∀ i, split.validators.data.size ≤ i →
        (!(a.state.validators.data[i]?.map (·.slashed)).getD false &&
          (b.state.validators.data[i]?.map (·.slashed)).getD false) = true →
        effectiveAt a i / (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat ≤ cr i) :
    (eventsC.map fun e => if e.source = .slashings then e.creditLimit else 0).sum ≤
      ∑ i ∈ (Finset.range counted.validators.data.size).filter (fun i =>
          (split.validators.data[i]?.map (·.slashed)).getD false = false ∧
            (counted.validators.data[i]?.map (·.slashed)).getD false = true),
        (if i < split.validators.data.size then
          env i / (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat else cr i) := by
  classical
  obtain ⟨shared⟩ := h.toFin
  refine slashing_credits_le (shared.append fromFin) tailC h.genesis h.early h.caps.compounding
    highC endEpochC _ _ ?_ replayedC
  intro a b step member i inside flag
  obtain ⟨pre, post, -, -, -⟩ :=
    DirectSafety.Apriori.Internal.Run.contains_step_facts member h.early
  have sameFork : a.fork = fork :=
    fork_eq_of_run pre ((Run.nil.snoc step).append post) (Nat.le_refl _)
  simp only [Bool.and_eq_true, Bool.not_eq_true'] at flag
  obtain ⟨unslashedA, slashedB⟩ := flag
  have insideCounted : i < counted.validators.data.size :=
    Nat.lt_of_lt_of_le (Finset.mem_range.mp inside) post.registryLifecycle.size_le
  have unslashedSplit : (split.validators.data[i]?.map (·.slashed)).getD false = false := by
    cases found : split.validators.data[i]? with
    | none => rfl
    | some w =>
      simp [unslashed_of_run pre found (fun u read => by simpa [read] using unslashedA)]
  have slashedCounted : (counted.validators.data[i]?.map (·.slashed)).getD false = true := by
    cases found : b.state.validators.data[i]? with
    | none => simp [found] at slashedB
    | some w =>
      have marked : w.slashed = true := by simpa [found] using slashedB
      obtain ⟨u, read, kept⟩ := post.slashedPersistence i w found marked
      simp [read, kept]
  refine ⟨Finset.mem_filter.mpr ⟨Finset.mem_range.mpr insideCounted, unslashedSplit,
    slashedCounted⟩, ?_⟩
  by_cases registered : i < split.validators.data.size
  · simp only [registered, ↓reduceIte, sameFork]
    exact Nat.div_le_div_right (registry step member i registered
      (by simp [unslashedA, slashedB]))
  · simp only [registered, ↓reduceIte, sameFork]
    exact created step member i (Nat.le_of_not_lt registered)
      (by simp [unslashedA, slashedB])

/-- The amount of the departure charge of a key on a run, or 0.

The charge reads the effective balance before the step that assigns the exit. -/
private def chargeAmt {x y : ForkedBeaconState preset} (tail : Run config checks x y) (i : ℕ) :
    ℕ :=
  ((tail.departureCharges.find? fun c => c.index == i).map (·.amount)).getD 0

/-- A charge that meets a test, and is the only one that does, is the first that does. -/
private theorem find_charge {l : List DepartureCharge} {p : DepartureCharge → Bool}
    {c : DepartureCharge} (member : c ∈ l) (hp : p c = true)
    (unique : ∀ d ∈ l, p d = true → d = c) : l.find? p = some c := by
  obtain ⟨d, chosen⟩ := Option.isSome_iff_exists.mp (List.find?_isSome.mpr ⟨c, member, hp⟩)
  obtain rfl := unique d (List.mem_of_find?_eq_some chosen) (List.find?_some chosen)
  exact chosen

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- A key that a step slashes with its exit unset is charged its effective balance before the step.

The slashing assigns its exit, so the step records a departure charge of that amount.

The charge of the run at the key is that one. -/
private theorem slash_exit_charge (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩)
    {a b : ForkedBeaconState preset} (step : Step config checks a b) (member : tailC.Contains step)
    (i : ℕ) (old new : Validator) (foundA : a.state.validators.data[i]? = some old)
    (foundB : b.state.validators.data[i]? = some new) (unset : old.exitEpoch = FAR_FUTURE_EPOCH)
    (slashed : new.slashed = true) :
    effectiveAt a i ≤ chargeAmt tailC i := by
  classical
  unfold chargeAmt
  obtain ⟨shared⟩ := h.toFin
  obtain ⟨pre, post, cut, -, -⟩ :=
    DirectSafety.Apriori.Internal.Run.contains_step_facts member h.early
  have bEarly : b.fork < .glamsterdam :=
    Nat.lt_of_le_of_lt (fork_le_of_chainSteps post.chainSteps) h.early
  have assigned : new.exitEpoch ≠ FAR_FUTURE_EPOCH :=
    run_slashed_exit_assigned (((shared.append fromFin).append pre).snoc step) h.genesis
      h.caps.activation h.caps.compounding bEarly h.delay i new foundB slashed
  have inStep : (⟨i, new.exitEpoch.toNat, old.effectiveBalance.toNat⟩ : DepartureCharge) ∈
      step.departureCharges := by
    apply List.mem_filterMap.mpr
    refine ⟨(old, i), ?_, ?_⟩
    · simpa only [List.mem_zipIdx_iff_getElem?, Array.getElem?_toList] using foundA
    · simp [foundB, unset, assigned]
  have inRun : (⟨i, new.exitEpoch.toNat, old.effectiveBalance.toNat⟩ : DepartureCharge) ∈
      tailC.departureCharges := by
    rw [cut, Run.departureCharges_append]
    simp [Run.departureCharges, inStep]
  rw [find_charge inRun (by simp)
    (fun d inD hd => charge_unique tailC inD inRun (by simpa using hd))]
  simp [effectiveAt, foundA]

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- A key beyond R's registry is charged the amount of its exit and what it gains after it.

An exit that a step assigns by the slashing is the charge of that step.

An earlier exit adds its gains, bands and credits, which `extra` bounds. -/
private theorem created_charge (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (extra : ℕ → ℕ)
    (earlier : ∀ {a b : ForkedBeaconState preset} (step : Step config checks a b),
      tailC.Contains step → ∀ (i : ℕ), split.validators.data.size ≤ i → ∀ (old : Validator),
        a.state.validators.data[i]? = some old → old.exitEpoch ≠ FAR_FUTURE_EPOCH →
          effectiveAt a i ≤ chargeAmt tailC i + extra i)
    {a b : ForkedBeaconState preset} (step : Step config checks a b) (member : tailC.Contains step)
    (i : ℕ) (created : split.validators.data.size ≤ i)
    (flag : (!(a.state.validators.data[i]?.map (·.slashed)).getD false &&
      (b.state.validators.data[i]?.map (·.slashed)).getD false) = true) :
    effectiveAt a i ≤ chargeAmt tailC i + extra i := by
  simp only [Bool.and_eq_true, Bool.not_eq_true'] at flag
  obtain ⟨-, slashedB⟩ := flag
  cases foundA : a.state.validators.data[i]? with
  | none => simp [effectiveAt, foundA]
  | some old =>
    by_cases unset : old.exitEpoch = FAR_FUTURE_EPOCH
    · cases foundB : b.state.validators.data[i]? with
      | none => simp [foundB] at slashedB
      | some new =>
        have marked : new.slashed = true := by simpa [foundB] using slashedB
        exact (slash_exit_charge h fromFin tailC step member i old new foundA foundB unset
          marked).trans (Nat.le_add_right _ _)
    · exact earlier step member i created old foundA unset

/-- The keys whose exit is charged within the run's epochs pay at most the window of the queues.

For such a key `chargeAmt` is the `exitQ` of the run. -/
private theorem charge_amounts_le_queueWindow
    (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (S : Finset ValidatorIndex)
    (charged : ∀ v ∈ S, ∃ c ∈ tailC.departureCharges,
      c.index = v.toNat ∧ c.epoch ≤ (getCurrentEpoch counted).toNat) :
    ∑ v ∈ S, chargeAmt tailC v.toNat ≤ (pinTerms config pulled anc fin).queueWindow := by
  classical
  have same : ∀ v ∈ S, chargeAmt tailC v.toNat = exitQ tailC v.toNat := by
    intro v member
    obtain ⟨c, inRun, index, epoch⟩ := charged v member
    have unique : ∀ d ∈ tailC.departureCharges, d.index = v.toNat → d = c := fun d inD same =>
      charge_unique tailC inD inRun (same.trans index.symm)
    unfold chargeAmt exitQ
    rw [find_charge inRun (by simp [index]) (fun d inD hd => unique d inD (by simpa using hd)),
      find_charge inRun (by simp [index, epoch])
        (fun d inD hd => unique d inD (by simp at hd; exact hd.1))]
  rw [Finset.sum_congr rfl same]
  refine (sum_exitQ_le tailC ((getCurrentEpoch counted).toNat - 1 + 1)
    (by simp only; omega) S).trans ?_
  exact charges_le_queueWindow h tailC

/-- Either a run has no counted charge of a key and `exitQ` is zero.

Or `exitQ` is the amount of a counted charge of the key.

The counted charges are those whose exit epoch is at most the run's last epoch. -/
private theorem exitQ_cases {x y : ForkedBeaconState preset} (tail : Run config checks x y)
    (v : ℕ) :
    ((∀ c ∈ tail.departureCharges, c.index = v → ¬ c.epoch ≤ (getCurrentEpoch y.state).toNat) ∧
      exitQ tail v = 0) ∨
    ∃ c ∈ tail.departureCharges, c.index = v ∧ c.epoch ≤ (getCurrentEpoch y.state).toNat ∧
      exitQ tail v = c.amount := by
  cases found : tail.departureCharges.find? fun c =>
      c.index == v && decide (c.epoch ≤ (getCurrentEpoch y.state).toNat) with
  | none =>
    refine .inl ⟨fun c mem idx le => ?_, by simp [exitQ, found]⟩
    have := List.find?_eq_none.mp found c mem
    simp [idx, le] at this
  | some c =>
    have both := List.find?_some found
    simp only [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at both
    exact .inr ⟨c, List.mem_of_find?_eq_some found, both.1, both.2, by simp [exitQ, found]⟩

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- A charge of a run is the charge of the stop at its position, on the run after a prefix.

The stop is the state before the step that assigns the exit, and the charge reads its balance. -/
private theorem stop_of_charge {x s y : ForkedBeaconState preset} (fromX : Run config checks x s)
    (tail : Run config checks s y) {c0 : DepartureCharge} (member : c0 ∈ tail.departureCharges)
    {i : ℕ} (index : c0.index = i) :
    ∃ stop : Stop (fromX.append tail) i, stop.charge = some c0 := by
  subst index
  have inTail : c0 ∈ (fromX.append tail).departureCharges := by
    rw [Run.departureCharges_append]
    exact List.mem_append_right _ member
  obtain ⟨stop⟩ := Stop.exists (fromX.append tail) c0.index
  obtain ⟨c, chosen⟩ : ∃ c, stop.charge = some c := by
    cases hc : stop.charge with
    | none =>
      have selected := stop.selected
      rw [hc] at selected
      exact absurd rfl (selected.2 c0 inTail)
    | some c => exact ⟨c, rfl⟩
  have selected := stop.selected
  rw [chosen] at selected
  have cEq : c = c0 := charge_unique _ selected.1 inTail selected.2.1
  subst cEq
  exact ⟨stop, chosen⟩

/-- A run has a charge at a position exactly when `riseScan` has seen one. -/
private theorem riseScan_fst {x : ForkedBeaconState preset} (v high : ℕ)
    {y : ForkedBeaconState preset} (tail : Run config checks x y) :
    (riseScan (config := config) (checks := checks) v high tail).1 = true ↔
      ∃ c ∈ tail.departureCharges, c.index = v := by
  induction tail with
  | nil => simp [riseScan, Run.departureCharges]
  | snoc pre step ih =>
    simp only [riseScan, Run.departureCharges, Bool.or_eq_true, ih, List.any_eq_true,
      List.mem_append, beq_iff_eq]
    constructor
    · rintro (⟨c, member, same⟩ | ⟨c, member, same⟩)
      · exact ⟨c, .inl member, same⟩
      · exact ⟨c, .inr member, same⟩
    · rintro ⟨c, member | member, same⟩
      · exact .inl ⟨c, member, same⟩
      · exact .inr ⟨c, member, same⟩

/-- The charge adds one upward band to the rise recorded after it. -/
private theorem riseQ_eq_of_seen {x y : ForkedBeaconState preset} (tail : Run config checks x y)
    (high i : ℕ) (seen : (riseScan i high tail).1 = true) :
    riseQ tail high i = preset.upwardBand + (riseScan i high tail).2 := by
  simp only [riseQ, seen, ↓reduceIte]

/-- A key with no charge on the run has no rise after its exit. -/
private theorem riseQ_eq_zero {x y : ForkedBeaconState preset} (tail : Run config checks x y)
    (high v : ℕ) (none : ∀ c ∈ tail.departureCharges, c.index ≠ v) : riseQ tail high v = 0 := by
  have unseen : (riseScan (config := config) (checks := checks) v high tail).1 ≠ true := fun seen =>
    let ⟨c, member, same⟩ := (riseScan_fst v high tail).mp seen
    none c member same
  simp [riseQ, unseen]

/-- A key with no charge on a run has no charge amount. -/
private theorem chargeAmt_eq_zero {x y : ForkedBeaconState preset} (tail : Run config checks x y)
    {i : ℕ} (none : ¬ ∃ c ∈ tail.departureCharges, c.index = i) : chargeAmt tail i = 0 := by
  unfold chargeAmt
  rw [List.find?_eq_none.mpr fun c member same => none ⟨c, member, by simpa using same⟩]
  rfl

/-- A key of `K5` that has a charge on the run exits by the run's last epoch. -/
private theorem charge_epoch_le_of_K5 (h : Setting config checks g split fin pulled anc counted V)
    {x : ForkedBeaconState preset} (tail : Run config checks x ⟨fork, counted⟩)
    {v : ValidatorIndex} (member : v ∈ K5 counted V) :
    ∀ c ∈ tail.departureCharges, c.index = v.toNat →
      c.epoch ≤ (getCurrentEpoch counted).toNat := by
  intro c charged same
  obtain ⟨w, found, assigned, epoch⟩ := Run.departure_charge_exit tail c charged
  obtain ⟨u, foundU, activeBefore, notNow⟩ := K5_previous_only h member
  rw [same] at found
  have equal : u = w := Option.some.inj (foundU.symm.trans found)
  subst equal
  have previous := getPreviousEpoch_toNat counted
  simp only [isActiveValidator, Bool.and_eq_true, decide_eq_true_eq] at activeBefore
  simp only [isActiveValidator, Bool.and_eq_false_iff, decide_eq_false_iff_not] at notNow
  have low := UInt64.le_iff_toNat_le.mp activeBefore.1
  rw [← epoch]
  rcases notNow with notLow | notHigh
  · exact absurd (UInt64.le_iff_toNat_le.mpr (by omega)) notLow
  · have : ¬ (getCurrentEpoch counted).toNat < u.exitEpoch.toNat :=
      fun lt => notHigh (UInt64.lt_iff_toNat_lt.mpr lt)
    omega

/-- The quarter of any total has a base reward per increment, if any total has one.

The factor times the increment fits in a `UInt64` for every total, and the quarter is positive. -/
private theorem quarter_base_ok (facts : PinPresetFacts preset) {total perIncrement : Gwei}
    (perOk : getBaseRewardPerIncrement preset total = .ok perIncrement) (T : Gwei) :
    ∃ pq, getBaseRewardPerIncrement preset
      (if 18 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤ T.toNat then T / 4
        else preset.EFFECTIVE_BALANCE_INCREMENT / 5) = .ok pq := by
  have size := facts.incrementSize
  have positive : 0 < (if 18 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤ T.toNat then T / 4
      else preset.EFFECTIVE_BALANCE_INCREMENT / 5 : Gwei).toNat := by
    split
    · rename_i big
      simp only [UInt64.toNat_div]
      show 0 < T.toNat / 4
      omega
    · simp only [UInt64.toNat_div]
      show 0 < preset.EFFECTIVE_BALANCE_INCREMENT.toNat / 5
      omega
  generalize (if 18 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤ T.toNat then T / 4
    else preset.EFFECTIVE_BALANCE_INCREMENT / 5 : Gwei) = q at positive ⊢
  simp only [getBaseRewardPerIncrement, liftArith, mapError_ok_iff, bind_ok_iff] at perOk
  obtain ⟨scaled, scaledOk, -⟩ := perOk
  have root : integerSquareroot q ≠ 0 := fun zero => by
    have value := toNat_integerSquareroot q
    rw [zero] at value
    have := Nat.sqrt_pos.mpr positive
    simp only [UInt64.toNat_zero] at value
    omega
  refine ⟨scaled / integerSquareroot q, ?_⟩
  simp only [getBaseRewardPerIncrement, liftArith, mapError_ok_iff, bind_ok_iff]
  exact ⟨scaled, scaledOk, divChecked_ok_iff.mpr ⟨root, by rw [UInt64.toNat_div]⟩⟩

/-- The pin has a rate `P` that bounds the reward rate at every state of a run from `fin`.

The rate is the base reward per increment that `pinTerms` reads, or zero if there is none.

The rate also bounds the largest gain rate, which `gainRateMax` is. -/
private theorem pin_rate_exists (h : Setting config checks g split fin pulled anc counted V) :
    ∃ P : ℕ,
      P = ((getBaseRewardPerIncrement preset
        (if 18 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤
            ((getTotalActiveBalance pulled).toOption.getD 0).toNat then
          (getTotalActiveBalance pulled).toOption.getD 0 / 4
        else preset.EFFECTIVE_BALANCE_INCREMENT / 5)).toOption.getD 0).toNat ∧
      preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat * P *
        (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum / WEIGHT_DENOMINATOR.toNat ≤
          (pinTerms config pulled anc fin).gainRateMax ∧
      ∀ {m : BeaconState preset fork} (_toM : Run config checks ⟨fork, fin⟩ ⟨fork, m⟩),
        (getCurrentEpoch m).toNat ≤ (getCurrentEpoch pulled).toNat + 1 →
        ∀ total perIncrement : Gwei, getTotalActiveBalance m = .ok total →
          getBaseRewardPerIncrement preset total = .ok perIncrement →
          perIncrement.toNat *
              ((∑ i ∈ (getActiveValidatorIndices m (getPreviousEpoch m)).toFinset,
                effectiveAt (⟨fork, m⟩ : ForkedBeaconState preset) i.toNat) /
                  preset.EFFECTIVE_BALANCE_INCREMENT.toNat) ≤
            P * (total.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat) := by
  have gainMax : (pinTerms config pulled anc fin).gainRateMax =
      preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat *
        ((getBaseRewardPerIncrement preset
          (if 18 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤
              ((getTotalActiveBalance pulled).toOption.getD 0).toNat then
            (getTotalActiveBalance pulled).toOption.getD 0 / 4
          else preset.EFFECTIVE_BALANCE_INCREMENT / 5)).toOption.getD 0).toNat *
        (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum / WEIGHT_DENOMINATOR.toNat := rfl
  by_cases anyOk : ∃ total perIncrement : Gwei,
      getBaseRewardPerIncrement preset total = .ok perIncrement
  · obtain ⟨total, perIncrement, perOk⟩ := anyOk
    obtain ⟨pq, pqOk⟩ :=
      quarter_base_ok h.facts perOk ((getTotalActiveBalance pulled).toOption.getD 0)
    refine ⟨pq.toNat, by rw [pqOk]; rfl, ?_, fun toM inside =>
      rate_of_guard h toM inside (Or.inl rfl) pqOk⟩
    rw [gainMax, pqOk]
    simp only [Except.toOption, Option.getD_some, le_refl]
  · refine ⟨0, ?_, ?_, fun _ _ total perIncrement _ perOk =>
      absurd ⟨total, perIncrement, perOk⟩ anyOk⟩
    · cases hr : getBaseRewardPerIncrement preset
          (if 18 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤
              ((getTotalActiveBalance pulled).toOption.getD 0).toNat then
            (getTotalActiveBalance pulled).toOption.getD 0 / 4
          else preset.EFFECTIVE_BALANCE_INCREMENT / 5) with
      | error e => rfl
      | ok p => exact absurd ⟨_, p, hr⟩ anyOk
    · simp

/-- The pin's rate bounds the reward rate at each state of a prefix of C's tail.

The prefix ends at most one epoch after the call, and its states are of the fork of the setting. -/
private theorem key_rate_forked (h : Setting config checks g split fin pulled anc counted V) :
    ∃ P : ℕ,
      P = ((getBaseRewardPerIncrement preset
        (if 18 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤
            ((getTotalActiveBalance pulled).toOption.getD 0).toNat then
          (getTotalActiveBalance pulled).toOption.getD 0 / 4
        else preset.EFFECTIVE_BALANCE_INCREMENT / 5)).toOption.getD 0).toNat ∧
      ∀ a : ForkedBeaconState preset, Run config checks ⟨fork, split⟩ a → a.fork ≤ fork →
      (getCurrentEpoch a.state).toNat ≤ (getCurrentEpoch pulled).toNat + 1 →
      ∀ total perIncrement : Gwei, getTotalActiveBalance a.state = .ok total →
        getBaseRewardPerIncrement preset total = .ok perIncrement →
        perIncrement.toNat * ((∑ j ∈ (getActiveValidatorIndices a.state
          (getPreviousEpoch a.state)).toFinset, effectiveAt a j.toNat) /
            preset.EFFECTIVE_BALANCE_INCREMENT.toNat) ≤
          P * (total.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat) := by
  obtain ⟨P, hP, -, rateAll⟩ := pin_rate_exists h
  obtain ⟨fromFin⟩ := h.fromFin
  refine ⟨P, hP, fun a run forkLe near total perIncrement totalOk perOk => ?_⟩
  obtain ⟨af, as⟩ := a
  have sameFork : af = fork := fork_eq_of_run run Run.nil forkLe
  subst sameFork
  simp only at near totalOk perOk ⊢
  exact rateAll (fromFin.append run) (by omega) total perIncrement totalOk perOk

/-- The pin's rate bounds the reward rate at every state of a prefix of C's tail.

The prefix ends at most one epoch after the call.

Each state of its balance path is the end of a run from the finalized block.

So the guard applies. -/
private theorem key_rate_pre (h : Setting config checks g split fin pulled anc counted V)
    {a : BeaconState preset fork} (pre : Run config checks ⟨fork, split⟩ ⟨fork, a⟩)
    (near : (getCurrentEpoch a).toNat ≤ (getCurrentEpoch pulled).toNat + 1) :
    ∃ P : ℕ,
      P = ((getBaseRewardPerIncrement preset
        (if 18 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤
            ((getTotalActiveBalance pulled).toOption.getD 0).toNat then
          (getTotalActiveBalance pulled).toOption.getD 0 / 4
        else preset.EFFECTIVE_BALANCE_INCREMENT / 5)).toOption.getD 0).toNat ∧
      ∀ z ∈ pre.balancePath, ∀ total perIncrement : Gwei,
      getTotalActiveBalance z.state = .ok total →
      getBaseRewardPerIncrement preset total = .ok perIncrement →
      perIncrement.toNat * ((∑ j ∈ (getActiveValidatorIndices z.state
        (getPreviousEpoch z.state)).toFinset, effectiveAt z j.toNat) /
          preset.EFFECTIVE_BALANCE_INCREMENT.toNat) ≤
        P * (total.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat) := by
  obtain ⟨P, hP, rate⟩ := key_rate_forked h
  refine ⟨P, hP, fun z member total perIncrement totalOk perOk => ?_⟩
  obtain ⟨r1, r2, -⟩ := balancePath_endpoint pre Run.nil
    (show (⟨fork, a⟩ : ForkedBeaconState preset).fork ≤
      (⟨fork, split⟩ : ForkedBeaconState preset).fork from Nat.le_refl _) member
  have order : (getCurrentEpoch z.state).toNat ≤ (getCurrentEpoch a).toNat :=
    UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps r2.chainSteps)
  exact rate z r1 (fork_le_of_chainSteps r2.chainSteps) (by omega) total perIncrement totalOk
    perOk

/-- The depth times the reward rate for each increment stays below an eleventh of an increment.

It follows from the second test of the low rate at an aligned bound.

Its units are the gwei of the reward, scaled by the weight denominator. -/
private theorem rate_per_increment (I WD F P e0 D : ℕ) (hI : 0 < I) (hWD : 0 < WD)
    (alignedE : e0 % I = 0) (rateLow : 11 * D * (e0 / I * P * F / WD + 1) ≤ e0) :
    11 * D * (P * F) < WD * I := by
  rcases Nat.eq_zero_or_pos D with zero | pos
  · subst zero
    simpa using Nat.mul_pos hWD hI
  · obtain ⟨m, hm⟩ := Nat.dvd_of_mod_eq_zero alignedE
    have e : e0 / I = m := by rw [hm, Nat.mul_div_cancel_left _ hI]
    rw [e] at rateLow
    have big : 11 ≤ e0 := Nat.le_trans (by
      have := Nat.mul_le_mul (show 11 ≤ 11 * D by omega)
        (Nat.le_add_left 1 (m * P * F / WD))
      simpa using this) rateLow
    have mPos : 0 < m := Nat.pos_of_ne_zero (fun z => by rw [z] at hm; omega)
    have a : m * P * F < WD * (m * P * F / WD + 1) := Nat.lt_mul_div_succ _ hWD
    have b := Nat.mul_lt_mul_of_pos_left a (show 0 < 11 * D by omega)
    have d := Nat.mul_le_mul_left WD rateLow
    have f : (11 * D * (P * F)) * m < (WD * I) * m := by
      calc (11 * D * (P * F)) * m = 11 * D * (m * P * F) := by ring
        _ < 11 * D * (WD * (m * P * F / WD + 1)) := b
        _ = WD * (11 * D * (m * P * F / WD + 1)) := by ring
        _ ≤ WD * e0 := d
        _ = (WD * I) * m := by rw [hm]; ring
    exact Nat.lt_of_mul_lt_mul_right f

/-- The base reward per increment is at least four.

The root of a quarter total is below `2 ^ 31`.

And `rewardScale` makes the scaled factor at least `2 ^ 35`.

Below the small total the root is at most a fifth of an increment, which the factor covers.

The read succeeds, since the quarter total is positive and `fits` bounds the scaled factor. -/
private theorem four_le_perIncrement (h : Setting config checks g split fin pulled anc counted V) :
    4 ≤ (pinTerms config pulled anc fin).perIncrement := by
  have definition : (pinTerms config pulled anc fin).perIncrement =
      ((getBaseRewardPerIncrement preset
        (if 18 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤
            ((getTotalActiveBalance pulled).toOption.getD 0).toNat then
          (getTotalActiveBalance pulled).toOption.getD 0 / 4
        else preset.EFFECTIVE_BALANCE_INCREMENT / 5)).toOption.getD 0).toNat := rfl
  obtain ⟨q, hq⟩ : ∃ q : Gwei, q = (if 18 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤
        ((getTotalActiveBalance pulled).toOption.getD 0).toNat then
          (getTotalActiveBalance pulled).toOption.getD 0 / 4
        else preset.EFFECTIVE_BALANCE_INCREMENT / 5) := ⟨_, rfl⟩
  rw [← hq] at definition
  have small : q.toNat < 2 ^ 62 ∨ 5 * q.toNat ≤ preset.EFFECTIVE_BALANCE_INCREMENT.toNat := by
    rw [hq]
    split_ifs
    · left
      have : ((getTotalActiveBalance pulled).toOption.getD 0).toNat < 2 ^ 64 :=
        ((getTotalActiveBalance pulled).toOption.getD 0).toNat_lt
      rw [UInt64.toNat_div]
      simp only [UInt64.reduceToNat]
      omega
    · right
      rw [UInt64.toNat_div]
      simp only [UInt64.reduceToNat]
      omega
  have room := h.facts.rewardScale
  have reward := h.facts.reward
  have positive : 0 < q.toNat := by
    have size := h.facts.incrementSize
    rw [hq]
    split_ifs
    · rw [UInt64.toNat_div]
      simp only [UInt64.reduceToNat]
      omega
    · rw [UInt64.toNat_div]
      simp only [UInt64.reduceToNat]
      omega
  obtain ⟨per, computed⟩ :=
    DirectSafety.Apriori.Internal.perIncrement_exists positive h.facts.fits
  rw [computed] at definition
  simp only [Except.toOption, Option.getD_some] at definition
  have formula := toNat_getBaseRewardPerIncrement computed
  have rootPos : 0 < q.toNat.sqrt := Nat.sqrt_pos.mpr positive
  have rootSmall : 4 * q.toNat.sqrt ≤ preset.EFFECTIVE_BALANCE_INCREMENT.toNat *
      preset.BASE_REWARD_FACTOR.toNat := by
    rcases small with low | tiny
    · have : q.toNat.sqrt < 2 ^ 31 := Nat.sqrt_lt'.mpr (by norm_num at low ⊢; omega)
      omega
    · have : q.toNat.sqrt ≤ q.toNat := Nat.sqrt_le_self _
      have : preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤
          preset.EFFECTIVE_BALANCE_INCREMENT.toNat * preset.BASE_REWARD_FACTOR.toNat :=
        Nat.le_mul_of_pos_right _ reward
      omega
  have four : 4 ≤ per.toNat := by
    rw [formula]
    exact (Nat.le_div_iff_mul_le rootPos).mpr rootSmall
  rw [definition]
  exact four

/-- Rounding up a whole number of increments gives it back. -/
private theorem div_round_mul (I u : ℕ) (hI : 0 < I) : (I * u + I - 1) / I = u := by
  rw [show I * u + I - 1 = I * u + (I - 1) by omega, Nat.mul_add_div hI,
    Nat.div_eq_of_lt (show I - 1 < I by omega)]
  simp

/-- The gain on a positive number of increments is below an eleventh of them.

The rate for each increment is the one that `rate_per_increment` bounds. -/
private theorem gain_lt (I WD F P D k : ℕ) (hk : 0 < k)
    (key : 11 * D * (P * F) < WD * I) : 11 * (D * (k * P * F / WD)) < I * k := by
  have fl : WD * (k * P * F / WD) ≤ k * P * F := Nat.mul_div_le _ _
  have h1 : WD * (11 * (D * (k * P * F / WD))) < WD * (I * k) :=
    calc WD * (11 * (D * (k * P * F / WD))) = 11 * D * (WD * (k * P * F / WD)) := by ring
      _ ≤ 11 * D * (k * P * F) := Nat.mul_le_mul_left _ fl
      _ = k * (11 * D * (P * F)) := by ring
      _ < k * (WD * I) := Nat.mul_lt_mul_of_pos_left key hk
      _ = WD * (I * k) := by ring
  exact Nat.lt_of_mul_lt_mul_left h1

/-- The gain on a credit rounded up to an increment is at most an eleventh of the credit.

The credit is a whole number of increments, so its rounding up is itself. -/
private theorem gain_credit_le (I WD F P D C : ℕ) (hI : 0 < I)
    (alignedC : C % I = 0) (key : 11 * D * (P * F) < WD * I) :
    11 * (D * ((C + I - 1) / I * P * F / WD)) ≤ C := by
  obtain ⟨u, hu⟩ := Nat.dvd_of_mod_eq_zero alignedC
  subst hu
  rw [div_round_mul I u hI]
  rcases Nat.eq_zero_or_pos u with zero | pos
  · subst zero
    simp
  · exact (gain_lt I WD F P D u pos key).le

/-- The gain at the stake `e0 + C` over `k` epochs splits into two parts.

They are the gain on the credits and the gain at the base stake `e0`.

The floor costs one unit per epoch. -/
private theorem gain_split_flat (I WD F P e0 C k depth : ℕ) (hI : 0 < I) (hk : k ≤ depth)
    (alignedE : e0 % I = 0) (alignedC : C % I = 0) :
    k * ((e0 + C) / I * P * F / WD) ≤
      depth * ((C + I - 1) / I * P * F / WD) + (depth * (e0 / I * P * F / WD) + depth) := by
  obtain ⟨a, rfl⟩ := Nat.dvd_of_mod_eq_zero alignedE
  obtain ⟨b, rfl⟩ := Nat.dvd_of_mod_eq_zero alignedC
  rw [← Nat.mul_add, Nat.mul_div_cancel_left _ hI, Nat.mul_div_cancel_left _ hI,
    div_round_mul I b hI]
  have floor := Nat.add_div_le_div_add_div_add_one (a * P * F) (b * P * F) WD
  have split : (a + b) * P * F = a * P * F + b * P * F := by ring
  rw [split]
  calc k * ((a * P * F + b * P * F) / WD)
      ≤ depth * ((a * P * F + b * P * F) / WD) := Nat.mul_le_mul_right _ hk
    _ ≤ depth * (a * P * F / WD + b * P * F / WD + 1) := Nat.mul_le_mul_left _ floor
    _ = depth * (b * P * F / WD) + (depth * (a * P * F / WD) + depth) := by ring

/-- The gain of one key's flows is at most the linear rate of the flows.

It drops the floor of the increments and the floor of the rate. -/
private theorem gain_lin (I WD FP D Z : ℕ) :
    10 * (I * WD) * (D * (11 * Z / (10 * I) * FP / WD)) ≤ 11 * D * FP * Z := by
  have floorLe : WD * (11 * Z / (10 * I) * FP / WD) ≤ 11 * Z / (10 * I) * FP :=
    Nat.mul_div_le _ _
  have increments : 10 * I * (11 * Z / (10 * I)) ≤ 11 * Z := by
    rw [Nat.mul_comm]; exact Nat.div_mul_le_self _ _
  calc 10 * (I * WD) * (D * (11 * Z / (10 * I) * FP / WD))
      = 10 * I * D * (WD * (11 * Z / (10 * I) * FP / WD)) := by ring
    _ ≤ 10 * I * D * (11 * Z / (10 * I) * FP) := Nat.mul_le_mul_left _ floorLe
    _ = D * FP * (10 * I * (11 * Z / (10 * I))) := by ring
    _ ≤ D * FP * (11 * Z) := Nat.mul_le_mul_left _ increments
    _ = 11 * D * FP * Z := by ring

/-- The gain on whole increments of a stake, at eleven tenths, is at most a tenth of the stake.

The rate for each increment is the one that `rate_per_increment` bounds. -/
private theorem gain_tenth (I WD F P D Zr : ℕ)
    (key : 11 * D * (P * F) < WD * I) :
    D * (11 * Zr / (10 * I) * P * F / WD) ≤ Zr / 10 := by
  have lin := gain_lin I WD (P * F) D Zr
  rw [Nat.mul_assoc (11 * Zr / (10 * I)) P F]
  generalize D * (11 * Zr / (10 * I) * (P * F) / WD) = G at lin ⊢
  have pos : 0 < I * WD := by
    have := Nat.lt_of_le_of_lt (Nat.zero_le _) key
    rwa [Nat.mul_comm] at this
  have rate : 11 * D * (P * F) * Zr ≤ WD * I * Zr := Nat.mul_le_mul_right Zr key.le
  rw [Nat.le_div_iff_mul_le (by norm_num)]
  refine Nat.le_of_mul_le_mul_left ?_ pos
  calc I * WD * (G * 10) = 10 * (I * WD) * G := by ring
    _ ≤ 11 * D * (P * F) * Zr := lin
    _ ≤ WD * I * Zr := rate
    _ = I * WD * Zr := by ring

/-- The gain at the base stake, with its tenth, is within `rise`'s gain slack. -/
private theorem base_absorb (D Df q : ℕ) (hDf : D ≤ Df) :
    D * q + D + (D * q + D) / 10 ≤ Df * ((11 * q + 9) / 10 + 3) := by
  have step : 11 * q ≤ 10 * ((11 * q + 9) / 10) := by omega
  have scaled := Nat.mul_le_mul_left D step
  have left : D * (11 * q) = 11 * (D * q) := by ring
  have right : D * (10 * ((11 * q + 9) / 10)) = 10 * (D * ((11 * q + 9) / 10)) := by ring
  have widen := Nat.mul_le_mul_right ((11 * q + 9) / 10 + 3) hDf
  have expand : D * ((11 * q + 9) / 10 + 3) = D * ((11 * q + 9) / 10) + 3 * D := by ring
  omega

/-- The gain of a key's flows and of the base stake is at most its flow gain, a unit and the base.

The joint floor of the flows and the base stake splits by kind with one step.

With no flow there is no step. -/
private theorem flow_gain_split (I WD F P D Dt Df q Zk Z' : ℕ)
    (key : 11 * D * (P * F) < WD * I) (hDt : D ≤ Dt) (hDf : D ≤ Df) (hZ : Zk ≤ Z') :
    D * (11 * (Zk + (D * q + D)) / (10 * I) * P * F / WD) + (D * q + D) ≤
      Dt * (11 * Z' / (10 * I) * P * F / WD) +
        (if 0 < Z' then Dt * (P * F / WD + 2) else 0) + Df * ((11 * q + 9) / 10 + 3) := by
  have tenth := gain_tenth I WD F P D (D * q + D) key
  have absorb := base_absorb D Df q hDf
  have monoGain : D * (11 * Zk / (10 * I) * P * F / WD) ≤
      Dt * (11 * Z' / (10 * I) * P * F / WD) :=
    Nat.mul_le_mul hDt (Nat.div_le_div_right (Nat.mul_le_mul_right F (Nat.mul_le_mul_right P
      (Nat.div_le_div_right (Nat.mul_le_mul_left 11 hZ)))))
  rcases Nat.eq_zero_or_pos Zk with zero | pos
  · subst zero
    simp only [Nat.zero_add]
    split_ifs <;> omega
  · have posZ : 0 < Z' := Nat.lt_of_lt_of_le pos hZ
    have joint : 11 * (Zk + (D * q + D)) / (10 * I) ≤
        11 * Zk / (10 * I) + 11 * (D * q + D) / (10 * I) + 1 := by
      have := Nat.add_div_le_div_add_div_add_one (11 * Zk) (11 * (D * q + D)) (10 * I)
      rwa [← Nat.mul_add] at this
    have step : D * (11 * (Zk + (D * q + D)) / (10 * I) * P * F / WD) ≤
        D * ((11 * Zk / (10 * I) + 11 * (D * q + D) / (10 * I) + 1) * P * F / WD) :=
      Nat.mul_le_mul_left D (Nat.div_le_div_right (Nat.mul_le_mul_right F
        (Nat.mul_le_mul_right P joint)))
    have split : (11 * Zk / (10 * I) + 11 * (D * q + D) / (10 * I) + 1) * P * F =
        11 * Zk / (10 * I) * P * F + 11 * (D * q + D) / (10 * I) * P * F + P * F := by ring
    have floors : (11 * Zk / (10 * I) * P * F + 11 * (D * q + D) / (10 * I) * P * F + P * F) /
        WD ≤ 11 * Zk / (10 * I) * P * F / WD + 11 * (D * q + D) / (10 * I) * P * F / WD +
          P * F / WD + 2 := by
      have one := Nat.add_div_le_div_add_div_add_one
        (11 * Zk / (10 * I) * P * F + 11 * (D * q + D) / (10 * I) * P * F) (P * F) WD
      have two := Nat.add_div_le_div_add_div_add_one (11 * Zk / (10 * I) * P * F)
        (11 * (D * q + D) / (10 * I) * P * F) WD
      omega
    rw [split] at step
    have wide := Nat.mul_le_mul_left D floors
    have expand : ∀ A B C : ℕ, D * (A + B + C + 2) = D * A + D * B + D * C + 2 * D :=
      fun A B C => by ring
    rw [expand] at wide
    have unit : D * (P * F / WD + 2) ≤ Dt * (P * F / WD + 2) := Nat.mul_le_mul_right _ hDt
    have unitSplit : D * (P * F / WD + 2) = D * (P * F / WD) + 2 * D := by ring
    simp only [posZ, ↓reduceIte]
    omega

/-- The closure test of the credit ceiling with the credits rounded down to increments.

The stake above `e0` is the credits, the slack `W` and the gain at the base stake.

The gain on the rounded credits is at most an eleventh of them.

Rounding down leaves less than an increment of that stake unrounded.

The increment of the bound covers it. -/
private theorem ceiling_closed_floor (I WD F P e0 D Cr Cr' S W C q : ℕ)
    (hq : q = e0 / I * P * F / WD) (hI : 0 < I) (key : 11 * D * (P * F) < WD * I)
    (hC : C = I * (11 * (Cr' + W + D * q + D) / (10 * I))) (start : S + Cr ≤ e0 + Cr' + W) :
    S + Cr + (D * ((C + I - 1) / I * P * F / WD) + (D * q + D)) < e0 + C + I := by
  subst hq
  have alignedC : C % I = 0 := by
    rw [hC]
    exact Nat.mul_mod_right _ _
  have credit := gain_credit_le I WD F P D C hI alignedC key
  have div := Nat.div_add_mod (11 * (Cr' + W + D * (e0 / I * P * F / WD) + D)) (10 * I)
  have lt := Nat.mod_lt (11 * (Cr' + W + D * (e0 / I * P * F / WD) + D)) (show 0 < 10 * I by omega)
  have times : 10 * I * (11 * (Cr' + W + D * (e0 / I * P * F / WD) + D) / (10 * I)) = 10 * C := by
    rw [hC]
    ring
  omega

/-- A number below an aligned bound by less than an increment rounds down to at most the bound.

Rounding down is to a multiple of the increment. -/
private theorem floor_le_of_lt {B E I : ℕ} (hI : 0 < I) (aligned : E % I = 0)
    (lt : B < E + I) : B - B % I ≤ E := by
  obtain ⟨u, hu⟩ := Nat.dvd_of_mod_eq_zero aligned
  have qlt : B / I < u + 1 := (Nat.div_lt_iff_lt_mul hI).mpr (by
    have : (u + 1) * I = E + I := by rw [hu]; ring
    omega)
  have mul : I * (B / I) ≤ I * u := Nat.mul_le_mul_left _ (by omega)
  have div := Nat.div_add_mod B I
  omega

/-- The arithmetic of the credit ceiling, for any run.

The bound `e0` on the effective balance, with the credits rounded down to increments, is closed.

The gain of any number of epochs up to the depth is at most the gain at the depth.

That gain is a tenth of the credits, the slack and the gain at the base stake. -/
private theorem ceiling_arith (incPos : 0 < preset.EFFECTIVE_BALANCE_INCREMENT.toNat)
    (P depth Cr Cr' e0 C S W F q : ℕ)
    (hF : F = (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum)
    (hq : q = e0 / preset.EFFECTIVE_BALANCE_INCREMENT.toNat * P * F / WEIGHT_DENOMINATOR.toNat)
    (alignedE0 : e0 % preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0)
    (hC : C = preset.EFFECTIVE_BALANCE_INCREMENT.toNat *
      (11 * (Cr' + W + depth * q + depth) / (10 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat)))
    (key : 11 * depth * (P * F) <
      WEIGHT_DENOMINATOR.toNat * preset.EFFECTIVE_BALANCE_INCREMENT.toNat)
    (start : S + Cr ≤ e0 + Cr' + W) :
    (e0 + C) % preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0 ∧
      S + Cr + (gainOn preset depth P C + (depth * q + depth)) <
        e0 + C + preset.EFFECTIVE_BALANCE_INCREMENT.toNat ∧
      (∀ k, k ≤ depth → k * ((e0 + C) / preset.EFFECTIVE_BALANCE_INCREMENT.toNat * P *
          (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum / WEIGHT_DENOMINATOR.toNat) ≤
        gainOn preset depth P C + (depth * q + depth)) ∧
      gainOn preset depth P C = depth * (11 * (Cr' + W + depth * q + depth) /
        (10 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat) * P *
          (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum / WEIGHT_DENOMINATOR.toNat) ∧
      10 * gainOn preset depth P C ≤ Cr' + W + depth * q + depth := by
  have closed := ceiling_closed_floor preset.EFFECTIVE_BALANCE_INCREMENT.toNat
    WEIGHT_DENOMINATOR.toNat F P e0 depth Cr Cr' S W C q hq incPos key hC start
  have alignedC : C % preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0 := by
    rw [hC]
    exact Nat.mul_mod_right _ _
  have credit := gain_credit_le preset.EFFECTIVE_BALANCE_INCREMENT.toNat
    WEIGHT_DENOMINATOR.toNat F P depth C incPos alignedC key
  have rounded := Nat.mul_div_le (11 * (Cr' + W + depth * q + depth))
    (10 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat)
  have times : 10 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat *
      (11 * (Cr' + W + depth * q + depth) / (10 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat)) =
        10 * C := by
    rw [hC]
    ring
  subst hF
  have alignedE : (e0 + C) % preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0 :=
    Nat.mod_eq_zero_of_dvd (Nat.dvd_add (Nat.dvd_of_mod_eq_zero alignedE0)
      (Nat.dvd_of_mod_eq_zero alignedC))
  refine ⟨alignedE, closed, fun k within => ?_, ?_, ?_⟩
  · have split := gain_split_flat preset.EFFECTIVE_BALANCE_INCREMENT.toNat
      WEIGHT_DENOMINATOR.toNat (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum P e0 C k depth
      incPos within alignedE0 alignedC
    rw [← hq] at split
    exact split
  · unfold gainOn
    rw [hC, div_round_mul _ _ incPos]
  · unfold gainOn
    omega

/-- A key's balance along a run is at most a stake bound, its credits and the gain at the bound.

The bound `e0` on the effective balance, with the credits rounded down to increments, is closed.

The stake above `e0` is the credits, the slack `W` and the gain at the base stake.

The rate premise is that of the low regime, at the depth of the call.

The gain on the rounded credits is at most a tenth of that stake. -/
private theorem c_ceiling_abstract {n y : ForkedBeaconState preset}
    (post : Run config checks n y) (early : y.fork < .glamsterdam) (fulu : .fusaka ≤ n.fork)
    (i : ℕ) (inside : i < n.state.validators.data.size) (high P capHigh : ℕ)
    (alignedCap : capHigh % preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0)
    (startCap : effectiveAt n i ≤ capHigh)
    (capCeil : ∀ z ∈ post.balancePath, PinTerms.capAt z i ≤ capHigh)
    (rate : ∀ z ∈ post.balancePath, ∀ total perIncrement : Gwei,
      getTotalActiveBalance z.state = .ok total →
      getBaseRewardPerIncrement preset total = .ok perIncrement →
      perIncrement.toNat * ((∑ j ∈ (getActiveValidatorIndices z.state
        (getPreviousEpoch z.state)).toFinset, effectiveAt z j.toNat) /
          preset.EFFECTIVE_BALANCE_INCREMENT.toNat) ≤
        P * (total.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat))
    (endEpoch : (getCurrentEpoch y.state).toNat ≤ high + 1)
    (incPos : 0 < preset.EFFECTIVE_BALANCE_INCREMENT.toNat)
    (depth Cr Cr' e0 C S W F q : ℕ)
    (hF : F = (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum)
    (hq : q = e0 / preset.EFFECTIVE_BALANCE_INCREMENT.toNat * P * F / WEIGHT_DENOMINATOR.toNat)
    (alignedE0 : e0 % preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0)
    (hC : C = preset.EFFECTIVE_BALANCE_INCREMENT.toNat *
      (11 * (Cr' + W + depth * q + depth) / (10 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat)))
    (epochs : (getCurrentEpoch y.state).toNat - (getCurrentEpoch n.state).toNat ≤ depth)
    (startBal : min (actualBalanceAt n i) capHigh ≤ S)
    (startEff : effectiveAt n i ≤ e0 + C)
    (credits : netScan i high post +
      (creditScan (fun _ => false) (fun s => decide (s ≠ .rewards)) i high post) ≤ Cr)
    (key : 11 * depth * (P * F) <
      WEIGHT_DENOMINATOR.toNat * preset.EFFECTIVE_BALANCE_INCREMENT.toNat)
    (start : S + Cr ≤ e0 + Cr' + W) :
    ∃ gc, gc = depth * (11 * (Cr' + W + depth * q + depth) /
        (10 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat) * P *
          (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum / WEIGHT_DENOMINATOR.toNat) ∧
      10 * gc ≤ Cr' + W + depth * q + depth ∧
      (∀ z ∈ post.balancePath, min (actualBalanceAt z i) capHigh ≤ S + Cr +
        (gc + (depth * q + depth))) ∧
      effectiveAt y i ≤ e0 + C := by
  obtain ⟨alignedE, closed, splitAll, hform, hten⟩ := ceiling_arith incPos P depth Cr Cr' e0 C S W F
    q hF hq alignedE0 hC key start
  subst hF
  have split := splitAll _ epochs
  have bound : PinKeyFloor.creditBound post i high (e0 + C) P capHigh ≤
      S + Cr + (gainOn preset depth P C + (depth * q + depth)) := by
    unfold PinKeyFloor.creditBound
    exact le_trans (le_of_eq (by ring)) (Nat.add_le_add (Nat.add_le_add startBal credits) split)
  have fixpoint : max (effectiveAt n i) (min capHigh
      (PinKeyFloor.creditBound post i high (e0 + C) P capHigh -
        PinKeyFloor.creditBound post i high (e0 + C) P capHigh %
          preset.EFFECTIVE_BALANCE_INCREMENT.toNat)) ≤ e0 + C :=
    max_le startEff (Nat.le_trans (Nat.min_le_right _ _)
      (floor_le_of_lt incPos alignedE (Nat.lt_of_le_of_lt bound closed)))
  obtain ⟨-, -, third, fourth⟩ := PinKeyFloor.Run.effective_floor_pair post early fulu i inside 0 0
    capHigh high (e0 + C) P
  have balances := fourth alignedCap startCap capCeil (fun z member => .inr (rate z member))
    endEpoch fixpoint
  refine ⟨gainOn preset depth P C, hform, hten,
    fun z member => Nat.le_trans (balances z member) bound, ?_⟩
  · refine Nat.le_trans (third _ alignedCap startCap balances capCeil).1 ?_
    rw [Nat.min_comm]
    exact fixpoint

/-- A key's balance along a run that makes it compound has the ceiling of a run with one cap.

The run splits at the step that makes the key compound.

Before the step the balance counts up to `lo`, and after it up to `hi`.

The ceiling is that of `c_ceiling_abstract`, with the credits of the step added.

The step leaves its balance within the smaller of its balance before it and `lo`, plus its credits.

So the balance after the step is at most the ceiling before it, plus the credits of the step.

Both parts take the same closed bound `e0 + C`, and their epochs add up to those of the run. -/
private theorem c_ceiling_abstract_flip {x m n y : ForkedBeaconState preset}
    (pre : Run config checks x m) (step : Step config checks m n) (post : Run config checks n y)
    (early : y.fork < .glamsterdam) (fulu : .fusaka ≤ x.fork)
    (i : ℕ) (inside : i < x.state.validators.data.size) (high P lo hi : ℕ)
    (alignedLo : lo % preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0)
    (alignedHi : hi % preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0) (loLe : lo ≤ hi)
    (startCap : effectiveAt x i ≤ lo)
    (capsPre : ∀ z ∈ pre.balancePath, PinTerms.capAt z i ≤ lo)
    (capsPost : ∀ z ∈ post.balancePath, PinTerms.capAt z i ≤ hi)
    (rate : ∀ z, z ∈ pre.balancePath ∨ z ∈ post.balancePath → ∀ total perIncrement : Gwei,
      getTotalActiveBalance z.state = .ok total →
      getBaseRewardPerIncrement preset total = .ok perIncrement →
      perIncrement.toNat * ((∑ j ∈ (getActiveValidatorIndices z.state
        (getPreviousEpoch z.state)).toFinset, effectiveAt z j.toNat) /
          preset.EFFECTIVE_BALANCE_INCREMENT.toNat) ≤
        P * (total.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat))
    (endEpoch : (getCurrentEpoch y.state).toNat ≤ high + 1)
    (incPos : 0 < preset.EFFECTIVE_BALANCE_INCREMENT.toNat)
    (depth Cr Cr' e0 C S W F q : ℕ)
    (hF : F = (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum)
    (hq : q = e0 / preset.EFFECTIVE_BALANCE_INCREMENT.toNat * P * F / WEIGHT_DENOMINATOR.toNat)
    (alignedE0 : e0 % preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0)
    (hC : C = preset.EFFECTIVE_BALANCE_INCREMENT.toNat *
      (11 * (Cr' + W + depth * q + depth) / (10 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat)))
    (epochs : (getCurrentEpoch y.state).toNat - (getCurrentEpoch x.state).toNat ≤ depth)
    (startBal : min (actualBalanceAt x i) lo ≤ S)
    (startEff : effectiveAt x i ≤ e0 + C)
    (junction : actualBalanceAt n i ≤ min (actualBalanceAt m i) lo +
      stepCredit (fun _ => true) (fun _ => true) i step)
    (keepEff : effectiveAt n i = effectiveAt m i)
    (credits : netScan i high pre + (creditScan (fun _ => false)
        (fun s => decide (s ≠ .rewards)) i high pre) +
      stepCredit (fun _ => true) (fun _ => true) i step + netScan i high post +
      (creditScan (fun _ => false) (fun s => decide (s ≠ .rewards)) i high post) ≤ Cr)
    (key : 11 * depth * (P * F) <
      WEIGHT_DENOMINATOR.toNat * preset.EFFECTIVE_BALANCE_INCREMENT.toNat)
    (start : S + Cr ≤ e0 + Cr' + W) :
    ∃ gc, gc = depth * (11 * (Cr' + W + depth * q + depth) /
        (10 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat) * P *
          (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum / WEIGHT_DENOMINATOR.toNat) ∧
      10 * gc ≤ Cr' + W + depth * q + depth ∧
      (∀ z ∈ pre.balancePath, min (actualBalanceAt z i) lo ≤ S + Cr +
        (gc + (depth * q + depth))) ∧
      (∀ z ∈ post.balancePath, min (actualBalanceAt z i) hi ≤ S + Cr +
        (gc + (depth * q + depth))) ∧
      effectiveAt y i ≤ e0 + C := by
  obtain ⟨alignedE, closed, splitAll, hform, hten⟩ := ceiling_arith incPos P depth Cr Cr' e0 C S W F
    q hF hq alignedE0 hC key start
  subst hF
  have epochStep := UInt64.le_iff_toNat_le.mp step.chainStep.currentEpoch_le
  have epochPre := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps pre.chainSteps)
  have epochPost := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps post.chainSteps)
  have forkM : m.fork < .glamsterdam := Nat.lt_of_le_of_lt
    (fork_le_of_chainSteps ((Run.nil.snoc step).append post).chainSteps) early
  have fuluN : .fusaka ≤ n.fork :=
    Nat.le_trans fulu (fork_le_of_chainSteps (pre.snoc step).chainSteps)
  have insideN : i < n.state.validators.data.size :=
    Nat.lt_of_lt_of_le inside (registryGrows_of_chainSteps (pre.snoc step).chainSteps)
  have split := splitAll ((getCurrentEpoch m.state).toNat - (getCurrentEpoch x.state).toNat +
    ((getCurrentEpoch y.state).toNat - (getCurrentEpoch n.state).toNat)) (by omega)
  rw [Nat.add_mul] at split
  have boundPre : PinKeyFloor.creditBound pre i high (e0 + C) P lo ≤
      S + Cr + (gainOn preset depth P C + (depth * q + depth)) := by
    unfold PinKeyFloor.creditBound
    omega
  have fixPre : max (effectiveAt x i) (min lo (PinKeyFloor.creditBound pre i high (e0 + C) P lo -
      PinKeyFloor.creditBound pre i high (e0 + C) P lo %
        preset.EFFECTIVE_BALANCE_INCREMENT.toNat)) ≤ e0 + C :=
    max_le startEff (Nat.le_trans (Nat.min_le_right _ _)
      (floor_le_of_lt incPos alignedE (Nat.lt_of_le_of_lt boundPre closed)))
  obtain ⟨-, -, thirdPre, fourthPre⟩ := PinKeyFloor.Run.effective_floor_pair pre
    forkM fulu i inside 0 0 lo high (e0 + C) P
  have balPre := fourthPre alignedLo startCap capsPre
    (fun z member => .inr (rate z (.inl member))) (by omega) fixPre
  obtain ⟨front, atLast⟩ := Run.balancePath_last pre
  have mPre : min (actualBalanceAt m i) lo ≤
      PinKeyFloor.creditBound pre i high (e0 + C) P lo :=
    balPre m (by rw [atLast]; simp)
  have effM : effectiveAt m i ≤ e0 + C := by
    refine Nat.le_trans (thirdPre _ alignedLo startCap balPre capsPre).1 ?_
    rw [Nat.min_comm]
    exact fixPre
  have effLo : effectiveAt m i ≤ lo := by
    have := (thirdPre _ alignedLo startCap balPre capsPre).1
    omega
  have boundPost : PinKeyFloor.creditBound post i high (e0 + C) P hi ≤
      S + Cr + (gainOn preset depth P C + (depth * q + depth)) := by
    unfold PinKeyFloor.creditBound at mPre ⊢
    omega
  have fixPost : max (effectiveAt n i) (min hi (PinKeyFloor.creditBound post i high (e0 + C) P hi -
      PinKeyFloor.creditBound post i high (e0 + C) P hi %
        preset.EFFECTIVE_BALANCE_INCREMENT.toNat)) ≤ e0 + C :=
    max_le (keepEff ▸ effM) (Nat.le_trans (Nat.min_le_right _ _)
      (floor_le_of_lt incPos alignedE (Nat.lt_of_le_of_lt boundPost closed)))
  obtain ⟨-, -, thirdPost, fourthPost⟩ := PinKeyFloor.Run.effective_floor_pair post early fuluN i
    insideN 0 0 hi high (e0 + C) P
  have balPost := fourthPost alignedHi (by omega) capsPost
    (fun z member => .inr (rate z (.inr member))) endEpoch fixPost
  refine ⟨gainOn preset depth P C, hform, hten,
    fun z member => Nat.le_trans (balPre z member) boundPre,
    fun z member => Nat.le_trans (balPost z member) boundPost, ?_⟩
  refine Nat.le_trans (thirdPost _ alignedHi (by omega) balPost capsPost).1 ?_
  rw [Nat.min_comm]
  exact fixPost

open DirectSafety.Apriori.Internal in
/-- The cap that `rise` reads: the key's own cap when its gain is low, else the largest. -/
private theorem capFor_eq (config : Config)
    (state ancestor finalizedState : BeaconState preset fork) (i : ℕ) :
    (pinTerms config state ancestor finalizedState).capFor i =
      if (decide ((pinTerms config state ancestor finalizedState).depthFin *
            ((11 * (pinTerms config state ancestor finalizedState).gainRate i + 9) / 10 + 3) <
            preset.EFFECTIVE_BALANCE_INCREMENT.toNat) &&
          decide (11 * (pinTerms config state ancestor finalizedState).depth *
              ((pinTerms config state ancestor finalizedState).gainRate i + 1) ≤
            (pinTerms config state ancestor finalizedState).ebUp i)) = true then
        PinTerms.capAt (⟨fork, state⟩ : ForkedBeaconState preset) i
      else preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat := rfl

/-- The cap that `rise` reads is at least the key's own cap. -/
private theorem capAt_le_capFor (config : Config)
    (state ancestor finalizedState : BeaconState preset fork) (i : ℕ)
    (capMax : PinTerms.capAt (⟨fork, state⟩ : ForkedBeaconState preset) i ≤
      preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat) :
    PinTerms.capAt (⟨fork, state⟩ : ForkedBeaconState preset) i ≤
      (pinTerms config state ancestor finalizedState).capFor i := by
  rw [capFor_eq]
  split
  · exact Nat.le_refl _
  · exact capMax

/-- The rise of a key on its kept arm is the least of its cap, its rounded top and its headroom.

The rounded top adds the downward band to `high`.

The headroom starts from the finalized balance.

The rise is that less the effective balance at R. -/
private theorem rise_kept (config : Config) (pulled anc fin : BeaconState preset fork) (i : ℕ)
    {H : ℕ} (hH : H = (pinTerms config pulled anc fin).high i)
    (kept : (pinTerms config pulled anc fin).keptArm i = true) :
    (pinTerms config pulled anc fin).rise i =
      min ((pinTerms config pulled anc fin).capFor i)
        (min (H + preset.downwardBand - (H + preset.downwardBand) %
              preset.EFFECTIVE_BALANCE_INCREMENT.toNat)
          (max (balanceAt fin i) (H - H % preset.EFFECTIVE_BALANCE_INCREMENT.toNat))) -
        balanceAt pulled i := by
  have unfold : (pinTerms config pulled anc fin).rise i =
      if (pinTerms config pulled anc fin).keptArm i = true then
        min ((pinTerms config pulled anc fin).capFor i)
          (min (H + preset.downwardBand - (H + preset.downwardBand) %
                preset.EFFECTIVE_BALANCE_INCREMENT.toNat)
            (max (balanceAt fin i) (H - H % preset.EFFECTIVE_BALANCE_INCREMENT.toNat))) -
          balanceAt pulled i
      else (pinTerms config pulled anc fin).capFor i - balanceAt pulled i := by
    rw [hH]
    rfl
  rw [unfold]
  split
  · rfl
  · exact absurd kept ‹_›

/-- A key on its kept arm has an effective balance within its rise, the flows and their slack.

The key's effective balance stays at that of R, ends at its start, or is within the ceiling.

The ceiling is within `high` and the flows, and the slack is paid when there are flows.

It starts from any state: `start` bounds the effective balance there.

A key that ends at its start has `start` within the cap and within the rounded top of `H`. -/
private theorem rise_close (config : Config) (pulled anc fin : BeaconState preset fork) (i : ℕ)
    {H : ℕ} (hH : H = (pinTerms config pulled anc fin).high i)
    (incPos : 0 < preset.EFFECTIVE_BALANCE_INCREMENT.toNat)
    (kept : (pinTerms config pulled anc fin).keptArm i = true)
    {eC Bc S U start capHigh : ℕ}
    (alignedC : eC % preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0)
    (startLe : start ≤ max (balanceAt fin i)
      ((H + S) - (H + S) % preset.EFFECTIVE_BALANCE_INCREMENT.toNat))
    (stay : eC = balanceAt pulled i ∨
      (eC ≤ start ∧ start ≤ (pinTerms config pulled anc fin).capFor i + S + U ∧
        start ≤ (H + preset.downwardBand) -
          (H + preset.downwardBand) % preset.EFFECTIVE_BALANCE_INCREMENT.toNat + S + U) ∨
      (eC ≤ Bc + preset.downwardBand ∧
        eC ≤ max start (min (Bc - Bc % preset.EFFECTIVE_BALANCE_INCREMENT.toNat) capHigh)))
    (capped : eC ≤ (pinTerms config pulled anc fin).capFor i + S + U)
    (ceiling : Bc ≤ H + S)
    (slack : S = 0 ∨ preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤ U + 1 ∨
      (S < preset.EFFECTIVE_BALANCE_INCREMENT.toNat ∧
        preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤ S + U)) :
    eC ≤ balanceAt pulled i + (pinTerms config pulled anc fin).rise i + S + U := by
  rw [rise_kept config pulled anc fin i hH kept]
  have arith := rise_arith (finEB := max (balanceAt fin i)
      (H - H % preset.EFFECTIVE_BALANCE_INCREMENT.toNat))
    (capFor := (pinTerms config pulled anc fin).capFor i) incPos
    stay (Nat.le_trans startLe (max_le_max (Nat.le_max_left _ _) (Nat.le_refl _))) alignedC
    capped ceiling slack
  rwa [max_assoc, max_self] at arith

/-- The bound `ebUp` on a key's effective balance is its largest balance or its rounded top.

The top adds the leak at the cap, the net partials and a band to the balance at R.

It reads the partials through `dueAmount`. -/
private theorem ebUp_eq (config : Config) (pulled anc fin : BeaconState preset fork)
    (electra : .pectra ≤ fork) (i t : ℕ)
    (ht : t = actualBalanceAt (⟨fork, pulled⟩ : ForkedBeaconState preset) i +
      ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) *
        (pinTerms config pulled anc fin).leakAt
          (PinTerms.capAt (⟨fork, pulled⟩ : ForkedBeaconState preset) i) i +
      (PinTerms.dueAmount fin electra i ((getCurrentEpoch pulled).toNat + 1) -
        PinTerms.dueAmount pulled electra i ((getCurrentEpoch pulled).toNat + 1)) +
      preset.downwardBand + preset.EFFECTIVE_BALANCE_INCREMENT.toNat - 1) :
    (pinTerms config pulled anc fin).ebUp i =
      max (max (balanceAt pulled i) (balanceAt fin i))
        (min (PinTerms.capAt (⟨fork, pulled⟩ : ForkedBeaconState preset) i)
          (t - t % preset.EFFECTIVE_BALANCE_INCREMENT.toNat)) := by
  subst ht
  simp only [pinTerms, PinTerms.dueAmount, electra, ↓reduceDIte]
  rfl

/-- The least and the greatest of two whole numbers of increments are such numbers too. -/
private theorem min_max_aligned {inc a b : ℕ} (ha : a % inc = 0) (hb : b % inc = 0) :
    min a b % inc = 0 ∧ max a b % inc = 0 :=
  ⟨by rcases min_choice a b with e | e <;> rw [e] <;> assumption,
    by rcases max_choice a b with e | e <;> rw [e] <;> assumption⟩

/-- A number rounded down to an increment is a whole number of increments. -/
private theorem round_aligned (inc x : ℕ) : (x - x % inc) % inc = 0 :=
  Nat.sub_mod_eq_zero_of_mod_eq (Nat.mod_mod _ _).symm

/-- The effective balances of a key at R and at the finalized state are aligned. -/
private theorem balances_aligned (h : Setting config checks g split fin pulled anc counted V)
    (i : ℕ) : balanceAt pulled i % preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0 ∧
      balanceAt fin i % preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0 := by
  obtain ⟨shared⟩ := h.toFin
  obtain ⟨fromFin⟩ := h.fromFin
  obtain ⟨toPulled⟩ := h.toPulled
  exact ⟨DirectSafety.Apriori.Internal.FloorTrace.effective_aligned
    (shared.append (fromFin.append toPulled)) h.genesis h.aligned i,
    DirectSafety.Apriori.Internal.FloorTrace.effective_aligned shared h.genesis h.aligned i⟩

/-- The aligned effective balances make the bound `ebUp` of a key a whole number of increments. -/
private theorem ebUp_aligned (h : Setting config checks g split fin pulled anc counted V) (i : ℕ) :
    (pinTerms config pulled anc fin).ebUp i % preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0 := by
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  obtain ⟨a1, a2⟩ := balances_aligned h i
  obtain ⟨t, ht⟩ : ∃ t, (pinTerms config pulled anc fin).ebUp i =
      max (max (balanceAt pulled i) (balanceAt fin i))
        (min (PinTerms.capAt (⟨fork, pulled⟩ : ForkedBeaconState preset) i)
          (t - t % preset.EFFECTIVE_BALANCE_INCREMENT.toNat)) :=
    ⟨_, ebUp_eq config pulled anc fin electra i _ rfl⟩
  have capAligned : PinTerms.capAt (⟨fork, pulled⟩ : ForkedBeaconState preset) i %
      preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0 := by
    cases found : pulled.validators.data[i]? with
    | none => simp [PinTerms.capAt, found]
    | some w =>
      exact capAt_aligned h.aligned (z := (⟨fork, pulled⟩ : ForkedBeaconState preset)) electra found
  rw [ht]
  exact (min_max_aligned (min_max_aligned a1 a2).2
    (min_max_aligned capAligned (round_aligned _ t)).1).2

/-- A call's cutoff is within the withdrawal delay of the finalized state. -/
private theorem window_short (h : Setting config checks g split fin pulled anc counted V) :
    (getCurrentEpoch pulled).toNat + 1 <
      (getCurrentEpoch fin).toNat + config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat := by
  have shallow := h.shallow
  omega

/-- The due amounts of a key are those of the entries that name it and are due, in two filters. -/
private theorem dueAmount_eq (state : BeaconState preset fork) (electra : .pectra ≤ fork)
    (v : ValidatorIndex) (cutoff : ℕ) :
    PinTerms.dueAmount state electra v.toNat cutoff =
      ((((state.pendingPartialWithdrawals electra).data.toList.filter
        fun entry => decide (entry.validatorIndex = v)).filter
          (fun entry => entry.withdrawableEpoch.toNat ≤ cutoff)).map (·.amount.toNat)).sum := by
  unfold PinTerms.dueAmount
  simp only [List.filter_filter]
  congr 3
  funext entry
  simp [Bool.decide_and, UInt64.toNat_inj, Bool.and_comm]

/-- The leak of the pin does not fall as the effective balance rises. -/
private theorem leakAt_mono (config : Config) (pulled anc fin : BeaconState preset fork) {a b : ℕ}
    (i : ℕ) (le : a ≤ b) :
    (pinTerms config pulled anc fin).leakAt a i ≤ (pinTerms config pulled anc fin).leakAt b i := by
  unfold pinTerms
  dsimp only
  exact Nat.add_le_add (Nat.mul_le_mul_left _ (Nat.mul_le_mul_right _ (Nat.div_le_div_right le)))
    (Nat.div_le_div_right (Nat.mul_le_mul_right _ le))

/-- The leak of the pin at the finalized state's score, spelled out.

The score is the key's inactivity score at the finalized state, or zero before Altair. -/
private theorem leakAt_eq (config : Config) (pulled anc fin : BeaconState preset fork)
    (eb i : ℕ) :
    (pinTerms config pulled anc fin).leakAt eb i =
      2 * (eb / preset.EFFECTIVE_BALANCE_INCREMENT.toNat *
        (pinTerms config pulled anc fin).perIncrement) +
      eb * ((if altair : .altair ≤ fork then
          (((fin.inactivityScores altair).data[i]?).map (·.toNat)).getD 0 else 0) +
        (pinTerms config pulled anc fin).depthFin * config.INACTIVITY_SCORE_BIAS.toNat) /
        (config.INACTIVITY_SCORE_BIAS.toNat *
          (parameters preset fork).INACTIVITY_PENALTY_QUOTIENT.toNat) := by
  unfold pinTerms
  rfl

/-- A key's inactivity score at the finalized state is at most the largest score there. -/
private theorem score_le_scoreMax (fin : BeaconState preset fork) (i : ℕ) :
    (if altair : .altair ≤ fork then
        (((fin.inactivityScores altair).data[i]?).map (·.toNat)).getD 0 else 0) ≤
      (if altair : .altair ≤ fork then
        ((fin.inactivityScores altair).data.toList.map (·.toNat)).foldl max 0 else 0) := by
  split
  · rename_i altair
    cases found : (fin.inactivityScores altair).data[i]? with
    | none => simp
    | some x =>
      have mem : x.toNat ∈ (fin.inactivityScores altair).data.toList.map (·.toNat) :=
        List.mem_map_of_mem (Array.mem_toList_iff.mpr (Array.mem_of_getElem? found))
      rw [List.foldl_max_eq_max (List.ne_nil_of_mem mem)]
      exact le_max_of_le_right (List.le_max_of_mem mem)
  · exact Nat.le_refl _

/-- Raising the balance by whole increments raises the leak by an amount in those increments.

The amount is the leak of the increments at the key's per-increment reward and the largest score.

It is rounded up once. -/
private theorem leakAt_add_le (config : Config) (pulled anc fin : BeaconState preset fork)
    (incPos : 0 < preset.EFFECTIVE_BALANCE_INCREMENT.toNat) (i eb m : ℕ) :
    (pinTerms config pulled anc fin).leakAt (eb + preset.EFFECTIVE_BALANCE_INCREMENT.toNat * m) i ≤
      (pinTerms config pulled anc fin).leakAt eb i +
        2 * ((pinTerms config pulled anc fin).perIncrement * m) +
        (preset.EFFECTIVE_BALANCE_INCREMENT.toNat * m *
          ((pinTerms config pulled anc fin).scoreMaxFin +
            (pinTerms config pulled anc fin).depthFin * config.INACTIVITY_SCORE_BIAS.toNat) /
          (config.INACTIVITY_SCORE_BIAS.toNat *
            (parameters preset fork).INACTIVITY_PENALTY_QUOTIENT.toNat) + 1) := by
  have scoreMax : (pinTerms config pulled anc fin).scoreMaxFin = (if altair : .altair ≤ fork then
      ((fin.inactivityScores altair).data.toList.map (·.toNat)).foldl max 0 else 0) := by
    unfold pinTerms
    rfl
  rw [leakAt_eq, leakAt_eq, scoreMax]
  have score := score_le_scoreMax fin i
  generalize (if altair : .altair ≤ fork then
    (((fin.inactivityScores altair).data[i]?).map (·.toNat)).getD 0 else 0) = S at score ⊢
  generalize (if altair : .altair ≤ fork then
    ((fin.inactivityScores altair).data.toList.map (·.toNat)).foldl max 0 else 0) = M at score ⊢
  generalize (pinTerms config pulled anc fin).perIncrement = P
  generalize (pinTerms config pulled anc fin).depthFin * config.INACTIVITY_SCORE_BIAS.toNat = B
  generalize config.INACTIVITY_SCORE_BIAS.toNat *
    (parameters preset fork).INACTIVITY_PENALTY_QUOTIENT.toNat = Q
  generalize preset.EFFECTIVE_BALANCE_INCREMENT.toNat = inc at incPos ⊢
  have quotient : (eb + inc * m) / inc = eb / inc + m := by
    rw [Nat.add_mul_div_left _ _ incPos]
  have rounded : (eb + inc * m) * (S + B) / Q ≤ eb * (S + B) / Q + inc * m * (S + B) / Q + 1 := by
    rw [Nat.add_mul]
    exact Nat.add_div_le_div_add_div_add_one _ _ _
  have larger : inc * m * (S + B) / Q ≤ inc * m * (M + B) / Q :=
    Nat.div_le_div_right (Nat.mul_le_mul_left _ (Nat.add_le_add_right score _))
  have step : 2 * ((eb / inc + m) * P) = 2 * (eb / inc * P) + 2 * (P * m) := by ring
  rw [quotient, step]
  generalize eb / inc * P = x at *
  generalize (eb + inc * m) * (S + B) / Q = u at *
  generalize eb * (S + B) / Q = v at *
  generalize inc * m * (S + B) / Q = w at *
  generalize inc * m * (M + B) / Q = z at *
  omega

/-- The leak that a rise above `ebUp` by `a` increments of debits and `s` of a penalty induces.

The debits cost the leak of their increments at the key's reward, and the penalty one increment.

A debited key pays one more for the rounding, which the reward of an increment covers. -/
private theorem inducedR_le (config : Config) (pulled anc fin : BeaconState preset fork)
    (incPos : 0 < preset.EFFECTIVE_BALANCE_INCREMENT.toNat)
    (perPos : 1 ≤ (pinTerms config pulled anc fin).perIncrement)
    {x y : ForkedBeaconState preset} (tail : Run config checks x y) (i a s : ℕ) (slack : s ≤ 1)
    (envelope : ∀ z ∈ tail.balancePath, effectiveAt z i ≤
      (pinTerms config pulled anc fin).ebUp i +
        preset.EFFECTIVE_BALANCE_INCREMENT.toNat * (a + s)) :
    inducedR (pinTerms config pulled anc fin) tail i ≤
      (pinTerms config pulled anc fin).depthFin *
          (3 * (pinTerms config pulled anc fin).perIncrement * a +
            preset.EFFECTIVE_BALANCE_INCREMENT.toNat * a *
              ((pinTerms config pulled anc fin).scoreMaxFin +
                (pinTerms config pulled anc fin).depthFin * config.INACTIVITY_SCORE_BIAS.toNat) /
              (config.INACTIVITY_SCORE_BIAS.toNat *
                (parameters preset fork).INACTIVITY_PENALTY_QUOTIENT.toNat)) +
        s * (pinTerms config pulled anc fin).slashLeak := by
  have fold : ∀ (l : List ℕ) (b c : ℕ), b ≤ c → (∀ x ∈ l, x ≤ c) → l.foldl max b ≤ c := by
    intro l
    induction l with
    | nil => exact fun _ _ le _ => le
    | cons x xs ih =>
      exact fun b c le all => ih _ c (max_le le (all x List.mem_cons_self))
        fun y m => all y (List.mem_cons_of_mem _ m)
  have mono := leakAt_mono config pulled anc fin i (fold _ 0 _ (Nat.zero_le _) fun v member => by
    obtain ⟨z, inPath, rfl⟩ := List.mem_map.mp member
    exact envelope z inPath)
  have first := leakAt_add_le config pulled anc fin incPos i
    ((pinTerms config pulled anc fin).ebUp i) a
  have second := leakAt_add_le config pulled anc fin incPos i
    ((pinTerms config pulled anc fin).ebUp i + preset.EFFECTIVE_BALANCE_INCREMENT.toNat * a) s
  have rate : (pinTerms config pulled anc fin).perIncrement * a ≥ 1 ∨ a = 0 := by
    rcases Nat.eq_zero_or_pos a with zero | pos
    · exact .inr zero
    · exact .inl (Nat.mul_pos perPos pos)
  rw [Nat.mul_add, ← Nat.add_assoc] at mono
  by_cases withdrawn : (pinTerms config pulled anc fin).withdrawnRB i = true
  · rw [inducedR_of_withdrawn _ tail i withdrawn]
    exact Nat.zero_le _
  rw [inducedR_of_not_withdrawn _ tail i (by simpa using withdrawn)]
  have leakEq : (pinTerms config pulled anc fin).slashLeak =
      (pinTerms config pulled anc fin).depthFin *
        (2 * (pinTerms config pulled anc fin).perIncrement +
          preset.EFFECTIVE_BALANCE_INCREMENT.toNat *
              ((pinTerms config pulled anc fin).scoreMaxFin +
                (pinTerms config pulled anc fin).depthFin * config.INACTIVITY_SCORE_BIAS.toNat) /
            (config.INACTIVITY_SCORE_BIAS.toNat *
              (parameters preset fork).INACTIVITY_PENALTY_QUOTIENT.toNat) + 1) := rfl
  rw [leakEq, Nat.mul_left_comm s, ← Nat.mul_add]
  refine Nat.mul_le_mul_left _ ?_
  have three : 3 * (pinTerms config pulled anc fin).perIncrement * a =
      3 * ((pinTerms config pulled anc fin).perIncrement * a) := by ring
  have n1 := Nat.zero_le (preset.EFFECTIVE_BALANCE_INCREMENT.toNat * a *
    ((pinTerms config pulled anc fin).scoreMaxFin +
      (pinTerms config pulled anc fin).depthFin * config.INACTIVITY_SCORE_BIAS.toNat) /
    (config.INACTIVITY_SCORE_BIAS.toNat *
      (parameters preset fork).INACTIVITY_PENALTY_QUOTIENT.toNat))
  have n2 := Nat.zero_le (preset.EFFECTIVE_BALANCE_INCREMENT.toNat *
    ((pinTerms config pulled anc fin).scoreMaxFin +
      (pinTerms config pulled anc fin).depthFin * config.INACTIVITY_SCORE_BIAS.toNat) /
    (config.INACTIVITY_SCORE_BIAS.toNat *
      (parameters preset fork).INACTIVITY_PENALTY_QUOTIENT.toNat))
  rcases Nat.le_one_iff_eq_zero_or_eq_one.mp slack with rfl | rfl <;>
    rcases rate with rate | rfl <;>
    simp only [Nat.add_zero, Nat.zero_add, Nat.mul_zero, Nat.zero_mul, Nat.mul_one, Nat.one_mul,
      Nat.zero_div] at mono first second three n1 ⊢ <;>
    omega

/-- A key's cap does not fall along a run. -/
private theorem cap_le_cap_of_run (caps : CapOrder preset) {z y : ForkedBeaconState preset}
    (post : Run config checks z y) (early : y.fork < .glamsterdam) (i : ℕ) :
    PinTerms.capAt z i ≤ PinTerms.capAt y i := by
  unfold PinTerms.capAt
  cases found : z.state.validators.data[i]? with
  | none => simp
  | some w =>
    obtain ⟨w', found', mono⟩ := post.validatorCap_mono caps.activation caps.compounding early i
      w found
    simp only [found', Option.map_some, Option.getD_some]
    exact UInt64.le_iff_toNat_le.mp mono

/-- A key's effective balance at the end of a run from genesis is at most its cap there.

The cap is the one at that state. -/
private theorem effective_le_cap_at {g z : ForkedBeaconState preset}
    (shared : Run config checks g z)
    (genesis : Genesis (config := config) (checks := checks) g) (caps : CapOrder preset)
    (early : z.fork < .glamsterdam) (i : ℕ) : effectiveAt z i ≤ PinTerms.capAt z i := by
  cases found : z.state.validators.data[i]? with
  | none => simp [effectiveAt, found]
  | some w =>
    have capped := DirectSafety.Apriori.Internal.effectiveAt_le_withdrawalMax shared genesis caps
      early found
    simpa [PinTerms.capAt, found] using capped

/-- On R's branch a key's effective balance is at most its cap at R. -/
private theorem effective_le_cap_pulled (h : Setting config checks g split fin pulled anc counted V)
    {z : BeaconState preset fork} (toZ : Run config checks ⟨fork, fin⟩ ⟨fork, z⟩)
    (post : Run config checks ⟨fork, z⟩ ⟨fork, pulled⟩) (i : ℕ) :
    effectiveAt (⟨fork, z⟩ : ForkedBeaconState preset) i ≤
      PinTerms.capAt (⟨fork, pulled⟩ : ForkedBeaconState preset) i := by
  obtain ⟨shared⟩ := h.toFin
  exact Nat.le_trans (effective_le_cap_at (shared.append toZ) h.genesis h.caps h.early i)
    (cap_le_cap_of_run h.caps post h.early i)

/-- Each state of the balance path of a run on the way to R has an effective balance within R's cap.

The run starts at a state that the finalized block's state reaches, and R follows its end. -/
private theorem path_le_cap_pulled (h : Setting config checks g split fin pulled anc counted V)
    {zs : BeaconState preset fork} {m : ForkedBeaconState preset}
    (toZ : Run config checks ⟨fork, fin⟩ ⟨fork, zs⟩) (rp : Run config checks ⟨fork, zs⟩ m)
    (rest : Run config checks m ⟨fork, pulled⟩) (i : ℕ) :
    ∀ z ∈ rp.balancePath,
      effectiveAt z i ≤ PinTerms.capAt (⟨fork, pulled⟩ : ForkedBeaconState preset) i := by
  intro z member
  obtain ⟨q1, q2, -⟩ := balancePath_endpoint rp rest (Nat.le_refl _) member
  obtain ⟨zf, zs'⟩ := z
  have same : fork = zf := (fork_eq_of_run q1 q2 (Nat.le_refl _)).symm
  subst same
  exact effective_le_cap_pulled h (toZ.append q1) q2 i

/-- A state of the balance path of a run between two states of one fork is a state of that fork.

It is the end of a run from the start and the start of a run to the end. -/
private theorem balancePath_state {a b : BeaconState preset fork}
    (r : Run config checks ⟨fork, a⟩ ⟨fork, b⟩) {z : ForkedBeaconState preset}
    (member : z ∈ r.balancePath) :
    ∃ zs : BeaconState preset fork, z = ⟨fork, zs⟩ ∧
      Nonempty (Run config checks ⟨fork, a⟩ ⟨fork, zs⟩) ∧
      Nonempty (Run config checks ⟨fork, zs⟩ ⟨fork, b⟩) := by
  obtain ⟨r1, r2, -⟩ := balancePath_endpoint r
    (Run.nil : Run config checks ⟨fork, b⟩ ⟨fork, b⟩) (Nat.le_refl _) member
  obtain ⟨zf, zs⟩ := z
  have same : fork = zf := (fork_eq_of_run r1 r2 (Nat.le_refl _)).symm
  subst same
  exact ⟨zs, rfl, ⟨r1⟩, ⟨r2⟩⟩

/-- The cap of a key in the registry is the activation balance, or the largest balance.

Both are a whole number of increments, and the cap is too. -/
private theorem capAt_kind (h : Setting config checks g split fin pulled anc counted V)
    {z : BeaconState preset fork} (i : ℕ) (within : i < z.validators.data.size) :
    (PinTerms.capAt (⟨fork, z⟩ : ForkedBeaconState preset) i =
        preset.MIN_ACTIVATION_BALANCE.toNat ∨
      PinTerms.capAt (⟨fork, z⟩ : ForkedBeaconState preset) i =
        preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat) ∧
    preset.MIN_ACTIVATION_BALANCE.toNat % preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0 ∧
    preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat % preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0 := by
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  obtain ⟨w, found⟩ : ∃ w, z.validators.data[i]? = some w :=
    ⟨_, Array.getElem?_eq_getElem within⟩
  obtain ⟨aMin, aMax⟩ := cap_values_aligned h.aligned
  refine ⟨?_, aMin, aMax⟩
  rw [capAt_of_found (z := (⟨fork, z⟩ : ForkedBeaconState preset)) electra found]
  split
  · exact .inr rfl
  · exact .inl rfl

/-- The states of the parts of a run cut at a step are states of the run. -/
private theorem flip_path_mem {x m n y : ForkedBeaconState preset} (pre : Run config checks x m)
    (step : Step config checks m n) (post : Run config checks n y)
    {tail : Run config checks x y} (cut : (pre.snoc step).append post = tail) :
    (∀ z ∈ pre.balancePath, z ∈ tail.balancePath) ∧
      ∀ z ∈ post.balancePath, z ∈ tail.balancePath := by
  have path := Run.balancePath_append (pre.snoc step) post
  rw [cut] at path
  obtain ⟨restPost, headPost⟩ := Run.balancePath_head post
  refine ⟨fun z member => by rw [path]; simp [Run.balancePath, member], fun z member => ?_⟩
  rw [headPost] at member
  rw [path]
  rcases List.mem_cons.mp member with rfl | inRest
  · simp [Run.balancePath, List.mem_of_mem_getLast? (Step.balancePath_ends step).2]
  · simp [headPost, inRest]

/-- A state of a run cut at a block step is a state of one of the parts. -/
private theorem flip_path_cover {x m n y : ForkedBeaconState preset} (pre : Run config checks x m)
    (step : Step config checks m n) (post : Run config checks n y)
    (notSlot : ∀ ok, step ≠ Step.slot ok) {tail : Run config checks x y}
    (cut : (pre.snoc step).append post = tail) :
    ∀ z ∈ tail.balancePath, z ∈ pre.balancePath ∨ z ∈ post.balancePath := by
  have path := Run.balancePath_append (pre.snoc step) post
  rw [cut] at path
  have block : step.balancePath = [m, n] := by
    cases step with
    | slot ok => exact absurd rfl (notSlot ok)
    | block => rfl
  obtain ⟨front, atLast⟩ := Run.balancePath_last pre
  obtain ⟨restPost, headPost⟩ := Run.balancePath_head post
  intro z member
  rw [path] at member
  simp only [Run.balancePath, block, headPost, List.mem_append, List.mem_cons,
    List.not_mem_nil, or_false, List.tail_cons] at member
  rcases member with (inPre | rfl | rfl) | inRest
  · exact .inl inPre
  · exact .inl (by rw [atLast]; simp)
  · exact .inr (by rw [headPost]; exact List.mem_cons_self)
  · exact .inr (by rw [headPost]; exact List.mem_cons_of_mem _ inRest)

/-- The effective balance of a key along a run is bounded by its capped balance.

The cap of the key may rise once, at a step that makes it compound.

The cap of a key in the registry is the activation balance, or the largest balance if it compounds.

The balance counts up to the cap, so a ceiling on it holds before and after the rise. -/
private theorem effective_ceiling_flip (h : Setting config checks g split fin pulled anc counted V)
    {x y : BeaconState preset fork} (tail : Run config checks ⟨fork, x⟩ ⟨fork, y⟩)
    (invariant : Invariant x) (i : ℕ) (inside : i < x.validators.data.size)
    (ceil capHigh : ℕ)
    (capped : ∀ z ∈ tail.balancePath, effectiveAt z i ≤ PinTerms.capAt z i)
    (capCeil : ∀ z ∈ tail.balancePath, PinTerms.capAt z i ≤ capHigh)
    (balanceCeil : ∀ z ∈ tail.balancePath,
      min (actualBalanceAt z i) (PinTerms.capAt z i) ≤ ceil) :
    effectiveAt (⟨fork, y⟩ : ForkedBeaconState preset) i ≤
        max (effectiveAt (⟨fork, x⟩ : ForkedBeaconState preset) i)
          (min (ceil - ceil % preset.EFFECTIVE_BALANCE_INCREMENT.toNat) capHigh) ∧
      ((getCurrentEpoch y).toNat ≤ (getCurrentEpoch x).toNat →
        effectiveAt (⟨fork, y⟩ : ForkedBeaconState preset) i =
          effectiveAt (⟨fork, x⟩ : ForkedBeaconState preset) i) ∧
      ((getCurrentEpoch x).toNat < (getCurrentEpoch y).toNat →
        effectiveAt (⟨fork, y⟩ : ForkedBeaconState preset) i ≤ ceil + preset.downwardBand) ∧
      (getCurrentEpoch x).toNat ≤ (getCurrentEpoch y).toNat := by
  have capOrder := h.caps
  have minMax := UInt64.le_iff_toNat_le.mp capOrder.compounding
  obtain ⟨-, alignedMin, alignedMax⟩ := capAt_kind h i inside
  -- a run of constant cap `c0`, below `capHigh`, is the constant-cap case
  have seg : ∀ {a b : BeaconState preset fork}
      (r : Run config checks ⟨fork, a⟩ ⟨fork, b⟩) (c0 : ℕ),
      c0 % preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0 → c0 ≤ capHigh →
      i < a.validators.data.size →
      effectiveAt (⟨fork, a⟩ : ForkedBeaconState preset) i ≤ c0 →
      (∀ z ∈ r.balancePath, PinTerms.capAt z i = c0) →
      (∀ z ∈ r.balancePath, min (actualBalanceAt z i) (PinTerms.capAt z i) ≤ ceil) →
      effectiveAt (⟨fork, b⟩ : ForkedBeaconState preset) i ≤
          max (effectiveAt (⟨fork, a⟩ : ForkedBeaconState preset) i)
            (min (ceil - ceil % preset.EFFECTIVE_BALANCE_INCREMENT.toNat) capHigh) ∧
        ((getCurrentEpoch b).toNat ≤ (getCurrentEpoch a).toNat →
          effectiveAt (⟨fork, b⟩ : ForkedBeaconState preset) i =
            effectiveAt (⟨fork, a⟩ : ForkedBeaconState preset) i) ∧
        ((getCurrentEpoch a).toNat < (getCurrentEpoch b).toNat →
          effectiveAt (⟨fork, b⟩ : ForkedBeaconState preset) i ≤ ceil + preset.downwardBand) ∧
        (getCurrentEpoch a).toNat ≤ (getCurrentEpoch b).toNat := by
    intro a b r c0 aligned le insideA start cap bal
    obtain ⟨p1, p2, p3, p4⟩ := PinKeyFloor.Run.effective_ceiling_of_balance_ceiling r h.early h.fulu
      i insideA ceil c0 aligned start
      (fun z member => by rw [← cap z member]; exact bal z member)
      (fun z member => (cap z member).le)
    exact ⟨le_trans p1 (max_le_max le_rfl (min_le_min le_rfl le)), p2, p3, p4⟩
  -- the cap of a key in the registry is one of two values
  have kind := fun (z : BeaconState preset fork) (within : i < z.validators.data.size) =>
    (capAt_kind h i within).1
  obtain ⟨rest, atHead⟩ := Run.balancePath_head tail
  have headMem : (⟨fork, x⟩ : ForkedBeaconState preset) ∈ tail.balancePath := by
    rw [atHead]
    exact List.mem_cons_self
  obtain ⟨last, atLast⟩ := Run.balancePath_last tail
  have lastMem : (⟨fork, y⟩ : ForkedBeaconState preset) ∈ tail.balancePath := by
    rw [atLast]
    simp
  -- a run that ends with the activation cap has the activation cap throughout
  have lowRun : ∀ {a b : BeaconState preset fork} (r : Run config checks ⟨fork, a⟩ ⟨fork, b⟩),
      i < a.validators.data.size →
      PinTerms.capAt (⟨fork, b⟩ : ForkedBeaconState preset) i ≤
        preset.MIN_ACTIVATION_BALANCE.toNat →
      ∀ z ∈ r.balancePath,
        PinTerms.capAt z i = preset.MIN_ACTIVATION_BALANCE.toNat :=
    fun r within atEnd z member => by
      obtain ⟨zs, rfl, ⟨r1⟩, ⟨r2⟩⟩ := balancePath_state r member
      have hi := cap_le_cap_of_run h.caps r2 h.early i
      rcases kind zs (Nat.lt_of_lt_of_le within (registryGrows_of_chainSteps r1.chainSteps)) with
        low | high
      · exact low
      · omega
  -- a run that starts above the activation cap has the largest cap throughout
  have highRun : ∀ {a b : BeaconState preset fork} (r : Run config checks ⟨fork, a⟩ ⟨fork, b⟩),
      i < a.validators.data.size →
      preset.MIN_ACTIVATION_BALANCE.toNat <
        PinTerms.capAt (⟨fork, a⟩ : ForkedBeaconState preset) i →
      ∀ z ∈ r.balancePath,
        PinTerms.capAt z i = preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat :=
    fun r within atStart z member => by
      obtain ⟨zs, rfl, ⟨r1⟩, ⟨r2⟩⟩ := balancePath_state r member
      have lo := cap_le_cap_of_run h.caps r1 h.early i
      rcases kind zs (Nat.lt_of_lt_of_le within (registryGrows_of_chainSteps r1.chainSteps)) with
        low | high
      · omega
      · exact high
  by_cases compoundsEnd : preset.MIN_ACTIVATION_BALANCE.toNat <
      PinTerms.capAt (⟨fork, y⟩ : ForkedBeaconState preset) i
  · by_cases compoundsStart : preset.MIN_ACTIVATION_BALANCE.toNat <
        PinTerms.capAt (⟨fork, x⟩ : ForkedBeaconState preset) i
    · -- the cap is the largest balance along the whole run
      have all := highRun tail inside compoundsStart
      have atX := all _ headMem
      exact seg tail _ alignedMax (by have := capCeil _ headMem; omega) inside
        (by have := capped _ headMem; omega) all balanceCeil
    · -- the cap is the activation balance until the step that makes the key compound
      obtain ⟨m, n, pre, step, post, cut, flatM, largeN, -, sameEpoch⟩ :=
        Run.flip_split tail h.early h.fulu invariant i
          (by omega) compoundsEnd
      obtain ⟨mf, ms⟩ := m
      obtain ⟨nf, ns⟩ := n
      have sameM : fork = mf :=
        (fork_eq_of_run pre ((Run.nil.snoc step).append post) (Nat.le_refl _)).symm
      have sameN : fork = nf := (fork_eq_of_run (pre.snoc step) post (Nat.le_refl _)).symm
      subst sameM sameN
      have insideM : i < ms.validators.data.size :=
        Nat.lt_of_lt_of_le inside (registryGrows_of_chainSteps pre.chainSteps)
      have insideN : i < ns.validators.data.size :=
        Nat.lt_of_lt_of_le inside (registryGrows_of_chainSteps (pre.snoc step).chainSteps)
      obtain ⟨preMem, postMem⟩ := flip_path_mem pre step post cut
      obtain ⟨restPost, headPost⟩ := Run.balancePath_head post
      have nMem := postMem (⟨fork, ns⟩ : ForkedBeaconState preset)
        (by rw [headPost]; exact List.mem_cons_self)
      have capsPre := lowRun pre inside flatM
      have capsPost := highRun post insideN largeN
      have atX := kind x inside
      have atY := kind y (Nat.lt_of_lt_of_le inside (registryGrows_of_chainSteps tail.chainSteps))
      have capX := capCeil _ headMem
      have capY := capCeil _ lastMem
      have effX := capped _ headMem
      have effN := capped _ nMem
      have capN := capsPost _ (by
        rw [headPost]
        exact List.mem_cons_self)
      have first := seg pre _ alignedMin (by omega) inside (by omega) capsPre
        (fun z member => balanceCeil z (preMem z member))
      have second := seg post _ alignedMax (by omega) insideN (by omega) capsPost
        (fun z member => balanceCeil z (postMem z member))
      have epochN : getCurrentEpoch ns = getCurrentEpoch ms :=
        UInt64.toNat_inj.mp (sameEpoch inside)
      have keep := step_same_epoch_effective step (Nat.lt_of_le_of_lt
        (fork_le_of_chainSteps post.chainSteps) h.early) epochN i insideM
      have epochs : (getCurrentEpoch ns).toNat = (getCurrentEpoch ms).toNat := sameEpoch inside
      obtain ⟨f1, f2, f3, f4⟩ := first
      obtain ⟨s1, s2, s3, s4⟩ := second
      refine ⟨by omega, fun back => ?_, fun before => ?_, by omega⟩
      · have e1 := f2 (by omega)
        have e2 := s2 (by omega)
        omega
      · by_cases later : (getCurrentEpoch ns).toNat < (getCurrentEpoch y).toNat
        · exact s3 later
        · have e1 := f3 (by omega)
          have e2 := s2 (by omega)
          omega
  · -- the cap is the activation balance along the whole run
    have all := lowRun tail inside (Nat.le_of_not_lt compoundsEnd)
    have atX := all _ headMem
    exact seg tail _ alignedMin (by have := capCeil _ headMem; omega) inside
      (by have := capped _ headMem; omega) all balanceCeil

/-- The cap along the balance path of a run is at most the cap at its end. -/
private theorem capCeil_path {c e : ForkedBeaconState preset} (tail : Run config checks c e)
    (caps : CapOrder preset) (early : e.fork < .glamsterdam) (back : e.fork ≤ c.fork) (i : ℕ) :
    ∀ z ∈ tail.balancePath, PinTerms.capAt z i ≤ PinTerms.capAt e i := by
  intro z member
  obtain ⟨-, r2, -⟩ := balancePath_endpoint tail (Run.nil : Run config checks e e) back member
  exact cap_le_cap_of_run caps r2 early i

/-- The effective balance of a key is at most its cap at each state of a run from a state `c`.

The run from the finalized state reaches `c` first, and `c` holds the key. -/
private theorem effective_le_cap_run (h : Setting config checks g split fin pulled anc counted V)
    {c : BeaconState preset fork} (toC : Run config checks ⟨fork, fin⟩ ⟨fork, c⟩)
    (fromC : Run config checks ⟨fork, c⟩ ⟨fork, split⟩) {y : BeaconState preset fork}
    (r : Run config checks ⟨fork, split⟩ ⟨fork, y⟩) (i : ℕ) :
    ∀ z ∈ (fromC.append r).balancePath, effectiveAt z i ≤ PinTerms.capAt z i := fun z member => by
  obtain ⟨shared⟩ := h.toFin
  obtain ⟨zs, rfl, ⟨r1⟩, -⟩ := balancePath_state (fromC.append r) member
  exact effective_le_cap_at (shared.append (toC.append r1)) h.genesis h.caps h.early i

/-- A key's effective balance at a state of C's run is that at `c`, or within the ceiling.

The run of C starts at a state `c` of the shared segment, which holds the key, and ends at `e`.

The cap of the key may rise once on the run, and the balance counts up to its cap at each state.

The effective balance at `e` is that at `c` if `e` is no later than `c`. -/
private theorem key_stay_to (h : Setting config checks g split fin pulled anc counted V)
    {c e : BeaconState preset fork} (toC : Run config checks ⟨fork, fin⟩ ⟨fork, c⟩)
    (fromC : Run config checks ⟨fork, c⟩ ⟨fork, split⟩)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, e⟩) (i : ℕ)
    (inside : i < c.validators.data.size) (Bc : ℕ)
    (balanceC : ∀ z ∈ (fromC.append tailC).balancePath,
      min (actualBalanceAt z i) (PinTerms.capAt z i) ≤ Bc) :
    ((getCurrentEpoch e).toNat ≤ (getCurrentEpoch c).toNat ∧
        effectiveAt (⟨fork, e⟩ : ForkedBeaconState preset) i =
          effectiveAt (⟨fork, c⟩ : ForkedBeaconState preset) i) ∨
      ((getCurrentEpoch c).toNat < (getCurrentEpoch e).toNat ∧
        effectiveAt (⟨fork, e⟩ : ForkedBeaconState preset) i ≤ Bc + preset.downwardBand ∧
        effectiveAt (⟨fork, e⟩ : ForkedBeaconState preset) i ≤
          max (effectiveAt (⟨fork, c⟩ : ForkedBeaconState preset) i)
            (min (Bc - Bc % preset.EFFECTIVE_BALANCE_INCREMENT.toNat)
              (PinTerms.capAt (⟨fork, e⟩ : ForkedBeaconState preset) i))) := by
  obtain ⟨shared⟩ := h.toFin
  have invariant : Invariant c := Run.invariant h.genesis.invariant (shared.append toC)
  obtain ⟨c1, c2, c3, -⟩ := effective_ceiling_flip h (fromC.append tailC) invariant i inside Bc
    (PinTerms.capAt (⟨fork, e⟩ : ForkedBeaconState preset) i)
    (effective_le_cap_run h toC fromC tailC i)
    (capCeil_path (fromC.append tailC) h.caps h.early (Nat.le_refl _) i) balanceC
  by_cases flat : (getCurrentEpoch e).toNat ≤ (getCurrentEpoch c).toNat
  · exact .inl ⟨flat, c2 flat⟩
  · exact .inr ⟨by omega, c3 (by omega), c1⟩

open DirectSafety.Apriori.Internal in
/-- A key's balance on C's branch is at most R's balance, its debits, its credits and the gains.

The key is in the low regime, so its effective balance bound `ebUp` closes the ceiling.

The credits are `Cr`, which covers C's net credits `credits`, and the sync debits of R's.

`flipCover` makes `Cr` cover all of C's gross credits, when the cap rises on C's run.

The gain is at most a tenth of the credits, sync debits, slack and base gain. -/
private theorem c_ceiling (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    {e : BeaconState preset fork}
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, e⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch e).toNat ≤ highC + 1)
    (near : (getCurrentEpoch e).toNat ≤ (getCurrentEpoch pulled).toNat + 1) (P : ℕ)
    (hP : P = ((getBaseRewardPerIncrement preset
      (if 18 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤
          ((getTotalActiveBalance pulled).toOption.getD 0).toNat then
        (getTotalActiveBalance pulled).toOption.getD 0 / 4
      else preset.EFFECTIVE_BALANCE_INCREMENT / 5)).toOption.getD 0).toNat)
    (v : ValidatorIndex) (inside : v.toNat < split.validators.data.size)
    {events eventsF eventsC : List (BalanceEvent preset)} (W : ℕ)
    (replayedC : tailC.balanceEvents highC = .ok eventsC) (Cr : ℕ)
    (credits : netScan v.toNat highC tailC +
      (creditScan (fun _ => false) (fun s => decide (s ≠ .rewards)) v.toNat highC tailC) ≤ Cr)
    (flipCover : PinTerms.capAt (⟨fork, split⟩ : ForkedBeaconState preset) v.toNat ≤
        preset.MIN_ACTIVATION_BALANCE.toNat ∧ preset.MIN_ACTIVATION_BALANCE.toNat <
          PinTerms.capAt (⟨fork, e⟩ : ForkedBeaconState preset) v.toNat →
      credC tailC highC v.toNat + whistC tailC highC v.toNat +
        (eventsC.map (syncCredit v.toNat)).sum ≤ Cr)
    (startEff : effectiveAt (⟨fork, split⟩ : ForkedBeaconState preset) v.toNat ≤
      (pinTerms config pulled anc fin).ebUp v.toNat +
        preset.EFFECTIVE_BALANCE_INCREMENT.toNat *
          (((eventsF.map (syncDebit v.toNat)).sum + (events.map (syncDebit v.toNat)).sum + W) /
            preset.EFFECTIVE_BALANCE_INCREMENT.toNat))
    (floorR : min (actualBalanceAt (⟨fork, split⟩ : ForkedBeaconState preset) v.toNat)
        (PinTerms.capAt (⟨fork, split⟩ : ForkedBeaconState preset) v.toNat) ≤
      actualBalanceAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat +
        ((events.map (penaltyDebit v.toNat)).sum + (events.map (floorPartialDebit v)).sum) +
        (events.map (syncDebit v.toNat)).sum + W)
    (debits : (events.map (penaltyDebit v.toNat)).sum + (events.map (floorPartialDebit v)).sum ≤
      ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) *
          (pinTerms config pulled anc fin).leakAt
            (PinTerms.capAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat) v.toNat +
        (PinTerms.dueAmount fin (Nat.le_trans (by decide) h.fulu) v.toNat
            ((getCurrentEpoch pulled).toNat + 1) -
          PinTerms.dueAmount pulled (Nat.le_trans (by decide) h.fulu) v.toNat
            ((getCurrentEpoch pulled).toNat + 1)))
    (rateLow : 11 * (pinTerms config pulled anc fin).depth *
      ((pinTerms config pulled anc fin).gainRate v.toNat + 1) ≤
        (pinTerms config pulled anc fin).ebUp v.toNat) :
    ∃ gc, gc = min (pinTerms config pulled anc fin).depth
          ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) *
        (11 * ((Cr +
            (events.map (syncDebit v.toNat)).sum + (eventsF.map (syncDebit v.toNat)).sum) + W +
          min (pinTerms config pulled anc fin).depth
              ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) *
            (pinTerms config pulled anc fin).gainRate v.toNat +
          min (pinTerms config pulled anc fin).depth
            ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat)) /
          (10 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat) * P *
        (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum / WEIGHT_DENOMINATOR.toNat) ∧
      10 * gc ≤ (Cr +
            (events.map (syncDebit v.toNat)).sum + (eventsF.map (syncDebit v.toNat)).sum) + W +
        min (pinTerms config pulled anc fin).depth
            ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) *
          (pinTerms config pulled anc fin).gainRate v.toNat +
        min (pinTerms config pulled anc fin).depth
          ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) ∧
      ∀ z ∈ tailC.balancePath, min (actualBalanceAt z v.toNat) (PinTerms.capAt z v.toNat) ≤
        min (actualBalanceAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat +
          ((events.map (penaltyDebit v.toNat)).sum + (events.map (floorPartialDebit v)).sum) +
          (events.map (syncDebit v.toNat)).sum + W)
          (PinTerms.capAt (⟨fork, split⟩ : ForkedBeaconState preset) v.toNat) +
          Cr +
          (gc + (min (pinTerms config pulled anc fin).depth
              ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) *
            (pinTerms config pulled anc fin).gainRate v.toNat +
            min (pinTerms config pulled anc fin).depth
              ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat))) := by
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  have incPos := h.bands.1
  have top : min (PinTerms.capAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat)
      (actualBalanceAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat +
        ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) *
          (pinTerms config pulled anc fin).leakAt
            (PinTerms.capAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat) v.toNat +
        (PinTerms.dueAmount fin electra v.toNat ((getCurrentEpoch pulled).toNat + 1) -
          PinTerms.dueAmount pulled electra v.toNat ((getCurrentEpoch pulled).toNat + 1)) +
        preset.downwardBand) ≤ (pinTerms config pulled anc fin).ebUp v.toNat := by
    have key : ∀ T : ℕ, T ≤ (T + preset.EFFECTIVE_BALANCE_INCREMENT.toNat - 1) -
        (T + preset.EFFECTIVE_BALANCE_INCREMENT.toNat - 1) %
          preset.EFFECTIVE_BALANCE_INCREMENT.toNat := fun T => by
      have := Nat.mod_lt (T + preset.EFFECTIVE_BALANCE_INCREMENT.toNat - 1) incPos
      omega
    rw [ebUp_eq config pulled anc fin electra v.toNat _ rfl]
    exact le_trans (min_le_min le_rfl (key _)) (le_max_right _ _)
  obtain ⟨i, hi⟩ : ∃ i, i = v.toNat := ⟨_, rfl⟩
  rw [← hi] at inside startEff floorR debits rateLow top credits flipCover ⊢
  obtain ⟨capI, hcap0⟩ : ∃ capI, capI =
      PinTerms.capAt (⟨fork, pulled⟩ : ForkedBeaconState preset) i := ⟨_, rfl⟩
  rw [← hcap0] at debits top
  obtain ⟨pd, hpd⟩ : ∃ pd,
      pd = PinTerms.dueAmount fin electra i ((getCurrentEpoch pulled).toNat + 1) -
      PinTerms.dueAmount pulled electra i ((getCurrentEpoch pulled).toNat + 1) := ⟨_, rfl⟩
  rw [← hpd] at debits top
  obtain ⟨Dp, hDp⟩ : ∃ Dp, Dp =
      (events.map (penaltyDebit i)).sum + (events.map (floorPartialDebit v)).sum := ⟨_, rfl⟩
  obtain ⟨Ds, hDs⟩ : ∃ Ds, Ds = (events.map (syncDebit i)).sum := ⟨_, rfl⟩
  obtain ⟨DsF, hDsF⟩ : ∃ DsF, DsF = (eventsF.map (syncDebit i)).sum := ⟨_, rfl⟩
  rw [← hDp] at floorR debits ⊢
  rw [← hDs] at floorR startEff ⊢
  rw [← hDsF] at startEff ⊢
  classical
  obtain ⟨shared⟩ := h.toFin
  obtain ⟨toPulled⟩ := h.toPulled
  have finalized := UInt64.le_iff_toNat_le.mp h.finalized
  have finSplit : (getCurrentEpoch fin).toNat ≤ (getCurrentEpoch split).toNat :=
    epoch_le_of_slot_le fin.slot split.slot (Run.slot_le fromFin)
  have depthEq : (pinTerms config pulled anc fin).depth =
      (getCurrentEpoch pulled).toNat + 2 - anc.finalizedCheckpoint.epoch.toNat := rfl
  obtain ⟨Df, hDf⟩ : ∃ Df, Df =
      (getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat := ⟨_, rfl⟩
  rw [← hDf] at debits top
  obtain ⟨D, hD⟩ : ∃ D, D = min (pinTerms config pulled anc fin).depth Df := ⟨_, rfl⟩
  rw [← hDf, ← hD]
  obtain ⟨e0, he0⟩ : ∃ e0, e0 = (pinTerms config pulled anc fin).ebUp i := ⟨_, rfl⟩
  obtain ⟨q, hq⟩ : ∃ q, q = (pinTerms config pulled anc fin).gainRate i := ⟨_, rfl⟩
  rw [← he0] at top startEff rateLow
  rw [← hq] at rateLow ⊢
  have hq' : q = e0 / preset.EFFECTIVE_BALANCE_INCREMENT.toNat * P *
      (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum / WEIGHT_DENOMINATOR.toNat := by
    rw [hq, he0, hP]
    rfl
  obtain ⟨C, hC⟩ : ∃ C, C = preset.EFFECTIVE_BALANCE_INCREMENT.toNat *
      (11 * (Cr + Ds + DsF + W + D * q + D) / (10 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat)) :=
    ⟨_, rfl⟩
  have startEff' : effectiveAt (⟨fork, split⟩ : ForkedBeaconState preset) i ≤ e0 + C := by
    refine Nat.le_trans startEff (Nat.add_le_add_left ?_ _)
    rw [hC]
    refine Nat.mul_le_mul_left _ ?_
    have le := Nat.div_le_div_right (c := 10 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat)
      (show 10 * (DsF + Ds + W) ≤ 11 * (Cr + Ds + DsF + W + D * q + D) by omega)
    rwa [Nat.mul_div_mul_left _ _ (by norm_num : 0 < 10)] at le
  have alignedE0 : e0 % preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0 := by
    rw [he0]
    exact ebUp_aligned h i
  obtain ⟨P', hP', rateAll⟩ := key_rate_pre h tailC near
  rw [hP'.trans hP.symm] at rateAll
  have hDle : D ≤ (pinTerms config pulled anc fin).depth := hD ▸ min_le_left _ _
  have epochs : (getCurrentEpoch e).toNat - (getCurrentEpoch split).toNat ≤ D := by
    rw [hD]
    exact Nat.le_min.mpr ⟨by omega, by omega⟩
  have sizeC : i < e.validators.data.size :=
    Nat.lt_of_lt_of_le inside (registryGrows_of_chainSteps tailC.chainSteps)
  have capSC := cap_le_cap_of_run h.caps tailC h.early i
  have capSP : PinTerms.capAt (⟨fork, split⟩ : ForkedBeaconState preset) i ≤ capI :=
    hcap0 ▸ cap_le_cap_of_run h.caps toPulled h.early i
  have capCeil := capCeil_path tailC h.caps h.early (Nat.le_refl _) i
  have effS := effective_le_cap_at (shared.append fromFin) h.genesis h.caps h.early i
  have minMax := UInt64.le_iff_toNat_le.mp h.caps.compounding
  obtain ⟨kindS, aMin, aMax⟩ := capAt_kind h i inside
  obtain ⟨kindC, -, -⟩ := capAt_kind h i sizeC
  obtain ⟨wC, foundC⟩ : ∃ w, e.validators.data[i]? = some w :=
    ⟨_, Array.getElem?_eq_getElem sizeC⟩
  have alignedC := capAt_aligned h.aligned (z := (⟨fork, e⟩ : ForkedBeaconState preset))
    electra foundC
  have startKey : 11 * D * (P * (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum) <
      WEIGHT_DENOMINATOR.toNat * preset.EFFECTIVE_BALANCE_INCREMENT.toNat :=
    rate_per_increment preset.EFFECTIVE_BALANCE_INCREMENT.toNat WEIGHT_DENOMINATOR.toNat
      (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum P e0 D incPos (by decide) alignedE0
      (by
        rw [← hq']
        exact Nat.le_trans (Nat.mul_le_mul_right _ (Nat.mul_le_mul_left 11 hDle)) rateLow)
  by_cases flipped : PinTerms.capAt (⟨fork, split⟩ : ForkedBeaconState preset) i ≤
      preset.MIN_ACTIVATION_BALANCE.toNat ∧ preset.MIN_ACTIVATION_BALANCE.toNat <
        PinTerms.capAt (⟨fork, e⟩ : ForkedBeaconState preset) i
  · -- the cap rises on C's branch, so the run splits at the step that makes the key compound
    have cover := flipCover flipped
    have invariantS := Run.invariant h.genesis.invariant (shared.append fromFin)
    obtain ⟨m, n, pre, step, post, cut, flatM, largeN, -, sameEpoch⟩ :=
      Run.flip_split tailC h.early h.fulu invariantS i flipped.1 flipped.2
    obtain ⟨mf, ms⟩ := m
    have sameM : fork = mf :=
      (fork_eq_of_run pre ((Run.nil.snoc step).append post) (Nat.le_refl _)).symm
    subst sameM
    have insideM : i < ms.validators.data.size :=
      Nat.lt_of_lt_of_le inside (registryGrows_of_chainSteps pre.chainSteps)
    obtain ⟨preMem, postMem⟩ := flip_path_mem pre step post cut
    have notSlot := step_flip_not_slot step
      (Nat.lt_of_le_of_lt (fork_le_of_chainSteps post.chainSteps) h.early)
      (Nat.le_trans h.fulu (fork_le_of_chainSteps pre.chainSteps)) i insideM
      (Nat.not_lt.mpr flatM) largeN
    have junction := step_flip_min step
      (Nat.lt_of_le_of_lt (fork_le_of_chainSteps post.chainSteps) h.early)
      (Nat.le_trans h.fulu (fork_le_of_chainSteps pre.chainSteps))
      (Run.invariant invariantS pre) i (Nat.not_lt.mpr flatM) largeN
    have capMin : PinTerms.capAt (⟨fork, split⟩ : ForkedBeaconState preset) i =
        preset.MIN_ACTIVATION_BALANCE.toNat := by omega
    clear kindS kindC
    have capsPre : ∀ z ∈ pre.balancePath, PinTerms.capAt z i ≤
        preset.MIN_ACTIVATION_BALANCE.toNat := fun z member => by
      obtain ⟨zs, rfl, -, ⟨r2⟩⟩ := balancePath_state pre member
      exact Nat.le_trans (cap_le_cap_of_run h.caps r2 h.early i) flatM
    have epochM : (getCurrentEpoch ms).toNat ≤ highC + 1 := by
      have := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps
        ((Run.nil.snoc step).append post).chainSteps)
      simp only at this
      omega
    have fc := flip_credits_le_sources (shared.append fromFin) h.genesis pre step post notSlot
      h.early electra i highC epochM (by rw [cut]; exact replayedC)
    rw [cut] at fc
    have minLe : preset.MIN_ACTIVATION_BALANCE.toNat ≤ capI := capMin ▸ capSP
    obtain ⟨gc, hform, hgc, bPre, bPost, -⟩ := c_ceiling_abstract_flip pre step post h.early
      h.fulu i inside highC P preset.MIN_ACTIVATION_BALANCE.toNat
      (PinTerms.capAt (⟨fork, e⟩ : ForkedBeaconState preset) i) aMin alignedC
      (by omega) (by omega) capsPre (fun z member => capCeil z (postMem z member))
      (fun z member => rateAll z (member.elim (preMem z) (postMem z))) endEpochC incPos D Cr
      (Cr + Ds + DsF) e0 C
      (min (actualBalanceAt (⟨fork, pulled⟩ : ForkedBeaconState preset) i + Dp + Ds + W)
        preset.MIN_ACTIVATION_BALANCE.toNat) W
      (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum q rfl hq' alignedE0 hC epochs
      (le_min (by rw [← capMin]; exact floorR) (min_le_right _ _)) startEff' junction
      (step_same_epoch_effective step
        (Nat.lt_of_le_of_lt (fork_le_of_chainSteps post.chainSteps) h.early)
        (UInt64.toNat_inj.mp (sameEpoch inside)) i insideM)
      (by omega) startKey (by omega)
    refine ⟨gc, hform, hgc, fun z member => ?_⟩
    rcases flip_path_cover pre step post notSlot cut z member with inPre | inPost
    · have := bPre z inPre
      have := capsPre z inPre
      rw [capMin]
      omega
    · have := bPost z inPost
      have := capCeil z member
      rw [capMin]
      omega
  · -- the cap of C's branch is the cap at the split throughout
    have same : PinTerms.capAt (⟨fork, e⟩ : ForkedBeaconState preset) i =
        PinTerms.capAt (⟨fork, split⟩ : ForkedBeaconState preset) i := by
      rcases kindS with s1 | s1 <;> rcases kindC with f | f <;> omega
    clear kindS kindC
    obtain ⟨gc, hform, hgc, bound, -⟩ := c_ceiling_abstract tailC h.early h.fulu i inside highC P
      (PinTerms.capAt (⟨fork, e⟩ : ForkedBeaconState preset) i) alignedC
      (by omega) capCeil rateAll endEpochC incPos D Cr (Cr + Ds + DsF) e0 C
      (min (actualBalanceAt (⟨fork, pulled⟩ : ForkedBeaconState preset) i + Dp + Ds + W)
        (PinTerms.capAt (⟨fork, split⟩ : ForkedBeaconState preset) i)) W
      (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum q rfl hq' alignedE0 hC epochs
      (le_min (by rw [same]; exact floorR) (by rw [same]; exact min_le_right _ _)) startEff'
      credits startKey (by omega)
    refine ⟨gc, hform, hgc, fun z member => ?_⟩
    have := bound z member
    have := capCeil z member
    omega

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The debits of a key on R's branch that the pin charges at the top: its passes and its partials.

The passes cost at most the leak at `M` for each epoch from the finalized state's.

The bound `M` is at least the key's effective balance at each state of the run to R.

The partials paid are at most those queued at the finalized state less those still queued at R. -/
private theorem debits_le_top (h : Setting config checks g split fin pulled anc counted V)
    {s : BeaconState preset fork} (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, s⟩)
    (tail : Run config checks ⟨fork, s⟩ ⟨fork, pulled⟩) (high : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    {eventsF : List (BalanceEvent preset)} (replayedF : fromFin.balanceEvents high = .ok eventsF)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    (v : ValidatorIndex) (inside : v.toNat < s.validators.data.size) (M : ℕ)
    (below : ∀ {zs : BeaconState preset fork} (pre : Run config checks ⟨fork, s⟩ ⟨fork, zs⟩)
      (post : Run config checks ⟨fork, zs⟩ ⟨fork, pulled⟩), tail = pre.append post →
      effectiveAt (⟨fork, zs⟩ : ForkedBeaconState preset) v.toNat ≤ M) :
    (events.map (penaltyDebit v.toNat)).sum + (events.map (floorPartialDebit v)).sum ≤
      ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) *
          (pinTerms config pulled anc fin).leakAt M v.toNat +
        (PinTerms.dueAmount fin (Nat.le_trans (by decide) h.fulu) v.toNat
            ((getCurrentEpoch pulled).toNat + 1) -
          PinTerms.dueAmount pulled (Nat.le_trans (by decide) h.fulu) v.toNat
            ((getCurrentEpoch pulled).toNat + 1)) := by
  have altair : .altair ≤ fork := Nat.le_trans (by decide) h.fulu
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  have passes : (events.map (penaltyDebit v.toNat)).sum ≤
      ((getCurrentEpoch pulled).toNat - (getCurrentEpoch s).toNat) *
        (pinTerms config pulled anc fin).leakAt M v.toNat :=
    Run.passDebit_le tail h.early altair high endEpoch inside
    ((pinTerms config pulled anc fin).leakAt M v.toNat)
    (fun {z} pre post cut before totals => by
      obtain ⟨T, perIncrement, totalOk, perOk⟩ := totals
      obtain ⟨zf, zs⟩ := z
      have same : zf = fork := fork_eq_of_run pre post (Nat.le_refl _)
      subst same
      have startE : (getCurrentEpoch zs).toNat ≤ (getCurrentEpoch pulled).toNat + 1 := by
        simp only at before
        omega
      obtain ⟨pq, pqOk⟩ :=
        quarter_base_ok h.facts perOk ((getTotalActiveBalance pulled).toOption.getD 0)
      exact (passRate_le_leakAt h (fromFin.append pre) startE totalOk pqOk v.toNat).trans
        (leakAt_mono config pulled anc fin v.toNat (below pre post cut)))
    replayed
  have epochs : (getCurrentEpoch pulled).toNat - (getCurrentEpoch s).toNat ≤
      (getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat := by
    have := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps fromFin.chainSteps)
    simp only at this
    omega
  have whole := Apriori.Internal.balanceEvents_append fromFin tail high replayedF replayed
  have net := Run.partialDebit_net (fromFin.append tail) electra h.early high
    ((getCurrentEpoch pulled).toNat + 1) (Nat.le_succ _) (window_short h) v whole
  simp only [List.map_append, List.sum_append] at net
  have part : (events.map (floorPartialDebit v)).sum +
      PinTerms.dueAmount pulled electra v.toNat ((getCurrentEpoch pulled).toNat + 1) ≤
        PinTerms.dueAmount fin electra v.toNat ((getCurrentEpoch pulled).toNat + 1) := by
    rw [dueAmount_eq, dueAmount_eq]
    omega
  have := Nat.mul_le_mul_right ((pinTerms config pulled anc fin).leakAt M v.toNat) epochs
  omega

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The balance of a key at a state of R's run from the finalized state has a ceiling.

The balance counts up to the key's cap at that state.

The ceiling is R's balance, the leak at `M` over the window and the net partials.

It adds the sync debits of the two runs and the slack `W`.

The floor of the state gives it, with the debits of the run after the state.

The bound `M` is at least the key's effective balance at each state of the run. -/
private theorem prefix_ceiling (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩) (high : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    {eventsF : List (BalanceEvent preset)} (replayedF : fromFin.balanceEvents high = .ok eventsF)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    (v : ValidatorIndex) (W M : ℕ)
    (below : ∀ {zs : BeaconState preset fork} (pre : Run config checks ⟨fork, fin⟩ ⟨fork, zs⟩)
      (post : Run config checks ⟨fork, zs⟩ ⟨fork, pulled⟩), pre.append post = fromFin.append tail →
      effectiveAt (⟨fork, zs⟩ : ForkedBeaconState preset) v.toNat ≤ M)
    {zs : BeaconState preset fork} (r1 : Run config checks ⟨fork, fin⟩ ⟨fork, zs⟩)
    (r2 : Run config checks ⟨fork, zs⟩ ⟨fork, pulled⟩) (cut : r1.append r2 = fromFin.append tail)
    (inside : v.toNat < zs.validators.data.size)
    (floorAt : ∀ {evs : List (BalanceEvent preset)}, r2.balanceEvents high = .ok evs →
      min (actualBalanceAt (⟨fork, zs⟩ : ForkedBeaconState preset) v.toNat)
          (PinTerms.capAt (⟨fork, zs⟩ : ForkedBeaconState preset) v.toNat) ≤
        actualBalanceAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat +
          (evs.map (penaltyDebit v.toNat)).sum + (evs.map (syncDebit v.toNat)).sum +
          (evs.map (floorPartialDebit v)).sum + W) :
    min (actualBalanceAt (⟨fork, zs⟩ : ForkedBeaconState preset) v.toNat)
        (PinTerms.capAt (⟨fork, zs⟩ : ForkedBeaconState preset) v.toNat) ≤
      actualBalanceAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat +
        (((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) *
            (pinTerms config pulled anc fin).leakAt M v.toNat +
          (PinTerms.dueAmount fin (Nat.le_trans (by decide) h.fulu) v.toNat
              ((getCurrentEpoch pulled).toNat + 1) -
            PinTerms.dueAmount pulled (Nat.le_trans (by decide) h.fulu) v.toNat
              ((getCurrentEpoch pulled).toNat + 1))) +
        ((eventsF.map (syncDebit v.toNat)).sum + (events.map (syncDebit v.toNat)).sum + W) := by
  have whole := Apriori.Internal.balanceEvents_append fromFin tail high replayedF replayed
  obtain ⟨e1, ok1⟩ := r1.balanceEvents_ok h.early high
  obtain ⟨e2, ok2⟩ := r2.balanceEvents_ok h.early high
  have app := Apriori.Internal.balanceEvents_append r1 r2 high ok1 ok2
  rw [cut, whole] at app
  have eq : eventsF ++ events = e1 ++ e2 := Except.ok.inj app
  have floor := floorAt ok2
  have debit := debits_le_top h r1 r2 high endEpoch ok1 ok2 v inside M
    (fun pre post same => below (r1.append pre) post
      (by rw [← Run.append_assoc, ← same]; exact cut))
  have sums : (e2.map (syncDebit v.toNat)).sum ≤
      (eventsF.map (syncDebit v.toNat)).sum + (events.map (syncDebit v.toNat)).sum := by
    have := congrArg (fun L => (L.map (syncDebit v.toNat)).sum) eq
    simp only [List.map_append, List.sum_append] at this
    omega
  omega

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- `prefix_ceiling` at each state of the balance path of the run from a state `c` to R.

The state `c` is on the shared segment, and the floor holds at each state after it. -/
private theorem path_ceiling (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩) (high : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    {eventsF : List (BalanceEvent preset)} (replayedF : fromFin.balanceEvents high = .ok eventsF)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    (v : ValidatorIndex) (W M : ℕ)
    (below : ∀ {zs : BeaconState preset fork} (pre : Run config checks ⟨fork, fin⟩ ⟨fork, zs⟩)
      (post : Run config checks ⟨fork, zs⟩ ⟨fork, pulled⟩), pre.append post = fromFin.append tail →
      effectiveAt (⟨fork, zs⟩ : ForkedBeaconState preset) v.toNat ≤ M)
    {c : BeaconState preset fork} (toC : Run config checks ⟨fork, fin⟩ ⟨fork, c⟩)
    (fromC : Run config checks ⟨fork, c⟩ ⟨fork, split⟩) (cutC : toC.append fromC = fromFin)
    (inside : v.toNat < c.validators.data.size)
    (floorAt : ∀ {zs : BeaconState preset fork} (pre : Run config checks ⟨fork, c⟩ ⟨fork, zs⟩)
      (after : Run config checks ⟨fork, zs⟩ ⟨fork, pulled⟩), pre.append after = fromC.append tail →
      ∀ {evs : List (BalanceEvent preset)}, after.balanceEvents high = .ok evs →
      min (actualBalanceAt (⟨fork, zs⟩ : ForkedBeaconState preset) v.toNat)
          (PinTerms.capAt (⟨fork, zs⟩ : ForkedBeaconState preset) v.toNat) ≤
        actualBalanceAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat +
          (evs.map (penaltyDebit v.toNat)).sum + (evs.map (syncDebit v.toNat)).sum +
          (evs.map (floorPartialDebit v)).sum + W) :
    ∀ z ∈ (fromC.append tail).balancePath,
      min (actualBalanceAt z v.toNat) (PinTerms.capAt z v.toNat) ≤
        actualBalanceAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat +
          (((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) *
              (pinTerms config pulled anc fin).leakAt M v.toNat +
            (PinTerms.dueAmount fin (Nat.le_trans (by decide) h.fulu) v.toNat
                ((getCurrentEpoch pulled).toNat + 1) -
              PinTerms.dueAmount pulled (Nat.le_trans (by decide) h.fulu) v.toNat
                ((getCurrentEpoch pulled).toNat + 1))) +
          ((eventsF.map (syncDebit v.toNat)).sum + (events.map (syncDebit v.toNat)).sum + W) := by
  intro z member
  obtain ⟨r1, r2, cutZ'⟩ := balancePath_endpoint (fromC.append tail)
    (Run.nil : Run config checks ⟨fork, pulled⟩ ⟨fork, pulled⟩) (Nat.le_refl _) member
  obtain ⟨zf, zs⟩ := z
  have same : fork = zf := (fork_eq_of_run r1 r2 (Nat.le_refl _)).symm
  subst same
  have cutZ : (toC.append r1).append r2 = fromFin.append tail := by
    rw [← Run.append_assoc]
    exact (congrArg toC.append cutZ').trans (by
      show toC.append (fromC.append tail) = fromFin.append tail
      rw [← cutC, Run.append_assoc])
  exact prefix_ceiling h fromFin tail high endEpoch replayedF replayed v W M below (toC.append r1)
    r2 cutZ (Nat.le_trans inside (registryGrows_of_chainSteps r1.chainSteps)) (floorAt r1 r2 cutZ')

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The effective balance of a key at each state of R's run from a state `c` is bounded.

The run from `c` is the rest of the run from the finalized state to R's, cut at `c`.

The finalized state is `c` for a key of the finalized registry.

A key that R's run creates has its first state `c` after the split.

At `c` the effective balance is within `ebUp` and the finalized one, or within its balance floor.

After `c` it is within `ebUp` and the whole increments of its sync debits and `W`.

`floorAt` bounds the balance at each state by R's balance and debits, which gives the ceiling. -/
private theorem prefix_envelope (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩) (high : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    {eventsF : List (BalanceEvent preset)} (replayedF : fromFin.balanceEvents high = .ok eventsF)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    (v : ValidatorIndex) {c : BeaconState preset fork}
    (toC : Run config checks ⟨fork, fin⟩ ⟨fork, c⟩)
    (rest : Run config checks ⟨fork, c⟩ ⟨fork, pulled⟩)
    (cutC : toC.append rest = fromFin.append tail)
    (inside : v.toNat < c.validators.data.size) (W : ℕ)
    (start : (effectiveAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat ≤
        (pinTerms config pulled anc fin).ebUp v.toNat ∧
        effectiveAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat ≤ balanceAt fin v.toNat) ∨
      effectiveAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat ≤
        actualBalanceAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat -
          actualBalanceAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat %
            preset.EFFECTIVE_BALANCE_INCREMENT.toNat)
    (floorAt : ∀ {zs : BeaconState preset fork} (pre : Run config checks ⟨fork, c⟩ ⟨fork, zs⟩)
      (after : Run config checks ⟨fork, zs⟩ ⟨fork, pulled⟩), pre.append after = rest →
      ∀ {evs : List (BalanceEvent preset)}, after.balanceEvents high = .ok evs →
      min (actualBalanceAt (⟨fork, zs⟩ : ForkedBeaconState preset) v.toNat)
          (PinTerms.capAt (⟨fork, zs⟩ : ForkedBeaconState preset) v.toNat) ≤
        actualBalanceAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat +
          (evs.map (penaltyDebit v.toNat)).sum + (evs.map (syncDebit v.toNat)).sum +
          (evs.map (floorPartialDebit v)).sum + W) :
    ∀ z ∈ rest.balancePath, effectiveAt z v.toNat ≤
      (pinTerms config pulled anc fin).ebUp v.toNat +
        preset.EFFECTIVE_BALANCE_INCREMENT.toNat *
          (((eventsF.map (syncDebit v.toNat)).sum + (events.map (syncDebit v.toNat)).sum + W) /
            preset.EFFECTIVE_BALANCE_INCREMENT.toNat) := by
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  have incPos := h.bands.1
  obtain ⟨shared⟩ := h.toFin
  -- the top of `ebUp`, `A`, and the balance ceiling, `B`, which adds the sync debits and `W` to it
  obtain ⟨A, hA⟩ : ∃ A, A = actualBalanceAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat +
      ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) *
          (pinTerms config pulled anc fin).leakAt
            (PinTerms.capAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat) v.toNat +
        (PinTerms.dueAmount fin electra v.toNat ((getCurrentEpoch pulled).toNat + 1) -
          PinTerms.dueAmount pulled electra v.toNat ((getCurrentEpoch pulled).toNat + 1)) :=
      ⟨_, rfl⟩
  obtain ⟨B, hB⟩ : ∃ B, B = A +
      ((eventsF.map (syncDebit v.toNat)).sum + (events.map (syncDebit v.toNat)).sum + W) :=
    ⟨_, rfl⟩
  -- the balance ceiling at each state of that run
  have ceiling : ∀ {zs : BeaconState preset fork} (r1 : Run config checks ⟨fork, c⟩ ⟨fork, zs⟩)
      (r2 : Run config checks ⟨fork, zs⟩ ⟨fork, pulled⟩), r1.append r2 = rest →
      min (actualBalanceAt (⟨fork, zs⟩ : ForkedBeaconState preset) v.toNat)
        (PinTerms.capAt (⟨fork, zs⟩ : ForkedBeaconState preset) v.toNat) ≤ B := by
    intro zs r1 r2 cut
    have := prefix_ceiling h fromFin tail high endEpoch replayedF replayed v W
      (PinTerms.capAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat)
      (fun pre post _ => effective_le_cap_pulled h pre post v.toNat) (toC.append r1) r2
      (by rw [← Run.append_assoc, cut, cutC])
      (Nat.lt_of_lt_of_le inside (registryGrows_of_chainSteps r1.chainSteps))
      (fun {evs} ev => floorAt r1 r2 cut ev)
    omega
  intro z member
  obtain ⟨r1, r2, cutZ⟩ := balancePath_endpoint rest
    (Run.nil : Run config checks ⟨fork, pulled⟩ ⟨fork, pulled⟩) (Nat.le_refl _) member
  obtain ⟨zf, zs⟩ := z
  have same : fork = zf := (fork_eq_of_run r1 r2 (Nat.le_refl _)).symm
  subst same
  -- every state of the run to `zs` is the end of a run from `c` to R's
  have atPath : ∀ z' ∈ r1.balancePath, ∃ (zs' : BeaconState preset fork)
      (s1 : Run config checks ⟨fork, c⟩ ⟨fork, zs'⟩)
      (s2 : Run config checks ⟨fork, zs'⟩ ⟨fork, pulled⟩),
      z' = ⟨fork, zs'⟩ ∧ s1.append s2 = rest := by
    intro z' member'
    obtain ⟨s1, s2, cutS⟩ := balancePath_endpoint r1 r2 (Nat.le_refl _) member'
    obtain ⟨zf', zs'⟩ := z'
    have same' : fork = zf' := (fork_eq_of_run s1 s2 (Nat.le_refl _)).symm
    subst same'
    exact ⟨zs', s1, s2, rfl, cutS.trans cutZ⟩
  have bound := effective_ceiling_flip h r1
    (Run.invariant h.genesis.invariant (shared.append toC)) v.toNat inside B
    (PinTerms.capAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat)
    (fun z' member' => by
      obtain ⟨zs', s1, s2, rfl, cut⟩ := atPath z' member'
      exact effective_le_cap_at (shared.append (toC.append s1)) h.genesis h.caps h.early
        v.toNat)
    (fun z' member' => by
      obtain ⟨zs', s1, s2, rfl, cut⟩ := atPath z' member'
      exact cap_le_cap_of_run h.caps s2 h.early v.toNat)
    (fun z' member' => by
      obtain ⟨zs', s1, s2, rfl, cut⟩ := atPath z' member'
      exact ceiling s1 s2 cut)
  obtain ⟨origin, -⟩ := bound
  -- a start within the floor of the balance at `c` is within the floor of the balance ceiling
  have startLe : effectiveAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat ≤
      (pinTerms config pulled anc fin).ebUp v.toNat ∨
      effectiveAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat ≤
        min (B - B % preset.EFFECTIVE_BALANCE_INCREMENT.toNat)
          (PinTerms.capAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat) := by
    rcases start with ⟨within, -⟩ | floorC
    · exact Or.inl within
    · refine Or.inr (Nat.le_min.mpr ⟨?_, ?_⟩)
      · have atC := ceiling (Run.nil : Run config checks ⟨fork, c⟩ ⟨fork, c⟩) rest
          (run_nil_append _)
        have capped := effective_le_cap_at (shared.append toC) h.genesis h.caps h.early v.toNat
        have aligned := FloorTrace.effective_aligned (shared.append toC) h.genesis h.aligned v.toNat
        have rounded := rounded_mono preset.EFFECTIVE_BALANCE_INCREMENT.toNat
          (show effectiveAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat ≤ B by omega)
        omega
      · have capped := effective_le_cap_at (shared.append toC) h.genesis h.caps h.early v.toNat
        have rise := cap_le_cap_of_run h.caps rest h.early v.toNat
        omega
  -- the envelope `ebUp` and the rounding
  obtain ⟨t, ht⟩ :
      ∃ t, t = A + preset.downwardBand + preset.EFFECTIVE_BALANCE_INCREMENT.toNat - 1 := ⟨_, rfl⟩
  have up := ebUp_eq config pulled anc fin electra v.toNat t (by omega)
  have floorRound := rounded_add_floor_le preset.EFFECTIVE_BALANCE_INCREMENT.toNat A
    ((eventsF.map (syncDebit v.toNat)).sum + (events.map (syncDebit v.toNat)).sum + W) incPos
  have rounded := rounded_mono preset.EFFECTIVE_BALANCE_INCREMENT.toNat
    (show A + preset.EFFECTIVE_BALANCE_INCREMENT.toNat - 1 ≤ t by omega)
  have upper : min (PinTerms.capAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat)
      (t - t % preset.EFFECTIVE_BALANCE_INCREMENT.toNat) ≤
        (pinTerms config pulled anc fin).ebUp v.toNat := by
    rw [up]
    exact Nat.le_max_right _ _
  rw [← hB] at floorRound
  omega

/-- Rounding down after adding an amount adds at most the whole increments that cover it. -/
private theorem rounded_add_ceil_le (I x C : ℕ) (hI : 0 < I) :
    (x + C) - (x + C) % I ≤ (x - x % I) + I * ((C + I - 1) / I) := by
  have sum := Nat.div_add_mod (x + C) I
  have base := Nat.div_add_mod x I
  have step : (x + C) / I ≤ x / I + (C + I - 1) / I := by
    obtain ⟨q, r, hr, rfl⟩ : ∃ q r, r < I ∧ x = I * q + r :=
      ⟨x / I, x % I, Nat.mod_lt _ hI, (Nat.div_add_mod x I).symm⟩
    have quotient : (I * q + r) / I = q := by
      rw [Nat.mul_add_div hI, Nat.div_eq_of_lt hr, Nat.add_zero]
    have shifted : (I * q + r + C) / I = q + (r + C) / I := by
      rw [show I * q + r + C = I * q + (r + C) by ring, Nat.mul_add_div hI]
    rw [shifted, quotient]
    exact Nat.add_le_add_left (Nat.div_le_div_right (by omega)) _
  have scaled := Nat.mul_le_mul_left I step
  rw [Nat.mul_add] at scaled
  omega

/-- A cap at a state of the Electra forks is at most the largest cap. -/
private theorem capAt_le_capMax {z : ForkedBeaconState preset} (caps : CapOrder preset)
    (electra : .pectra ≤ z.fork) (i : ℕ) :
    PinTerms.capAt z i ≤ preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat := by
  cases found : z.state.validators.data[i]? with
  | none => simp [PinTerms.capAt, found]
  | some w =>
    have compounding := UInt64.le_iff_toNat_le.mp caps.compounding
    rw [capAt_of_found electra found]
    split <;> omega

/-- A key with an assigned exit epoch is inactive at every epoch from the exit on, along a run.

The run keeps an assigned exit epoch. -/
private theorem inactive_from_exit {x y : ForkedBeaconState preset} (tail : Run config checks x y)
    {i : ℕ} {v : Validator} (found : x.state.validators.data[i]? = some v)
    (assigned : v.exitEpoch ≠ FAR_FUTURE_EPOCH) {e : Epoch} (reached : v.exitEpoch ≤ e) :
    isActiveAt y.state e i = false := by
  obtain ⟨later, foundLater, kept⟩ := tail.registryLifecycle.validators i v found
  have inactive : isActiveValidator later e = false := by
    unfold isActiveValidator
    simp
    exact fun _ => by rw [kept.exitEpoch assigned]; exact reached
  simp [isActiveAt, foundLater, inactive]

/-- A key that exited before the finalized epoch stays within its finalized balance and credits.

The key is idle from the finalized block on.

Its exit is kept, and the previous epoch of each later state is at or past it.

An idle key earns no epoch reward, so the credit ceiling of the run needs no rate.

The ceiling on the balance is the finalized balance and the credits of the run.

Rounding adds the whole increments that cover the credits. -/
private theorem exited_ceiling (h : Setting config checks g split fin pulled anc counted V)
    {a : BeaconState preset fork} (run : Run config checks ⟨fork, fin⟩ ⟨fork, a⟩) (high : ℕ)
    (endEpoch : (getCurrentEpoch a).toNat ≤ high + 1) (i : ℕ) {w : Validator}
    (found : fin.validators.data[i]? = some w)
    (exited : w.exitEpoch.toNat + 1 ≤ (getCurrentEpoch fin).toNat) (Cr : ℕ)
    (credits : netScan i high run +
      (creditScan (fun _ => false) (fun s => decide (s ≠ .rewards)) i high run) ≤ Cr) :
    effectiveAt (⟨fork, a⟩ : ForkedBeaconState preset) i ≤
      max (effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) i)
        ((actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i -
          actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i %
            preset.EFFECTIVE_BALANCE_INCREMENT.toNat) +
          preset.EFFECTIVE_BALANCE_INCREMENT.toNat *
            ((Cr + preset.EFFECTIVE_BALANCE_INCREMENT.toNat - 1) /
              preset.EFFECTIVE_BALANCE_INCREMENT.toNat)) := by
  have incPos := h.bands.1
  have inside : i < fin.validators.data.size := (Array.getElem?_eq_some_iff.mp found).1
  obtain ⟨shared⟩ := h.toFin
  have alignedMax := (cap_values_aligned h.aligned).2
  have startCap := PinSeatDebits.effectiveAt_le_capMax shared h.genesis h.caps h.early i
  have capCeil : ∀ z ∈ run.balancePath,
      PinTerms.capAt z i ≤ preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat := fun z member => by
    obtain ⟨r1, -, -⟩ := balancePath_endpoint run
      (Run.nil : Run config checks ⟨fork, a⟩ ⟨fork, a⟩) (Nat.le_refl _) member
    exact capAt_le_capMax h.caps (Nat.le_trans (Nat.le_trans (by decide) h.fulu)
      (fork_le_of_chainSteps r1.chainSteps)) i
  have notFar : w.exitEpoch ≠ FAR_FUTURE_EPOCH := fun far => by
    have := getCurrentEpoch_succ_lt_farFuture h.twoSlots fin
    have := congrArg UInt64.toNat far
    omega
  have idle : ∀ z ∈ run.balancePath,
      i.toUInt64 ∉ getActiveValidatorIndices z.state (getPreviousEpoch z.state) := by
    intro z member active
    obtain ⟨r1, r2, -⟩ := balancePath_endpoint run
      (Run.nil : Run config checks ⟨fork, a⟩ ⟨fork, a⟩) (Nat.le_refl _) member
    obtain ⟨zf, zs⟩ := z
    have within := BeaconState.registryWithinLimit_of_lt
      (Nat.lt_of_le_of_lt (fork_le_of_chainSteps r2.chainSteps) h.early) zs
    have index : i.toUInt64.toNat = i := toNat_toUInt64_of_lt within
      (Nat.lt_of_lt_of_le (Array.getElem?_eq_some_iff.mp found).1 r1.registryLifecycle.size_le)
    have previous := getPreviousEpoch_toNat zs
    have epochs := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps r1.chainSteps)
    simp only at epochs
    have inactive := inactive_from_exit r1 found notFar (e := getPreviousEpoch zs)
      (UInt64.le_iff_toNat_le.mpr (by omega))
    obtain ⟨v, foundV, isActive⟩ := (mem_getActiveValidatorIndices within).mp active
    rw [index] at foundV
    have := isActiveAt_eq_true_iff.mpr ⟨v, foundV, isActive⟩
    rw [inactive] at this
    exact Bool.false_ne_true this
  obtain ⟨cb, hcb⟩ : ∃ cb, cb = min (actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i)
      preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat + (netScan i high run +
        (creditScan (fun _ => false) (fun s => decide (s ≠ .rewards)) i high run)) := ⟨_, rfl⟩
  have cbE : ∀ E, PinKeyFloor.creditBound run i high E 0
      preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat = cb := fun E => by
    rw [hcb]
    unfold PinKeyFloor.creditBound
    simp only [Nat.mul_zero, Nat.zero_mul, Nat.zero_div, Nat.add_zero]
    omega
  obtain ⟨E, hE⟩ : ∃ E, E = max (effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) i)
      (min preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat
        (cb - cb % preset.EFFECTIVE_BALANCE_INCREMENT.toNat)) := ⟨_, rfl⟩
  have ceiling := key_credit_ceiling run h.early h.fulu i inside high 0 E alignedMax startCap
    capCeil (fun z member => .inl (idle z member)) endEpoch
    (by rw [cbE]; exact le_of_eq hE.symm)
  rw [cbE] at ceiling
  have mono := rounded_mono preset.EFFECTIVE_BALANCE_INCREMENT.toNat
    (show cb ≤ actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i + Cr by
      have := Nat.min_le_left (actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i)
        preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat
      omega)
  have split := rounded_add_ceil_le preset.EFFECTIVE_BALANCE_INCREMENT.toNat
    (actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i) Cr incPos
  exact Nat.le_trans ceiling (max_le_max (Nat.le_refl _)
    (Nat.le_trans (Nat.min_le_left _ _) (Nat.le_trans mono split)))

/-- A step that charges a key has it without an exit at its start and with one at its end. -/
private theorem charge_exits {m n : ForkedBeaconState preset} (step : Step config checks m n)
    {v : ℕ} (charged : step.departureCharges.any (·.index == v) = true) :
    ∃ u w, m.state.validators.data[v]? = some u ∧ n.state.validators.data[v]? = some w ∧
      (∀ u', m.state.validators.data[v]? = some u' → u'.exitEpoch = FAR_FUTURE_EPOCH) ∧
      w.exitEpoch ≠ FAR_FUTURE_EPOCH := by
  obtain ⟨c, member, same⟩ := List.any_eq_true.mp charged
  obtain ⟨⟨u, j⟩, found, picked⟩ := List.mem_filterMap.mp member
  have found : m.state.validators.data[j]? = some u := by
    simpa only [List.mem_zipIdx_iff_getElem?, Array.getElem?_toList] using found
  dsimp only at picked
  split at picked
  · cases picked
  · rename_i w located
    split at picked
    · rename_i assigned
      cases Option.some.inj picked
      simp only [Bool.and_eq_true, beq_iff_eq, bne_iff_ne] at assigned
      have : j = v := by simpa using same
      subst this
      refine ⟨u, w, found, located, ?_, assigned.2⟩
      intro u' read
      obtain rfl := Option.some.inj (found.symm.trans read)
      exact assigned.1
    · cases picked

/-- A step that charges a key has it in the registry at its start. -/
private theorem charge_inside {m n : ForkedBeaconState preset} (step : Step config checks m n)
    {v : ℕ} (charged : step.departureCharges.any (·.index == v) = true) :
    v < m.state.validators.data.size :=
  let ⟨_, _, found, _⟩ := charge_exits step charged
  (Array.getElem?_eq_some_iff.mp found).1

/-- The epoch rewards of a key over a run are at most the rate for each epoch of the run.

The steps from the key's departure charge on count, and the key is in the registry from then.

So the bound is needed for a step only when the key is in the registry at its start. -/
private theorem riseScan_snd_le (v high R : ℕ) {x : ForkedBeaconState preset}
    {y : ForkedBeaconState preset} (tail : Run config checks x y)
    (bound : ∀ {m n : ForkedBeaconState preset} (step : Step config checks m n),
      tail.Contains step → v < m.state.validators.data.size →
        PinKeyFloor.epochRewards v step ≤
          ((getCurrentEpoch n.state).toNat - (getCurrentEpoch m.state).toNat) * R) :
    (riseScan (config := config) (checks := checks) v high tail).2 ≤
      ((getCurrentEpoch y.state).toNat - (getCurrentEpoch x.state).toNat) * R := by
  induction tail with
  | nil => simp [riseScan]
  | @snoc m n pre step ih =>
    have prior := ih fun inner member inside => bound inner (.earlier member step) inside
    have xm := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps pre.chainSteps)
    have mn := UInt64.le_iff_toNat_le.mp
      (currentEpoch_le_of_chainSteps (Run.nil.snoc step : Run config checks m n).chainSteps)
    simp only [riseScan]
    split
    · rename_i cond
      have inside : v < m.state.validators.data.size := by
        rcases cond.1 with seen | charged
        · obtain ⟨c, member, same⟩ := (riseScan_fst v high pre).mp seen
          obtain ⟨w, found, -, -⟩ := pre.departure_charge_exit c member
          rw [same] at found
          exact (Array.getElem?_eq_some_iff.mp found).1
        · exact charge_inside step charged
      have one := bound step (.last pre step) inside
      have split : (getCurrentEpoch n.state).toNat - (getCurrentEpoch x.state).toNat =
          ((getCurrentEpoch m.state).toNat - (getCurrentEpoch x.state).toNat) +
            ((getCurrentEpoch n.state).toNat - (getCurrentEpoch m.state).toNat) := by omega
      rw [split, Nat.add_mul]
      omega
    · exact prior.trans (Nat.mul_le_mul_right _ (by omega))

/-- The rise of a charged key on C's branch is one band and the depth's gains at the largest rate.

The gains are the epoch rewards of the key after its exit starts, over the epochs of the run. -/
private theorem riseQ_le (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC v : ℕ) :
    riseQ tailC highC v ≤ preset.upwardBand + (pinTerms config pulled anc fin).depth *
      (pinTerms config pulled anc fin).gainRateMax := by
  classical
  obtain ⟨shared⟩ := h.toFin
  obtain ⟨fromFin⟩ := h.fromFin
  have altair : .altair ≤ fork := Nat.le_trans (by decide) h.fulu
  have finalized := UInt64.le_iff_toNat_le.mp h.finalized
  have called := UInt64.le_iff_toNat_le.mp h.called
  have near := h.near
  unfold riseQ
  split
  swap
  · exact Nat.zero_le _
  obtain ⟨P, -, gainLe, rateAll⟩ := pin_rate_exists h
  have scan := riseScan_snd_le (config := config) (checks := checks) v highC
    (preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat * P *
      (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum / WEIGHT_DENOMINATOR.toNat) tailC
    (fun {m n} step member inside => by
      obtain ⟨pre, post, _, mEarly, mEpoch⟩ :=
        DirectSafety.Apriori.Internal.Run.contains_step_facts member h.early
      have same := fork_eq_of_run pre ((Run.nil.snoc step).append post) (Nat.le_refl _)
      obtain ⟨mf, ms⟩ := m
      obtain rfl : mf = fork := same
      have nEarly : n.fork < .glamsterdam :=
        Nat.lt_of_le_of_lt (fork_le_of_chainSteps post.chainSteps) h.early
      exact PinKeyFloor.epochRewards_le step altair nEarly v (Or.inl inside)
        preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat P
        (.inr (PinSeatDebits.effectiveAt_le_capMax (shared.append (fromFin.append pre)) h.genesis
          h.caps mEarly v))
        (.inr (rateAll (fromFin.append pre) (by simp only at mEpoch ⊢; omega))))
  have depthEq : (pinTerms config pulled anc fin).depth =
      (getCurrentEpoch pulled).toNat + 2 - anc.finalizedCheckpoint.epoch.toNat := rfl
  have epochs : (getCurrentEpoch counted).toNat - (getCurrentEpoch split).toNat ≤
      (pinTerms config pulled anc fin).depth := by omega
  calc _ ≤ preset.upwardBand + (pinTerms config pulled anc fin).depth *
        (preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat *
          P * (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum / WEIGHT_DENOMINATOR.toNat) :=
        Nat.add_le_add_left (scan.trans (Nat.mul_le_mul_right _ epochs)) _
    _ ≤ _ := Nat.add_le_add_left (Nat.mul_le_mul_left _ gainLe) _

/-- A low key is in the registry. -/
private theorem lowB_found (config : Config)
    (state ancestor finalizedState : BeaconState preset fork)
    {i : ℕ} (low : (pinTerms config state ancestor finalizedState).lowB i = true) :
    ∃ w, state.validators.data[i]? = some w := by
  refine validator_of_flag (f := fun v =>
    decide (ancestor.finalizedCheckpoint.epoch.toNat < v.withdrawableEpoch.toNat) &&
      decide (v.activationEpoch.toNat ≤ (getCurrentEpoch state).toNat)) (.inl ?_)
  exact (of_decide_eq_true low).1

/-- A key is low if it is activated, not withdrawable at R, and its low bound is below the floor. -/
private theorem lowB_intro (config : Config)
    (state ancestor finalizedState : BeaconState preset fork)
    {i : ℕ}
    (first : ((state.validators.data[i]?).any fun v =>
      decide (ancestor.finalizedCheckpoint.epoch.toNat < v.withdrawableEpoch.toNat) &&
        decide (v.activationEpoch.toNat ≤ (getCurrentEpoch state).toNat)) = true)
    (low : (pinTerms config state ancestor finalizedState).lowEB i <
      (pinTerms config state ancestor finalizedState).newKeyFloor) :
    (pinTerms config state ancestor finalizedState).lowB i = true :=
  decide_eq_true ⟨first, low⟩

/-- A key whose exit starts on a run is activated at the start of the step that starts it.

The hypothesis `site` is the split of the run at the step that assigns the charged exit.

The activation comes from `ChainStep.exit_assigned_activated` at that step. -/
private theorem charge_activated {x y : ForkedBeaconState preset} (electra : .pectra ≤ x.fork)
    (tail : Run config checks x y) (charge : DepartureCharge)
    (site : ∃ a b, ∃ pre : Run config checks x a, ∃ step : Step config checks a b,
      ∃ post : Run config checks b y, (pre.snoc step).append post = tail ∧
        ∃ v w, a.state.validators.data[charge.index]? = some v ∧
          b.state.validators.data[charge.index]? = some w ∧
          v.exitEpoch = FAR_FUTURE_EPOCH ∧ w.exitEpoch ≠ FAR_FUTURE_EPOCH ∧
          charge.amount = v.effectiveBalance.toNat ∧ charge.epoch = w.exitEpoch.toNat) :
    ∃ a b, ∃ pre : Run config checks x a, ∃ step : Step config checks a b,
      ∃ post : Run config checks b y, (pre.snoc step).append post = tail ∧
        ∃ v w, a.state.validators.data[charge.index]? = some v ∧
          b.state.validators.data[charge.index]? = some w ∧ v.exitEpoch = FAR_FUTURE_EPOCH ∧
          w.exitEpoch ≠ FAR_FUTURE_EPOCH ∧ v.activationEpoch ≤ getCurrentEpoch a.state ∧
          charge.amount = v.effectiveBalance.toNat ∧ charge.epoch = w.exitEpoch.toNat := by
  obtain ⟨a, b, pre, step, post, split, v, w, found, later, unset, set, amount, epoch⟩ := site
  exact ⟨a, b, pre, step, post, split, v, w, found, later, unset, set,
    step.chainStep.exit_assigned_activated
      (Nat.le_trans electra (fork_le_of_chainSteps pre.chainSteps))
      found later unset set, amount, epoch⟩

/-- A charged key activated at the finalized state, and by R's epoch at C, is active at R.

Its activation at R is that of C: an assigned activation does not change.

It is not withdrawable by the finalized epoch at R, since then it would be exited on both branches.

This is the argument of `slashed_waits` for any key.

The split fixes its exit and withdrawable epochs. -/
private theorem activated_key_at_pulled (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (v : ValidatorIndex)
    (activatedBy : ∀ c, counted.validators.data[v.toNat]? = some c →
      c.activationEpoch.toNat ≤ (getCurrentEpoch pulled).toNat) {w : Validator}
    (charged : ∃ c ∈ tailC.departureCharges, c.index = v.toNat)
    (found : fin.validators.data[v.toNat]? = some w)
    (activated : w.activationEpoch ≠ FAR_FUTURE_EPOCH) :
    ((pulled.validators.data[v.toNat]?).any fun u =>
      decide (anc.finalizedCheckpoint.epoch.toNat < u.withdrawableEpoch.toNat) &&
        decide (u.activationEpoch.toNat ≤ (getCurrentEpoch pulled).toNat)) = true := by
  classical
  obtain ⟨fromFin⟩ := h.fromFin
  obtain ⟨toPulled⟩ := h.toPulled
  have near := h.near
  -- the key at the split, at R and at C, with the activation of the finalized state
  obtain ⟨x, foundSplit, lifeFin⟩ := fromFin.registryLifecycle.validators v.toNat w found
  obtain ⟨u, foundPulled, lifeSplit⟩ := toPulled.registryLifecycle.validators v.toNat x foundSplit
  have actSplit : x.activationEpoch = w.activationEpoch := lifeFin.activationEpoch activated
  have actPulled : u.activationEpoch = w.activationEpoch :=
    (lifeSplit.activationEpoch (actSplit ▸ activated)).trans actSplit
  obtain ⟨c, foundCounted, lifeAll⟩ :=
    (fromFin.append tailC).registryLifecycle.validators v.toNat w found
  have actCounted : c.activationEpoch = w.activationEpoch := lifeAll.activationEpoch activated
  have atPulled : u.activationEpoch.toNat ≤ (getCurrentEpoch pulled).toNat := by
    rw [actPulled, ← actCounted]
    exact activatedBy c foundCounted
  -- the key is not withdrawable by the finalized epoch at R, since it has a charge on C's run
  have settled : anc.finalizedCheckpoint.epoch.toNat < u.withdrawableEpoch.toNat := by
    by_contra not
    obtain ⟨d, member, index⟩ := charged
    exact no_charge_of_settled h tailC
      (Array.getElem?_eq_some_iff.mp foundSplit).1 foundPulled (by omega) d member index
  simp [foundPulled, settled, atPulled]

section LowBound

open DirectSafety.Apriori DirectSafety.Apriori.Internal

/-- The penalties of one key in one step fit a rate read at the start of the step. -/
private theorem step_passDebit_le {m n : ForkedBeaconState preset} (step : Step config checks m n)
    (early : n.fork < .glamsterdam) (altair : .altair ≤ m.fork) (high : ℕ)
    (endEpoch : (getCurrentEpoch n.state).toNat ≤ high + 1)
    (startEpoch : (getCurrentEpoch m.state).toNat ≤ high + 1) {v : ℕ}
    (inside : v < m.state.validators.data.size) (pen : ℕ)
    (rate : (getCurrentEpoch m.state).toNat < (getCurrentEpoch n.state).toNat →
      (∃ total perIncrement, getTotalActiveBalance m.state = .ok total ∧
        getBaseRewardPerIncrement preset total = .ok perIncrement) →
      passPenaltyRate config m v ≤ pen)
    {evs : List (BalanceEvent preset)} (replayed : step.balanceEvents = .ok evs) :
    (evs.map (penaltyDebit v)).sum ≤ pen := by
  have run : (Run.nil.snoc step : Run config checks m n).balanceEvents high = .ok evs := by
    simp [Run.balanceEvents, startEpoch, replayed, bind, Except.bind, pure, Except.pure]
  have bound := segment_passDebit_le_guarded (Run.nil.snoc step : Run config checks m n) early
    altair high endEpoch
    (fun {u w} step' member => by
      cases member with
      | last => rfl
      | earlier inner _ => cases inner)
    inside pen
    (fun {z} pre ok split before total => by
      injection split with middle _ _ _
      subst middle
      exact rate before total) run
  refine bound.trans ?_
  split <;> simp

/-- A rate that is linear in the effective balance bounds the two terms of a leak.

It bounds the leak of an aligned balance, and the leak of any balance an increment above, less one.
-/
private theorem leak_linear (inc pi score depth bias quotient : ℕ) (incPos : 0 < inc) :
    ∃ ρn ρd : ℕ, 0 < ρd ∧
      (∀ eb : ℕ, inc ∣ eb →
        2 * (eb / inc * pi) + eb * (score + depth * bias) / (bias * quotient) ≤ ρn * eb / ρd) ∧
      ∀ x : ℕ, ρn * x ≤ ρd * (2 * ((x + inc) / inc * pi) +
        (x + inc) * (score + depth * bias) / (bias * quotient) + 1) := by
  have under : ∀ x : ℕ, x ≤ inc * ((x + inc) / inc) := fun x => by
    rw [Nat.add_div_right _ incPos]
    exact (Nat.lt_mul_div_succ x incPos).le
  by_cases zero : bias * quotient = 0
  · refine ⟨2 * pi, inc, incPos, fun eb aligned => ?_, fun x => ?_⟩
    · obtain ⟨u, rfl⟩ := aligned
      simp only [zero, Nat.div_zero, Nat.add_zero]
      rw [Nat.mul_div_cancel_left _ incPos, show 2 * pi * (inc * u) = inc * (2 * pi * u) by ring,
        Nat.mul_div_cancel_left _ incPos]
      ring_nf
      exact le_refl _
    · simp only [zero, Nat.div_zero, Nat.add_zero]
      calc 2 * pi * x ≤ 2 * pi * (inc * ((x + inc) / inc)) := Nat.mul_le_mul_left _ (under x)
        _ = inc * (2 * ((x + inc) / inc * pi)) := by ring
        _ ≤ inc * (2 * ((x + inc) / inc * pi) + 1) := Nat.mul_le_mul_left _ (by omega)
  · have positive : 0 < bias * quotient := Nat.pos_of_ne_zero zero
    refine ⟨2 * pi * (bias * quotient) + (score + depth * bias) * inc, inc * (bias * quotient),
      Nat.mul_pos incPos positive, fun eb aligned => ?_, fun x => ?_⟩
    · obtain ⟨u, rfl⟩ := aligned
      have lhs : 2 * (inc * u / inc * pi) + inc * u * (score + depth * bias) / (bias * quotient) =
          2 * (u * pi) + (score + depth * bias) * inc * u / (bias * quotient) := by
        rw [Nat.mul_div_cancel_left _ incPos]
        congr 2
        ring
      have rhs : (2 * pi * (bias * quotient) + (score + depth * bias) * inc) * (inc * u) /
          (inc * (bias * quotient)) =
          2 * (u * pi) + (score + depth * bias) * inc * u / (bias * quotient) := by
        rw [show (2 * pi * (bias * quotient) + (score + depth * bias) * inc) * (inc * u) =
          inc * ((bias * quotient) * (2 * (u * pi)) + (score + depth * bias) * inc * u) by ring,
          Nat.mul_div_mul_left _ _ incPos, Nat.mul_add_div positive]
      rw [lhs, rhs]
    · have first := Nat.mul_le_mul_left (bias * quotient * (2 * pi)) (under x)
      have second : (score + depth * bias) * x ≤
          bias * quotient * ((x + inc) * (score + depth * bias) / (bias * quotient) + 1) := by
        have := Nat.lt_mul_div_succ ((x + inc) * (score + depth * bias)) positive
        have mono : (score + depth * bias) * x ≤ (x + inc) * (score + depth * bias) :=
          calc (score + depth * bias) * x = x * (score + depth * bias) := Nat.mul_comm _ _
            _ ≤ (x + inc) * (score + depth * bias) :=
              Nat.mul_le_mul_right _ (Nat.le_add_right _ _)
        omega
      have third := Nat.mul_le_mul_left inc second
      calc (2 * pi * (bias * quotient) + (score + depth * bias) * inc) * x
          = bias * quotient * (2 * pi) * x + inc * ((score + depth * bias) * x) := by ring
        _ ≤ bias * quotient * (2 * pi) * (inc * ((x + inc) / inc)) +
            inc * (bias * quotient *
              ((x + inc) * (score + depth * bias) / (bias * quotient) + 1)) :=
          Nat.add_le_add first third
        _ = inc * (bias * quotient) * (2 * ((x + inc) / inc * pi) +
            (x + inc) * (score + depth * bias) / (bias * quotient) + 1) := by ring

/-- The pass premise of the potential floor, from a rate that is linear in aligned balances. -/
private theorem pass_of_leak (h : Setting config checks g split fin pulled anc counted V)
    {e : BeaconState preset fork} (whole : Run config checks ⟨fork, fin⟩ ⟨fork, e⟩)
    (near : (getCurrentEpoch e).toNat ≤ (getCurrentEpoch pulled).toNat + 1)
    (i : ValidatorIndex) (initial : ∃ val, fin.validators.data[i.toNat]? = some val)
    (ρn ρd : ℕ)
    (leaky : ∀ eb : ℕ, preset.EFFECTIVE_BALANCE_INCREMENT.toNat ∣ eb →
      (pinTerms config pulled anc fin).leakAt eb i.toNat ≤ ρn * eb / ρd) :
    ∀ {m n : ForkedBeaconState preset} (before : Run config checks ⟨fork, fin⟩ m)
      (step : Step config checks m n) (after : Run config checks n ⟨fork, e⟩),
      (before.snoc step).append after = whole → ∀ evs, step.balanceEvents = .ok evs →
      (evs.map (penaltyDebit i.toNat)).sum ≤ ρn * effectiveAt m i.toNat / ρd := by
  obtain ⟨shared⟩ := h.toFin
  obtain ⟨val, initial⟩ := initial
  have altair : .altair ≤ fork := Nat.le_trans (by decide) h.fulu
  intro m n pre step post cut evs ok
  have same := fork_eq_of_run pre ((Run.nil.snoc step).append post) (Nat.le_refl _)
  have startE : (getCurrentEpoch m.state).toNat ≤ (getCurrentEpoch pulled).toNat + 1 := by
    have := UInt64.le_iff_toNat_le.mp
      (currentEpoch_le_of_chainSteps ((Run.nil.snoc step).append post).chainSteps)
    simp only at this
    omega
  have endE : (getCurrentEpoch n.state).toNat ≤ (getCurrentEpoch pulled).toNat + 1 := by
    have := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps post.chainSteps)
    simp only at this
    omega
  have nEarly : n.fork < .glamsterdam :=
    Nat.lt_of_le_of_lt (fork_le_of_chainSteps post.chainSteps) h.early
  have mSize := registryGrows_of_chainSteps pre.chainSteps
  obtain ⟨mf, ms⟩ := m
  obtain rfl : mf = fork := same
  have inside : i.toNat < ms.validators.data.size :=
    Nat.lt_of_lt_of_le (Array.getElem?_eq_some_iff.mp initial).1 mSize
  refine step_passDebit_le step nEarly altair (getCurrentEpoch pulled).toNat endE startE inside
    (ρn * effectiveAt ⟨mf, ms⟩ i.toNat / ρd) (fun _ total => ?_) ok
  obtain ⟨T, perIncrement, totalOk, perOk⟩ := total
  obtain ⟨pq, pqOk⟩ :=
    quarter_base_ok h.facts perOk ((getTotalActiveBalance pulled).toOption.getD 0)
  have rate := passRate_le_leakAt h pre startE totalOk pqOk i.toNat
  exact rate.trans (leaky _ (Nat.dvd_of_mod_eq_zero
    (FloorTrace.effective_aligned (shared.append pre) h.genesis h.aligned i.toNat)))

/-- The floor of the potential, in naturals.

It is the closed form less the debits, the band and the carried shortfall. -/
private def potentialFloor (ρn ρd K X band slack cost : ℕ) : ℕ :=
  ((ρd - ρn * K) * (X + band) - ρn * slack) / ρd - (band + cost)

/-- The queued partials of the key at the finalized state that are due by the call's cutoff.

They are at most the key's `partialsDue`. -/
private theorem partials_le_due (electra : .pectra ≤ fork) (v : ValidatorIndex) :
    ((((fin.pendingPartialWithdrawals electra).data.toList.filter
        fun entry => decide (entry.validatorIndex = v)).filter
          (fun entry => entry.withdrawableEpoch.toNat ≤ (getCurrentEpoch pulled).toNat + 1)).map
            (·.amount.toNat)).sum ≤
      (pinTerms config pulled anc fin).partialsDue v.toNat := by
  rw [← dueAmount_eq fin electra v]
  refine le_trans ?_ (le_max_left (_ : ℕ) _)
  dsimp only
  simp only [PinTerms.dueAmount, electra, ↓reduceDIte]
  exact le_rfl

/-- The partials paid to a key over a run from the finalized state are at most those due.

The run ends by the call's cutoff, which is within the withdrawal delay of the finalized state. -/
private theorem run_partials_le_due (h : Setting config checks g split fin pulled anc counted V)
    {e : BeaconState preset fork} (whole : Run config checks ⟨fork, fin⟩ ⟨fork, e⟩)
    (near : (getCurrentEpoch e).toNat ≤ (getCurrentEpoch pulled).toNat + 1) (v : ValidatorIndex)
    {events : List (BalanceEvent preset)}
    (replayed : whole.balanceEvents (getCurrentEpoch pulled).toNat = .ok events) :
    (events.map (floorPartialDebit v)).sum ≤
      (pinTerms config pulled anc fin).partialsDue v.toNat := by
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  exact (Run.partialDebit_le whole electra h.early (getCurrentEpoch pulled).toNat
    ((getCurrentEpoch pulled).toNat + 1) near (window_short h) v replayed).trans
    (partials_le_due electra v)

/-- The effective balance of a key at a state of the run from the finalized state, before its exit.

It is at least the least of its effective balance and cap at the finalized state.

It is also at least the floor of its potential, rounded down to an increment.

The floor loses the shortfall of the balance below the stored effective balance.

It also loses the debits, which are the sync debits of the run and the partials due. -/
private theorem exitQ_at (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩)
    {events : List (BalanceEvent preset)}
    (replayed : (fromFin.append tailC).balanceEvents (getCurrentEpoch pulled).toNat = .ok events)
    {sd : ForkedBeaconState preset} (pre : Run config checks ⟨fork, fin⟩ sd)
    (post : Run config checks sd ⟨fork, counted⟩)
    (cut : pre.append post = fromFin.append tailC)
    (v : ValidatorIndex) (val : Validator)
    (initial : fin.validators.data[v.toNat]? = some val)
    (far : ∀ w, sd.state.validators.data[v.toNat]? = some w → w.exitEpoch = FAR_FUTURE_EPOCH)
    (ρn ρd : ℕ)
    (leaky : ∀ eb : ℕ, preset.EFFECTIVE_BALANCE_INCREMENT.toNat ∣ eb →
      (pinTerms config pulled anc fin).leakAt eb v.toNat ≤ ρn * eb / ρd) :
    min (effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat)
        (min (withdrawalMaxEffectiveBalance preset fork val).toNat
          (potentialFloor ρn ρd ((getCurrentEpoch counted).toNat - (getCurrentEpoch fin).toNat)
              (min (actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat)
                (withdrawalMaxEffectiveBalance preset fork val).toNat)
              preset.downwardBand (effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat -
                actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat)
              ((events.map (syncDebit v.toNat)).sum +
                (pinTerms config pulled anc fin).partialsDue v.toNat) -
            potentialFloor ρn ρd ((getCurrentEpoch counted).toNat - (getCurrentEpoch fin).toNat)
              (min (actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat)
                (withdrawalMaxEffectiveBalance preset fork val).toNat)
              preset.downwardBand (effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat -
                actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat)
              ((events.map (syncDebit v.toNat)).sum +
                (pinTerms config pulled anc fin).partialsDue v.toNat) %
              preset.EFFECTIVE_BALANCE_INCREMENT.toNat)) ≤
      effectiveAt sd v.toNat := by
  have nearC := h.near
  have same := fork_eq_of_run pre post (Nat.le_refl _)
  obtain ⟨sf, se⟩ := sd
  obtain rfl : fork = sf := same.symm
  have toCounted := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps post.chainSteps)
  simp only at toCounted
  have near : (getCurrentEpoch se).toNat ≤ (getCurrentEpoch pulled).toNat + 1 := by omega
  obtain ⟨before, beforeOk, isPrefix⟩ := Run.balanceEvents_prefix pre post
    (getCurrentEpoch pulled).toNat events (by rw [cut]; exact replayed)
  have clean : ∀ w, se.validators.data[v.toNat]? = some w → w.slashed = false := by
    obtain ⟨shared⟩ := h.toFin
    intro w found
    by_contra slashed
    exact run_slashed_exit_assigned (shared.append pre) h.genesis h.caps.activation
      h.caps.compounding h.early h.delay v.toNat w found (by simpa using slashed) (far w found)
  have retained : ∀ {m n : ForkedBeaconState preset} (b : Run config checks ⟨fork, fin⟩ m)
      (step : Step config checks m n) (a : Run config checks n ⟨fork, se⟩),
      (b.snoc step).append a = pre → ∀ w, n.state.validators.data[v.toNat]? = some w →
      (getCurrentEpoch pulled).toNat + 1 < w.exitEpoch.toNat ∨
        ∀ u, m.state.validators.data[v.toNat]? = some u →
          (getCurrentEpoch pulled).toNat + 1 < u.withdrawableEpoch.toNat := by
    intro m n b step a cut' w found
    obtain ⟨last, located, kept⟩ := a.registryLifecycle.validators v.toNat w found
    by_cases e : w.exitEpoch = FAR_FUTURE_EPOCH
    · rw [e]
      exact .inl (getCurrentEpoch_succ_lt_farFuture h.twoSlots pulled)
    · exact absurd ((kept.exitEpoch e).symm.trans (far last located)) e
  have syncLe : (before.map (syncDebit v.toNat)).sum ≤ (events.map (syncDebit v.toNat)).sum :=
    (isPrefix.sublist.map (syncDebit v.toNat)).sum_le_sum fun _ _ => Nat.zero_le _
  have partialLe : (before.map (floorPartialDebit v)).sum ≤
      (pinTerms config pulled anc fin).partialsDue v.toNat :=
    run_partials_le_due h pre near v beforeOk
  have final := cfloor_endpoint h se pre near beforeOk v val initial clean retained
    (effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat -
      actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat) ρn ρd
    (potentialFloor ρn ρd ((getCurrentEpoch counted).toNat - (getCurrentEpoch fin).toNat)
      (min (actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat)
        (withdrawalMaxEffectiveBalance preset fork val).toNat)
      preset.downwardBand (effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat -
        actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat)
      ((before.map (syncDebit v.toNat)).sum + (before.map (floorPartialDebit v)).sum))
    (by omega)
    (pass_of_leak h pre near v ⟨val, initial⟩ ρn ρd leaky)
    (fun a D k hk hD closed => by
      have mono : ρd - ρn * ((getCurrentEpoch counted).toNat - (getCurrentEpoch fin).toNat) ≤
          ρd - ρn * k :=
        Nat.sub_le_sub_left (Nat.mul_le_mul_left _ (hk.trans (Nat.sub_le_sub_right toCounted _))) _
      have step2 := (Nat.mul_le_mul_right _ mono).trans closed
      have step3 := Nat.div_le_of_le_mul (Nat.sub_le_of_le_add step2)
      unfold potentialFloor
      omega)
    pre Run.nil rfl
  refine le_trans (min_le_min le_rfl (min_le_min le_rfl (rounded_mono _ ?_))) final
  unfold potentialFloor
  omega

/-- The charge of a key on C's run is its effective balance at a state where its exit is unset.

The state is the stop of the charge.

The runs to it and from it make C's run from the finalized block. -/
private theorem exit_stop (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (v : ℕ)
    (charged : ∃ c ∈ tailC.departureCharges, c.index = v)
    (epochLe : ∀ c ∈ tailC.departureCharges, c.index = v →
      c.epoch ≤ (getCurrentEpoch counted).toNat) :
    ∃ (sd : ForkedBeaconState preset) (pre : Run config checks ⟨fork, fin⟩ sd)
        (post : Run config checks sd ⟨fork, counted⟩),
      pre.append post = fromFin.append tailC ∧
      (∀ w, sd.state.validators.data[v]? = some w → w.exitEpoch = FAR_FUTURE_EPOCH) ∧
      exitQ tailC v = effectiveAt sd v := by
  classical
  obtain ⟨c0, member0, index0, -, amount0⟩ : ∃ c ∈ tailC.departureCharges,
      c.index = v ∧ c.epoch ≤ (getCurrentEpoch counted).toNat ∧ exitQ tailC v = c.amount := by
    obtain ⟨c, mem, idx⟩ := charged
    rcases exitQ_cases tailC v with ⟨none, -⟩ | found
    · exact absurd (epochLe c mem idx) (none c mem idx)
    · exact found
  obtain ⟨stop, chosen⟩ := stop_of_charge fromFin tailC member0 index0
  have selected := stop.selected
  rw [chosen] at selected
  obtain ⟨-, -, amount, next, assignedStep, rest, split', charged', vv, w, atStop, atNext,
    unset, assigned, epoch⟩ := selected
  refine ⟨stop.state, stop.pre, stop.post, stop.split, fun w' found => ?_, by rw [amount0, amount]⟩
  have same := Option.some.inj (found.symm.trans atStop)
  subst same
  exact unset

/-- The key's effective balance at its exit call, from the potential floor of the run to the call.

The key is activated at the finalized state, charged on the run from the split, and exits by C. -/
private theorem exitQ_potential (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩)
    {events : List (BalanceEvent preset)}
    (replayed : (fromFin.append tailC).balanceEvents (getCurrentEpoch pulled).toNat = .ok events)
    (v : ValidatorIndex)
    (epochLe : ∀ c ∈ tailC.departureCharges, c.index = v.toNat →
      c.epoch ≤ (getCurrentEpoch counted).toNat) (val : Validator)
    (initial : fin.validators.data[v.toNat]? = some val)
    (charged : ∃ c ∈ tailC.departureCharges, c.index = v.toNat)
    (ρn ρd : ℕ)
    (leaky : ∀ eb : ℕ, preset.EFFECTIVE_BALANCE_INCREMENT.toNat ∣ eb →
      (pinTerms config pulled anc fin).leakAt eb v.toNat ≤ ρn * eb / ρd) :
    min (effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat)
        (min (withdrawalMaxEffectiveBalance preset fork val).toNat
          (potentialFloor ρn ρd ((getCurrentEpoch counted).toNat - (getCurrentEpoch fin).toNat)
              (min (actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat)
                (withdrawalMaxEffectiveBalance preset fork val).toNat)
              preset.downwardBand (effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat -
                actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat)
              ((events.map (syncDebit v.toNat)).sum +
                (pinTerms config pulled anc fin).partialsDue v.toNat) -
            potentialFloor ρn ρd ((getCurrentEpoch counted).toNat - (getCurrentEpoch fin).toNat)
              (min (actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat)
                (withdrawalMaxEffectiveBalance preset fork val).toNat)
              preset.downwardBand (effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat -
                actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat)
              ((events.map (syncDebit v.toNat)).sum +
                (pinTerms config pulled anc fin).partialsDue v.toNat) %
              preset.EFFECTIVE_BALANCE_INCREMENT.toNat)) ≤
      exitQ tailC v.toNat := by
  obtain ⟨sd, pre, post, cut, far, amount⟩ := exit_stop fromFin tailC v.toNat charged epochLe
  rw [amount]
  exact exitQ_at h fromFin tailC replayed pre post cut v val initial far ρn ρd leaky

/-- The leak of an aligned effective balance is at most a rate times it.

The rate times any balance is at most the leak an increment above, plus one. -/
private theorem leak_rate (config : Config) (pulled anc fin : BeaconState preset fork)
    (incPos : 0 < preset.EFFECTIVE_BALANCE_INCREMENT.toNat) (v : ℕ) :
    ∃ ρn ρd : ℕ, 0 < ρd ∧
      (∀ eb : ℕ, preset.EFFECTIVE_BALANCE_INCREMENT.toNat ∣ eb →
        (pinTerms config pulled anc fin).leakAt eb v ≤ ρn * eb / ρd) ∧
      ∀ x : ℕ, ρn * x ≤ ρd * ((pinTerms config pulled anc fin).leakAt
        (x + preset.EFFECTIVE_BALANCE_INCREMENT.toNat) v + 1) := by
  obtain ⟨ρn, ρd, positive, bound, above⟩ := leak_linear preset.EFFECTIVE_BALANCE_INCREMENT.toNat
    ((getBaseRewardPerIncrement preset
      (if 18 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤
          ((getTotalActiveBalance pulled).toOption.getD 0).toNat then
        (getTotalActiveBalance pulled).toOption.getD 0 / 4
      else preset.EFFECTIVE_BALANCE_INCREMENT / 5)).toOption.getD 0).toNat
    (if altair : .altair ≤ fork then
      (((fin.inactivityScores altair).data[v]?).map (·.toNat)).getD 0 else 0)
    ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat)
    config.INACTIVITY_SCORE_BIAS.toNat
    (parameters preset fork).INACTIVITY_PENALTY_QUOTIENT.toNat incPos
  exact ⟨ρn, ρd, positive, fun eb aligned => bound eb aligned, fun x => above x⟩

/-- The rate times the epochs and the base is at most the leak for each epoch, plus one.

The leak is read an increment above the base. -/
private theorem rate_cost (ρn ρd K L Y : ℕ) (first : ρn * Y ≤ ρd * (L + 1)) :
    ρn * K * Y ≤ ρd * (K * (L + 1)) :=
  calc ρn * K * Y = K * (ρn * Y) := by ring
    _ ≤ K * (ρd * (L + 1)) := Nat.mul_le_mul_left _ first
    _ = ρd * (K * (L + 1)) := by ring

/-- The leak at a base, for each epoch of the depth, covers the base's share of the closed form.

The rate bounds the base by the leak an increment above it, plus one.

The closed form takes the rate for each epoch from the base, and its rest is the base's share. -/
private theorem rate_step (ρn ρd K L Y : ℕ) (first : ρn * Y ≤ ρd * (L + 1)) :
    ρd * Y ≤ (ρd - ρn * K) * Y + ρd * (K * (L + 1)) := by
  have rate := rate_cost ρn ρd K L Y first
  have cover : ρd ≤ (ρd - ρn * K) + ρn * K := by omega
  calc ρd * Y ≤ ((ρd - ρn * K) + ρn * K) * Y := Nat.mul_le_mul_right _ cover
    _ = (ρd - ρn * K) * Y + ρn * K * Y := by ring
    _ ≤ (ρd - ρn * K) * Y + ρd * (K * (L + 1)) := Nat.add_le_add_left rate _

/-- The arithmetic of the low bound of an existing key.

The potential floor, rounded down to an increment, is at least the bound less the sync debits.

`L1` and `L2` are the leaks an increment above the base and above the shortfall.

The rate bounds the base and the shortfall by them, plus one each.

`R` is the bound before its drop, and it is at most the base less the partials due. -/
private theorem low_arith (inc band ρn ρd K depth X s R pd sync L1 L2 E0 cap : ℕ)
    (positive : 0 < ρd) (incPos : 0 < inc)
    (first : ρn * X ≤ ρd * (L1 + 1)) (second : ρn * s ≤ ρd * (L2 + 1)) (epochs : K ≤ depth)
    (baseLe : R ≤ X - pd) (effLe : R ≤ E0) (capLe : E0 ≤ cap) :
    R - ((L2 + 1) + depth * (L1 + 1) + band + inc) ≤
      min E0 (min cap
        (((ρd - ρn * K) * (X + band) - ρn * s) / ρd - (band + (sync + pd)) -
          (((ρd - ρn * K) * (X + band) - ρn * s) / ρd - (band + (sync + pd))) % inc)) + sync := by
  have depthMul : K * (L1 + 1) ≤ depth * (L1 + 1) := Nat.mul_le_mul_right _ epochs
  suffices rounded : R - ((L2 + 1) + depth * (L1 + 1) + band + inc) ≤
      (((ρd - ρn * K) * (X + band) - ρn * s) / ρd - (band + (sync + pd)) -
        (((ρd - ρn * K) * (X + band) - ρn * s) / ρd - (band + (sync + pd))) % inc) + sync by
    omega
  generalize hF : ((ρd - ρn * K) * (X + band) - ρn * s) / ρd - (band + (sync + pd)) = F
  have modLt := Nat.mod_lt F incPos
  have modLe := Nat.mod_le F inc
  by_cases big : ρd ≤ ρn * K
  · -- the closed form is vacuous, and the leak already covers the base
    have zero : ρd - ρn * K = 0 := Nat.sub_eq_zero_of_le big
    rw [zero, Nat.zero_mul, Nat.zero_sub, Nat.zero_div, Nat.zero_sub] at hF
    have step := rate_step ρn ρd K L1 X first
    rw [zero, Nat.zero_mul, Nat.zero_add] at step
    have base := Nat.le_of_mul_le_mul_left step positive
    omega
  · have step := rate_step ρn ρd K L1 X first
    have mono : (ρd - ρn * K) * X ≤ (ρd - ρn * K) * (X + band) :=
      Nat.mul_le_mul_left _ (Nat.le_add_right _ _)
    have bound := Nat.lt_mul_div_succ
      ((ρd - ρn * K) * (X + band) - ρn * s) positive
    have total : ρd * (X + band) ≤ ((ρd - ρn * K) * (X + band) - ρn * s) + ρn * s +
        ρd * (K * (L1 + 1)) + ρd * band := by
      have split : ρd * (X + band) = ρd * X + ρd * band := by ring
      omega
    have lt : ρd * (X + band) < ρd * (((ρd - ρn * K) * (X + band) - ρn * s) / ρd + 1 +
        (L2 + 1) + K * (L1 + 1) + band) := by
      calc ρd * (X + band) ≤ _ := total
        _ < ρd * (((ρd - ρn * K) * (X + band) - ρn * s) / ρd + 1) + ρd * (L2 + 1) +
              ρd * (K * (L1 + 1)) + ρd * band := by omega
        _ = _ := by ring
    have cancel := Nat.lt_of_mul_lt_mul_left lt
    generalize ((ρd - ρn * K) * (X + band) - ρn * s) / ρd = W at cancel hF
    omega

/-- The low bound of an existing key, against the `lowEB` and `drop` of the reserve.

The key is activated at the finalized state, charged on the run from the split, and exits by C.

The bound is its effective balance at the call, less its sync debits.

The form of `drop` carries the shortfall of the balance below the stored effective balance once.

It carries the leak at the base for each epoch of the depth. -/
private theorem existing_low_explicit
    (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩)
    {events : List (BalanceEvent preset)}
    (replayed : (fromFin.append tailC).balanceEvents (getCurrentEpoch pulled).toNat = .ok events)
    (v : ValidatorIndex)
    (epochLe : ∀ c ∈ tailC.departureCharges, c.index = v.toNat →
      c.epoch ≤ (getCurrentEpoch counted).toNat) (val : Validator)
    (initial : fin.validators.data[v.toNat]? = some val)
    (charged : ∃ c ∈ tailC.departureCharges, c.index = v.toNat) :
    min (min (min (balanceAt pulled v.toNat) (balanceAt fin v.toNat))
          (actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat) -
        (pinTerms config pulled anc fin).partialsDue v.toNat)
      preset.MIN_ACTIVATION_BALANCE.toNat -
      (((pinTerms config pulled anc fin).leakAt
          (balanceAt fin v.toNat -
            actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat +
            preset.EFFECTIVE_BALANCE_INCREMENT.toNat) v.toNat + 1) +
        ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) *
          ((pinTerms config pulled anc fin).leakAt
            (min (actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat)
              (withdrawalMaxEffectiveBalance preset fork val).toNat +
              preset.EFFECTIVE_BALANCE_INCREMENT.toNat) v.toNat + 1) +
        preset.downwardBand + preset.EFFECTIVE_BALANCE_INCREMENT.toNat) ≤
      exitQ tailC v.toNat + (events.map (syncDebit v.toNat)).sum := by
  obtain ⟨shared⟩ := h.toFin
  obtain ⟨ρn, ρd, positive, leaky, above⟩ := leak_rate config pulled anc fin h.bands.1 v.toNat
  have potential := exitQ_potential h fromFin tailC replayed v epochLe val initial charged ρn ρd
    leaky
  have finEB : balanceAt fin v.toNat =
      effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat := rfl
  have capped : effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat ≤
      (withdrawalMaxEffectiveBalance preset fork val).toNat :=
    DirectSafety.Apriori.Internal.effectiveAt_le_withdrawalMax shared h.genesis h.caps h.early
      initial
  have toCounted := UInt64.le_iff_toNat_le.mp h.later
  have nearC := h.near
  have arith := low_arith preset.EFFECTIVE_BALANCE_INCREMENT.toNat preset.downwardBand ρn ρd
    ((getCurrentEpoch counted).toNat - (getCurrentEpoch fin).toNat)
    ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat)
    (min (actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat)
      (withdrawalMaxEffectiveBalance preset fork val).toNat)
    (effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat -
      actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat)
    (min (min (min (balanceAt pulled v.toNat) (balanceAt fin v.toNat))
          (actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat) -
        (pinTerms config pulled anc fin).partialsDue v.toNat)
      preset.MIN_ACTIVATION_BALANCE.toNat)
    ((pinTerms config pulled anc fin).partialsDue v.toNat) (events.map (syncDebit v.toNat)).sum
    ((pinTerms config pulled anc fin).leakAt
      (min (actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat)
        (withdrawalMaxEffectiveBalance preset fork val).toNat +
        preset.EFFECTIVE_BALANCE_INCREMENT.toNat) v.toNat)
    ((pinTerms config pulled anc fin).leakAt
      (effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat -
        actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat +
        preset.EFFECTIVE_BALANCE_INCREMENT.toNat) v.toNat)
    (effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat)
    (withdrawalMaxEffectiveBalance preset fork val).toNat positive h.bands.1 (above _) (above _)
    (by omega) (by omega) (by omega) capped
  simp only [potentialFloor] at potential
  exact le_trans arith (Nat.add_le_add_right potential _)

/-- The relaxed closed form, read at `a + X / M`, is the unslashed one with one more pass.

`Y` stands for `max finEB base0`.

`X` is the argument of `flagged`'s slashing loss. -/
private theorem bridge (ρn ρd M k B0 DOWN slack a D X Y inc : Nat) (hM : 2 ≤ M)
    (closed : (M - 1) * ((ρd - ρn * (k + 1)) * (B0 + DOWN)) ≤
      M * (ρd * (a + D + DOWN) + ρn * slack) + ρd * (DOWN + slack))
    (hB : B0 + slack ≤ Y) (hX : Y + inc ≤ X) (hinc : M + 2 * DOWN ≤ inc + 1) :
    (ρd - ρn * (k + 1)) * (B0 + DOWN) ≤ ρd * (a + X / M + D + DOWN) + ρn * slack := by
  have hMpos : 0 < M := by omega
  have hq : X < M * (X / M + 1) := by
    have := Nat.lt_mul_div_succ X hMpos
    simpa [Nat.mul_comm] using this
  have hV : ρd - ρn * (k + 1) ≤ ρd := Nat.sub_le _ _
  have hP : (ρd - ρn * (k + 1)) * (B0 + DOWN) ≤ ρd * (B0 + DOWN) :=
    Nat.mul_le_mul_right _ hV
  have hsplit : M * ((ρd - ρn * (k + 1)) * (B0 + DOWN)) =
      (M - 1) * ((ρd - ρn * (k + 1)) * (B0 + DOWN)) +
        (ρd - ρn * (k + 1)) * (B0 + DOWN) := by
    obtain ⟨m, rfl⟩ : ∃ m, M = m + 1 := ⟨M - 1, by omega⟩
    simp [Nat.add_mul]
  have hfit : B0 + 2 * DOWN + slack ≤ M * (X / M) := by
    have : M * (X / M + 1) = M * (X / M) + M := by rw [Nat.mul_add, Nat.mul_one]
    omega
  have hρ : ρd * (B0 + 2 * DOWN + slack) ≤ ρd * (M * (X / M)) := Nat.mul_le_mul_left _ hfit
  have hlhs : M * ((ρd - ρn * (k + 1)) * (B0 + DOWN)) ≤
      M * (ρd * (a + D + DOWN) + ρn * slack) + ρd * (M * (X / M)) := by
    have e1 : ρd * (B0 + 2 * DOWN + slack) = ρd * (B0 + DOWN) + ρd * (DOWN + slack) := by
      rw [← Nat.mul_add]; congr 1; omega
    omega
  have hrhs : M * (ρd * (a + X / M + D + DOWN) + ρn * slack) =
      M * (ρd * (a + D + DOWN) + ρn * slack) + ρd * (M * (X / M)) := by
    have e2 : ρd * (a + X / M + D + DOWN) = ρd * (a + D + DOWN) + ρd * (X / M) := by
      rw [← Nat.mul_add]; congr 1; omega
    rw [e2, Nat.add_right_comm (ρd * (a + D + DOWN)), Nat.mul_add, Nat.mul_add,
      Nat.mul_left_comm M ρd (X / M)]
  exact Nat.le_of_mul_le_mul_left (by omega) hMpos

/-- The arithmetic of the margin of the floor of a key on C's run.

The closed form of the potential floor, less the sync debits, is at least the base less the fall.

The fall holds the leak at the base and the band for each epoch of the depth, and the carry.

`L1` and `L2` are the leaks an increment above the base with the band and above the shortfall.

The rate bounds the base with the band and the shortfall by them, plus one each. -/
private theorem margin_arith (ρn ρd K depth B band s L1 L2 pd sync D a X : ℕ)
    (positive : 0 < ρd) (first : ρn * (B + band) ≤ ρd * (L1 + 1))
    (second : ρn * s ≤ ρd * (L2 + 1)) (epochs : K ≤ depth)
    (fall : (L2 + 1) + depth * (L1 + 1) + pd ≤ X) (debit : D ≤ sync + pd)
    (closed : (ρd - ρn * K) * (B + band) ≤ ρd * (a + D + band) + ρn * s) :
    B - X - sync ≤ a := by
  have depthMul : K * (L1 + 1) ≤ depth * (L1 + 1) := Nat.mul_le_mul_right _ epochs
  have step := rate_step ρn ρd K L1 (B + band) first
  have spread : ρd * (a + D + band + (L2 + 1) + K * (L1 + 1)) =
      ρd * (a + D + band) + ρd * (L2 + 1) + ρd * (K * (L1 + 1)) := by ring
  have total : ρd * (B + band) ≤ ρd * (a + D + band + (L2 + 1) + K * (L1 + 1)) := by omega
  have cancel := Nat.le_of_mul_le_mul_left total positive
  omega

/-- The arithmetic of the stay of the effective balance of a key on C's run.

The key has no sync debits, and the test of its floor holds.

An effective balance above the finalized one is at least an increment above it.

A segment of the run from a state with that effective balance ends at a balance of at least M.

Here `M` is the finalized effective balance.

The segment loses the rate of the leak for each epoch and the partials due.

The rate bounds the base with the band by the leak, and the test bounds the fall by the band.

A quarter of an increment bounds the band, as the preset requires. -/
private theorem stay_arith (ρn ρd K k depth inc band B M Bw X pd D bal L1 L2 : ℕ)
    (positive : 0 < ρd) (incPos : 0 < inc) (quarter : 4 * band ≤ inc) (big : inc ≤ M)
    (testB : M ≤ B + band) (fallX : X ≤ band) (first : ρn * (B + band) ≤ ρd * (L1 + 1))
    (fall : (L2 + 1) + depth * (L1 + 1) + pd ≤ X) (epochs : k ≤ K) (depthK : K ≤ depth)
    (start : M + inc ≤ Bw) (debit : D ≤ pd)
    (closed : (ρd - ρn * k) * (Bw + band) ≤ ρd * (bal + D + band)) : M ≤ bal := by
  have cost := rate_cost ρn ρd K L1 (B + band) first
  have depthMul : K * (L1 + 1) ≤ depth * (L1 + 1) := Nat.mul_le_mul_right _ depthK
  have rate : ρn * K * (B + band) + ρd * pd ≤ ρd * X := by
    have fits : ρd * (K * (L1 + 1) + pd) ≤ ρd * X := Nat.mul_le_mul_left ρd (by omega)
    rw [Nat.mul_add] at fits
    omega
  have yPos : 0 < B + band := by omega
  have bound : ρn * K * (B + band) ≤ ρd * (B + band) :=
    calc ρn * K * (B + band) ≤ ρd * X := by omega
      _ ≤ ρd * band := Nat.mul_le_mul_left _ fallX
      _ ≤ ρd * (B + band) := Nat.mul_le_mul_left _ (by omega)
  have under : ρn * K ≤ ρd := Nat.le_of_mul_le_mul_right bound yPos
  have fewer : ρn * k ≤ ρd := Nat.le_trans (Nat.mul_le_mul_left ρn epochs) under
  have mono : (ρd - ρn * k) * (M + inc + band) ≤ (ρd - ρn * k) * (Bw + band) :=
    Nat.mul_le_mul_left _ (by omega)
  have split : ρd * (M + inc + band) =
      (ρd - ρn * k) * (M + inc + band) + ρn * k * (M + inc + band) :=
    calc ρd * (M + inc + band) = ((ρd - ρn * k) + ρn * k) * (M + inc + band) := by
          rw [Nat.sub_add_cancel fewer]
      _ = _ := by ring
  have loss : ρn * k * (M + inc + band) ≤ 3 * (ρn * K * (B + band)) :=
    calc ρn * k * (M + inc + band) ≤ ρn * K * (M + inc + band) :=
          Nat.mul_le_mul_right _ (Nat.mul_le_mul_left ρn epochs)
      _ ≤ ρn * K * (3 * (B + band)) := Nat.mul_le_mul_left _ (by omega)
      _ = 3 * (ρn * K * (B + band)) := by ring
  have left : ρd * (M + inc + band + 3 * pd) = ρd * (M + inc + band) + 3 * (ρd * pd) := by ring
  have right : ρd * (bal + D + band + 3 * X) = ρd * (bal + D + band) + 3 * (ρd * X) := by ring
  have total : ρd * (M + inc + band + 3 * pd) ≤ ρd * (bal + D + band + 3 * X) := by omega
  have cancel := Nat.le_of_mul_le_mul_left total positive
  omega

/-- The margin of the floor of a key on C's run, from a rate of its leak.

The rate is `leak_rate`'s for the key.

The balance of the key from the finalized block is above the closed form of the potential floor.

The closed form reads the rate that `leak_rate` gives and the shortfall of the balance.

It also reads the debits of the run, which are its sync debits and its partials.

The partials are at most those due.

`low` is the base less `X`.

`X` is at least the fall.

The fall is the carry, the leak for each epoch of the depth, and the partials due.

The leak is read at the base with the band. -/
private theorem floorC_margin (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩)
    {events : List (BalanceEvent preset)}
    (replayed : (fromFin.append tailC).balanceEvents (getCurrentEpoch pulled).toNat = .ok events)
    (i : ValidatorIndex) (val : Validator) (initial : fin.validators.data[i.toNat]? = some val)
    (ρn ρd : ℕ) (positive : 0 < ρd)
    (leaky : ∀ eb : ℕ, preset.EFFECTIVE_BALANCE_INCREMENT.toNat ∣ eb →
      (pinTerms config pulled anc fin).leakAt eb i.toNat ≤ ρn * eb / ρd)
    (above : ∀ x : ℕ, ρn * x ≤ ρd * ((pinTerms config pulled anc fin).leakAt
      (x + preset.EFFECTIVE_BALANCE_INCREMENT.toNat) i.toNat + 1))
    (base0 X low : ℕ)
    (hbase0 : base0 = min (actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat)
      (withdrawalMaxEffectiveBalance preset fork val).toNat)
    (hlow : low = base0 - X)
    (fall : ((pinTerms config pulled anc fin).leakAt
          (effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat -
            actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat +
              preset.EFFECTIVE_BALANCE_INCREMENT.toNat) i.toNat + 1) +
        ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) *
          ((pinTerms config pulled anc fin).leakAt
            (base0 + preset.downwardBand + preset.EFFECTIVE_BALANCE_INCREMENT.toNat) i.toNat + 1) +
        (pinTerms config pulled anc fin).partialsDue i.toNat ≤ X) :
    ∃ slack : ℕ,
      effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat ≤
        actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat +
          (preset.downwardBand + slack) ∧
      (∀ {m n : ForkedBeaconState preset} (before : Run config checks ⟨fork, fin⟩ m)
        (step : Step config checks m n) (after : Run config checks n ⟨fork, counted⟩),
        (before.snoc step).append after = fromFin.append tailC → ∀ evs,
        step.balanceEvents = .ok evs →
        (evs.map (penaltyDebit i.toNat)).sum ≤ ρn * effectiveAt m i.toNat / ρd) ∧
      ∀ a D k : ℕ, k ≤ (getCurrentEpoch counted).toNat - (getCurrentEpoch fin).toNat →
        D ≤ (events.map (syncDebit i.toNat)).sum + (events.map (floorPartialDebit i)).sum →
        (ρd - ρn * k) * (min (actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat)
            (withdrawalMaxEffectiveBalance preset fork val).toNat +
          preset.downwardBand) ≤ ρd * (a + D + preset.downwardBand) + ρn * slack →
        low - (events.map (syncDebit i.toNat)).sum ≤ a := by
  have nearC := h.near
  have partialLe := run_partials_le_due h (fromFin.append tailC) nearC i replayed
  refine ⟨effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat -
    actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat, by omega,
    pass_of_leak h (fromFin.append tailC) nearC i ⟨val, initial⟩ ρn ρd leaky,
    fun a D k hk hD closed => ?_⟩
  rw [← hbase0] at closed
  have bound := margin_arith ρn ρd k
    ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) base0
    preset.downwardBand
    (effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat -
      actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat)
    ((pinTerms config pulled anc fin).leakAt
      (base0 + preset.downwardBand + preset.EFFECTIVE_BALANCE_INCREMENT.toNat) i.toNat)
    ((pinTerms config pulled anc fin).leakAt
      (effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat -
        actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat +
          preset.EFFECTIVE_BALANCE_INCREMENT.toNat) i.toNat)
    ((pinTerms config pulled anc fin).partialsDue i.toNat)
    (events.map (syncDebit i.toNat)).sum D a X
    positive (above _) (above _) (by omega) fall (by omega) closed
  omega

/-- The arithmetic of the margin of the floor of a slashed key on C's run.

It is `floorC_margin` for the closed form after a slash with the fork's quotient.

The fall reads the leak at the base, and the band is a term of `X`, as `lowEB`'s drop reads them.

`Xs` is the effective balance that the slash is read at.

It is at least the finalized one and an increment.

`bridge` turns the closed form into the one at the balance and the slash's share `Xs / M`.

Then `margin_arith` at one more epoch gives the bound. -/
private theorem floorC_margin_slash (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩)
    {events : List (BalanceEvent preset)}
    (replayed : (fromFin.append tailC).balanceEvents (getCurrentEpoch pulled).toNat = .ok events)
    (i : ValidatorIndex) (val : Validator) (initial : fin.validators.data[i.toNat]? = some val)
    (ρn ρd : ℕ) (positive : 0 < ρd)
    (leaky : ∀ eb : ℕ, preset.EFFECTIVE_BALANCE_INCREMENT.toNat ∣ eb →
      (pinTerms config pulled anc fin).leakAt eb i.toNat ≤ ρn * eb / ρd)
    (above : ∀ x : ℕ, ρn * x ≤ ρd * ((pinTerms config pulled anc fin).leakAt
      (x + preset.EFFECTIVE_BALANCE_INCREMENT.toNat) i.toNat + 1))
    (base0 X low Xs : ℕ)
    (hXs : max (balanceAt fin i.toNat) base0 + preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤ Xs)
    (hbase0 : base0 = min (actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat)
      (withdrawalMaxEffectiveBalance preset fork val).toNat)
    (hlow : low = base0 - X)
    (fall : ((pinTerms config pulled anc fin).leakAt
          (effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat -
            actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat +
              preset.EFFECTIVE_BALANCE_INCREMENT.toNat) i.toNat + 1) +
        ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) *
          ((pinTerms config pulled anc fin).leakAt
            (base0 + preset.EFFECTIVE_BALANCE_INCREMENT.toNat) i.toNat + 1) +
        preset.downwardBand + (pinTerms config pulled anc fin).partialsDue i.toNat ≤ X) :
    ∃ slack : ℕ,
      effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat ≤
        actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat +
          (preset.downwardBand + slack) ∧
      (∀ {m n : ForkedBeaconState preset} (before : Run config checks ⟨fork, fin⟩ m)
        (step : Step config checks m n) (after : Run config checks n ⟨fork, counted⟩),
        (before.snoc step).append after = fromFin.append tailC → ∀ evs,
        step.balanceEvents = .ok evs →
        (evs.map (penaltyDebit i.toNat)).sum ≤ ρn * effectiveAt m i.toNat / ρd) ∧
      ∀ a D k : ℕ, k ≤ (getCurrentEpoch counted).toNat - (getCurrentEpoch fin).toNat →
        D ≤ (events.map (syncDebit i.toNat)).sum + (events.map (floorPartialDebit i)).sum →
        ((EthLib.Consensus.parameters preset fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat - 1) *
        ((ρd - ρn * (k + 1)) *
            (min (actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat)
              (withdrawalMaxEffectiveBalance preset fork val).toNat + preset.downwardBand)) ≤
          (EthLib.Consensus.parameters preset fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat *
            (ρd * (a + D + preset.downwardBand) + ρn * slack) +
            ρd * (preset.downwardBand + slack) →
        low - (events.map (syncDebit i.toNat)).sum ≤ a + Xs /
          (EthLib.Consensus.parameters preset fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat := by
  have nearC := h.near
  have partialLe := run_partials_le_due h (fromFin.append tailC) nearC i replayed
  have fusaka := parameters_of_fusaka (preset := preset) h.fulu h.early
  have two := h.facts.quotient
  have slashFact := h.facts.slash
  have quarter := h.facts.quarterBand
  rw [← fusaka] at two slashFact
  refine ⟨effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat -
    actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat, by omega,
    pass_of_leak h (fromFin.append tailC) nearC i ⟨val, initial⟩ ρn ρd leaky,
    fun a D k hk hD closed => ?_⟩
  rw [← hbase0] at closed
  have finEq : balanceAt fin i.toNat =
      effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat := rfl
  have bridged := bridge ρn ρd
    (EthLib.Consensus.parameters preset fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat k base0
    preset.downwardBand
    (effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat -
      actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat)
    a D Xs (max (balanceAt fin i.toNat) base0) preset.EFFECTIVE_BALANCE_INCREMENT.toNat two
    closed (by rw [hbase0, finEq]; omega) hXs (by omega)
  have finSplit := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps fromFin.chainSteps)
  have splitPulled := UInt64.le_iff_toNat_le.mp h.called
  simp only at finSplit
  have epochs : k + 1 ≤ (getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat := by
    omega
  have mono : (ρd - ρn * (k + 1)) * (base0 + 0) ≤
      (ρd - ρn * (k + 1)) * (base0 + preset.downwardBand) :=
    Nat.mul_le_mul_left _ (by omega)
  have closed0 : (ρd - ρn * (k + 1)) * (base0 + 0) ≤ ρd * ((a + Xs /
      (EthLib.Consensus.parameters preset fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat +
        preset.downwardBand) + D + 0) + ρn * (effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset)
        i.toNat - actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat) := by
    refine mono.trans (bridged.trans (le_of_eq ?_))
    congr 2
    omega
  have bound := margin_arith ρn ρd (k + 1)
    ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) base0 0
    (effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat -
      actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat)
    ((pinTerms config pulled anc fin).leakAt
      (base0 + preset.EFFECTIVE_BALANCE_INCREMENT.toNat) i.toNat)
    ((pinTerms config pulled anc fin).leakAt
      (effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat -
        actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat +
          preset.EFFECTIVE_BALANCE_INCREMENT.toNat) i.toNat)
    ((pinTerms config pulled anc fin).partialsDue i.toNat)
    (events.map (syncDebit i.toNat)).sum D
    (a + Xs / (EthLib.Consensus.parameters preset fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat +
      preset.downwardBand) (X - preset.downwardBand)
    positive (by simpa using above base0) (above _) epochs (by omega) (by omega) closed0
  have downLe : preset.downwardBand ≤ X := by omega
  rw [hlow]
  exact (fun (B X S q a dn : ℕ) (le : dn ≤ X) (b : B - (X - dn) - S ≤ a + q + dn) =>
    show B - X - S ≤ a + q by omega) _ _ _ _ _ _ downLe bound

/-- The drop of `lowEB` and the fall `X` of the margin leave the rounded floor above `lowEB`.

The drop has the increment where the fall has the partials due.

A key whose bound is zero needs no floor. -/
private theorem slash_low_arith (R pd dropV X base0 m sy G r inc A P dn : ℕ)
    (hX : X = A + P + dn + pd) (hD : dropV = A + P + dn + inc)
    (hR : 0 < R → R + pd ≤ base0) (hG : base0 - X - sy - m = G) (hr : r < inc) :
    R - dropV - m - sy ≤ G - r := by
  omega

/-- The effective balance of a key at C is above its `lowEB`, less the slash's share.

The sync debits of the key are added to it.

The key is unslashed at the finalized block, and it may be slashed at C.

The share is read at the effective balance that `flagged` reads the slashing's loss at.

The drop in `lowEB` holds the band and an increment, which cover the rounding of the floor. -/
private theorem lowEB_slashed (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩)
    {events : List (BalanceEvent preset)}
    (replayed : (fromFin.append tailC).balanceEvents (getCurrentEpoch pulled).toNat = .ok events)
    (i : ValidatorIndex) (val : Validator) (initial : fin.validators.data[i.toNat]? = some val)
    (unslashed : val.slashed = false)
    (retained : ∀ {m n : ForkedBeaconState preset} (before : Run config checks ⟨fork, fin⟩ m)
      (step : Step config checks m n) (after : Run config checks n ⟨fork, counted⟩),
      (before.snoc step).append after = fromFin.append tailC → ∀ w,
      n.state.validators.data[i.toNat]? = some w →
      ((getCurrentEpoch pulled).toNat + 1 < w.exitEpoch.toNat ∨
        ∀ u, m.state.validators.data[i.toNat]? = some u →
          (getCurrentEpoch pulled).toNat + 1 < u.withdrawableEpoch.toNat)) :
    (pinTerms config pulled anc fin).lowEB i.toNat -
        max ((pinTerms config pulled anc fin).ebUp i.toNat)
          (max (balanceAt fin i.toNat) ((pinTerms config pulled anc fin).base0 i.toNat) +
            preset.EFFECTIVE_BALANCE_INCREMENT.toNat) /
        (EthLib.Consensus.parameters preset fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat ≤
      balanceAt counted i.toNat + (events.map (syncDebit i.toNat)).sum := by
  classical
  obtain ⟨shared⟩ := h.toFin
  have incPos := h.bands.1
  obtain ⟨ρn, ρd, positive, leaky, above⟩ := leak_rate config pulled anc fin incPos i.toNat
  have capped : effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat ≤
      (withdrawalMaxEffectiveBalance preset fork val).toNat :=
    DirectSafety.Apriori.Internal.effectiveAt_le_withdrawalMax shared h.genesis h.caps h.early
      initial
  have finEq : balanceAt fin i.toNat =
      effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat := rfl
  have base0Eq := base0_of_found config pulled anc fin initial
  have dropEq := drop_of_found config pulled anc fin initial
  obtain ⟨X, hX⟩ : ∃ X, X = ((pinTerms config pulled anc fin).leakAt
          (effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat -
            actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat +
              preset.EFFECTIVE_BALANCE_INCREMENT.toNat) i.toNat + 1) +
        ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) *
          ((pinTerms config pulled anc fin).leakAt
            ((pinTerms config pulled anc fin).base0 i.toNat +
              preset.EFFECTIVE_BALANCE_INCREMENT.toNat) i.toNat + 1) +
        preset.downwardBand + (pinTerms config pulled anc fin).partialsDue i.toNat := ⟨_, rfl⟩
  obtain ⟨Xs, hXsEq⟩ : ∃ Xs, Xs = max ((pinTerms config pulled anc fin).ebUp i.toNat)
      (max (balanceAt fin i.toNat) ((pinTerms config pulled anc fin).base0 i.toNat) +
        preset.EFFECTIVE_BALANCE_INCREMENT.toNat) := ⟨_, rfl⟩
  obtain ⟨slack, start, pass, arithS⟩ := floorC_margin_slash h fromFin tailC replayed i val initial
    ρn ρd positive leaky above ((pinTerms config pulled anc fin).base0 i.toNat) X
    ((pinTerms config pulled anc fin).base0 i.toNat - X) Xs
    (by rw [hXsEq]; exact Nat.le_max_right _ _) base0Eq rfl (by omega)
  have endpoint := cfloor_endpoint_slash h counted (fromFin.append tailC) h.near replayed i val
    initial unslashed retained slack ρn ρd
    ((pinTerms config pulled anc fin).base0 i.toNat - X -
      (events.map (syncDebit i.toNat)).sum)
    (Xs / (EthLib.Consensus.parameters preset fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat) start pass
    arithS (fromFin.append tailC) (Run.nil : Run config checks ⟨fork, counted⟩ ⟨fork, counted⟩) rfl
  have actEq : ((fin.balances.data[i.toNat]?).map (·.toNat)).getD 0 =
      actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat := rfl
  rw [lowEB_unfold, actEq]
  have effC : balanceAt counted i.toNat =
      effectiveAt (⟨fork, counted⟩ : ForkedBeaconState preset) i.toNat := rfl
  rw [effC, ← hXsEq]
  obtain ⟨m1, hm1⟩ : ∃ m1, m1 = min (min (balanceAt pulled i.toNat) (balanceAt fin i.toNat))
      (actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat) := ⟨_, rfl⟩
  rw [← hm1]
  have m1Eff : m1 ≤ balanceAt fin i.toNat := by
    rw [hm1]
    exact Nat.le_trans (Nat.min_le_left _ _) (Nat.min_le_right _ _)
  have m1Act : m1 ≤ actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat := by
    rw [hm1]
    exact Nat.min_le_right _ _
  obtain ⟨R, hR⟩ : ∃ R, R = min (m1 - (pinTerms config pulled anc fin).partialsDue i.toNat)
      preset.MIN_ACTIVATION_BALANCE.toNat := ⟨_, rfl⟩
  rw [← hR]
  have hRle : R ≤ m1 - (pinTerms config pulled anc fin).partialsDue i.toNat := by
    rw [hR]
    exact Nat.min_le_left _ _
  have capped' : balanceAt fin i.toNat ≤ (withdrawalMaxEffectiveBalance preset fork val).toNat := by
    rw [finEq]
    exact capped
  have baseLe : 0 < R → R + (pinTerms config pulled anc fin).partialsDue i.toNat ≤
      (pinTerms config pulled anc fin).base0 i.toNat := fun positive => by
    rw [base0Eq]
    exact Nat.le_min.mpr ⟨by omega, by omega⟩
  have underM : R ≤ m1 := Nat.le_trans hRle (Nat.sub_le _ _)
  generalize hG : (pinTerms config pulled anc fin).base0 i.toNat - X -
    (events.map (syncDebit i.toNat)).sum - Xs /
      (EthLib.Consensus.parameters preset fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat = G at endpoint
  have modLt := Nat.mod_lt G incPos
  generalize G % preset.EFFECTIVE_BALANCE_INCREMENT.toNat = r at endpoint modLt
  rw [← finEq] at endpoint
  have bounded : R - (pinTerms config pulled anc fin).drop i.toNat -
      Xs / (EthLib.Consensus.parameters preset fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat -
        (events.map (syncDebit i.toNat)).sum ≤ G - r :=
    slash_low_arith _ _ _ _ _ _ _ _ _ _ _ _ _ hX dropEq baseLe hG modLt
  have atMin : R - (pinTerms config pulled anc fin).drop i.toNat -
      Xs / (EthLib.Consensus.parameters preset fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat -
        (events.map (syncDebit i.toNat)).sum ≤
      min (balanceAt fin i.toNat) (min (withdrawalMaxEffectiveBalance preset fork val).toNat
        (G - r)) :=
    Nat.le_min.mpr ⟨Nat.le_trans (Nat.sub_le _ _) (Nat.le_trans (Nat.sub_le _ _)
      (Nat.le_trans (Nat.sub_le _ _) (Nat.le_trans underM m1Eff))),
      Nat.le_min.mpr ⟨Nat.le_trans (Nat.sub_le _ _) (Nat.le_trans (Nat.sub_le _ _)
        (Nat.le_trans (Nat.sub_le _ _) (Nat.le_trans underM (Nat.le_trans m1Eff capped')))),
        bounded⟩⟩
  omega

/-- The effective balance of a key on C's run stays at its finalized value when the test holds.

The key has no sync debits on the run, and the test of its floor holds.

A downward update fires only at a step whose balance after it is at least the finalized balance. -/
private theorem floorC_stay (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩)
    {events : List (BalanceEvent preset)}
    (replayed : (fromFin.append tailC).balanceEvents (getCurrentEpoch pulled).toNat = .ok events)
    (i : ValidatorIndex) (val : Validator) (initial : fin.validators.data[i.toNat]? = some val)
    (clean : ∀ w, counted.validators.data[i.toNat]? = some w → w.slashed = false)
    (retained : ∀ {m n : ForkedBeaconState preset} (before : Run config checks ⟨fork, fin⟩ m)
      (step : Step config checks m n) (after : Run config checks n ⟨fork, counted⟩),
      (before.snoc step).append after = fromFin.append tailC → ∀ w,
      n.state.validators.data[i.toNat]? = some w →
      ((getCurrentEpoch pulled).toNat + 1 < w.exitEpoch.toNat ∨
        ∀ u, m.state.validators.data[i.toNat]? = some u →
          (getCurrentEpoch pulled).toNat + 1 < u.withdrawableEpoch.toNat))
    (ρn ρd : ℕ) (positive : 0 < ρd)
    (leaky : ∀ eb : ℕ, preset.EFFECTIVE_BALANCE_INCREMENT.toNat ∣ eb →
      (pinTerms config pulled anc fin).leakAt eb i.toNat ≤ ρn * eb / ρd)
    (above : ∀ x : ℕ, ρn * x ≤ ρd * ((pinTerms config pulled anc fin).leakAt
      (x + preset.EFFECTIVE_BALANCE_INCREMENT.toNat) i.toNat + 1))
    (base0 X low finEB : ℕ)
    (hbase0 : base0 = min (actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat)
      (withdrawalMaxEffectiveBalance preset fork val).toNat)
    (hlow : low = base0 - X)
    (hfin : finEB = effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat)
    (fall : ((pinTerms config pulled anc fin).leakAt
          (effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat -
            actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat +
              preset.EFFECTIVE_BALANCE_INCREMENT.toNat) i.toNat + 1) +
        ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) *
          ((pinTerms config pulled anc fin).leakAt
            (base0 + preset.downwardBand + preset.EFFECTIVE_BALANCE_INCREMENT.toNat) i.toNat + 1) +
        (pinTerms config pulled anc fin).partialsDue i.toNat ≤ X)
    (sync : (events.map (syncDebit i.toNat)).sum = 0)
    (test : max finEB base0 ≤ low + preset.downwardBand)
    {z : ForkedBeaconState preset} (rp : Run config checks ⟨fork, fin⟩ z)
    (rest : Run config checks z ⟨fork, counted⟩) (cut : rp.append rest = fromFin.append tailC) :
    finEB ≤ effectiveAt z i.toNat := by
  obtain ⟨toFin⟩ := h.toFin
  have incPos := h.bands.1
  have alignedFin := FloorTrace.effective_aligned toFin h.genesis h.aligned i.toNat
  have aligned : finEB % preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0 := by
    rw [hfin]
    exact alignedFin
  by_cases small : finEB < preset.EFFECTIVE_BALANCE_INCREMENT.toNat
  · have zero : finEB = 0 := by rw [← Nat.mod_eq_of_lt small]; exact aligned
    omega
  have big : preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤ finEB := Nat.le_of_not_lt small
  have quarter := h.facts.quarterBand
  have fallX : X ≤ preset.downwardBand := by omega
  have testB : finEB ≤ base0 + preset.downwardBand := by omega
  have first := above (base0 + preset.downwardBand)
  have partialLe := run_partials_le_due h (fromFin.append tailC) h.near i replayed
  obtain ⟨slack, start, pass, arith⟩ := floorC_margin h fromFin tailC replayed i val initial ρn ρd
    positive leaky above base0 X low hbase0 hlow fall
  have floorAt : ∀ {p : ForkedBeaconState preset} (r1 : Run config checks ⟨fork, fin⟩ p)
      (r2 : Run config checks p ⟨fork, counted⟩), r1.append r2 = fromFin.append tailC →
      low - (events.map (syncDebit i.toNat)).sum ≤ actualBalanceAt p i.toNat :=
    fun r1 r2 whole => cfloor_balance h counted (fromFin.append tailC) h.near replayed i val
      initial clean retained slack ρn ρd (low - (events.map (syncDebit i.toNat)).sum) start pass
      arith r1 r2 whole
  have forkEnd : ∀ {p : ForkedBeaconState preset} (r2 : Run config checks p ⟨fork, counted⟩),
      p.fork < .glamsterdam := fun r2 =>
    Nat.lt_of_le_of_lt (fork_le_of_chainSteps r2.chainSteps) h.early
  have inside : i.toNat < fin.validators.data.size := (Array.getElem?_eq_some_iff.mp initial).1
  have cappedFin : effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat ≤
      (withdrawalMaxEffectiveBalance preset fork val).toNat :=
    DirectSafety.Apriori.Internal.effectiveAt_le_withdrawalMax toFin h.genesis h.caps h.early
      initial
  rw [hfin]
  refine (PinKeyFloor.Run.effective_floor_pair rp (forkEnd rest) h.fulu i.toNat inside 0 0 0 0 0
    0).2.1 alignedFin ?_ ?_
  · intro m n before step after cut' below
    have nSame := fork_eq_of_run (before.snoc step) (after.append rest) (Nat.le_refl _)
    have mSame := fork_eq_of_run before ((Run.nil.snoc step).append (after.append rest))
      (Nat.le_refl _)
    obtain ⟨mF, mS⟩ := m
    obtain ⟨nF, nS⟩ := n
    obtain rfl : fork = nF := nSame.symm
    obtain rfl : fork = mF := mSame.symm
    have eqn : (before.snoc step).append (after.append rest) = fromFin.append tailC := by
      rw [Run.append_assoc, cut', cut]
    have atN := floorAt (before.snoc step) (after.append rest) eqn
    by_cases down : effectiveAt (⟨fork, mS⟩ : ForkedBeaconState preset) i.toNat ≤ finEB
    · omega
    have alignedM := FloorTrace.effective_aligned (toFin.append before) h.genesis h.aligned i.toNat
    have gap := add_le_of_lt_of_aligned alignedM aligned (by omega)
    have origin := cfloor_origin h counted (fromFin.append tailC) h.near replayed i val initial
      clean retained before ((Run.nil.snoc step).append (after.append rest))
      (by rw [Run.append_assoc]; exact eqn)
    rcases origin with same | ⟨w, pre, post, hpre, hm, hle, -⟩
    · omega
    have wSame := fork_eq_of_run pre post (Nat.le_refl _)
    obtain ⟨wF, wS⟩ := w
    obtain rfl : fork = wF := wSame.symm
    obtain ⟨valW, initialW, -⟩ := pre.registryLifecycle.validators i.toNat val initial
    have hwhole : (pre.append (post.snoc step)).append (after.append rest) =
        fromFin.append tailC := by
      show ((pre.append post).snoc step).append (after.append rest) = _
      rw [hpre]
      exact eqn
    have lift : ∀ {m' n' : ForkedBeaconState preset} (before' : Run config checks ⟨fork, wS⟩ m')
        (step' : Step config checks m' n') (after' : Run config checks n' ⟨fork, nS⟩),
        (before'.snoc step').append after' = post.snoc step →
        ((pre.append before').snoc step').append (after'.append (after.append rest)) =
          fromFin.append tailC := by
      intro m' n' before' step' after' cut''
      have shift : ((pre.append before').snoc step').append after' =
          pre.append ((before'.snoc step').append after') :=
        (Run.append_assoc pre (before'.snoc step') after').symm
      rw [Run.append_assoc, shift, cut'']
      exact hwhole
    obtain ⟨segEv, segOk⟩ := Run.balanceEvents_ok (post.snoc step) h.early
      (getCurrentEpoch pulled).toNat
    obtain ⟨preEv, preOk⟩ := Run.balanceEvents_ok pre h.early (getCurrentEpoch pulled).toNat
    obtain ⟨D, split, closed⟩ := segment_potential h h.near i clean pre (post.snoc step)
      (after.append rest) valW initialW
      (fun before' step' after' cut'' w found => retained (pre.append before') step'
        (after'.append (after.append rest)) (lift before' step' after' cut'') w found)
      0 ρn ρd (by omega)
      (fun before' step' after' cut'' evs ok => pass (pre.append before') step'
        (after'.append (after.append rest)) (lift before' step' after' cut'') evs ok)
      segOk
    have app := balanceEvents_append pre (post.snoc step) (getCurrentEpoch pulled).toNat preOk
      segOk
    obtain ⟨b, hb, isPrefix⟩ := Run.balanceEvents_prefix (pre.append (post.snoc step))
      (after.append rest) (getCurrentEpoch pulled).toNat events (by rw [hwhole]; exact replayed)
    have sameEv : b = preEv ++ segEv := Except.ok.inj (hb.symm.trans app)
    have sub : segEv.Sublist events := by
      rw [sameEv] at isPrefix
      exact (List.sublist_append_right _ _).trans isPrefix.sublist
    have syncLe : (segEv.map (syncDebit i.toNat)).sum ≤ (events.map (syncDebit i.toNat)).sum :=
      (sub.map (syncDebit i.toNat)).sum_le_sum fun _ _ => Nat.zero_le _
    have partialSeg : (segEv.map (floorPartialDebit i)).sum ≤
        (events.map (floorPartialDebit i)).sum :=
      (sub.map (floorPartialDebit i)).sum_le_sum fun _ _ => Nat.zero_le _
    have splitDebit := floorPenaltyDebit_sum i.toNat segEv
    have cappedW : effectiveAt (⟨fork, wS⟩ : ForkedBeaconState preset) i.toNat ≤
        (withdrawalMaxEffectiveBalance preset fork valW).toNat :=
      DirectSafety.Apriori.Internal.effectiveAt_le_withdrawalMax (toFin.append pre) h.genesis
        h.caps h.early initialW
    have preEpoch := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps pre.chainSteps)
    have restEpoch := UInt64.le_iff_toNat_le.mp
      (currentEpoch_le_of_chainSteps (after.append rest).chainSteps)
    simp only at preEpoch restEpoch
    have kept := stay_arith ρn ρd ((getCurrentEpoch counted).toNat - (getCurrentEpoch fin).toNat)
      ((getCurrentEpoch nS).toNat - (getCurrentEpoch wS).toNat)
      ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat)
      preset.EFFECTIVE_BALANCE_INCREMENT.toNat preset.downwardBand base0 finEB
      (min (actualBalanceAt (⟨fork, wS⟩ : ForkedBeaconState preset) i.toNat)
        (withdrawalMaxEffectiveBalance preset fork valW).toNat) X
      ((pinTerms config pulled anc fin).partialsDue i.toNat)
      D (actualBalanceAt (⟨fork, nS⟩ : ForkedBeaconState preset) i.toNat)
      ((pinTerms config pulled anc fin).leakAt
        (base0 + preset.downwardBand + preset.EFFECTIVE_BALANCE_INCREMENT.toNat) i.toNat)
      ((pinTerms config pulled anc fin).leakAt
        (effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat -
          actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i.toNat +
            preset.EFFECTIVE_BALANCE_INCREMENT.toNat) i.toNat)
      positive incPos h.facts.quarterBand big testB fallX first fall (by omega)
      (by have := h.near; omega) (by omega) (by omega) (by simpa using closed)
    omega
  · intro p member
    obtain ⟨r1, r2, -⟩ : ∃ (r1 : Run config checks ⟨fork, fin⟩ p)
        (r2 : Run config checks p ⟨fork, counted⟩), r1.append r2 = rp.append rest := by
      obtain ⟨r1, r2, whole⟩ := balancePath_endpoint rp rest (Nat.le_refl _) member
      exact ⟨r1, r2, whole⟩
    obtain ⟨w, found, mono⟩ := r1.validatorCap_mono h.caps.activation h.caps.compounding
      (forkEnd r2) i.toNat val initial
    have := UInt64.le_iff_toNat_le.mp mono
    simp only [PinTerms.capAt, found, Option.map_some, Option.getD_some]
    exact cappedFin.trans this

/-- A key whose exit comes late stays out of its withdrawal along a run from the finalized block.

Its exit epoch is constant from the state where it is set.

The withdrawable epoch is the delay after it, so it is after the horizon `high` of the call.

A key with no exit has the withdrawable epoch that no epoch reaches, since it exits no later. -/
private theorem retained_of_exit (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    {e : BeaconState preset fork} (tail : Run config checks ⟨fork, split⟩ ⟨fork, e⟩)
    (high : ℕ) (highLe : high ≤ (getCurrentEpoch pulled).toNat) (i : ValidatorIndex)
    {wE : Validator} (foundE : e.validators.data[i.toNat]? = some wE)
    (late : high + 1 < wE.exitEpoch.toNat + config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat) :
    ∀ {m n : ForkedBeaconState preset} (before : Run config checks ⟨fork, fin⟩ m)
      (step : Step config checks m n) (after : Run config checks n ⟨fork, e⟩),
      (before.snoc step).append after = fromFin.append tail → ∀ w,
      n.state.validators.data[i.toNat]? = some w →
      (high + 1 < w.exitEpoch.toNat ∨
        ∀ u, m.state.validators.data[i.toNat]? = some u →
          high + 1 < u.withdrawableEpoch.toNat) := by
  obtain ⟨toFin⟩ := h.toFin
  intro m n before step after cut w found
  refine .inr fun u foundU => ?_
  have holds := Run.invariant (Genesis.invariant h.genesis) (toFin.append before)
  obtain ⟨last, located, kept⟩ := ((Run.nil.snoc step).append after).registryLifecycle.validators
    i.toNat u foundU
  by_cases unset : u.exitEpoch = FAR_FUTURE_EPOCH
  · have ordered := holds.exitsOrdered u (Array.mem_of_getElem? foundU)
    rw [unset] at ordered
    have := UInt64.le_iff_toNat_le.mp ordered
    have := getCurrentEpoch_succ_lt_farFuture h.twoSlots pulled
    omega
  · have same := congrArg UInt64.toNat (kept.exitEpoch unset)
    have lastEq : last = wE := Option.some.inj (located.symm.trans foundE)
    have delayed := (toFin.append before).exit_withdrawable_delay h.genesis i.toNat u foundU unset
    subst lastEq
    omega

/-- A key whose exit at R is at or before the finalized epoch has that exit at the finalized state.

A key absent from the finalized registry was created after it, and its exit is assigned after it.

An exit assigned after the finalized state is at least the seed lookahead past its epoch.

An exit assigned before it is kept along the run. -/
private theorem exit_kept_of_le_fin (h : Setting config checks g split fin pulled anc counted V)
    {i : ℕ} {w : Validator} (foundPulled : pulled.validators.data[i]? = some w)
    (exited : w.exitEpoch.toNat ≤ (getCurrentEpoch fin).toNat) :
    ∃ u, fin.validators.data[i]? = some u ∧ u.exitEpoch = w.exitEpoch := by
  obtain ⟨fromFin⟩ := h.fromFin
  obtain ⟨toPulled⟩ := h.toPulled
  have assigned : w.exitEpoch ≠ FAR_FUTURE_EPOCH := fun far => by
    have := getCurrentEpoch_succ_lt_farFuture h.twoSlots fin
    have := congrArg UInt64.toNat far
    omega
  have late : ∀ c ∈ (fromFin.append toPulled).departureCharges,
      (getCurrentEpoch fin).toNat + 1 + preset.MAX_SEED_LOOKAHEAD.toNat ≤ c.epoch :=
    DirectSafety.Run.departureCharges_epoch_ge_start (fromFin.append toPulled)
      (Nat.le_trans (by decide) h.fulu) h.early
  cases foundFin : fin.validators.data[i]? with
  | none =>
    obtain ⟨charge, member, -, epoch⟩ := PinKeys.Run.charge_of_exit (fromFin.append toPulled)
      (Nat.le_trans (by decide) h.fulu) h.early i (fun v hv => nomatch hv.symm.trans foundFin) w
      foundPulled assigned
    have := late charge member
    omega
  | some u =>
    refine ⟨u, rfl, ?_⟩
    by_cases unset : u.exitEpoch = FAR_FUTURE_EPOCH
    · obtain ⟨charge, member, -, epoch⟩ := (fromFin.append toPulled).departure_charge_of_assigned
        i u w foundFin foundPulled unset assigned
      have := late charge member
      omega
    · obtain ⟨last, located, kept⟩ :=
        (fromFin.append toPulled).registryLifecycle.validators i u foundFin
      have lastEq : last = w := Option.some.inj (located.symm.trans foundPulled)
      rw [← lastEq]
      exact (kept.exitEpoch unset).symm

/-- The events of C's run from the finalized block are those of its two parts.

They are read at R's epoch. -/
private theorem V_events (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩)
    {eventsF eventsC : List (BalanceEvent preset)} (high highC : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    (replayedF : fromFin.balanceEvents high = .ok eventsF)
    (replayedC : tailC.balanceEvents highC = .ok eventsC) :
    (fromFin.append tailC).balanceEvents (getCurrentEpoch pulled).toNat =
      .ok (eventsF ++ eventsC) := by
  have calledNat := UInt64.le_iff_toNat_le.mp h.called
  have nearC := h.near
  refine balanceEvents_append fromFin tailC _ ?_ ?_
  · rw [balanceEvents_eq_of_endpoint_le fromFin (localHigh := high) (by simp only; omega)
      (by simp only; omega)]
    exact replayedF
  · rw [balanceEvents_eq_of_endpoint_le tailC (localHigh := highC) (by simp only; omega)
      (by simp only; omega)]
    exact replayedC

/-- The sync debits of a key over two runs are at most those that `cV_le` charges. -/
private theorem V_sync_le (eventsF eventsC : List (BalanceEvent preset)) (v : ℕ) :
    ((eventsF ++ eventsC).map (syncDebit v)).sum ≤
      (eventsF.map (syncDebit v)).sum + syncF eventsC v := by
  have := sum_syncDebit_eq eventsC v
  unfold syncF
  rw [List.map_append, List.sum_append]
  omega

/-- A key falls by at least its effective balance at R, less any bound of its floor.

A key that is not in the finalized registry has the floor zero. -/
private theorem fall_floor (h : Setting config checks g split fin pulled anc counted V)
    (v : ValidatorIndex) (X : ℕ)
    (bound : fin.validators.data[v.toNat]? = none ∨
      (pinTerms config pulled anc fin).floorC v.toNat ≤ X) :
    (eR pulled v : ℤ) ≤ ((pinTerms config pulled anc fin).fall v.toNat : ℤ) + X := by
  have fallEq := fall_eq config pulled anc fin v.toNat
  simp only [h.shallow, ↓reduceIte] at fallEq
  have eRdef : eR pulled v = balanceAt pulled v.toNat := rfl
  rcases bound with none | le
  · obtain ⟨low, base, shape⟩ : ∃ low base : ℕ, (pinTerms config pulled anc fin).floorC v.toNat =
        if max (balanceAt fin v.toNat) base ≤ low + preset.downwardBand then balanceAt fin v.toNat
        else min (balanceAt fin v.toNat) (low - low % preset.EFFECTIVE_BALANCE_INCREMENT.toNat) :=
      ⟨_, _, rfl⟩
    have zero : balanceAt fin v.toNat = 0 := by simp [balanceAt, none]
    have : (pinTerms config pulled anc fin).floorC v.toNat = 0 := by
      rw [shape]
      split
      · exact zero
      · rw [zero]
        exact Nat.zero_min _
    omega
  · omega

/-- C's floor of a key is below its effective balance at each state of C's run, with its debits.

The debits are the key's sync debits over the run and their rounding band.

The key is in the finalized registry, unslashed at C's end, and kept out of withdrawal. -/
private theorem V_floor (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩)
    {events : List (BalanceEvent preset)}
    (replayed : (fromFin.append tailC).balanceEvents (getCurrentEpoch pulled).toNat = .ok events)
    (v : ValidatorIndex) (val : Validator) (initial : fin.validators.data[v.toNat]? = some val)
    (clean : ∀ w, counted.validators.data[v.toNat]? = some w → w.slashed = false)
    (retained : ∀ {m n : ForkedBeaconState preset} (before : Run config checks ⟨fork, fin⟩ m)
      (step : Step config checks m n) (after : Run config checks n ⟨fork, counted⟩),
      (before.snoc step).append after = fromFin.append tailC → ∀ w,
      n.state.validators.data[v.toNat]? = some w →
      ((getCurrentEpoch pulled).toNat + 1 < w.exitEpoch.toNat ∨
        ∀ u, m.state.validators.data[v.toNat]? = some u →
          (getCurrentEpoch pulled).toNat + 1 < u.withdrawableEpoch.toNat))
    {z : ForkedBeaconState preset} (rp : Run config checks ⟨fork, fin⟩ z)
    (rest : Run config checks z ⟨fork, counted⟩) (cut : rp.append rest = fromFin.append tailC) :
    (pinTerms config pulled anc fin).floorC v.toNat ≤ effectiveAt z v.toNat +
      (events.map (syncDebit v.toNat)).sum + bandR events v.toNat := by
  obtain ⟨ρn, ρd, positive, leaky, above⟩ := leak_rate config pulled anc fin h.bands.1 v.toNat
  obtain ⟨base0, hbase0def⟩ : ∃ b, b = (pinTerms config pulled anc fin).base0 v.toNat := ⟨_, rfl⟩
  have hbase0 : base0 = min (actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat)
      (withdrawalMaxEffectiveBalance preset fork val).toNat :=
    hbase0def.trans (base0_of_found config pulled anc fin initial)
  obtain ⟨X, hX⟩ : ∃ X, X = ((pinTerms config pulled anc fin).leakAt
        (effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat -
          actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat +
            preset.EFFECTIVE_BALANCE_INCREMENT.toNat) v.toNat + 1) +
      ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) *
        ((pinTerms config pulled anc fin).leakAt
          (base0 + preset.downwardBand + preset.EFFECTIVE_BALANCE_INCREMENT.toNat) v.toNat +
            (pinTerms config pulled anc fin).gainRate v.toNat + 1) +
      (pinTerms config pulled anc fin).partialsDue v.toNat := ⟨_, rfl⟩
  have hfall : ((pinTerms config pulled anc fin).leakAt
        (effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat -
          actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat +
            preset.EFFECTIVE_BALANCE_INCREMENT.toNat) v.toNat + 1) +
      ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) *
        ((pinTerms config pulled anc fin).leakAt
          (base0 + preset.downwardBand + preset.EFFECTIVE_BALANCE_INCREMENT.toNat) v.toNat + 1) +
      (pinTerms config pulled anc fin).partialsDue v.toNat ≤ X := by
    rw [hX]
    have := Nat.mul_le_mul_left ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat)
      (show (pinTerms config pulled anc fin).leakAt
          (base0 + preset.downwardBand + preset.EFFECTIVE_BALANCE_INCREMENT.toNat) v.toNat + 1 ≤
        (pinTerms config pulled anc fin).leakAt
          (base0 + preset.downwardBand + preset.EFFECTIVE_BALANCE_INCREMENT.toNat) v.toNat +
            (pinTerms config pulled anc fin).gainRate v.toNat + 1 by omega)
    omega
  have hfloorC : (pinTerms config pulled anc fin).floorC v.toNat =
      if max (balanceAt fin v.toNat) base0 ≤ (base0 - X) + preset.downwardBand
      then balanceAt fin v.toNat
      else min (balanceAt fin v.toNat)
        ((base0 - X) - (base0 - X) % preset.EFFECTIVE_BALANCE_INCREMENT.toNat) := by
    rw [hX, hbase0def]
    rfl
  have hfin : balanceAt fin v.toNat =
      effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat := rfl
  obtain ⟨slack, margin⟩ := floorC_margin h fromFin tailC replayed v val initial ρn ρd positive
    leaky above base0 X (base0 - X) hbase0 rfl hfall
  exact floorC_at h fromFin tailC replayed v val initial clean retained base0 X (base0 - X)
    (balanceAt fin v.toNat) ((pinTerms config pulled anc fin).floorC v.toNat) hbase0 rfl hfin
    hfloorC rp rest cut ⟨slack, ρn, ρd, margin⟩
    (fun test sync => floorC_stay h fromFin tailC replayed v val initial clean retained
      ρn ρd positive leaky above base0 X (base0 - X) (balanceAt fin v.toNat)
      hbase0 rfl hfin hfall sync test rp rest cut)

/-- A V key that is active in C falls by at most `fall` and what C's floor leaves out.

C's floor is below the key's effective balance at C's end, plus its sync debits and their band.

The fall is the key's effective balance at R, less that floor, within the delay. -/
private theorem V_active (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩)
    {eventsF eventsC : List (BalanceEvent preset)} (high highC : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    (replayedF : fromFin.balanceEvents high = .ok eventsF)
    (replayedC : tailC.balanceEvents highC = .ok eventsC) :
    ∀ v ∈ V, v ∈ AC counted → (eR pulled v : ℤ) - eC counted v ≤
      ((pinTerms config pulled anc fin).fall v.toNat : ℤ) +
        ((eventsF.map (syncDebit v.toNat)).sum + syncF eventsC v.toNat) +
          bandR (eventsF ++ eventsC) v.toNat := by
  intro v member act
  have laterNat := UInt64.le_iff_toNat_le.mp h.later
  have delay := h.delay
  obtain ⟨wC, foundC, isActive⟩ := active_of_activeVoters h.early (s := counted) act
  simp only [isActiveValidator, Bool.and_eq_true, decide_eq_true_eq] at isActive
  have exitAfter := UInt64.lt_iff_toNat_lt.mp isActive.2
  have clean : ∀ w, counted.validators.data[v.toNat]? = some w → w.slashed = false := by
    intro w found
    rw [foundC] at found
    cases found
    simpa [slashedFlagAt, foundC] using (h.voting v member).2
  have sync := V_sync_le eventsF eventsC v.toNat
  have := fall_floor h v (balanceAt counted v.toNat + ((eventsF.map (syncDebit v.toNat)).sum +
      syncF eventsC v.toNat) + bandR (eventsF ++ eventsC) v.toNat) (by
    cases initial : fin.validators.data[v.toNat]? with
    | none => exact .inl rfl
    | some val =>
      have floor := V_floor h fromFin tailC
        (V_events h fromFin tailC high highC endEpoch endEpochC replayedF replayedC) v val initial
        clean (retained_of_exit h fromFin tailC _ (Nat.le_refl _) v foundC (by omega))
          (fromFin.append tailC)
        Run.nil rfl
      exact .inr (by
        have : effectiveAt (⟨fork, counted⟩ : ForkedBeaconState preset) v.toNat =
          balanceAt counted v.toNat := rfl
        omega))
  have eCdef : eC counted v = balanceAt counted v.toNat := rfl
  omega

/-- A V key that left C's active set is charged by its exit, its late activation or its floor.

Its activation is at most R's epoch.

If that is within the seed lookahead of the split, the two branches agree on its activity there.

Then C's record exits it by C's epoch, which R reads as exiting or C charges.

Otherwise R activated it after finalizing the split, and R reads it as late.

R's registry may hold a key that C's does not, since the registries differ by position.

Then `h.voting` holds with the unslashed flag read as false.

Such a key activates late at R, so it is in the second case. -/
private theorem V_left (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩)
    {eventsF eventsC : List (BalanceEvent preset)} (high highC : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    (replayedF : fromFin.balanceEvents high = .ok eventsF)
    (replayedC : tailC.balanceEvents highC = .ok eventsC) :
    ∀ v ∈ VN counted V, (eR pulled v : ℤ) ≤
      ((pinTerms config pulled anc fin).fall v.toNat +
        ((eventsF.map (syncDebit v.toNat)).sum + syncF eventsC v.toNat) +
        bandR (eventsF ++ eventsC) v.toNat + exitQ tailC v.toNat +
        (if (pinTerms config pulled anc fin).exitingB v.toNat = true then eR pulled v else 0) +
        (if (pinTerms config pulled anc fin).lateB v.toNat = true then eR pulled v
          else 0) : ℕ) := by
  intro v hv
  obtain ⟨member, notAC⟩ := Finset.mem_filter.mp hv
  obtain ⟨toFin⟩ := h.toFin
  obtain ⟨toPulled⟩ := h.toPulled
  obtain ⟨w, foundW, activeWb⟩ := active_of_activeVoters h.early (h.voting v member).1
  have activeW := activeWb
  simp only [isActiveValidator, Bool.and_eq_true, decide_eq_true_eq, UInt64.le_iff_toNat_le,
    UInt64.lt_iff_toNat_lt] at activeW
  have farEpoch := getCurrentEpoch_succ_lt_farFuture h.twoSlots pulled
  have finSplit := UInt64.le_iff_toNat_le.mp h.finalized
  have laterNat := UInt64.le_iff_toNat_le.mp h.later
  have nearC := h.near
  by_cases early : w.activationEpoch.toNat ≤
      (getCurrentEpoch split).toNat + preset.MAX_SEED_LOOKAHEAD.toNat
  · -- the key's activity at its activation epoch is shared, so C holds it
    have atAct : isActiveAt counted w.activationEpoch v.toNat = true := by
      rw [← activity_shared h (e := w.activationEpoch) early v.toNat]
      exact isActiveAt_eq_true_iff.mpr ⟨w, foundW, by
        simp only [isActiveValidator, Bool.and_eq_true, decide_eq_true_eq,
          UInt64.le_iff_toNat_le, UInt64.lt_iff_toNat_lt]
        omega⟩
    obtain ⟨u, foundU, activeU⟩ := isActiveAt_eq_true_iff.mp atAct
    simp only [isActiveValidator, Bool.and_eq_true, decide_eq_true_eq, UInt64.le_iff_toNat_le,
      UInt64.lt_iff_toNat_lt] at activeU
    have exited : u.exitEpoch.toNat ≤ (getCurrentEpoch counted).toNat := by
      by_contra later
      apply notAC
      simpa [AC, activeVoters] using mem_getActiveValidatorIndices_of_isActiveAt
        (isActiveAt_eq_true_iff.mpr ⟨u, foundU, by
          simp only [isActiveValidator, Bool.and_eq_true, decide_eq_true_eq,
            UInt64.le_iff_toNat_le, UInt64.lt_iff_toNat_lt]
          omega⟩)
    have assigned : u.exitEpoch ≠ FAR_FUTURE_EPOCH := fun far => by
      rw [far] at exited
      omega
    have unslashed : u.slashed = false := by
      simpa [slashedFlagAt, foundU] using (h.voting v member).2
    by_cases ex : (pinTerms config pulled anc fin).exitingB v.toNat = true
    · simp only [ex, ↓reduceIte]
      omega
    · obtain ⟨c, mem, idx⟩ := exit_charged h tailC foundU assigned exited unslashed
        (fun w' found _ => by
          obtain rfl : w' = w := Option.some.inj (found.symm.trans foundW)
          exact .inr (isActiveAt_eq_true_iff.mpr ⟨w', foundW, activeWb⟩))
        (by simpa using ex)
      have exitOf : ∀ c ∈ tailC.departureCharges, c.index = v.toNat →
          u.exitEpoch.toNat = c.epoch := by
        intro c' mem' idx'
        obtain ⟨x, found, -, epoch⟩ := Run.departure_charge_exit tailC c' mem'
        rw [idx'] at found
        obtain rfl : x = u := Option.some.inj (found.symm.trans foundU)
        exact epoch
      have startC := DirectSafety.Run.departureCharges_epoch_ge_start tailC
        (Nat.le_trans (by decide) h.fulu) h.early c mem
      simp only at startC
      have exitC := exitOf c mem idx
      have shallow := h.shallow
      have finOrder := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps fromFin.chainSteps)
      simp only at finOrder
      obtain ⟨sd, pre, post, cut, far, amount⟩ := exit_stop fromFin tailC v.toNat ⟨c, mem, idx⟩
        (fun c' mem' idx' => by have := exitOf c' mem' idx'; omega)
      have sync := V_sync_le eventsF eventsC v.toNat
      have clean : ∀ w, counted.validators.data[v.toNat]? = some w → w.slashed = false := by
        intro w found
        rw [foundU] at found
        cases found
        exact unslashed
      have := fall_floor h v (exitQ tailC v.toNat + ((eventsF.map (syncDebit v.toNat)).sum +
          syncF eventsC v.toNat) + bandR (eventsF ++ eventsC) v.toNat) (by
        cases initial : fin.validators.data[v.toNat]? with
        | none => exact .inl rfl
        | some val =>
          have floor := V_floor h fromFin tailC
            (V_events h fromFin tailC high highC endEpoch endEpochC replayedF replayedC) v val
            initial clean
            (retained_of_exit h fromFin tailC _ (Nat.le_refl _) v foundU (by omega)) pre post cut
          exact .inr (by omega))
      omega
  · -- R activated the key after finalizing the split, so it reads the key as late
    have farAct : w.activationEpoch ≠ FAR_FUTURE_EPOCH := fun far => by
      rw [far] at activeW
      omega
    have eligible := Run.eligibility_le_finalized ((toFin.append fromFin).append toPulled)
      h.genesis v.toNat w foundW farAct
    have finCur := UInt64.le_iff_toNat_le.mp (finalized_le_current h)
    have late := (lateB_iff config pulled anc fin v.toNat).mpr ⟨w, foundW, by
      have := UInt64.le_iff_toNat_le.mp eligible
      simp only at this
      omega, by omega⟩
    simp only [late, ↓reduceIte]
    omega

/-- The fall of the V keys, and the stake of the V keys that left C's active set. -/
private theorem cV_le (h : Setting config checks g split fin pulled anc counted V) (high : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1) (events : List (BalanceEvent preset))
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    {eventsF : List (BalanceEvent preset)} (replayedF : fromFin.balanceEvents high = .ok eventsF)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC) :
    cV1 pulled counted V + cV2 pulled counted V ≤
      ((∑ v ∈ V, (pinTerms config pulled anc fin).fall v.toNat) +
        (∑ v ∈ V, bandR (eventsF ++ eventsC) v.toNat) +
        (∑ v ∈ V, (syncD eventsF v.toNat + (syncF events v.toNat + syncF eventsC v.toNat))) +
        (∑ v ∈ V, credDepR events v.toNat) +
        (∑ v ∈ V, consAmt events v.toNat) + preset.upwardBand * dueAt fin high V +
        (∑ v ∈ (VN counted V), exitQ tailC v.toNat) +
        (∑ v ∈ (VN counted V) with (pinTerms config pulled anc fin).exitingB v.toNat = true,
          eR pulled v) +
        (∑ v ∈ (VN counted V) with (pinTerms config pulled anc fin).lateB v.toNat = true,
          eR pulled v) : ℕ) := by
  have base := cV_le_of h tailC
    (V_active h fromFin tailC high highC endEpoch endEpochC replayedF replayedC)
    (V_left h fromFin tailC high highC endEpoch endEpochC replayedF replayedC)
  have sync : ∑ v ∈ V, ((eventsF.map (syncDebit v.toNat)).sum + syncF eventsC v.toNat) ≤
      ∑ v ∈ V, (syncD eventsF v.toNat + (syncF events v.toNat + syncF eventsC v.toNat)) :=
    Finset.sum_le_sum fun v _ => by unfold syncD; omega
  refine le_trans base (Int.ofNat_le.mpr ?_)
  simp only [syncD, Finset.sum_add_distrib] at sync ⊢
  omega

end LowBound

/-- The low bound of an existing key is covered by its exit charge and its sync debits.

The key is activated at the finalized state, charged on the run, and exits by C.

The charge is its effective balance at the exit call.

The bound reads the floor of its balance from the finalized state.

The penalties are covered by `drop` and the partials by `partialsDue`.

The hysteresis is covered by the activation balance. -/
private theorem existing_low_le_charge (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩)
    {events : List (BalanceEvent preset)}
    (replayed : (fromFin.append tailC).balanceEvents (getCurrentEpoch pulled).toNat = .ok events)
    (v : ValidatorIndex)
    (epochLe : ∀ c ∈ tailC.departureCharges, c.index = v.toNat →
      c.epoch ≤ (getCurrentEpoch counted).toNat) (val : Validator)
    (initial : fin.validators.data[v.toNat]? = some val)
    (charged : ∃ c ∈ tailC.departureCharges, c.index = v.toNat) :
    (pinTerms config pulled anc fin).lowEB v.toNat ≤
      exitQ tailC v.toNat + (events.map (syncDebit v.toNat)).sum := by
  have bound := existing_low_explicit h fromFin tailC replayed v epochLe val initial charged
  have drop : (pinTerms config pulled anc fin).drop v.toNat =
      ((pinTerms config pulled anc fin).leakAt
          (balanceAt fin v.toNat -
            actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat +
            preset.EFFECTIVE_BALANCE_INCREMENT.toNat) v.toNat + 1) +
        ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) *
          ((pinTerms config pulled anc fin).leakAt
            (min (actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) v.toNat)
              (withdrawalMaxEffectiveBalance preset fork val).toNat +
              preset.EFFECTIVE_BALANCE_INCREMENT.toNat) v.toNat + 1) +
        preset.downwardBand + preset.EFFECTIVE_BALANCE_INCREMENT.toNat := by
    rw [drop_of_found config pulled anc fin initial, base0_of_found config pulled anc fin initial]
    rfl
  rw [lowEB_unfold, drop]
  exact bound

/-- The low and new-key floors are ordered: `newKeyFloor` is `newKeySlack` above `exitFloor`. -/
private theorem exitFloor_add_slack (h : Setting config checks g split fin pulled anc counted V) :
    (pinTerms config pulled anc fin).exitFloor + (pinTerms config pulled anc fin).newKeySlack =
      (pinTerms config pulled anc fin).newKeyFloor := by
  have newKey := h.facts.newKey fork
  have size := h.facts.incrementSize
  have floorEq : (pinTerms config pulled anc fin).newKeyFloor =
      2 * preset.MAX_EFFECTIVE_BALANCE.toNat / 3 -
        preset.MAX_EFFECTIVE_BALANCE.toNat /
          (EthLib.Consensus.parameters preset fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat -
        preset.downwardBand - preset.EFFECTIVE_BALANCE_INCREMENT.toNat := rfl
  have exitEq : (pinTerms config pulled anc fin).exitFloor =
      max 1 (min (config.EJECTION_BALANCE.toNat - preset.EFFECTIVE_BALANCE_INCREMENT.toNat)
        (pinTerms config pulled anc fin).newKeyFloor) := rfl
  have slack : (pinTerms config pulled anc fin).newKeySlack =
      (pinTerms config pulled anc fin).newKeyFloor -
        (pinTerms config pulled anc fin).exitFloor := rfl
  omega

/-- A key that is not yet activated at the finalized state and has a small charge loses seats.

The key is missing at the finalized state, or its activation there is unassigned.

It activates on the run from the finalized state.

So it keeps at least `newKeyFloor` of effective balance less its sync debits.

This is `Run.new_key_effective_floor`.

A small charge is below `exitFloor`, so the debits exceed `newKeySlack`.

It has no partial withdrawals queued, since a request needs an active key. -/
private theorem pending_key_claim (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩)
    {events : List (BalanceEvent preset)}
    (replayed : (fromFin.append tailC).balanceEvents (getCurrentEpoch pulled).toNat = .ok events)
    (v : ValidatorIndex)
    (epochLe : ∀ c ∈ tailC.departureCharges, c.index = v.toNat →
      c.epoch ≤ (getCurrentEpoch counted).toNat)
    (charged : ∃ c ∈ tailC.departureCharges, c.index = v.toNat)
    (small : exitQ tailC v.toNat < (pinTerms config pulled anc fin).exitFloor)
    (fresh : fin.validators.data[v.toNat]? = none ∨
      ∃ w, fin.validators.data[v.toNat]? = some w ∧ w.activationEpoch = FAR_FUTURE_EPOCH) :
    (pinTerms config pulled anc fin).newKeySlack < (events.map (syncDebit v.toNat)).sum := by
  -- The charge splits C's run at the step that exits the key.
  --
  -- The key is activated there, by `charge_activated`.
  --
  -- The key is active at that state, so the floor of a new key reads its effective balance.
  --
  -- That balance is the charge, and the floor adds the key's sync debits and partial payments.
  --
  -- The partial payments are none, since no queued entry names the key at the finalized state.
  --
  -- An entry queued later is not due in the window.
  classical
  obtain ⟨toFin⟩ := h.toFin
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  obtain ⟨c, cMember, cIndex⟩ := charged
  obtain ⟨a, b, pre, step, post, split', vv, w, found, foundB, unset, set, activated, amount,
    epoch⟩ := charge_activated (x := ⟨fork, split⟩) electra tailC c
    (tailC.departure_charge_site c cMember)
  rw [cIndex] at found foundB
  -- the charge counts, so `exitQ` is its amount
  have exitQEq : exitQ tailC v.toNat = c.amount := by
    rcases exitQ_cases tailC v.toNat with ⟨none, -⟩ | ⟨d, dMember, dIndex, -, dQ⟩
    · exact absurd (epochLe c cMember cIndex) (none c cMember cIndex)
    · rw [dQ, charge_unique tailC dMember cMember (dIndex.trans cIndex.symm)]
  -- the run from the finalized state to the exit step, and its events, a prefix of the replay
  have shape : fromFin.append ((pre.snoc step).append post) =
      (fromFin.append pre).append ((Run.nil.snoc step).append post) := by
    have snoc : pre.snoc step = pre.append (Run.nil.snoc step) := rfl
    rw [snoc, ← Run.append_assoc pre (Run.nil.snoc step) post, Run.append_assoc]
  rw [← split', shape] at replayed
  obtain ⟨prior, priorOk, isPrefix⟩ := Run.balanceEvents_prefix (fromFin.append pre)
    ((Run.nil.snoc step).append post) (getCurrentEpoch pulled).toNat events replayed
  have aEpoch : (getCurrentEpoch a.state).toNat ≤ (getCurrentEpoch counted).toNat :=
    UInt64.le_iff_toNat_le.mp
      (currentEpoch_le_of_chainSteps ((Run.nil.snoc step).append post).chainSteps)
  have aInside : (getCurrentEpoch a.state).toNat ≤ (getCurrentEpoch pulled).toNat + 1 := by
    have := h.near
    omega
  have aEarly : a.fork < .glamsterdam :=
    Nat.lt_of_le_of_lt (fork_le_of_chainSteps ((Run.nil.snoc step).append post).chainSteps)
      h.early
  have finite : (getCurrentEpoch a.state).toNat < FAR_FUTURE_EPOCH.toNat := by
    have ne := getCurrentEpoch_ne_farFuture h.twoSlots a.state
    have := (getCurrentEpoch a.state).toNat_lt
    have farNat : FAR_FUTURE_EPOCH.toNat = 2 ^ 64 - 1 := rfl
    have : (getCurrentEpoch a.state).toNat ≠ FAR_FUTURE_EPOCH.toNat := fun eq =>
      ne (UInt64.toNat_inj.mp eq)
    omega
  have active : isActiveAt a.state (getCurrentEpoch a.state) v.toNat = true := by
    refine isActiveAt_eq_true_iff.mpr ⟨vv, found, ?_⟩
    simp only [isActiveValidator, Bool.and_eq_true, decide_eq_true_eq]
    exact ⟨activated, by rw [unset]; exact UInt64.lt_iff_toNat_lt.mpr finite⟩
  have pending : ∀ u, fin.validators.data[v.toNat]? = some u →
      (getCurrentEpoch (⟨fork, fin⟩ : ForkedBeaconState preset).state).toNat + 1 <
        u.activationEpoch.toNat := by
    intro u foundFin
    rcases fresh with none | ⟨u', foundFin', far⟩
    · rw [none] at foundFin
      cases foundFin
    · obtain rfl := Option.some.inj (foundFin.symm.trans foundFin')
      rw [far]
      exact getCurrentEpoch_succ_lt_farFuture h.twoSlots fin
  have floor := PinKeys.Run.new_key_effective_floor toFin h.genesis h.parameters h.caps h.aligned
    h.twoSlots electra h.fulu (getCurrentEpoch pulled).toNat h.guard (fromFin.append pre) aEarly
    aInside h.window h.delay h.bands h.facts v.toNat pending active priorOk
  -- no queued partial withdrawal names the key at the finalized state, which has no activation
  have genesisPartials : Internal.AssignedPartials g.state := by
    obtain ⟨_, _, _, initialized⟩ := h.genesis
    have before := (initializeBeaconStateFromEth1_ok initialized).1
    intro fork
    exact (Nat.not_le_of_lt before (Nat.le_trans (by decide) fork)).elim
  have finPartials : Internal.AssignedPartials fin :=
    (Internal.CapStep.run toFin h.caps.activation h.caps.compounding h.early).2.1 genesisPartials
  have noEntry : ((((fin.pendingPartialWithdrawals electra).data.toList.filter
      fun entry => decide (entry.validatorIndex = v)).filter
        (fun entry => entry.withdrawableEpoch.toNat ≤ (getCurrentEpoch pulled).toNat + 1)).map
          (·.amount.toNat)).sum = 0 := by
    have none : (fin.pendingPartialWithdrawals electra).data.toList.filter
        (fun entry => decide (entry.validatorIndex = v)) = [] := by
      apply List.filter_eq_nil_iff.mpr
      intro entry member same
      obtain ⟨u, foundU, assignedU⟩ := finPartials electra entry member
      rw [of_decide_eq_true same] at foundU
      rcases fresh with absent | ⟨u', foundU', far⟩
      · rw [absent] at foundU
        cases foundU
      · obtain rfl := Option.some.inj (foundU.symm.trans foundU')
        exact assignedU far
    rw [none]
    rfl
  have debits := Run.partialDebit_le (fromFin.append pre) electra aEarly
    (getCurrentEpoch pulled).toNat ((getCurrentEpoch pulled).toNat + 1) aInside
    (window_short h) v priorOk
  have toUInt : v.toNat.toUInt64 = v := by simp
  have partials : (prior.map (DirectSafety.Apriori.Internal.floorPartialDebit
      v.toNat.toUInt64)).sum = 0 := by
    rw [toUInt]
    exact Nat.le_zero.mp (noEntry ▸ debits)
  have order := exitFloor_add_slack h
  have floorEq : (pinTerms config pulled anc fin).newKeyFloor =
      2 * preset.MAX_EFFECTIVE_BALANCE.toNat / 3 -
        preset.MAX_EFFECTIVE_BALANCE.toNat /
          (EthLib.Consensus.parameters preset fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat -
        preset.downwardBand - preset.EFFECTIVE_BALANCE_INCREMENT.toNat := rfl
  rw [parameters_of_fusaka h.fulu h.early] at floorEq
  have effective : effectiveAt a v.toNat = c.amount := by
    simp only [effectiveAt, found, Option.map_some, Option.getD_some]
    exact amount.symm
  have prefixSum : (prior.map (syncDebit v.toNat)).sum ≤ (events.map (syncDebit v.toNat)).sum := by
    obtain ⟨rest, rfl⟩ := isPrefix
    simp only [List.map_append, List.sum_append]
    omega
  omega

/-- A key of `K5` that is not exiting at the call and has a small charge is low or loses seats.

A small charge is below `exitFloor`.

The key is then a low key, or its sync debits from the finalized state exceed `newKeySlack`.

The debits are those of the replay of the run from the finalized state to C's state.

A key that is not activated at the finalized state loses seats, by `pending_key_claim`.

An activated key is active and not withdrawable at R, by `activated_key_at_pulled`.

Its low bound is covered by its charge and its debits, by `existing_low_le_charge`. -/
private theorem small_charge_claim (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩)
    {events : List (BalanceEvent preset)}
    (replayed : (fromFin.append tailC).balanceEvents (getCurrentEpoch pulled).toNat = .ok events)
    (v : ValidatorIndex)
    (activatedBy : ∀ c, counted.validators.data[v.toNat]? = some c →
      c.activationEpoch.toNat ≤ (getCurrentEpoch pulled).toNat)
    (epochLe : ∀ c ∈ tailC.departureCharges, c.index = v.toNat →
      c.epoch ≤ (getCurrentEpoch counted).toNat)
    (charged : ∃ c ∈ tailC.departureCharges, c.index = v.toNat)
    (small : exitQ tailC v.toNat < (pinTerms config pulled anc fin).exitFloor) :
    (pinTerms config pulled anc fin).lowB v.toNat = true ∨
      (pinTerms config pulled anc fin).newKeySlack < (events.map (syncDebit v.toNat)).sum := by
  classical
  by_cases fresh : fin.validators.data[v.toNat]? = none ∨
      ∃ w, fin.validators.data[v.toNat]? = some w ∧ w.activationEpoch = FAR_FUTURE_EPOCH
  · exact .inr (pending_key_claim h fromFin tailC replayed v epochLe charged small fresh)
  obtain ⟨absent, notFar⟩ := not_or.mp fresh
  obtain ⟨w, found⟩ := Option.ne_none_iff_exists'.mp absent
  have activated : w.activationEpoch ≠ FAR_FUTURE_EPOCH := fun far => notFar ⟨w, found, far⟩
  by_cases rich : (pinTerms config pulled anc fin).newKeySlack <
      (events.map (syncDebit v.toNat)).sum
  · exact .inr rich
  refine .inl (lowB_intro config pulled anc fin
    (activated_key_at_pulled h tailC v activatedBy charged found activated) ?_)
  have floor := existing_low_le_charge h fromFin tailC replayed v epochLe w found charged
  have order := exitFloor_add_slack h
  omega

/-- The total active balance at each step of a run from the finalized state is bounded.

It is at most three halves of the pulled total.

The run ends at most one epoch after the pulled epoch.

This is `total_band_of_guard` at the states of the steps of the run. -/
private theorem step_band_of_guard (h : Setting config checks g split fin pulled anc counted V)
    {e : BeaconState preset fork} (r : Run config checks ⟨fork, fin⟩ ⟨fork, e⟩)
    (within : (getCurrentEpoch e).toNat ≤ (getCurrentEpoch pulled).toNat + 1)
    {pulledTotal : Gwei} (pulledOk : getTotalActiveBalance pulled = .ok pulledTotal) :
    ∀ {u w : ForkedBeaconState preset} (step : Step config checks u w),
      r.Contains step → ∀ T : Gwei, getTotalActiveBalance w.state = .ok T →
        2 * T.toNat ≤ 3 * pulledTotal.toNat := by
  obtain ⟨shared⟩ := h.toFin
  obtain ⟨fromFin⟩ := h.fromFin
  obtain ⟨toPulled⟩ := h.toPulled
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  intro u w step member T read
  obtain ⟨pre, post, _, _, _⟩ :=
    DirectSafety.Apriori.Internal.Run.contains_step_facts member h.early
  have wEarly : w.fork < .glamsterdam :=
    Nat.lt_of_le_of_lt (fork_le_of_chainSteps post.chainSteps) h.early
  have wEpoch : (getCurrentEpoch w.state).toNat ≤ (getCurrentEpoch e).toNat :=
    UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps post.chainSteps)
  exact total_band_of_guard shared h.genesis h.parameters h.caps h.aligned h.twoSlots electra
    h.guard (fromFin.append toPulled) h.early (Nat.le_succ _) (pre.snoc step) wEarly
    (by omega) pulledOk read

/-- The sync debits of any keys over a run from the finalized block fit the window's envelope.

The run ends within one epoch of R's, and its events are read at R's epoch.

The seats of the window debit at most its slots' envelopes, one for each epoch to the run's end. -/
private theorem syncDebits_window_le (h : Setting config checks g split fin pulled anc counted V)
    {e : BeaconState preset fork} (run : Run config checks ⟨fork, fin⟩ ⟨fork, e⟩)
    (within : (getCurrentEpoch e).toNat ≤ (getCurrentEpoch pulled).toNat + 1)
    {events : List (BalanceEvent preset)}
    (replayed : run.balanceEvents (getCurrentEpoch pulled).toNat = .ok events)
    (S : Finset ValidatorIndex) :
    ∑ v ∈ S, (events.map (syncDebit v.toNat)).sum ≤
      ((getCurrentEpoch e).toNat + 1 - (getCurrentEpoch fin).toNat) *
        preset.SLOTS_PER_EPOCH.toNat * preset.SYNC_COMMITTEE_SIZE.toNat *
          PinTerms.syncEnvelope preset
            ((getTotalActiveBalance pulled).toOption.getD 0).toNat := by
  obtain ⟨pulledTotal, pulledOk⟩ := h.pulledTotal
  have band : ∀ {u w : ForkedBeaconState preset} (step : Step config checks u w),
      run.Contains step → ∀ T : Gwei, getTotalActiveBalance w.state = .ok T →
        2 * T.toNat ≤ 3 * pulledTotal.toNat :=
    step_band_of_guard h run within pulledOk
  have debits := (PinSeatDebits.Run.syncDebits_le run h.fulu h.early (getCurrentEpoch pulled).toNat
    replayed pulledTotal.toNat band (S.image fun v : ValidatorIndex => v.toNat)).1
  rw [Finset.sum_image fun _ _ _ _ same => UInt64.toNat_inj.mp same] at debits
  rwa [pulledOk]

/-- The keys whose sync debits from the finalized state exceed `newKeySlack` are at most the seats.

The sync debits of any keys over the run from the finalized state to C's state fit one envelope.

The envelope is for each seat and slot of the window.

A key over the slack has at least one more than the slack.

So the keys number at most the debits over the slack. -/
private theorem card_seat_keys_le (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩)
    {events : List (BalanceEvent preset)}
    (replayed : (fromFin.append tailC).balanceEvents (getCurrentEpoch pulled).toNat = .ok events)
    (B : Finset ValidatorIndex)
    (seats : ∀ v ∈ B, (pinTerms config pulled anc fin).newKeySlack <
      (events.map (syncDebit v.toNat)).sum) :
    B.card ≤ (pinTerms config pulled anc fin).newKeySeats := by
  classical
  have debits := syncDebits_window_le h (fromFin.append tailC) h.near replayed B
  have each : B.card * ((pinTerms config pulled anc fin).newKeySlack + 1) ≤
      ∑ v ∈ B, (events.map (syncDebit v.toNat)).sum := by
    have := Finset.card_nsmul_le_sum B
      (fun v : ValidatorIndex => (events.map (syncDebit v.toNat)).sum)
      ((pinTerms config pulled anc fin).newKeySlack + 1) fun v member => seats v member
    simpa [smul_eq_mul] using this
  have seatsEq : (pinTerms config pulled anc fin).newKeySeats =
      ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) *
        preset.SLOTS_PER_EPOCH.toNat * preset.SYNC_COMMITTEE_SIZE.toNat *
          PinTerms.syncEnvelope preset ((getTotalActiveBalance pulled).toOption.getD 0).toNat /
            max 1 (pinTerms config pulled anc fin).newKeySlack := rfl
  rw [seatsEq, Nat.le_div_iff_mul_le (lt_max_of_lt_left Nat.one_pos)]
  have epochs : (getCurrentEpoch counted).toNat + 1 - (getCurrentEpoch fin).toNat ≤
      (getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat := by have := h.near; omega
  have window := Nat.mul_le_mul_right
    (PinTerms.syncEnvelope preset ((getTotalActiveBalance pulled).toOption.getD 0).toNat)
    (Nat.mul_le_mul_right preset.SYNC_COMMITTEE_SIZE.toNat
      (Nat.mul_le_mul_right preset.SLOTS_PER_EPOCH.toNat epochs))
  have unit : max 1 (pinTerms config pulled anc fin).newKeySlack ≤
      (pinTerms config pulled anc fin).newKeySlack + 1 := by omega
  calc B.card * max 1 (pinTerms config pulled anc fin).newKeySlack
      ≤ B.card * ((pinTerms config pulled anc fin).newKeySlack + 1) := Nat.mul_le_mul_left _ unit
    _ ≤ _ := each
    _ ≤ _ := debits
    _ ≤ _ := by simpa [Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm] using window

/-- The keys that C's branch charges are few, if each is activated by R's epoch and exits by C.

A key is charged if the run has a departure charge at its position.

`card_big_charges_le` counts the charges of at least `exitFloor`.

`small_charge_claim` counts the small ones, and reads no exit flag of R.

They are at most the keys that `queueKeys` counts.

Those are the keys with a large charge, the low keys and the keys that lose seats. -/
private theorem charged_count_of (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (S : Finset ValidatorIndex)
    (keys : ∀ v ∈ S, (∀ c, counted.validators.data[v.toNat]? = some c →
        c.activationEpoch.toNat ≤ (getCurrentEpoch pulled).toNat) ∧
      (∀ c ∈ tailC.departureCharges, c.index = v.toNat →
        c.epoch ≤ (getCurrentEpoch counted).toNat) ∧
      ∃ c ∈ tailC.departureCharges, c.index = v.toNat) :
    S.card ≤ (pinTerms config pulled anc fin).queueKeys := by
  classical
  obtain ⟨fromFin⟩ := h.fromFin
  obtain ⟨events, replayed⟩ := (fromFin.append tailC).balanceEvents_ok h.early
    (getCurrentEpoch pulled).toNat
  have big := card_big_charges_le h tailC S
  set small := S.filter fun v => ¬ (pinTerms config pulled anc fin).exitFloor ≤
    exitQ tailC v.toNat with hSmall
  have claim : ∀ v ∈ small, (pinTerms config pulled anc fin).lowB v.toNat = true ∨
      (pinTerms config pulled anc fin).newKeySlack < (events.map (syncDebit v.toNat)).sum := by
    intro v member
    obtain ⟨inS, notBig⟩ := Finset.mem_filter.mp member
    obtain ⟨activatedBy, epochLe, charged⟩ := keys v inS
    exact small_charge_claim h fromFin tailC replayed v activatedBy epochLe charged
      (Nat.lt_of_not_ge notBig)
  have seats := card_seat_keys_le h fromFin tailC replayed
    (small.filter fun v => ¬ (pinTerms config pulled anc fin).lowB v.toNat = true) (by
      intro v member
      obtain ⟨inSmall, notLow⟩ := Finset.mem_filter.mp member
      exact (claim v inSmall).resolve_left notLow)
  have lows : (small.filter fun v => (pinTerms config pulled anc fin).lowB v.toNat = true).card ≤
      (pinTerms config pulled anc fin).lowKeys := by
    rw [lowKeys_eq]
    have count := voters_sum_le (voters := small.filter fun v =>
        (pinTerms config pulled anc fin).lowB v.toNat = true)
      (positions := (pinTerms config pulled anc fin).positions.filter fun i =>
        (pinTerms config pulled anc fin).lowB i = true) (fun _ => 1) (fun v member => by
      have low := (Finset.mem_filter.mp member).2
      obtain ⟨w, found⟩ := lowB_found config pulled anc fin low
      exact mem_positions_filter config pulled anc fin found low)
    simpa using count
  have coverSmall : small ⊆
      (small.filter fun v => (pinTerms config pulled anc fin).lowB v.toNat = true) ∪
        (small.filter fun v => ¬ (pinTerms config pulled anc fin).lowB v.toNat = true) := by
    intro v member
    by_cases low : (pinTerms config pulled anc fin).lowB v.toNat = true
    · exact Finset.mem_union_left _ (Finset.mem_filter.mpr ⟨member, low⟩)
    · exact Finset.mem_union_right _ (Finset.mem_filter.mpr ⟨member, low⟩)
  have coverS : S ⊆ (S.filter fun v => (pinTerms config pulled anc fin).exitFloor ≤
      exitQ tailC v.toNat) ∪ small := by
    intro v member
    by_cases large : (pinTerms config pulled anc fin).exitFloor ≤ exitQ tailC v.toNat
    · exact Finset.mem_union_left _ (Finset.mem_filter.mpr ⟨member, large⟩)
    · exact Finset.mem_union_right _ (Finset.mem_filter.mpr ⟨member, large⟩)
  have splitS := (Finset.card_le_card coverS).trans (Finset.card_union_le _ _)
  have splitSmall := (Finset.card_le_card coverSmall).trans (Finset.card_union_le _ _)
  rw [queueKeys_unfold]
  omega

/-- The keys of `K5` that C's branch charges are few.

Each is activated by R's epoch, since it is active in the epoch before C's. -/
private theorem charged_count (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) :
    ((K5 counted V).filter fun v => ∃ c ∈ tailC.departureCharges, c.index = v.toNat).card ≤
      (pinTerms config pulled anc fin).queueKeys := by
  refine charged_count_of h tailC _ fun v member => ?_
  obtain ⟨inK5, charged⟩ := Finset.mem_filter.mp member
  refine ⟨fun c foundC => ?_, charge_epoch_le_of_K5 h tailC inK5, charged⟩
  obtain ⟨u, foundU, activeBefore, -⟩ := K5_previous_only h inK5
  obtain rfl : u = c := Option.some.inj (foundU.symm.trans foundC)
  simp only [isActiveValidator, Bool.and_eq_true, decide_eq_true_eq] at activeBefore
  have low := UInt64.le_iff_toNat_le.mp activeBefore.1
  have previous := getPreviousEpoch_toNat counted
  have near := h.near
  omega

/-- K5 bands: the two bands beyond `credits`' one of each credited K5 key, weight 3.

Split by `exitingB`: the keys whose exit R reads and those the queues let exit on C. -/
private theorem bud_exitingBands (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ) :
    2 * (∑ v ∈ (K5 counted V), bandC tailC highC v.toNat) ≤
      (pinTerms config pulled anc fin).exitingBands :=
  two_bands_le_exitingBands config pulled anc fin counted V tailC highC
    (fun _ member flag _ => K5_charged h tailC member flag) (charged_count h tailC)

/-- K5 (`queueRise`): the rise of keys after their exit starts on C's branch.

Every key of `K5` with a departure charge counts, since `charged_count` bounds all of them. -/
private theorem bud_queueRise (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ) :
    3 * (∑ v ∈ (K5 counted V) with ∃ c ∈ tailC.departureCharges, c.index = v.toNat,
        riseQ tailC highC v.toNat) ≤
      (pinTerms config pulled anc fin).queueRise := by
  classical
  rw [queueRise_unfold]
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  have finalized := UInt64.le_iff_toNat_le.mp h.finalized
  have called := UInt64.le_iff_toNat_le.mp h.called
  have near := h.near
  have later := UInt64.le_iff_toNat_le.mp h.later
  by_cases tight : (pinTerms config pulled anc fin).tight = true
  · simp only [tight, ↓reduceIte]
    have tightLe : (pinTerms config pulled anc fin).depth ≤ 1 + preset.MAX_SEED_LOOKAHEAD.toNat :=
      of_decide_eq_true tight
    have depthEq : (pinTerms config pulled anc fin).depth =
        (getCurrentEpoch pulled).toNat + 2 - anc.finalizedCheckpoint.epoch.toNat := rfl
    rw [depthEq] at tightLe
    have none : ∀ v ∈ (K5 counted V).filter
        (fun v => ∃ c ∈ tailC.departureCharges, c.index = v.toNat),
        riseQ tailC highC v.toNat = 0 := by
      intro v member
      apply riseQ_eq_zero
      intro c charged same
      have inside := charge_epoch_le_of_K5 h tailC (Finset.mem_filter.mp member).1 c
        charged same
      have far : (getCurrentEpoch split).toNat + 1 + preset.MAX_SEED_LOOKAHEAD.toNat ≤ c.epoch :=
        DirectSafety.Run.departureCharges_epoch_ge_start tailC electra h.early c charged
      omega
    rw [Finset.sum_eq_zero none]
    simp
  · simp only [tight, Bool.false_eq_true, ↓reduceIte]
    have sumEq := Finset.sum_filter_ne_zero
      (s := (K5 counted V).filter fun v => ∃ c ∈ tailC.departureCharges, c.index = v.toNat)
      (f := fun v : ValidatorIndex => riseQ tailC highC v.toNat)
    have each := Finset.sum_le_card_nsmul
      (((K5 counted V).filter fun v => ∃ c ∈ tailC.departureCharges, c.index = v.toNat).filter
          fun v => riseQ tailC highC v.toNat ≠ 0)
      (fun v : ValidatorIndex => riseQ tailC highC v.toNat)
      (preset.upwardBand + (pinTerms config pulled anc fin).depth *
        (pinTerms config pulled anc fin).gainRateMax)
      fun v _ => riseQ_le h tailC highC v.toNat
    have count := (Finset.card_le_card (Finset.filter_subset
      (fun v : ValidatorIndex => riseQ tailC highC v.toNat ≠ 0)
      ((K5 counted V).filter fun v => ∃ c ∈ tailC.departureCharges, c.index = v.toNat))).trans
      (charged_count h tailC)
    rw [smul_eq_mul] at each
    rw [← sumEq]
    calc _ ≤ 3 * ((((K5 counted V).filter fun v =>
            ∃ c ∈ tailC.departureCharges, c.index = v.toNat).filter
          fun v => riseQ tailC highC v.toNat ≠ 0).card *
        (preset.upwardBand + (pinTerms config pulled anc fin).depth *
          (pinTerms config pulled anc fin).gainRateMax)) := Nat.mul_le_mul_left _ each
      _ ≤ _ := by
        rw [Nat.mul_assoc]
        exact Nat.mul_le_mul_left _ (Nat.mul_le_mul_right _ count)

/-- K5 (`exitingRise`): the keys whose exit R reads.

The keys of `K5` are those without a departure charge on C's run. -/
private theorem bud_exitingRise (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) :
    (∑ v ∈ (K5 counted V) with ¬ ∃ c ∈ tailC.departureCharges, c.index = v.toNat,
        (pinTerms config pulled anc fin).rise v.toNat) +
      (∑ v ∈ (K6 pulled counted) with (pinTerms config pulled anc fin).exitingB v.toNat = true,
        (pinTerms config pulled anc fin).rise v.toNat) ≤
      (pinTerms config pulled anc fin).exitingRise := by
  classical
  have exitingRise : (pinTerms config pulled anc fin).exitingRise =
      ∑ i ∈ (pinTerms config pulled anc fin).positions with
        (pinTerms config pulled anc fin).exitingB i = true,
        (pinTerms config pulled anc fin).rise i := by
    simp only [pinTerms, decide_eq_true_eq]
  have apart : Disjoint
      ((K5 counted V).filter fun v => ¬ ∃ c ∈ tailC.departureCharges, c.index = v.toNat)
      ((K6 pulled counted).filter fun v =>
        (pinTerms config pulled anc fin).exitingB v.toNat = true) := by
    refine Finset.disjoint_left.mpr fun v first second => ?_
    have active := (Finset.mem_filter.mp (Finset.mem_filter.mp second).1).1
    exact (Finset.mem_filter.mp (Finset.mem_filter.mp first).1).2.1 active
  rw [← Finset.sum_union apart, exitingRise]
  refine voters_sum_le (pinTerms config pulled anc fin).rise fun v selected => ?_
  have exiting : (pinTerms config pulled anc fin).exitingB v.toNat = true := by
    rcases Finset.mem_union.mp selected with chosen | chosen
    · exact K5_exiting_of_not_charged h tailC (Finset.mem_filter.mp chosen).1
        (Finset.mem_filter.mp chosen).2
    · exact (Finset.mem_filter.mp chosen).2
  have found : ∃ w, pulled.validators.data[v.toNat]? = some w := by
    obtain ⟨-, -, read⟩ := (by simpa only [pinTerms, decide_eq_true_eq] using exiting :
      _ ∧ _ ∧ ((pulled.validators.data[v.toNat]?).map fun w =>
        decide (w.exitEpoch.toNat ≤ (getCurrentEpoch pulled).toNat + 1)).getD false = true)
    exact validator_of_flag (.inr read)
  obtain ⟨w, found⟩ := found
  exact mem_positions_filter config pulled anc fin found exiting

/-- The credits of a set of keys in one event are at most the event's credit limit. -/
private theorem sum_keyCredit_le_creditLimit (S : Finset ValidatorIndex) (e : BalanceEvent preset)
    (bounded : e.credits ≤ e.creditLimit) : ∑ v ∈ S, keyCredit v.toNat e ≤ e.creditLimit := by
  refine Nat.le_trans ?_ bounded
  unfold keyCredit
  have inj : Set.InjOn (fun v : ValidatorIndex => v.toNat) S := fun a _ b _ same =>
    UInt64.toNat_inj.mp same
  rw [← Finset.sum_image (f := fun i => actualBalanceAt e.after i - actualBalanceAt e.before i)
    inj]
  exact PinSeatDebits.keys_credits_le _ e

/-- The block credits of one epoch, against the pin's rate on the pulled total.

The rewards of the epoch are at most `54 / 448` of the rate on each active set.

Each active set is at most the total, which is within three halves of the pulled total. -/
private theorem propN_arith {inc c pi pq a b total T : ℕ} (incPos : 0 < inc)
    (credits : c * 448 ≤ 54 * pi * (a + b)) (prev : pi * a ≤ pq * (total / inc))
    (curr : pi * b ≤ pq * (total / inc)) (band : 2 * total ≤ 3 * T) :
    c * 896 ≤ 324 * (pq * (T / inc)) + 216 * pq := by
  have h1 := Nat.div_mul_le_self total inc
  have h2 := Nat.lt_mul_div_succ T incPos
  have K2 : 2 * (total / inc) ≤ 3 * (T / inc) + 2 := by
    have : 2 * (total / inc) * inc < (3 * (T / inc) + 3) * inc := by nlinarith
    have := Nat.lt_of_mul_lt_mul_right this
    omega
  have e : c * 448 ≤ 54 * (2 * (pq * (total / inc))) := by
    calc c * 448 ≤ 54 * pi * (a + b) := credits
      _ = 54 * (pi * a + pi * b) := by ring
      _ ≤ _ := by omega
  calc c * 896 = 2 * (c * 448) := by ring
    _ ≤ 2 * (54 * (2 * (pq * (total / inc)))) := by omega
    _ = 108 * (pq * (2 * (total / inc))) := by ring
    _ ≤ 108 * (pq * (3 * (T / inc) + 2)) := Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ K2)
    _ = 324 * (pq * (T / inc)) + 216 * pq := by ring

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The reward rate and the total at the start of a run in `fin`'s epoch or later are bounded.

The state is reached from `fin`, or it precedes `fin` in its epoch and reads what `fin` reads. -/
private theorem start_rates (h : Setting config checks g split fin pulled anc counted V)
    {m : BeaconState preset fork}
    (within : (getCurrentEpoch m).toNat ≤ (getCurrentEpoch pulled).toNat + 1)
    (link : Nonempty (Run config checks ⟨fork, fin⟩ ⟨fork, m⟩) ∨
      ∃ _ : Run config checks ⟨fork, m⟩ ⟨fork, fin⟩, getCurrentEpoch fin = getCurrentEpoch m)
    {pq : Gwei} (pqOk : getBaseRewardPerIncrement preset
      (if 18 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤
          ((getTotalActiveBalance pulled).toOption.getD 0).toNat then
        (getTotalActiveBalance pulled).toOption.getD 0 / 4
      else preset.EFFECTIVE_BALANCE_INCREMENT / 5) = .ok pq)
    {T : Gwei} (pulledOk : getTotalActiveBalance pulled = .ok T)
    {total perIncrement : Gwei} (totalOk : getTotalActiveBalance m = .ok total)
    (per : getBaseRewardPerIncrement preset total = .ok perIncrement) :
    perIncrement.toNat * ((∑ i ∈ (getActiveValidatorIndices m (getPreviousEpoch m)).toFinset,
        effectiveAt (⟨fork, m⟩ : ForkedBeaconState preset) i.toNat) /
          preset.EFFECTIVE_BALANCE_INCREMENT.toNat) ≤
      pq.toNat * (total.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat) ∧
    perIncrement.toNat * ((∑ i ∈ (getActiveValidatorIndices m (getCurrentEpoch m)).toFinset,
        effectiveAt (⟨fork, m⟩ : ForkedBeaconState preset) i.toNat) /
          preset.EFFECTIVE_BALANCE_INCREMENT.toNat) ≤
      pq.toNat * (total.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat) ∧
    2 * total.toNat ≤ 3 * T.toNat := by
  obtain ⟨toFin⟩ := h.toFin
  obtain ⟨fromFin⟩ := h.fromFin
  obtain ⟨toPulled⟩ := h.toPulled
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  rcases link with toMne | ⟨back, same⟩
  · obtain ⟨toM⟩ := toMne
    exact ⟨rate_of_guard h toM within (Or.inl rfl) pqOk total perIncrement totalOk per,
      rate_of_guard h toM within (Or.inr rfl) pqOk total perIncrement totalOk per,
      total_band_of_guard toFin h.genesis h.parameters h.caps h.aligned h.twoSlots electra
        h.guard (fromFin.append toPulled) h.early (Nat.le_succ _) toM h.early within pulledOk
        totalOk⟩
  · have current := activeStake_eq_of_same_epoch back h.early same (getCurrentEpoch m)
      (UInt64.le_refl _)
    have previous := activeStake_eq_of_same_epoch back h.early same (getPreviousEpoch m)
      (getPreviousEpoch_le _)
    have previousSame : getPreviousEpoch fin = getPreviousEpoch m := by
      simp only [getPreviousEpoch, same]
    obtain ⟨-, -, value⟩ := getTotalBalance_ok_iff_stake.mp (getTotalActiveBalance_ok totalOk)
    change total.toNat = max preset.EFFECTIVE_BALANCE_INCREMENT.toNat
      (∑ i ∈ (getActiveValidatorIndices m (getCurrentEpoch m)).toFinset,
        effectiveAt (⟨fork, m⟩ : ForkedBeaconState preset) i.toNat) at value
    obtain ⟨atFin, atFinOk, atFinValue⟩ := totalActive_exists (s := fin) h.early (by
      rw [same, current]
      exact Nat.lt_of_le_of_lt (by rw [value]; exact le_max_right _ _) total.toNat_lt)
    simp only [same] at atFinValue
    have amounts : atFin = total := UInt64.toNat_inj.mp (by rw [atFinValue, current, value])
    subst amounts
    have inside : (getCurrentEpoch fin).toNat ≤ (getCurrentEpoch pulled).toNat + 1 := by
      rw [same]
      exact within
    have first := rate_of_guard h (Run.nil : Run config checks ⟨fork, fin⟩ ⟨fork, fin⟩) inside
      (Or.inl rfl) pqOk atFin perIncrement atFinOk per
    have second := rate_of_guard h (Run.nil : Run config checks ⟨fork, fin⟩ ⟨fork, fin⟩) inside
      (Or.inr rfl) pqOk atFin perIncrement atFinOk per
    refine ⟨?_, ?_, total_band_of_guard toFin h.genesis h.parameters h.caps h.aligned
      h.twoSlots electra h.guard (fromFin.append toPulled) h.early (Nat.le_succ _)
      (Run.nil : Run config checks ⟨fork, fin⟩ ⟨fork, fin⟩) h.early inside pulledOk atFinOk⟩
    · rw [previousSame, previous] at first
      exact first
    · rw [same, current] at second
      exact second

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The proposer credits of a set of keys over a run inside one epoch of C's branch are bounded.

The bound is the pin's rate on the pulled total, with `896` times the credits on the left.

The block steps of the run credit at most `54 / 448` of the rate on the active increments.

A run with no reads of the rate credits nothing. -/
private theorem propN_epoch_le (h : Setting config checks g split fin pulled anc counted V)
    (highC : ℕ) (S : Finset ValidatorIndex) {T : Gwei}
    (pulledOk : getTotalActiveBalance pulled = .ok T) {m : BeaconState preset fork}
    (toM : Run config checks g ⟨fork, m⟩)
    (link : Nonempty (Run config checks ⟨fork, fin⟩ ⟨fork, m⟩) ∨
      ∃ _ : Run config checks ⟨fork, m⟩ ⟨fork, fin⟩, getCurrentEpoch fin = getCurrentEpoch m)
    {u : ForkedBeaconState preset}
    (inner : Run config checks ⟨fork, m⟩ u) (rest : Run config checks u ⟨fork, counted⟩)
    (same : getCurrentEpoch u.state = getCurrentEpoch m) :
    (∑ v ∈ S, (creditScan (fun s => decide (s = .rewards)) (fun _ => false) v.toNat highC
      inner)) * 896 ≤
      324 * ((pinTerms config pulled anc fin).perIncrement *
        (T.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat)) +
        216 * (pinTerms config pulled anc fin).perIncrement := by
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  have uFork : u.fork = fork := fork_eq_of_run inner rest (Nat.le_refl _)
  have uEarly : u.fork < .glamsterdam := by rw [uFork]; exact h.early
  have within : (getCurrentEpoch m).toNat ≤ (getCurrentEpoch pulled).toNat + 1 :=
    Nat.le_trans (UInt64.le_iff_toNat_le.mp
      (currentEpoch_le_of_chainSteps (inner.append rest).chainSteps)) h.near
  obtain ⟨events, replayed, bounded⟩ :=
    Run.balanceEvents_bounded toM inner h.genesis uEarly highC
  have scan : ∑ v ∈ S, (creditScan (fun s => decide (s = .rewards)) (fun _ => false) v.toNat highC
      inner) ≤ sourceCredits .rewards events := by
    have := creditScan_sum_le S UInt64.toNat (fun s => decide (s = .rewards)) (fun _ => false) highC
      (fun e => e.creditLimit) inner replayed fun e member _ =>
        sum_keyCredit_le_creditLimit S e (bounded e member).1
    simpa [sourceCredits] using this
  obtain ⟨reads, data⟩ := epoch_credits_data inner (by exact electra) uEarly same highC replayed
  rcases reads with ⟨total, perIncrement, totalOk, per⟩ | ⟨quiet, -⟩
  swap
  · rw [quiet] at scan
    simp [Nat.le_zero.mp scan]
  obtain ⟨credits, -⟩ := data total perIncrement totalOk per
  obtain ⟨pq, pqOk⟩ := quarter_base_ok h.facts per ((getTotalActiveBalance pulled).toOption.getD 0)
  obtain ⟨prev, curr, band⟩ := start_rates h within link pqOk pulledOk totalOk per
  have rate : (pinTerms config pulled anc fin).perIncrement = pq.toNat := by
    show ((getBaseRewardPerIncrement preset
      (if 18 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤
          ((getTotalActiveBalance pulled).toOption.getD 0).toNat then
        (getTotalActiveBalance pulled).toOption.getD 0 / 4
      else preset.EFFECTIVE_BALANCE_INCREMENT / 5)).toOption.getD 0).toNat = pq.toNat
    rw [pqOk]
    rfl
  have incPos : 0 < preset.EFFECTIVE_BALANCE_INCREMENT.toNat := by
    have := h.facts.incrementSize
    omega
  rw [rate]
  exact Nat.le_trans (Nat.mul_le_mul_right 896 scan)
    (propN_arith incPos credits prev curr band)

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The proposer credits of a set of keys over a one-epoch segment of C's branch are bounded.

The segment may follow a run `head` of its own epoch, whose credits it adds to.

The bound is the pin's rate on the pulled total, with `896` times the credits on the left.

The slot that ends the segment adds no block credit.

So the segment fits as its run before that slot does. -/
private theorem propN_segment_le (h : Setting config checks g split fin pulled anc counted V)
    (highC : ℕ) (S : Finset ValidatorIndex) {T : Gwei}
    (pulledOk : getTotalActiveBalance pulled = .ok T) {s0 : BeaconState preset fork}
    {m n : ForkedBeaconState preset} (toS : Run config checks g ⟨fork, s0⟩)
    (link : Nonempty (Run config checks ⟨fork, fin⟩ ⟨fork, s0⟩) ∨
      ∃ _ : Run config checks ⟨fork, s0⟩ ⟨fork, fin⟩, getCurrentEpoch fin = getCurrentEpoch s0)
    (head : Run config checks ⟨fork, s0⟩ m) (mid : Run config checks m n)
    (rest : Run config checks n ⟨fork, counted⟩)
    (sameStart : getCurrentEpoch m.state = getCurrentEpoch s0)
    (starts : ∀ {u w : ForkedBeaconState preset} (step : Step config checks u w),
      mid.Contains step → getCurrentEpoch u.state = getCurrentEpoch m.state) :
    ((∑ v ∈ S, (creditScan (fun s => decide (s = .rewards)) (fun _ => false) v.toNat highC
      head)) + ∑ v ∈ S, (creditScan (fun s => decide (s = .rewards)) (fun _ => false) v.toNat
        highC mid)) * 896 ≤
      324 * ((pinTerms config pulled anc fin).perIncrement *
        (T.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat)) +
        216 * (pinTerms config pulled anc fin).perIncrement := by
  have mFork : m.fork = fork := fork_eq_of_run head (mid.append rest) (Nat.le_refl _)
  obtain ⟨mf, ms⟩ := m
  obtain rfl : mf = fork := mFork
  rcases DirectSafety.Apriori.Internal.segment_slot_cases mid starts with same |
    ⟨u, inner, boundary, rfl, uEpoch, -⟩
  · have whole := propN_epoch_le h highC S pulledOk toS link (head.append mid) rest
      (same.trans sameStart)
    simp only [creditScan_append, Finset.sum_add_distrib] at whole
    exact whole
  · have whole := propN_epoch_le h highC S pulledOk toS link (head.append inner)
      ((Run.nil.snoc (Step.slot boundary)).append rest) (uEpoch.trans sameStart)
    simp only [creditScan_append, Finset.sum_add_distrib] at whole
    refine Nat.le_trans (Nat.mul_le_mul_right 896 (Nat.add_le_add_left
      (Finset.sum_le_sum fun v _ => ?_) _)) whole
    rw [creditScan_snoc]
    split <;> simp [stepCredit]

/-- The whole increments of aligned stakes are at most those of larger stakes on a larger set. -/
private theorem stake_le_base {α : Type} {inc pq : ℕ} {P : Finset ℕ} {f : ℕ → ℕ} {A : Finset α}
    {g : α → ℕ} (e : ℕ → ℕ) (incPos : 0 < inc) (inj : Set.InjOn g A)
    (inside : ∀ a ∈ A, g a ∈ P) (le : ∀ a ∈ A, e (g a) ≤ f (g a)) (dvd : ∀ j, inc ∣ e j) :
    pq * ((∑ a ∈ A, e (g a)) / inc) ≤ ∑ j ∈ P, f j / inc * pq := by
  rw [← Finset.sum_image (f := e) inj]
  have exact : ∑ j ∈ A.image g, e j = inc * ∑ j ∈ A.image g, e j / inc := by
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun j _ => (Nat.mul_div_cancel' (dvd j)).symm
  rw [exact, Nat.mul_div_cancel_left _ incPos, Finset.mul_sum]
  refine Nat.le_trans (Finset.sum_le_sum fun j member => ?_)
    (Finset.sum_le_sum_of_subset (f := fun j => f j / inc * pq) fun j member => ?_)
  · obtain ⟨a, inA, rfl⟩ := Finset.mem_image.mp member
    rw [Nat.mul_comm]
    exact Nat.mul_le_mul_right _ (Nat.div_le_div_right (le a inA))
  · obtain ⟨a, inA, rfl⟩ := Finset.mem_image.mp member
    exact inside a inA

/-- The epoch bound of the pin's rate on the pulled total is at most the proposer credit.

The proposer base pays the bound, and `attesterExcess` pays one more increment's rate. -/
private theorem credit_arith {inc pi E T P A : ℕ} (incPos : 0 < inc) (hT : T = max inc E)
    (hP : pi * (E / inc) ≤ P) (hA : 1 ≤ A) :
    (324 * (pi * (T / inc)) + 216 * pi) / 896 ≤ P + A * pi := by
  have one : T / inc ≤ E / inc + 1 := by
    rw [hT]
    rcases le_total inc E with h | h
    · rw [max_eq_right h]; omega
    · rw [max_eq_left h, Nat.div_self incPos]; exact Nat.le_add_left _ _
  have mul : pi * (T / inc) ≤ pi * (E / inc) + pi := by
    calc pi * (T / inc) ≤ pi * (E / inc + 1) := Nat.mul_le_mul_left _ one
      _ = _ := by ring
  have A1 : pi ≤ A * pi := Nat.le_mul_of_pos_left _ hA
  refine Nat.div_le_of_le_mul ?_
  nlinarith

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- C's proposer credits to any set of keys, with the sync part of the bound, are bounded.

The credits start at a state `b` of the split's epoch, so they include the run `pre` from `b`.

The bound is the proposer credit of each epoch of the window.

The credits of each epoch are cut over the blocks, and the split's epoch is cut once from `b`.

So the flag rewards of its epoch pass are not read. -/
private theorem proposer_rewards_le (h : Setting config checks g split fin pulled anc counted V)
    {b : BeaconState preset fork} (toB : Run config checks g ⟨fork, b⟩)
    (link : Nonempty (Run config checks ⟨fork, fin⟩ ⟨fork, b⟩) ∨
      ∃ _ : Run config checks ⟨fork, b⟩ ⟨fork, fin⟩, getCurrentEpoch fin = getCurrentEpoch b)
    (pre : Run config checks ⟨fork, b⟩ ⟨fork, split⟩)
    (sameEpoch : getCurrentEpoch split = getCurrentEpoch b)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (S : Finset ValidatorIndex) :
    (∑ v ∈ S, propN (pre.append tailC) highC v.toNat) +
        (pinTerms config pulled anc fin).depth * (pinTerms config pulled anc fin).syncProposer ≤
      (pinTerms config pulled anc fin).depth * (pinTerms config pulled anc fin).proposerCredit := by
  obtain ⟨T, pulledOk⟩ := h.pulledTotal
  obtain ⟨toFin⟩ := h.toFin
  obtain ⟨fromFin⟩ := h.fromFin
  obtain ⟨toPulled⟩ := h.toPulled
  have incPos : 0 < preset.EFFECTIVE_BALANCE_INCREMENT.toNat := by
    have := h.facts.incrementSize
    omega
  obtain ⟨B, hB⟩ : ∃ B, B = (324 * ((pinTerms config pulled anc fin).perIncrement *
      (T.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat)) +
        216 * (pinTerms config pulled anc fin).perIncrement) / 896 := ⟨_, rfl⟩
  -- the credits of `pre` are those of one epoch run, so they fit one epoch's bound
  obtain ⟨P, hP⟩ : ∃ P, P = ∑ v ∈ S, (creditScan (fun s => decide (s = .rewards))
    (fun _ => false) v.toNat highC pre) := ⟨_, rfl⟩
  have first : P ≤ B := by
    have one := propN_segment_le h highC S pulledOk toB link pre
      (Run.nil : Run config checks ⟨fork, split⟩ ⟨fork, split⟩) tailC sameEpoch
      (fun step member => by cases member)
    rw [hB, hP]
    refine (Nat.le_div_iff_mul_le (by norm_num)).mpr (Nat.le_trans ?_ one)
    simp only [creditScan_nil, Finset.sum_const_zero, Nat.add_zero]
    exact Nat.le_refl _
  have cut := run_cuts_of_additive tailC h.early (fun _ => True)
    (fun r => ∑ v ∈ S, (creditScan (fun s => decide (s = .rewards)) (fun _ => false) v.toNat highC
      r)) (fun i => if i = 0 then B - P else B)
    (fun pre post _ => by simp only [creditScan_append, Finset.sum_add_distrib])
    (fun _ _ _ _ => trivial)
    (fun {m n} toM mid rest starts _ => by
      obtain ⟨mf, ms⟩ := m
      obtain rfl : fork = mf := (fork_eq_of_run toM (mid.append rest) (Nat.le_refl _)).symm
      by_cases e : getCurrentEpoch ms = getCurrentEpoch split
      · -- the segment is in the split's epoch, so it adds to the credits of `pre`
        have index : ix (⟨fork, split⟩ : ForkedBeaconState preset) ⟨fork, ms⟩ = 0 := by
          simp only [ix, e]
          omega
        simp only [index, ↓reduceIte]
        have one := propN_segment_le h highC S pulledOk toB link (pre.append toM) mid rest
          (by simpa only [sameEpoch] using e) starts
        have again : P ≤ ∑ v ∈ S, (creditScan (fun s => decide (s = .rewards)) (fun _ => false)
            v.toNat highC (pre.append toM)) := by
          rw [hP]
          exact Finset.sum_le_sum fun v _ => by
            rw [creditScan_append]
            exact Nat.le_add_right _ _
        have bound : P + ∑ v ∈ S, (creditScan (fun s => decide (s = .rewards)) (fun _ => false)
            v.toNat highC mid) ≤ B := by
          rw [hB]
          exact (Nat.le_div_iff_mul_le (by norm_num)).mpr
            (Nat.le_trans (Nat.mul_le_mul_right 896 (Nat.add_le_add_right again _)) one)
        omega
      · have later : getCurrentEpoch split < getCurrentEpoch ms :=
          UInt64.lt_of_le_of_ne (currentEpoch_le_of_chainSteps toM.chainSteps) (Ne.symm e)
        have index : ix (⟨fork, split⟩ : ForkedBeaconState preset) ⟨fork, ms⟩ ≠ 0 := by
          have := UInt64.lt_iff_toNat_lt.mp later
          simp only [ix]
          omega
        simp only [index, ↓reduceIte]
        rw [hB]
        have one := propN_segment_le h highC S pulledOk ((toFin.append fromFin).append toM)
          (Or.inl ⟨fromFin.append toM⟩) (Run.nil : Run config checks ⟨fork, ms⟩ ⟨fork, ms⟩) mid
          rest rfl starts
        simp only [creditScan_nil, Finset.sum_const_zero, Nat.zero_add] at one
        exact (Nat.le_div_iff_mul_le (by norm_num)).mpr one)
    (ix ⟨fork, split⟩ ⟨fork, counted⟩ + 1) (fun step member => steps_before_end tailC step member)
  have total : ∀ t : ℕ, ((List.range (t + 1)).map
      (fun i => if i = 0 then B - P else B)).sum + P ≤ (t + 1) * B := by
    intro t
    induction t with
    | zero => simp only [List.range_one, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil,
        ↓reduceIte, Nat.add_zero, Nat.zero_add]; omega
    | succ t ih =>
      rw [List.range_succ, List.map_append, List.sum_append]
      simp only [List.map_cons, List.map_nil, List.sum_cons, List.sum_nil,
        Nat.succ_ne_zero t, ↓reduceIte] at ih ⊢
      have : (t + 1 + 1) * B = (t + 1) * B + B := by ring
      omega
  have joined : ∑ v ∈ S, propN (pre.append tailC) highC v.toNat =
      P + ∑ v ∈ S, (creditScan (fun s => decide (s = .rewards)) (fun _ => false) v.toNat highC
        tailC) := by
    rw [hP, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun v _ => creditScan_append _ _ _ _ pre tailC
  have depth : ix ⟨fork, split⟩ ⟨fork, counted⟩ + 1 ≤ (pinTerms config pulled anc fin).depth := by
    have fin' := UInt64.le_iff_toNat_le.mp h.finalized
    have called := UInt64.le_iff_toNat_le.mp h.called
    have near := h.near
    show _ ≤ (getCurrentEpoch pulled).toNat + 2 - anc.finalizedCheckpoint.epoch.toNat
    simp only [ix]
    omega
  have credit : B + (pinTerms config pulled anc fin).syncProposer ≤
      (pinTerms config pulled anc fin).proposerCredit := by
    obtain ⟨-, -, value⟩ := getTotalBalance_ok_iff_stake.mp (getTotalActiveBalance_ok pulledOk)
    rw [hB]
    simp only [pinTerms]
    refine Nat.add_le_add_right (credit_arith incPos value ?_ ?_) _
    · refine stake_le_base (g := UInt64.toNat) (fun j => balanceAt pulled j) incPos
        (fun a _ b _ same => UInt64.toNat_inj.mp same) (fun a member => ?_)
        (fun a _ => Nat.le_trans (Nat.le_add_right _ _) (le_max_left _ _)) fun j =>
          Nat.dvd_of_mod_eq_zero (FloorTrace.effective_aligned
            (toFin.append (fromFin.append toPulled)) h.genesis h.aligned j)
      obtain ⟨w, found, active⟩ := (mem_getActiveValidatorIndices
        (pulled.validators.bound h.early)).mp (List.mem_toFinset.mp member)
      simp only [isActiveValidator, Bool.and_eq_true, decide_eq_true_eq] at active
      have exit := UInt64.lt_iff_toNat_lt.mp active.2
      have fin' := UInt64.le_iff_toNat_le.mp h.finalized
      have called := UInt64.le_iff_toNat_le.mp h.called
      exact mem_positions_filter config pulled anc fin found (by simp [found]; omega)
    · have slots := h.twoSlots
      have two : 2 ≤ (getCurrentEpoch pulled).toNat + 2 - anc.finalizedCheckpoint.epoch.toNat := by
        have := UInt64.le_iff_toNat_le.mp h.finalized
        have := UInt64.le_iff_toNat_le.mp h.called
        omega
      -- The first of the credited keys' slots is one of the terms of `attesterExcess`.
      iterate 4 refine Nat.le_trans ?_ (Nat.le_add_right _ _)
      refine Nat.le_trans ?_ (Nat.le_add_left _ _)
      iterate 3 refine Nat.le_trans ?_ (Nat.le_add_right _ _)
      exact Nat.le_trans (by decide) (Nat.mul_le_mul two slots)
  calc _ ≤ (ix ⟨fork, split⟩ ⟨fork, counted⟩ + 1) * B +
        (pinTerms config pulled anc fin).depth * (pinTerms config pulled anc fin).syncProposer :=
      Nat.add_le_add_right (by
        rw [joined]
        have := total (ix ⟨fork, split⟩ ⟨fork, counted⟩)
        omega) _
    _ ≤ (pinTerms config pulled anc fin).depth * B +
        (pinTerms config pulled anc fin).depth * (pinTerms config pulled anc fin).syncProposer :=
      Nat.add_le_add_right (Nat.mul_le_mul_right _ depth) _
    _ ≤ _ := by rw [← Nat.mul_add]; exact Nat.mul_le_mul_left _ credit

/-- The sources of the due entries of X's queue that name a target in `T`. -/
private def dueList (X : BeaconState preset fork) (electra : .pectra ≤ fork) (high : ℕ)
    (T : Finset ValidatorIndex) : List Validator :=
  (((X.pendingConsolidations electra).data.toList.filter fun c =>
      decide (c.targetIndex ∈ T)).filterMap fun c =>
    X.validators.data[c.sourceIndex.toNat]?).filter fun v =>
      !v.slashed && decide (v.withdrawableEpoch.toNat ≤ high + 1)

/-- `dueAt` counts `dueList`. -/
private theorem dueAt_eq (X : BeaconState preset fork) (electra : .pectra ≤ fork) (high : ℕ)
    (T : Finset ValidatorIndex) : dueAt X high T = (dueList X electra high T).length := by
  unfold dueAt dueList
  simp only [electra, ↓reduceDIte]

/-- The caps of the due entries of two disjoint sets of targets add up. -/
private theorem dueList_sum_union (X : BeaconState preset fork) (electra : .pectra ≤ fork)
    (high : ℕ) {A B : Finset ValidatorIndex} (disjoint : Disjoint A B) (f : Validator → ℕ) :
    ((dueList X electra high (A ∪ B)).map f).sum =
      ((dueList X electra high A).map f).sum + ((dueList X electra high B).map f).sum := by
  -- Each entry adds the value of its source when the source passes the test, else nothing.
  have perEntry : ∀ (M : List PendingConsolidation)
      (look : PendingConsolidation → Option Validator) (ok : Validator → Bool),
      (((M.filterMap look).filter ok).map f).sum =
        (M.map fun c => (((look c).filter ok).map f).getD 0).sum := by
    intro M look ok
    induction M with
    | nil => rfl
    | cons c M ih =>
      cases found : look c with
      | none => simp [found, ih]
      | some w => by_cases keep : ok w = true <;> simp [found, keep, ih, Option.filter]
  unfold dueList
  rw [perEntry, perEntry, perEntry]
  have := sum_filter_or (X.pendingConsolidations electra).data.toList
    (fun c => decide (c.targetIndex ∈ A)) (fun c => decide (c.targetIndex ∈ B))
    (by
      rintro c ⟨ha, hb⟩
      simp only [decide_eq_true_eq] at ha hb
      exact Finset.disjoint_left.mp disjoint ha hb)
    (fun c => ((((X.validators.data[c.sourceIndex.toNat]?).filter fun v =>
      !v.slashed && decide (v.withdrawableEpoch.toNat ≤ high + 1)).map f).getD 0))
  simpa [Finset.mem_union, Bool.decide_or] using this

/-- The due entries of two disjoint sets of targets number as many as those of their union. -/
private theorem dueList_length_union (X : BeaconState preset fork) (electra : .pectra ≤ fork)
    (high : ℕ) {A B : Finset ValidatorIndex} (disjoint : Disjoint A B) :
    (dueList X electra high (A ∪ B)).length =
      (dueList X electra high A).length + (dueList X electra high B).length := by
  have := dueList_sum_union X electra high disjoint (fun _ => 1)
  simpa using this

/-- A later horizon keeps at least the stake of an earlier one. -/
private theorem dueList_sum_mono (X : BeaconState preset fork) (electra : .pectra ≤ fork)
    {high high' : ℕ} (later : high ≤ high') (T : Finset ValidatorIndex) (f : Validator → ℕ) :
    ((dueList X electra high T).map f).sum ≤ ((dueList X electra high' T).map f).sum := by
  unfold dueList
  have sub : List.Sublist
      ((((X.pendingConsolidations electra).data.toList.filter fun c =>
        decide (c.targetIndex ∈ T)).filterMap fun c =>
      X.validators.data[c.sourceIndex.toNat]?).filter
        (fun v => !v.slashed && decide (v.withdrawableEpoch.toNat ≤ high + 1)))
      ((((X.pendingConsolidations electra).data.toList.filter fun c =>
        decide (c.targetIndex ∈ T)).filterMap fun c =>
      X.validators.data[c.sourceIndex.toNat]?).filter
        (fun v => !v.slashed && decide (v.withdrawableEpoch.toNat ≤ high' + 1))) := by
    refine List.monotone_filter_right _ fun b hb => ?_
    simp only [Bool.and_eq_true, decide_eq_true_eq] at hb ⊢
    exact ⟨hb.1, by omega⟩
  exact (sub.map f).sum_le_sum fun _ _ => Nat.zero_le _

/-- A later horizon keeps at least the entries of an earlier one. -/
private theorem dueList_length_mono (X : BeaconState preset fork) (electra : .pectra ≤ fork)
    {high high' : ℕ} (later : high ≤ high') (T : Finset ValidatorIndex) :
    (dueList X electra high T).length ≤ (dueList X electra high' T).length := by
  simpa using dueList_sum_mono X electra later T fun _ => 1

/-- More targets keep at least the entries of fewer. -/
private theorem dueList_length_subset (X : BeaconState preset fork) (electra : .pectra ≤ fork)
    (high : ℕ) {A B : Finset ValidatorIndex} (sub : A ⊆ B) :
    (dueList X electra high A).length ≤ (dueList X electra high B).length := by
  unfold dueList
  refine (((List.monotone_filter_right _ fun c hc => ?_).filterMap _).filter _).length_le
  simp only [decide_eq_true_eq] at hc ⊢
  exact sub hc

/-- The due entries of any targets have at most the stake of all entries read at that horizon. -/
private theorem dueList_sum_le_all (X : BeaconState preset fork) (electra : .pectra ≤ fork)
    (high : ℕ) (T : Finset ValidatorIndex) (f : Validator → ℕ) :
    ((dueList X electra high T).map f).sum ≤
      ((((((X.pendingConsolidations electra).data.toList.filterMap fun c =>
        X.validators.data[c.sourceIndex.toNat]?).filter fun v =>
          !v.slashed && decide (v.withdrawableEpoch.toNat ≤ high + 1)).map f)).sum) := by
  unfold dueList
  refine (List.Sublist.map f ?_).sum_le_sum fun _ _ => Nat.zero_le _
  exact (List.filter_sublist.filterMap _).filter _

/-- A whistleblower's share of an amount is at most the amount.

The quotient is at least thirty, so a share of `33/300` of the amount, rounded up, fits. -/
private theorem wShare_le (facts : PinPresetFacts preset) (x : ℕ) : wShare preset fork x ≤ x := by
  have quotient := facts.whistleblower fork
  unfold wShare
  generalize (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat = W at *
  have pos : 0 < 10 * W := by omega
  refine Nat.lt_succ_iff.mp ((Nat.div_lt_iff_lt_mul pos).mpr ?_)
  have big : 33 * x ≤ 10 * W * x := Nat.mul_le_mul_right _ (by omega)
  have two : (x + 1) * (10 * W) = 10 * W * x + 10 * W := by ring
  show 33 * x + 10 * W - 1 < (x + 1) * (10 * W)
  omega

/-- The due entries of a set of targets are those of its keys.

Each entry names one target. -/
private theorem dueAt_sum (X : BeaconState preset fork) (electra : .pectra ≤ fork) (high : ℕ)
    (T : Finset ValidatorIndex) : ∑ v ∈ T, dueAt X high {v} = dueAt X high T := by
  classical
  induction T using Finset.induction_on with
  | empty =>
    rw [dueAt_eq X electra high]
    simp [dueList]
  | insert a s ha ih =>
    rw [Finset.sum_insert ha, ih, dueAt_eq X electra high, dueAt_eq X electra high,
      dueAt_eq X electra high, show insert a s = {a} ∪ s from rfl,
      dueList_length_union X electra high (Finset.disjoint_singleton_left.mpr ha)]

/-- The band of a key is its upward band for each due entry that names it, and these add over keys.

The due entries of a set of targets are the due entries of its keys. -/
private theorem bandX_sum (X : BeaconState preset fork) (electra : .pectra ≤ fork) (high : ℕ)
    (T : Finset ValidatorIndex) :
    ∑ v ∈ T, bandX X high v.toNat = preset.upwardBand * dueAt X high T := by
  classical
  have single (v : ValidatorIndex) :
      bandX X high v.toNat = preset.upwardBand * dueAt X high {v} := by
    simp [bandX]
  simp only [single]
  rw [← Finset.mul_sum, dueAt_sum X electra high T]

/-- The classes `K4`, `K5` and `K6` share no key with each other or with `V`. -/
private theorem classes_disjoint (h : Setting config checks g split fin pulled anc counted V) :
    Disjoint (K4 pulled counted V) (K5 counted V) ∧
    Disjoint (K4 pulled counted V) (K6 pulled counted) ∧
    Disjoint (K5 counted V) (K6 pulled counted) ∧
    Disjoint V (K4 pulled counted V) ∧ Disjoint V (K5 counted V) ∧
    Disjoint V (K6 pulled counted) := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;> refine Finset.disjoint_left.mpr fun v a b => ?_
  · simp only [K4, K5, Finset.mem_filter] at a b
    exact b.2.1 a.1
  · simp only [K4, K6, Finset.mem_filter] at a b
    exact b.2.2 a.2.1
  · simp only [K5, K6, Finset.mem_filter] at a b
    exact a.2.1 b.1
  · simp only [K4, Finset.mem_filter] at b
    exact b.2.2.2 a
  · simp only [K5, Finset.mem_filter] at b
    exact b.2.2 a
  · simp only [K6, Finset.mem_filter] at b
    exact b.2.2 (h.voting v a).1

/-- A key of `K4`, `K5` or `K6` is in C's quorum. -/
private theorem classes_mem_Q {v : ValidatorIndex}
    (member : v ∈ K4 pulled counted V ∪ K5 counted V ∪ K6 pulled counted) : v ∈ Q counted := by
  simp only [Finset.mem_union] at member
  rcases member with (h4 | h5) | h6
  · simp only [K4, Finset.mem_filter] at h4
    exact h4.2.2.1
  · simp only [K5, Finset.mem_filter] at h5
    exact h5.1
  · simp only [K6, Finset.mem_filter] at h6
    exact h6.2.1

/-- A key of `K4`, `K5` or `K6` is in C's quorum, so it is unslashed at C. -/
private theorem classes_unslashed {v : ValidatorIndex}
    (member : v ∈ K4 pulled counted V ∪ K5 counted V ∪ K6 pulled counted) :
    slashedFlagAt counted v.toNat ≠ some true := by
  have inQ := classes_mem_Q member
  intro slashed
  simp only [Q, quorumVoters, Finset.mem_filter] at inQ
  have unslashed := inQ.2
  unfold slashedFlagAt at slashed
  rw [slashed] at unslashed
  simp at unslashed

/-- The keys slashed at C and not at the split are in no class of C's quorum, and not in `V`. -/
private theorem sc_disjoint (h : Setting config checks g split fin pulled anc counted V) :
    Disjoint (K4 pulled counted V ∪ K5 counted V ∪ K6 pulled counted) (SC pulled counted split) ∧
    Disjoint V (SC pulled counted split) := by
  refine ⟨?_, ?_⟩
  · rw [Finset.disjoint_left]
    intro v hk hs
    simp only [SC, Finset.mem_filter] at hs
    exact classes_unslashed hk hs.2.1
  · rw [Finset.disjoint_left]
    intro v hv hs
    simp only [SC, Finset.mem_filter] at hs
    have unslashed := (h.voting v hv).2
    rw [hs.2.1] at unslashed
    simp at unslashed

/-- The keys created after the split's registry and slashed at C are in no other class.

They are slashed at C, so they are not in C's quorum or in `V`.

They are absent at the split, so they are not in `SC`. -/
private theorem cs_disjoint (h : Setting config checks g split fin pulled anc counted V) :
    Disjoint (K4 pulled counted V ∪ K5 counted V ∪ K6 pulled counted ∪ SC pulled counted split)
      (CS counted split) ∧ Disjoint V (CS counted split) := by
  refine ⟨?_, ?_⟩
  · rw [Finset.disjoint_left]
    intro v hk hc
    simp only [CS, Finset.mem_filter] at hc
    rcases Finset.mem_union.mp hk with quorum | created
    · exact classes_unslashed quorum hc.2.2
    · simp only [SC, Finset.mem_filter] at created
      have absent : slashedFlagAt split v.toNat = none := by
        simp only [slashedFlagAt, Option.map_eq_none_iff]
        exact Array.getElem?_eq_none hc.2.1
      rw [absent] at created
      cases created.2.2
  · rw [Finset.disjoint_left]
    intro v hv hc
    simp only [CS, Finset.mem_filter] at hc
    have unslashed := (h.voting v hv).2
    rw [hc.2.2] at unslashed
    simp at unslashed

/-- A key that a run credits.

A block step credits it, or a pending-deposit pass does. -/
private def creditedKey {x y : ForkedBeaconState preset} (tail : Run config checks x y)
    (high : ℕ) (v : ValidatorIndex) : Bool :=
  decide (0 < grossScan v.toNat high tail +
    (creditScan (fun _ => false) (fun s => decide (s = .deposits)) v.toNat high tail))

/-- `creditUnits` is `unitGain` for the credited-key slots and for two more of each exiting key.

The same holds for each queue key.

The slots are at least the proposers, the seats and the deposit recipients of the window.

They also hold the seat units of R's branch and the shared segment. -/
private theorem creditUnits_eq (config : Config) (pulled anc fin : BeaconState preset fork) :
    ∃ N : ℕ, (pinTerms config pulled anc fin).creditUnits =
        (N + 2 * (((pinTerms config pulled anc fin).positions.filter fun i =>
          (pinTerms config pulled anc fin).exitingB i = true).card +
            (pinTerms config pulled anc fin).queueKeys)) *
          (pinTerms config pulled anc fin).unitGain ∧
      (pinTerms config pulled anc fin).depth * preset.SLOTS_PER_EPOCH.toNat +
        ((pinTerms config pulled anc fin).depth /
          max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat + 2) *
            preset.SYNC_COMMITTEE_SIZE.toNat +
        (pinTerms config pulled anc fin).depth *
          preset.MAX_PENDING_DEPOSITS_PER_EPOCH.toNat +
        ((pinTerms config pulled anc fin).depth /
          max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat +
            ((pinTerms config pulled anc fin).depthFin /
              max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat + 2)) *
          preset.SYNC_COMMITTEE_SIZE.toNat ≤ N := by
  dsimp only [pinTerms]
  simp only [decide_eq_true_eq]
  exact ⟨_, rfl, by omega⟩

/-- The keys that a sync aggregate debits on the shared segment or R's branch fit the seat units.

The seat units are the seats of the committees of the periods that the two runs touch. -/
private theorem debit_keys_le (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (high : ℕ)
    {events eventsF : List (BalanceEvent preset)}
    (replayed : tail.balanceEvents high = .ok events)
    (replayedF : fromFin.balanceEvents high = .ok eventsF) (A B : Finset ValidatorIndex)
    (debitsF : ∀ v ∈ A, 0 < syncD eventsF v.toNat) (debitsR : ∀ v ∈ B, 0 < syncD events v.toNat) :
    (A ∪ B).card ≤ ((pinTerms config pulled anc fin).depth /
      max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat +
        ((pinTerms config pulled anc fin).depthFin /
          max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat + 2)) *
      preset.SYNC_COMMITTEE_SIZE.toNat := by
  classical
  obtain ⟨eventsC, replayedC⟩ := tailC.balanceEvents_ok h.early high
  have inj : Function.Injective fun v : ValidatorIndex => v.toNat := fun a b same =>
    UInt64.toNat_inj.mp same
  have union := seat_union_card h fromFin tail tailC high high replayed replayedF replayedC
    (Nat.le_trans (by decide) h.fulu) (A.image fun v => v.toNat) (B.image fun v => v.toNat)
    (fun i hi => by
      obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp hi
      have := debitsF v hv
      simp only [syncD, List.map_append, List.sum_append] at this ⊢
      omega)
    (fun i hi => by
      obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp hi
      exact debitsR v hv)
  rw [← Finset.image_union, Finset.card_image_of_injective _ inj] at union
  have finEpoch : (getCurrentEpoch fin).toNat ≤ (getCurrentEpoch split).toNat :=
    UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps fromFin.chainSteps)
  have splitPulled : (getCurrentEpoch split).toNat ≤ (getCurrentEpoch pulled).toNat :=
    UInt64.le_iff_toNat_le.mp h.called
  have periods := Nat.add_div_le_div_add_div_add_one
    ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) (getCurrentEpoch fin).toNat
    (max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat)
  have shift : ((getCurrentEpoch pulled).toNat + 1) /
      max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat ≤ ((getCurrentEpoch pulled).toNat + 2) /
      max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat := Nat.div_le_div_right (by omega)
  rw [Nat.sub_add_cancel (by omega)] at periods
  have depthEq : (pinTerms config pulled anc fin).depth =
      (getCurrentEpoch pulled).toNat + 2 - anc.finalizedCheckpoint.epoch.toNat := rfl
  have depthFinEq : (pinTerms config pulled anc fin).depthFin =
      (getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat := rfl
  refine union.trans ?_
  have nonneg := Nat.zero_le (((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) /
    max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat)
  rw [depthEq, depthFinEq, Nat.mul_comm]
  exact Nat.mul_le_mul_right _ (by omega)

/-- The credited keys of a set fit the credited-key slots of the window.

The slots are the proposers, the seats and the deposit recipients of the window.

They are the keys of C's run, which `credited_keys_le` counts by the slots of its epochs. -/
private theorem credited_slots_le (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (T : Finset ValidatorIndex) (inside : ∀ v ∈ T, v.toNat < counted.validators.data.size) :
    (T.filter fun v => creditedKey tailC highC v = true).card ≤
      (pinTerms config pulled anc fin).depth * preset.SLOTS_PER_EPOCH.toNat +
        ((pinTerms config pulled anc fin).depth /
          max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat + 2) *
            preset.SYNC_COMMITTEE_SIZE.toNat +
        (pinTerms config pulled anc fin).depth * preset.MAX_PENDING_DEPOSITS_PER_EPOCH.toNat := by
  classical
  have fit : (T.filter fun v => creditedKey tailC highC v = true).card ≤
      ((Finset.range counted.validators.data.size).filter fun i =>
        0 < grossScan i highC tailC +
          (creditScan (fun _ => false) (fun s => decide (s = .deposits)) i highC
            tailC)).card := by
    refine Finset.card_le_card_of_injOn (fun v : ValidatorIndex => v.toNat) (fun v hv => ?_)
      (fun a _ b _ same => UInt64.toNat_inj.mp same)
    obtain ⟨member, flag⟩ := Finset.mem_filter.mp hv
    exact Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (inside v member), of_decide_eq_true flag⟩
  have credited := credited_keys_le h tailC highC
  have depthEq : (pinTerms config pulled anc fin).depth =
      (getCurrentEpoch pulled).toNat + 2 - anc.finalizedCheckpoint.epoch.toNat := rfl
  -- The slots of the run's epochs are at most those of the window.
  have near := h.near
  have finalized := UInt64.le_iff_toNat_le.mp h.finalized
  have monotone := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps tailC.chainSteps)
  simp only at monotone
  have wide : (getCurrentEpoch counted).toNat - (getCurrentEpoch split).toNat + 1 ≤
      (getCurrentEpoch pulled).toNat + 2 - anc.finalizedCheckpoint.epoch.toNat := by omega
  have periods := Nat.add_div_le_div_add_div_add_one
    ((getCurrentEpoch counted).toNat - (getCurrentEpoch split).toNat)
    (getCurrentEpoch split).toNat (max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat)
  rw [Nat.sub_add_cancel monotone] at periods
  have periodsLe := Nat.div_le_div_right
    (c := max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat)
    (show (getCurrentEpoch counted).toNat - (getCurrentEpoch split).toNat ≤
      (getCurrentEpoch pulled).toNat + 2 - anc.finalizedCheckpoint.epoch.toNat by omega)
  have monotoneLe := Nat.div_le_div_right
    (c := max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat) monotone
  have first := Nat.mul_le_mul_right
    (preset.SLOTS_PER_EPOCH.toNat + preset.MAX_PENDING_DEPOSITS_PER_EPOCH.toNat) wide
  have second := Nat.mul_le_mul_left preset.SYNC_COMMITTEE_SIZE.toNat
    (show (getCurrentEpoch counted).toNat / max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat -
        (getCurrentEpoch split).toNat / max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat + 1 ≤
      ((getCurrentEpoch pulled).toNat + 2 - anc.finalizedCheckpoint.epoch.toNat) /
        max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat + 2 by omega)
  have bound : ((getCurrentEpoch counted).toNat - (getCurrentEpoch split).toNat + 1) *
      (preset.SLOTS_PER_EPOCH.toNat + preset.MAX_PENDING_DEPOSITS_PER_EPOCH.toNat) +
        preset.SYNC_COMMITTEE_SIZE.toNat *
          ((getCurrentEpoch counted).toNat / max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat -
            (getCurrentEpoch split).toNat / max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat +
              1) ≤
      ((getCurrentEpoch pulled).toNat + 2 - anc.finalizedCheckpoint.epoch.toNat) *
          preset.SLOTS_PER_EPOCH.toNat +
        (((getCurrentEpoch pulled).toNat + 2 - anc.finalizedCheckpoint.epoch.toNat) /
          max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat + 2) *
            preset.SYNC_COMMITTEE_SIZE.toNat +
        ((getCurrentEpoch pulled).toNat + 2 - anc.finalizedCheckpoint.epoch.toNat) *
          preset.MAX_PENDING_DEPOSITS_PER_EPOCH.toNat :=
    (Nat.add_le_add first second).trans_eq (by ring)
  rw [depthEq]
  omega

/-- The credited keys of `K4`, `K5`, `K6`, `SC` and `CS` fit the credited-key slots of the window.

The slots are the proposers, the seats and the deposit recipients of the window.

A credited key of `CS` is a credited key of C's run, in C's registry, as the others are. -/
private theorem credited_classes_le (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ) :
    ((K4 pulled counted V).filter fun v => creditedKey tailC highC v = true).card +
      ((K5 counted V).filter fun v => creditedKey tailC highC v = true).card +
      ((K6 pulled counted).filter fun v => creditedKey tailC highC v = true).card +
      ((SC pulled counted split).filter fun v => creditedKey tailC highC v = true).card +
      ((CS counted split).filter fun v => creditedKey tailC highC v = true).card ≤
    (pinTerms config pulled anc fin).depth * preset.SLOTS_PER_EPOCH.toNat +
      ((pinTerms config pulled anc fin).depth /
        max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat + 2) *
          preset.SYNC_COMMITTEE_SIZE.toNat +
      (pinTerms config pulled anc fin).depth * preset.MAX_PENDING_DEPOSITS_PER_EPOCH.toNat := by
  classical
  obtain ⟨d45, d46, d56, -, -, -⟩ := classes_disjoint h
  obtain ⟨dSC, -⟩ := sc_disjoint h
  obtain ⟨dCS, -⟩ := cs_disjoint h
  set C4 := (K4 pulled counted V).filter fun v => creditedKey tailC highC v = true
  set C5 := (K5 counted V).filter fun v => creditedKey tailC highC v = true
  set C6 := (K6 pulled counted).filter fun v => creditedKey tailC highC v = true
  set Csc := (SC pulled counted split).filter fun v => creditedKey tailC highC v = true
  set Ccs := (CS counted split).filter fun v => creditedKey tailC highC v = true
  -- The five classes are apart, and each key of them is in C's registry.
  have apart : Disjoint (C4 ∪ C6) C5 :=
    Finset.disjoint_union_left.mpr ⟨Finset.disjoint_filter_filter d45,
      (Finset.disjoint_filter_filter d56).symm⟩
  have apartSC : Disjoint (C4 ∪ C6 ∪ C5) Csc :=
    Finset.disjoint_of_subset_left (u := K4 pulled counted V ∪ K5 counted V ∪ K6 pulled counted)
      (fun v hv => by
        simp only [C4, C5, C6, Finset.mem_union, Finset.mem_filter] at hv
        simp only [Finset.mem_union]
        tauto)
      (Finset.disjoint_of_subset_right (Finset.filter_subset _ _) dSC)
  have apartCS : Disjoint (C4 ∪ C6 ∪ C5 ∪ Csc) Ccs :=
    Finset.disjoint_of_subset_left (u := K4 pulled counted V ∪ K5 counted V ∪ K6 pulled counted ∪
      SC pulled counted split)
      (fun v hv => by
        simp only [C4, C5, C6, Csc, Finset.mem_union, Finset.mem_filter] at hv
        simp only [Finset.mem_union]
        tauto)
      (Finset.disjoint_of_subset_right (Finset.filter_subset _ _) dCS)
  have card5 : (C4 ∪ C6 ∪ C5 ∪ Csc ∪ Ccs).card =
      C4.card + C6.card + C5.card + Csc.card + Ccs.card := by
    rw [Finset.card_union_of_disjoint apartCS, Finset.card_union_of_disjoint apartSC,
      Finset.card_union_of_disjoint apart,
      Finset.card_union_of_disjoint (Finset.disjoint_filter_filter d46)]
  have inCounted : ∀ v ∈ K4 pulled counted V ∪ K6 pulled counted ∪ K5 counted V,
      v.toNat < counted.validators.data.size := by
    intro v hv
    simp only [Finset.mem_union] at hv
    rcases hv with (h4 | h6) | h5
    · obtain ⟨w, found, -⟩ := active_of_activeVoters h.early (Finset.mem_filter.mp h4).1
      exact (Array.getElem?_eq_some_iff.mp found).1
    · obtain ⟨w, found, -⟩ := active_of_activeVoters h.early (Finset.mem_filter.mp h6).1
      exact (Array.getElem?_eq_some_iff.mp found).1
    · have listed := (Finset.mem_filter.mp h5).1
      simp only [Q, quorumVoters, Finset.mem_filter, List.mem_toFinset, List.mem_append] at listed
      rcases listed.1 with now | before
      · exact lt_size_of_mem_getActiveValidatorIndices now
      · exact lt_size_of_mem_getActiveValidatorIndices before
  have flagIn : ∀ v : ValidatorIndex, slashedFlagAt counted v.toNat = some true →
      v.toNat < counted.validators.data.size := by
    intro v flag
    simp only [slashedFlagAt, Option.map_eq_some_iff] at flag
    obtain ⟨w, found, -⟩ := flag
    exact (Array.getElem?_eq_some_iff.mp found).1
  have inSC : ∀ v ∈ SC pulled counted split, v.toNat < counted.validators.data.size :=
    fun v hv => flagIn v (Finset.mem_filter.mp hv).2.1
  have inCS : ∀ v ∈ CS counted split, v.toNat < counted.validators.data.size :=
    fun v hv => flagIn v (Finset.mem_filter.mp hv).2.2
  have flags : ∀ v ∈ C4 ∪ C6 ∪ C5 ∪ Csc ∪ Ccs, creditedKey tailC highC v = true := by
    intro v member
    simp only [C4, C5, C6, Csc, Ccs, Finset.mem_union, Finset.mem_filter] at member
    tauto
  have inside : ∀ v ∈ C4 ∪ C6 ∪ C5 ∪ Csc ∪ Ccs, v.toNat < counted.validators.data.size := by
    intro v member
    have classed : v ∈ K4 pulled counted V ∪ K6 pulled counted ∪ K5 counted V ∨
        v ∈ SC pulled counted split ∨ v ∈ CS counted split := by
      simp only [C4, C5, C6, Csc, Ccs, Finset.mem_union, Finset.mem_filter] at member ⊢
      tauto
    rcases classed with held | held | held
    · exact inCounted v held
    · exact inSC v held
    · exact inCS v held
  have slots := credited_slots_le h tailC highC _ inside
  rw [Finset.filter_true_of_mem flags, card5] at slots
  omega

/-- The rounding slacks of a set of keys are the upward band for each credited key. -/
private theorem band_sum {x y : ForkedBeaconState preset} (tail : Run config checks x y)
    (high : ℕ) (S : Finset ValidatorIndex) :
    ∑ v ∈ S, bandC tail high v.toNat =
      preset.upwardBand * (S.filter fun v => creditedKey tail high v = true).card := by
  rw [Finset.card_filter, Finset.mul_sum]
  refine Finset.sum_congr rfl fun v _ => ?_
  unfold bandC creditedKey
  by_cases credited : 0 < grossScan v.toNat high tail +
    (creditScan (fun _ => false) (fun s => decide (s = .deposits)) v.toNat high tail) <;>
    simp [credited]

/-- The credits that a scan reads for a key are at most the credits of its source's events.

The sources of the scan, block and slot, are those that `p` selects. -/
private theorem scan_le_events (blockP slotP : BalanceSource → Bool) (p : BalanceSource → Prop)
    [DecidablePred p] (selects : ∀ s, (blockP s = true ∨ slotP s = true) ↔ p s)
    {x y : ForkedBeaconState preset} (tail : Run config checks x y) (high : ℕ)
    (v : ValidatorIndex) {events : List (BalanceEvent preset)}
    (replayed : tail.balanceEvents high = .ok events) :
    (creditScan blockP slotP v.toNat high tail) ≤
      ((events.filter fun e => p e.source).map (keyCredit v.toNat)).sum := by
  have scan := creditScan_sum_le {v} UInt64.toNat blockP slotP high (keyCredit v.toNat) tail
    replayed fun e _ _ => by simp
  simp only [Finset.sum_singleton] at scan
  refine scan.trans (le_of_eq ?_)
  simp only [selects]
  rw [List.sum_map_ite (fun e : BalanceEvent preset => p e.source) (keyCredit v.toNat)
    (fun _ => 0)]
  simp

/-- The credits of a key on C's branch are its proposer credits and deposits, up to consolidations.

The consolidations are those of the replayed events. -/
private theorem credit_parts_le {x y : ForkedBeaconState preset} (tail : Run config checks x y)
    (high : ℕ) (v : ValidatorIndex) {events : List (BalanceEvent preset)}
    (replayed : tail.balanceEvents high = .ok events) :
    credC tail high v.toNat ≤ credN tail high v.toNat + consAmt events v.toNat ∧
    propC tail high v.toNat ≤ propN tail high v.toNat + consAmt events v.toNat := by
  have cons := scan_le_events (fun s => decide (s = .consolidations))
    (fun s => decide (s = .consolidations)) (· = .consolidations) (by intro s; simp) tail high v
    replayed
  have c := credC_split tail high v.toNat
  have p := propC_split tail high v.toNat
  exact ⟨by unfold consAmt; omega, by unfold consAmt; omega⟩

/-- K5 (`exitingCredits` with `credits`): C's proposer credits to K5 keys, weight 3.

`bud_consolidations` charges the consolidation amounts, so they are added to the bound.

The `syncProposer` part of the bound is not here: `bud_sync` uses it.

The bound is scaled by ten, to take the eleven tenths and the rounding of `exitingCredits`.

The compounding of the credits, an exact tenth of the keys' total, is in the bound.

The two further bands of each credited K5 key are in `bud_exitingBands`.

The run `pre` starts at the split's epoch, so its credits are proposer credits only.

Consolidations and deposits credit at epoch processing, so none falls inside `pre`. -/
private theorem bud_exitingCredits (h : Setting config checks g split fin pulled anc counted V)
    {b : BeaconState preset fork} (toB : Run config checks g ⟨fork, b⟩)
    (link : Nonempty (Run config checks ⟨fork, fin⟩ ⟨fork, b⟩) ∨
      ∃ _ : Run config checks ⟨fork, b⟩ ⟨fork, fin⟩, getCurrentEpoch fin = getCurrentEpoch b)
    (pre : Run config checks ⟨fork, b⟩ ⟨fork, split⟩)
    (sameEpoch : getCurrentEpoch split = getCurrentEpoch b)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC) :
    10 * (2 * ((∑ v ∈ (K5 counted V), propN pre highC v.toNat) +
        ∑ v ∈ (K5 counted V), propC tailC highC v.toNat)) +
      2 * ((∑ v ∈ (K5 counted V), propN pre highC v.toNat) +
        ∑ v ∈ (K5 counted V), propN tailC highC v.toNat) +
        22 * ((pinTerms config pulled anc fin).depth *
          (pinTerms config pulled anc fin).syncProposer) ≤
      10 * (pinTerms config pulled anc fin).exitingCredits +
        20 * (∑ v ∈ (K5 counted V), consAmt eventsC v.toNat) := by
  -- The proposer credits fit the pin's per-epoch bound, and their consolidation part is `consAmt`.
  have rewards := proposer_rewards_le h toB link pre sameEpoch tailC highC (K5 counted V)
  simp only [propN_append, Finset.sum_add_distrib] at rewards
  have parts : ∑ v ∈ (K5 counted V), propC tailC highC v.toNat ≤
      ∑ v ∈ (K5 counted V), propN tailC highC v.toNat +
        ∑ v ∈ (K5 counted V), consAmt eventsC v.toNat := by
    rw [← Finset.sum_add_distrib]
    exact Finset.sum_le_sum fun v _ => (credit_parts_le tailC highC v replayedC).2
  have exiting : (pinTerms config pulled anc fin).exitingCredits =
      (22 * ((pinTerms config pulled anc fin).depth *
        (pinTerms config pulled anc fin).proposerCredit) + 9) / 10 := rfl
  rw [exiting]
  omega

/-- `credits` holds the proposer credit, the deposit queue and the credited-key slots.

`queueDep` is the same queue, three times. -/
private theorem credits_budget (config : Config) (pulled anc fin : BeaconState preset fork) :
    ∃ carry churn wb ck : ℕ, (pinTerms config pulled anc fin).queueDep = 3 * (churn + carry) ∧
      (pinTerms config pulled anc fin).credits =
        (11 * ((pinTerms config pulled anc fin).depth *
          (pinTerms config pulled anc fin).proposerCredit + carry + churn + wb) + 9) / 10 +
          ck * preset.upwardBand ∧
      (pinTerms config pulled anc fin).depth * preset.SLOTS_PER_EPOCH.toNat +
        ((pinTerms config pulled anc fin).depth /
          max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat + 2) *
            preset.SYNC_COMMITTEE_SIZE.toNat +
        (pinTerms config pulled anc fin).depth * preset.MAX_PENDING_DEPOSITS_PER_EPOCH.toNat ≤
        ck := by
  dsimp only [pinTerms]
  exact ⟨_, _, _, _, rfl, rfl, Nat.le_add_right _ _⟩

/-- The deposits of the classes fit the deposit queue at weight three.

The keys slashed at C, `SC` and `CS`, count the deposits of events that do not hold them slashed.

The classes of C's quorum are apart from them. -/
private theorem deposits_union_le (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC) :
    3 * ((∑ v ∈ K4 pulled counted V ∪ K6 pulled counted,
        (creditScan (fun _ => false) (fun s => decide (s = .deposits)) v.toNat highC tailC)) +
      (∑ v ∈ SC pulled counted split ∪ CS counted split, depPre eventsC v.toNat)) ≤
      (pinTerms config pulled anc fin).queueDep := by
  have quorum : K4 pulled counted V ∪ K6 pulled counted ⊆
      K4 pulled counted V ∪ K5 counted V ∪ K6 pulled counted := fun v member => by
    simp only [Finset.mem_union] at member ⊢
    tauto
  refine deposits_active_le h tailC highC endEpochC replayedC _ _ ?_ (fun v member => ?_)
    fun v member => ?_
  · rw [Finset.disjoint_union_right]
    exact ⟨Finset.disjoint_of_subset_left quorum (sc_disjoint h).1,
      Finset.disjoint_of_subset_left (fun v m => Finset.mem_union_left _ (quorum m))
        (cs_disjoint h).1⟩
  · have countedActive : v ∈ AC counted := by
      rcases Finset.mem_union.mp member with m | m
      · exact (Finset.mem_filter.mp m).1
      · exact (Finset.mem_filter.mp m).1
    obtain ⟨w, found, active⟩ := active_of_activeVoters h.early countedActive
    simp only [isActiveValidator, Bool.and_eq_true, decide_eq_true_eq] at active
    exact ⟨w, found, active.2⟩
  · have flag : slashedFlagAt counted v.toNat = some true := by
      rcases Finset.mem_union.mp member with m | m
      · exact (Finset.mem_filter.mp m).2.1
      · exact (Finset.mem_filter.mp m).2.2
    simpa [slashedFlagAt, Option.map_eq_some_iff] using flag

/-- The credits bound, from the proposer rewards, the deposits and the credited keys of its classes.

The consolidation amounts are charged by `bud_consolidations`, and the sync part by `bud_sync`.

The deposits of a key slashed at C count only those before its slashing, in its share.

`rewards` is the proposer credits of the five classes and the sync part against `proposerCredit`.

`deposits` is the deposits of the classes against the deposit queue, at weight three.

`cards` is the credited keys of the classes against the credited-key slots. -/
private theorem bud_credits_of (h : Setting config checks g split fin pulled anc counted V)
    {b : BeaconState preset fork} (pre : Run config checks ⟨fork, b⟩ ⟨fork, split⟩)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    (rewards : (∑ v ∈ K4 pulled counted V, propN tailC highC v.toNat) +
      (∑ v ∈ K5 counted V, propN pre highC v.toNat) +
      (∑ v ∈ K5 counted V, propN tailC highC v.toNat) +
      (∑ v ∈ K6 pulled counted, propN tailC highC v.toNat) +
      (∑ v ∈ SC pulled counted split, propN pre highC v.toNat) +
      (∑ v ∈ SC pulled counted split, propN tailC highC v.toNat) +
      (∑ v ∈ CS counted split, propN tailC highC v.toNat) +
      (pinTerms config pulled anc fin).depth * (pinTerms config pulled anc fin).syncProposer ≤
      (pinTerms config pulled anc fin).depth * (pinTerms config pulled anc fin).proposerCredit)
    (deposits : 3 * ((∑ v ∈ K4 pulled counted V ∪ K6 pulled counted,
        (creditScan (fun _ => false) (fun s => decide (s = .deposits)) v.toNat highC tailC)) +
      (∑ v ∈ SC pulled counted split ∪ CS counted split, depPre eventsC v.toNat)) ≤
      (pinTerms config pulled anc fin).queueDep)
    (cards : ((K4 pulled counted V).filter fun v => creditedKey tailC highC v = true).card +
      ((K5 counted V).filter fun v => creditedKey tailC highC v = true).card +
      ((K6 pulled counted).filter fun v => creditedKey tailC highC v = true).card +
      ((SC pulled counted split).filter fun v => creditedKey tailC highC v = true).card +
      ((CS counted split).filter fun v => creditedKey tailC highC v = true).card ≤
      (pinTerms config pulled anc fin).depth * preset.SLOTS_PER_EPOCH.toNat +
        ((pinTerms config pulled anc fin).depth /
          max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat + 2) *
            preset.SYNC_COMMITTEE_SIZE.toNat +
        (pinTerms config pulled anc fin).depth * preset.MAX_PENDING_DEPOSITS_PER_EPOCH.toNat) :
    10 * ((∑ v ∈ (K4 pulled counted V), credC tailC highC v.toNat) +
      (∑ v ∈ (K6 pulled counted), credC tailC highC v.toNat) +
      (∑ v ∈ (K5 counted V), propN pre highC v.toNat) +
      (∑ v ∈ (K5 counted V), propC tailC highC v.toNat) +
      (∑ v ∈ (K4 pulled counted V), bandC tailC highC v.toNat) +
      (∑ v ∈ (K5 counted V), bandC tailC highC v.toNat) +
      (∑ v ∈ (K6 pulled counted), bandC tailC highC v.toNat) +
      wShare preset fork ((∑ v ∈ SC pulled counted split, propN tailC highC v.toNat) +
        ∑ v ∈ SC pulled counted split, depPre eventsC v.toNat) +
      wShare preset fork (∑ v ∈ SC pulled counted split, propN pre highC v.toNat) +
      (∑ v ∈ SC pulled counted split, bandC tailC highC v.toNat) +
      wShare preset fork ((∑ v ∈ CS counted split, propN tailC highC v.toNat) +
        ∑ v ∈ CS counted split, depPre eventsC v.toNat) +
      (∑ v ∈ CS counted split, bandC tailC highC v.toNat)) +
      ((∑ v ∈ (K4 pulled counted V), credN tailC highC v.toNat) +
        (∑ v ∈ (K6 pulled counted), credN tailC highC v.toNat) +
        (∑ v ∈ (K5 counted V), propN pre highC v.toNat) +
        (∑ v ∈ (K5 counted V), propN tailC highC v.toNat)) +
        11 * ((pinTerms config pulled anc fin).depth *
          (pinTerms config pulled anc fin).syncProposer) ≤
      10 * (pinTerms config pulled anc fin).credits +
        10 * ((∑ v ∈ (K4 pulled counted V), consAmt eventsC v.toNat) +
          (∑ v ∈ (K6 pulled counted), consAmt eventsC v.toNat) +
          (∑ v ∈ (K5 counted V), consAmt eventsC v.toNat)) := by
  classical
  obtain ⟨carry, churn, wb, ck, queue, credits, slots⟩ := credits_budget config pulled anc fin
  obtain ⟨-, d46, -, -, -, -⟩ := classes_disjoint h
  have dSCCS : Disjoint (SC pulled counted split) (CS counted split) :=
    Finset.disjoint_of_subset_left Finset.subset_union_right (cs_disjoint h).1
  have parts (S : Finset ValidatorIndex) := fun v (_ : v ∈ S) => credit_parts_le tailC highC v
    replayedC
  have sumLe (S : Finset ValidatorIndex) (f g : ValidatorIndex → ℕ)
      (le : ∀ v ∈ S, f v ≤ g v) : ∑ v ∈ S, f v ≤ ∑ v ∈ S, g v := Finset.sum_le_sum le
  have c4 := sumLe (K4 pulled counted V) _ (fun v => credN tailC highC v.toNat +
    consAmt eventsC v.toNat) fun v m => (parts _ v m).1
  have c6 := sumLe (K6 pulled counted) _ (fun v => credN tailC highC v.toNat +
    consAmt eventsC v.toNat) fun v m => (parts _ v m).1
  have c5 := sumLe (K5 counted V) _ (fun v => propN tailC highC v.toNat +
    consAmt eventsC v.toNat) fun v m => (parts _ v m).2
  simp only [Finset.sum_add_distrib] at c4 c6 c5
  have e4 : ∑ v ∈ K4 pulled counted V, credN tailC highC v.toNat =
      (∑ v ∈ K4 pulled counted V, propN tailC highC v.toNat) + ∑ v ∈ K4 pulled counted V,
        (creditScan (fun _ => false) (fun s => decide (s = .deposits)) v.toNat highC tailC) := by
    rw [← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun v _ => credN_split tailC highC v.toNat
  have e6 : ∑ v ∈ K6 pulled counted, credN tailC highC v.toNat =
      (∑ v ∈ K6 pulled counted, propN tailC highC v.toNat) + ∑ v ∈ K6 pulled counted,
        (creditScan (fun _ => false) (fun s => decide (s = .deposits)) v.toNat highC tailC) := by
    rw [← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun v _ => credN_split tailC highC v.toNat
  rw [Finset.sum_union d46, Finset.sum_union dSCCS] at deposits
  have w1 := wShare_le (fork := fork) h.facts ((∑ v ∈ SC pulled counted split,
    propN tailC highC v.toNat) + ∑ v ∈ SC pulled counted split, depPre eventsC v.toNat)
  have w3 := wShare_le (fork := fork) h.facts (∑ v ∈ SC pulled counted split,
    propN pre highC v.toNat)
  have w2 := wShare_le (fork := fork) h.facts ((∑ v ∈ CS counted split,
    propN tailC highC v.toNat) + ∑ v ∈ CS counted split, depPre eventsC v.toNat)
  have bands : (∑ v ∈ K4 pulled counted V, bandC tailC highC v.toNat) +
      (∑ v ∈ K5 counted V, bandC tailC highC v.toNat) +
      (∑ v ∈ K6 pulled counted, bandC tailC highC v.toNat) +
      (∑ v ∈ SC pulled counted split, bandC tailC highC v.toNat) +
      (∑ v ∈ CS counted split, bandC tailC highC v.toNat) ≤ ck * preset.upwardBand := by
    simp only [band_sum, ← Nat.mul_add]
    rw [Nat.mul_comm]
    exact Nat.mul_le_mul_right _ (cards.trans slots)
  omega

/-- C's non-attestation credits to keys counted once.

The consolidation amounts are not here either: `bud_consolidations` charges them.

The `syncProposer` part of `credits` is not here: `bud_sync` uses it.

The bound is scaled by ten, to take the eleven tenths and the rounding of `credits`.

The compounding of the credits, an exact tenth of the keys' total, is in the bound.

The rounding slacks of the credited keys of `K4` and `K5` are paid by `creditedKeys`.

`K5` also reads the proposer credits of `pre`, the run to the split from the start of its epoch. -/
private theorem bud_credits (h : Setting config checks g split fin pulled anc counted V)
    {b : BeaconState preset fork} (toB : Run config checks g ⟨fork, b⟩)
    (link : Nonempty (Run config checks ⟨fork, fin⟩ ⟨fork, b⟩) ∨
      ∃ _ : Run config checks ⟨fork, b⟩ ⟨fork, fin⟩, getCurrentEpoch fin = getCurrentEpoch b)
    (pre : Run config checks ⟨fork, b⟩ ⟨fork, split⟩)
    (sameEpoch : getCurrentEpoch split = getCurrentEpoch b)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC) :
    10 * ((∑ v ∈ (K4 pulled counted V), credC tailC highC v.toNat) +
      (∑ v ∈ (K6 pulled counted), credC tailC highC v.toNat) +
      (∑ v ∈ (K5 counted V), propN pre highC v.toNat) +
      (∑ v ∈ (K5 counted V), propC tailC highC v.toNat) +
      (∑ v ∈ (K4 pulled counted V), bandC tailC highC v.toNat) +
      (∑ v ∈ (K5 counted V), bandC tailC highC v.toNat) +
      (∑ v ∈ (K6 pulled counted), bandC tailC highC v.toNat) +
      wShare preset fork ((∑ v ∈ SC pulled counted split, propN tailC highC v.toNat) +
        ∑ v ∈ SC pulled counted split, depPre eventsC v.toNat) +
      wShare preset fork (∑ v ∈ SC pulled counted split, propN pre highC v.toNat) +
      (∑ v ∈ SC pulled counted split, bandC tailC highC v.toNat) +
      wShare preset fork ((∑ v ∈ CS counted split, propN tailC highC v.toNat) +
        ∑ v ∈ CS counted split, depPre eventsC v.toNat) +
      (∑ v ∈ CS counted split, bandC tailC highC v.toNat)) +
      ((∑ v ∈ (K4 pulled counted V), credN tailC highC v.toNat) +
        (∑ v ∈ (K6 pulled counted), credN tailC highC v.toNat) +
        (∑ v ∈ (K5 counted V), propN pre highC v.toNat) +
        (∑ v ∈ (K5 counted V), propN tailC highC v.toNat)) +
        11 * ((pinTerms config pulled anc fin).depth *
          (pinTerms config pulled anc fin).syncProposer) ≤
      10 * (pinTerms config pulled anc fin).credits +
        10 * ((∑ v ∈ (K4 pulled counted V), consAmt eventsC v.toNat) +
          (∑ v ∈ (K6 pulled counted), consAmt eventsC v.toNat) +
          (∑ v ∈ (K5 counted V), consAmt eventsC v.toNat)) :=
  bud_credits_of h pre tailC highC replayedC
    (by
      obtain ⟨d45, d46, d56, -, -, -⟩ := classes_disjoint h
      have := proposer_rewards_le h toB link pre sameEpoch tailC highC
        (K4 pulled counted V ∪ K5 counted V ∪
        K6 pulled counted ∪ SC pulled counted split ∪ CS counted split)
      simp only [propN_append, Finset.sum_add_distrib] at this
      simp only [Finset.sum_union (cs_disjoint h).1, Finset.sum_union (sc_disjoint h).1,
        Finset.sum_union (Finset.disjoint_union_left.mpr ⟨d46, d56⟩),
        Finset.sum_union d45] at this
      omega)
    (deposits_union_le h tailC highC endEpochC replayedC) (credited_classes_le h tailC highC)

/-- The keys of `K5` are at most the keys that R reads as exiting and the queue keys.

A key of `K5` is read as exiting at R, or has a departure charge on C's run. -/
private theorem card_K5_le (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) :
    (K5 counted V).card ≤ ((pinTerms config pulled anc fin).positions.filter fun i =>
        (pinTerms config pulled anc fin).exitingB i = true).card +
      (pinTerms config pulled anc fin).queueKeys := by
  classical
  set A := (K5 counted V).filter fun v =>
    (pinTerms config pulled anc fin).exitingB v.toNat = true
  set B := (K5 counted V).filter fun v => ∃ c ∈ tailC.departureCharges, c.index = v.toNat
  have cover : K5 counted V ⊆ A ∪ B := by
    intro v inK5
    by_cases exiting : (pinTerms config pulled anc fin).exitingB v.toNat = true
    · exact Finset.mem_union_left _ (Finset.mem_filter.mpr ⟨inK5, exiting⟩)
    · have flag : (pinTerms config pulled anc fin).exitingB v.toNat = false := by
        simpa using exiting
      exact Finset.mem_union_right _ (Finset.mem_filter.mpr
        ⟨inK5, K5_charged h tailC inK5 flag⟩)
  have exitingLe := card_exitingB_le config pulled anc fin A fun v hv =>
    (Finset.mem_filter.mp hv).2
  have chargedLe := charged_count h tailC
  exact (Finset.card_le_card cover).trans ((Finset.card_union_le _ _).trans
    (Nat.add_le_add exitingLe chargedLe))

/-- The events of the sources of consolidations and deposits are at most those of each source. -/
private theorem sum_filter_cons_dep_le (events : List (BalanceEvent preset))
    (f : BalanceEvent preset → ℕ) :
    ((events.filter fun e => decide (e.source = .consolidations ∨ e.source = .deposits)).map
        f).sum ≤
      ((events.filter fun e => decide (e.source = .deposits)).map f).sum +
        ((events.filter fun e => decide (e.source = .consolidations)).map f).sum := by
  have same : (fun e : BalanceEvent preset =>
      decide (e.source = .consolidations ∨ e.source = .deposits)) =
        fun e => decide (e.source = .deposits) || decide (e.source = .consolidations) := by
    funext e
    cases e.source <;> decide
  rw [same]
  have apart : ∀ s : BalanceSource, ¬ (decide (s = .deposits) = true ∧
      decide (s = .consolidations) = true) := fun s h => by
    simp at h
    exact absurd (h.1.symm.trans h.2) (by decide)
  exact (sum_filter_or events (fun e => decide (e.source = .deposits))
    (fun e => decide (e.source = .consolidations)) (fun e => apart e.source) f).le

/-- A slot step raises the balance of a key that is idle in the previous epoch by its credits.

The credits are those of deposits and consolidations.

The epoch rewards of such a key are 0, and the slot has no sync events. -/
private theorem slot_idle_step {g m n : ForkedBeaconState preset}
    (shared : Run config checks g m) (genesis : Genesis config checks g)
    (ok : advanceSlotAcross config checks m = .ok n) (early : n.fork < .glamsterdam)
    (electra : .pectra ≤ m.fork) (v : ℕ)
    (known : v < m.state.validators.data.size ∨ BalancesMatch m.state)
    (idle : v.toUInt64 ∉ getActiveValidatorIndices m.state (getPreviousEpoch m.state)) :
    actualBalanceAt n v ≤ actualBalanceAt m v +
      stepCredit (fun _ => false) (fun s => decide (s = .deposits)) v
        (Step.slot ok : Step config checks m n) +
      stepCredit (fun _ => false) (fun s => decide (s = .consolidations)) v
        (Step.slot ok : Step config checks m n) := by
  have altair : .altair ≤ m.fork := Nat.le_trans (by decide) electra
  obtain ⟨events, replayed⟩ := (Step.slot ok : Step config checks m n).balanceEvents_ok early
  have base := PinKeyFloor.step_balance_le (Step.slot ok : Step config checks m n) early v
  have rewards := PinKeyFloor.epochRewards_le (Step.slot ok : Step config checks m n) altair early v
    known 0 0 (.inl idle) (.inl idle)
  have rewardsZero : PinKeyFloor.epochRewards v (Step.slot ok : Step config checks m n) = 0 := by
    simpa using rewards
  have sources := step_credit_le_sources shared genesis (Step.slot ok : Step config checks m n)
    early electra v replayed
  have noSync := PinSeatDebits.slot_noSync electra ok early replayed
  have syncZero : (events.map (syncCredit v)).sum = 0 :=
    List.sum_eq_zero fun x member => by
      obtain ⟨e, mem, rfl⟩ := List.mem_map.mp member
      simp [syncCredit, noSync e mem]
  have split := sum_filter_cons_dep_le events (keyCredit v)
  simp only [stepCredit, stepNet, replayed, Except.toOption, Option.getD_some,
    syncZero] at base sources ⊢
  simp only [List.filter_false, List.map_nil, List.sum_nil] at sources
  omega

/-- A block step gives no gross credit to a key that is not active and holds no seat.

A key that is not active at the epoch of the step is not its proposer.

A key whose activation is too late for a committee to sample it holds no seat. -/
private theorem block_idle_step {g : ForkedBeaconState preset}
    (genesis : Genesis config checks g)
    (apart : preset.MIN_SEED_LOOKAHEAD.toNat + 2 < preset.EPOCHS_PER_HISTORICAL_VECTOR.toNat)
    (covers : preset.MIN_SEED_LOOKAHEAD.toNat + 1 ≤ preset.MAX_SEED_LOOKAHEAD.toNat)
    {f : Fork} {s t : BeaconState preset f} {engine : ExecutionEngine preset f}
    {signed : SignedBeaconBlock preset f} {due : upgradeDue config ⟨f, s⟩ = false}
    {ok : applySignedBlock config checks engine s signed true = .ok t}
    (shared : Run config checks g ⟨f, s⟩) (fulu : .fusaka ≤ f) (early : f < .glamsterdam) (v : ℕ)
    (notActive : ∀ w, s.validators.data[v]? = some w →
      isActiveValidator w (getCurrentEpoch s) = false)
    (notSeated : ∀ w, t.validators.data[v]? = some w → w.activationEpoch = FAR_FUTURE_EPOCH ∨
      (getCurrentEpoch t).toNat + 1 < w.activationEpoch.toNat) :
    stepCredit (fun s => decide (s = .rewards ∨ s = .slashings ∨ s = .sync)) (fun _ => false) v
      (Step.block engine signed due ok) = 0 := by
  obtain ⟨K, -, proposer, keys⟩ := block_step_gross_keys genesis apart shared fulu early
    (engine := engine) (signed := signed) (due := due) (ok := ok)
  by_contra nonzero
  rcases keys v (Nat.pos_of_ne_zero nonzero) with member | ⟨altair, w, found, seat⟩
  · obtain ⟨p, read, same⟩ := proposer v member
    have active := (Run.lookaheadActive covers genesis shared early).proposer_active fulu read
    rw [same] at active
    obtain ⟨w, found, isActive⟩ := isActiveAt_eq_true_iff.mp active
    rw [notActive w found] at isActive
    exact Bool.false_ne_true isActive
  · have run := shared.snoc (Step.block engine signed due ok)
    obtain ⟨j, w', found', keyed, assigned, late⟩ :=
      (run.syncCommittee_activation_bounded genesis altair).1 w.pubkey seat
    obtain rfl := (run.pubkeysDistinct genesis).index_eq found found' keyed.symm
    obtain rfl := Option.some.inj (found.symm.trans found')
    rcases notSeated w found with far | later
    · exact assigned far
    · have bound : w.activationEpoch.toNat ≤ (getCurrentEpoch t).toNat + 1 := late
      omega

/-- A key that is idle along a prefix of C's run has a balance at most its credits there.

The key is two epochs from its activation at the end of the run.

It is absent at the start.

No block step gives it a gross credit, since it is neither a proposer nor on a seat.

A slot step credits it the credits of deposits and consolidations, since it is idle. -/
private theorem key_idle_walk (h : Setting config checks g split fin pulled anc counted V)
    {z : ForkedBeaconState preset} (v : ℕ) (small : v < 2 ^ 64) (highC : ℕ)
    (zEarly : z.fork < .glamsterdam)
    (zHigh : (getCurrentEpoch z.state).toNat ≤ highC + 1)
    (ahead : ∀ m : ForkedBeaconState preset, Run config checks m z → ∀ w : Validator,
      m.state.validators.data[v]? = some w → w.activationEpoch ≠ FAR_FUTURE_EPOCH →
        (getCurrentEpoch m.state).toNat + 1 < w.activationEpoch.toNat)
    (start : actualBalanceAt (⟨fork, split⟩ : ForkedBeaconState preset) v = 0) :
    ∀ {m : ForkedBeaconState preset} (pre : Run config checks ⟨fork, split⟩ m),
      Run config checks m z → grossScan v highC pre = 0 ∧ actualBalanceAt m v ≤
        (creditScan (fun _ => false) (fun s => decide (s = .deposits)) v highC pre) +
        (creditScan (fun _ => false) (fun s => decide (s = .consolidations)) v highC pre) := by
  obtain ⟨toFin⟩ := h.toFin
  obtain ⟨fromFin⟩ := h.fromFin
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  -- The key is not active at any epoch up to the current one, at a state of the rest of the run.
  have inactive : ∀ m : ForkedBeaconState preset, Run config checks m z → ∀ w : Validator,
      m.state.validators.data[v]? = some w → ∀ e : Epoch,
        e.toNat ≤ (getCurrentEpoch m.state).toNat → isActiveValidator w e = false := by
    intro m run w found e le
    by_contra active
    simp only [Bool.not_eq_false, isActiveValidator, Bool.and_eq_true, decide_eq_true_eq]
      at active
    have lowEpoch := UInt64.le_iff_toNat_le.mp active.1
    have highEpoch := UInt64.lt_iff_toNat_lt.mp active.2
    have exitBound := w.exitEpoch.toNat_lt
    by_cases assigned : w.activationEpoch = FAR_FUTURE_EPOCH
    · rw [assigned] at lowEpoch
      have far : FAR_FUTURE_EPOCH.toNat = 2 ^ 64 - 1 := rfl
      omega
    · have := ahead m run w found assigned
      omega
  intro m pre
  induction pre with
  | nil =>
    intro _
    rw [start]
    exact ⟨rfl, Nat.zero_le _⟩
  | @snoc middle last pre step ih =>
    intro post
    have shared : Run config checks g middle := (toFin.append fromFin).append pre
    have afterStep : Run config checks middle z := (Run.nil.snoc step).append post
    have middleZ := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps afterStep.chainSteps)
    have middleFork := fork_le_of_chainSteps afterStep.chainSteps
    have lastFork := fork_le_of_chainSteps post.chainSteps
    have selected : (getCurrentEpoch middle.state).toNat ≤ highC + 1 := by omega
    rw [grossScan_snoc, creditScan_snoc, creditScan_snoc]
    simp only [selected, ↓reduceIte]
    obtain ⟨noGross, before⟩ := ih afterStep
    have lastEarly : last.fork < .glamsterdam := Nat.lt_of_le_of_lt lastFork zEarly
    cases step with
    | block engine signed due ok =>
      have gross := block_balance_le_gross (engine := engine) (signed := signed) (due := due)
        (ok := ok) shared h.genesis lastEarly
        (Nat.le_trans electra (fork_le_of_chainSteps pre.chainSteps)) v
      have zero := block_idle_step (engine := engine) (signed := signed) (due := due) (ok := ok)
        h.genesis h.parameters.lookahead h.facts.covers shared
        (Nat.le_trans h.fulu (fork_le_of_chainSteps pre.chainSteps)) lastEarly v
        (fun w found => inactive _ afterStep w found _ (Nat.le_refl _))
        (fun w found => by
          by_cases assigned : w.activationEpoch = FAR_FUTURE_EPOCH
          · exact .inl assigned
          · exact .inr (ahead _ post w found assigned))
      exact ⟨by omega, by omega⟩
    | slot ok =>
      have middleElectra : .pectra ≤ middle.fork :=
        Nat.le_trans electra (fork_le_of_chainSteps pre.chainSteps)
      have middleEarly : middle.fork < .glamsterdam := Nat.lt_of_le_of_lt middleFork zEarly
      have known : v < middle.state.validators.data.size ∨ BalancesMatch middle.state := by
        by_cases inside : v < middle.state.validators.data.size
        · exact .inl inside
        · exact .inr (Run.invariant (Genesis.invariant h.genesis) shared).balancesMatch
      have idle : v.toUInt64 ∉ getActiveValidatorIndices middle.state
          (getPreviousEpoch middle.state) := by
        intro active
        obtain ⟨w, found, isActive⟩ :=
          (mem_getActiveValidatorIndices (middle.state.validators.bound middleEarly)).mp active
        rw [Nat.toUInt64_eq, UInt64.toNat_ofNat_of_lt' small] at found
        have previous := getPreviousEpoch_toNat middle.state
        rw [inactive middle afterStep w found _ (by omega)] at isActive
        exact Bool.false_ne_true isActive
      have noCredit : stepCredit (fun s => decide (s = .rewards ∨ s = .slashings ∨ s = .sync))
          (fun _ => false) v (Step.slot ok : Step config checks middle last) = 0 := by
        simp [stepCredit]
      have step := slot_idle_step shared h.genesis ok lastEarly middleElectra v known idle
      exact ⟨by omega, by omega⟩

/-- A validator active at an epoch up to the current one has its activation assigned and reached. -/
private theorem activated_of_active {s : BeaconState preset fork} {w : Validator} {e : Epoch}
    (active : isActiveValidator w e = true) (le : e ≤ getCurrentEpoch s) :
    w.activationEpoch ≠ FAR_FUTURE_EPOCH ∧ w.activationEpoch ≤ getCurrentEpoch s := by
  simp only [isActiveValidator, Bool.and_eq_true, decide_eq_true_eq] at active
  have low := UInt64.le_iff_toNat_le.mp active.1
  have high := UInt64.lt_iff_toNat_lt.mp active.2
  have bound := w.exitEpoch.toNat_lt
  have ahead := UInt64.le_iff_toNat_le.mp le
  refine ⟨fun far => ?_, UInt64.le_iff_toNat_le.mpr (by omega)⟩
  rw [far] at low
  have : FAR_FUTURE_EPOCH.toNat = 2 ^ 64 - 1 := rfl
  omega

/-- A voter that is active at a state has its activation assigned and reached. -/
private theorem activated_of_activeVoters (early : fork < .glamsterdam)
    {s : BeaconState preset fork} {v : ValidatorIndex} (member : v ∈ activeVoters s) :
    ∃ w, s.validators.data[v.toNat]? = some w ∧ w.activationEpoch ≠ FAR_FUTURE_EPOCH ∧
      w.activationEpoch ≤ getCurrentEpoch s := by
  obtain ⟨w, found, active⟩ := active_of_activeVoters early member
  exact ⟨w, found, activated_of_active active (UInt64.le_refl _)⟩

/-- A voter of the quorum has its activation assigned and reached.

The quorum holds the keys that are active at the current or the previous epoch. -/
private theorem activated_of_quorum (early : fork < .glamsterdam)
    {s : BeaconState preset fork} {v : ValidatorIndex} (member : v ∈ Q s) :
    ∃ w, s.validators.data[v.toNat]? = some w ∧ w.activationEpoch ≠ FAR_FUTURE_EPOCH ∧
      w.activationEpoch ≤ getCurrentEpoch s := by
  have listed := (Finset.mem_filter.mp (member : v ∈ quorumVoters s)).1
  rw [List.mem_toFinset, List.mem_append] at listed
  rcases listed with now | before
  · exact activated_of_activeVoters early (by simpa [activeVoters] using now)
  · obtain ⟨w, found, active⟩ :=
      (mem_getActiveValidatorIndices (s.validators.bound early)).mp before
    exact ⟨w, found, activated_of_active active (getPreviousEpoch_le s)⟩

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- A key that C activates has its activation before its exit. -/
private theorem activated_ordered (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) {v : ValidatorIndex}
    (activated : ∃ w, counted.validators.data[v.toNat]? = some w ∧
      w.activationEpoch ≠ FAR_FUTURE_EPOCH ∧ w.activationEpoch ≤ getCurrentEpoch counted) :
    ∀ vy, counted.validators.data[v.toNat]? = some vy →
      vy.activationEpoch.toNat < vy.exitEpoch.toNat := by
  obtain ⟨toFin⟩ := h.toFin
  obtain ⟨w, foundC, neFar, -⟩ := activated
  intro vy found
  obtain rfl := Option.some.inj (found.symm.trans foundC)
  have farToNat : FAR_FUTURE_EPOCH.toNat = 2 ^ 64 - 1 := rfl
  have bound := vy.activationEpoch.toNat_lt
  have notFar : vy.activationEpoch.toNat ≠ 2 ^ 64 - 1 := fun same =>
    neFar (UInt64.toNat_inj.mp (by rw [same]; rfl))
  by_cases exit : vy.exitEpoch = FAR_FUTURE_EPOCH
  · rw [exit]
    omega
  · have gap := (toFin.append (fromFin.append tailC)).exit_activation_gap h.genesis v.toNat vy
      found exit
    omega

/-- A key activated by C and absent at the split holds the activation reserve at a state of C's run.

The run from the split reaches that state first, and then C.

The key is activated by C, before it exits, and absent at the split.

At that state its balance is at least `MAX_EFFECTIVE_BALANCE`.

Its effective balance is within the downward band of its balance, and at least that.

The key is idle before that state, so its balance is at most the credits that the scans count. -/
private theorem created_start (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {v : ValidatorIndex} (activated : ∃ w, counted.validators.data[v.toNat]? = some w ∧
      w.activationEpoch ≠ FAR_FUTURE_EPOCH ∧ w.activationEpoch ≤ getCurrentEpoch counted)
    (absent : split.validators.data.size ≤ v.toNat) :
    ∃ (z : ForkedBeaconState preset) (pre : Run config checks ⟨fork, split⟩ z)
      (post : Run config checks z ⟨fork, counted⟩), tailC = pre.append post ∧
      z.fork < .glamsterdam ∧ z.fork ≤ fork ∧
      (getCurrentEpoch z.state).toNat ≤ (getCurrentEpoch counted).toNat ∧
      v.toNat < z.state.validators.data.size ∧
      preset.MAX_EFFECTIVE_BALANCE.toNat ≤ actualBalanceAt z v.toNat ∧
      effectiveAt z v.toNat ≤ actualBalanceAt z v.toNat + preset.downwardBand ∧
      preset.MAX_EFFECTIVE_BALANCE.toNat ≤ effectiveAt z v.toNat ∧
      actualBalanceAt z v.toNat ≤ grossScan v.toNat highC pre +
        (creditScan (fun _ => false) (fun s => decide (s = .deposits)) v.toNat highC pre) +
        (creditScan (fun _ => false) (fun s => decide (s = .consolidations)) v.toNat highC
          pre) ∧ grossScan v.toNat highC pre = 0 ∧
      ∀ p ∈ pre.balancePath, ∀ w : Validator, p.state.validators.data[v.toNat]? = some w →
        w.activationEpoch ≠ FAR_FUTURE_EPOCH →
        (getCurrentEpoch p.state).toNat + 1 < w.activationEpoch.toNat := by
  classical
  obtain ⟨toFin⟩ := h.toFin
  obtain ⟨fromFin⟩ := h.fromFin
  have shared : Run config checks g ⟨fork, split⟩ := toFin.append fromFin
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  -- The key is activated at C, before its exit, and absent at the split.
  obtain ⟨w, foundC, neFar, lowC⟩ := activated
  have ordered := activated_ordered h fromFin tailC ⟨w, foundC, neFar, lowC⟩
  have splitAbsent : split.validators.data[v.toNat]? = none :=
    Array.getElem?_eq_none absent
  have pending : ∀ u, (⟨fork, split⟩ : ForkedBeaconState preset).state.validators.data[v.toNat]? =
      some u → (getCurrentEpoch (⟨fork, split⟩ : ForkedBeaconState preset).state).toNat + 1 <
        u.activationEpoch.toNat := fun u found => by
    simp only [splitAbsent] at found
    cases found
  obtain ⟨z, pre, post, v0, vy, splitEq, found0, foundY, sameAct, actEq, actLe⟩ :=
    PinKeys.Run.start_state tailC h.window v.toNat pending ⟨w, foundC, neFar, lowC⟩ ordered
  obtain rfl := Option.some.inj (foundY.symm.trans foundC)
  have actNeFar : v0.activationEpoch ≠ FAR_FUTURE_EPOCH := fun same =>
    neFar (sameAct.symm.trans same)
  have zFork : z.fork ≤ fork := fork_le_of_chainSteps post.chainSteps
  have zEarly : z.fork < .glamsterdam := Nat.lt_of_le_of_lt zFork h.early
  have actZ : (getCurrentEpoch z.state).toNat + 2 = v0.activationEpoch.toNat := by
    rw [sameAct]
    exact actEq
  -- At that state the key holds the activation reserve, which is positive.
  obtain ⟨-, funded, hysteresis, reserve⟩ :=
    PinKeys.Run.funded_at_start shared h.genesis h.caps h.aligned electra pre zEarly v.toNat found0
      actNeFar actZ
  have zCounted : (getCurrentEpoch z.state).toNat ≤ (getCurrentEpoch counted).toNat :=
    UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps post.chainSteps)
  -- The key has no balance at the start, and no credit scan counts a step before that state.
  have startZero : actualBalanceAt (⟨fork, split⟩ : ForkedBeaconState preset) v.toNat = 0 := by
    have matched : split.balances.data.size = split.validators.data.size :=
      (Run.invariant (Genesis.invariant h.genesis) shared).balancesMatch
    simp only [actualBalanceAt, Array.getElem?_eq_none (show
      split.balances.data.size ≤ v.toNat by omega), Option.map_none,
      Option.getD_none]
  -- the key is not yet active at a state before the one that schedules it
  have ahead : ∀ m : ForkedBeaconState preset, Run config checks m z → ∀ w : Validator,
      m.state.validators.data[v.toNat]? = some w → w.activationEpoch ≠ FAR_FUTURE_EPOCH →
        (getCurrentEpoch m.state).toNat + 1 < w.activationEpoch.toNat :=
    fun m run w found assigned => by
      obtain ⟨later, foundLater, life⟩ := run.registryLifecycle.validators v.toNat w found
      have same : later = v0 := Option.some.inj (foundLater.symm.trans found0)
      subst same
      have act := life.activationEpoch assigned
      have mZ := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps run.chainSteps)
      rw [← act]
      omega
  obtain ⟨noGross, walk⟩ := key_idle_walk h v.toNat v.toNat_lt highC zEarly (by omega) ahead
    startZero pre Run.nil
  refine ⟨z, pre, post, splitEq, zEarly, zFork, zCounted,
    (Array.getElem?_eq_some_iff.mp found0).1, funded, hysteresis, reserve, by omega, noGross,
    fun p member => ?_⟩
  obtain ⟨-, r2, -⟩ := balancePath_endpoint pre (Run.nil : Run config checks z z) zFork member
  exact ahead p r2

/-- The activation reserve is positive. -/
private theorem maxEffectiveBalance_pos
    (h : Setting config checks g split fin pulled anc counted V) :
    0 < preset.MAX_EFFECTIVE_BALANCE.toNat := by
  have newKey := h.facts.newKey .fusaka
  have size := h.facts.incrementSize
  by_contra zero
  have none : preset.MAX_EFFECTIVE_BALANCE.toNat = 0 := by omega
  rw [none] at newKey
  simp only [Nat.mul_zero, Nat.zero_div, Nat.zero_sub, Nat.le_zero] at newKey
  omega

/-- The consolidation credits of a run after the shared segment fit the due entries.

The keys of a set are credited at most the caps of the due entries of X's queue that name them.

The run from X to the end is the shared segment and then the run from the split.

The horizon is within the withdrawal delay of X, as `shallow` says. -/
private theorem cons_due_bound (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    {z : BeaconState preset fork} (tail : Run config checks ⟨fork, split⟩ ⟨fork, z⟩) (high : ℕ)
    (endEpoch : (getCurrentEpoch z).toNat ≤ high + 1)
    (highLe : high ≤ (getCurrentEpoch pulled).toNat)
    {events eventsF : List (BalanceEvent preset)}
    (replayedF : fromFin.balanceEvents high = .ok eventsF)
    (replayed : tail.balanceEvents high = .ok events) (T : Finset ValidatorIndex) :
    ∑ v ∈ T, consAmt (eventsF ++ events) v.toNat ≤
      ((dueList fin (Nat.le_trans (by decide) h.fulu) high T).map fun v =>
        (withdrawalMaxEffectiveBalance preset fork v).toNat).sum := by
  classical
  have shallow := h.shallow
  obtain ⟨shared⟩ := h.toFin
  have finEpoch : (getCurrentEpoch fin).toNat ≤ (getCurrentEpoch split).toNat :=
    UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps fromFin.chainSteps)
  have splitPulled : (getCurrentEpoch split).toNat ≤ (getCurrentEpoch pulled).toNat :=
    UInt64.le_iff_toNat_le.mp h.called
  have bound := PinKeys.Run.consolidation_credits_le_X_targets (config := config)
    (checks := checks) shared h.genesis h.caps (fromFin.append tail)
    (Nat.le_trans (by decide) h.fulu) h.early high
    (Apriori.Internal.balanceEvents_append fromFin tail high replayedF replayed) endEpoch
    (by simp only; omega) (by omega) (T.image UInt64.toNat)
  have injective : Function.Injective UInt64.toNat := fun _ _ same => UInt64.toNat_inj.mp same
  simp only [injective.mem_finset_image] at bound
  rw [← Finset.sum_image (f := fun i => consAmt (eventsF ++ events) i)
    (fun _ _ _ _ e => UInt64.toNat_inj.mp e)]
  exact bound

/-- The keys that a consolidation of X's queue credits on C's run are at most its due entries.

Each such key is the target of a due entry, and each entry names one target. -/
private theorem cons_keys_le (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    (highLe : highC ≤ (getCurrentEpoch pulled).toNat)
    {eventsF eventsC : List (BalanceEvent preset)}
    (replayedF : fromFin.balanceEvents highC = .ok eventsF)
    (replayedC : tailC.balanceEvents highC = .ok eventsC) (T : Finset ValidatorIndex)
    (credited : ∀ v ∈ T, 0 < consAmt eventsC v.toNat) :
    T.card ≤ (pinTerms config pulled anc fin).consolidationsXCount := by
  classical
  have shallow := h.shallow
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  have each (v : ValidatorIndex) (hv : v ∈ T) : 1 ≤ dueAt fin highC {v} := by
    have bound := cons_due_bound h fromFin tailC highC endEpochC highLe replayedF replayedC {v}
    rw [dueAt_eq fin electra highC]
    by_contra none
    have empty : dueList fin electra highC {v} = [] := List.length_eq_zero_iff.mp (by omega)
    simp only [Finset.sum_singleton, empty, List.map_nil, List.sum_nil] at bound
    have positive := credited v hv
    unfold consAmt at positive bound
    simp only [List.filter_append, List.map_append, List.sum_append] at bound
    omega
  calc T.card = ∑ v ∈ T, 1 := by simp
    _ ≤ ∑ v ∈ T, dueAt fin highC {v} := Finset.sum_le_sum each
    _ = dueAt fin highC T := dueAt_sum fin electra highC T
    _ ≤ (dueList fin electra (getCurrentEpoch pulled).toNat T).length := by
      rw [dueAt_eq fin electra highC]
      exact dueList_length_mono fin electra highLe T
    _ ≤ _ := by
      unfold pinTerms
      dsimp only
      simp only [shallow, electra, ↓reduceIte, ↓reduceDIte]
      simpa using dueList_sum_le_all fin electra (getCurrentEpoch pulled).toNat T fun _ => 1

/-- `consolidationsX` is the sum of the caps of the sources in X's queue that are due.

It is zero beyond the withdrawal delay, so the setting's `shallow` selects the entries. -/
private theorem consolidationsX_eq (h : Setting config checks g split fin pulled anc counted V)
    (electra : .pectra ≤ fork) :
    (pinTerms config pulled anc fin).consolidationsX =
      (((((fin.pendingConsolidations electra).data.toList.filterMap fun c =>
        fin.validators.data[c.sourceIndex.toNat]?).filter fun v =>
          !v.slashed &&
            decide (v.withdrawableEpoch.toNat ≤ (getCurrentEpoch pulled).toNat + 1)).map
            fun v => (withdrawalMaxEffectiveBalance preset fork v).toNat)).sum := by
  have shallow := h.shallow
  unfold pinTerms
  dsimp only
  simp only [shallow, electra, ↓reduceIte, ↓reduceDIte]

/-- The caps are whole increments, so `consolidationsX` is too. -/
private theorem consolidationsX_aligned
    (h : Setting config checks g split fin pulled anc counted V) :
    (pinTerms config pulled anc fin).consolidationsX % preset.EFFECTIVE_BALANCE_INCREMENT.toNat =
      0 := by
  rw [consolidationsX_eq h (Nat.le_trans (by decide) h.fulu)]
  apply Nat.mod_eq_zero_of_dvd
  refine List.dvd_sum fun x hx => ?_
  obtain ⟨v, -, rfl⟩ := List.mem_map.mp hx
  have := congrArg UInt64.toNat (withdrawalMaxEffectiveBalance_aligned (fork := fork) h.aligned v)
  exact Nat.dvd_of_mod_eq_zero (by simpa [UInt64.toNat_mod] using this)

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- A key with no due consolidation entry takes no consolidation credit on C's run or before it.

The horizon of the due entries is cut to R's epoch, which C's replay does not read. -/
private theorem consAmt_zero (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩) {eventsF : List (BalanceEvent preset)}
    (replayedF : fromFin.balanceEvents (getCurrentEpoch pulled).toNat = .ok eventsF)
    {ending : BeaconState preset fork}
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, ending⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch ending).toNat ≤ highC + 1)
    (near : (getCurrentEpoch ending).toNat ≤ (getCurrentEpoch pulled).toNat + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    (v : ValidatorIndex) (none : dueAt fin highC {v} = 0) :
    consAmt eventsF v.toNat + consAmt eventsC v.toNat = 0 := by
  classical
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  have called := UInt64.le_iff_toNat_le.mp h.called
  have later := UInt64.le_iff_toNat_le.mp h.later
  have ahead : (getCurrentEpoch split).toNat ≤ (getCurrentEpoch ending).toNat :=
    UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps tailC.chainSteps)
  obtain ⟨hc, hhc⟩ : ∃ hc, hc = min highC (getCurrentEpoch pulled).toNat := ⟨_, rfl⟩
  rw [balanceEvents_eq_of_endpoint_le fromFin (localHigh := hc) (by simp only; omega)
    (by simp only; omega)] at replayedF
  rw [balanceEvents_eq_of_endpoint_le tailC (localHigh := hc) (by simp only; omega)
    (by simp only; omega)] at replayedC
  have bound := cons_due_bound h fromFin tailC hc (by omega) (by omega) replayedF replayedC {v}
  have empty : dueList fin electra hc {v} = [] := List.length_eq_zero_iff.mp (by
    have := dueList_length_mono fin electra (show hc ≤ highC by omega) {v}
    rw [dueAt_eq fin electra highC] at none
    omega)
  simp only [Finset.sum_singleton, empty, List.map_nil, List.sum_nil] at bound
  unfold consAmt at bound ⊢
  simp only [List.filter_append, List.map_append, List.sum_append] at bound
  omega

/-- The caps of a list of validators are at least the maximum effective balance each. -/
private theorem cap_floor_sum (h : Setting config checks g split fin pulled anc counted V)
    (l : List Validator) :
    preset.MAX_EFFECTIVE_BALANCE.toNat * l.length ≤
      (l.map fun v => (withdrawalMaxEffectiveBalance preset fork v).toNat).sum := by
  have := List.length_nsmul_le_sum
    (l.map fun v => (withdrawalMaxEffectiveBalance preset fork v).toNat)
    preset.MAX_EFFECTIVE_BALANCE.toNat (by
      simp only [List.mem_map]
      rintro _ ⟨v, -, rfl⟩
      exact UInt64.le_iff_toNat_le.mp
        (Internal.minimum_cap h.caps.activation h.caps.compounding v))
  simpa [smul_eq_mul, Nat.mul_comm] using this

/-- A sum over a subset can be extended by zero to use the ambient set's pointwise bounds. -/
private theorem sum_eq_U {M : Type*} [AddCommMonoid M] {S W : Finset ValidatorIndex}
    (sub : S ⊆ W) (f : ValidatorIndex → M) :
    ∑ v ∈ S, f v = ∑ v ∈ W, if v ∈ S then f v else 0 := by
  rw [Finset.sum_ite_mem, Finset.inter_eq_right.mpr sub]

/-- The consolidation credits of C's branch, charged to `consolidationsX`.

The run from the finalized block's state X to C's state has the run from the split as its tail.

`Run.consolidation_credits_le_X_targets` bounds the credits to a set of targets.

The bound is the caps at X of the due entries of X's queue that name them.

It is over the whole run from X.

The run to R's state bounds the credits to V the same way.

The sets `V`, `K4`, `K5` and `K6` are disjoint.

So the sum over their union is at most the caps of X's queue: `consolidationsX`.

This holds as `high ≤` the epoch of the call and X is within the withdrawal delay.

The keys of `SC` are slashed at C, so they are not in `K4`, `K5`, `K6` or `V`.

Their credits join those of `K4`, `K5` and `K6` in the bound.

The keys of `CS` are created after R's registry and slashed at C.

So they are in none of those sets either.

Their credits join the bound with the same share and bands.

A whistleblower's share of the amounts of `SC` and `CS` is at most the amounts.

A due entry that names one of them adds its band.

A key of `V` or `K5` weighs three, and the others one.

Each applied entry also adds one upward band to its target's rise.

So the left side has `upwardBand` for each due entry of X's queue.

An entry is charged its cap at X, which is at least `MAX_EFFECTIVE_BALANCE`.

So three bands are at most three tenths of it.

The bound `3.3 · X ≤ (33 · X + 9) / 10` is the charge of `consolidationsX` in `pinReserve`.

Deeper than the withdrawal delay `consolidationsX` is 0, so the setting's `shallow` is used here. -/
private theorem bud_consolidations_base
    (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩) (high : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    {eventsF : List (BalanceEvent preset)} (replayedF : fromFin.balanceEvents high = .ok eventsF)
    (highLeR : high ≤ (getCurrentEpoch pulled).toNat)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    (highLe : highC ≤ (getCurrentEpoch pulled).toNat) :
    (((∑ v ∈ (K4 pulled counted V), consAmt eventsC v.toNat) +
      (∑ v ∈ (K6 pulled counted), consAmt eventsC v.toNat) +
      3 * (∑ v ∈ (K5 counted V), consAmt eventsC v.toNat) +
      3 * (∑ v ∈ V, consAmt events v.toNat) +
      wShare preset fork (∑ v ∈ SC pulled counted split, consAmt eventsC v.toNat) +
      (∑ v ∈ SC pulled counted split, bandX fin highC v.toNat) +
      wShare preset fork (∑ v ∈ CS counted split, consAmt eventsC v.toNat) +
      (∑ v ∈ CS counted split, bandX fin highC v.toNat) +
      wShare preset fork (∑ v ∈ SC pulled counted split with
        (pinTerms config pulled anc fin).exitBeforeFin v.toNat = true,
          consAmt eventsF v.toNat) +
      (∑ v ∈ SC pulled counted split with
        (pinTerms config pulled anc fin).exitBeforeFin v.toNat = true, bandX fin high v.toNat)) +
      preset.upwardBand * (dueAt fin highC (K4 pulled counted V) +
        dueAt fin highC (K6 pulled counted) + 3 * dueAt fin highC (K5 counted V) +
        3 * dueAt fin high V) ≤
        (33 * (pinTerms config pulled anc fin).consolidationsX + 9) / 10) ∧
      (∑ v ∈ (K4 pulled counted V), consAmt eventsC v.toNat) +
        (∑ v ∈ (K6 pulled counted), consAmt eventsC v.toNat) +
        3 * (∑ v ∈ (K5 counted V), consAmt eventsC v.toNat) ≤
      3 * (pinTerms config pulled anc fin).consolidationsX := by
  classical
  have shallow := h.shallow
  have early := h.early
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  have finEpoch : (getCurrentEpoch fin).toNat ≤ (getCurrentEpoch split).toNat :=
    UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps fromFin.chainSteps)
  have splitPulled : (getCurrentEpoch split).toNat ≤ (getCurrentEpoch pulled).toNat :=
    UInt64.le_iff_toNat_le.mp h.called
  obtain ⟨eventsFin, replayedFin⟩ := fromFin.balanceEvents_ok early highC
  have sameF : eventsFin = eventsF := by
    have splitC := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps tailC.chainSteps)
    simp only at splitC
    have same := DirectSafety.Apriori.Internal.balanceEvents_eq_of_endpoint_le fromFin
      (high := highC) (localHigh := high)
      (by simp only; omega) (by simp only; omega)
    rw [same, replayedF] at replayedFin
    exact (Except.ok.inj replayedFin).symm
  subst sameF
  obtain ⟨Kall, hKall⟩ : ∃ K : Finset ValidatorIndex,
      K = K4 pulled counted V ∪ K5 counted V ∪ K6 pulled counted ∪ SC pulled counted split ∪
        CS counted split := ⟨_, rfl⟩
  have boundC := cons_due_bound h fromFin tailC highC endEpochC highLe replayedFin replayedC Kall
  have boundR := cons_due_bound h fromFin tail high endEpoch highLeR replayedF replayed V
  -- The shared segment's amounts of the keys of `SC` that exited before the finalized epoch.
  set S' := (SC pulled counted split).filter fun v =>
    (pinTerms config pulled anc fin).exitBeforeFin v.toNat = true with hS'
  have subS : S' ⊆ Kall := fun v hv => by
    rw [hKall]
    exact Finset.mem_union_left _ (Finset.mem_union_right _ (Finset.mem_filter.mp hv).1)
  have amountC : (∑ v ∈ Kall, consAmt eventsC v.toNat) + (∑ v ∈ S', consAmt eventsFin v.toNat) ≤
      ((dueList fin electra highC Kall).map fun v =>
        (withdrawalMaxEffectiveBalance preset fork v).toNat).sum := by
    rw [sum_eq_U subS, ← Finset.sum_add_distrib]
    refine le_trans (Finset.sum_le_sum fun i _ => ?_) boundC
    simp only [consAmt, List.filter_append, List.map_append, List.sum_append]
    split_ifs <;> omega
  have amountR : (∑ v ∈ V, consAmt events v.toNat) ≤
      ((dueList fin electra high V).map fun v =>
        (withdrawalMaxEffectiveBalance preset fork v).toNat).sum := by
    refine le_trans (Finset.sum_le_sum fun i _ => ?_) boundR
    simp only [consAmt, List.filter_append, List.map_append, List.sum_append]
    exact Nat.le_add_left _ _
  -- The target sets are disjoint.
  obtain ⟨d45, d46, d56, -, -, -⟩ := classes_disjoint h
  have d456 : Disjoint (K4 pulled counted V ∪ K5 counted V) (K6 pulled counted) :=
    Finset.disjoint_union_left.mpr ⟨d46, d56⟩
  obtain ⟨dS, dVS⟩ := sc_disjoint h
  obtain ⟨dC, dVC⟩ := cs_disjoint h
  have dKV : Disjoint Kall V := by
    rw [hKall, Finset.disjoint_left]
    intro v hk hv
    simp only [Finset.mem_union] at hk
    rcases hk with (((h4 | h5) | h6) | hS) | hC
    · simp only [K4, Finset.mem_filter] at h4
      exact h4.2.2.2 hv
    · simp only [K5, Finset.mem_filter] at h5
      exact h5.2.2 hv
    · simp only [K6, Finset.mem_filter] at h6
      exact h6.2.2 (h.voting v hv).1
    · exact Finset.disjoint_left.mp dVS hv hS
    · exact Finset.disjoint_left.mp dVC hv hC
  -- The amounts and the entries split over the three sets of C's keys.
  have splitAmount : (∑ v ∈ Kall, consAmt eventsC v.toNat) =
      (∑ v ∈ K4 pulled counted V, consAmt eventsC v.toNat) +
        (∑ v ∈ K5 counted V, consAmt eventsC v.toNat) +
        (∑ v ∈ K6 pulled counted, consAmt eventsC v.toNat) +
        (∑ v ∈ SC pulled counted split, consAmt eventsC v.toNat) +
        (∑ v ∈ CS counted split, consAmt eventsC v.toNat) := by
    rw [hKall, Finset.sum_union dC, Finset.sum_union dS, Finset.sum_union d456,
      Finset.sum_union d45]
  have splitEntries (H : ℕ) : (dueList fin electra H Kall).length =
      (dueList fin electra H (K4 pulled counted V)).length +
        (dueList fin electra H (K5 counted V)).length +
        (dueList fin electra H (K6 pulled counted)).length +
        (dueList fin electra H (SC pulled counted split)).length +
        (dueList fin electra H (CS counted split)).length := by
    rw [hKall, dueList_length_union fin electra H dC, dueList_length_union fin electra H dS,
      dueList_length_union fin electra H d456, dueList_length_union fin electra H d45]
  -- The caps of the due entries are at least `MAX_EFFECTIVE_BALANCE` each.
  have floorC := cap_floor_sum h (dueList fin electra (getCurrentEpoch pulled).toNat Kall)
  have floorR := cap_floor_sum h (dueList fin electra high V)
  -- Both runs charge entries of X's queue, at most those that `consolidationsX` counts.
  have total : ((dueList fin electra (getCurrentEpoch pulled).toNat Kall).map fun v =>
        (withdrawalMaxEffectiveBalance preset fork v).toNat).sum +
      ((dueList fin electra high V).map fun v =>
        (withdrawalMaxEffectiveBalance preset fork v).toNat).sum ≤
      (pinTerms config pulled anc fin).consolidationsX := by
    have hcX := consolidationsX_eq h electra
    have laterR := dueList_sum_mono fin electra highLeR V
      (fun v => (withdrawalMaxEffectiveBalance preset fork v).toNat)
    have union := dueList_sum_union fin electra (getCurrentEpoch pulled).toNat dKV
      (fun v => (withdrawalMaxEffectiveBalance preset fork v).toNat)
    have all := dueList_sum_le_all fin electra (getCurrentEpoch pulled).toNat (Kall ∪ V)
      (fun v => (withdrawalMaxEffectiveBalance preset fork v).toNat)
    rw [hcX]
    omega
  have laterC := dueList_sum_mono fin electra highLe Kall
    (fun v => (withdrawalMaxEffectiveBalance preset fork v).toNat)
  -- Whole, the due caps of C's keys fit `consolidationsX`, so the weighted amounts fit three of it.
  have whole : (∑ v ∈ (K4 pulled counted V), consAmt eventsC v.toNat) +
      (∑ v ∈ (K6 pulled counted), consAmt eventsC v.toNat) +
      3 * (∑ v ∈ (K5 counted V), consAmt eventsC v.toNat) ≤
      3 * (pinTerms config pulled anc fin).consolidationsX := by
    omega
  refine ⟨?_, whole⟩
  have bandLen : (dueList fin electra highC (SC pulled counted split)).length +
      (dueList fin electra highC (CS counted split)).length +
      (dueList fin electra highC (K4 pulled counted V)).length +
      (dueList fin electra highC (K6 pulled counted)).length +
      3 * (dueList fin electra highC (K5 counted V)).length +
      (dueList fin electra high S').length ≤
        3 * (dueList fin electra (getCurrentEpoch pulled).toNat Kall).length := by
    have union := splitEntries (getCurrentEpoch pulled).toNat
    have m4 := dueList_length_mono fin electra highLe (K4 pulled counted V)
    have m5 := dueList_length_mono fin electra highLe (K5 counted V)
    have m6 := dueList_length_mono fin electra highLe (K6 pulled counted)
    have mS := dueList_length_mono fin electra highLe (SC pulled counted split)
    have mC := dueList_length_mono fin electra highLe (CS counted split)
    have mF := (dueList_length_mono fin electra highLeR S').trans
      (dueList_length_subset fin electra (getCurrentEpoch pulled).toNat
        (Finset.filter_subset _ _ : S' ⊆ SC pulled counted split))
    omega
  have shareF := wShare_le (fork := fork) h.facts (∑ v ∈ S', consAmt eventsFin v.toNat)
  have shareS := wShare_le (fork := fork) h.facts
    (∑ v ∈ SC pulled counted split, consAmt eventsC v.toNat)
  have shareC := wShare_le (fork := fork) h.facts
    (∑ v ∈ CS counted split, consAmt eventsC v.toNat)
  rw [bandX_sum fin electra highC (SC pulled counted split),
    bandX_sum fin electra highC (CS counted split), bandX_sum fin electra high S']
  rw [dueAt_eq fin electra highC, dueAt_eq fin electra highC, dueAt_eq fin electra highC,
    dueAt_eq fin electra highC, dueAt_eq fin electra highC, dueAt_eq fin electra high,
    dueAt_eq fin electra high]
  rw [Nat.le_div_iff_mul_le (by norm_num)]
  generalize (dueList fin electra highC (K4 pulled counted V)).length = d4 at *
  generalize (dueList fin electra highC (K5 counted V)).length = d5 at *
  generalize (dueList fin electra highC (K6 pulled counted)).length = d6 at *
  generalize (dueList fin electra highC (SC pulled counted split)).length = dS' at *
  generalize (dueList fin electra highC (CS counted split)).length = dC' at *
  generalize (∑ v ∈ SC pulled counted split, consAmt eventsC v.toNat) = aS at *
  generalize wShare preset fork aS = wS at *
  generalize (∑ v ∈ CS counted split, consAmt eventsC v.toNat) = aC at *
  generalize wShare preset fork aC = wC at *
  generalize (dueList fin electra high S').length = dF at *
  generalize (∑ v ∈ S', consAmt eventsFin v.toNat) = aF at *
  generalize wShare preset fork aF = wF at *
  generalize (dueList fin electra (getCurrentEpoch pulled).toNat Kall).length = dK at *
  generalize (dueList fin electra high V).length = dV at *
  generalize ((dueList fin electra highC Kall).map fun v =>
    (withdrawalMaxEffectiveBalance preset fork v).toNat).sum = PK' at *
  generalize ((dueList fin electra (getCurrentEpoch pulled).toNat Kall).map fun v =>
    (withdrawalMaxEffectiveBalance preset fork v).toNat).sum = PK at *
  generalize ((dueList fin electra high V).map fun v =>
    (withdrawalMaxEffectiveBalance preset fork v).toNat).sum = PV at *
  generalize (pinTerms config pulled anc fin).consolidationsX = cX at *
  have bandsK : preset.upwardBand * dS' + preset.upwardBand * dC' +
      preset.upwardBand * (d4 + d6 + 3 * d5 + 3 * dV) + preset.upwardBand * dF ≤
        3 * (preset.upwardBand * (dK + dV)) := by
    have : dS' + dC' + (d4 + d6 + 3 * d5 + 3 * dV) + dF ≤ 3 * (dK + dV) := by omega
    calc preset.upwardBand * dS' + preset.upwardBand * dC' +
          preset.upwardBand * (d4 + d6 + 3 * d5 + 3 * dV) + preset.upwardBand * dF
        = preset.upwardBand * (dS' + dC' + (d4 + d6 + 3 * d5 + 3 * dV) + dF) := by ring
      _ ≤ preset.upwardBand * (3 * (dK + dV)) := Nat.mul_le_mul_left _ this
      _ = 3 * (preset.upwardBand * (dK + dV)) := by ring
  have bandsM : 10 * (preset.upwardBand * (dK + dV)) ≤
      preset.MAX_EFFECTIVE_BALANCE.toNat * dK + preset.MAX_EFFECTIVE_BALANCE.toNat * dV := by
    calc 10 * (preset.upwardBand * (dK + dV))
        = (10 * preset.upwardBand) * (dK + dV) := by ring
      _ ≤ preset.MAX_EFFECTIVE_BALANCE.toNat * (dK + dV) := Nat.mul_le_mul_right _ h.facts.band
      _ = preset.MAX_EFFECTIVE_BALANCE.toNat * dK + preset.MAX_EFFECTIVE_BALANCE.toNat * dV :=
        Nat.mul_add _ _ _
  omega

/-- The consolidation credits of the third window, with the shares of `CS` and the shared segment.

The shared segment's shares are those of the keys of `SC` that exited before the finalized epoch. -/
private theorem bud_consolidations (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩) (high : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    {eventsF : List (BalanceEvent preset)} (replayedF : fromFin.balanceEvents high = .ok eventsF)
    (highLeR : high ≤ (getCurrentEpoch pulled).toNat)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    (highLe : highC ≤ (getCurrentEpoch pulled).toNat) :
    ((∑ v ∈ (K4 pulled counted V), consAmt eventsC v.toNat) +
      (∑ v ∈ (K6 pulled counted), consAmt eventsC v.toNat) +
      3 * (∑ v ∈ (K5 counted V), consAmt eventsC v.toNat) +
      3 * (∑ v ∈ V, consAmt events v.toNat) +
      wShare preset fork (∑ v ∈ SC pulled counted split, consAmt eventsC v.toNat) +
      (∑ v ∈ SC pulled counted split, bandX fin highC v.toNat) +
      wShare preset fork (∑ v ∈ CS counted split, consAmt eventsC v.toNat) +
      (∑ v ∈ CS counted split, bandX fin highC v.toNat) +
      wShare preset fork (∑ v ∈ SC pulled counted split with
        (pinTerms config pulled anc fin).exitBeforeFin v.toNat = true,
          consAmt eventsF v.toNat) +
      (∑ v ∈ SC pulled counted split with
        (pinTerms config pulled anc fin).exitBeforeFin v.toNat = true, bandX fin high v.toNat)) +
      preset.upwardBand * (dueAt fin highC (K4 pulled counted V) +
        dueAt fin highC (K6 pulled counted) + 3 * dueAt fin highC (K5 counted V) +
        3 * dueAt fin high V) ≤
        (33 * (pinTerms config pulled anc fin).consolidationsX + 9) / 10 := by
  exact (bud_consolidations_base h fromFin tail high endEpoch replayed replayedF highLeR tailC highC
    endEpochC replayedC highLe).1

/-- The keys of `K6` whose exit started on R's branch after the split. -/
private theorem bud_exitedR :
    (∑ v ∈ (K6 pulled counted) with (pinTerms config pulled anc fin).exitedRB v.toNat = true,
      (eR pulled v + (pinTerms config pulled anc fin).rise v.toNat)) ≤
        (pinTerms config pulled anc fin).exitedR := by
  rw [exitedR_eq]
  refine voters_sum_le (fun i => balanceAt pulled i + (pinTerms config pulled anc fin).rise i)
    fun v hv => ?_
  have flag := (Finset.mem_filter.mp hv).2
  obtain ⟨w, found⟩ := validator_of_flag (state := pulled) (i := v.toNat) (Or.inl flag)
  exact mem_positions_filter config pulled anc fin found flag

/-- Three sets with disjoint keys: the weights one, three and one are at most three. -/
private theorem weighted_le {A B C : Finset ValidatorIndex} (f : ValidatorIndex → ℕ)
    (ab : Disjoint A B) (ac : Disjoint A C) (bc : Disjoint B C) :
    ∑ v ∈ A, f v + 3 * ∑ v ∈ B, f v + ∑ v ∈ C, f v ≤ 3 * ∑ v ∈ A ∪ B ∪ C, f v := by
  rw [Finset.sum_union (Finset.disjoint_union_left.mpr ⟨ac, bc⟩), Finset.sum_union ab]
  omega

/-- `slashedRB` reads the slashed flag and the withdrawable epoch of the key's record. -/
private theorem slashedRB_eq (config : Config)
    (state ancestor finalizedState : BeaconState preset fork) (i : ℕ) :
    (pinTerms config state ancestor finalizedState).slashedRB i =
      decide ((((state.validators.data[i]?).map (·.slashed)).getD false = true) ∧
        ((state.validators.data[i]?).any fun v => decide (
          ancestor.finalizedCheckpoint.epoch.toNat + preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat ≤
            v.withdrawableEpoch.toNat)) = true) := rfl

/-- A key that the pin counts as slashed on this branch holds a position of the registry. -/
private theorem slashedRB_lt (config : Config)
    (state ancestor finalizedState : BeaconState preset fork)
    {i : ℕ} (h : (pinTerms config state ancestor finalizedState).slashedRB i = true) :
    i < state.validators.data.size := by
  by_contra out
  have none : state.validators.data[i]? = none := Array.getElem?_eq_none (Nat.le_of_not_lt out)
  rw [slashedRB_eq] at h
  simp [none] at h

/-- A slashed key counts in `slashedRB` when its withdrawable epoch is late enough.

That epoch must be a slashing vector past the finalized epoch. -/
private theorem slashedRB_of_withdrawable (config : Config)
    (state ancestor finalizedState : BeaconState preset fork) {i : ℕ} {w : Validator}
    (found : state.validators.data[i]? = some w) (slashed : w.slashed = true)
    (late : ancestor.finalizedCheckpoint.epoch.toNat + preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat ≤
      w.withdrawableEpoch.toNat) :
    (pinTerms config state ancestor finalizedState).slashedRB i = true := by
  rw [slashedRB_eq]
  simpa [found, slashed] using late

/-- A key unslashed at the split and slashed at R counts in `slashedRB`.

R slashes it after the split, so its withdrawable epoch is a slashing vector past the split's. -/
private theorem slashedRB_of_newly_slashed
    (h : Setting config checks g split fin pulled anc counted V) {i : ℕ} {s w : Validator}
    (foundS : split.validators.data[i]? = some s)
    (foundP : pulled.validators.data[i]? = some w) (cleanS : s.slashed = false)
    (slashedP : w.slashed = true) :
    (pinTerms config pulled anc fin).slashedRB i = true := by
  obtain ⟨tail⟩ := h.toPulled
  have finSplit := UInt64.le_iff_toNat_le.mp h.finalized
  have delayed : (getCurrentEpoch split).toNat + preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat ≤
      w.withdrawableEpoch.toNat := (tail.newly_slashed_withdrawableEpoch h.caps.activation
    h.caps.compounding h.early h.delay i s w foundS foundP cleanS slashedP).2
  exact slashedRB_of_withdrawable config pulled anc fin foundP slashedP (by omega)

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The exit of a counted voter of the finalized registry is late at R.

The voter is not active at `counted` since an exit before the finalized epoch is excluded.

Its exit at R is then at least the finalized epoch, so it is late for the whole run. -/
private theorem voter_late (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (v : ValidatorIndex) (voter : v ∈ Q counted) :
    ∀ w, pulled.validators.data[v.toNat]? = some w →
      (getCurrentEpoch pulled).toNat + 1 <
        w.exitEpoch.toNat + config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat := by
  classical
  intro wP foundP
  obtain ⟨tailC⟩ := h.toCounted
  have calledNat := UInt64.le_iff_toNat_le.mp h.called
  have laterNat := UInt64.le_iff_toNat_le.mp h.later
  have finSplit : (getCurrentEpoch fin).toNat ≤ (getCurrentEpoch split).toNat :=
    epoch_le_of_slot_le fin.slot split.slot (Run.slot_le fromFin)
  have within := BeaconState.registryWithinLimit_of_lt h.early counted
  have inQ := voter
  simp only [Q, quorumVoters, Finset.mem_filter, List.mem_toFinset, List.mem_append] at inQ
  obtain ⟨listed, -⟩ := inQ
  obtain ⟨uC, foundC, activeC⟩ : ∃ uC, counted.validators.data[v.toNat]? = some uC ∧
      (isActiveValidator uC (getCurrentEpoch counted) = true ∨
        isActiveValidator uC (getPreviousEpoch counted) = true) := by
    rcases listed with now | before
    · obtain ⟨u, foundU, act⟩ := (mem_getActiveValidatorIndices within).mp now
      exact ⟨u, foundU, .inl act⟩
    · obtain ⟨u, foundU, act⟩ := (mem_getActiveValidatorIndices within).mp before
      exact ⟨u, foundU, .inr act⟩
  -- the voter's exit at R is not before the finalized epoch, so it is late for the whole run
  have short := window_short h
  by_cases exitedFin : wP.exitEpoch.toNat < (getCurrentEpoch fin).toNat
  · exfalso
    obtain ⟨uF', foundF', sameExit⟩ := exit_kept_of_le_fin h foundP (Nat.le_of_lt exitedFin)
    have exitNat : uF'.exitEpoch.toNat = wP.exitEpoch.toNat := congrArg UInt64.toNat sameExit
    have assigned : uF'.exitEpoch ≠ FAR_FUTURE_EPOCH := fun far => by
      have far1 := getCurrentEpoch_succ_lt_farFuture h.twoSlots fin
      have far2 := congrArg UInt64.toNat far
      omega
    have previous := getPreviousEpoch_toNat counted
    have idle : ∀ e : Epoch, uF'.exitEpoch ≤ e → isActiveValidator uC e = false :=
      fun e reached => by
        have inactive := inactive_from_exit (fromFin.append tailC) foundF' assigned reached
        cases act : isActiveValidator uC e
        · rfl
        · exact absurd (inactive.symm.trans (isActiveAt_eq_true_iff.mpr ⟨uC, foundC, act⟩))
            Bool.false_ne_true
    rcases activeC with act | act
    · rw [idle (getCurrentEpoch counted) (UInt64.le_iff_toNat_le.mpr (by omega))] at act
      exact Bool.false_ne_true act
    · rw [idle (getPreviousEpoch counted) (UInt64.le_iff_toNat_le.mpr (by omega))] at act
      exact Bool.false_ne_true act
  · omega

/-- A key whose exit at R is at or after the finalized epoch is late for the whole run.

The call's cutoff is within the withdrawal delay of the finalized epoch.

`voter_late` gives the same for a counted voter. -/
private theorem late_of_exitAfterFin (h : Setting config checks g split fin pulled anc counted V)
    (i : ℕ) (exitAfterFin : ∀ w, pulled.validators.data[i]? = some w →
      (getCurrentEpoch fin).toNat ≤ w.exitEpoch.toNat) :
    ∀ w, pulled.validators.data[i]? = some w →
      (getCurrentEpoch pulled).toNat + 1 <
        w.exitEpoch.toNat + config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat := by
  intro w found
  have after := exitAfterFin w found
  have short := window_short h
  omega

/-- A counted voter is unslashed at the split.

It is unslashed at `counted`, and a slashing stays. -/
private theorem voter_unslashed (h : Setting config checks g split fin pulled anc counted V)
    (v : ValidatorIndex) (voter : v ∈ Q counted) :
    (split.validators.data[v.toNat]?.map (·.slashed)).getD false = false := by
  classical
  obtain ⟨tailC⟩ := h.toCounted
  have within := BeaconState.registryWithinLimit_of_lt h.early counted
  have inQ := voter
  simp only [Q, quorumVoters, Finset.mem_filter, List.mem_toFinset, List.mem_append] at inQ
  obtain ⟨listed, unslashedC⟩ := inQ
  obtain ⟨uC, foundC⟩ : ∃ uC, counted.validators.data[v.toNat]? = some uC := by
    rcases listed with now | before
    · obtain ⟨u, foundU, -⟩ := (mem_getActiveValidatorIndices within).mp now
      exact ⟨u, foundU⟩
    · obtain ⟨u, foundU, -⟩ := (mem_getActiveValidatorIndices within).mp before
      exact ⟨u, foundU⟩
  have cleanC : uC.slashed = false := by simpa [foundC] using unslashedC
  cases foundS : split.validators.data[v.toNat]? with
  | none => rfl
  | some uS =>
    simp [unslashed_of_run tailC foundS (fun u read => by
      rw [foundC] at read
      cases read
      exact cleanC)]

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- A key slashed at R after a state of its run, where it is unslashed, is withdrawable late.

It is withdrawable a slashings vector after that state.

The state is at or after the finalized epoch, so the pin counts the slashing. -/
private theorem slashed_withdrawable_of_clean
    (h : Setting config checks g split fin pulled anc counted V) {d : BeaconState preset fork}
    (run : Run config checks ⟨fork, d⟩ ⟨fork, pulled⟩) (v : ValidatorIndex)
    (clean : ∀ u, d.validators.data[v.toNat]? = some u → u.slashed = false)
    (inside : v.toNat < d.validators.data.size)
    (finalized : anc.finalizedCheckpoint.epoch ≤ getCurrentEpoch d) :
    ∀ w, pulled.validators.data[v.toNat]? = some w → w.slashed = true →
      anc.finalizedCheckpoint.epoch.toNat + preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat ≤
        w.withdrawableEpoch.toNat := by
  intro wP foundP slashedP
  obtain ⟨uD, foundD⟩ : ∃ uD, d.validators.data[v.toNat]? = some uD :=
    ⟨_, Array.getElem?_eq_getElem inside⟩
  have newly := (run.newly_slashed_withdrawableEpoch h.caps.activation h.caps.compounding
    h.early h.delay v.toNat uD wP foundD foundP (clean uD foundD) slashedP).2
  have newly' : (getCurrentEpoch d).toNat + preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat ≤
      wP.withdrawableEpoch.toNat := newly
  have finalizedNat := UInt64.le_iff_toNat_le.mp finalized
  omega

/-- Under the guard, the window from the finalized epoch through R's horizon is under half a vector.

It is the short window of the guard, read at R's horizon. -/
private theorem depthFin_lt_half (h : Setting config checks g split fin pulled anc counted V) :
    (getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat <
      preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat / 2 := by
  obtain ⟨_, _, _, _, _, _, _, _, _, _, short, _⟩ := id h.guard
  change (getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat + 2 <
    preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat / 2 at short
  omega

/-- A step that slashes a key stays in its epoch.

A slot step keeps each slashed flag, and a block keeps the slot. -/
private theorem step_slash_epoch {m n : ForkedBeaconState preset} (step : Step config checks m n)
    (early : n.fork < .glamsterdam) (fulu : .fusaka ≤ m.fork) (i : ℕ)
    (clean : (slashedFlagAt m.state i).getD false = false)
    (slashed : (slashedFlagAt n.state i).getD false = true) :
    (getCurrentEpoch n.state).toNat = (getCurrentEpoch m.state).toNat := by
  cases step with
  | slot ok =>
    obtain ⟨advanced, advancedOk, upgraded⟩ := bind_ok_iff.mp ok
    obtain rfl := DirectSafety.Apriori.Internal.processUpgrades_eq_of_window upgraded fulu early
    have same := slashedFlagAt_advanceSlot advancedOk i
    rw [clean] at same
    exact absurd (same.symm.trans slashed) Bool.false_ne_true
  | @block f s t engine signed due ok =>
    obtain ⟨-, processed, -⟩ := applySignedBlock_ok ok
    have slot := (frame_processBlock processed).slot
    simp only [getCurrentEpoch, slot]

/-- A state before the last step of a run leads to the first state of that step. -/
private theorem prefix_leads {x m n : ForkedBeaconState preset} (pre : Run config checks x m)
    (step : Step config checks m n) {m1 n1 : ForkedBeaconState preset}
    (before : Run config checks x m1) (step1 : Step config checks m1 n1)
    (after : Run config checks n1 n) (cut : (before.snoc step1).append after = pre.snoc step) :
    Nonempty (Run config checks m1 m) := by
  cases after with
  | nil =>
    obtain ⟨rfl, -, -⟩ := Run.snoc.inj cut
    exact ⟨Run.nil⟩
  | snoc rest step2 =>
    obtain ⟨rfl, -, -⟩ := Run.snoc.inj cut
    exact ⟨(Run.nil.snoc step1).append rest⟩

/-- A key unslashed at `c` and slashed at a later state is withdrawable a vector past `fin`.

The key is slashed after `c`, so its withdrawable epoch is the slashings vector past that epoch.

The finalized epoch is at most the epoch of `c`. -/
private theorem slashed_withdrawable_vector
    (h : Setting config checks g split fin pulled anc counted V) (v : ValidatorIndex)
    {c : BeaconState preset fork} (toC : Run config checks ⟨fork, fin⟩ ⟨fork, c⟩)
    (inside : v.toNat < c.validators.data.size)
    (clean : ∀ u, c.validators.data[v.toNat]? = some u → u.slashed = false)
    {a : ForkedBeaconState preset} (run : Run config checks ⟨fork, c⟩ a)
    (low : a.fork < .glamsterdam) (u : Validator)
    (foundU : a.state.validators.data[v.toNat]? = some u) (flag : u.slashed = true) :
    (getCurrentEpoch fin).toNat + preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat ≤
      u.withdrawableEpoch.toNat := by
  obtain ⟨uB, foundB⟩ : ∃ uB, c.validators.data[v.toNat]? = some uB :=
    ⟨_, Array.getElem?_eq_getElem inside⟩
  have finC := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps toC.chainSteps)
  have lower := (run.newly_slashed_withdrawableEpoch h.caps.activation h.caps.compounding
    low h.delay v.toNat uB u foundB foundU (clean uB foundB) flag).2
  simp only at finC lower
  omega

/-- A key unslashed at `c` and slashed at a later state is withdrawable beyond R's horizon.

The guard keeps the window from the finalized epoch through R's horizon under half a vector. -/
private theorem slashed_beyond_horizon
    (h : Setting config checks g split fin pulled anc counted V) (v : ValidatorIndex)
    {c : BeaconState preset fork} (toC : Run config checks ⟨fork, fin⟩ ⟨fork, c⟩)
    (inside : v.toNat < c.validators.data.size)
    (clean : ∀ u, c.validators.data[v.toNat]? = some u → u.slashed = false)
    {a : ForkedBeaconState preset} (run : Run config checks ⟨fork, c⟩ a)
    (low : a.fork < .glamsterdam) (u : Validator)
    (foundU : a.state.validators.data[v.toNat]? = some u) (flag : u.slashed = true) :
    (getCurrentEpoch pulled).toNat + 1 < u.withdrawableEpoch.toNat := by
  have := slashed_withdrawable_vector h v toC inside clean run low u foundU flag
  have half := depthFin_lt_half h
  omega

/-- A key unslashed at R that R does not hold withdrawable has a late exit.

Its withdrawable epoch is its exit plus the delay, or both are unset. -/
private theorem late_of_withdrawable (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩) (i : ℕ) (w : Validator)
    (found : pulled.validators.data[i]? = some w) (clean : w.slashed = false)
    (beyond : (getCurrentEpoch pulled).toNat + 1 < w.withdrawableEpoch.toNat) :
    (getCurrentEpoch pulled).toNat + 1 <
      w.exitEpoch.toNat + config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat := by
  obtain ⟨shared⟩ := h.toFin
  have far := getCurrentEpoch_succ_lt_farFuture h.twoSlots pulled
  rcases Run.withdrawable_eq_exit_delay (shared.append (fromFin.append tail)) h.genesis i w found
    clean with ⟨exitFar, withdrawFar⟩ | eq
  · have := congrArg UInt64.toNat exitFar
    have farEq : FAR_FUTURE_EPOCH.toNat = 2 ^ 64 - 1 := rfl
    omega
  · omega

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The floor of a key slashed at R, from a state of R's run, across the step that slashes it.

The key is unslashed at `c`, and the pin counts it as slashed on R's branch.

The run from the state splits at the step that slashes the key.

Before the step the key is unslashed, and its withdrawable epoch is beyond the epoch of that step.

After it the key is slashed, so its withdrawable epoch is beyond R's horizon.

The floor is R's balance, the run's debits, and the one slack of the slashing that `slashW` holds.

A key slashed at the state needs no step, and takes `slashed_floor` from that state. -/
private theorem slash_floor_across (h : Setting config checks g split fin pulled anc counted V)
    (v : ValidatorIndex) {c : BeaconState preset fork}
    (toC : Run config checks ⟨fork, fin⟩ ⟨fork, c⟩) (inside : v.toNat < c.validators.data.size)
    (clean : ∀ u, c.validators.data[v.toNat]? = some u → u.slashed = false)
    (wP : Validator) (foundP : pulled.validators.data[v.toNat]? = some wP)
    (slashedP : wP.slashed = true)
    (rb : (pinTerms config pulled anc fin).slashedRB v.toNat = true)
    {zs : BeaconState preset fork} (pre : Run config checks ⟨fork, c⟩ ⟨fork, zs⟩)
    (rest : Run config checks ⟨fork, zs⟩ ⟨fork, pulled⟩)
    {evs : List (BalanceEvent preset)}
    (ev : rest.balanceEvents (getCurrentEpoch pulled).toNat = .ok evs) :
    min (actualBalanceAt (⟨fork, zs⟩ : ForkedBeaconState preset) v.toNat)
        (PinTerms.capAt (⟨fork, zs⟩ : ForkedBeaconState preset) v.toNat) ≤
      actualBalanceAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat +
        (evs.map (penaltyDebit v.toNat)).sum + (evs.map (syncDebit v.toNat)).sum +
        (evs.map (floorPartialDebit v)).sum +
          slashW (pinTerms config pulled anc fin) v.toNat := by
  classical
  obtain ⟨shared⟩ := h.toFin
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  obtain ⟨uB, foundB⟩ : ∃ uB, c.validators.data[v.toNat]? = some uB :=
    ⟨_, Array.getElem?_eq_getElem inside⟩
  have cleanB : uB.slashed = false := clean uB foundB
  have finC := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps toC.chainSteps)
  obtain ⟨val, foundZ⟩ : ∃ val, zs.validators.data[v.toNat]? = some val :=
    ⟨_, Array.getElem?_eq_getElem
      (Nat.lt_of_lt_of_le inside (registryGrows_of_chainSteps pre.chainSteps))⟩
  -- the cap of the voter at the state is the cap that the floor reads
  have atZ : PinTerms.capAt (⟨fork, zs⟩ : ForkedBeaconState preset) v.toNat =
      (withdrawalMaxEffectiveBalance preset fork val).toNat := by
    simp [PinTerms.capAt, foundZ]
  have topDiv : PinTerms.capAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat /
      (parameters preset fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat ≤
      slashW (pinTerms config pulled anc fin) v.toNat := by
    have hW : slashW (pinTerms config pulled anc fin) v.toNat =
        preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat /
          (EthLib.Consensus.parameters preset .fusaka).MIN_SLASHING_PENALTY_QUOTIENT.toNat := by
      simp [slashW, rb]
    rw [hW, parameters_of_fusaka h.fulu h.early]
    exact Nat.div_le_div_right (capAt_le_capMax h.caps electra v.toNat)
  -- the floor of a slashed key from a state to R
  have slashedTail : ∀ {a : BeaconState preset fork}
      (runA : Run config checks ⟨fork, c⟩ ⟨fork, a⟩)
      (restA : Run config checks ⟨fork, a⟩ ⟨fork, pulled⟩) {evsA : List (BalanceEvent preset)},
      restA.balanceEvents (getCurrentEpoch pulled).toNat = .ok evsA → ∀ ua : Validator,
      a.validators.data[v.toNat]? = some ua → ua.slashed = true →
      min (actualBalanceAt (⟨fork, a⟩ : ForkedBeaconState preset) v.toNat)
          (PinTerms.capAt (⟨fork, a⟩ : ForkedBeaconState preset) v.toNat) ≤
        actualBalanceAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat +
          (evsA.map (penaltyDebit v.toNat)).sum + (evsA.map (syncDebit v.toNat)).sum +
          (evsA.map (floorPartialDebit v)).sum := by
    intro a runA restA evsA evA ua foundA flagA
    have floor := slashed_floor h (toC.append runA) (e := pulled) (Nat.le_succ _) restA
      (getCurrentEpoch pulled).toNat (Nat.le_succ _) evA v ua foundA
      (fun flag => slashed_withdrawable_vector h v toC inside clean runA h.early ua foundA flag)
      (PinTerms.capAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat)
      (path_le_cap_pulled h (toC.append runA) restA .nil v.toNat)
      (fun before step after _ _ _ => .inr fun u foundU => by
        obtain ⟨w', foundW', flagW'⟩ := before.slashedPersistence v.toNat ua foundA flagA
        have same := Option.some.inj (foundW'.symm.trans foundU)
        have low := Nat.lt_of_le_of_lt
          (fork_le_of_chainSteps ((Run.nil.snoc step).append after).chainSteps) h.early
        exact slashed_beyond_horizon h v toC inside clean (runA.append before) low u foundU
          (same ▸ flagW'))
    have capEq : PinTerms.capAt (⟨fork, a⟩ : ForkedBeaconState preset) v.toNat =
        (withdrawalMaxEffectiveBalance preset fork ua).toNat := by
      simp [PinTerms.capAt, foundA]
    rw [ite_eq_left flagA] at floor
    omega
  by_cases startSlashed : val.slashed = true
  · -- the key is slashed already at the state
    have := slashedTail pre rest ev val foundZ startSlashed
    omega
  · have cleanZ : val.slashed = false := by simpa using startSlashed
    -- the run splits at the step that slashes the key
    obtain ⟨m, n, pre', step, post, split', notYet, arrived⟩ := Run.split_at_flip rest
      (fun z => ∃ w, z.state.validators.data[v.toNat]? = some w ∧ w.slashed = true)
      (fun hx => by
        obtain ⟨w, found, flag⟩ := hx
        have found' : zs.validators.data[v.toNat]? = some w := found
        rw [foundZ] at found'
        cases found'
        simp [cleanZ] at flag)
      ⟨wP, foundP, slashedP⟩
    subst split'
    have forkM : m.fork = fork :=
      fork_eq_of_run pre' ((Run.nil.snoc step).append post) (Nat.le_refl _)
    have forkN : n.fork = fork := fork_eq_of_run (pre'.snoc step) post (Nat.le_refl _)
    obtain ⟨mf, mS⟩ := m
    obtain ⟨nf, nS⟩ := n
    have forkM' : fork = mf := forkM.symm
    have forkN' : fork = nf := forkN.symm
    subst forkM'
    subst forkN'
    obtain ⟨valM, foundM⟩ : ∃ valM, mS.validators.data[v.toNat]? = some valM :=
      ⟨_, Array.getElem?_eq_getElem (Nat.lt_of_lt_of_le
        (Array.getElem?_eq_some_iff.mp foundZ).1 (registryGrows_of_chainSteps pre'.chainSteps))⟩
    have cleanM : valM.slashed = false := by
      by_contra flag
      exact notYet ⟨valM, foundM, by simpa using flag⟩
    obtain ⟨valN, foundN, slashedN⟩ := arrived
    have flagM : (slashedFlagAt mS v.toNat).getD false = false := by
      simp [slashedFlagAt, foundM, cleanM]
    have flagN : (slashedFlagAt nS v.toNat).getD false = true := by
      simp [slashedFlagAt, foundN, slashedN]
    -- the slashing step is a block, so it stays in its epoch
    have sameEpoch : (getCurrentEpoch nS).toNat = (getCurrentEpoch mS).toNat :=
      step_slash_epoch step h.early h.fulu v.toNat flagM flagN
    have nearN : (getCurrentEpoch nS).toNat ≤ (getCurrentEpoch pulled).toNat :=
      UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps post.chainSteps)
    -- the key is not yet withdrawable when the step slashes it
    have slashable : (getCurrentEpoch mS).toNat < valM.withdrawableEpoch.toNat :=
      newly_slashed_unwithdrawable h.genesis h.caps (shared.append (toC.append (pre.append pre')))
        step h.early foundM foundN cleanM slashedN
    -- before the step the key is withdrawable beyond the epoch of the step
    have wide : ∀ {m1 : ForkedBeaconState preset} (toM1 : Run config checks ⟨fork, c⟩ m1)
        (toM : Run config checks m1 ⟨fork, mS⟩) (u : Validator),
        m1.state.validators.data[v.toNat]? = some u →
        (getCurrentEpoch mS).toNat - 1 + 1 < u.withdrawableEpoch.toNat := by
      intro m1 toM1 toM u foundU
      have low : m1.fork < .glamsterdam :=
        Nat.lt_of_le_of_lt (fork_le_of_chainSteps toM.chainSteps) h.early
      have reach : (getCurrentEpoch mS).toNat ≤ (getCurrentEpoch pulled).toNat := by omega
      by_cases flag : u.slashed = true
      · have := slashed_beyond_horizon h v toC inside clean toM1 low u foundU flag
        omega
      · have clean : u.slashed = false := by simpa using flag
        have farBound := getCurrentEpoch_succ_lt_farFuture h.twoSlots pulled
        rcases (shared.append (toC.append toM1)).withdrawable_eq_exit_delay h.genesis v.toNat u
          foundU clean with ⟨-, far⟩ | eqW
        · rw [far]
          omega
        · by_cases assigned : u.exitEpoch = FAR_FUTURE_EPOCH
          · rw [assigned] at eqW
            omega
          · obtain ⟨mm, foundMM, life⟩ := toM.registryLifecycle.validators v.toNat u foundU
            have mmEq : mm = valM := Option.some.inj (foundMM.symm.trans foundM)
            have exM : valM.exitEpoch = u.exitEpoch := by
              rw [← mmEq]
              exact life.exitEpoch assigned
            rcases (shared.append (toC.append (pre.append pre'))).withdrawable_eq_exit_delay
              h.genesis v.toNat valM foundM cleanM with ⟨farM, -⟩ | exactM
            · exact absurd (exM.symm.trans farM) assigned
            · have lower := (shared.append (toC.append toM1)).exit_withdrawable_delay h.genesis
                v.toNat u foundU assigned
              have gap := (shared.append (toC.append toM1)).exit_activation_gap h.genesis
                v.toNat u foundU assigned
              have delayPos := h.delay
              rw [exM] at exactM
              omega
    -- the floor of the run up to the slashed state
    obtain ⟨evs1, ok1⟩ := (pre'.snoc step).balanceEvents_ok h.early
      ((getCurrentEpoch mS).toNat - 1)
    obtain ⟨evs2, ok2⟩ := post.balanceEvents_ok h.early (getCurrentEpoch pulled).toNat
    have ok1' : (pre'.snoc step).balanceEvents (getCurrentEpoch pulled).toNat = .ok evs1 := by
      rw [balanceEvents_eq_of_endpoint_le (pre'.snoc step)
        (localHigh := (getCurrentEpoch mS).toNat - 1) (by simp only; omega)
        (by simp only; omega)]
      exact ok1
    have evEq : evs = evs1 ++ evs2 :=
      Except.ok.inj (ev.symm.trans (balanceEvents_append (pre'.snoc step) post _ ok1' ok2))
    have floor1 := slashed_floor h (toC.append pre) (e := nS) (by omega) (pre'.snoc step)
      ((getCurrentEpoch mS).toNat - 1) (by omega) ok1 v val foundZ
      (fun flag => absurd flag startSlashed)
      (PinTerms.capAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat)
      (path_le_cap_pulled h (toC.append pre) (pre'.snoc step) post v.toNat)
      (fun before step1 after1 cutB _ _ => .inr fun u foundU => by
        obtain ⟨toM⟩ := prefix_leads pre' step before step1 after1 cutB
        exact wide (pre.append before) toM u foundU)
    rw [ite_eq_right startSlashed] at floor1
    have floor2 := slashedTail (pre.append (pre'.snoc step)) post ok2 valN foundN slashedN
    have capMono := cap_le_cap_of_run h.caps (pre'.snoc step) h.early v.toNat
    rw [atZ] at capMono
    rw [evEq]
    simp only [List.map_append, List.sum_append] at floor1 floor2 ⊢
    rw [atZ]
    omega

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The floor of a key unslashed at `c` at each state of R's run from `c`.

The run from `c` is the rest of the run from the finalized state to R's, cut at `c`.

The floor starts from the smaller of the voter's balance there and its cap there.

The cap there is the cap at R if it is frozen, and less if the voter switches to compounding on R.

It is R's balance, the debits of the rest of R's run, and the slack of a slashing on R.

A voter unslashed at R takes it from `key_floorR_from`.

A voter slashed at R takes it from `slashed_floor`, with the slack that `slashW` holds.

The key is unslashed at `c`.

A key slashed on R is withdrawable after the finalized epoch by a vector, by `slashedLate`.

The pin counts it, so `slashW` holds the slack.

The exit of the key at R is late for the whole run.

`voter_late` and `late_of_exitAfterFin` give that for a finalized key. -/
private theorem voter_floorAt (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩)
    (v : ValidatorIndex)
    {c : BeaconState preset fork}
    (toC : Run config checks ⟨fork, fin⟩ ⟨fork, c⟩)
    (rest : Run config checks ⟨fork, c⟩ ⟨fork, pulled⟩)
    (cutC : toC.append rest = fromFin.append tail)
    (clean : ∀ u, c.validators.data[v.toNat]? = some u → u.slashed = false)
    (slashedLate : ∀ w, pulled.validators.data[v.toNat]? = some w → w.slashed = true →
      anc.finalizedCheckpoint.epoch.toNat + preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat ≤
        w.withdrawableEpoch.toNat)
    (inside : v.toNat < c.validators.data.size)
    (late : ∀ w, pulled.validators.data[v.toNat]? = some w → w.slashed = false →
      (getCurrentEpoch pulled).toNat + 1 <
        w.exitEpoch.toNat + config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat) :
    ∀ {zs : BeaconState preset fork} (pre : Run config checks ⟨fork, c⟩ ⟨fork, zs⟩)
    (after : Run config checks ⟨fork, zs⟩ ⟨fork, pulled⟩), pre.append after = rest →
    ∀ {evs : List (BalanceEvent preset)},
    after.balanceEvents (getCurrentEpoch pulled).toNat = .ok evs →
    min (actualBalanceAt (⟨fork, zs⟩ : ForkedBeaconState preset) v.toNat)
        (PinTerms.capAt (⟨fork, zs⟩ : ForkedBeaconState preset) v.toNat) ≤
      actualBalanceAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat +
        (evs.map (penaltyDebit v.toNat)).sum + (evs.map (syncDebit v.toNat)).sum +
        (evs.map (floorPartialDebit v)).sum +
          slashW (pinTerms config pulled anc fin) v.toNat := by
  classical
  have calledNat := UInt64.le_iff_toNat_le.mp h.called
  have laterNat := UInt64.le_iff_toNat_le.mp h.later
  -- the key's records at the four states
  have sizeC := registryGrows_of_chainSteps rest.chainSteps
  obtain ⟨uB, foundB⟩ : ∃ uB, c.validators.data[v.toNat]? = some uB :=
    ⟨_, Array.getElem?_eq_getElem inside⟩
  obtain ⟨wP, foundP⟩ : ∃ wP, pulled.validators.data[v.toNat]? = some wP :=
    ⟨_, Array.getElem?_eq_getElem (Nat.lt_of_lt_of_le inside sizeC)⟩
  -- a record that is unslashed is the unslashed record at its index
  have only : ∀ {s : BeaconState preset fork} {u : Validator},
      s.validators.data[v.toNat]? = some u → u.slashed = false →
      ∀ w, s.validators.data[v.toNat]? = some w → w.slashed = false :=
    fun fu cu w fw => by
      rw [fu] at fw
      cases fw
      exact cu
  have cleanB : uB.slashed = false := clean uB foundB
  have finC := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps toC.chainSteps)
  intro zs pre after cut' evs ev
  have cut : (toC.append pre).append after = fromFin.append tail := by
    rw [← Run.append_assoc, cut', cutC]
  obtain ⟨val, foundZ⟩ : ∃ val, zs.validators.data[v.toNat]? = some val :=
    ⟨_, Array.getElem?_eq_getElem
      (Nat.lt_of_lt_of_le inside (registryGrows_of_chainSteps pre.chainSteps))⟩
  -- the cap of the voter at the state is the cap that the floor reads
  have atZ : PinTerms.capAt (⟨fork, zs⟩ : ForkedBeaconState preset) v.toNat =
      (withdrawalMaxEffectiveBalance preset fork val).toNat := by
    simp [PinTerms.capAt, foundZ]
  by_cases slashedP : wP.slashed = true
  · -- slashed on R after the split: the pin counts it, and `slashW` holds its slack
    have rb : (pinTerms config pulled anc fin).slashedRB v.toNat = true :=
      slashedRB_of_withdrawable config pulled anc fin foundP slashedP
        (slashedLate wP foundP slashedP)
    exact slash_floor_across h v toC inside (fun u fu => only foundB cleanB u fu) wP foundP
      slashedP rb pre after ev
  · have cleanP : wP.slashed = false := by simpa using slashedP
    have lateP := late wP foundP cleanP
    have cleanZ : val.slashed = false := unslashed_of_run after foundZ (only foundP cleanP)
    have retainedZ : ∀ {m n : ForkedBeaconState preset} (before : Run config checks ⟨fork, zs⟩ m)
        (step : Step config checks m n) (later : Run config checks n ⟨fork, pulled⟩),
        (before.snoc step).append later = after → ∀ w,
        n.state.validators.data[v.toNat]? = some w →
        ((getCurrentEpoch pulled).toNat + 1 < w.exitEpoch.toNat ∨
          ∀ u, m.state.validators.data[v.toNat]? = some u →
            (getCurrentEpoch pulled).toNat + 1 < u.withdrawableEpoch.toNat) :=
      fun before step later cutB w foundW =>
        retained_of_exit h fromFin tail (getCurrentEpoch pulled).toNat (Nat.le_refl _) v foundP
          lateP ((toC.append pre).append before) step later
          (by
            rw [← cut, ← cutB]
            exact (Run.append_assoc (toC.append pre) (before.snoc step) later).symm)
          w foundW
    have floor := key_floorR_from h (toC.append pre) after (getCurrentEpoch pulled).toNat
      (Nat.le_succ _) ev v
      val foundZ cleanZ
      (fun w fw => by
        rw [← Option.some.inj (foundP.symm.trans fw)]
        exact cleanP)
      retainedZ
    rw [atZ]
    omega

/-- The effective balance of a key at the finalized state is at most `ebUp`. -/
private theorem effective_fin_le_ebUp (h : Setting config checks g split fin pulled anc counted V)
    (i : ℕ) :
    effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) i ≤
      (pinTerms config pulled anc fin).ebUp i := by
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  rw [ebUp_eq config pulled anc fin electra i _ rfl]
  exact Nat.le_trans (Nat.le_max_right _ _) (Nat.le_max_left _ _)

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The floor of a key slashed at the finalized state, from a state of a run to R.

The key keeps its withdrawable epoch along every run, once it is slashed.

Its withdrawable epoch at R is the slashings vector past the finalized epoch, and past R's horizon.

So `slashed_floor` takes the floor of each state, with no slashing slack. -/
private theorem slash_floor_from_slashed
    (h : Setting config checks g split fin pulled anc counted V) (v : ValidatorIndex)
    (inFin : v.toNat < fin.validators.data.size)
    (slashedFin : ∀ u, fin.validators.data[v.toNat]? = some u → u.slashed = true)
    (wP : Validator) (foundP : pulled.validators.data[v.toNat]? = some wP)
    (frozen : (getCurrentEpoch fin).toNat + preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat ≤
      wP.withdrawableEpoch.toNat)
    (late : (getCurrentEpoch pulled).toNat + 1 < wP.withdrawableEpoch.toNat)
    {zs : BeaconState preset fork} (r1 : Run config checks ⟨fork, fin⟩ ⟨fork, zs⟩)
    (r2 : Run config checks ⟨fork, zs⟩ ⟨fork, pulled⟩) {evs : List (BalanceEvent preset)}
    (ev : r2.balanceEvents (getCurrentEpoch pulled).toNat = .ok evs) :
    min (actualBalanceAt (⟨fork, zs⟩ : ForkedBeaconState preset) v.toNat)
        (PinTerms.capAt (⟨fork, zs⟩ : ForkedBeaconState preset) v.toNat) ≤
      actualBalanceAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat +
        (evs.map (penaltyDebit v.toNat)).sum + (evs.map (syncDebit v.toNat)).sum +
        (evs.map (floorPartialDebit v)).sum := by
  classical
  obtain ⟨shared⟩ := h.toFin
  obtain ⟨uF, foundF⟩ : ∃ uF, fin.validators.data[v.toNat]? = some uF :=
    ⟨_, Array.getElem?_eq_getElem inFin⟩
  obtain ⟨val, foundZ, slashedZ⟩ := r1.slashedPersistence v.toNat uF foundF (slashedFin uF foundF)
  have assigned : val.exitEpoch ≠ FAR_FUTURE_EPOCH :=
    run_slashed_exit_assigned (shared.append r1) h.genesis h.caps.activation
      h.caps.compounding h.early h.delay v.toNat val foundZ slashedZ
  have kept := r2.slashed_withdrawable_eq h.caps.activation h.caps.compounding h.early
    v.toNat val wP foundZ foundP slashedZ assigned
  have capEq : PinTerms.capAt (⟨fork, zs⟩ : ForkedBeaconState preset) v.toNat =
      (withdrawalMaxEffectiveBalance preset fork val).toNat := by
    simp [PinTerms.capAt, foundZ]
  have floor := slashed_floor h r1 (e := pulled) (Nat.le_succ _) r2
    (getCurrentEpoch pulled).toNat (Nat.le_succ _) ev v val foundZ
    (fun _ => by
      have := frozen
      rw [kept.2] at this
      exact this)
    (PinTerms.capAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat)
    (path_le_cap_pulled h r1 r2 .nil v.toNat)
    (fun before step after _ _ _ => .inr fun u foundU => by
      have low := Nat.lt_of_le_of_lt
        (fork_le_of_chainSteps ((Run.nil.snoc step).append after).chainSteps) h.early
      have keptU := before.slashed_withdrawable_eq h.caps.activation h.caps.compounding low
        v.toNat val u foundZ foundU slashedZ assigned
      have lateW := late
      rw [kept.2] at lateW
      rw [keptU.2]
      exact lateW)
  rw [ite_eq_left slashedZ] at floor
  omega

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The effective balance of a finalized key slashed at the split stays in its envelope on R's run.

A key unslashed at the finalized state is slashed on the shared segment or on R's run.

It takes its floor from `slash_floor_across` at the finalized state.

A key slashed at the finalized state keeps its withdrawable epoch along every run.

Its withdrawable epoch at R is the slashings vector past the finalized epoch, and past R's horizon.

So `slashed_floor` takes its floor from each state, with no slashing slack.

`prefix_envelope` turns the floor into the bound on the effective balance. -/
private theorem kc_envelope (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩)
    {eventsF events : List (BalanceEvent preset)}
    (replayedF : fromFin.balanceEvents (getCurrentEpoch pulled).toNat = .ok eventsF)
    (replayed : tail.balanceEvents (getCurrentEpoch pulled).toNat = .ok events)
    (v : ValidatorIndex) (inFin : v.toNat < fin.validators.data.size)
    (slashedSplit : ∃ u, split.validators.data[v.toNat]? = some u ∧ u.slashed = true)
    (rb : (pinTerms config pulled anc fin).slashedRB v.toNat = true)
    (frozen : ∀ w, pulled.validators.data[v.toNat]? = some w →
      (getCurrentEpoch fin).toNat + preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat ≤
        w.withdrawableEpoch.toNat)
    (late : ∀ w, pulled.validators.data[v.toNat]? = some w →
      (getCurrentEpoch pulled).toNat + 1 < w.withdrawableEpoch.toNat) :
    ∀ z ∈ (fromFin.append tail).balancePath, effectiveAt z v.toNat ≤
      (pinTerms config pulled anc fin).ebUp v.toNat + preset.EFFECTIVE_BALANCE_INCREMENT.toNat *
        ((syncD eventsF v.toNat + syncD events v.toNat +
            slashW (pinTerms config pulled anc fin) v.toNat) /
          preset.EFFECTIVE_BALANCE_INCREMENT.toNat) := by
  classical
  obtain ⟨toPulled⟩ := h.toPulled
  obtain ⟨uF, foundF⟩ : ∃ uF, fin.validators.data[v.toNat]? = some uF :=
    ⟨_, Array.getElem?_eq_getElem inFin⟩
  obtain ⟨uS, foundS, flagS⟩ := slashedSplit
  obtain ⟨wP, foundP, slashedP⟩ := toPulled.slashedPersistence v.toNat uS foundS flagS
  have floorAt : ∀ {zs : BeaconState preset fork}
      (pre : Run config checks ⟨fork, fin⟩ ⟨fork, zs⟩)
      (rest : Run config checks ⟨fork, zs⟩ ⟨fork, pulled⟩),
      pre.append rest = fromFin.append tail → ∀ {evs : List (BalanceEvent preset)},
      rest.balanceEvents (getCurrentEpoch pulled).toNat = .ok evs →
      min (actualBalanceAt (⟨fork, zs⟩ : ForkedBeaconState preset) v.toNat)
          (PinTerms.capAt (⟨fork, zs⟩ : ForkedBeaconState preset) v.toNat) ≤
        actualBalanceAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat +
          (evs.map (penaltyDebit v.toNat)).sum + (evs.map (syncDebit v.toNat)).sum +
          (evs.map (floorPartialDebit v)).sum +
            slashW (pinTerms config pulled anc fin) v.toNat := by
    intro zs pre rest _ evs ev
    by_cases cleanF : uF.slashed = false
    · exact slash_floor_across h v Run.nil inFin (fun u fu => by
        rw [← Option.some.inj (foundF.symm.trans fu)]
        exact cleanF) wP foundP slashedP rb pre rest ev
    · -- slashed at the finalized state, so slashed at every state of the run
      have slashedF : uF.slashed = true := by simpa using cleanF
      have := slash_floor_from_slashed h v inFin (fun u fu => by
        rw [← Option.some.inj (foundF.symm.trans fu)]
        exact slashedF) wP foundP (frozen wP foundP) (late wP foundP) pre rest ev
      omega
  exact prefix_envelope h fromFin tail (getCurrentEpoch pulled).toNat (Nat.le_succ _) replayedF
    replayed v Run.nil (fromFin.append tail) (run_nil_append (fromFin.append tail)) inFin
    (slashW (pinTerms config pulled anc fin) v.toNat)
    (Or.inl ⟨effective_fin_le_ebUp h v.toNat, Nat.le_refl _⟩) floorAt

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The effective balance of a key unslashed at `c` at each state of R's run from `c`.

The run from `c` is the rest of the run from the finalized state to R's, cut at `c`.

It is within `ebUp` and a few increments, if it starts within `ebUp`.

It may start within the floor of its balance at `c` instead.

The increments are the whole ones of its sync debits and its slashing slack.

The floor of each state of that run is `voter_floorAt`.

`prefix_envelope` turns it into the bound on the effective balance. -/
private theorem envelope_of_voter (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩)
    {eventsF events : List (BalanceEvent preset)}
    (replayedF : fromFin.balanceEvents (getCurrentEpoch pulled).toNat = .ok eventsF)
    (replayed : tail.balanceEvents (getCurrentEpoch pulled).toNat = .ok events)
    (v : ValidatorIndex)
    {c : BeaconState preset fork}
    (toC : Run config checks ⟨fork, fin⟩ ⟨fork, c⟩)
    (rest : Run config checks ⟨fork, c⟩ ⟨fork, pulled⟩)
    (cutC : toC.append rest = fromFin.append tail)
    (clean : ∀ u, c.validators.data[v.toNat]? = some u → u.slashed = false)
    (slashedLate : ∀ w, pulled.validators.data[v.toNat]? = some w → w.slashed = true →
      anc.finalizedCheckpoint.epoch.toNat + preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat ≤
        w.withdrawableEpoch.toNat)
    (inside : v.toNat < c.validators.data.size)
    (start : (effectiveAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat ≤
        (pinTerms config pulled anc fin).ebUp v.toNat ∧
        effectiveAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat ≤ balanceAt fin v.toNat) ∨
      effectiveAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat ≤
        actualBalanceAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat -
          actualBalanceAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat %
            preset.EFFECTIVE_BALANCE_INCREMENT.toNat)
    (late : ∀ w, pulled.validators.data[v.toNat]? = some w → w.slashed = false →
      (getCurrentEpoch pulled).toNat + 1 <
        w.exitEpoch.toNat + config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat) :
    ∀ z ∈ rest.balancePath, effectiveAt z v.toNat ≤
      (pinTerms config pulled anc fin).ebUp v.toNat +
        preset.EFFECTIVE_BALANCE_INCREMENT.toNat *
          ((syncD eventsF v.toNat + syncD events v.toNat +
              slashW (pinTerms config pulled anc fin) v.toNat) /
            preset.EFFECTIVE_BALANCE_INCREMENT.toNat) := by
  exact prefix_envelope h fromFin tail (getCurrentEpoch pulled).toNat (Nat.le_succ _) replayedF
    replayed v toC rest cutC inside (slashW (pinTerms config pulled anc fin) v.toNat) start
    (voter_floorAt h fromFin tail v toC rest cutC clean slashedLate inside late)

/-- The keys of a set that the pin counts as slashed on this branch are at most `slashedR`. -/
private theorem slashedRB_card_le (config : Config)
    (state ancestor finalizedState : BeaconState preset fork) (W : Finset ValidatorIndex) :
    (W.filter fun v => (pinTerms config state ancestor finalizedState).slashedRB v.toNat =
      true).card ≤ (pinTerms config state ancestor finalizedState).slashedR := by
  classical
  rw [slashedR_eq]
  refine Finset.card_le_card_of_injOn UInt64.toNat (fun v member => ?_)
    (fun a _ b _ same => UInt64.toNat_inj.mp same)
  obtain ⟨_, flag⟩ := Finset.mem_filter.mp member
  exact Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (slashedRB_lt config state ancestor
    finalizedState flag), flag⟩

/-- The keys slashed on this branch after the finalized epoch cost one increment each, once. -/
private theorem slashR_le (config : Config)
    (state ancestor finalizedState : BeaconState preset fork)
    (W : Finset ValidatorIndex) :
    ∑ v ∈ W, slashR (pinTerms config state ancestor finalizedState) v.toNat ≤
      preset.EFFECTIVE_BALANCE_INCREMENT.toNat *
        (pinTerms config state ancestor finalizedState).slashedR := by
  classical
  have sum : ∑ v ∈ W, slashR (pinTerms config state ancestor finalizedState) v.toNat =
      ∑ v ∈ W.filter (fun v => (pinTerms config state ancestor finalizedState).slashedRB v.toNat
        = true), preset.EFFECTIVE_BALANCE_INCREMENT.toNat := by
    rw [Finset.sum_filter]
    rfl
  rw [sum, Finset.sum_const, smul_eq_mul, Nat.mul_comm]
  exact Nat.mul_le_mul_left _ (slashedRB_card_le config state ancestor finalizedState W)

/-- A key that exited by the epoch of a run's start is inactive at the end of the run.

The run keeps an assigned exit epoch, and the epoch of its end is not before that of its start. -/
private theorem inactive_of_exited (twoSlots : 2 ≤ preset.SLOTS_PER_EPOCH.toNat)
    {x y : ForkedBeaconState preset} (tail : Run config checks x y) {i : ℕ} {v : Validator}
    (found : x.state.validators.data[i]? = some v)
    (exited : v.exitEpoch.toNat ≤ (getCurrentEpoch x.state).toNat) :
    isActiveAt y.state (getCurrentEpoch y.state) i = false := by
  have assigned : v.exitEpoch ≠ FAR_FUTURE_EPOCH := by
    intro same
    rw [same] at exited
    have farNat : FAR_FUTURE_EPOCH.toNat = 2 ^ 64 - 1 := rfl
    have bound := (getCurrentEpoch x.state).toNat_lt_size
    simp only [UInt64.size] at bound
    exact getCurrentEpoch_ne_farFuture twoSlots x.state (UInt64.toNat_inj.mp (by omega))
  have forward := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps tail.chainSteps)
  exact inactive_from_exit tail found assigned
    (UInt64.le_iff_toNat_le.mpr (Nat.le_trans exited forward))

/-- No block of a run from the finalized state has as proposer a key that exited by that state.

The key's exit is already assigned at the finalized state, so it is inactive on the whole run.

A proposer is active, which the lookahead of the run gives. -/
private theorem exited_not_proposer (h : Setting config checks g split fin pulled anc counted V)
    {i : ℕ} {w : Validator} (foundPulled : pulled.validators.data[i]? = some w)
    (exited : w.exitEpoch.toNat ≤ (getCurrentEpoch fin).toNat)
    (u : ForkedBeaconState preset) (run : Run config checks ⟨fork, fin⟩ u) (p : ValidatorIndex) :
    u.fork < .glamsterdam → getBeaconProposerIndex u.state = .ok p → p.toNat ≠ i := by
  intro early proposer same
  obtain ⟨toFin⟩ := h.toFin
  obtain ⟨w0, foundFin, kept⟩ := exit_kept_of_le_fin h foundPulled exited
  have inactive := inactive_of_exited h.twoSlots run foundFin (by rw [kept]; exact exited)
  have look := Run.lookaheadActive h.facts.covers h.genesis (toFin.append run) early
  have active := look.proposer_active
    (Nat.le_trans h.fulu (fork_le_of_chainSteps run.chainSteps)) proposer
  rw [same, inactive] at active
  exact Bool.false_ne_true active

/-- A scan over sources that the gross credits hold is at most the gross credits. -/
private theorem scan_le_gross {x y : ForkedBeaconState preset} (tail : Run config checks x y)
    (high v : ℕ) (p : BalanceSource → Bool)
    (inside : ∀ s, p s = true → s = .rewards ∨ s = .slashings ∨ s = .sync) :
    (creditScan p (fun _ => false) v high tail) ≤ grossScan v high tail := by
  have split := creditScan_or (fun s => decide (s = .rewards ∨ s = .slashings ∨ s = .sync))
    (fun _ => false) p (fun s => decide (s = .rewards ∨ s = .slashings ∨ s = .sync) && !p s)
    (fun _ => false) (fun _ => false)
    (fun s => by
      by_cases hp : p s = true
      · simp [hp, inside s hp]
      · simp [hp])
    (fun _ => rfl) (fun s ⟨first, second⟩ => by simp [first] at second)
    (fun s h => by simp at h) v high tail
  unfold grossScan
  omega

/-- A key with a sync credit over a run's replayed events has a gross credit on the run. -/
private theorem syncCr_gross {x y : ForkedBeaconState preset} (electra : .pectra ≤ x.fork)
    (early : y.fork < .glamsterdam) (tailC : Run config checks x y) (highC : ℕ)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    (v : ℕ) (positive : 0 < syncCr eventsC v) : 0 < grossScan v highC tailC := by
  obtain ⟨-, sync⟩ := creditScan_bounds (∅ : Finset ValidatorIndex) UInt64.toNat
    (fun s => decide (s = .rewards ∨ s = .slashings ∨ s = .sync)) (fun _ => false) highC
    (fun _ => 0) tailC replayedC (fun e _ _ => by simp)
  have bound := sync (fun s => decide (s = .sync)) (Or.inl fun s covered => by
      simp only [decide_eq_true_eq] at covered ⊢
      exact Or.inr (Or.inr covered))
    (Or.inr fun ok _ fork early replayed i =>
      (sum_map_sync _ (keyCredit i)).symm.trans
        (PinSeatDebits.slot_syncDebit_zero fork ok early replayed i).2) electra early v
  have conv : syncCr eventsC v = ((eventsC.filter (·.source = .sync)).map (keyCredit v)).sum :=
    sum_map_sync _ (keyCredit v)
  unfold grossScan
  rw [conv] at positive
  omega

/-- A key with a sync credit over the events of the shared segment has a gross credit on a run.

The run is the shared segment followed by a tail from the split. -/
private theorem syncCr_gross_shared (h : Setting config checks g split fin pulled anc counted V)
    {z : BeaconState preset fork} (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, z⟩) (high : ℕ)
    {eventsF : List (BalanceEvent preset)} (replayedF : fromFin.balanceEvents high = .ok eventsF)
    (v : ℕ) (positive : 0 < syncCr eventsF v) :
    0 < grossScan v high (fromFin.append tailC) := by
  have shared := syncCr_gross (Nat.le_trans (by decide) h.fulu) h.early fromFin high replayedF v
    positive
  have split := creditScan_append (fun s => decide (s = .rewards ∨ s = .slashings ∨ s = .sync))
    (fun _ => false) v high fromFin tailC
  unfold grossScan at shared ⊢
  omega

/-- The rounding bands of a set of keys are the band for each key with a sync debit. -/
private theorem sum_bandR (events : List (BalanceEvent preset)) (T : Finset ValidatorIndex) :
    ∑ v ∈ T, bandR events v.toNat =
      (preset.EFFECTIVE_BALANCE_INCREMENT.toNat + preset.downwardBand - 1) *
        (T.filter fun v => 0 < (events.map (syncDebit v.toNat)).sum).card := by
  classical
  simp only [bandR_eq]
  rw [← Finset.sum_filter, Finset.sum_const, smul_eq_mul, Nat.mul_comm]

/-- The keys of `SC` that C's run charges to depart.

A key charged in the split's epoch reads the balance before the credits of `pre` that follow it.

A key charged later holds those credits in its charge, so reading them is an overpayment.

The overpayment fits the one application of `cut_whistle` over these keys and those of `K5`. -/
private def scCharged (pulled counted split : BeaconState preset fork)
    {x y : ForkedBeaconState preset} (tailC : Run config checks x y) : Finset ValidatorIndex :=
  (SC pulled counted split).filter fun v => ∃ c ∈ tailC.departureCharges, c.index = v.toNat

/-- The keys of R's registry that are slashed at the split and that R's call reads as slashed.

They are the keys that the shared run slashes in its last epoch, and some before it.

The withdrawable epoch at R is a slashing vector past the finalized state's epoch.

The anchor's finalized epoch can lag that of the finalized state.

So this leaves out a key slashed before the finalized state's epoch.

Its correlation penalty can fall in the window.

None is in `SC`, which holds keys that are unslashed at the split.

None is in C's quorum, since a flag set at the split persists to C. -/
private def cutKeys (config : Config) (pulled anc fin split : BeaconState preset fork) :
    Finset ValidatorIndex :=
  ((Finset.range pulled.validators.data.size).image UInt64.ofNat).filter fun v =>
    ((split.validators.data[v.toNat]?).map (·.slashed)).getD false = true ∧
      (pinTerms config pulled anc fin).slashedRB v.toNat = true ∧
      ((pulled.validators.data[v.toNat]?).any fun w =>
        decide ((getCurrentEpoch fin).toNat + preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat ≤
          w.withdrawableEpoch.toNat)) = true

/-- A key that exited by the finalized epoch is exited at R's record. -/
private theorem exited_of_exitBeforeFin {v : ValidatorIndex}
    (exit : (pinTerms config pulled anc fin).exitBeforeFin v.toNat = true) :
    ∃ w, pulled.validators.data[v.toNat]? = some w ∧
      w.exitEpoch.toNat ≤ (getCurrentEpoch fin).toNat := by
  have flag : ((pulled.validators.data[v.toNat]?).any fun w =>
      decide (w.exitEpoch.toNat ≤ (getCurrentEpoch fin).toNat)) = true := exit
  cases found0 : pulled.validators.data[v.toNat]? with
  | none => simp [found0] at flag
  | some w0 =>
    simp [found0] at flag
    exact ⟨w0, rfl, flag⟩

/-- A key that C's run charges to depart has not exited by the finalized epoch.

Its exit is assigned at the finalized state, so it is assigned at the start of C's run.

The charge is of a step that starts with the exit unassigned. -/
private theorem scCharged_not_exited (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) {v : ValidatorIndex}
    (member : v ∈ scCharged pulled counted split tailC) :
    (pinTerms config pulled anc fin).exitBeforeFin v.toNat ≠ true := by
  intro exit
  obtain ⟨fromFin⟩ := h.fromFin
  obtain ⟨-, c, cMember, cIndex⟩ := Finset.mem_filter.mp member
  obtain ⟨w, foundPulled, exited⟩ := exited_of_exitBeforeFin exit
  obtain ⟨u, foundFin, kept⟩ := exit_kept_of_le_fin h foundPulled exited
  have assigned : u.exitEpoch ≠ FAR_FUTURE_EPOCH := fun far => by
    have := getCurrentEpoch_succ_lt_farFuture h.twoSlots fin
    have := congrArg UInt64.toNat (kept.symm.trans far)
    have : FAR_FUTURE_EPOCH.toNat = 2 ^ 64 - 1 := rfl
    omega
  obtain ⟨at_split, foundSplit, life⟩ := fromFin.registryLifecycle.validators v.toNat u foundFin
  have keptSplit := life.exitEpoch assigned
  obtain ⟨a, b, front, step, post, site, vv, w2, found, foundB, unset, set, amount, epoch⟩ :=
    tailC.departure_charge_site c cMember
  rw [cIndex] at found foundB
  obtain ⟨at_a, foundA, lifeA⟩ := front.registryLifecycle.validators v.toNat at_split foundSplit
  have same : at_a = vv := Option.some.inj (foundA.symm.trans found)
  have assignedSplit : at_split.exitEpoch ≠ FAR_FUTURE_EPOCH := by
    rw [keptSplit]
    exact assigned
  have keptA := lifeA.exitEpoch assignedSplit
  rw [same] at keptA
  exact assignedSplit (by rw [← keptA]; exact unset)

/-- A key with a proposer, whistleblower or sync credit on a run has a gross credit. -/
private theorem credit_gross {x y : ForkedBeaconState preset} (electra : .pectra ≤ x.fork)
    (early : y.fork < .glamsterdam) (r : Run config checks x y) (highC : ℕ)
    {eventsP : List (BalanceEvent preset)} (replayedP : r.balanceEvents highC = .ok eventsP)
    (v : ℕ) (positive : 0 < propN r highC v + whistC r highC v + syncCr eventsP v) :
    0 < grossScan v highC r := by
  have prop := scan_le_gross r highC v (fun s => decide (s = .rewards))
    fun s h => by simp at h; simp [h]
  have whist := scan_le_gross r highC v (fun s => decide (s = .slashings))
    fun s h => by simp at h; simp [h]
  by_cases sync : 0 < syncCr eventsP v
  · exact syncCr_gross electra early r highC replayedP v sync
  · unfold propN whistC at positive
    omega

/-- A key credited on `pre` is a proposer of its epoch, or holds a seat of the split's committee.

The run `pre` is inside one epoch, from the start `b` of the split's epoch.

At most one block of `pre` is proposed in each of the epoch's slots. -/
private theorem pre_credit_seat (h : Setting config checks g split fin pulled anc counted V)
    {b : BeaconState preset fork} (toB : Run config checks g ⟨fork, b⟩)
    (pre : Run config checks ⟨fork, b⟩ ⟨fork, split⟩)
    (sameEpoch : getCurrentEpoch split = getCurrentEpoch b) (highC : ℕ) :
    ∃ B : Finset ℕ, B.card ≤ preset.SLOTS_PER_EPOCH.toNat ∧
      ∀ i, 0 < grossScan i highC pre → i ∈ B ∨ ∃ w, split.validators.data[i]? = some w ∧
        w.pubkey ∈
          (split.currentSyncCommittee (Nat.le_trans (by decide) h.fulu)).value.pubkeys.toList := by
  have altair : .altair ≤ fork := Nat.le_trans (by decide) h.fulu
  have samePeriod : (getCurrentEpoch split).toNat /
      max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat =
      (getCurrentEpoch b).toNat / max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat := by
    rw [sameEpoch]
  obtain ⟨B, D, cardB, -, gross, -, -, -⟩ := credited_piece h.genesis h.parameters.lookahead toB
    pre h.fulu altair h.early h.delay highC samePeriod
  refine ⟨B, ?_, fun i pos => ?_⟩
  · -- the blocks of `pre` are at most one in each slot of the epoch
    have positive : 0 < preset.SLOTS_PER_EPOCH.toNat := by have := h.twoSlots; omega
    have count : pre.blockCount ≤
        ((getCurrentEpoch split).toNat + 1 - (getCurrentEpoch b).toNat) *
          preset.SLOTS_PER_EPOCH.toNat := PinSeatDebits.Run.blockCount_le_epochs pre positive
    have one : (getCurrentEpoch split).toNat + 1 - (getCurrentEpoch b).toNat = 1 := by
      rw [sameEpoch]
      omega
    rw [one, Nat.one_mul] at count
    exact cardB.trans count
  · rcases gross i pos with inB | ⟨w, found, mem⟩
    · exact .inl inB
    · refine .inr ⟨w, found, ?_⟩
      rw [pre.currentSyncCommittee_eq_of_same_period h.early samePeriod altair altair]
      exact mem

/-- The rounding of an increment's reward is at most a third of a band, from quotient thirty. -/
private theorem whistle_round_le (inc W down : ℕ) (quotient : 30 ≤ W) (large : 3600 ≤ inc) :
    3 * ((inc + W - 1) / W) ≤ inc + down - 1 := by
  have le := Nat.div_mul_le_self (inc + W - 1) W
  generalize (inc + W - 1) / W = c at le ⊢
  rcases c with _ | k
  · omega
  · rw [Nat.succ_mul] at le
    have := Nat.mul_le_mul_left k quotient
    omega

/-- The bands of the classes and of the charged and cut keys fit the seats and slots, as numbers. -/
private theorem bands_arith (UP β cc SPE seats nV n4 n5 n6 nS nE nQ nB nU nK : ℕ)
    (bandUp : UP ≤ 2 * β) (ceil : 3 * cc ≤ β)
    (linear : 3 * nV + n4 + 3 * n5 + n6 + 3 * nU + nK ≤ 3 * seats) (subS : nS ≤ nU)
    (subEQ : nE + nQ ≤ nU) (cardB : nB ≤ SPE) :
    3 * (β * nV) + β * n4 + 3 * (β * n5) + β * n6 + β * nS + UP * nE + UP * (nB + nQ) +
        3 * (cc * nK) ≤ 3 * (β * (seats + SPE)) := by
  have scaled := Nat.mul_le_mul_left β linear
  have bandS := Nat.mul_le_mul_left β subS
  have bandEQ : UP * (nE + nQ) ≤ 2 * β * nU := Nat.mul_le_mul bandUp subEQ
  have bandB : UP * nB ≤ 2 * β * SPE := Nat.mul_le_mul bandUp cardB
  have bandK : 3 * cc * nK ≤ β * nK := Nat.mul_le_mul_right nK ceil
  nlinarith

/-- The cut keys are in no class of `bud_sync`.

A cut key is slashed at the split, and the flag persists to C.

So it is not in `V` or a quorum class, and it is not in `SC`, which is unslashed at the split.

It is in the split's registry, so it is not in `CS`. -/
private theorem cut_disjoint (h : Setting config checks g split fin pulled anc counted V) :
    Disjoint (cutKeys config pulled anc fin split) (V ∪ K4 pulled counted V ∪ K5 counted V ∪
      K6 pulled counted ∪ SC pulled counted split ∪ CS counted split) := by
  rw [Finset.disjoint_left]
  intro v cut member
  simp only [cutKeys, Finset.mem_filter] at cut
  obtain ⟨w, found, marked⟩ : ∃ w, split.validators.data[v.toNat]? = some w ∧ w.slashed = true := by
    cases hw : split.validators.data[v.toNat]? <;> simp_all
  obtain ⟨toCounted⟩ := h.toCounted
  obtain ⟨u, foundC, markedC⟩ := toCounted.slashedPersistence v.toNat w found marked
  have atCounted : slashedFlagAt counted v.toNat = some true := by
    simp [slashedFlagAt, foundC, markedC]
  simp only [Finset.mem_union] at member
  rcases member with ((((inV | in4) | in5) | in6) | inSC) | inCS
  · have unslashed := (h.voting v inV).2
    simp [atCounted] at unslashed
  · exact classes_unslashed (Finset.mem_union_left _ (Finset.mem_union_left _ in4))
      atCounted
  · exact classes_unslashed (pulled := pulled)
      (Finset.mem_union_left _ (Finset.mem_union_right _ in5)) atCounted
  · exact classes_unslashed (V := V) (Finset.mem_union_right _ in6) atCounted
  · simp only [SC, Finset.mem_filter] at inSC
    have fresh := inSC.2.2
    simp [slashedFlagAt, found, marked] at fresh
  · simp only [CS, Finset.mem_filter] at inCS
    have := (Array.getElem?_eq_some_iff.mp found).1
    omega

/-- The bands of the classes, of the charged `SC` keys and of the cut keys fit the seats and slots.

The keys of `scCharged` with a credit on `pre` also pay an upward band.

A key that proposed in `pre` pays it from a slot of the epoch.

The bound adds the slots of an epoch to the seats.

The run `pre` starts at a state of the split's epoch, so its proposers fill the slots of one epoch.

Any other key holds a seat, by its sync credit, and pays it from the spare of its seat.

A cut key with a sync debit holds a seat and pays the rounding of an increment's reward there.

C's run is read at `highC`, and the shared segment and R's run at `high`.

The end epochs of R and of C are at most `high + 1` and `highC + 1`, as in `bud_branchR`. -/
private theorem bands_seats (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (high highC : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {b : BeaconState preset fork} (toB : Run config checks g ⟨fork, b⟩)
    (pre : Run config checks ⟨fork, b⟩ ⟨fork, split⟩)
    (sameEpoch : getCurrentEpoch split = getCurrentEpoch b)
    {events eventsF eventsC eventsP : List (BalanceEvent preset)}
    (replayed : tail.balanceEvents high = .ok events)
    (replayedF : fromFin.balanceEvents high = .ok eventsF)
    (replayedC : tailC.balanceEvents highC = .ok eventsC)
    (replayedP : pre.balanceEvents highC = .ok eventsP) :
    3 * (∑ v ∈ V, bandR (eventsF ++ eventsC) v.toNat) +
        (∑ v ∈ K4 pulled counted V, bandR (eventsF ++ events) v.toNat) +
        3 * (∑ v ∈ K5 counted V, bandR (eventsF ++ events) v.toNat) +
        (∑ v ∈ K6 pulled counted, bandR (eventsF ++ events) v.toNat) +
        (∑ v ∈ SC pulled counted split, bandR (eventsF ++ events) v.toNat) +
        (∑ v ∈ SC pulled counted split,
          if (pinTerms config pulled anc fin).exitBeforeFin v.toNat = true then
            (if 0 < syncCr eventsF v.toNat then preset.upwardBand else 0) else 0) +
        (∑ v ∈ scCharged pulled counted split tailC,
          if 0 < propN pre highC v.toNat + whistC pre highC v.toNat + syncCr eventsP v.toNat then
            preset.upwardBand else 0) +
        3 * (∑ v ∈ cutKeys config pulled anc fin split,
          if 0 < syncD eventsF v.toNat + syncD events v.toNat then
            (preset.EFFECTIVE_BALANCE_INCREMENT.toNat +
              (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat - 1) /
                (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat else 0) ≤
      3 * ((preset.EFFECTIVE_BALANCE_INCREMENT.toNat + preset.downwardBand - 1) *
        (preset.SYNC_COMMITTEE_SIZE.toNat *
          (((getCurrentEpoch pulled).toNat + 1) /
              max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat -
            (getCurrentEpoch fin).toNat / max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat + 1 +
          ((getCurrentEpoch pulled).toNat + 2 - anc.finalizedCheckpoint.epoch.toNat) /
            max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat) +
          preset.SLOTS_PER_EPOCH.toNat)) := by
  classical
  obtain ⟨d45, d46, d56, d4v, d5v, d6v⟩ := classes_disjoint h
  obtain ⟨dSC, dSV⟩ := sc_disjoint h
  have cutApart := cut_disjoint h
  have dKV : Disjoint (cutKeys config pulled anc fin split) V :=
    Finset.disjoint_of_subset_right (fun v hv => by simp [Finset.mem_union, hv]) cutApart
  have dKK : Disjoint (cutKeys config pulled anc fin split)
      (K4 pulled counted V ∪ K5 counted V ∪ K6 pulled counted) :=
    Finset.disjoint_of_subset_right (fun v hv => by
      simp only [Finset.mem_union] at hv ⊢
      tauto) cutApart
  have dKS : Disjoint (cutKeys config pulled anc fin split) (SC pulled counted split) :=
    Finset.disjoint_of_subset_right (fun v hv => by simp [Finset.mem_union, hv]) cutApart
  obtain ⟨B, cardB, creditB⟩ := pre_credit_seat h toB pre sameEpoch highC
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  have altairF : .altair ≤ fork := Nat.le_trans (by decide) electra
  have whistleblower := h.facts.whistleblower fork
  -- the charged keys of `SC` that were credited on `pre`
  set fP := (scCharged pulled counted split tailC).filter fun v =>
    0 < propN pre highC v.toNat + whistC pre highC v.toNat + syncCr eventsP v.toNat with hfP
  have sumP : (∑ v ∈ scCharged pulled counted split tailC,
      if 0 < propN pre highC v.toNat + whistC pre highC v.toNat + syncCr eventsP v.toNat then
        preset.upwardBand else 0) = preset.upwardBand * fP.card := by
    rw [hfP, Finset.card_filter, Finset.mul_sum]
    refine Finset.sum_congr rfl fun v _ => ?_
    by_cases credit : 0 < propN pre highC v.toNat + whistC pre highC v.toNat +
      syncCr eventsP v.toNat <;> simp [credit]
  set fB := fP.filter fun v => v.toNat ∈ B with hfB
  set fQ := fP.filter fun v => v.toNat ∉ B with hfQ
  have splitP : fB.card + fQ.card = fP.card :=
    Finset.card_filter_add_card_filter_not (s := fP) (fun v : ValidatorIndex => v.toNat ∈ B)
  have cardFB : fB.card ≤ B.card :=
    Finset.card_le_card_of_injOn (fun v : ValidatorIndex => v.toNat)
      (fun v hv => (Finset.mem_filter.mp hv).2)
      (fun a _ b _ same => UInt64.toNat_inj.mp same)
  -- a charged key credited on `pre`, and not a proposer there, holds a seat of the split
  have seatQ : ∀ v ∈ fQ, ∃ w, split.validators.data[v.toNat]? = some w ∧
      w.pubkey ∈ (split.currentSyncCommittee altairF).value.pubkeys.toList := by
    intro v hv
    obtain ⟨hvP, notB⟩ := Finset.mem_filter.mp hv
    obtain ⟨-, credit⟩ := Finset.mem_filter.mp hvP
    have gross := credit_gross electra h.early pre highC replayedP v.toNat credit
    rcases creditB v.toNat gross with inB | seat
    · exact absurd inB notB
    · exact seat
  have subQ : fQ ⊆ SC pulled counted split := fun v hv =>
    (Finset.mem_filter.mp (Finset.mem_filter.mp (Finset.mem_filter.mp hv).1).1).1
  -- the cut keys with a sync debit
  set fK := (cutKeys config pulled anc fin split).filter fun v =>
    0 < syncD eventsF v.toNat + syncD events v.toNat with hfK
  have sumK : (∑ v ∈ cutKeys config pulled anc fin split,
      if 0 < syncD eventsF v.toNat + syncD events v.toNat then
        (preset.EFFECTIVE_BALANCE_INCREMENT.toNat +
          (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat - 1) /
            (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat else 0) =
      ((preset.EFFECTIVE_BALANCE_INCREMENT.toNat +
          (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat - 1) /
            (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat) * fK.card := by
    rw [hfK, Finset.card_filter, Finset.mul_sum]
    refine Finset.sum_congr rfl fun v _ => ?_
    by_cases debit : 0 < syncD eventsF v.toNat + syncD events v.toNat <;> simp [debit]
  -- the rounding of an increment's reward at the whistleblower quotient is a third of a band
  have ceil : 3 * ((preset.EFFECTIVE_BALANCE_INCREMENT.toNat +
        (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat - 1) /
          (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat) ≤
      preset.EFFECTIVE_BALANCE_INCREMENT.toNat + preset.downwardBand - 1 := by
    have rounding := h.facts.rounding
    have vector := h.facts.vector
    exact whistle_round_le _ _ _ whistleblower (by omega)
  -- the upward band of a shared credit is paid by each exited key of `SC` with such a credit
  set fE := (SC pulled counted split).filter fun v =>
    (pinTerms config pulled anc fin).exitBeforeFin v.toNat = true ∧
      0 < syncCr eventsF v.toNat with hfE
  have sumE : (∑ v ∈ SC pulled counted split,
      if (pinTerms config pulled anc fin).exitBeforeFin v.toNat = true then
        (if 0 < syncCr eventsF v.toNat then preset.upwardBand else 0) else 0) =
      preset.upwardBand * fE.card := by
    rw [hfE, Finset.card_filter, Finset.mul_sum]
    refine Finset.sum_congr rfl fun v _ => ?_
    by_cases exit : (pinTerms config pulled anc fin).exitBeforeFin v.toNat = true <;>
      by_cases credit : 0 < syncCr eventsF v.toNat <;> simp [exit, credit]
  rw [sum_bandR, sum_bandR, sum_bandR, sum_bandR, sum_bandR, sumE, sumP, sumK]
  have upward := h.facts.upward
  have rounding := h.facts.rounding
  have vector := h.facts.vector
  have bandUp : preset.upwardBand ≤
      2 * (preset.EFFECTIVE_BALANCE_INCREMENT.toNat + preset.downwardBand - 1) := by omega
  generalize preset.upwardBand = UP at bandUp ⊢
  generalize preset.EFFECTIVE_BALANCE_INCREMENT.toNat + preset.downwardBand - 1 = β at bandUp ceil ⊢
  generalize ((preset.EFFECTIVE_BALANCE_INCREMENT.toNat +
      (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat - 1) /
        (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat) = cc at ceil ⊢
  generalize preset.SLOTS_PER_EPOCH.toNat = SPE at cardB ⊢
  generalize hSeats : preset.SYNC_COMMITTEE_SIZE.toNat *
    (((getCurrentEpoch pulled).toNat + 1) / max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat -
      (getCurrentEpoch fin).toNat / max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat + 1 +
    ((getCurrentEpoch pulled).toNat + 2 - anc.finalizedCheckpoint.epoch.toNat) /
      max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat) = seats
  set fV := V.filter fun v => 0 < ((eventsF ++ eventsC).map (syncDebit v.toNat)).sum with hfV
  set f4 := (K4 pulled counted V).filter fun v =>
    0 < ((eventsF ++ events).map (syncDebit v.toNat)).sum with hf4
  set f5 := (K5 counted V).filter fun v =>
    0 < ((eventsF ++ events).map (syncDebit v.toNat)).sum with hf5
  set f6 := (K6 pulled counted).filter fun v =>
    0 < ((eventsF ++ events).map (syncDebit v.toNat)).sum with hf6
  set fS := (SC pulled counted split).filter fun v =>
    0 < ((eventsF ++ events).map (syncDebit v.toNat)).sum with hfS
  set U := fS ∪ fE ∪ fQ with hU
  have subU : U ⊆ SC pulled counted split :=
    Finset.union_subset (Finset.union_subset (Finset.filter_subset _ _)
      (Finset.filter_subset _ _)) subQ
  -- the charged keys of `SC` are not exited by the finalized state
  have dEQ : Disjoint fE fQ := Finset.disjoint_left.mpr fun v hE hQ =>
    scCharged_not_exited h tailC
      (Finset.mem_filter.mp (Finset.mem_filter.mp hQ).1).1 (Finset.mem_filter.mp hE).2.1
  have dKf : Disjoint fV fK := dKV.symm.mono (Finset.filter_subset _ _) (Finset.filter_subset _ _)
  have dK456 : Disjoint (f4 ∪ f5 ∪ f6) fK := dKK.symm.mono
    (Finset.union_subset_union (Finset.union_subset_union (Finset.filter_subset _ _)
      (Finset.filter_subset _ _)) (Finset.filter_subset _ _)) (Finset.filter_subset _ _)
  have dKU : Disjoint U fK := dKS.symm.mono subU (Finset.filter_subset _ _)
  have dSK : Disjoint (f4 ∪ f5 ∪ f6) U := dSC.mono
    (Finset.union_subset_union (Finset.union_subset_union (Finset.filter_subset _ _)
      (Finset.filter_subset _ _)) (Finset.filter_subset _ _)) subU
  have dSf : Disjoint fV U := dSV.mono (Finset.filter_subset _ _) subU
  have d45' : Disjoint f4 f5 := d45.mono (Finset.filter_subset _ _) (Finset.filter_subset _ _)
  have d46' : Disjoint f4 f6 := d46.mono (Finset.filter_subset _ _) (Finset.filter_subset _ _)
  have d56' : Disjoint f5 f6 := d56.mono (Finset.filter_subset _ _) (Finset.filter_subset _ _)
  have d4f : Disjoint fV f4 := d4v.mono (Finset.filter_subset _ _) (Finset.filter_subset _ _)
  have d5f : Disjoint fV f5 := d5v.mono (Finset.filter_subset _ _) (Finset.filter_subset _ _)
  have d6f : Disjoint fV f6 := d6v.mono (Finset.filter_subset _ _) (Finset.filter_subset _ _)
  have inj : Function.Injective fun v : ValidatorIndex => v.toNat := fun a b same =>
    UInt64.toNat_inj.mp same
  -- A key debited on the shared segment is debited on C's run, and any other on R's tail.
  --
  -- A key that exited by the finalized epoch and has a shared credit holds a seat of C's run.
  obtain ⟨everyone, hEveryone⟩ : ∃ everyone, everyone = fV ∪ (f4 ∪ f5 ∪ f6 ∪ U ∪ fK) :=
    ⟨_, rfl⟩
  have replayedFC : fromFin.balanceEvents highC = .ok eventsF := by
    have calledNat := UInt64.le_iff_toNat_le.mp h.called
    have laterNat := UInt64.le_iff_toNat_le.mp h.later
    rw [← DirectSafety.Apriori.Internal.balanceEvents_eq_of_endpoint_le fromFin (high := high)
      (localHigh := highC) (by simp only; omega) (by simp only; omega)]
    exact replayedF
  have union := seat_union_card h fromFin tail tailC high highC replayed replayedFC replayedC
    altairF
    ((everyone.filter fun v =>
      0 < ((eventsF ++ eventsC).map (syncDebit v.toNat)).sum ∨
        ((pinTerms config pulled anc fin).exitBeforeFin v.toNat = true ∧
          0 < syncCr eventsF v.toNat) ∨ v ∈ fQ).image fun v => v.toNat)
    ((everyone.filter fun v => 0 < (events.map (syncDebit v.toNat)).sum).image
      fun v => v.toNat)
    (fun i hi => by
      obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp hi
      rcases (Finset.mem_filter.mp hv).2 with debit | ⟨exit, credit⟩ | seat
      · exact .inl debit
      · obtain ⟨w, found, exited⟩ := exited_of_exitBeforeFin exit
        exact .inr (.inl ⟨syncCr_gross_shared h fromFin tailC highC replayedFC v.toNat credit,
          fun u run p early proposer => exited_not_proposer h found exited u run p early
            proposer⟩)
      · exact .inr (.inr (seatQ v seat)))
    (fun i hi => by
      obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp hi
      exact (Finset.mem_filter.mp hv).2)
  rw [hSeats] at union
  have cover : (everyone.image fun v => v.toNat) ⊆
      ((everyone.filter fun v =>
        0 < ((eventsF ++ eventsC).map (syncDebit v.toNat)).sum ∨
          ((pinTerms config pulled anc fin).exitBeforeFin v.toNat = true ∧
            0 < syncCr eventsF v.toNat) ∨ v ∈ fQ).image fun v => v.toNat) ∪
      ((everyone.filter fun v => 0 < (events.map (syncDebit v.toNat)).sum).image
        fun v => v.toNat) := by
    intro i hi
    obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp hi
    -- a key debited over both runs is debited on one of them
    have debited : 0 < ((eventsF ++ events).map (syncDebit v.toNat)).sum →
        0 < ((eventsF ++ eventsC).map (syncDebit v.toNat)).sum ∨
          0 < (events.map (syncDebit v.toNat)).sum := fun pos => by
      simp only [List.map_append, List.sum_append] at pos ⊢
      omega
    have inEv : v ∈ everyone := hv
    have viaF : 0 < ((eventsF ++ events).map (syncDebit v.toNat)).sum →
        v ∈ everyone.filter (fun v =>
          0 < ((eventsF ++ eventsC).map (syncDebit v.toNat)).sum ∨
          ((pinTerms config pulled anc fin).exitBeforeFin v.toNat = true ∧
            0 < syncCr eventsF v.toNat) ∨ v ∈ fQ) ∨
        v ∈ everyone.filter fun v => 0 < (events.map (syncDebit v.toNat)).sum := fun pos =>
      (debited pos).elim
        (fun d => .inl (Finset.mem_filter.mpr ⟨inEv, .inl d⟩))
        (fun d => .inr (Finset.mem_filter.mpr ⟨inEv, d⟩))
    have viaK : 0 < syncD eventsF v.toNat + syncD events v.toNat →
        v ∈ everyone.filter (fun v =>
          0 < ((eventsF ++ eventsC).map (syncDebit v.toNat)).sum ∨
          ((pinTerms config pulled anc fin).exitBeforeFin v.toNat = true ∧
            0 < syncCr eventsF v.toNat) ∨ v ∈ fQ) ∨
        v ∈ everyone.filter fun v => 0 < (events.map (syncDebit v.toNat)).sum := fun pos =>
      viaF (by simp only [syncD, List.map_append, List.sum_append] at pos ⊢; omega)
    have inV : v ∈ everyone.filter (fun v =>
        0 < ((eventsF ++ eventsC).map (syncDebit v.toNat)).sum ∨
        ((pinTerms config pulled anc fin).exitBeforeFin v.toNat = true ∧
          0 < syncCr eventsF v.toNat) ∨ v ∈ fQ) ∨
        v ∈ everyone.filter fun v => 0 < (events.map (syncDebit v.toNat)).sum := by
      have split : v ∈ fV ∪ (f4 ∪ f5 ∪ f6 ∪ U ∪ fK) := hEveryone ▸ hv
      rcases Finset.mem_union.mp split with member | member
      · exact .inl (Finset.mem_filter.mpr ⟨inEv, .inl (Finset.mem_filter.mp member).2⟩)
      · rcases Finset.mem_union.mp member with member | member
        · rcases Finset.mem_union.mp member with member | member
          · rcases Finset.mem_union.mp member with member | member
            · rcases Finset.mem_union.mp member with member | member
              · exact viaF (Finset.mem_filter.mp member).2
              · exact viaF (Finset.mem_filter.mp member).2
            · exact viaF (Finset.mem_filter.mp member).2
          · rcases Finset.mem_union.mp member with member | member
            · rcases Finset.mem_union.mp member with member | member
              · exact viaF (Finset.mem_filter.mp member).2
              · exact .inl (Finset.mem_filter.mpr
                  ⟨inEv, .inr (.inl (Finset.mem_filter.mp member).2)⟩)
            · exact .inl (Finset.mem_filter.mpr ⟨inEv, .inr (.inr member)⟩)
        · exact viaK (Finset.mem_filter.mp member).2
    rcases inV with c | r
    · exact Finset.mem_union_left _ (Finset.mem_image.mpr ⟨v, c, rfl⟩)
    · exact Finset.mem_union_right _ (Finset.mem_image.mpr ⟨v, r, rfl⟩)
  have union' := (Finset.card_le_card cover).trans union
  have dEQU : Disjoint (f4 ∪ f5 ∪ f6 ∪ U) fK := Finset.disjoint_union_left.mpr ⟨dK456, dKU⟩
  have disjoint : Disjoint fV (f4 ∪ f5 ∪ f6 ∪ U ∪ fK) := by
    rw [Finset.disjoint_union_right, Finset.disjoint_union_right, Finset.disjoint_union_right,
      Finset.disjoint_union_right]
    exact ⟨⟨⟨⟨d4f, d5f⟩, d6f⟩, dSf⟩, dKf⟩
  rw [hEveryone, Finset.card_image_of_injective _ inj, Finset.card_union_of_disjoint disjoint,
    Finset.card_union_of_disjoint dEQU, Finset.card_union_of_disjoint dSK,
    Finset.card_union_of_disjoint (Finset.disjoint_union_left.mpr ⟨d46', d56'⟩),
    Finset.card_union_of_disjoint d45'] at union'
  have subS : fS.card ≤ U.card :=
    Finset.card_le_card (Finset.subset_union_left.trans Finset.subset_union_left)
  have subEQ : fE.card + fQ.card ≤ U.card := by
    rw [← Finset.card_union_of_disjoint dEQ]
    exact Finset.card_le_card (Finset.union_subset
      (Finset.subset_union_right.trans Finset.subset_union_left) Finset.subset_union_right)
  have linear : 3 * fV.card + f4.card + 3 * f5.card + f6.card + 3 * U.card + fK.card ≤
      3 * seats := by
    omega
  have key := bands_arith UP β cc SPE seats fV.card f4.card f5.card f6.card fS.card fE.card
    fQ.card fB.card U.card fK.card bandUp ceil linear subS subEQ (cardFB.trans cardB)
  rw [← splitP]
  linarith

/-- The flag reward of one increment is at most the reward of one increment. -/
private theorem flagRate_le (config : Config)
    (state ancestor finalizedState : BeaconState preset fork) :
    (pinTerms config state ancestor finalizedState).flagRate ≤
      (pinTerms config state ancestor finalizedState).perIncrement := by
  show _ * _ / _ ≤ _
  have weights : (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum ≤ WEIGHT_DENOMINATOR.toNat := by
    decide
  exact (Nat.div_le_div_right (Nat.mul_le_mul_left _ weights)).trans
    (Nat.mul_div_cancel _ (by decide : 0 < WEIGHT_DENOMINATOR.toNat)).le

/-- The rewards of the keys of a set that a test marks fit a quotient.

The quotient is of the sum over the positions that meet a stronger test.

Each reward is a quotient of the key's value.

A sum of quotients is at most the quotient of the sum. -/
private theorem floor_aux {A : Finset ValidatorIndex} {S : Finset ℕ} {P : ℕ → Prop}
    [DecidablePred P] {c q : ℕ} (f : ℕ → ℕ) (rb : ℕ → Bool)
    (inside : ∀ v ∈ A, rb v.toNat = true → v.toNat ∈ S ∧ P v.toNat) :
    ∑ v ∈ A.filter (fun v => rb v.toNat = true), f v.toNat / q ≤
      (∑ i ∈ S.filter P, f i + c) / q :=
  le_trans (DirectSafety.Apriori.Internal.sum_div_le (A.filter fun v => rb v.toNat = true)
    (fun v : ValidatorIndex => f v.toNat) q)
    (Nat.div_le_div_right (Nat.le_trans (voters_sum_le f fun v hv =>
      Finset.mem_filter.mpr (inside v (Finset.mem_filter.mp hv).1 (Finset.mem_filter.mp hv).2))
      (Nat.le_add_right _ _)))

/-- `branchR` is a whistleblower charge and the slashed, proposer and rounding charges.

The slashed, proposer and rounding charges have weight three.

So has the whistleblower charge `Wh`.

The slashed charge covers the flag gain of two windows and the leak of one increment.

The remainder `W` holds those and the unit gain.

`Wh` pays the whistleblower reward of any set of keys that R's call reads as slashed on its branch.

Each reward is at the key's effective balance and rise, or at its balance at the finalized state. -/
private theorem branchR_split (config : Config)
    (state ancestor finalizedState : BeaconState preset fork) :
    ∃ Wh W : ℕ, (pinTerms config state ancestor finalizedState).branchR =
      3 * (Wh + W + preset.EFFECTIVE_BALANCE_INCREMENT.toNat *
          (pinTerms config state ancestor finalizedState).slashedR +
        (pinTerms config state ancestor finalizedState).depth *
          (pinTerms config state ancestor finalizedState).proposerCredit +
        (preset.EFFECTIVE_BALANCE_INCREMENT.toNat + preset.downwardBand - 1) *
          ((pinTerms config state ancestor finalizedState).depth * preset.SLOTS_PER_EPOCH.toNat +
            (pinTerms config state ancestor finalizedState).depth *
              preset.MAX_PENDING_DEPOSITS_PER_EPOCH.toNat +
            preset.SYNC_COMMITTEE_SIZE.toNat *
              (((getCurrentEpoch state).toNat + 1) /
                  max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat -
                (getCurrentEpoch finalizedState).toNat /
                  max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat + 1 +
                (pinTerms config state ancestor finalizedState).depth /
                  max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat))) ∧
      (pinTerms config state ancestor finalizedState).slashedR *
          (2 * (pinTerms config state ancestor finalizedState).depthFin *
            (pinTerms config state ancestor finalizedState).flagRate) +
        (pinTerms config state ancestor finalizedState).slashedR *
          (pinTerms config state ancestor finalizedState).slashLeak +
        (pinTerms config state ancestor finalizedState).unitGain *
          (pinTerms config state ancestor finalizedState).slashedR ≤ W ∧
      ∀ A : Finset ValidatorIndex,
        ∑ v ∈ A.filter (fun v => (pinTerms config state ancestor finalizedState).slashedRB v.toNat
          = true), max (balanceAt state v.toNat +
            (pinTerms config state ancestor finalizedState).rise v.toNat)
              (balanceAt finalizedState v.toNat) /
          (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat ≤ Wh := by
  -- The slashed charge is an increment and the leak of the dropped balance; the leak joins `W`.
  have charge : ∀ d p a b Q f : ℕ, f ≤ p → a ≤ b →
      2 * d * f + d * (2 * p + a / Q + 1) ≤ d * (2 * (2 * p) + b / Q + 1) :=
    fun d p a b Q f le ab => by
      have floor := Nat.div_le_div_right (c := Q) ab
      calc 2 * d * f + d * (2 * p + a / Q + 1) = d * (2 * f + (2 * p + a / Q + 1)) := by ring
        _ ≤ d * (2 * (2 * p) + b / Q + 1) := Nat.mul_le_mul_left _ (by omega)
  obtain ⟨W, D, U, split, gain, unit, floorW⟩ : ∃ W D U : ℕ,
      (pinTerms config state ancestor finalizedState).branchR =
      3 * (W + (preset.EFFECTIVE_BALANCE_INCREMENT.toNat + D) *
          (pinTerms config state ancestor finalizedState).slashedR +
        U * (pinTerms config state ancestor finalizedState).slashedR +
        (pinTerms config state ancestor finalizedState).depth *
          (pinTerms config state ancestor finalizedState).proposerCredit +
        (preset.EFFECTIVE_BALANCE_INCREMENT.toNat + preset.downwardBand - 1) *
          ((pinTerms config state ancestor finalizedState).depth * preset.SLOTS_PER_EPOCH.toNat +
            (pinTerms config state ancestor finalizedState).depth *
              preset.MAX_PENDING_DEPOSITS_PER_EPOCH.toNat +
            preset.SYNC_COMMITTEE_SIZE.toNat *
              (((getCurrentEpoch state).toNat + 1) /
                  max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat -
                (getCurrentEpoch finalizedState).toNat /
                  max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat + 1 +
                (pinTerms config state ancestor finalizedState).depth /
                  max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat))) ∧
      2 * (pinTerms config state ancestor finalizedState).depthFin *
          (pinTerms config state ancestor finalizedState).flagRate +
        (pinTerms config state ancestor finalizedState).slashLeak ≤ D ∧
      U = (pinTerms config state ancestor finalizedState).unitGain ∧
      ∀ A : Finset ValidatorIndex,
        ∑ v ∈ A.filter (fun v => (pinTerms config state ancestor finalizedState).slashedRB v.toNat
          = true), max (balanceAt state v.toNat +
            (pinTerms config state ancestor finalizedState).rise v.toNat)
              (balanceAt finalizedState v.toNat) /
          (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat ≤ W := by
    refine ⟨_, _, _, rfl, ?_, rfl, fun A => ?_⟩
    · exact charge _ _ _ _ _ _ (flagRate_le _ _ _ _)
        (by rw [Nat.mul_assoc]; exact Nat.le_mul_of_pos_left _ (by norm_num))
    · -- The reward of a key is read at its position among the keys slashed on this branch.
      refine floor_aux (A := A) (fun i => max (balanceAt state i +
        (pinTerms config state ancestor finalizedState).rise i) (balanceAt finalizedState i))
        (fun i => (pinTerms config state ancestor finalizedState).slashedRB i) fun v _ flag => ?_
      refine ⟨Finset.mem_range.mpr (slashedRB_lt config state ancestor finalizedState flag), ?_⟩
      rw [slashedRB_eq] at flag
      exact of_decide_eq_true flag
  subst unit
  refine ⟨W, D * (pinTerms config state ancestor finalizedState).slashedR +
    (pinTerms config state ancestor finalizedState).unitGain *
      (pinTerms config state ancestor finalizedState).slashedR, by rw [split]; ring, ?_, floorW⟩
  have step : (pinTerms config state ancestor finalizedState).slashedR *
      (2 * (pinTerms config state ancestor finalizedState).depthFin *
          (pinTerms config state ancestor finalizedState).flagRate +
        (pinTerms config state ancestor finalizedState).slashLeak) ≤
      D * (pinTerms config state ancestor finalizedState).slashedR :=
    (Nat.mul_comm _ _).le.trans (Nat.mul_le_mul_right _ gain)
  rw [Nat.mul_add] at step
  omega

/-- The sync part of the proposer credit is at most the proposer credit. -/
private theorem syncProposer_le_credit (config : Config)
    (state ancestor finalizedState : BeaconState preset fork) :
    (pinTerms config state ancestor finalizedState).syncProposer ≤
      (pinTerms config state ancestor finalizedState).proposerCredit :=
  Nat.le_add_left _ _

/-- The quotient of a number rounded up is at most the number. -/
private theorem ceil_div_le (c q : ℕ) : (c + q - 1) / q ≤ c := by
  rcases Nat.eq_zero_or_pos q with rfl | pos
  · simp
  · obtain ⟨q', rfl⟩ : ∃ q', q = q' + 1 := ⟨q - 1, by omega⟩
    rcases Nat.eq_zero_or_pos c with rfl | cpos
    · exact (Nat.div_eq_of_lt (by omega)).le
    · obtain ⟨c', rfl⟩ : ∃ c', c = c' + 1 := ⟨c - 1, by omega⟩
      refine Nat.div_le_of_le_mul ?_
      rw [show c' + 1 + (q' + 1) - 1 = c' + q' + 1 by omega]
      nlinarith

/-- The keys of `SC` that the rise term of `bud_whistle_of` charges.

They are not slashed at R, `exitedSlashable` does not count them, and they are active at C. -/
private def sc3a (config : Config) (pulled anc fin counted split : BeaconState preset fork) :
    Finset ValidatorIndex :=
  (SC pulled counted split).filter fun v =>
    (¬ (pinTerms config pulled anc fin).slashedRB v.toNat = true ∧
      ¬ PinTerms.exitedSlashable anc pulled v.toNat = true) ∧
    isActiveAt counted (getCurrentEpoch counted) v.toNat = true

/-- The cap that the keys of `K6` beyond R's registry take from `creditCap`.

At a high gain rate each takes the largest cap. -/
private def capUse (config : Config) (pulled anc fin counted : BeaconState preset fork) : ℕ :=
  if (pinTerms config pulled anc fin).gainHigh = true then
    ((K6 pulled counted).filter fun v => pulled.validators.data.size ≤ v.toNat).card *
      preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat
  else 0

/-! ### The supplies of the header terms for the keys of `SC` and `CS`

Each one strengthens a claim on an entry of `pinReserve` that only the keys of the classes make.

The keys of `SC` and `CS` join that claim, and the entry is spent once.

Its base lemma keeps the proof of the claim for the classes. -/

/-- The rise of the current keys of K4 and of `SC` fits the rise of the current keys of R.

The keys of `SC` that the rise term of `bud_whistle_of` charges are not in K4.

Each of them is a key of R's registry. -/
private theorem bud_rise (h : Setting config checks g split fin pulled anc counted V) :
    (∑ v ∈ (K4 pulled counted V), (pinTerms config pulled anc fin).rise v.toNat) +
      (∑ v ∈ (sc3a config pulled anc fin counted split) with
        (pinTerms config pulled anc fin).current v.toNat = true,
          (pinTerms config pulled anc fin).rise v.toNat) ≤
      ∑ i ∈ (pinTerms config pulled anc fin).positions with
        (pinTerms config pulled anc fin).current i = true,
          (pinTerms config pulled anc fin).rise i := by
  classical
  obtain ⟨dSC, -⟩ := sc_disjoint h
  have dis : Disjoint (K4 pulled counted V) ((sc3a config pulled anc fin counted split).filter
      fun v => (pinTerms config pulled anc fin).current v.toNat = true) :=
    Finset.disjoint_of_subset_right (Finset.filter_subset _ _)
      (Finset.disjoint_of_subset_right (Finset.filter_subset _ _)
        (Finset.disjoint_of_subset_left
          (Finset.subset_union_left.trans Finset.subset_union_left) dSC))
  rw [← Finset.sum_union dis]
  refine voters_sum_le (fun i => (pinTerms config pulled anc fin).rise i) fun v hv => ?_
  rcases Finset.mem_union.mp hv with member | member
  · simp only [K4, Finset.mem_filter] at member
    obtain ⟨w, found, active⟩ := active_of_activeVoters h.early (s := pulled) member.2.1
    exact mem_positions_filter config pulled anc fin found
      (isActiveAt_eq_true_iff.mpr ⟨w, found, active⟩)
  · obtain ⟨-, current⟩ := Finset.mem_filter.mp member
    obtain ⟨w, found, -⟩ := isActiveAt_eq_true_iff.mp
      (show isActiveAt pulled (getCurrentEpoch pulled) v.toNat = true from current)
    exact mem_positions_filter config pulled anc fin found current

/-- The rise of the upcoming-only keys of K6 and of `SC` fits `joinRise`.

The keys of `SC` that the rise term of `bud_whistle_of` charges are not in K6.

Each of them is a key of R's registry. -/
private theorem bud_joinRise (h : Setting config checks g split fin pulled anc counted V) :
    (∑ v ∈ (K6 pulled counted) with
        (isActiveAt pulled (getCurrentEpoch pulled) v.toNat = false ∧
          isActiveAt pulled (getCurrentEpoch pulled + 1) v.toNat = true),
        (pinTerms config pulled anc fin).rise v.toNat) +
      (∑ v ∈ (sc3a config pulled anc fin counted split) with
        (isActiveAt pulled (getCurrentEpoch pulled) v.toNat = false ∧
          isActiveAt pulled (getCurrentEpoch pulled + 1) v.toNat = true),
        (pinTerms config pulled anc fin).rise v.toNat) ≤
      (pinTerms config pulled anc fin).joinRise := by
  classical
  obtain ⟨dSC, -⟩ := sc_disjoint h
  have dis : Disjoint ((K6 pulled counted).filter fun v =>
        isActiveAt pulled (getCurrentEpoch pulled) v.toNat = false ∧
          isActiveAt pulled (getCurrentEpoch pulled + 1) v.toNat = true)
      ((sc3a config pulled anc fin counted split).filter fun v =>
        isActiveAt pulled (getCurrentEpoch pulled) v.toNat = false ∧
          isActiveAt pulled (getCurrentEpoch pulled + 1) v.toNat = true) :=
    Finset.disjoint_of_subset_left (Finset.filter_subset _ _)
      (Finset.disjoint_of_subset_right (Finset.filter_subset _ _)
        (Finset.disjoint_of_subset_right (Finset.filter_subset _ _)
          (Finset.disjoint_of_subset_left (Finset.subset_union_right) dSC)))
  rw [← Finset.sum_union dis, joinRise_eq]
  refine voters_sum_le (fun i => (pinTerms config pulled anc fin).rise i) fun v hv => ?_
  have upcoming : isActiveAt pulled (getCurrentEpoch pulled) v.toNat = false ∧
      isActiveAt pulled (getCurrentEpoch pulled + 1) v.toNat = true := by
    rcases Finset.mem_union.mp hv with member | member <;> exact (Finset.mem_filter.mp member).2
  obtain ⟨w, found, -⟩ := isActiveAt_eq_true_iff.mp upcoming.2
  exact mem_positions_filter config pulled anc fin found upcoming

/-- Late activations, weight 3 for V keys and for new keys, and for the keys of `SC`.

A key of `SC` outside the tight window pays its stake three times and its rise.

It also pays the reward of what its finalized balance exceeds them by, rounded up.

In the tight window `late` is 0, and the sum over `SC` is empty, since its guard is false. -/
private theorem bud_late (h : Setting config checks g split fin pulled anc counted V) :
    3 * (∑ v ∈ (VN counted V) with (pinTerms config pulled anc fin).lateB v.toNat = true,
        eR pulled v) +
      (∑ v ∈ (K6 pulled counted) with (pinTerms config pulled anc fin).lateB v.toNat = true,
        (3 * eR pulled v + (pinTerms config pulled anc fin).rise v.toNat)) +
      (∑ v ∈ (sc3a config pulled anc fin counted split) with
        ((pinTerms config pulled anc fin).tight = false ∧
          (pinTerms config pulled anc fin).lateB v.toNat = true),
        (3 * eR pulled v + (pinTerms config pulled anc fin).rise v.toNat +
          3 * ((balanceAt fin v.toNat - balanceAt pulled v.toNat -
            (pinTerms config pulled anc fin).rise v.toNat +
            ((parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat - 1)) /
            (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat))) ≤
      (pinTerms config pulled anc fin).late := by
  classical
  obtain ⟨dSC, dSV⟩ := sc_disjoint h
  rw [late_eq]
  by_cases tight : (pinTerms config pulled anc fin).tight = true
  · rw [ite_eq_left tight]
    have baseTight : 3 * (∑ v ∈ (VN counted V) with
        (pinTerms config pulled anc fin).lateB v.toNat = true, eR pulled v) +
        (∑ v ∈ (K6 pulled counted) with (pinTerms config pulled anc fin).lateB v.toNat = true,
          (3 * eR pulled v + (pinTerms config pulled anc fin).rise v.toNat)) ≤ 0 := by
      -- Tight: no key of VN or K6 is late.
      have fin_le := UInt64.le_iff_toNat_le.mp h.finalized
      have called := UInt64.le_iff_toNat_le.mp h.called
      have bound := (tight_iff config pulled anc fin).mp tight
      have near := h.near
      have lowerEpoch : (getCurrentEpoch pulled).toNat + 1 ≤
          anc.finalizedCheckpoint.epoch.toNat + preset.MAX_SEED_LOOKAHEAD.toNat := by omega
      have none : ∀ v ∈ (VN counted V) ∪ (K6 pulled counted),
          (pinTerms config pulled anc fin).lateB v.toNat = false := by
        intro v hv
        by_contra late
        obtain ⟨w, found, -, beyond⟩ := (lateB_iff config pulled anc fin v.toNat).mp
          (by simpa using late)
        rcases Finset.mem_union.mp hv with hv | hv
        · obtain ⟨w', found', active⟩ := active_of_activeVoters h.early
            (h.voting v (Finset.mem_filter.mp hv).1).1
          rw [found] at found'
          cases found'
          simp only [isActiveValidator, Bool.and_eq_true, decide_eq_true_eq] at active
          have := UInt64.le_iff_toNat_le.mp active.1
          omega
        · have le := activation_le_of_active h (by omega) (Finset.mem_filter.mp hv).1 found
          omega
      have zeroA : ∑ v ∈ (VN counted V) with (pinTerms config pulled anc fin).lateB v.toNat = true,
          eR pulled v = 0 := by
        apply Finset.sum_eq_zero
        intro v hv
        have := none v (Finset.mem_union_left _ (Finset.mem_filter.mp hv).1)
        simp [(Finset.mem_filter.mp hv).2] at this
      have zeroB : ∑ v ∈ (K6 pulled counted) with
          (pinTerms config pulled anc fin).lateB v.toNat = true,
            (3 * eR pulled v + (pinTerms config pulled anc fin).rise v.toNat) = 0 := by
        apply Finset.sum_eq_zero
        intro v hv
        have := none v (Finset.mem_union_right _ (Finset.mem_filter.mp hv).1)
        simp [(Finset.mem_filter.mp hv).2] at this
      rw [zeroA, zeroB]
    have empty : ∑ v ∈ (sc3a config pulled anc fin counted split) with
        ((pinTerms config pulled anc fin).tight = false ∧
          (pinTerms config pulled anc fin).lateB v.toNat = true),
        (3 * eR pulled v + (pinTerms config pulled anc fin).rise v.toNat +
          3 * ((balanceAt fin v.toNat - balanceAt pulled v.toNat -
            (pinTerms config pulled anc fin).rise v.toNat +
            ((parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat - 1)) /
            (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat)) = 0 := by
      refine Finset.sum_eq_zero fun v hv => ?_
      have := (Finset.mem_filter.mp hv).2.1
      rw [tight] at this
      cases this
    omega
  · rw [ite_eq_right tight]
    set A := (VN counted V).filter fun v => (pinTerms config pulled anc fin).lateB v.toNat = true
      with hA
    set B := (K6 pulled counted).filter
      fun v => (pinTerms config pulled anc fin).lateB v.toNat = true with hB
    set C := (sc3a config pulled anc fin counted split).filter fun v =>
      (pinTerms config pulled anc fin).tight = false ∧
        (pinTerms config pulled anc fin).lateB v.toNat = true with hC
    have apartAB : Disjoint A B := by
      rw [Finset.disjoint_left]
      intro v hv hk
      exact (Finset.mem_filter.mp (Finset.mem_filter.mp hk).1).2.2
        (h.voting v (Finset.mem_filter.mp (Finset.mem_filter.mp hv).1).1).1
    have apartAC : Disjoint A C :=
      Finset.disjoint_of_subset_left (Finset.filter_subset _ _)
        (Finset.disjoint_of_subset_right (Finset.filter_subset _ _)
          (Finset.disjoint_of_subset_left (Finset.filter_subset _ _)
            (Finset.disjoint_of_subset_right (Finset.filter_subset _ _) dSV)))
    have apartBC : Disjoint B C :=
      Finset.disjoint_of_subset_left (Finset.filter_subset _ _)
        (Finset.disjoint_of_subset_right (Finset.filter_subset _ _)
          (Finset.disjoint_of_subset_left Finset.subset_union_right
            (Finset.disjoint_of_subset_right (Finset.filter_subset _ _) dSC)))
    have growA : 3 * ∑ v ∈ A, eR pulled v ≤
        ∑ v ∈ A, (3 * eR pulled v + (pinTerms config pulled anc fin).rise v.toNat +
          3 * ((balanceAt fin v.toNat - balanceAt pulled v.toNat -
            (pinTerms config pulled anc fin).rise v.toNat +
            ((parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat - 1)) /
            (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat)) := by
      rw [Finset.mul_sum]
      exact Finset.sum_le_sum fun v _ =>
        Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _)
    have growB : ∑ v ∈ B, (3 * eR pulled v + (pinTerms config pulled anc fin).rise v.toNat) ≤
        ∑ v ∈ B, (3 * eR pulled v + (pinTerms config pulled anc fin).rise v.toNat +
          3 * ((balanceAt fin v.toNat - balanceAt pulled v.toNat -
            (pinTerms config pulled anc fin).rise v.toNat +
            ((parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat - 1)) /
            (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat)) :=
      Finset.sum_le_sum fun v _ => Nat.le_add_right _ _
    have joined : ∑ v ∈ A, (3 * eR pulled v + (pinTerms config pulled anc fin).rise v.toNat +
          3 * ((balanceAt fin v.toNat - balanceAt pulled v.toNat -
            (pinTerms config pulled anc fin).rise v.toNat +
            ((parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat - 1)) /
            (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat)) +
        ∑ v ∈ B, (3 * eR pulled v + (pinTerms config pulled anc fin).rise v.toNat +
          3 * ((balanceAt fin v.toNat - balanceAt pulled v.toNat -
            (pinTerms config pulled anc fin).rise v.toNat +
            ((parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat - 1)) /
            (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat)) +
        ∑ v ∈ C, (3 * eR pulled v + (pinTerms config pulled anc fin).rise v.toNat +
          3 * ((balanceAt fin v.toNat - balanceAt pulled v.toNat -
            (pinTerms config pulled anc fin).rise v.toNat +
            ((parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat - 1)) /
            (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat)) ≤
        ∑ i ∈ (pinTerms config pulled anc fin).positions.filter
          (fun i => (pinTerms config pulled anc fin).lateB i = true),
            (3 * balanceAt pulled i + (pinTerms config pulled anc fin).rise i +
              3 * ((balanceAt fin i - balanceAt pulled i -
            (pinTerms config pulled anc fin).rise i +
            ((parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat - 1)) /
            (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat)) := by
      rw [← Finset.sum_union apartAB, ← Finset.sum_union (Finset.disjoint_union_left.mpr
        ⟨apartAC, apartBC⟩)]
      refine voters_sum_le (fun i => 3 * balanceAt pulled i +
        (pinTerms config pulled anc fin).rise i + 3 * ((balanceAt fin i - balanceAt pulled i -
            (pinTerms config pulled anc fin).rise i +
            ((parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat - 1)) /
            (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat)) fun v hv => ?_
      have flag : (pinTerms config pulled anc fin).lateB v.toNat = true := by
        rcases Finset.mem_union.mp hv with hv | hv
        · rcases Finset.mem_union.mp hv with hv | hv <;>
            exact (Finset.mem_filter.mp hv).2
        · exact (Finset.mem_filter.mp hv).2.2
      obtain ⟨w, found, -⟩ := (lateB_iff config pulled anc fin v.toNat).mp flag
      exact mem_positions_filter config pulled anc fin found flag
    omega

/-- K6 keys and `SC` keys of R's registry that are not yet eligible at R: their stake and rise.

A key of `SC` also pays the reward of what its finalized balance exceeds them by, rounded up.

In the tight window `pendingR` is 0, and the sum over `SC` is empty, since its guard is false. -/
private theorem bud_pendingR (h : Setting config checks g split fin pulled anc counted V) :
    (∑ v ∈ (K6 pulled counted) with (pinTerms config pulled anc fin).pendingRB v.toNat = true,
      (eR pulled v + (pinTerms config pulled anc fin).rise v.toNat)) +
      (∑ v ∈ (sc3a config pulled anc fin counted split) with
        ((pinTerms config pulled anc fin).tight = false ∧
          (pinTerms config pulled anc fin).pendingRB v.toNat = true),
        (eR pulled v + (pinTerms config pulled anc fin).rise v.toNat +
          3 * ((balanceAt fin v.toNat - balanceAt pulled v.toNat -
            (pinTerms config pulled anc fin).rise v.toNat +
            ((parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat - 1)) /
            (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat))) ≤
      (pinTerms config pulled anc fin).pendingR := by
  classical
  obtain ⟨dSC, -⟩ := sc_disjoint h
  rw [pendingR_eq]
  by_cases tight : (pinTerms config pulled anc fin).tight = true
  · rw [ite_eq_left tight]
    have baseTight : (∑ v ∈ (K6 pulled counted) with
        (pinTerms config pulled anc fin).pendingRB v.toNat = true,
        (eR pulled v + (pinTerms config pulled anc fin).rise v.toNat)) ≤ 0 := by
      have fin_le := UInt64.le_iff_toNat_le.mp h.finalized
      have called := UInt64.le_iff_toNat_le.mp h.called
      have bound := (tight_iff config pulled anc fin).mp tight
      have near : (getCurrentEpoch counted).toNat ≤ (getCurrentEpoch pulled).toNat + 1 := h.near
      apply Nat.le_of_eq
      apply Finset.sum_eq_zero
      intro v hv
      exfalso
      have hv' := Finset.mem_filter.mp hv
      obtain ⟨w, found, -, far⟩ := (pendingRB_iff config pulled anc fin v.toNat).mp hv'.2
      have le := activation_le_of_active h (by omega) (Finset.mem_filter.mp hv'.1).1 found
      have farNat : w.activationEpoch.toNat = 2 ^ 64 - 1 := by rw [far]; rfl
      have below := getCurrentEpoch_succ_lt_farFuture h.twoSlots counted
      have farValue : FAR_FUTURE_EPOCH.toNat = 2 ^ 64 - 1 := rfl
      omega
    have empty : ∑ v ∈ (sc3a config pulled anc fin counted split) with
        ((pinTerms config pulled anc fin).tight = false ∧
          (pinTerms config pulled anc fin).pendingRB v.toNat = true),
        (eR pulled v + (pinTerms config pulled anc fin).rise v.toNat +
          3 * ((balanceAt fin v.toNat - balanceAt pulled v.toNat -
            (pinTerms config pulled anc fin).rise v.toNat +
            ((parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat - 1)) /
            (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat)) = 0 := by
      refine Finset.sum_eq_zero fun v hv => ?_
      have := (Finset.mem_filter.mp hv).2.1
      rw [tight] at this
      cases this
    omega
  · rw [ite_eq_right tight]
    set K := (K6 pulled counted).filter
      fun v => (pinTerms config pulled anc fin).pendingRB v.toNat = true with hK
    set C := (sc3a config pulled anc fin counted split).filter fun v =>
      (pinTerms config pulled anc fin).tight = false ∧
        (pinTerms config pulled anc fin).pendingRB v.toNat = true with hC
    have apart : Disjoint K C :=
      Finset.disjoint_of_subset_left (Finset.filter_subset _ _)
        (Finset.disjoint_of_subset_right (Finset.filter_subset _ _)
          (Finset.disjoint_of_subset_left Finset.subset_union_right
            (Finset.disjoint_of_subset_right (Finset.filter_subset _ _) dSC)))
    have grow : ∑ v ∈ K, (eR pulled v + (pinTerms config pulled anc fin).rise v.toNat) ≤
        ∑ v ∈ K, (eR pulled v + (pinTerms config pulled anc fin).rise v.toNat +
          3 * ((balanceAt fin v.toNat - balanceAt pulled v.toNat -
            (pinTerms config pulled anc fin).rise v.toNat +
            ((parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat - 1)) /
            (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat)) :=
      Finset.sum_le_sum fun v _ => Nat.le_add_right _ _
    refine Nat.le_trans (Nat.add_le_add_right grow _) ?_
    rw [← Finset.sum_union apart]
    refine voters_sum_le (fun i => balanceAt pulled i + (pinTerms config pulled anc fin).rise i +
      3 * ((balanceAt fin i - balanceAt pulled i -
            (pinTerms config pulled anc fin).rise i +
            ((parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat - 1)) /
            (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat)) fun v hv => ?_
    have flag : (pinTerms config pulled anc fin).pendingRB v.toNat = true := by
      rcases Finset.mem_union.mp hv with member | member
      · exact (Finset.mem_filter.mp member).2
      · exact (Finset.mem_filter.mp member).2.2
    obtain ⟨w, found, -⟩ := (pendingRB_iff config pulled anc fin v.toNat).mp flag
    exact mem_positions_filter config pulled anc fin found flag

/-- No key of the split's registry is slashed on C's branch and withdrawable at R.

Here withdrawable means by the finalized epoch.

Both records are unslashed before C's slashing, and the key is unslashed at R.

If the split has no exit for it, C's slashing assigns one, and a run never charges an exit twice.

Otherwise R's withdrawable epoch is the split's, so the key is retired at the split.

A retired key stays unslashed on C's run. -/
private theorem sc3a_unwithdrawn (h : Setting config checks g split fin pulled anc counted V)
    {i : ℕ} {s w u : Validator} (foundS : split.validators.data[i]? = some s)
    (foundP : pulled.validators.data[i]? = some w)
    (foundC : counted.validators.data[i]? = some u)
    (cleanS : s.slashed = false) (slashedC : u.slashed = true) (cleanP : w.slashed = false)
    (settled : w.withdrawableEpoch.toNat ≤ anc.finalizedCheckpoint.epoch.toNat) : False := by
  obtain ⟨rf⟩ := h.toFin
  obtain ⟨rs⟩ := h.fromFin
  obtain ⟨tailR⟩ := h.toPulled
  obtain ⟨tailC⟩ := h.toCounted
  have finSplit := UInt64.le_iff_toNat_le.mp h.finalized
  obtain ⟨uAssigned, -⟩ := tailC.newly_slashed_withdrawableEpoch h.caps.activation
    h.caps.compounding h.early h.delay i s u foundS foundC cleanS slashedC
  by_cases unset : s.exitEpoch = FAR_FUTURE_EPOCH
  · obtain ⟨c, member, index, -⟩ := tailC.departure_charge_of_assigned i s u foundS foundC unset
      uAssigned
    exact no_charge_of_settled h tailC (Array.getElem?_eq_some_iff.mp foundS).1 foundP settled c
      member index
  · have kept := PinEventsKept.kept_run (rf.append rs) h.genesis h.fulu tailR h.early
    obtain ⟨-, moved⟩ := kept.withdrawable i s w foundS foundP unset
    have same := congrArg UInt64.toNat (moved.resolve_left (by simp [cleanP]))
    have ordered := UInt64.le_iff_toNat_le.mp
      ((Run.invariant (Genesis.invariant h.genesis) (rf.append rs)).exitsOrdered s
        (Array.mem_of_getElem? foundS))
    have exited : s.exitEpoch.toNat ≤ (getCurrentEpoch split).toNat := by omega
    have withdrawn : s.withdrawableEpoch.toNat ≤ (getCurrentEpoch split).toNat := by omega
    have clean := (Run.retired_validator tailC h.caps.activation h.caps.compounding h.early i s u
      foundS foundC (UInt64.le_iff_toNat_le.mpr exited) cleanS
      (UInt64.le_iff_toNat_le.mpr withdrawn)).1
    simp [slashedC] at clean

/-- A key of `sc3a` is active at R or at R's next epoch.

Outside the tight window it can instead be late or pending.

In the tight window C's epoch is in the shared window, so R activates the key by then.

Outside it, an exit by R's next epoch is a slashing on R's branch, which `slashedRB` counts.

Otherwise `exitedSlashable` counts the exit.

Or the key withdraws by the finalized epoch, which C's slashing excludes.

A key that exits after R's next epoch activates after it.

Its eligibility is then late or pending. -/
private theorem sc3a_class (h : Setting config checks g split fin pulled anc counted V)
    {v : ValidatorIndex} (member : v ∈ sc3a config pulled anc fin counted split) :
    isActiveAt pulled (getCurrentEpoch pulled) v.toNat = true ∨
      isActiveAt pulled (getCurrentEpoch pulled + 1) v.toNat = true ∨
      ((pinTerms config pulled anc fin).tight = false ∧
        ((pinTerms config pulled anc fin).lateB v.toNat = true ∨
          (pinTerms config pulled anc fin).pendingRB v.toNat = true)) := by
  classical
  obtain ⟨memberSC, ⟨notRB, notX⟩, activeC⟩ := Finset.mem_filter.mp member
  obtain ⟨-, flagC, flagS⟩ := Finset.mem_filter.mp memberSC
  obtain ⟨u, foundU, slashedU⟩ : ∃ u, counted.validators.data[v.toNat]? = some u ∧
      u.slashed = true := by
    simpa [slashedFlagAt, Option.map_eq_some_iff] using flagC
  obtain ⟨s, foundS, cleanS⟩ : ∃ s, split.validators.data[v.toNat]? = some s ∧
      s.slashed = false := by
    simpa [slashedFlagAt, Option.map_eq_some_iff] using flagS
  obtain ⟨rp⟩ := h.toPulled
  obtain ⟨w, found⟩ : ∃ w, pulled.validators.data[v.toNat]? = some w :=
    ⟨_, Array.getElem?_eq_getElem (Nat.lt_of_lt_of_le (Array.getElem?_eq_some_iff.mp foundS).1
      (registryGrows_of_chainSteps rp.chainSteps))⟩
  obtain ⟨finSplit, called, later, near, below, farNat, succNat, finCur⟩ := setting_epochs h
  have rActive : ∀ e : Epoch, isActiveAt pulled e v.toNat = true ↔
      (w.activationEpoch.toNat ≤ e.toNat ∧ e.toNat < w.exitEpoch.toNat) := by
    intro e
    simp [isActiveAt, found, isActiveValidator, UInt64.le_iff_toNat_le, UInt64.lt_iff_toNat_lt]
  by_cases tight : (pinTerms config pulled anc fin).tight = true
  · -- In the tight window C's epoch is in the shared window, so R activates the key by then.
    have bound := (tight_iff config pulled anc fin).mp tight
    have shared := activity_shared h (e := getCurrentEpoch counted) (by omega) v.toNat
    have atR := shared.trans activeC
    by_cases same : (getCurrentEpoch counted).toNat = (getCurrentEpoch pulled).toNat
    · rw [UInt64.toNat_inj.mp same] at atR
      exact .inl atR
    · rw [show getCurrentEpoch counted = getCurrentEpoch pulled + 1 from
        UInt64.toNat_inj.mp (by rw [succNat]; omega)] at atR
      exact .inr (.inl atR)
  · have loose : (pinTerms config pulled anc fin).tight = false := by simpa using tight
    have bound : anc.finalizedCheckpoint.epoch.toNat + preset.MAX_SEED_LOOKAHEAD.toNat <
        (getCurrentEpoch pulled).toNat + 1 := by
      have := mt (tight_iff config pulled anc fin).mpr tight
      omega
    by_cases aR : isActiveAt pulled (getCurrentEpoch pulled) v.toNat = true
    · exact .inl aR
    by_cases aR1 : isActiveAt pulled (getCurrentEpoch pulled + 1) v.toNat = true
    · exact .inr (.inl aR1)
    refine .inr (.inr ⟨loose, ?_⟩)
    have notR1 := mt (rActive _).mpr aR1
    by_cases exited : w.exitEpoch.toNat ≤ (getCurrentEpoch pulled).toNat + 1
    · -- An exit by R's next epoch is held by a slashing, or by `exitedSlashable`.
      exfalso
      by_cases slashedW : w.slashed = true
      · exact notRB (slashedRB_of_newly_slashed h foundS found cleanS slashedW)
      · have cleanW : w.slashed = false := by simpa using slashedW
        have settled : w.withdrawableEpoch.toNat ≤ anc.finalizedCheckpoint.epoch.toNat := by
          by_contra late
          apply notX
          simp only [PinTerms.exitedSlashable, found, Option.map_some, Option.getD_some, cleanW,
            Option.any_some]
          simp
          omega
        exact sc3a_unwithdrawn h foundS found foundU cleanS slashedU cleanW settled
    · -- The key activates after R's next epoch.
      have afterA : (getCurrentEpoch pulled).toNat + 1 < w.activationEpoch.toNat := by
        by_contra early
        apply notR1
        rw [succNat]
        exact ⟨by omega, by omega⟩
      exact late_or_pending h found bound afterA

/-- The charged keys of `SC` are current, upcoming-only, late or pending, and each pays that entry.

A key of `SC` outside the tight window that is late or pending pays its stake and its rise there.

A key is active at R, or active at the next epoch only.

Otherwise its activation is past the delay, or its eligibility is past the epoch.

In the tight window the last two cases are empty. -/
private theorem sc_3a_split (h : Setting config checks g split fin pulled anc counted V) :
    ∑ v ∈ sc3a config pulled anc fin counted split,
        ((pinTerms config pulled anc fin).rise v.toNat +
          (if (pinTerms config pulled anc fin).tight = false ∧
              (pinTerms config pulled anc fin).lateB v.toNat = true then
            3 * balanceAt pulled v.toNat +
              3 * ((balanceAt fin v.toNat - balanceAt pulled v.toNat -
                (pinTerms config pulled anc fin).rise v.toNat +
                ((parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat - 1)) /
                (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat) else 0) +
          (if (pinTerms config pulled anc fin).tight = false ∧
              (pinTerms config pulled anc fin).pendingRB v.toNat = true then
            balanceAt pulled v.toNat +
              3 * ((balanceAt fin v.toNat - balanceAt pulled v.toNat -
                (pinTerms config pulled anc fin).rise v.toNat +
                ((parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat - 1)) /
                (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat) else 0)) ≤
      (∑ v ∈ (sc3a config pulled anc fin counted split) with
        (pinTerms config pulled anc fin).current v.toNat = true,
          (pinTerms config pulled anc fin).rise v.toNat) +
      (∑ v ∈ (sc3a config pulled anc fin counted split) with
        (isActiveAt pulled (getCurrentEpoch pulled) v.toNat = false ∧
          isActiveAt pulled (getCurrentEpoch pulled + 1) v.toNat = true),
        (pinTerms config pulled anc fin).rise v.toNat) +
      (∑ v ∈ (sc3a config pulled anc fin counted split) with
        ((pinTerms config pulled anc fin).tight = false ∧
          (pinTerms config pulled anc fin).lateB v.toNat = true),
        (3 * eR pulled v + (pinTerms config pulled anc fin).rise v.toNat +
          3 * ((balanceAt fin v.toNat - balanceAt pulled v.toNat -
            (pinTerms config pulled anc fin).rise v.toNat +
            ((parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat - 1)) /
            (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat))) +
      (∑ v ∈ (sc3a config pulled anc fin counted split) with
        ((pinTerms config pulled anc fin).tight = false ∧
          (pinTerms config pulled anc fin).pendingRB v.toNat = true),
        (eR pulled v + (pinTerms config pulled anc fin).rise v.toNat +
          3 * ((balanceAt fin v.toNat - balanceAt pulled v.toNat -
            (pinTerms config pulled anc fin).rise v.toNat +
            ((parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat - 1)) /
            (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat))) := by
  classical
  simp only [Finset.sum_filter, ← Finset.sum_add_distrib]
  refine Finset.sum_le_sum fun v member => ?_
  have cls := sc3a_class h member
  have current : (pinTerms config pulled anc fin).current v.toNat =
      isActiveAt pulled (getCurrentEpoch pulled) v.toNat := rfl
  rw [current]
  unfold eR
  have arith : ∀ (r b c : ℕ) (C U L P : Prop) [Decidable C] [Decidable U] [Decidable L]
      [Decidable P], (C ∨ U ∨ L ∨ P) →
      r + (if L then 3 * b + 3 * c else 0) + (if P then b + 3 * c else 0) ≤
        (if C then r else 0) + (if U then r else 0) + (if L then 3 * b + r + 3 * c else 0) +
          (if P then b + r + 3 * c else 0) := by
    intro r b c C U L P _ _ _ _ cover
    by_cases hC : C <;> by_cases hU : U <;> by_cases hL : L <;> by_cases hP : P <;>
      simp [hC, hU, hL, hP] at cover ⊢ <;> omega
  refine arith _ _ _ _ _ _ _ ?_
  by_cases hC : isActiveAt pulled (getCurrentEpoch pulled) v.toNat = true
  · exact .inl hC
  · have hC' : isActiveAt pulled (getCurrentEpoch pulled) v.toNat = false := by simpa using hC
    by_cases hU : isActiveAt pulled (getCurrentEpoch pulled + 1) v.toNat = true
    · exact .inr (.inl ⟨hC', hU⟩)
    · rcases cls with c | u | ⟨t, l | p⟩
      · exact absurd c hC
      · exact absurd u hU
      · exact .inr (.inr (.inl ⟨t, l⟩))
      · exact .inr (.inr (.inr ⟨t, p⟩))

/-- The whistleblower reward of the keys of `SC` that R slashes, at R's effective balance and rise.

Each key reads the quotient of its balance and rise, and the quotient of an increment rounded up.

`bud_branchR` pays it and `bud_whistle_of` charges it. -/
private def scSlashedReward (config : Config)
    (pulled anc fin counted split : BeaconState preset fork) : ℕ :=
  ∑ v ∈ (SC pulled counted split).filter
      (fun v => (pinTerms config pulled anc fin).slashedRB v.toNat = true),
    (max (balanceAt pulled v.toNat + (pinTerms config pulled anc fin).rise v.toNat)
        (balanceAt fin v.toNat) /
        (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat +
      (preset.EFFECTIVE_BALANCE_INCREMENT.toNat +
          (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat - 1) /
        (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat)

/-- A key off the kept arm rises by its whole headroom to the largest cap.

Within the withdrawal delay, the kept arm fails only at the gain test, which `lowRate` repeats.

So `capFor` reads the largest cap. -/
private theorem rise_of_notKept (h : Setting config checks g split fin pulled anc counted V) (i : ℕ)
    (notKept : ¬ (pinTerms config pulled anc fin).keptArm i = true) :
    (pinTerms config pulled anc fin).rise i =
      preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat - balanceAt pulled i := by
  have shallow := h.shallow
  unfold pinTerms at notKept ⊢
  simp only at notKept ⊢
  rw [ite_eq_right notKept]
  simp only [Bool.and_eq_true, decide_eq_true_eq, not_and] at notKept
  rw [ite_eq_right]
  intro low
  exact notKept shallow (of_decide_eq_true (Bool.and_eq_true_iff.mp low).2)

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- A key that a run from the finalized state creates has a first state on the run.

At that state its effective balance is within the floor of its balance, and it is unslashed.

Before it the key is absent from the path, so its effective balance is zero.

A state of the run that lacks the key is no later than the first state.

A step that appends a key leaves it unassigned, so the first state is where the key is created. -/
private theorem created_first_state (h : Setting config checks g split fin pulled anc counted V)
    {e : BeaconState preset fork} (run : Run config checks ⟨fork, fin⟩ ⟨fork, e⟩)
    {v : ValidatorIndex} (created : fin.validators.data.size ≤ v.toNat)
    (inside : v.toNat < e.validators.data.size) :
    ∃ (c : BeaconState preset fork) (toC : Run config checks ⟨fork, fin⟩ ⟨fork, c⟩)
      (fromC : Run config checks ⟨fork, c⟩ ⟨fork, e⟩), toC.append fromC = run ∧
      v.toNat < c.validators.data.size ∧
      (∀ u, c.validators.data[v.toNat]? = some u → u.slashed = false) ∧
      (∀ p ∈ toC.balancePath, p = ⟨fork, c⟩ ∨ effectiveAt p v.toNat = 0) ∧
      effectiveAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat ≤
        actualBalanceAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat -
          actualBalanceAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat %
            preset.EFFECTIVE_BALANCE_INCREMENT.toNat ∧
      ∀ (d : BeaconState preset fork) (toD : Run config checks ⟨fork, fin⟩ ⟨fork, d⟩)
        (restD : Run config checks ⟨fork, d⟩ ⟨fork, e⟩), toD.append restD = run →
        ¬ v.toNat < d.validators.data.size →
        (getCurrentEpoch d).toNat ≤ (getCurrentEpoch c).toNat := by
  classical
  obtain ⟨toFin⟩ := h.toFin
  -- the first state of the run that holds the key
  obtain ⟨m, n, pre0, step, post0, cutFlip, absentM, presentN⟩ := Run.split_at_flip run
    (fun s : ForkedBeaconState preset => v.toNat < s.state.validators.data.size)
    (by simpa using created) inside
  have forkN : fork = n.fork := (fork_eq_of_run (pre0.snoc step) post0 (Nat.le_refl _)).symm
  have electra : .pectra ≤ m.fork :=
    Nat.le_trans (Nat.le_trans (by decide) h.fulu) (fork_le_of_chainSteps pre0.chainSteps)
  obtain ⟨fork, ns⟩ := n
  subst forkN
  simp only at presentN
  have sizeM : ¬ v.toNat < m.state.validators.data.size := absentM
  obtain ⟨vn, foundN⟩ : ∃ vn, ns.validators.data[v.toNat]? = some vn :=
    ⟨_, Array.getElem?_eq_getElem presentN⟩
  -- a step that appends the key leaves it unassigned, so it is funded and unslashed there
  obtain ⟨far, -⟩ := Step.new_validators_unassigned step h.early electra v.toNat vn
    (Nat.le_of_not_lt sizeM) foundN
  have finite : getCurrentEpoch ns < FAR_FUTURE_EPOCH :=
    UInt64.lt_iff_toNat_lt.mpr (by
      have := getCurrentEpoch_succ_lt_farFuture h.twoSlots ns
      omega)
  obtain ⟨unassigned, -⟩ := EthLib.Consensus.Internal.run_eligible_balance
    (toFin.append (pre0.snoc step)) h.genesis h.caps.activation h.caps.compounding h.aligned
    h.early finite
  obtain ⟨⟨b, foundB, le⟩, -, clean⟩ := unassigned v.toNat vn foundN far
  -- the key is absent at each state of the path before the first state
  have before : ∀ p ∈ (pre0.snoc step).balancePath, p = ⟨fork, ns⟩ ∨ effectiveAt p v.toNat = 0 := by
    intro p member
    obtain ⟨r1, r2, cutP⟩ := balancePath_endpoint (pre0.snoc step)
      (Run.nil : Run config checks ⟨fork, ns⟩ ⟨fork, ns⟩) (Nat.le_refl _) member
    rcases Run.prefix_snoc r1 r2 pre0 step cutP with ⟨same, joined⟩ | ⟨r', cutR⟩
    · exact Or.inl same
    · refine Or.inr ?_
      have grows := registryGrows_of_chainSteps r'.chainSteps
      have absent : p.state.validators.data[v.toNat]? = none :=
        Array.getElem?_eq_none (by omega)
      simp [effectiveAt, absent]
  refine ⟨ns, pre0.snoc step, post0, cutFlip.symm, presentN, fun u found => ?_, before, ?_, ?_⟩
  · rw [foundN] at found
    cases found
    exact clean
  · -- the effective balance of a key within its balance is within the floor of the balance
    have aligned := FloorTrace.effective_aligned (toFin.append (pre0.snoc step)) h.genesis
      h.aligned v.toNat
    have within : effectiveAt (⟨fork, ns⟩ : ForkedBeaconState preset) v.toNat ≤
        actualBalanceAt (⟨fork, ns⟩ : ForkedBeaconState preset) v.toNat := by
      simp only [effectiveAt, actualBalanceAt, foundN, foundB, Option.map_some, Option.getD_some]
      exact UInt64.le_iff_toNat_le.mp le
    have rounded := rounded_mono preset.EFFECTIVE_BALANCE_INCREMENT.toNat within
    rw [aligned] at rounded
    simpa using rounded
  · -- a state without the key is before the first state, since the registry only grows
    intro d toD restD cutD absentD
    rcases Run.prefix_total toD restD (pre0.snoc step) post0 cutD cutFlip.symm with
      ⟨r, -⟩ | ⟨r, -⟩
    · exact UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps r.chainSteps)
    · exact absurd (Nat.lt_of_lt_of_le presentN (registryGrows_of_chainSteps r.chainSteps)) absentD

/-- A key's effective balance at a state of a run is at most the largest on the run's balance path.

The state is the end of a prefix of the run, so the path holds it. -/
private theorem effective_le_foldl_max {x y : ForkedBeaconState preset}
    (run : Run config checks x y) (i : ℕ) {m : ForkedBeaconState preset}
    (pre : Run config checks x m) (post : Run config checks m y) (cut : pre.append post = run) :
    effectiveAt m i ≤ (run.balancePath.map fun z => effectiveAt z i).foldl max 0 := by
  obtain ⟨front, atEnd⟩ := Run.balancePath_last pre
  have path := Run.balancePath_append pre post
  rw [cut] at path
  have member : m ∈ run.balancePath := by
    rw [path, atEnd]
    simp
  have mapped : effectiveAt m i ∈ run.balancePath.map fun z => effectiveAt z i :=
    List.mem_map.mpr ⟨_, member, rfl⟩
  rw [List.foldl_max_eq_max (List.ne_nil_of_mem mapped)]
  exact Nat.le_trans (List.le_max_of_mem mapped) (Nat.le_max_right _ _)

/-- A key's slashing slack and the downward band fit an increment. -/
private theorem slashW_add_downwardBand_le
    (h : Setting config checks g split fin pulled anc counted V) (i : ℕ) :
    slashW (pinTerms config pulled anc fin) i + preset.downwardBand ≤
      preset.EFFECTIVE_BALANCE_INCREMENT.toNat := by
  unfold slashW; split <;> first | exact h.facts.slashBand | simpa using h.facts.below.le

/-- A replay of a run that ends by R's epoch, read at R's epoch.

The horizon of the replay does not change the events of such a run. -/
private theorem replay_at_pulled (pulled : BeaconState preset fork)
    {u w : ForkedBeaconState preset} (run : Run config checks u w) (high : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    (ending : getCurrentEpoch w.state ≤ getCurrentEpoch pulled)
    {events : List (BalanceEvent preset)} (replayed : run.balanceEvents high = .ok events) :
    run.balanceEvents (getCurrentEpoch pulled).toNat = .ok events := by
  have endingNat := UInt64.le_iff_toNat_le.mp ending
  rw [DirectSafety.Apriori.Internal.balanceEvents_eq_of_endpoint_le run (localHigh := high)
    (by omega) (by omega)]
  exact replayed

/-- The pin's `high` of a key, with its depth and its due partials read out. -/
private theorem high_eq (config : Config) (pulled anc fin : BeaconState preset fork)
    (electra : .pectra ≤ fork) (i : ℕ) :
    (pinTerms config pulled anc fin).high i =
      actualBalanceAt (⟨fork, pulled⟩ : ForkedBeaconState preset) i +
        ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) *
          ((11 * (pinTerms config pulled anc fin).gainRate i + 9) / 10 + 3 +
            (pinTerms config pulled anc fin).leak i) +
        (PinTerms.dueAmount fin electra i ((getCurrentEpoch pulled).toNat + 1) -
          PinTerms.dueAmount pulled electra i ((getCurrentEpoch pulled).toNat + 1)) := by
  dsimp only [pinTerms]
  simp only [electra, ↓reduceDIte]
  rfl

/-- The leak at a key's largest effective balance on a run is the pin's leak and its induced leak.

The key is not withdrawable at R's next epoch, so `inducedR` charges the difference. -/
private theorem leakAt_foldl_le (config : Config) (pulled anc fin : BeaconState preset fork)
    {x y : ForkedBeaconState preset} (run : Run config checks x y) (i : ℕ)
    (notWithdrawn : (pinTerms config pulled anc fin).withdrawnRB i = false) :
    (pinTerms config pulled anc fin).depthFin * (pinTerms config pulled anc fin).leakAt
        ((run.balancePath.map fun z => effectiveAt z i).foldl max 0) i ≤
      (pinTerms config pulled anc fin).depthFin * (pinTerms config pulled anc fin).leak i +
        inducedR (pinTerms config pulled anc fin) run i := by
  rw [inducedR_of_not_withdrawn _ _ _ notWithdrawn, ← Nat.mul_add]
  exact Nat.mul_le_mul_left _ (by
    show _ ≤ (pinTerms config pulled anc fin).leakAt ((pinTerms config pulled anc fin).ebUp i) i + _
    omega)

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The balance of a cut key at the split is bounded from an anchor state of R's run that holds it.

The key is slashed on R's branch.

`floor` is the floor of its balance from each state after the anchor.

The floors give a ceiling on its balance along the run.

The ceiling bounds its effective balance at the split, up to a downward band.

The slash and the band fit one increment.

With a sync debit the rounding of `H` adds a second increment.

Without one nothing is induced, since the effective balance stays within `ebUp`.

`pathEnv` holds that bound before the anchor.

`start` bounds the anchor by its balance when the anchor is no earlier than the split's epoch. -/
private theorem cut_balance_core (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩) (high : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    {eventsF events : List (BalanceEvent preset)}
    (replayedF : fromFin.balanceEvents high = .ok eventsF)
    (replayed : tail.balanceEvents high = .ok events)
    (v : ValidatorIndex)
    (hW : slashW (pinTerms config pulled anc fin) v.toNat <
      preset.EFFECTIVE_BALANCE_INCREMENT.toNat)
    {c : BeaconState preset fork} (toC : Run config checks ⟨fork, fin⟩ ⟨fork, c⟩)
    (fromC : Run config checks ⟨fork, c⟩ ⟨fork, split⟩) (cutC : toC.append fromC = fromFin)
    (insideC : v.toNat < c.validators.data.size)
    (floor : ∀ {zs : BeaconState preset fork} (_ : Run config checks ⟨fork, c⟩ ⟨fork, zs⟩)
      (r2 : Run config checks ⟨fork, zs⟩ ⟨fork, pulled⟩) {evs : List (BalanceEvent preset)},
      r2.balanceEvents (getCurrentEpoch pulled).toNat = .ok evs →
      min (actualBalanceAt (⟨fork, zs⟩ : ForkedBeaconState preset) v.toNat)
          (PinTerms.capAt (⟨fork, zs⟩ : ForkedBeaconState preset) v.toNat) ≤
        actualBalanceAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat +
          (evs.map (penaltyDebit v.toNat)).sum + (evs.map (syncDebit v.toNat)).sum +
          (evs.map (floorPartialDebit v)).sum + slashW (pinTerms config pulled anc fin) v.toNat)
    (start : (getCurrentEpoch split).toNat ≤ (getCurrentEpoch c).toNat →
      effectiveAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat ≤
        actualBalanceAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat + preset.downwardBand)
    (startEnv : (effectiveAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat ≤
        (pinTerms config pulled anc fin).ebUp v.toNat ∧
        effectiveAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat ≤ balanceAt fin v.toNat) ∨
      effectiveAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat ≤
        actualBalanceAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat -
          actualBalanceAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat %
            preset.EFFECTIVE_BALANCE_INCREMENT.toNat)
    (pathEnv : ∀ p ∈ toC.balancePath, p ≠ ⟨fork, c⟩ → effectiveAt p v.toNat ≤
      (pinTerms config pulled anc fin).ebUp v.toNat)
    (notWithdrawn : (pinTerms config pulled anc fin).withdrawnRB v.toNat = false) :
    balanceAt split v.toNat ≤ balanceAt pulled v.toNat +
      (pinTerms config pulled anc fin).rise v.toNat + preset.EFFECTIVE_BALANCE_INCREMENT.toNat +
      (if 0 < syncD eventsF v.toNat + syncD events v.toNat then
        preset.EFFECTIVE_BALANCE_INCREMENT.toNat else 0) +
      (syncD eventsF v.toNat + syncD events v.toNat +
        inducedR (pinTerms config pulled anc fin) (fromFin.append tail) v.toNat) := by
  classical
  obtain ⟨toFin⟩ := h.toFin
  obtain ⟨toPulled⟩ := h.toPulled
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  have capSplit : PinTerms.capAt (⟨fork, split⟩ : ForkedBeaconState preset) v.toNat ≤
      PinTerms.capAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat :=
    cap_le_cap_of_run h.caps toPulled h.early v.toNat
  -- the largest effective balance on R's run
  obtain ⟨M, hM⟩ : ∃ M, M = ((fromFin.append tail).balancePath.map
      fun z => effectiveAt z v.toNat).foldl max 0 := ⟨_, rfl⟩
  obtain ⟨Df, hDf⟩ : ∃ Df, Df = (getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat :=
    ⟨_, rfl⟩
  obtain ⟨W, hWdef⟩ : ∃ W, W = slashW (pinTerms config pulled anc fin) v.toNat := ⟨_, rfl⟩
  -- the ceiling on the balance at each state of the run from the anchor
  obtain ⟨Bc, hBc⟩ : ∃ Bc, Bc = actualBalanceAt (⟨fork, pulled⟩ : ForkedBeaconState preset)
        v.toNat + (Df * (pinTerms config pulled anc fin).leakAt M v.toNat +
          (PinTerms.dueAmount fin electra v.toNat ((getCurrentEpoch pulled).toNat + 1) -
            PinTerms.dueAmount pulled electra v.toNat ((getCurrentEpoch pulled).toNat + 1))) +
      ((eventsF.map (syncDebit v.toNat)).sum + (events.map (syncDebit v.toNat)).sum + W) :=
    ⟨_, rfl⟩
  have ceil : ∀ z ∈ fromC.balancePath,
      min (actualBalanceAt z v.toNat) (PinTerms.capAt z v.toNat) ≤ Bc := by
    intro z member
    have inFull : z ∈ (fromC.append tail).balancePath := by
      rw [Run.balancePath_append]
      exact List.mem_append_left _ member
    have := path_ceiling h fromFin tail high endEpoch replayedF replayed v W M
      (fun pre post cut => hM ▸ effective_le_foldl_max (fromFin.append tail) v.toNat pre post cut)
      toC fromC cutC insideC
      (fun {_} r1 r2 _ {evs} ev => by
        have ev' := replay_at_pulled pulled r2 high endEpoch (UInt64.le_refl _) ev
        rw [hWdef]
        exact floor r1 r2 ev') z inFull
    rw [hBc, hDf]
    omega
  have capped : ∀ z ∈ fromC.balancePath, effectiveAt z v.toNat ≤ PinTerms.capAt z v.toNat := by
    intro z member
    obtain ⟨zs, rfl, ⟨r1⟩, -⟩ := balancePath_state fromC member
    exact effective_le_cap_at (toFin.append (toC.append r1)) h.genesis h.caps h.early v.toNat
  have capCeil : ∀ z ∈ fromC.balancePath,
      PinTerms.capAt z v.toNat ≤ PinTerms.capAt (⟨fork, pulled⟩ : ForkedBeaconState preset)
        v.toNat := by
    intro z member
    obtain ⟨zs, rfl, -, ⟨r2⟩⟩ := balancePath_state fromC member
    exact Nat.le_trans (cap_le_cap_of_run h.caps r2 h.early v.toNat) capSplit
  obtain ⟨-, sameC, afterC, -⟩ := effective_ceiling_flip h fromC
    (Run.invariant h.genesis.invariant (toFin.append toC)) v.toNat insideC Bc
    (PinTerms.capAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat) capped capCeil ceil
  -- the effective balance at the split is within a downward band of the ceiling
  have ebBound : balanceAt split v.toNat ≤ Bc + preset.downwardBand := by
    by_cases flat : (getCurrentEpoch split).toNat ≤ (getCurrentEpoch c).toNat
    · have eq := sameC flat
      have startB := start flat
      have atC := ceil ⟨fork, c⟩ (by
        obtain ⟨front, atHead⟩ := Run.balancePath_head fromC
        rw [atHead]
        exact List.mem_cons_self)
      have capAtC := effective_le_cap_at (toFin.append toC) h.genesis h.caps h.early v.toNat
      change effectiveAt (⟨fork, split⟩ : ForkedBeaconState preset) v.toNat ≤ _
      omega
    · exact afterC (by omega)
  have hdf : (pinTerms config pulled anc fin).depthFin = Df := by rw [hDf]; rfl
  obtain ⟨H, hH⟩ : ∃ H, H = (pinTerms config pulled anc fin).high v.toNat :=
    ⟨_, rfl⟩
  obtain ⟨q, hq⟩ : ∃ q, q = (pinTerms config pulled anc fin).gainRate v.toNat := ⟨_, rfl⟩
  have hHeq : H = actualBalanceAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat +
      Df * ((11 * q + 9) / 10 + 3 + (pinTerms config pulled anc fin).leak v.toNat) +
        (PinTerms.dueAmount fin electra v.toNat ((getCurrentEpoch pulled).toNat + 1) -
          PinTerms.dueAmount pulled electra v.toNat ((getCurrentEpoch pulled).toNat + 1)) := by
    rw [hH, hq, hDf]
    exact high_eq config pulled anc fin electra v.toNat
  obtain ⟨ind, hind⟩ : ∃ ind, ind =
      inducedR (pinTerms config pulled anc fin) (fromFin.append tail) v.toNat := ⟨_, rfl⟩
  have induced : Df * (pinTerms config pulled anc fin).leakAt M v.toNat ≤
      Df * (pinTerms config pulled anc fin).leak v.toNat + ind := by
    rw [hind, ← hdf, hM]
    exact leakAt_foldl_le config pulled anc fin (fromFin.append tail) v.toNat notWithdrawn
  have gap : Bc ≤ H + (syncD eventsF v.toNat + syncD events v.toNat + ind + W) := by
    unfold syncD
    rw [hBc, hHeq, Nat.mul_add Df _ _]
    omega
  have alignedC : balanceAt split v.toNat % preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0 :=
    FloorTrace.effective_aligned (toFin.append fromFin) h.genesis h.aligned v.toNat
  have cappedC : balanceAt split v.toNat ≤
      (pinTerms config pulled anc fin).capFor v.toNat :=
    Nat.le_trans (effective_le_cap_pulled h fromFin tail v.toNat)
      (capAt_le_capFor config pulled anc fin v.toNat (capAt_le_capMax h.caps electra v.toNat))
  have incPos : 1 < preset.EFFECTIVE_BALANCE_INCREMENT.toNat := by
    have := h.facts.incrementSize
    omega
  have bandSlash : W + preset.downwardBand ≤ preset.EFFECTIVE_BALANCE_INCREMENT.toNat := by
    rw [hWdef]
    exact slashW_add_downwardBand_le h v.toNat
  obtain ⟨s, hs⟩ : ∃ s, s = syncD eventsF v.toNat + syncD events v.toNat := ⟨_, rfl⟩
  rw [← hind, ← hs]
  by_cases kept : (pinTerms config pulled anc fin).keptArm v.toNat = true
  · rw [rise_kept config pulled anc fin v.toNat hH kept]
    have alignedLe : ∀ x, balanceAt split v.toNat ≤ x →
        balanceAt split v.toNat ≤ x - x % preset.EFFECTIVE_BALANCE_INCREMENT.toNat := fun x le => by
      have := rounded_mono preset.EFFECTIVE_BALANCE_INCREMENT.toNat le
      rw [alignedC] at this
      simpa using this
    have maxH := Nat.le_max_right (balanceAt fin v.toNat)
      (H - H % preset.EFFECTIVE_BALANCE_INCREMENT.toNat)
    have roundH := rounded_mono preset.EFFECTIVE_BALANCE_INCREMENT.toNat
      (Nat.le_add_right H preset.downwardBand)
    by_cases sync : 0 < s
    · have bound : balanceAt split v.toNat ≤
          H + (s + ind + preset.EFFECTIVE_BALANCE_INCREMENT.toNat) := by
        omega
      have first := alignedLe _ bound
      have second := round_add_le (inc := preset.EFFECTIVE_BALANCE_INCREMENT.toNat) (x := H)
        (S := s + ind + preset.EFFECTIVE_BALANCE_INCREMENT.toNat)
        (U := preset.EFFECTIVE_BALANCE_INCREMENT.toNat - 1) (by omega)
        (Or.inr (Or.inl (by omega)))
      rw [ite_eq_left sync]
      omega
    · have s0 : s = 0 := by omega
      have sums : (eventsF.map (syncDebit v.toNat)).sum + (events.map (syncDebit v.toNat)).sum =
          0 := by
        unfold syncD at hs
        omega
      -- with no sync debit the effective balances stay within `ebUp`, so nothing is induced
      have env := prefix_envelope h fromFin tail high endEpoch replayedF replayed v toC
        (fromC.append tail) (by rw [Run.append_assoc, cutC]) insideC W startEnv
        (fun {zs} pre after cutR {evs} ev => by
          have ev' := replay_at_pulled pulled after high endEpoch (UInt64.le_refl _) ev
          rw [hWdef]
          exact floor pre after ev')
      have memberSplit : (⟨fork, split⟩ : ForkedBeaconState preset) ∈
          (fromFin.append tail).balancePath := by
        obtain ⟨front, atEnd⟩ := Run.balancePath_last fromFin
        rw [Run.balancePath_append, atEnd]
        simp
      have M0 : M ≤ (pinTerms config pulled anc fin).ebUp v.toNat := by
        have mapped : effectiveAt (⟨fork, split⟩ : ForkedBeaconState preset) v.toNat ∈
            (fromFin.append tail).balancePath.map fun z => effectiveAt z v.toNat :=
          List.mem_map.mpr ⟨_, memberSplit, rfl⟩
        rw [hM, List.foldl_max_eq_max (List.ne_nil_of_mem mapped)]
        refine Nat.max_le.2 ⟨Nat.zero_le _, (List.max_le_iff (List.ne_nil_of_mem mapped)).2 ?_⟩
        intro x hx
        obtain ⟨z, hz, rfl⟩ := List.mem_map.mp hx
        have full : z ∈ (toC.append (fromC.append tail)).balancePath := by
          rw [Run.append_assoc, cutC]
          exact hz
        rw [Run.balancePath_append] at full
        rcases List.mem_append.mp full with front | later
        · by_cases atC : z = ⟨fork, c⟩
          · subst atC
            have e := env _ (by
              obtain ⟨rest, atHead⟩ := Run.balancePath_head (fromC.append tail)
              rw [atHead]
              exact List.mem_cons_self)
            rw [sums, Nat.div_eq_of_lt
              (by omega : 0 + W < preset.EFFECTIVE_BALANCE_INCREMENT.toNat),
              Nat.mul_zero, Nat.add_zero] at e
            exact e
          · exact pathEnv z front atC
        · have e := env z (List.mem_of_mem_tail later)
          rw [sums, Nat.div_eq_of_lt (by omega : 0 + W < preset.EFFECTIVE_BALANCE_INCREMENT.toNat),
            Nat.mul_zero, Nat.add_zero] at e
          exact e
      have ind0 : ind = 0 := by
        rw [hind, inducedR_of_not_withdrawn _ _ _ notWithdrawn]
        rw [← hM, Nat.sub_eq_zero_of_le (leakAt_mono config pulled anc fin v.toNat M0),
          Nat.mul_zero]
      have zeroMod : (balanceAt split v.toNat - preset.EFFECTIVE_BALANCE_INCREMENT.toNat) %
          preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0 :=
        Nat.sub_mod_eq_zero_of_mod_eq (by rw [alignedC, Nat.mod_self])
      have rounded := rounded_mono preset.EFFECTIVE_BALANCE_INCREMENT.toNat
        (show balanceAt split v.toNat - preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤ H by omega)
      rw [zeroMod, Nat.sub_zero] at rounded
      rw [ite_eq_right (by omega : ¬ 0 < s)]
      omega
  · have headroom := rise_of_notKept h v.toNat kept
    have capped : balanceAt split v.toNat ≤ preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat :=
      PinSeatDebits.effectiveAt_le_capMax (toFin.append fromFin) h.genesis h.caps h.early v.toNat
    have cappedR : balanceAt pulled v.toNat ≤ preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat :=
      PinSeatDebits.effectiveAt_le_capMax (toFin.append (fromFin.append tail)) h.genesis h.caps
        h.early v.toNat
    omega

/-- A key that the shared run slashes is bounded by its finalized balance or by R's balance.

The bound by R's balance reads its rise, one increment and the debits and induced leak.

A second increment pays the rounding of the balance when it has a sync debit.

The balance at the split is the key's effective balance at the epoch start, up to the downward band.

A queued partial paid before the finalized state leaves the balance at the finalized one.

Otherwise R's tail takes its penalties and sync debits, and the leak that `rise` reads covers them.

The cut-key part of `bud_branchR`'s body reads the quotient of this bound.

It reads it for each key of `cut_whistle`'s set, and pays the rounding with the debits. -/
private theorem cut_balance_le (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩) (high : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    {eventsF events : List (BalanceEvent preset)}
    (replayedF : fromFin.balanceEvents high = .ok eventsF)
    (replayed : tail.balanceEvents high = .ok events)
    (v : ValidatorIndex) (member : v ∈ cutKeys config pulled anc fin split) :
    balanceAt split v.toNat ≤ max (balanceAt fin v.toNat)
      (balanceAt pulled v.toNat + (pinTerms config pulled anc fin).rise v.toNat +
        preset.EFFECTIVE_BALANCE_INCREMENT.toNat +
        (if 0 < syncD eventsF v.toNat + syncD events v.toNat then
          preset.EFFECTIVE_BALANCE_INCREMENT.toNat else 0) +
        (syncD eventsF v.toNat + syncD events v.toNat +
          inducedR (pinTerms config pulled anc fin) (fromFin.append tail) v.toNat)) := by
  classical
  obtain ⟨-, flagS, rb, frozenFlag⟩ := Finset.mem_filter.mp member
  have rb' := rb
  rw [slashedRB_eq] at rb'
  obtain ⟨wP, foundP⟩ : ∃ wP, pulled.validators.data[v.toNat]? = some wP := by
    cases f : pulled.validators.data[v.toNat]? with
    | none => simp [f] at rb'
    | some w => exact ⟨w, rfl⟩
  have slashedP : wP.slashed = true := by simpa [foundP] using (of_decide_eq_true rb').1
  have frozen : (getCurrentEpoch fin).toNat + preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat ≤
      wP.withdrawableEpoch.toNat := by
    simpa [foundP] using frozenFlag
  have half := depthFin_lt_half h
  have finSplit : (getCurrentEpoch fin).toNat ≤ (getCurrentEpoch split).toNat :=
    UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps fromFin.chainSteps)
  have called := UInt64.le_iff_toNat_le.mp h.called
  have late : (getCurrentEpoch pulled).toNat + 1 < wP.withdrawableEpoch.toNat := by
    omega
  have notWithdrawn : (pinTerms config pulled anc fin).withdrawnRB v.toNat = false := by
    simp only [pinTerms, foundP, Option.any_some, decide_eq_false_iff_not]
    omega
  have hWdb := slashW_add_downwardBand_le h v.toNat
  have hW : slashW (pinTerms config pulled anc fin) v.toNat <
      preset.EFFECTIVE_BALANCE_INCREMENT.toNat := by
    have := h.facts.bandLow
    have := h.facts.incrementSize
    omega
  by_cases inFin : v.toNat < fin.validators.data.size
  · by_cases flat : (getCurrentEpoch split).toNat ≤ (getCurrentEpoch fin).toNat
    · have sameE : getCurrentEpoch split = getCurrentEpoch fin :=
        UInt64.toNat_inj.mp (by omega)
      exact le_max_of_le_left
        (run_same_epoch_effective fromFin h.early sameE v.toNat inFin).le
    · refine le_max_of_le_right (cut_balance_core h fromFin tail high endEpoch replayedF replayed
        v hW (Run.nil : Run config checks ⟨fork, fin⟩ ⟨fork, fin⟩) fromFin
        (run_nil_append fromFin) inFin ?_ (fun hle => absurd hle flat)
        (Or.inl ⟨effective_fin_le_ebUp h v.toNat, Nat.le_refl _⟩)
        (fun p hp ne => by
          have : p = ⟨fork, fin⟩ := by simpa [Run.balancePath] using hp
          exact absurd this ne) notWithdrawn)
      obtain ⟨u, foundU⟩ : ∃ u, fin.validators.data[v.toNat]? = some u :=
        ⟨_, Array.getElem?_eq_getElem inFin⟩
      by_cases sl : u.slashed = true
      · intro r1 r2 evs ev
        have := slash_floor_from_slashed h v inFin
          (fun u' fu' => by
            rw [foundU] at fu'
            cases fu'
            exact sl) wP foundP frozen late r1 r2 ev
        omega
      · intro r1 r2 evs ev
        exact slash_floor_across h v (Run.nil : Run config checks ⟨fork, fin⟩ ⟨fork, fin⟩) inFin
          (fun u' fu' => by
            rw [foundU] at fu'
            cases fu'
            simpa using sl) wP foundP slashedP rb r1 r2 ev
  · -- a key created after the finalized state is anchored at the first state that holds it
    have first := created_first_state h fromFin (v := v) (by omega) (by
      cases f : split.validators.data[v.toNat]? with
      | none => simp [f] at flagS
      | some u => exact (Array.getElem?_eq_some_iff.mp f).1)
    obtain ⟨c, toC, fromC, cutC, insideC, clean, before, startEB, -⟩ := first
    have incPos := h.bands.1
    have remainder := Nat.mod_le (actualBalanceAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat)
      preset.EFFECTIVE_BALANCE_INCREMENT.toNat
    refine le_max_of_le_right (cut_balance_core h fromFin tail high endEpoch replayedF replayed v hW
      toC fromC cutC insideC ?_ (fun _ => by omega) (Or.inr startEB)
      (fun p hp ne => by
        rcases before p hp with eq | zero
        · exact absurd eq ne
        · rw [zero]
          exact Nat.zero_le _) notWithdrawn)
    intro zs r1 r2 evs ev
    exact slash_floor_across h v toC insideC clean wP foundP slashedP rb r1 r2 ev

/-- A replay inside one epoch whose steps all start past the cutoff records no event.

The run starts at `b`, so each of its steps starts at the epoch of `b` or later.

No landed lemma states this, so `cut_whistle` reads it here, for a cutoff before that epoch. -/
private theorem balanceEvents_late {f : Fork} {b : BeaconState preset f}
    {y : ForkedBeaconState preset} (tail : Run config checks ⟨f, b⟩ y)
    (early : y.fork < .glamsterdam) (same : getCurrentEpoch y.state = getCurrentEpoch b)
    {high : ℕ} (late : high + 1 < (getCurrentEpoch b).toNat) :
    tail.balanceEvents high = .ok [] := by
  refine Run.induction_of_same_epoch (fun _ r => r.balanceEvents high = .ok []) rfl ?_ ?_ tail
    early same
  · intro _ s _ _ _ _ _ pre _ prior
    have started : (getCurrentEpoch b).toNat ≤ (getCurrentEpoch s).toNat :=
      UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps pre.chainSteps)
    have skipped : ¬ (getCurrentEpoch s).toNat ≤ high + 1 := by omega
    simp [Run.balanceEvents, prior, skipped, pure, Except.pure, bind, Except.bind]
  · intro middle _ _ _ pre _ _ _ _ prior
    have started : (getCurrentEpoch b).toNat ≤ (getCurrentEpoch middle.state).toNat :=
      UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps pre.chainSteps)
    have skipped : ¬ (getCurrentEpoch middle.state).toNat ≤ high + 1 := by omega
    simp [Run.balanceEvents, prior, skipped, pure, Except.pure, bind, Except.bind]

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The whistleblower credits of the shared run's last epoch fit the keys that it slashes.

The run `pre` goes from `b` to the split, inside the split's epoch.

A whistleblower credit lands in the proposer's block, so a key of any class can receive it.

Each key slashed along `pre` pays the quotient of its effective balance at the slashing.

That balance is the one at the split.

It changes only at an epoch update, and `pre` is in one epoch.

R's call reads each such key as slashed, since its withdrawable epoch is a slashing vector away.

The sum is over keys that `SC` leaves out, because they are slashed at the split. -/
private theorem cut_whistle (h : Setting config checks g split fin pulled anc counted V)
    {b : BeaconState preset fork} (toB : Run config checks g ⟨fork, b⟩)
    (pre : Run config checks ⟨fork, b⟩ ⟨fork, split⟩)
    (sameEpoch : getCurrentEpoch split = getCurrentEpoch b) (high : ℕ) (keys : Finset ℕ) :
    ∑ i ∈ keys, whistC pre high i ≤
      ∑ v ∈ ((Finset.range pulled.validators.data.size).image UInt64.ofNat).filter
          (fun v => ((b.validators.data[v.toNat]?).map (·.slashed)).getD false = false ∧
            ((split.validators.data[v.toNat]?).map (·.slashed)).getD false = true ∧
            (pinTerms config pulled anc fin).slashedRB v.toNat = true),
        balanceAt split v.toNat / (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat := by
  classical
  obtain ⟨toPulled⟩ := h.toPulled
  obtain ⟨events, replayed, bounded⟩ := Run.balanceEvents_bounded toB pre h.genesis h.early high
  have scan := creditScan_sum_le keys id (fun s => decide (s = .slashings)) (fun _ => false) high
    BalanceEvent.credits pre replayed fun e _ _ => by
      simpa [keyCredit] using PinSeatDebits.keys_credits_le keys e
  have limits := slashing_credits_le_limits events fun e member => (bounded e member).1
  have slashings : (events.map fun e =>
      if decide (e.source = .slashings) = true ∨ false = true then e.credits else 0).sum =
      ((events.filter (·.source = .slashings)).map BalanceEvent.credits).sum := by
    simp only [decide_eq_true_eq, Bool.false_eq_true, or_false]
    rw [List.sum_map_ite (fun e : BalanceEvent preset => e.source = .slashings)
      BalanceEvent.credits (fun _ => 0)]
    simp
  refine (scan.trans (slashings.le.trans limits)).trans ?_
  by_cases late : high + 1 < (getCurrentEpoch b).toNat
  · rw [balanceEvents_late pre h.early sameEpoch late] at replayed
    cases replayed
    simp
  have endEpoch : (getCurrentEpoch split).toNat ≤ high + 1 := by rw [sameEpoch]; omega
  let P : ℕ → Prop := fun j => ((b.validators.data[j]?).map (·.slashed)).getD false = false ∧
    ((split.validators.data[j]?).map (·.slashed)).getD false = true ∧
    (pinTerms config pulled anc fin).slashedRB j = true
  let quotient := (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat
  have finalized := UInt64.le_iff_toNat_le.mp h.finalized
  refine (slashing_credits_le toB pre h.genesis h.early h.caps.compounding high endEpoch
    (Finset.range pulled.validators.data.size)
    (fun j => if P j then balanceAt split j / quotient else 0) ?_ replayed).trans ?_
  · intro a a' step contained j inside flip
    obtain ⟨before, after, -⟩ := pre.contains_split step contained
    have rest := (Run.nil.snoc step).append after
    have sameFork : a.fork = fork := fork_eq_of_run before rest (Nat.le_refl _)
    have size := Nat.lt_of_lt_of_le (Finset.mem_range.mp inside)
      ((after.append toPulled).registryLifecycle.size_le)
    refine ⟨Finset.mem_range.mpr size, ?_⟩
    simp only [Bool.and_eq_true, Bool.not_eq_true'] at flip
    obtain ⟨unslashedA, slashedA'⟩ := flip
    rcases foundA : a.state.validators.data[j]? with _ | u
    · simp [effectiveAt, foundA]
    have clean : u.slashed = false := by simpa [foundA] using unslashedA
    obtain ⟨w, foundA', marked⟩ :
        ∃ w, a'.state.validators.data[j]? = some w ∧ w.slashed = true := by
      cases found : a'.state.validators.data[j]? with
      | none => simp [found] at slashedA'
      | some w => exact ⟨w, rfl, by simpa [found] using slashedA'⟩
    obtain ⟨_, foundS, markedS⟩ := after.slashedPersistence j w foundA' marked
    obtain ⟨wP, foundP, markedP⟩ := (after.append toPulled).slashedPersistence j w foundA' marked
    have startB : (getCurrentEpoch b).toNat ≤ (getCurrentEpoch a.state).toNat :=
      UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps before.chainSteps)
    have endS : (getCurrentEpoch a.state).toNat ≤ (getCurrentEpoch split).toNat :=
      UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps rest.chainSteps)
    have epochB : (getCurrentEpoch b).toNat = (getCurrentEpoch split).toNat := by rw [sameEpoch]
    have withdrawable := ((rest.append toPulled).newly_slashed_withdrawableEpoch h.caps.activation
      h.caps.compounding h.early h.delay j u wP foundA foundP clean markedP).2
    have p : P j := by
      refine ⟨?_, by simp [foundS, markedS], ?_⟩
      · cases foundB : b.validators.data[j]? with
        | none => rfl
        | some v =>
          simp [unslashed_of_run before foundB (fun z read => by simp_all)]
      · exact slashedRB_of_withdrawable config pulled anc fin foundP markedP (by omega)
    have sameEpochA : getCurrentEpoch split = getCurrentEpoch a.state :=
      UInt64.toNat_inj.mp (by omega)
    have kept := rest.effectiveKept_of_same_epoch h.early sameEpochA j
      (Array.getElem?_eq_some_iff.mp foundA).1
    have read : balanceAt split j = effectiveAt a j := kept
    simp only [p, ↓reduceIte, quotient, read, sameFork, le_refl]
  · rw [← Finset.sum_filter]
    have round (z : ℕ) (hz : z ∈ (Finset.range pulled.validators.data.size).filter P) :
        (UInt64.ofNat z).toNat = z := by
      have inside := Finset.mem_range.mp (Finset.mem_filter.mp hz).1
      exact UInt64.toNat_ofNat_of_lt'
        (inside.trans (BeaconState.validators_size_lt_of_lt_glamsterdam h.early pulled))
    refine Finset.sum_le_sum_of_injOn UInt64.ofNat ?_ ?_ ?_ (fun _ _ _ => Nat.zero_le _)
    · intro x hx y hy same
      rw [← round x hx, ← round y hy, same]
    · intro v hv
      obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hv
      obtain ⟨inside, px⟩ := Finset.mem_filter.mp hx
      refine Finset.mem_filter.mpr ⟨Finset.mem_image.mpr ⟨x, inside, rfl⟩, ?_⟩
      rw [round x hx]
      exact px
    · intro x hx
      rw [round x hx]

/-- A sum is at most the sum of the floors of its parts, with the ceiling of the second part. -/
private theorem floor_add_ceil_le (a b Q : ℕ) (pos : 0 < Q) :
    (a + b) / Q ≤ a / Q + (b + Q - 1) / Q := by
  refine Nat.lt_succ_iff.mp ((Nat.div_lt_iff_lt_mul pos).mpr ?_)
  have h1 := Nat.div_add_mod a Q
  have h2 := Nat.mod_lt a pos
  have h3 := Nat.div_add_mod (b + Q - 1) Q
  have h4 := Nat.mod_lt (b + Q - 1) pos
  generalize a / Q = qa at *
  generalize (b + Q - 1) / Q = qb at *
  generalize a % Q = ra at *
  generalize (b + Q - 1) % Q = rb at *
  have : (qa + qb).succ * Q = Q * qa + Q * qb + Q := by rw [Nat.succ_mul]; ring
  rw [this]
  omega

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- R1 from the count of its rounding bands.

The slash charges of the classes fit the slashed keys of `branchR`, with the weights of the classes.

The sync part of the proposer credit fits the proposer credit of each epoch.

The flag gain and the unit of each slashed key fit `W`, by `branchR_split`.

The bands of the classes fit the rounded keys of `branchR`, which is the hypothesis `bands`.

The seat holders of `SC` weigh one in `bands`, and take seat slots that no class claims. -/
private theorem bud_branchR_of (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    {b : BeaconState preset fork} (pre : Run config checks ⟨fork, b⟩ ⟨fork, split⟩)
    {events eventsF eventsC eventsP : List (BalanceEvent preset)}
    (bands : 3 * (∑ v ∈ V, bandR (eventsF ++ eventsC) v.toNat) +
        (∑ v ∈ K4 pulled counted V, bandR (eventsF ++ events) v.toNat) +
        3 * (∑ v ∈ K5 counted V, bandR (eventsF ++ events) v.toNat) +
        (∑ v ∈ K6 pulled counted, bandR (eventsF ++ events) v.toNat) +
        (∑ v ∈ SC pulled counted split, bandR (eventsF ++ events) v.toNat) +
        (∑ v ∈ SC pulled counted split,
          if (pinTerms config pulled anc fin).exitBeforeFin v.toNat = true then
            (if 0 < syncCr eventsF v.toNat then preset.upwardBand else 0) else 0) +
        (∑ v ∈ scCharged pulled counted split tailC,
          if 0 < propN pre highC v.toNat + whistC pre highC v.toNat + syncCr eventsP v.toNat then
            preset.upwardBand else 0) +
        3 * (∑ v ∈ cutKeys config pulled anc fin split,
          if 0 < syncD eventsF v.toNat + syncD events v.toNat then
            (preset.EFFECTIVE_BALANCE_INCREMENT.toNat +
              (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat - 1) /
                (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat else 0) ≤
      3 * ((preset.EFFECTIVE_BALANCE_INCREMENT.toNat + preset.downwardBand - 1) *
        ((pinTerms config pulled anc fin).depth * preset.SLOTS_PER_EPOCH.toNat +
          (pinTerms config pulled anc fin).depth *
            preset.MAX_PENDING_DEPOSITS_PER_EPOCH.toNat +
          preset.SYNC_COMMITTEE_SIZE.toNat *
            (((getCurrentEpoch pulled).toNat + 1) /
                max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat -
              (getCurrentEpoch fin).toNat /
                max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat + 1 +
              (pinTerms config pulled anc fin).depth /
                max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat)))) :
    3 * ((pinTerms config pulled anc fin).slashedR *
        (2 * (pinTerms config pulled anc fin).depthFin *
          (pinTerms config pulled anc fin).flagRate)) +
      3 * ((pinTerms config pulled anc fin).slashedR *
        (pinTerms config pulled anc fin).slashLeak) +
      3 * ((pinTerms config pulled anc fin).unitGain * (pinTerms config pulled anc fin).slashedR) +
      3 * (∑ v ∈ V, bandR (eventsF ++ eventsC) v.toNat) +
        3 * ((pinTerms config pulled anc fin).depth *
          (pinTerms config pulled anc fin).syncProposer) +
        (∑ v ∈ (K4 pulled counted V),
          (slashR (pinTerms config pulled anc fin) v.toNat + bandR (eventsF ++ events) v.toNat)) +
        3 * (∑ v ∈ (K5 counted V),
          (slashR (pinTerms config pulled anc fin) v.toNat + bandR (eventsF ++ events) v.toNat)) +
        (∑ v ∈ (K6 pulled counted),
          (slashR (pinTerms config pulled anc fin) v.toNat + bandR (eventsF ++ events) v.toNat)) +
        3 * scSlashedReward config pulled anc fin counted split +
        (∑ v ∈ SC pulled counted split, bandR (eventsF ++ events) v.toNat) +
        (∑ v ∈ SC pulled counted split,
          if (pinTerms config pulled anc fin).exitBeforeFin v.toNat = true then
            (if 0 < syncCr eventsF v.toNat then preset.upwardBand else 0) else 0) +
        (∑ v ∈ scCharged pulled counted split tailC,
          if 0 < propN pre highC v.toNat + whistC pre highC v.toNat + syncCr eventsP v.toNat then
            preset.upwardBand else 0) +
        3 * (∑ v ∈ cutKeys config pulled anc fin split,
          if 0 < syncD eventsF v.toNat + syncD events v.toNat then
            (preset.EFFECTIVE_BALANCE_INCREMENT.toNat +
              (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat - 1) /
                (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat else 0) +
        3 * (∑ v ∈ cutKeys config pulled anc fin split,
          (max (balanceAt pulled v.toNat + (pinTerms config pulled anc fin).rise v.toNat)
              (balanceAt fin v.toNat) /
            (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat +
          slashR (pinTerms config pulled anc fin) v.toNat)) ≤
      (pinTerms config pulled anc fin).branchR := by
  classical
  unfold scSlashedReward
  obtain ⟨Wh, W, hW, gainW, floorW⟩ := branchR_split config pulled anc fin
  obtain ⟨d45, d46, d56, -, -, -⟩ := classes_disjoint h
  obtain ⟨dSC, -⟩ := sc_disjoint h
  have slashes := weighted_le (A := K4 pulled counted V) (B := K5 counted V)
    (C := K6 pulled counted) (fun v => slashR (pinTerms config pulled anc fin) v.toNat) d45 d46
    d56
  -- A cut key is slashed at the split, so it is in no class and not in `SC`.
  have dCut : Disjoint (K4 pulled counted V ∪ K5 counted V ∪ K6 pulled counted ∪
      SC pulled counted split) (cutKeys config pulled anc fin split) :=
    (cut_disjoint h).symm.mono_left fun v member => by
      simp only [Finset.mem_union] at member ⊢
      tauto
  -- Each cut key is read as slashed, so its slash charge is an increment.
  have cutRB : (cutKeys config pulled anc fin split).filter
      (fun v => (pinTerms config pulled anc fin).slashedRB v.toNat = true) =
        cutKeys config pulled anc fin split :=
    Finset.filter_true_of_mem fun v cut => (Finset.mem_filter.mp cut).2.2.1
  -- A key of `SC` that R slashes takes an increment of `branchR`'s slashed keys.
  --
  -- A key of the classes takes one too, and the two sets are disjoint.
  have slashBound := slashR_le config pulled anc fin
    (K4 pulled counted V ∪ K5 counted V ∪ K6 pulled counted ∪ SC pulled counted split ∪
      cutKeys config pulled anc fin split)
  rw [Finset.sum_union dCut, Finset.sum_union dSC] at slashBound
  have scFloor := floorW (SC pulled counted split ∪ cutKeys config pulled anc fin split)
  rw [Finset.filter_union, cutRB, Finset.sum_union (Finset.disjoint_of_subset_left
    (Finset.filter_subset _ _) (Finset.disjoint_union_left.mp dCut).2)] at scFloor
  have scReward : ∑ v ∈ (SC pulled counted split).filter
        (fun v => (pinTerms config pulled anc fin).slashedRB v.toNat = true),
      (max (balanceAt pulled v.toNat + (pinTerms config pulled anc fin).rise v.toNat)
          (balanceAt fin v.toNat) /
          (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat +
        (preset.EFFECTIVE_BALANCE_INCREMENT.toNat +
            (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat - 1) /
          (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat) ≤
      (∑ v ∈ (SC pulled counted split).filter
          (fun v => (pinTerms config pulled anc fin).slashedRB v.toNat = true),
        max (balanceAt pulled v.toNat + (pinTerms config pulled anc fin).rise v.toNat)
          (balanceAt fin v.toNat) /
          (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat) +
        ∑ v ∈ SC pulled counted split, slashR (pinTerms config pulled anc fin) v.toNat := by
    have each : ∀ v ∈ (SC pulled counted split).filter
        (fun v => (pinTerms config pulled anc fin).slashedRB v.toNat = true),
        max (balanceAt pulled v.toNat + (pinTerms config pulled anc fin).rise v.toNat)
          (balanceAt fin v.toNat) /
            (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat +
          (preset.EFFECTIVE_BALANCE_INCREMENT.toNat +
              (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat - 1) /
            (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat ≤
        max (balanceAt pulled v.toNat + (pinTerms config pulled anc fin).rise v.toNat)
          (balanceAt fin v.toNat) /
          (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat +
        slashR (pinTerms config pulled anc fin) v.toNat := fun v hv => by
      have flag := (Finset.mem_filter.mp hv).2
      rw [show slashR (pinTerms config pulled anc fin) v.toNat =
        preset.EFFECTIVE_BALANCE_INCREMENT.toNat by simp [slashR, flag]]
      exact Nat.add_le_add_left (ceil_div_le _ _) _
    refine (Finset.sum_le_sum each).trans ?_
    rw [Finset.sum_add_distrib]
    exact Nat.add_le_add_left (Finset.sum_le_sum_of_subset (Finset.filter_subset _ _)) _
  have credit := Nat.mul_le_mul_left (pinTerms config pulled anc fin).depth
    (syncProposer_le_credit config pulled anc fin)
  simp only [Finset.sum_add_distrib] at *
  rw [hW]
  omega

/-- R1 (branchR): R's credits to V keys since the split, weight 3.

The slashing of a key on R's branch is charged here for the keys of `K4` and `K5`.

So is a sync debit of R that `rise` omits.

The keys of `K4` weigh one, and those of `K5` weigh three.

The surplus of the slash charge pays `flow_split_of`'s slashed term.

`branchR` also holds the unit of each key slashed on R's branch.

R's credits leave out sync events, so `bud_sync` takes them.

The keys of `SC` that R slashes after the split also draw on `branchR`, at weight three.

The `whistleblowerR` term of `pinReserve` pays their reward on C's branch.

The seat holders of `SC` also weigh one, and take seat slots of `branchR` that no class claims.

A key of `K5` that receives a whistleblower credit on `pre` is read at the credits of `pre`. -/
private theorem bud_branchR (h : Setting config checks g split fin pulled anc counted V)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩) (high : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    {b : BeaconState preset fork} (toB : Run config checks g ⟨fork, b⟩)
    (pre : Run config checks ⟨fork, b⟩ ⟨fork, split⟩)
    (sameEpoch : getCurrentEpoch split = getCurrentEpoch b)
    {eventsF : List (BalanceEvent preset)} (replayedF : fromFin.balanceEvents high = .ok eventsF)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    {eventsP : List (BalanceEvent preset)} (replayedP : pre.balanceEvents highC = .ok eventsP) :
    3 * ((pinTerms config pulled anc fin).slashedR *
        (2 * (pinTerms config pulled anc fin).depthFin *
          (pinTerms config pulled anc fin).flagRate)) +
      3 * ((pinTerms config pulled anc fin).slashedR *
        (pinTerms config pulled anc fin).slashLeak) +
      3 * ((pinTerms config pulled anc fin).unitGain * (pinTerms config pulled anc fin).slashedR) +
      3 * (∑ v ∈ V, bandR (eventsF ++ eventsC) v.toNat) +
        3 * ((pinTerms config pulled anc fin).depth *
          (pinTerms config pulled anc fin).syncProposer) +
        (∑ v ∈ (K4 pulled counted V),
          (slashR (pinTerms config pulled anc fin) v.toNat + bandR (eventsF ++ events) v.toNat)) +
        3 * (∑ v ∈ (K5 counted V),
          (slashR (pinTerms config pulled anc fin) v.toNat + bandR (eventsF ++ events) v.toNat)) +
        3 * (∑ v ∈ (K5 counted V), whistC pre highC v.toNat) +
        3 * (∑ v ∈ scCharged pulled counted split tailC, whistC pre highC v.toNat) +
        (∑ v ∈ (K6 pulled counted),
          (slashR (pinTerms config pulled anc fin) v.toNat + bandR (eventsF ++ events) v.toNat)) +
        3 * scSlashedReward config pulled anc fin counted split +
        (∑ v ∈ SC pulled counted split, bandR (eventsF ++ events) v.toNat) +
        (∑ v ∈ SC pulled counted split,
          if (pinTerms config pulled anc fin).exitBeforeFin v.toNat = true then
            (if 0 < syncCr eventsF v.toNat then preset.upwardBand else 0) else 0) +
        (∑ v ∈ scCharged pulled counted split tailC,
          if 0 < propN pre highC v.toNat + whistC pre highC v.toNat + syncCr eventsP v.toNat then
            preset.upwardBand else 0) ≤
      (pinTerms config pulled anc fin).branchR +
        -- The cut keys' sync debits and induced leak, paid by `bud_sync` and `bud_syncLeak`.
        3 * (∑ v ∈ cutKeys config pulled anc fin split,
          (syncD eventsF v.toNat + syncD events v.toNat +
            inducedR (pinTerms config pulled anc fin) (fromFin.append tail) v.toNat)) := by
  classical
  obtain ⟨toPulled⟩ := h.toPulled
  set q := (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat with hq
  set inc := preset.EFFECTIVE_BALANCE_INCREMENT.toNat with hinc
  -- The bands of `bud_branchR_of` are the seats' bands, within the bound of `roundedKeys`.
  have depthEq : (pinTerms config pulled anc fin).depth =
      (getCurrentEpoch pulled).toNat + 2 - anc.finalizedCheckpoint.epoch.toNat := rfl
  have finalized := UInt64.le_iff_toNat_le.mp h.finalized
  have called := UInt64.le_iff_toNat_le.mp h.called
  have seats := bands_seats h fromFin tail tailC high highC endEpoch endEpochC toB pre sameEpoch
    replayed replayedF replayedC replayedP
  have slots : preset.SLOTS_PER_EPOCH.toNat ≤
      (pinTerms config pulled anc fin).depth * preset.SLOTS_PER_EPOCH.toNat :=
    Nat.le_mul_of_pos_left _ (by omega)
  rw [← depthEq] at seats
  have of := bud_branchR_of h tailC highC pre (seats.trans (Nat.mul_le_mul_left 3
    (Nat.mul_le_mul_left _ ?bandsLe)))
  case bandsLe => omega
  -- One `cut_whistle` reads the credits of `pre` to the keys of `K5` and of `scCharged`.
  obtain ⟨dSC, -⟩ := sc_disjoint h
  have apart : Disjoint (K5 counted V) (scCharged pulled counted split tailC) :=
    Finset.disjoint_of_subset_right (Finset.filter_subset _ _)
      (Finset.disjoint_of_subset_left (fun v member => Finset.mem_union.mpr
        (.inl (Finset.mem_union.mpr (.inr member)))) dSC)
  have whistle := cut_whistle h toB pre sameEpoch highC
    ((K5 counted V ∪ scCharged pulled counted split tailC).image UInt64.toNat)
  rw [Finset.sum_image fun a _ b _ same => UInt64.toNat_inj.mp same,
    Finset.sum_union apart] at whistle
  -- Each key that `pre` slashes is a cut key, at most its reserve, increment, seat and debits.
  have finEpoch : (getCurrentEpoch fin).toNat ≤ (getCurrentEpoch split).toNat :=
    UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps fromFin.chainSteps)
  have each : ∀ v ∈ ((Finset.range pulled.validators.data.size).image UInt64.ofNat).filter
      (fun v => ((b.validators.data[v.toNat]?).map (·.slashed)).getD false = false ∧
        ((split.validators.data[v.toNat]?).map (·.slashed)).getD false = true ∧
        (pinTerms config pulled anc fin).slashedRB v.toNat = true),
      v ∈ cutKeys config pulled anc fin split ∧ balanceAt split v.toNat / q ≤
        (max (balanceAt pulled v.toNat + (pinTerms config pulled anc fin).rise v.toNat)
            (balanceAt fin v.toNat) / q + slashR (pinTerms config pulled anc fin) v.toNat) +
          (if 0 < syncD eventsF v.toNat + syncD events v.toNat then (inc + q - 1) / q else 0) +
          (syncD eventsF v.toNat + syncD events v.toNat +
            inducedR (pinTerms config pulled anc fin) (fromFin.append tail) v.toNat) := by
    intro v member
    obtain ⟨inside, clean, marked, rb⟩ : v ∈ (Finset.range pulled.validators.data.size).image
        UInt64.ofNat ∧ _ ∧ _ ∧ _ := by simpa only [Finset.mem_filter, and_assoc] using member
    -- The step of `pre` that slashes the key starts from a record of it.
    let P : ForkedBeaconState preset → Prop := fun z =>
      ((z.state.validators.data[v.toNat]?).map (·.slashed)).getD false = true
    obtain ⟨m, n, before, step, after, -, notM, atN⟩ :=
      Run.split_at_flip pre P (by simp [P, clean]) marked
    have mFork : m.fork = fork := fork_eq_of_run before ((Run.nil.snoc step).append after)
      (Nat.le_refl _)
    have startB : (getCurrentEpoch b).toNat ≤ (getCurrentEpoch m.state).toNat :=
      UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps before.chainSteps)
    obtain ⟨w, foundN, slashedN⟩ : ∃ w, n.state.validators.data[v.toNat]? = some w ∧
        w.slashed = true := by
      cases found : n.state.validators.data[v.toNat]? with
      | none => simp [P, found] at atN
      | some w => exact ⟨w, rfl, by simpa [P, found] using atN⟩
    obtain ⟨u, foundM, unslashedM⟩ : ∃ u, m.state.validators.data[v.toNat]? = some u ∧
        u.slashed = false := by
      cases found : m.state.validators.data[v.toNat]? with
      | some u => exact ⟨u, rfl, by simpa [P, found] using notM⟩
      | none =>
        have finite : getCurrentEpoch m.state < FAR_FUTURE_EPOCH := by
          refine UInt64.lt_iff_le_and_ne.mpr ⟨UInt64.le_iff_toNat_le.mpr ?_,
            getCurrentEpoch_ne_farFuture h.twoSlots m.state⟩
          have := (getCurrentEpoch m.state).toNat_lt
          have far : FAR_FUTURE_EPOCH.toNat = 2 ^ 64 - 1 := rfl
          omega
        obtain ⟨_, recorded, -⟩ := step.slashed_activated
          (by rw [mFork]; exact Nat.le_trans (by decide) h.fulu)
          (Nat.lt_of_le_of_lt (fork_le_of_chainSteps after.chainSteps) h.early)
          h.caps.activation h.caps.compounding h.delay finite v.toNat
          (fun u read => by simp [found] at read) (by simp [found, foundN, slashedN])
        simp [found] at recorded
    obtain ⟨wP, foundP, slashedP⟩ :=
      (after.append toPulled).slashedPersistence v.toNat w foundN slashedN
    have withdrawable := ((((Run.nil.snoc step).append after).append toPulled)
      |>.newly_slashed_withdrawableEpoch h.caps.activation h.caps.compounding h.early h.delay
        v.toNat u wP foundM foundP unslashedM slashedP).2
    have cut : v ∈ cutKeys config pulled anc fin split := by
      refine Finset.mem_filter.mpr ⟨inside, marked, rb, ?_⟩
      have key : (getCurrentEpoch fin).toNat + preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat ≤
          wP.withdrawableEpoch.toNat := by
        have same : (getCurrentEpoch split).toNat = (getCurrentEpoch b).toNat := by
          rw [sameEpoch]
        have late : (getCurrentEpoch m.state).toNat + preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat ≤
            wP.withdrawableEpoch.toNat := withdrawable
        omega
      simpa [foundP] using key
    refine ⟨cut, ?_⟩
    -- The balance at the split is within `cut_balance_le`'s bound, and the quotient splits.
    have bound := cut_balance_le h fromFin tail high endEpoch replayedF replayed v cut
    have unit : slashR (pinTerms config pulled anc fin) v.toNat = inc := by simp [slashR, rb, inc]
    rw [unit]
    rcases Nat.eq_zero_or_pos q with zero | positive
    · simp [zero]
    have lift (a c : ℕ) : (a + c) / q ≤ a + c / q := by
      have h2 := Nat.lt_mul_div_succ c positive
      rw [Nat.mul_succ] at h2
      have ha : a ≤ q * a := Nat.le_mul_of_pos_left a positive
      apply Nat.le_of_lt_succ
      rw [Nat.div_lt_iff_lt_mul positive, Nat.succ_mul, Nat.add_mul, Nat.mul_comm a q,
        Nat.mul_comm (c / q)]
      omega
    generalize balanceAt split v.toNat = x at bound ⊢
    generalize hP : balanceAt pulled v.toNat + (pinTerms config pulled anc fin).rise v.toNat = p
      at bound ⊢
    generalize syncD eventsF v.toNat + syncD events v.toNat +
      inducedR (pinTerms config pulled anc fin) (fromFin.append tail) v.toNat = r at bound ⊢
    generalize syncD eventsF v.toNat + syncD events v.toNat = d at bound ⊢
    generalize balanceAt fin v.toNat = f at bound ⊢
    by_cases debited : 0 < d
    · simp only [debited, ↓reduceIte] at bound ⊢
      have within : x ≤ max p f + ((inc + r) + inc) := by omega
      have one := (Nat.div_le_div_right (c := q) within).trans
        (floor_add_ceil_le _ _ q positive)
      have two := lift (inc + r) (inc + q - 1)
      rw [show inc + r + inc + q - 1 = inc + r + (inc + q - 1) by omega] at one
      omega
    · simp only [debited, ↓reduceIte] at bound ⊢
      have within : x ≤ max p f + (inc + r) := by omega
      have one := (Nat.div_le_div_right (c := q) within).trans
        (floor_add_ceil_le _ _ q positive)
      have two := lift (inc + r) (q - 1)
      have zero : (q - 1) / q = 0 := Nat.div_eq_of_lt (by omega)
      rw [show inc + r + q - 1 = inc + r + (q - 1) by omega] at one
      omega
  -- The keys that `pre` slashes fit the cut keys' reserves, increments, seats and debits.
  have cutSum := (Finset.sum_le_sum fun v member => (each v member).2).trans
    (Finset.sum_le_sum_of_subset_of_nonneg (fun v member => (each v member).1)
      fun _ _ _ => Nat.zero_le _)
  rw [Finset.sum_add_distrib, Finset.sum_add_distrib] at cutSum
  simp only [hq, hinc] at cutSum whistle
  linarith

/-- The sync movement of a key is its sync credits plus its sync debits over the events. -/
private theorem syncF_eq (events : List (BalanceEvent preset)) (v : ℕ) :
    syncF events v = (events.map (syncCredit v)).sum +
      (events.map (syncDebit v)).sum := by
  unfold syncF
  rw [← sum_syncDebit_eq events v]
  exact congrArg (· + ((events.map (syncDebit v)).sum)) (sum_map_sync events (keyCredit v)).symm

/-- The sync movement of keys on a run within a call's reach is within an envelope.

The run is the tail from the split, after `pre`, the shared run from the start of the split's epoch.

The envelope is the seats' one, read at the pulled state's total.

`shape` ties `pre` to the run from the finalized state, so each of its steps has a guarded total.

A step before the finalized state is in its epoch, where the active stake is the finalized one. -/
private theorem syncF_run_le (h : Setting config checks g split fin pulled anc counted V)
    (pulledTotal : Gwei) (pulledOk : getTotalActiveBalance pulled = .ok pulledTotal)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    {b : BeaconState preset fork} (pre : Run config checks ⟨fork, b⟩ ⟨fork, split⟩)
    (sameEpoch : getCurrentEpoch split = getCurrentEpoch b)
    (shape : (∃ fromB : Run config checks ⟨fork, fin⟩ ⟨fork, b⟩, fromFin = fromB.append pre) ∨
      ∃ toFinB : Run config checks ⟨fork, b⟩ ⟨fork, fin⟩, pre = toFinB.append fromFin)
    {e : BeaconState preset fork} (t : Run config checks ⟨fork, split⟩ ⟨fork, e⟩)
    (within : (getCurrentEpoch e).toNat ≤ (getCurrentEpoch pulled).toNat + 1)
    (highE : ℕ) {evs : List (BalanceEvent preset)}
    (replayed : (pre.append t).balanceEvents highE = .ok evs) (keys : Finset ℕ) :
    ∑ i ∈ keys, syncF evs i ≤
      ((getCurrentEpoch e).toNat + 1 - (getCurrentEpoch split).toNat) *
        preset.SLOTS_PER_EPOCH.toNat * preset.SYNC_COMMITTEE_SIZE.toNat *
          PinSeatDebits.syncSeatEnvelope preset pulledTotal.toNat := by
  obtain ⟨shared⟩ := h.toFin
  obtain ⟨toPulled⟩ := h.toPulled
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  have called := UInt64.le_iff_toNat_le.mp h.called
  have finSplit : (getCurrentEpoch fin).toNat ≤ (getCurrentEpoch split).toNat :=
    UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps fromFin.chainSteps)
  have splitB := congrArg UInt64.toNat sameEpoch
  have guarded : ∀ {u w : ForkedBeaconState preset} (step : Step config checks u w),
      (fromFin.append t).Contains step → ∀ T : Gwei, getTotalActiveBalance w.state = .ok T →
        2 * T.toNat ≤ 3 * pulledTotal.toNat := fun step member T read =>
    step_band_of_guard h (fromFin.append t) within pulledOk step member T read
  have band : ∀ {u w : ForkedBeaconState preset} (step : Step config checks u w),
      (pre.append t).Contains step → ∀ T : Gwei, getTotalActiveBalance w.state = .ok T →
        2 * T.toNat ≤ 3 * pulledTotal.toNat := by
    intro u w step member T read
    rcases (Run.contains_append _ _ _).mp member with inPre | inTail
    · rcases shape with ⟨fromB, rfl⟩ | ⟨toFinB, rfl⟩
      · exact guarded step ((Run.contains_append _ _ _).mpr (.inl
          ((Run.contains_append _ _ _).mpr (.inr inPre)))) T read
      · rcases (Run.contains_append _ _ _).mp inPre with before | inFin
        · -- a step before the finalized state shares its epoch, so its stake is the finalized one
          obtain ⟨front, back, -⟩ := toFinB.contains_split step before
          have startW : (getCurrentEpoch b).toNat ≤ (getCurrentEpoch w.state).toNat :=
            UInt64.le_iff_toNat_le.mp (UInt64.le_trans
              (currentEpoch_le_of_chainSteps front.chainSteps) step.chainStep.currentEpoch_le)
          have endW : (getCurrentEpoch w.state).toNat ≤ (getCurrentEpoch fin).toNat :=
            UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps back.chainSteps)
          have sameEp : getCurrentEpoch fin = getCurrentEpoch w.state :=
            UInt64.toNat_inj.mp (by omega)
          have wFork := Run.fork_eq_of_same_epoch back sameEp
          obtain ⟨wf, ws⟩ := w
          dsimp only at wFork sameEp read
          subst wFork
          have sums := DirectSafety.Apriori.Internal.activeStake_eq_of_same_epoch back h.early
            sameEp (getCurrentEpoch ws) (UInt64.le_refl _)
          have okW := getTotalActiveBalance_ok read
          obtain ⟨-, ltW, valW⟩ := getTotalBalance_ok_iff_stake.mp okW
          rw [← sameEp] at ltW valW
          have sameStake : stake (fun index => balanceAt fin index.toNat)
              (getActiveValidatorIndices fin (getCurrentEpoch fin)).toFinset =
              stake (fun index => balanceAt ws index.toNat)
                (getActiveValidatorIndices ws (getCurrentEpoch fin)).toFinset := by
            rw [← sameEp] at sums
            exact sums
          have checked : getActiveValidatorIndicesChecked fin (getCurrentEpoch fin) =
              .ok (getActiveValidatorIndices fin (getCurrentEpoch fin)) := by
            rw [getActiveValidatorIndicesChecked_eq_ok_iff]
            intro position inside _
            exact inside.trans (BeaconState.validators_size_lt_of_lt_glamsterdam h.early fin)
          have okFin : getTotalActiveBalance fin = .ok T := by
            unfold getTotalActiveBalance
            rw [checked]
            exact getTotalBalance_ok_iff_stake.mpr
              ⟨fun i m => lt_size_of_mem_getActiveValidatorIndices m, sameStake ▸ ltW,
                by rw [valW, sameStake]⟩
          exact total_band_of_guard shared h.genesis h.parameters h.caps h.aligned h.twoSlots
            electra h.guard (fromFin.append toPulled) h.early (Nat.le_succ _)
            (Run.nil : Run config checks ⟨fork, fin⟩ ⟨fork, fin⟩) h.early
            (by dsimp only; omega) pulledOk okFin
        · exact guarded step ((Run.contains_append _ _ _).mpr (.inl inFin)) T read
    · exact guarded step ((Run.contains_append _ _ _).mpr (.inr inTail)) T read
  have moves := (PinSeatDebits.Run.syncDebits_le (pre.append t) h.fulu h.early highE replayed
    pulledTotal.toNat band keys).2.1
  refine (Finset.sum_le_sum fun i _ => (syncF_eq evs i).le).trans (moves.trans (le_of_eq ?_))
  dsimp only
  rw [sameEpoch]

/-- `syncProposer` is the proposer share of the sync envelope at R's total.

It is paid for each seat in each slot of an epoch. -/
private theorem syncProposer_eq (config : Config) (pulled anc fin : BeaconState preset fork) :
    (pinTerms config pulled anc fin).syncProposer =
      preset.SLOTS_PER_EPOCH.toNat * preset.SYNC_COMMITTEE_SIZE.toNat *
        (PinTerms.syncEnvelope preset ((getTotalActiveBalance pulled).toOption.getD 0).toNat *
          PROPOSER_WEIGHT.toNat / (WEIGHT_DENOMINATOR.toNat - PROPOSER_WEIGHT.toNat)) := rfl

/-- The total that `pinTerms` reads at R is R's total active balance. -/
private theorem getD_total_eq {pulledTotal : Gwei}
    (pulledOk : getTotalActiveBalance pulled = .ok pulledTotal) :
    ((getTotalActiveBalance pulled).toOption.getD 0).toNat = pulledTotal.toNat := by
  rw [pulledOk]
  rfl

/-- The steps of a run from the split keep their total within the band of R's total. -/
private theorem step_band_of_tail (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩) {e : BeaconState preset fork}
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, e⟩)
    (within : (getCurrentEpoch e).toNat ≤ (getCurrentEpoch pulled).toNat + 1)
    {pulledTotal : Gwei} (pulledOk : getTotalActiveBalance pulled = .ok pulledTotal) :
    ∀ {u w : ForkedBeaconState preset} (step : Step config checks u w),
      tail.Contains step → ∀ T : Gwei, getTotalActiveBalance w.state = .ok T →
        2 * T.toNat ≤ 3 * pulledTotal.toNat := fun step member T read =>
  step_band_of_guard h (fromFin.append tail) within pulledOk step
    ((Run.contains_append _ _ _).mpr (.inr member)) T read

/-- The epochs of the shared segment and of R's run add up to the window from `fin`. -/
private theorem pin_epochs (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩) :
    ((getCurrentEpoch pulled).toNat + 1 - (getCurrentEpoch split).toNat) +
        ((getCurrentEpoch split).toNat + 1 - (getCurrentEpoch fin).toNat) =
      (getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat := by
  have finSplit := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps fromFin.chainSteps)
  have called := UInt64.le_iff_toNat_le.mp h.called
  simp only at finSplit
  omega

/-- The sync seats, in the third window: the base bound with the shared segment's K debits.

It also holds the shares of `CS` and of the shared segment's exited keys of `SC`.

The shared segment's debits are one weighted sum over the disjoint classes.

`cutKeys` holds the keys slashed at the split that R's call reads as slashed, at the same weight.

`bud_branchR` rounds their rewards up, and the debits pay the rounding.

The sync credits of `pre` ride with R's tail, since `pre` and the tail are one run in the epoch.

`K5` weighs three, and `SC` once for the split-epoch charge case. -/
private theorem bud_sync (h : Setting config checks g split fin pulled anc counted V)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩) (high : ℕ)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    {b : BeaconState preset fork} (pre : Run config checks ⟨fork, b⟩ ⟨fork, split⟩)
    (sameEpoch : getCurrentEpoch split = getCurrentEpoch b)
    (shape : (∃ fromB : Run config checks ⟨fork, fin⟩ ⟨fork, b⟩, fromFin = fromB.append pre) ∨
      ∃ toFinB : Run config checks ⟨fork, b⟩ ⟨fork, fin⟩, pre = toFinB.append fromFin)
    {eventsF : List (BalanceEvent preset)} (replayedF : fromFin.balanceEvents high = .ok eventsF)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    {eventsP : List (BalanceEvent preset)} (replayedP : pre.balanceEvents high = .ok eventsP) :
    3 * ((∑ v ∈ V, (syncD eventsF v.toNat + (syncF events v.toNat + syncF eventsC v.toNat))) +
        (∑ v ∈ (K4 pulled counted V), syncD eventsF v.toNat) +
        (∑ v ∈ (K4 pulled counted V), (syncF events v.toNat + syncF eventsC v.toNat)) +
        (∑ v ∈ (K5 counted V), (syncD eventsF v.toNat + syncCr eventsP v.toNat)) +
        (∑ v ∈ (K5 counted V), (syncF events v.toNat + syncF eventsC v.toNat)) +
        (∑ v ∈ cutKeys config pulled anc fin split,
          (syncD eventsF v.toNat + syncD events v.toNat))) +
      (∑ v ∈ (K6 pulled counted), syncD eventsF v.toNat) +
      (∑ v ∈ (K6 pulled counted), (syncF events v.toNat + syncF eventsC v.toNat)) +
      wShare preset fork (∑ v ∈ SC pulled counted split, syncCr eventsC v.toNat) +
      wShare preset fork
        (∑ v ∈ SC pulled counted split, (syncD eventsF v.toNat + syncD events v.toNat)) +
      wShare preset fork (∑ v ∈ CS counted split, syncCr eventsC v.toNat) +
      wShare preset fork (∑ v ∈ SC pulled counted split with
        (pinTerms config pulled anc fin).exitBeforeFin v.toNat = true, syncCr eventsF v.toNat) +
      2 * ∑ v ∈ sc3a config pulled anc fin counted split, syncD eventsF v.toNat +
      (∑ v ∈ SC pulled counted split, syncCr eventsP v.toNat) ≤
        (pinTerms config pulled anc fin).syncSeats +
          6 * ((pinTerms config pulled anc fin).depth *
            (pinTerms config pulled anc fin).syncProposer) := by
  classical
  obtain ⟨pulledTotal, pulledOk⟩ := h.pulledTotal
  have finalized := UInt64.le_iff_toNat_le.mp h.finalized
  have called := UInt64.le_iff_toNat_le.mp h.called
  have near := h.near
  have finSplit : (getCurrentEpoch fin).toNat ≤ (getCurrentEpoch split).toNat :=
    UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps fromFin.chainSteps)
  -- the five sets are pairwise disjoint
  obtain ⟨d45, d46, d56, d1, d15, d16⟩ := classes_disjoint h
  obtain ⟨dS, dVS⟩ := sc_disjoint h
  obtain ⟨dCK, dCV⟩ := cs_disjoint h
  have d2 : Disjoint (V ∪ K4 pulled counted V) (K5 counted V) :=
    Finset.disjoint_union_left.mpr ⟨d15, d45⟩
  have d3 : Disjoint (V ∪ K4 pulled counted V ∪ K5 counted V) (K6 pulled counted) :=
    Finset.disjoint_union_left.mpr ⟨Finset.disjoint_union_left.mpr ⟨d16, d46⟩, d56⟩
  have d4 : Disjoint (V ∪ K4 pulled counted V ∪ K5 counted V ∪ K6 pulled counted)
      (SC pulled counted split) := by
    rw [Finset.disjoint_left]
    intro v member slashed
    simp only [Finset.mem_union] at member
    rcases member with ((inV | in4) | in5) | in6
    · exact Finset.disjoint_left.mp dVS inV slashed
    · exact Finset.disjoint_left.mp dS (Finset.mem_union_left _ (Finset.mem_union_left _ in4))
        slashed
    · exact Finset.disjoint_left.mp dS (Finset.mem_union_left _ (Finset.mem_union_right _ in5))
        slashed
    · exact Finset.disjoint_left.mp dS (Finset.mem_union_right _ in6) slashed
  have dCS : Disjoint (V ∪ K4 pulled counted V ∪ K5 counted V ∪ K6 pulled counted ∪
      SC pulled counted split) (CS counted split) := by
    rw [Finset.disjoint_left]
    intro v member created
    simp only [Finset.mem_union] at member
    rcases member with (((inV | in4) | in5) | in6) | inSC
    · exact Finset.disjoint_left.mp dCV inV created
    · exact Finset.disjoint_left.mp dCK (by simp [in4]) created
    · exact Finset.disjoint_left.mp dCK (by simp [in5]) created
    · exact Finset.disjoint_left.mp dCK (by simp [in6]) created
    · exact Finset.disjoint_left.mp dCK (by simp [inSC]) created
  obtain ⟨U, hU⟩ : ∃ U : Finset ValidatorIndex,
      U = V ∪ K4 pulled counted V ∪ K5 counted V ∪ K6 pulled counted ∪ SC pulled counted split ∪
        CS counted split :=
    ⟨_, rfl⟩
  obtain ⟨g, hg⟩ : ∃ g : ValidatorIndex → ℕ, ∀ v, g v =
      syncF events v.toNat + syncF eventsC v.toNat := ⟨_, fun _ => rfl⟩
  have sumU : ∑ v ∈ U, g v = ∑ v ∈ V, g v + ∑ v ∈ K4 pulled counted V, g v +
      ∑ v ∈ K5 counted V, g v + ∑ v ∈ K6 pulled counted, g v +
      ∑ v ∈ SC pulled counted split, g v + ∑ v ∈ CS counted split, g v := by
    rw [hU, Finset.sum_union dCS, Finset.sum_union d4, Finset.sum_union d3, Finset.sum_union d2,
      Finset.sum_union d1]
  -- the keys of SC that exited by the finalized epoch hold the shared credits, and the rest debits
  set EK := (SC pulled counted split).filter
    (fun v => (pinTerms config pulled anc fin).exitBeforeFin v.toNat = true) with hEK
  set NF := (SC pulled counted split).filter
    (fun v => ¬ (pinTerms config pulled anc fin).exitBeforeFin v.toNat = true) with hNF
  have dKN : Disjoint (V ∪ K4 pulled counted V ∪ K5 counted V ∪ K6 pulled counted) NF :=
    Finset.disjoint_of_subset_right (Finset.filter_subset _ _) d4
  have dKE : Disjoint (V ∪ K4 pulled counted V ∪ K5 counted V ∪ K6 pulled counted) EK :=
    Finset.disjoint_of_subset_right (Finset.filter_subset _ _) d4
  have dNE : Disjoint NF EK := Finset.disjoint_left.mpr fun v inN inE =>
    (Finset.mem_filter.mp inN).2 (Finset.mem_filter.mp inE).2
  have scSplit : ∑ v ∈ SC pulled counted split, syncD eventsF v.toNat =
      ∑ v ∈ EK, syncD eventsF v.toNat + ∑ v ∈ NF, syncD eventsF v.toNat :=
    (Finset.sum_filter_add_sum_filter_not _ _ fun v : ValidatorIndex => syncD eventsF v.toNat).symm
  have unionD : ∑ v ∈ V ∪ K4 pulled counted V ∪ K5 counted V ∪ K6 pulled counted ∪ NF,
      syncD eventsF v.toNat = ∑ v ∈ V, syncD eventsF v.toNat +
        ∑ v ∈ K4 pulled counted V, syncD eventsF v.toNat +
        ∑ v ∈ K5 counted V, syncD eventsF v.toNat + ∑ v ∈ K6 pulled counted, syncD eventsF v.toNat +
        ∑ v ∈ NF, syncD eventsF v.toNat := by
    rw [Finset.sum_union dKN, Finset.sum_union d3, Finset.sum_union d2, Finset.sum_union d1]
  have unionK : ∑ v ∈ EK, (syncCr eventsF v.toNat + syncD eventsF v.toNat) =
      ∑ v ∈ EK, syncCr eventsF v.toNat + ∑ v ∈ EK, syncD eventsF v.toNat :=
    Finset.sum_add_distrib
  -- each class is weighed at most three times its tail movement, and the shares at most their own
  have classV : ∑ v ∈ V, (syncD eventsF v.toNat + (syncF events v.toNat + syncF eventsC v.toNat)) =
      ∑ v ∈ V, syncD eventsF v.toNat + ∑ v ∈ V, g v := by
    rw [← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun v _ => by rw [hg]
  have class4 : ∑ v ∈ K4 pulled counted V, (syncF events v.toNat + syncF eventsC v.toNat) ≤
      ∑ v ∈ K4 pulled counted V, g v := Finset.sum_le_sum fun v _ => (hg v).ge
  have class5 : ∑ v ∈ K5 counted V, (syncF events v.toNat + syncF eventsC v.toNat) ≤
      ∑ v ∈ K5 counted V, g v := Finset.sum_le_sum fun v _ => (hg v).ge
  have class6 : ∑ v ∈ K6 pulled counted, (syncF events v.toNat + syncF eventsC v.toNat) ≤
      ∑ v ∈ K6 pulled counted, g v := Finset.sum_le_sum fun v _ => (hg v).ge
  have credits : wShare preset fork (∑ v ∈ SC pulled counted split, syncCr eventsC v.toNat) ≤
      ∑ v ∈ SC pulled counted split, syncF eventsC v.toNat :=
    (wShare_le h.facts _).trans (Finset.sum_le_sum fun v _ => by
      unfold syncCr
      rw [syncF_eq]
      exact Nat.le_add_right _ _)
  have debits : wShare preset fork
      (∑ v ∈ SC pulled counted split, (syncD eventsF v.toNat + syncD events v.toNat)) ≤
      ∑ v ∈ SC pulled counted split, syncD eventsF v.toNat +
        ∑ v ∈ SC pulled counted split, syncF events v.toNat := by
    rw [← Finset.sum_add_distrib]
    exact (wShare_le h.facts _).trans (Finset.sum_le_sum fun v _ => by
      unfold syncD
      rw [syncF_eq]
      omega)
  have creditsF : wShare preset fork (∑ v ∈ EK, syncCr eventsF v.toNat) ≤
      ∑ v ∈ EK, syncCr eventsF v.toNat := wShare_le h.facts _
  have creditsCS : wShare preset fork (∑ v ∈ CS counted split, syncCr eventsC v.toNat) ≤
      ∑ v ∈ CS counted split, g v :=
    (wShare_le h.facts _).trans (Finset.sum_le_sum fun v _ => by
      rw [hg]
      unfold syncCr
      rw [syncF_eq eventsC]
      omega)
  have shares : ∑ v ∈ SC pulled counted split, syncF eventsC v.toNat +
      ∑ v ∈ SC pulled counted split, syncF events v.toNat =
      ∑ v ∈ SC pulled counted split, g v := by
    rw [← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun v _ => by rw [hg]; omega
  obtain ⟨S, hS⟩ : ∃ S, S = ∑ v ∈ V ∪ K4 pulled counted V ∪ K5 counted V ∪ K6 pulled counted ∪ NF,
      syncD eventsF v.toNat + ∑ v ∈ EK, (syncCr eventsF v.toNat + syncD eventsF v.toNat) :=
    ⟨_, rfl⟩
  -- the keys that the rise term of `bud_whistle_of` charges are among the keys of `SC`
  have rise3a : ∑ v ∈ sc3a config pulled anc fin counted split, syncD eventsF v.toNat ≤
      ∑ v ∈ SC pulled counted split, syncD eventsF v.toNat :=
    Finset.sum_le_sum_of_subset (Finset.filter_subset _ _)
  -- the terms of the statement beyond the old ones: the credits of `pre` and the cut keys' debits
  obtain ⟨extra, hextra⟩ : ∃ extra : ℕ, extra =
      3 * ∑ v ∈ K5 counted V, syncCr eventsP v.toNat +
      3 * ∑ v ∈ cutKeys config pulled anc fin split,
        (syncD eventsF v.toNat + syncD events v.toNat) +
      ∑ v ∈ SC pulled counted split, syncCr eventsP v.toNat := ⟨_, rfl⟩
  have k5split : ∑ v ∈ K5 counted V, (syncD eventsF v.toNat + syncCr eventsP v.toNat) =
      ∑ v ∈ K5 counted V, syncD eventsF v.toNat + ∑ v ∈ K5 counted V, syncCr eventsP v.toNat :=
    Finset.sum_add_distrib
  have cutSplit : ∑ v ∈ cutKeys config pulled anc fin split,
        (syncD eventsF v.toNat + syncD events v.toNat) =
      ∑ v ∈ cutKeys config pulled anc fin split, syncD eventsF v.toNat +
        ∑ v ∈ cutKeys config pulled anc fin split, syncD events v.toNat := Finset.sum_add_distrib
  refine le_trans (b := 3 * (∑ v ∈ U, g v + S) + extra) ?_ ?_
  · rw [sumU, hS]
    omega
  -- the shared segment moves the debited keys and the keys of EK by one envelope for each seat
  have cutAll := cut_disjoint h
  have cutU : Disjoint U (cutKeys config pulled anc fin split) := hU ▸ cutAll.symm
  have cutD : Disjoint (V ∪ K4 pulled counted V ∪ K5 counted V ∪ K6 pulled counted ∪ NF)
      (cutKeys config pulled anc fin split) := by
    refine Finset.disjoint_of_subset_left ?_ cutU
    rw [hU]
    intro v member
    simp only [Finset.mem_union] at member ⊢
    rcases member with inK | inNF
    · exact .inl (.inl inK)
    · exact .inl (.inr (Finset.mem_filter.mp inNF).1)
  obtain ⟨PD, hPD⟩ : ∃ PD, PD = (V ∪ K4 pulled counted V ∪ K5 counted V ∪ K6 pulled counted ∪
      NF ∪ cutKeys config pulled anc fin split).image fun v : ValidatorIndex => v.toNat :=
    ⟨_, rfl⟩
  obtain ⟨PK, hPK⟩ : ∃ PK, PK = EK.image fun v : ValidatorIndex => v.toNat := ⟨_, rfl⟩
  have dP : Disjoint PD PK := by
    have injective : Function.Injective fun v : ValidatorIndex => v.toNat :=
      fun a b same => UInt64.toNat_inj.mp same
    rw [hPD, hPK, Finset.disjoint_image injective]
    refine Finset.disjoint_union_left.mpr ⟨Finset.disjoint_union_left.mpr ⟨dKE, dNE⟩, ?_⟩
    refine Finset.disjoint_of_subset_right (fun v inE => ?_) cutAll
    simp only [Finset.mem_union]
    exact .inl (.inr (Finset.mem_filter.mp inE).1)
  have posD := voters_sum_le
      (voters := V ∪ K4 pulled counted V ∪ K5 counted V ∪ K6 pulled counted ∪ NF ∪
        cutKeys config pulled anc fin split) (positions := PD) (fun i => syncD eventsF i)
    fun v member => by rw [hPD]; exact Finset.mem_image_of_mem _ member
  have posK := voters_sum_le (voters := EK) (positions := PK)
      (fun i => syncCr eventsF i + syncD eventsF i)
    fun v member => by rw [hPK]; exact Finset.mem_image_of_mem _ member
  have band : ∀ {u w : ForkedBeaconState preset} (step : Step config checks u w),
      fromFin.Contains step → ∀ T : Gwei, getTotalActiveBalance w.state = .ok T →
        2 * T.toNat ≤ 3 * pulledTotal.toNat :=
    step_band_of_guard h fromFin (by omega) pulledOk
  -- no block of the shared segment has a proposer among the keys of EK
  obtain ⟨toFin⟩ := h.toFin
  have apartK : ∀ {u w : ForkedBeaconState preset} (step : Step config checks u w),
      fromFin.Contains step → PinSeatDebits.stepApart PK step := by
    intro u w step member
    cases step with
    | slot _ => trivial
    | @block f before after engine signed due ok =>
      obtain ⟨pre, post, -, -, -⟩ :=
        DirectSafety.Apriori.Internal.Run.contains_step_facts member h.early
      intro p found inK
      obtain ⟨v, inEK, same⟩ := Finset.mem_image.mp (hPK ▸ inK)
      -- v exits at R by the finalized epoch, so the finalized state has its record and exit
      obtain ⟨w0, foundPulled, exited⟩ : ∃ w0, pulled.validators.data[v.toNat]? = some w0 ∧
          w0.exitEpoch.toNat ≤ (getCurrentEpoch fin).toNat := by
        have flag : ((pulled.validators.data[v.toNat]?).any fun w =>
            decide (w.exitEpoch.toNat ≤ (getCurrentEpoch fin).toNat)) = true :=
          (Finset.mem_filter.mp inEK).2
        cases found0 : pulled.validators.data[v.toNat]? with
        | none => simp [found0] at flag
        | some w0 =>
          simp [found0] at flag
          exact ⟨w0, rfl, flag⟩
      obtain ⟨u0, foundFin, kept⟩ := exit_kept_of_le_fin h foundPulled exited
      have inactive := inactive_of_exited h.twoSlots (pre.snoc (Step.block engine signed due ok))
        foundFin (by rw [kept]; exact exited)
      have look := Run.lookaheadActive h.facts.covers h.genesis
        (toFin.append (pre.snoc (Step.block engine signed due ok)))
        (Nat.lt_of_le_of_lt (fork_le_of_chainSteps post.chainSteps) h.early)
      have active := look.proposer_active (Nat.le_trans h.fulu
        (fork_le_of_chainSteps (pre.snoc (Step.block engine signed due ok)).chainSteps)) found
      rw [← same, inactive] at active
      exact Bool.false_ne_true active
  have sharedRun := (PinSeatDebits.Run.syncDebits_le fromFin h.fulu h.early high replayedF
    pulledTotal.toNat band ∅).2.2 PD PK dP apartK
  unfold PinSeatDebits.syncSeatMoves at sharedRun
  have sharedS : S + ∑ v ∈ cutKeys config pulled anc fin split, syncD eventsF v.toNat ≤
      ((getCurrentEpoch split).toNat + 1 - (getCurrentEpoch fin).toNat) *
        preset.SLOTS_PER_EPOCH.toNat * preset.SYNC_COMMITTEE_SIZE.toNat *
          PinTerms.syncEnvelope preset pulledTotal.toNat := by
    have whole := Finset.sum_union cutD (f := fun v : ValidatorIndex => syncD eventsF v.toNat)
    have both := (Nat.add_le_add posD posK).trans sharedRun
    dsimp only at whole both
    rw [hS]
    omega
  -- the tails move the keys of the classes and the cut keys by their seat bounds.
  --
  -- `pre` joins R's tail as one run, whose events are those of `pre` and then the tail's.
  have joined := DirectSafety.Apriori.Internal.balanceEvents_append pre tail high replayedP replayed
  have syncAppend : ∀ i, syncF (eventsP ++ events) i = syncF eventsP i + syncF events i := by
    intro i
    simp only [syncF, List.filter_append, List.map_append, List.sum_append]
    omega
  obtain ⟨G, hG⟩ : ∃ G : ValidatorIndex → ℕ, ∀ v, G v = syncF eventsP v.toNat + g v :=
    ⟨_, fun _ => rfl⟩
  have toPositions : ∑ v ∈ U ∪ cutKeys config pulled anc fin split, G v ≤
      ∑ i ∈ (U ∪ cutKeys config pulled anc fin split).image (fun v : ValidatorIndex => v.toNat),
        (syncF (eventsP ++ events) i + syncF eventsC i) :=
    (Finset.sum_congr rfl fun v _ => by rw [hG, hg, syncAppend]; omega).le.trans
      (voters_sum_le (fun i => syncF (eventsP ++ events) i + syncF eventsC i)
        fun v member => Finset.mem_image_of_mem _ member)
  have first := syncF_run_le h pulledTotal pulledOk fromFin pre sameEpoch shape tail
    (Nat.le_succ _) high joined
    ((U ∪ cutKeys config pulled anc fin split).image fun v : ValidatorIndex => v.toNat)
  have second := syncF_run_le h pulledTotal pulledOk fromFin Run.nil rfl (.inl ⟨fromFin, rfl⟩) tailC
    near highC (by rw [run_nil_append]; exact replayedC)
    ((U ∪ cutKeys config pulled anc fin split).image fun v : ValidatorIndex => v.toNat)
  generalize (U ∪ cutKeys config pulled anc fin split).image (fun v : ValidatorIndex => v.toNat) =
    P at toPositions first second
  have splitP : ∑ i ∈ P, (syncF (eventsP ++ events) i + syncF eventsC i) =
      ∑ i ∈ P, syncF (eventsP ++ events) i + ∑ i ∈ P, syncF eventsC i := Finset.sum_add_distrib
  have totalEq := getD_total_eq pulledOk
  have seats : (pinTerms config pulled anc fin).syncSeats =
      3 * (((pinTerms config pulled anc fin).depth +
        ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat)) *
          preset.SLOTS_PER_EPOCH.toNat * preset.SYNC_COMMITTEE_SIZE.toNat *
            PinTerms.syncEnvelope preset
              ((getTotalActiveBalance pulled).toOption.getD 0).toNat) := rfl
  have proposer := syncProposer_eq config pulled anc fin
  have depthEq : (pinTerms config pulled anc fin).depth =
      (getCurrentEpoch pulled).toNat + 2 - anc.finalizedCheckpoint.epoch.toNat := rfl
  rw [totalEq] at seats proposer
  rw [seats, proposer]
  unfold PinSeatDebits.syncSeatEnvelope at first second
  generalize (pinTerms config pulled anc fin).depth = depth at depthEq ⊢
  generalize PinTerms.syncEnvelope preset pulledTotal.toNat = env at *
  generalize env * PROPOSER_WEIGHT.toNat / (WEIGHT_DENOMINATOR.toNat - PROPOSER_WEIGHT.toNat) =
    share at *
  -- the epochs of the three runs fit the two depths
  have epochs : ((getCurrentEpoch split).toNat + 1 - (getCurrentEpoch fin).toNat) +
      ((getCurrentEpoch pulled).toNat + 1 - (getCurrentEpoch split).toNat) +
      ((getCurrentEpoch counted).toNat + 1 - (getCurrentEpoch split).toNat) ≤
      depth + ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) := by
    omega
  have firstDepth :
      (getCurrentEpoch pulled).toNat + 1 - (getCurrentEpoch split).toNat ≤ depth := by
    omega
  have secondDepth :
      (getCurrentEpoch counted).toNat + 1 - (getCurrentEpoch split).toNat ≤ depth := by
    omega
  generalize (getCurrentEpoch split).toNat + 1 - (getCurrentEpoch fin).toNat = ef at *
  generalize (getCurrentEpoch pulled).toNat + 1 - (getCurrentEpoch split).toNat = e1 at *
  generalize (getCurrentEpoch counted).toNat + 1 - (getCurrentEpoch split).toNat = e2 at *
  generalize (getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat = d at *
  have scaleEnv := Nat.mul_le_mul_right
    (preset.SLOTS_PER_EPOCH.toNat * preset.SYNC_COMMITTEE_SIZE.toNat * env) epochs
  have scaleShare := Nat.mul_le_mul_right
    (preset.SLOTS_PER_EPOCH.toNat * preset.SYNC_COMMITTEE_SIZE.toNat * share)
    (show e1 + e2 ≤ depth + depth by omega)
  have positions : ∑ v ∈ U ∪ cutKeys config pulled anc fin split, G v + (S +
      ∑ v ∈ cutKeys config pulled anc fin split, syncD eventsF v.toNat) ≤
      (ef + e1 + e2) * (preset.SLOTS_PER_EPOCH.toNat * preset.SYNC_COMMITTEE_SIZE.toNat * env) +
        (e1 + e2) *
          (preset.SLOTS_PER_EPOCH.toNat * preset.SYNC_COMMITTEE_SIZE.toNat * share) := by
    have tails : ∑ i ∈ P, (syncF (eventsP ++ events) i + syncF eventsC i) ≤
        e1 * preset.SLOTS_PER_EPOCH.toNat * preset.SYNC_COMMITTEE_SIZE.toNat * (env + share) +
          e2 * preset.SLOTS_PER_EPOCH.toNat * preset.SYNC_COMMITTEE_SIZE.toNat *
            (env + share) := by
      rw [splitP]
      exact Nat.add_le_add first second
    calc _ ≤ _ := Nat.add_le_add (toPositions.trans tails) sharedS
      _ = _ := by ring
  -- `extra` is paid by the same pools: `pre`'s credits and the cut keys' debits are in them
  have pay : 3 * (∑ v ∈ U, g v + S) + extra ≤
      3 * (∑ v ∈ U ∪ cutKeys config pulled anc fin split, G v +
        (S + ∑ v ∈ cutKeys config pulled anc fin split, syncD eventsF v.toNat)) := by
    have whole := Finset.sum_union cutU (f := G)
    have splitU : ∑ v ∈ U, G v = ∑ v ∈ U, syncF eventsP v.toNat + ∑ v ∈ U, g v := by
      rw [← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun v _ => hG v
    have splitCut : ∑ v ∈ cutKeys config pulled anc fin split, G v =
        ∑ v ∈ cutKeys config pulled anc fin split, syncF eventsP v.toNat +
          ∑ v ∈ cutKeys config pulled anc fin split, g v := by
      rw [← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun v _ => hG v
    have classesP : ∑ v ∈ U, syncF eventsP v.toNat = ∑ v ∈ V, syncF eventsP v.toNat +
        ∑ v ∈ K4 pulled counted V, syncF eventsP v.toNat +
        ∑ v ∈ K5 counted V, syncF eventsP v.toNat + ∑ v ∈ K6 pulled counted, syncF eventsP v.toNat +
        ∑ v ∈ SC pulled counted split, syncF eventsP v.toNat +
        ∑ v ∈ CS counted split, syncF eventsP v.toNat := by
      rw [hU, Finset.sum_union dCS, Finset.sum_union d4, Finset.sum_union d3, Finset.sum_union d2,
        Finset.sum_union d1]
    have credit (L : Finset ValidatorIndex) :
        ∑ v ∈ L, syncCr eventsP v.toNat ≤ ∑ v ∈ L, syncF eventsP v.toNat :=
      Finset.sum_le_sum fun v _ => by
        unfold syncCr
        rw [syncF_eq]
        exact Nat.le_add_right _ _
    have k5 := credit (K5 counted V)
    have sc := credit (SC pulled counted split)
    have cutTail : ∑ v ∈ cutKeys config pulled anc fin split, syncD events v.toNat ≤
        ∑ v ∈ cutKeys config pulled anc fin split, g v :=
      Finset.sum_le_sum fun v _ => by
        rw [hg]
        unfold syncD
        rw [syncF_eq]
        omega
    rw [hextra]
    omega
  calc 3 * (∑ v ∈ U, g v + S) + extra
      ≤ 3 * (∑ v ∈ U ∪ cutKeys config pulled anc fin split, G v +
          (S + ∑ v ∈ cutKeys config pulled anc fin split, syncD eventsF v.toNat)) := pay
    _ ≤ 3 * ((ef + e1 + e2) *
          (preset.SLOTS_PER_EPOCH.toNat * preset.SYNC_COMMITTEE_SIZE.toNat * env) +
        (e1 + e2) * (preset.SLOTS_PER_EPOCH.toNat * preset.SYNC_COMMITTEE_SIZE.toNat * share)) :=
        Nat.mul_le_mul_left _ positions
    _ ≤ 3 * ((depth + d) *
          (preset.SLOTS_PER_EPOCH.toNat * preset.SYNC_COMMITTEE_SIZE.toNat * env) +
        (depth + depth) *
          (preset.SLOTS_PER_EPOCH.toNat * preset.SYNC_COMMITTEE_SIZE.toNat * share)) :=
        Nat.mul_le_mul_left _ (Nat.add_le_add scaleEnv scaleShare)
    _ = _ := by ring

/-- The sync credits of any keys on C's branch are at most the seats' envelope and a share.

The share is the proposer's, and the bound weighs both at the depth, as `syncSeats` does. -/
private theorem syncCredits_le (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    (keys : Finset ℕ) :
    ∑ i ∈ keys, (eventsC.map (syncCredit i)).sum ≤
      (pinTerms config pulled anc fin).depth * preset.SLOTS_PER_EPOCH.toNat *
          preset.SYNC_COMMITTEE_SIZE.toNat *
          PinTerms.syncEnvelope preset ((getTotalActiveBalance pulled).toOption.getD 0).toNat +
        (pinTerms config pulled anc fin).depth * (pinTerms config pulled anc fin).syncProposer := by
  obtain ⟨pulledTotal, pulledOk⟩ := h.pulledTotal
  have finalized := UInt64.le_iff_toNat_le.mp h.finalized
  have called := UInt64.le_iff_toNat_le.mp h.called
  have near := h.near
  obtain ⟨fromFin⟩ := h.fromFin
  have run := syncF_run_le h pulledTotal pulledOk fromFin Run.nil rfl
    (.inl ⟨fromFin, rfl⟩) tailC near highC
    (by rw [run_nil_append]; exact replayedC) keys
  have credits : ∑ i ∈ keys, (eventsC.map (syncCredit i)).sum ≤ ∑ i ∈ keys, syncF eventsC i :=
    Finset.sum_le_sum fun i _ => (Nat.le_add_right _ _).trans (syncF_eq eventsC i).ge
  have totalEq := getD_total_eq pulledOk
  have proposer := syncProposer_eq config pulled anc fin
  have depthEq : (pinTerms config pulled anc fin).depth =
      (getCurrentEpoch pulled).toNat + 2 - anc.finalizedCheckpoint.epoch.toNat := rfl
  rw [proposer, totalEq]
  unfold PinSeatDebits.syncSeatEnvelope at run
  generalize (pinTerms config pulled anc fin).depth = depth at depthEq ⊢
  generalize PinTerms.syncEnvelope preset pulledTotal.toNat = env at *
  generalize env * PROPOSER_WEIGHT.toNat / (WEIGHT_DENOMINATOR.toNat - PROPOSER_WEIGHT.toNat) =
    share at *
  have depthCounted : (getCurrentEpoch counted).toNat + 1 - (getCurrentEpoch split).toNat ≤ depth :=
    by omega
  have bounded : ∑ i ∈ keys, syncF eventsC i ≤
      depth * preset.SLOTS_PER_EPOCH.toNat * preset.SYNC_COMMITTEE_SIZE.toNat * env +
        depth * preset.SLOTS_PER_EPOCH.toNat * preset.SYNC_COMMITTEE_SIZE.toNat * share := by
    refine run.trans ?_
    rw [Nat.mul_add]
    exact Nat.add_le_add
      (Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ depthCounted)))
      (Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ depthCounted)))
  calc _ ≤ _ := credits.trans bounded
    _ = _ := by ring

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- A run from a state after the split bounds a key's balance and effective balance by its credits.

The balance at the start, up to the cap bound, is at most `B`.

Then the balance up to the cap bound is at most `B`, the gains at the largest rate and the credits.

The effective balance at the end is at most that of the start, or that bound.

The cap bound is at least every cap along the run. -/
private theorem ceiling_run (h : Setting config checks g split fin pulled anc counted V)
    {c a : ForkedBeaconState preset} (toC : Run config checks ⟨fork, split⟩ c)
    (tail : Run config checks c a) (aEarly : a.fork < .glamsterdam) (aFork : a.fork ≤ fork)
    (i : ℕ) (inside : i < c.state.validators.data.size) (highC : ℕ)
    (endEpoch : (getCurrentEpoch a.state).toNat ≤ highC + 1)
    (near : (getCurrentEpoch a.state).toNat ≤ (getCurrentEpoch pulled).toNat + 1)
    (capHigh : ℕ) (capLe : capHigh ≤ preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat)
    (alignedCap : capHigh % preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0)
    (startCap : effectiveAt c i ≤ capHigh) (B : ℕ)
    (startBal : min (actualBalanceAt c i) capHigh ≤ B)
    (capCeil : ∀ z ∈ tail.balancePath, PinTerms.capAt z i ≤ capHigh) :
    (∀ z ∈ tail.balancePath, min (actualBalanceAt z i) capHigh ≤ B +
      ((getCurrentEpoch a.state).toNat - (getCurrentEpoch c.state).toNat) *
        (pinTerms config pulled anc fin).gainRateMax +
      (netScan i highC tail +
        (creditScan (fun _ => false) (fun s => decide (s ≠ .rewards)) i highC tail))) ∧
    effectiveAt a i ≤ max (effectiveAt c i) (B +
      ((getCurrentEpoch a.state).toNat - (getCurrentEpoch c.state).toNat) *
        (pinTerms config pulled anc fin).gainRateMax +
      (netScan i highC tail +
        (creditScan (fun _ => false) (fun s => decide (s ≠ .rewards)) i highC tail))) := by
  classical
  obtain ⟨P, hP, gainLe, -⟩ := pin_rate_exists h
  obtain ⟨P', hP', rateAll⟩ := key_rate_forked h
  rw [hP'.trans hP.symm] at rateAll
  have cFork : fork ≤ c.fork := fork_le_of_chainSteps toC.chainSteps
  have rate : ∀ z ∈ tail.balancePath, i.toUInt64 ∉ getActiveValidatorIndices z.state
        (getPreviousEpoch z.state) ∨
      ∀ total perIncrement : Gwei, getTotalActiveBalance z.state = .ok total →
        getBaseRewardPerIncrement preset total = .ok perIncrement →
        perIncrement.toNat * ((∑ j ∈ (getActiveValidatorIndices z.state
          (getPreviousEpoch z.state)).toFinset, effectiveAt z j.toNat) /
            preset.EFFECTIVE_BALANCE_INCREMENT.toNat) ≤
          P * (total.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat) := by
    intro z member
    right
    obtain ⟨r1, r2, -⟩ := balancePath_endpoint tail (Run.nil : Run config checks a a)
      (Nat.le_trans aFork cFork) member
    have order : (getCurrentEpoch z.state).toNat ≤ (getCurrentEpoch a.state).toNat :=
      UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps r2.chainSteps)
    exact rateAll z (toC.append r1) (Nat.le_trans (fork_le_of_chainSteps r2.chainSteps) aFork)
      (by omega)
  obtain ⟨-, -, third, fourth⟩ := PinKeyFloor.Run.effective_floor_pair tail aEarly
    (Nat.le_trans h.fulu cFork) i inside 0 0 capHigh highC
    preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat P
  have balances := fourth alignedCap startCap capCeil rate endEpoch
    (max_le (Nat.le_trans startCap capLe) (Nat.le_trans (Nat.min_le_left _ _) capLe))
  have ceiling := (third _ alignedCap startCap balances capCeil).1
  have gain := Nat.mul_le_mul_left ((getCurrentEpoch a.state).toNat -
    (getCurrentEpoch c.state).toNat) gainLe
  have credit : PinKeyFloor.creditBound tail i highC preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat P
      capHigh ≤ B +
        ((getCurrentEpoch a.state).toNat - (getCurrentEpoch c.state).toNat) *
          (pinTerms config pulled anc fin).gainRateMax +
        (netScan i highC tail +
          (creditScan (fun _ => false) (fun s => decide (s ≠ .rewards)) i highC tail)) := by
    unfold PinKeyFloor.creditBound
    omega
  exact ⟨fun z member => Nat.le_trans (balances z member) credit,
    Nat.le_trans ceiling (max_le (Nat.le_max_left _ _) (Nat.le_trans (Nat.min_le_left _ _)
      (Nat.le_trans (Nat.sub_le _ _) (Nat.le_trans credit (Nat.le_max_right _ _)))))⟩

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- A key beyond R's registry whose exit started on C's run rises at most by its credits and a band.

The exit is charged at the step that assigns it, with the effective balance before that step.

The band is the upward band at the epoch boundary before that step, where the key is active. -/
private theorem earlier_charge (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    {a b : ForkedBeaconState preset} (step : Step config checks a b) (member : tailC.Contains step)
    (i : ℕ) (created : split.validators.data.size ≤ i) (old : Validator)
    (foundA : a.state.validators.data[i]? = some old)
    (assigned : old.exitEpoch ≠ FAR_FUTURE_EPOCH) :
    effectiveAt a i ≤ chargeAmt tailC i + (preset.upwardBand +
      (pinTerms config pulled anc fin).depth * (pinTerms config pulled anc fin).gainRateMax +
      (credC tailC highC i + whistC tailC highC i + (eventsC.map (syncCredit i)).sum)) := by
  classical
  obtain ⟨shared⟩ := h.toFin
  obtain ⟨fromFin⟩ := h.fromFin
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  obtain ⟨pre, post, cut, aEarly, aEpoch⟩ :=
    DirectSafety.Apriori.Internal.Run.contains_step_facts member h.early
  have aFork : a.fork ≤ fork :=
    Nat.le_trans step.chainStep.fork_le (fork_le_of_chainSteps post.chainSteps)
  -- the key is absent at the split, so it has a charge on the run before `a`
  have unset : ∀ v, (⟨fork, split⟩ : ForkedBeaconState preset).state.validators.data[i]? =
      some v → v.exitEpoch = FAR_FUTURE_EPOCH := fun v found =>
    absurd (Array.getElem?_eq_some_iff.mp found).1 (by simp only; omega)
  obtain ⟨c0, c0Mem, c0Index, -⟩ :=
    PinKeys.Run.charge_of_exit pre electra aEarly i unset old foundA assigned
  obtain ⟨p, q, pre', step', post', cut', v, w, foundP, foundQ, unsetP, setQ, actP, amount, -⟩ :=
    charge_activated (x := ⟨fork, split⟩) electra pre c0 (pre.departure_charge_site c0 c0Mem)
  rw [c0Index] at foundP foundQ
  have inTailC : c0 ∈ tailC.departureCharges := by
    rw [cut, Run.departureCharges_append]
    simp [Run.departureCharges, c0Mem]
  have chargeEq : chargeAmt tailC i = c0.amount := by
    unfold chargeAmt
    rw [find_charge inTailC (by simp [c0Index])
      (fun d inD hd => charge_unique tailC inD inTailC (by simpa [c0Index] using hd))]
    rfl
  have pEarly : p.fork < .glamsterdam :=
    Nat.lt_of_le_of_lt (fork_le_of_chainSteps
      ((Run.nil.snoc step').append post' : Run config checks p a).chainSteps) aEarly
  -- the key is active at the start of the charge step
  have activeP : isActiveAt p.state (getCurrentEpoch p.state) i = true := by
    refine isActiveAt_eq_true_iff.mpr ⟨v, foundP, ?_⟩
    simp only [isActiveValidator, Bool.and_eq_true, decide_eq_true_eq]
    refine ⟨actP, UInt64.lt_iff_toNat_lt.mpr ?_⟩
    rw [unsetP]
    have := getCurrentEpoch_succ_lt_farFuture h.twoSlots p.state
    omega
  have splitP : (getCurrentEpoch split).toNat ≤ (getCurrentEpoch p.state).toNat :=
    UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps pre'.chainSteps)
  have pBound := (getCurrentEpoch p.state).toNat_lt
  -- so the run from the split crosses an epoch boundary before it
  have splitLt : (getCurrentEpoch split).toNat < (getCurrentEpoch p.state).toNat := by
    by_contra notLt
    have fixed : getCurrentEpoch p.state ≤ activityFixedEpoch split := by
      rw [UInt64.le_iff_toNat_le, activityFixedEpoch_toNat]
      omega
    have keep := activeKept_of_chainSteps pre'.chainSteps (getCurrentEpoch p.state) fixed i
    have activeSplit : isActiveAt split (getCurrentEpoch p.state) i = true := by
      rw [← keep]
      exact activeP
    obtain ⟨u, foundU, -⟩ := isActiveAt_eq_true_iff.mp activeSplit
    have := (Array.getElem?_eq_some_iff.mp foundU).1
    omega
  obtain ⟨z, cc, pre0, ok, rest0, splitEq, hz, hcc⟩ := PinKeys.Run.cross_split pre'
    ((getCurrentEpoch p.state).toNat - 1)
    (by show (getCurrentEpoch split).toNat ≤ (getCurrentEpoch p.state).toNat - 1; omega)
    (by omega)
  subst splitEq
  have ccEarly : cc.fork < .glamsterdam :=
    Nat.lt_of_le_of_lt (fork_le_of_chainSteps rest0.chainSteps) pEarly
  have fuluZ : .fusaka ≤ z.fork :=
    Nat.le_trans h.fulu (fork_le_of_chainSteps pre0.chainSteps)
  have hyst : Hysteresis cc.state :=
    hysteresis_of_crossing_slot ok h.bands fuluZ ccEarly (by omega)
  -- the key is in the registry at the first state of the epoch of the charge
  have fixedC : getCurrentEpoch p.state ≤ activityFixedEpoch cc.state := by
    rw [UInt64.le_iff_toNat_le, activityFixedEpoch_toNat]
    omega
  have keepC := activeKept_of_chainSteps rest0.chainSteps (getCurrentEpoch p.state) fixedC i
  have activeC : isActiveAt cc.state (getCurrentEpoch p.state) i = true := by
    rw [← keepC]
    exact activeP
  obtain ⟨vc, foundC, -⟩ := isActiveAt_eq_true_iff.mp activeC
  have insideC : i < cc.state.validators.data.size := (Array.getElem?_eq_some_iff.mp foundC).1
  have effEq : effectiveAt cc i = c0.amount := by
    have same := run_same_epoch_effective rest0 pEarly
      (UInt64.toNat_inj.mp (by omega)) i insideC
    have atP : effectiveAt p i = c0.amount := by simp [effectiveAt, foundP, amount]
    omega
  -- the run from the start of the epoch to the key's state
  obtain ⟨tail2, h2⟩ : ∃ t : Run config checks cc a, t = (rest0.snoc step').append post' :=
    ⟨_, rfl⟩
  have whole : pre = (pre0.snoc (Step.slot ok)).append tail2 := by
    rw [← cut', h2, Run.append_assoc]
    rfl
  have aElectra : .pectra ≤ a.fork := Nat.le_trans electra (fork_le_of_chainSteps pre.chainSteps)
  have capEnd := capAt_le_capMax h.caps aElectra i
  have toCC : Run config checks ⟨fork, split⟩ cc := pre0.snoc (Step.slot ok)
  have cFork : fork ≤ cc.fork := fork_le_of_chainSteps toCC.chainSteps
  have startEff : effectiveAt cc i ≤ PinTerms.capAt cc i :=
    effective_le_cap_at (shared.append (fromFin.append toCC)) h.genesis h.caps ccEarly i
  have capCC : PinTerms.capAt cc i ≤ PinTerms.capAt a i :=
    cap_le_cap_of_run h.caps tail2 aEarly i
  have alignedCap : PinTerms.capAt a i % preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0 := by
    have := congrArg UInt64.toNat
      (withdrawalMaxEffectiveBalance_aligned (fork := a.fork) h.aligned old)
    simpa [PinTerms.capAt, foundA, UInt64.toNat_mod] using this
  have capCeil := capCeil_path tail2 h.caps aEarly (Nat.le_trans aFork cFork) i
  have aEpoch' : (getCurrentEpoch a.state).toNat ≤ (getCurrentEpoch counted).toNat := aEpoch
  have nearC := h.near
  have near : (getCurrentEpoch a.state).toNat ≤ (getCurrentEpoch pulled).toNat + 1 := by omega
  have scans : netScan i highC tail2 +
      (creditScan (fun _ => false) (fun s => decide (s ≠ .rewards)) i highC tail2) ≤
      netScan i highC tailC +
        (creditScan (fun _ => false) (fun s => decide (s ≠ .rewards)) i highC tailC) := by
    have eqC : tailC = (((pre0.snoc (Step.slot ok)).append tail2).snoc step).append post := by
      rw [cut, whole]
    rw [eqC]
    simp only [netScan_append, creditScan_append, netScan_snoc, creditScan_snoc]
    split_ifs <;> omega
  have sources := credits_le_sources (shared.append fromFin) h.genesis tailC h.early electra i highC
    replayedC
  have finalized := UInt64.le_iff_toNat_le.mp h.finalized
  have called := UInt64.le_iff_toNat_le.mp h.called
  have ccLow : (getCurrentEpoch split).toNat ≤ (getCurrentEpoch cc.state).toNat :=
    UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps toCC.chainSteps)
  have depthEq : (pinTerms config pulled anc fin).depth =
      (getCurrentEpoch pulled).toNat + 2 - anc.finalizedCheckpoint.epoch.toNat := rfl
  by_cases flipCase : ¬effectiveAt cc i < PinTerms.capAt cc i ∧
      PinTerms.capAt a i ≠ PinTerms.capAt cc i
  · -- the key switched to compounding after the epoch start, with its effective balance at the cap
    obtain ⟨notBelow, capNe⟩ := flipCase
    have electraC : .pectra ≤ cc.fork := Nat.le_trans electra cFork
    have capCCmin : PinTerms.capAt cc i = preset.MIN_ACTIVATION_BALANCE.toNat := by
      have eqn := capAt_of_found electraC foundC
      split at eqn <;> omega
    obtain ⟨s, s', pre1, step1, post1, eq1, capS, capS', balS', epochAt⟩ :=
      Run.flip_split tail2 aEarly (Nat.le_trans h.fulu cFork)
        ((shared.append (fromFin.append toCC)).invariant h.genesis.invariant) i (by omega)
        (by omega)
    have sFork : s.fork ≤ fork := Nat.le_trans step1.chainStep.fork_le
      (Nat.le_trans (fork_le_of_chainSteps post1.chainSteps) aFork)
    have s'Fork : s'.fork ≤ fork := Nat.le_trans (fork_le_of_chainSteps post1.chainSteps) aFork
    have sEarly : s.fork < .glamsterdam := Nat.lt_of_le_of_lt sFork h.early
    have s'Early : s'.fork < .glamsterdam := Nat.lt_of_le_of_lt s'Fork h.early
    have insideS : i < s.state.validators.data.size :=
      Nat.lt_of_lt_of_le insideC pre1.registryLifecycle.size_le
    have insideS' : i < s'.state.validators.data.size := Nat.lt_of_lt_of_le insideS
      (Run.nil.snoc step1 : Run config checks s s').registryLifecycle.size_le
    have e1 := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps pre1.chainSteps)
    have e2 := UInt64.le_iff_toNat_le.mp
      (currentEpoch_le_of_chainSteps (Run.nil.snoc step1 : Run config checks s s').chainSteps)
    have e3 := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps post1.chainSteps)
    -- the switch step is a block step, so it keeps the epoch and the effective balances
    have epochEq := epochAt insideC
    have effS' : effectiveAt s' i = effectiveAt s i :=
      run_same_epoch_effective (Run.nil.snoc step1 : Run config checks s s') s'Early
        (UInt64.toNat_inj.mp epochEq) i insideS
    have minLe : preset.MIN_ACTIVATION_BALANCE.toNat ≤
        preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat :=
      UInt64.le_iff_toNat_le.mp h.caps.compounding
    have alignedMin : preset.MIN_ACTIVATION_BALANCE.toNat %
        preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0 := by
      simpa [UInt64.toNat_mod] using congrArg UInt64.toNat h.aligned.2.1
    -- the run from the epoch start to the switch, at the activation balance as cap
    obtain ⟨-, ceil1⟩ := ceiling_run h toCC pre1 sEarly sFork i insideC highC (by omega)
      (by omega) preset.MIN_ACTIVATION_BALANCE.toNat minLe alignedMin (by omega)
      (effectiveAt cc i + preset.upwardBand) (by omega)
      (fun z member => Nat.le_trans
        (capCeil_path pre1 h.caps sEarly (Nat.le_trans sFork cFork) i z member) capS)
    -- the run from the switch to the key's state, at its cap
    obtain ⟨-, ceil2⟩ := ceiling_run h (toCC.append (pre1.snoc step1)) post1 aEarly aFork i
      insideS' highC (by omega) near (PinTerms.capAt a i) capEnd alignedCap
      (Nat.le_trans (effective_le_cap_at (shared.append (fromFin.append
        (toCC.append (pre1.snoc step1)))) h.genesis h.caps s'Early i)
        (cap_le_cap_of_run h.caps post1 aEarly i))
      (effectiveAt cc i + stepCredit (fun _ => true) (fun _ => true) i step1) (by omega)
      (capCeil_path post1 h.caps aEarly (Nat.le_trans aFork
        (fork_le_of_chainSteps (toCC.append (pre1.snoc step1)).chainSteps)) i)
    -- the credits of the three parts are at most the sources of C's run
    have notSlot := step_flip_not_slot step1 s'Early
      (Nat.le_trans (Nat.le_trans h.fulu cFork) (fork_le_of_chainSteps pre1.chainSteps)) i
      insideS (by omega) capS'
    obtain ⟨eT, replayedT⟩ := tail2.balanceEvents_ok aEarly highC
    have eqC' : tailC = (pre0.snoc (Step.slot ok)).append
        (tail2.append ((Run.nil.snoc step).append post)) := by
      rw [cut, whole, Run.append_assoc, Run.append_assoc]
      rfl
    have part : credC tail2 highC i + whistC tail2 highC i + (eT.map (syncCredit i)).sum ≤
        credC tailC highC i + whistC tailC highC i + (eventsC.map (syncCredit i)).sum := by
      obtain ⟨eP, replayedP⟩ := (pre0.snoc (Step.slot ok)).balanceEvents_ok ccEarly highC
      obtain ⟨eQ, replayedQ⟩ := ((Run.nil.snoc step).append post).balanceEvents_ok h.early highC
      have joinedC := balanceEvents_append (pre0.snoc (Step.slot ok))
        (tail2.append ((Run.nil.snoc step).append post)) highC replayedP
        (balanceEvents_append tail2 ((Run.nil.snoc step).append post) highC replayedT replayedQ)
      rw [eqC', joinedC] at replayedC
      obtain rfl := Except.ok.inj replayedC
      rw [eqC']
      unfold credC whistC
      simp only [creditScan_append, List.map_append, List.sum_append]
      omega
    have around := flip_credits_le_sources (shared.append (fromFin.append toCC)) h.genesis pre1
      step1 post1 notSlot aEarly (Nat.le_trans electra cFork) i highC (by omega)
      (by rw [eq1]; exact replayedT)
    rw [eq1] at around
    have epochs : (getCurrentEpoch s.state).toNat - (getCurrentEpoch cc.state).toNat +
        ((getCurrentEpoch a.state).toNat - (getCurrentEpoch s'.state).toNat) ≤
        (pinTerms config pulled anc fin).depth := by omega
    have gains := Nat.mul_le_mul_right (pinTerms config pulled anc fin).gainRateMax epochs
    rw [Nat.add_mul] at gains
    rw [chargeEq]
    omega
  · have startBal : min (actualBalanceAt cc i) (PinTerms.capAt a i) ≤
        effectiveAt cc i + preset.upwardBand := by
      by_cases below : effectiveAt cc i < PinTerms.capAt cc i
      · cases hb : cc.state.balances.data[i]? with
        | none => simp [actualBalanceAt, hb]
        | some bal =>
          have up := hyst.up i vc bal foundC hb (UInt64.lt_iff_toNat_lt.mpr
            (by simpa [effectiveAt, PinTerms.capAt, foundC] using below))
          have read : actualBalanceAt cc i = bal.toNat := by simp [actualBalanceAt, hb]
          have eff : effectiveAt cc i = vc.effectiveBalance.toNat := by simp [effectiveAt, foundC]
          omega
      · have same : PinTerms.capAt a i = PinTerms.capAt cc i := by
          by_contra ne
          exact flipCase ⟨below, ne⟩
        have := Nat.min_le_right (actualBalanceAt cc i) (PinTerms.capAt a i)
        omega
    obtain ⟨-, ceiling⟩ := ceiling_run h toCC tail2 aEarly aFork i insideC highC (by omega) near
      (PinTerms.capAt a i) capEnd alignedCap (Nat.le_trans startEff capCC)
      (effectiveAt cc i + preset.upwardBand) startBal capCeil
    have epochs : (getCurrentEpoch a.state).toNat - (getCurrentEpoch cc.state).toNat ≤
        (pinTerms config pulled anc fin).depth := by omega
    have gains := Nat.mul_le_mul_right (pinTerms config pulled anc fin).gainRateMax epochs
    rw [chargeEq]
    omega

/-- The whistleblower credits of a set of keys over a run fit the limits of its slashing events. -/
private theorem whistC_sum_le_limits {g m y : ForkedBeaconState preset}
    (shared : Run config checks g m) (genesis : Genesis config checks g)
    (tail : Run config checks m y) (early : y.fork < .glamsterdam) (high : ℕ)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    (S : Finset ValidatorIndex) :
    ∑ v ∈ S, whistC tail high v.toNat ≤
      (events.map fun e => if e.source = .slashings then e.creditLimit else 0).sum := by
  obtain ⟨found, foundOk, bounded⟩ := Run.balanceEvents_bounded shared tail genesis early high
  rw [replayed] at foundOk
  cases foundOk
  simpa [whistC] using creditScan_sum_le S UInt64.toNat (fun s => decide (s = .slashings))
    (fun _ => false) high (fun e => e.creditLimit) tail replayed fun e member _ =>
      sum_keyCredit_le_creditLimit S e (bounded e member).1

/-- The positions of the keys slashed on C's branch after the split.

They are unslashed at the split and slashed at C. -/
private def slashedOnC (split counted : BeaconState preset fork) : Finset ℕ :=
  (Finset.range counted.validators.data.size).filter fun i =>
    (split.validators.data[i]?.map (·.slashed)).getD false = false ∧
      (counted.validators.data[i]?.map (·.slashed)).getD false = true

/-- The bound on the effective balance of a key of R's registry that R's call reads.

It is the key's effective balance, its rise and one increment, if R's branch slashes it.

It is also at least the key's effective balance at the finalized state.

A prefix state of the finalized epoch can reach that balance.

`branchR` pays that bound for such a key, and its increment covers the drop of R's penalty.

A key that `exitedSlashable`, `late` or `pendingR` charges is read at its balance and rise, or `bF`.

It is also read at its effective balance at the finalized state.

It is read without `ebUp`, which can exceed them.

Otherwise it is also at least the key's bound `ebUp`. -/
private def whistleEnv (t : PinTerms preset) (pulled anc fin : BeaconState preset fork) (i : ℕ) :
    ℕ :=
  if t.slashedRB i = true then
    max (balanceAt pulled i + t.rise i + preset.EFFECTIVE_BALANCE_INCREMENT.toNat) (balanceAt fin i)
  else if PinTerms.exitedSlashable anc pulled i = true ∨
      (t.tight = false ∧ (t.lateB i = true ∨ t.pendingRB i = true)) then
    max (balanceAt pulled i + t.rise i) (max (t.bF i) (balanceAt fin i))
  else max (max (t.ebUp i) (balanceAt pulled i + t.rise i)) (t.bF i)

/-- A balance within the finalized effective balance is within `whistleEnv`, plus any slack.

The first two branches of `whistleEnv` hold the finalized effective balance.

The third holds `ebUp`, which is at least that. -/
private theorem short_end (h : Setting config checks g split fin pulled anc counted V) (i : ℕ)
    {X : ℕ} (hfin : X ≤ balanceAt fin i) (slack : ℕ) :
    X ≤ whistleEnv (pinTerms config pulled anc fin) pulled anc fin i + slack := by
  have up : balanceAt fin i ≤ (pinTerms config pulled anc fin).ebUp i :=
    effective_fin_le_ebUp h i
  unfold whistleEnv
  split_ifs <;> omega

/-- A state of C's run in the epoch of a state `c` has its effective balance within `whistleEnv`.

The run from `c` to it stays in one epoch.

So a key of the registry at `c` keeps its effective balance there.

If that balance at `c` is within the finalized one, `short_end` reads it, plus any slack.

The finalized state is the case `c = fin`. -/
private theorem short_in_fin (h : Setting config checks g split fin pulled anc counted V)
    {c : BeaconState preset fork}
    (fromC : Run config checks ⟨fork, c⟩ ⟨fork, split⟩)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩)
    {a b : ForkedBeaconState preset} (step : Step config checks a b)
    (member : tailC.Contains step) (i : ℕ) (inside : i < c.validators.data.size)
    (left : effectiveAt (⟨fork, c⟩ : ForkedBeaconState preset) i ≤ balanceAt fin i) (slack : ℕ)
    (sameEpoch : (getCurrentEpoch a.state).toNat ≤ (getCurrentEpoch c).toNat) :
    effectiveAt a i ≤ whistleEnv (pinTerms config pulled anc fin) pulled anc fin i + slack := by
  obtain ⟨pre, post, -⟩ := tailC.contains_split step member
  have early : a.fork < .glamsterdam := Nat.lt_of_le_of_lt step.chainStep.fork_le
    (Nat.lt_of_le_of_lt (fork_le_of_chainSteps post.chainSteps) h.early)
  have forward : (getCurrentEpoch c).toNat ≤ (getCurrentEpoch a.state).toNat :=
    UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps (fromC.append pre).chainSteps)
  have same : getCurrentEpoch a.state = getCurrentEpoch c :=
    UInt64.toNat_inj.mp (by omega)
  have kept := (fromC.append pre).effectiveKept_of_same_epoch early same i inside
  exact short_end h i (by rw [kept]; exact left) slack

/-- The credits that raise the effective balance of a key of R's registry on C's branch.

They are the key's credits at eleven tenths, rounded up, with the bands of credits and seat debits.

The credits hold the key's own whistleblower credits.

Its unit of gain and the leak that its sync debits induce on R's run come on top, unscaled.

`bud_whistle_of` pays them with the sets that it counts.

The seat debits are those of the two runs that R shares with C.

A key that exited before the finalized state also holds its credits on the shared segment.

A sync credit there has the band of its rounding. -/
private def whistleSlackBase (t : PinTerms preset) {x y : ForkedBeaconState preset}
    (tail : Run config checks x y) {x' y' : ForkedBeaconState preset}
    (rrun : Run config checks x' y') (highC high : ℕ)
    (eventsC eventsF events : List (BalanceEvent preset)) (fin : BeaconState preset fork)
    (i : ℕ) : ℕ :=
  (11 * (propN tail highC i + depPre eventsC i + whistC tail highC i + syncCr eventsC i +
    consAmt eventsC i + syncD eventsF i + syncD events i) + 9) / 10 + bandC tail highC i +
    bandX fin highC i + bandR (eventsF ++ events) i +
    unitK t tail highC eventsC events eventsF i + inducedR t rrun i +
  if t.exitBeforeFin i = true then
    (11 * (syncCr eventsF i + consAmt eventsF i) + 9) / 10 + bandX fin high i +
      (if 0 < syncCr eventsF i then preset.upwardBand else 0)
  else 0

/-- The credits of `whistleSlackBase`, and a second unit of gain for a key that R slashes.

The second unit pays the joint floor that R's slashing penalty can tip. -/
private def whistleSlack (t : PinTerms preset) {x y : ForkedBeaconState preset}
    (tail : Run config checks x y) {x' y' : ForkedBeaconState preset}
    (rrun : Run config checks x' y') (highC high : ℕ)
    (eventsC eventsF events : List (BalanceEvent preset)) (fin : BeaconState preset fork)
    (i : ℕ) : ℕ :=
  whistleSlackBase t tail rrun highC high eventsC eventsF events fin i +
    (if 0 < slashW t i then t.unitGain else 0)

/-- What a created key's charge adds to the effective balance of the key at an earlier exit.

It is the band, the gains at the largest rate and the key's credits on C's branch. -/
private def whistleExtra (t : PinTerms preset) {x y : ForkedBeaconState preset}
    (tail : Run config checks x y) (high : ℕ) (eventsC : List (BalanceEvent preset)) (i : ℕ) :
    ℕ :=
  preset.upwardBand + t.depth * t.gainRateMax +
    (credC tail high i + whistC tail high i + syncCr eventsC i)

/-- The bound on the effective balance at its slashing of a key of the split's registry.

A key that is not active at C and has a departure charge on C's branch is also read at its charge.

That reading is the charge, the key's rise after it, and the slack.

A charge in the split's own epoch reads the balance before the credits of `pre`.

So the key's proposer, whistleblower and sync credits over `pre` are read too.

The slashing starts the key's exit, or finds the exit that an earlier charge started. -/
private def whistleRead (t : PinTerms preset) (pulled anc counted : BeaconState preset fork)
    {x y : ForkedBeaconState preset} (tail : Run config checks x y)
    {x' y' : ForkedBeaconState preset} (rrun : Run config checks x' y')
    {x'' y'' : ForkedBeaconState preset} (pre : Run config checks x'' y'') (highC high : ℕ)
    (eventsC eventsF events eventsP : List (BalanceEvent preset)) (fin : BeaconState preset fork)
    (i : ℕ) : ℕ :=
  if ¬ isActiveAt counted (getCurrentEpoch counted) i = true ∧
      (tail.departureCharges.any fun c => c.index == i) = true then
    min (whistleEnv t pulled anc fin i +
        whistleSlack t tail rrun highC high eventsC eventsF events fin i)
      (chargeAmt tail i + riseQ tail highC i + (propN pre highC i + whistC pre highC i +
        syncCr eventsP i) + whistleSlack t tail rrun highC high eventsC eventsF events fin i)
  else
    whistleEnv t pulled anc fin i + whistleSlack t tail rrun highC high eventsC eventsF events fin i

/-- The bound on the effective balance at its slashing of a key created after the split.

The key is active at C.

At a high gain rate it is the largest cap.

Otherwise it is the key's credits, their gains over the window, and a band. -/
private def createdCeil (t : PinTerms preset) {x y : ForkedBeaconState preset}
    (tail : Run config checks x y) (high : ℕ) (eventsC : List (BalanceEvent preset)) (i : ℕ) :
    ℕ :=
  let credits := credC tail high i + whistC tail high i + syncCr eventsC i
  let rate := t.perIncrement * (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum
  if t.gainHigh = true then preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat
  else
    credits + t.depth * (11 * credits / (10 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat) * rate /
      WEIGHT_DENOMINATOR.toNat) + t.depth * (rate / WEIGHT_DENOMINATOR.toNat + 2) +
        preset.downwardBand

/-- The gain of a created key's credits and base stake is at most the gain of its flows and a unit.

The key's base stake is credits, so it sits in the flows `Z`.

The flow of `Cr` and the slack `S - e0` compound at eleven tenths.

The floor holds the base gain `D * q` and `D`.

A key whose rate is low has `11 * D * q ≤ e0`, so its base gain is within a tenth of its stake.

The floors then lose one increment against the floor of the flows, which the unit pays. -/
private theorem created_gain_arith (I WD F P D e0 S Cr Z β : ℕ)
    (key : 11 * D * (P * F) < WD * I) (start : e0 ≤ S + β) (flows : Cr + S ≤ Z)
    (small : 11 * (β + D) < 10 * I) :
    D * (11 * (Cr + (S - e0) + D * (e0 / I * P * F / WD) + D) / (10 * I) * P * F / WD) +
        (D * (e0 / I * P * F / WD) + D) ≤
      D * (11 * Z / (10 * I) * P * F / WD) + D * (P * F / WD + 2) := by
  have hWD : 0 < WD := Nat.pos_of_ne_zero fun zero => by
    rw [zero] at key
    omega
  simp only [Nat.mul_assoc]
  obtain ⟨a, ha⟩ : ∃ a, a = P * F := ⟨_, rfl⟩
  rw [← ha] at key ⊢
  obtain ⟨N2, hN2⟩ : ∃ N2, N2 = e0 / I := ⟨_, rfl⟩
  rw [← hN2]
  obtain ⟨q, hq⟩ : ∃ q, q = N2 * a / WD := ⟨_, rfl⟩
  rw [← hq]
  -- the base gain is at most a eleventh of the stake
  have baseGain : 11 * (D * q) ≤ e0 := by
    have floor : q * WD ≤ N2 * a := by rw [hq]; exact Nat.div_mul_le_self _ _
    have step : 11 * D * q * WD ≤ WD * I * N2 := by
      calc 11 * D * q * WD = 11 * D * (q * WD) := by ring
        _ ≤ 11 * D * (N2 * a) := Nat.mul_le_mul_left _ floor
        _ = N2 * (11 * D * a) := by ring
        _ ≤ N2 * (WD * I) := Nat.mul_le_mul_left _ key.le
        _ = WD * I * N2 := by ring
    have cancel : 11 * D * q ≤ I * N2 := by
      refine Nat.le_of_mul_le_mul_right (c := WD) ?_ hWD
      calc 11 * D * q * WD ≤ WD * I * N2 := step
        _ = I * N2 * WD := by ring
    have rounded : I * N2 ≤ e0 := by rw [hN2]; exact Nat.mul_div_le _ _
    calc 11 * (D * q) = 11 * D * q := by ring
      _ ≤ e0 := Nat.le_trans cancel rounded
  obtain ⟨X, hX⟩ : ∃ X, X = Cr + (S - e0) + D * q + D := ⟨_, rfl⟩
  rw [← hX]
  have total : 11 * X + 10 * e0 ≤ 11 * Z + 11 * (β + D) := by omega
  -- the floors of the stake and of the credits add to one floor
  obtain ⟨N1, hN1⟩ : ∃ N1, N1 = 11 * X / (10 * I) := ⟨_, rfl⟩
  obtain ⟨N3, hN3⟩ : ∃ N3, N3 = 11 * Z / (10 * I) := ⟨_, rfl⟩
  rw [← hN1, ← hN3]
  have joint : N1 + N2 ≤ N3 + 1 := by
    have n2 : N2 = 10 * e0 / (10 * I) := by
      rw [hN2, Nat.mul_div_mul_left _ _ (by norm_num : 0 < 10)]
    have add := Nat.div_add_div_le_add_div (x := 11 * X) (y := 10 * e0) (z := 10 * I)
    have mono := Nat.div_le_div_right (c := 10 * I) total
    have more := Nat.add_div_le_div_add_div_add_one (11 * Z) (11 * (β + D)) (10 * I)
    have none : 11 * (β + D) / (10 * I) = 0 := Nat.div_eq_of_lt small
    omega
  have gains : N1 * a / WD + N2 * a / WD ≤ N3 * a / WD + a / WD + 1 := by
    have add := Nat.div_add_div_le_add_div (x := N1 * a) (y := N2 * a) (z := WD)
    have mono : (N1 + N2) * a / WD ≤ (N3 + 1) * a / WD :=
      Nat.div_le_div_right (Nat.mul_le_mul_right _ joint)
    have more := Nat.add_div_le_div_add_div_add_one (N3 * a) a WD
    rw [Nat.add_mul] at mono
    rw [Nat.add_mul, Nat.one_mul] at mono
    omega
  have scaled := Nat.mul_le_mul_left D gains
  rw [Nat.mul_add, Nat.mul_add, Nat.mul_add, Nat.mul_one] at scaled
  rw [← hq] at scaled
  rw [Nat.mul_add D (a / WD) 2]
  omega

/-- The deposits and consolidations that a run credits to a key are among its non-reward credits. -/
private theorem scan_deposits_consolidations_le (v high : ℕ) {x y : ForkedBeaconState preset}
    (run : Run config checks x y) :
    (creditScan (fun _ => false) (fun s => decide (s = .deposits)) v high run) +
      (creditScan (fun _ => false) (fun s => decide (s = .consolidations)) v high run) ≤
        (creditScan (fun _ => false) (fun s => decide (s ≠ .rewards)) v high run) := by
  have named := creditScan_or (fun _ => false) (fun s => decide (s ≠ .rewards))
    (fun _ => false) (fun _ => false)
    (fun s => decide (s = .deposits ∨ s = .consolidations))
    (fun s => decide (s ≠ .rewards ∧ s ≠ .deposits ∧ s ≠ .consolidations))
    (fun _ => rfl) (fun s => by cases s <;> decide) (fun _ => by simp)
    (fun s => by cases s <;> decide) v high run
  have pair := creditScan_or (fun _ => false)
    (fun s => decide (s = .deposits ∨ s = .consolidations)) (fun _ => false) (fun _ => false)
    (fun s => decide (s = .deposits)) (fun s => decide (s = .consolidations))
    (fun _ => rfl) (fun s => by cases s <;> decide) (fun _ => by simp)
    (fun s => by cases s <;> decide) v high run
  omega

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The effective balance of a key created on C's branch is at most its credits and their gains.

The run from the split reaches a state `z` where the key holds the activation reserve, and then C.

The bound holds at every state of C's run after `z`, and at C.

The key's base stake is credits, so one floor of the flows pays its gain.

The rate premise is that of the low regime: `key` reads it at the depth of the call. -/
private theorem created_ceiling (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    {v : ValidatorIndex} (activated : ∃ w, counted.validators.data[v.toNat]? = some w ∧
      w.activationEpoch ≠ FAR_FUTURE_EPOCH ∧ w.activationEpoch ≤ getCurrentEpoch counted)
    (absent : split.validators.data.size ≤ v.toNat) (P : ℕ)
    (hP : P = ((getBaseRewardPerIncrement preset
      (if 18 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤
          ((getTotalActiveBalance pulled).toOption.getD 0).toNat then
        (getTotalActiveBalance pulled).toOption.getD 0 / 4
      else preset.EFFECTIVE_BALANCE_INCREMENT / 5)).toOption.getD 0).toNat)
    (key : 11 * (min (pinTerms config pulled anc fin).depth
      ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat)) *
      (P * (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum) <
        WEIGHT_DENOMINATOR.toNat * preset.EFFECTIVE_BALANCE_INCREMENT.toNat) :
    let Z := credC tailC highC v.toNat + whistC tailC highC v.toNat + syncCr eventsC v.toNat
    ∃ (z : ForkedBeaconState preset) (pre : Run config checks ⟨fork, split⟩ z)
      (post : Run config checks z ⟨fork, counted⟩), tailC = pre.append post ∧ 0 < Z ∧
      (∀ p ∈ pre.balancePath, ∀ w : Validator, p.state.validators.data[v.toNat]? = some w →
        w.activationEpoch ≠ FAR_FUTURE_EPOCH →
        (getCurrentEpoch p.state).toNat + 1 < w.activationEpoch.toNat) ∧
      ∀ p ∈ post.balancePath, effectiveAt p v.toNat ≤ Z +
        (min (pinTerms config pulled anc fin).depth
          ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat)) *
          (11 * Z / (10 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat) * P *
            (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum / WEIGHT_DENOMINATOR.toNat) +
        (min (pinTerms config pulled anc fin).depth
          ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat)) *
          (P * (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum / WEIGHT_DENOMINATOR.toNat + 2) +
        preset.downwardBand := by
  classical
  intro Z
  obtain ⟨z, pre, post, splitEq, zEarly, zFork, zCounted, inside, funded, hysteresis, reserve,
    walk, -, ahead⟩ := created_start h tailC highC endEpochC
      activated absent
  obtain ⟨toFin⟩ := h.toFin
  obtain ⟨fromFin⟩ := h.fromFin
  have shared : Run config checks g ⟨fork, split⟩ := toFin.append fromFin
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  have flows : grossScan v.toNat highC tailC +
      (creditScan (fun _ => false) (fun s => decide (s ≠ .rewards)) v.toNat highC tailC) ≤ Z :=
    (credits_le_sources shared h.genesis tailC h.early electra v.toNat highC replayedC).1
  have incPos := h.bands.1
  have alignedMax := (cap_values_aligned h.aligned).2
  have fuluZ : .fusaka ≤ z.fork := Nat.le_trans h.fulu (fork_le_of_chainSteps pre.chainSteps)
  have electraZ : .pectra ≤ z.fork := Nat.le_trans (by decide) fuluZ
  obtain ⟨P', hP', rate⟩ := key_rate_pre h tailC h.near
  obtain rfl : P = P' := hP.trans hP'.symm
  have inRun : ∀ p ∈ post.balancePath, p ∈ tailC.balancePath := fun p member => by
    obtain ⟨front, last⟩ := Run.balancePath_last pre
    obtain ⟨rest, head⟩ := Run.balancePath_head post
    rw [head] at member
    rw [splitEq, Run.balancePath_append, last, head]
    rcases List.mem_cons.mp member with rfl | later <;> simp [*]
  have backZ : (⟨fork, counted⟩ : ForkedBeaconState preset).fork ≤ z.fork := by
    have := fork_le_of_chainSteps pre.chainSteps
    exact this
  have capCeil : ∀ p ∈ post.balancePath, PinTerms.capAt p v.toNat ≤
      preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat := fun p member => by
    obtain ⟨r1, -, -⟩ := balancePath_endpoint post
      (Run.nil : Run config checks ⟨fork, counted⟩ ⟨fork, counted⟩) backZ member
    exact capAt_le_capMax h.caps (Nat.le_trans electraZ (fork_le_of_chainSteps r1.chainSteps))
      v.toNat
  have splitZ := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps pre.chainSteps)
  have near := h.near
  have finalized := UInt64.le_iff_toNat_le.mp h.finalized
  have depthEq : (pinTerms config pulled anc fin).depth =
      (getCurrentEpoch pulled).toNat + 2 - anc.finalizedCheckpoint.epoch.toNat := rfl
  have finSplit : (getCurrentEpoch fin).toNat ≤ (getCurrentEpoch split).toNat :=
    epoch_le_of_slot_le fin.slot split.slot (Run.slot_le fromFin)
  obtain ⟨D, hD⟩ : ∃ D, D = min (pinTerms config pulled anc fin).depth
    ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) := ⟨_, rfl⟩
  rw [← hD] at key ⊢
  obtain ⟨e0, he0⟩ : ∃ e0, e0 = effectiveAt z v.toNat := ⟨_, rfl⟩
  obtain ⟨S, hS⟩ : ∃ S, S = actualBalanceAt z v.toNat := ⟨_, rfl⟩
  obtain ⟨Cr, hCr⟩ : ∃ Cr, Cr = netScan v.toNat highC post +
    (creditScan (fun _ => false) (fun s => decide (s ≠ .rewards)) v.toNat highC post) :=
    ⟨_, rfl⟩
  obtain ⟨W, hW⟩ : ∃ W, W = S - e0 := ⟨_, rfl⟩
  obtain ⟨q, hq⟩ : ∃ q, q = e0 / preset.EFFECTIVE_BALANCE_INCREMENT.toNat * P *
      (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum / WEIGHT_DENOMINATOR.toNat := ⟨_, rfl⟩
  obtain ⟨C, hC⟩ : ∃ C, C = preset.EFFECTIVE_BALANCE_INCREMENT.toNat *
      (11 * (Cr + W + D * q + D) / (10 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat)) :=
    ⟨_, rfl⟩
  have alignedE0 : e0 % preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0 := by
    rw [he0]
    exact FloorTrace.effective_aligned (shared.append pre) h.genesis h.aligned v.toNat
  have core := c_ceiling_abstract post h.early fuluZ v.toNat inside highC P
    preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat alignedMax
    (PinSeatDebits.effectiveAt_le_capMax (shared.append pre) h.genesis h.caps zEarly v.toNat)
    capCeil
    (fun p member total perIncrement totalOk perOk =>
      rate p (inRun p member) total perIncrement totalOk perOk)
    endEpochC incPos D Cr Cr e0 C S W (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum q rfl hq
    alignedE0 hC (by simp only at splitZ ⊢; omega) (by rw [hS]; exact Nat.min_le_left _ _)
    (by omega) (le_of_eq hCr.symm) key (by omega)
  obtain ⟨gc, rfl, -, bound, -⟩ := core
  -- the credits, the base stake and the gains of the key
  have beforeZ : S ≤ grossScan v.toNat highC pre +
      (creditScan (fun _ => false) (fun s => decide (s = .deposits)) v.toNat highC pre) +
      (creditScan (fun _ => false) (fun s => decide (s = .consolidations)) v.toNat highC
        pre) := by
    rw [hS]
    exact walk
  have splitScans := scan_deposits_consolidations_le v.toNat highC pre
  subst splitEq
  rw [grossScan_append, creditScan_append (fun _ => false) (fun s => decide (s ≠ .rewards))
    v.toNat highC pre post] at flows
  obtain ⟨e2, ok2⟩ := post.balanceEvents_ok h.early highC
  have netLe := (credits_le_sources (shared.append pre) h.genesis post h.early electraZ v.toNat
    highC ok2).2.1
  have credited : Cr + S ≤ Z := by omega
  -- the key's rate is low against an increment, so the depth is small
  have weights : (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum = 54 := by decide
  have denominator : WEIGHT_DENOMINATOR.toNat = 64 := by decide
  have quarter := h.facts.quarterBand
  have four : 4 ≤ P := by
    rw [hP]
    exact four_le_perIncrement h
  have small : 11 * (preset.downwardBand + D) < 10 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat := by
    rw [weights, denominator] at key
    have scaled := Nat.mul_le_mul_left D (show 4 * 54 ≤ P * 54 by omega)
    have regroup : 11 * D * (P * 54) = 11 * (D * (P * 54)) := by ring
    omega
  have arith := created_gain_arith preset.EFFECTIVE_BALANCE_INCREMENT.toNat
    WEIGHT_DENOMINATOR.toNat (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum P D e0 S Cr Z
    preset.downwardBand key (by rw [he0, hS]; exact hysteresis) credited small
  rw [← hq, ← hW] at arith
  refine ⟨z, pre, post, rfl, ?_, ahead, fun p member => ?_⟩
  · have := maxEffectiveBalance_pos h
    omega
  obtain ⟨r1, r2, cut⟩ := balancePath_endpoint post
    (Run.nil : Run config checks ⟨fork, counted⟩ ⟨fork, counted⟩) backZ member
  have prefixPath : ∀ z' ∈ r1.balancePath, z' ∈ post.balancePath := fun z' mem => by
    have joined : post.balancePath = r1.balancePath ++ r2.balancePath.tail := by
      rw [← Run.balancePath_append]
      exact congrArg Run.balancePath cut.symm
    rw [joined]
    exact List.mem_append_left _ mem
  have pEarly : p.fork < .glamsterdam :=
    Nat.lt_of_le_of_lt (fork_le_of_chainSteps r2.chainSteps) h.early
  have ceiling := PinKeyFloor.Run.effective_ceiling_of_balance_ceiling r1 pEarly fuluZ v.toNat
    inside
    (S + Cr + (D * (11 * (Cr + W + D * q + D) / (10 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat) *
      P * (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum / WEIGHT_DENOMINATOR.toNat) +
        (D * q + D)))
    preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat alignedMax
    (PinSeatDebits.effectiveAt_le_capMax (shared.append pre) h.genesis h.caps zEarly v.toNat)
    (fun z' mem => bound z' (prefixPath z' mem)) (fun z' mem => capCeil z' (prefixPath z' mem))
  obtain ⟨-, same, third, ordered⟩ := ceiling
  by_cases crossed : (getCurrentEpoch z.state).toNat < (getCurrentEpoch p.state).toNat
  · have := third crossed
    omega
  · have stays := same (by omega)
    omega

/-- Off the high gain rate, the full window's weighted gain is below an increment. -/
private theorem wide_of_lowGain (h : Setting config checks g split fin pulled anc counted V)
    (lowGain : (pinTerms config pulled anc fin).gainHigh = false) :
    11 * (pinTerms config pulled anc fin).depth *
        ((pinTerms config pulled anc fin).perIncrement *
          (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum) <
      WEIGHT_DENOMINATOR.toNat * preset.EFFECTIVE_BALANCE_INCREMENT.toNat := by
  have low : 11 * (pinTerms config pulled anc fin).depth *
      ((pinTerms config pulled anc fin).gainRateMax + 1) ≤
        preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat := by
    have notHigh : (!decide (11 * (pinTerms config pulled anc fin).depth *
      ((pinTerms config pulled anc fin).gainRateMax + 1) ≤
        preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat)) = false := lowGain
    simpa using notHigh
  have gainMax : (pinTerms config pulled anc fin).gainRateMax =
      preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat / preset.EFFECTIVE_BALANCE_INCREMENT.toNat *
        (pinTerms config pulled anc fin).perIncrement *
          (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum / WEIGHT_DENOMINATOR.toNat := rfl
  exact rate_per_increment preset.EFFECTIVE_BALANCE_INCREMENT.toNat
    WEIGHT_DENOMINATOR.toNat (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum
    (pinTerms config pulled anc fin).perIncrement
    preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat (pinTerms config pulled anc fin).depth
    h.bands.1 (by decide) (cap_values_aligned h.aligned).2 (by rw [← gainMax]; exact low)

/-- Off the high gain rate, the depth of the window is small against the rate.

It is below an eleventh of an increment.

It is the rate premise of `created_ceiling` and `created_key_ceiling`. -/
private theorem key_of_lowGain (h : Setting config checks g split fin pulled anc counted V)
    (lowGain : (pinTerms config pulled anc fin).gainHigh = false) :
    11 * (min (pinTerms config pulled anc fin).depth
      ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat)) *
        ((pinTerms config pulled anc fin).perIncrement *
          (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum) <
      WEIGHT_DENOMINATOR.toNat * preset.EFFECTIVE_BALANCE_INCREMENT.toNat := by
  exact Nat.lt_of_le_of_lt
    (Nat.mul_le_mul_right _ (Nat.mul_le_mul_left 11 (Nat.min_le_left _ _)))
    (wide_of_lowGain h lowGain)

/-- The kept arm's test bounds the gain at the full depth. -/
private theorem keptArm_eq (i : ℕ)
    (kept : (pinTerms config pulled anc fin).keptArm i = true) :
    11 * (pinTerms config pulled anc fin).depth *
        ((pinTerms config pulled anc fin).gainRate i + 1) ≤
      (pinTerms config pulled anc fin).ebUp i := by
  simp only [pinTerms, Bool.and_eq_true, decide_eq_true_eq] at kept
  exact kept.2

/-- The kept arm bounds the gain per increment up to the full depth. -/
private theorem key_of_kept (h : Setting config checks g split fin pulled anc counted V)
    (i D : ℕ) (depth : D ≤ (pinTerms config pulled anc fin).depth)
    (kept : (pinTerms config pulled anc fin).keptArm i = true) :
    11 * D * ((pinTerms config pulled anc fin).perIncrement *
        (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum) <
      WEIGHT_DENOMINATOR.toNat * preset.EFFECTIVE_BALANCE_INCREMENT.toNat := by
  exact rate_per_increment _ _ _ _ _ _ h.bands.1 (by decide) (ebUp_aligned h i)
    (Nat.le_trans (Nat.mul_le_mul_right _ (Nat.mul_le_mul_left 11 depth)) (keptArm_eq i kept))

/-- A key created after the split that is active at C has the bound `createdCeil` at its slashing.

Its credits since its creation are credits of C's branch, which `created_ceiling` reads.

The credits of the run are at most `credC`, `whistC` and the seat credits, so the bound reads them.

Off the high gain rate, `gainHigh` is false, which gives the rate premise of `created_ceiling`. -/
private theorem created_active (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    {a b : ForkedBeaconState preset} (step : Step config checks a b) (member : tailC.Contains step)
    (i : ℕ) (created : ¬ i < split.validators.data.size)
    (active : isActiveAt counted (getCurrentEpoch counted) i = true)
    (flag : (!(a.state.validators.data[i]?.map (·.slashed)).getD false &&
      (b.state.validators.data[i]?.map (·.slashed)).getD false) = true) :
    effectiveAt a i ≤ createdCeil (pinTerms config pulled anc fin) tailC highC eventsC i := by
  classical
  obtain ⟨shared⟩ := h.toFin
  obtain ⟨fromFin⟩ := h.fromFin
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  obtain ⟨pre', post', cut', aEarly, -⟩ :=
    DirectSafety.Apriori.Internal.Run.contains_step_facts member h.early
  by_cases high : (pinTerms config pulled anc fin).gainHigh = true
  · simp only [createdCeil, high, ↓reduceIte]
    exact PinSeatDebits.effectiveAt_le_capMax ((shared.append fromFin).append pre') h.genesis h.caps
      aEarly i
  have lowGain : (pinTerms config pulled anc fin).gainHigh = false := by simpa using high
  -- the key as a validator index
  obtain ⟨w, found, -⟩ := isActiveAt_eq_true_iff.mp active
  have inside := (Array.getElem?_eq_some_iff.mp found).1
  have below := inside.trans (BeaconState.validators_size_lt_of_lt_glamsterdam h.early counted)
  obtain ⟨v, hvi⟩ : ∃ v : ValidatorIndex, v.toNat = i :=
    ⟨UInt64.ofNat i, UInt64.toNat_ofNat_of_lt' below⟩
  subst hvi
  have member_active : v ∈ activeVoters counted :=
    List.mem_toFinset.mpr (mem_getActiveValidatorIndices_of_isActiveAt active)
  have activated := activated_of_activeVoters h.early member_active
  have absent : split.validators.data.size ≤ v.toNat := Nat.le_of_not_lt created
  have key := key_of_lowGain h lowGain
  obtain ⟨z, pre, post, cut, positive, ahead, bound⟩ := created_ceiling h tailC highC endEpochC
    replayedC activated absent (pinTerms config pulled anc fin).perIncrement rfl key
  -- the state `a` is a state of the run, so it is before `z` or after it
  have inPath : a ∈ tailC.balancePath := by
    rw [cut', Run.balancePath_append]
    refine List.mem_append_left _ ?_
    simp only [Run.balancePath, List.mem_append]
    exact .inr (List.mem_of_mem_head? (Step.balancePath_ends step).1)
  have ends : a ∈ pre.balancePath ∨ a ∈ post.balancePath := by
    rw [cut, Run.balancePath_append] at inPath
    rcases List.mem_append.mp inPath with first | later
    · exact .inl first
    · exact .inr (List.mem_of_mem_tail later)
  rcases ends with before | after
  · -- a key that the step slashes was activated by the epoch of `a`, which `z` comes after
    have bEarly : b.fork < .glamsterdam :=
      Nat.lt_of_le_of_lt (fork_le_of_chainSteps post'.chainSteps) h.early
    have finite : getCurrentEpoch a.state < FAR_FUTURE_EPOCH :=
      UInt64.lt_iff_toNat_lt.mpr (by
        have := getCurrentEpoch_succ_lt_farFuture h.twoSlots a.state
        omega)
    obtain ⟨u, found, far, reached⟩ := Step.slashed_activated step
      (Nat.le_trans electra (fork_le_of_chainSteps pre'.chainSteps)) bEarly h.caps.activation
      h.caps.compounding h.delay finite v.toNat
      (((shared.append fromFin).append pre').exit_activated h.genesis v.toNat) flag
    have := ahead a before u found far
    have := UInt64.le_iff_toNat_le.mp reached
    omega
  have ceiling := bound a after
  have minLe : min (pinTerms config pulled anc fin).depth
      ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) ≤
        (pinTerms config pulled anc fin).depth := Nat.min_le_left _ _
  simp only [createdCeil, lowGain, Bool.false_eq_true, ↓reduceIte]
  rw [Nat.mul_assoc (11 * _ / (10 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat))] at ceiling
  exact ceiling.trans (Nat.add_le_add (Nat.add_le_add (Nat.add_le_add_left
    (Nat.mul_le_mul_right _ minLe) _) (Nat.mul_le_mul_right _ minLe)) le_rfl)

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The whistleblower credits of any set of keys on C's branch are at most the reward base.

The base is the slashing reward of each key slashed on that branch, read at its balance then.

A key of the split's registry is read at the bound `registry` gives for it.

If it is not active at C and has a charge there, it is also read at `registryCharge`.

`registry` is asked for each key that is unslashed at the split, at each step of C's branch.

A key slashed before the split has no term, since its credit on C's branch is zero.

A key of R's registry that is also slashed on R's branch is a term of the first sum.

A consumer that pays those terms by another budget splits that sum by the key's slashing on R.

A key created after the split is read at `createdCeil` if it is active at C.

If it has exited by C, it is read at its charge and credits.

A charge in the split's own epoch also reads the credits of `pre`, the run from that epoch's start.

`registryCharge` takes the facts that tie `pre` to the run, and this lemma does not use them. -/
private theorem whistle_core (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩)
    {eventsF events : List (BalanceEvent preset)} (high : ℕ)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    {b : BeaconState preset fork} (pre : Run config checks ⟨fork, b⟩ ⟨fork, split⟩)
    {eventsP : List (BalanceEvent preset)}
    (registry : ∀ {a b : ForkedBeaconState preset} (step : Step config checks a b),
      tailC.Contains step → ∀ i, i < split.validators.data.size →
        (split.validators.data[i]?.map (·.slashed)).getD false = false →
        (!(a.state.validators.data[i]?.map (·.slashed)).getD false &&
          (b.state.validators.data[i]?.map (·.slashed)).getD false) = true →
          effectiveAt a i ≤ whistleEnv (pinTerms config pulled anc fin) pulled anc fin i +
            whistleSlack (pinTerms config pulled anc fin) tailC (fromFin.append tail) highC high
              eventsC eventsF events fin i)
    (registryCharge : ∀ {a b : ForkedBeaconState preset} (step : Step config checks a b),
      tailC.Contains step → ∀ i, i < split.validators.data.size →
        (split.validators.data[i]?.map (·.slashed)).getD false = false →
        (!(a.state.validators.data[i]?.map (·.slashed)).getD false &&
          (b.state.validators.data[i]?.map (·.slashed)).getD false) = true →
        (tailC.departureCharges.any fun c => c.index == i) = true →
          effectiveAt a i ≤ chargeAmt tailC i + riseQ tailC highC i +
            (propN pre highC i + whistC pre highC i + syncCr eventsP i) +
            whistleSlack (pinTerms config pulled anc fin) tailC (fromFin.append tail) highC high
              eventsC eventsF events fin i)
    (S : Finset ValidatorIndex) :
    ∑ v ∈ S, whistC tailC highC v.toNat ≤
      (∑ i ∈ (slashedOnC split counted).filter (fun i => i < split.validators.data.size),
        min (whistleRead (pinTerms config pulled anc fin) pulled anc counted tailC
            (fromFin.append tail) pre highC high eventsC eventsF events eventsP fin i)
          preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat /
            (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat) +
      (∑ i ∈ ((slashedOnC split counted).filter (fun i => ¬ i < split.validators.data.size)).filter
          (fun i => isActiveAt counted (getCurrentEpoch counted) i = true),
        min (createdCeil (pinTerms config pulled anc fin) tailC highC eventsC i)
          preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat /
          (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat) +
      (∑ i ∈ ((slashedOnC split counted).filter (fun i => ¬ i < split.validators.data.size)).filter
          (fun i => ¬ isActiveAt counted (getCurrentEpoch counted) i = true),
        min (chargeAmt tailC i +
            whistleExtra (pinTerms config pulled anc fin) tailC highC eventsC i)
          preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat /
            (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat) := by
  classical
  obtain ⟨shared⟩ := h.toFin
  have limit := whistC_sum_le_limits (shared.append fromFin) h.genesis tailC h.early highC
    replayedC S
  obtain ⟨E, hE⟩ : ∃ E : ℕ → ℕ, ∀ i, E i =
      if (split.validators.data[i]?.map (·.slashed)).getD false = false then
        min (whistleRead (pinTerms config pulled anc fin) pulled anc counted tailC
            (fromFin.append tail) pre highC high eventsC eventsF events eventsP fin i)
          preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat
      else preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat := ⟨_, fun _ => rfl⟩
  obtain ⟨cr, hcr⟩ : ∃ cr : ℕ → ℕ, ∀ i, cr i =
      if isActiveAt counted (getCurrentEpoch counted) i = true then
        min (createdCeil (pinTerms config pulled anc fin) tailC highC eventsC i)
          preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat /
          (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat
      else min (chargeAmt tailC i +
          whistleExtra (pinTerms config pulled anc fin) tailC highC eventsC i)
          preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat /
        (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat := ⟨_, fun _ => rfl⟩
  -- the keys of R's registry are read at `registry`, or at the largest cap if slashed at the split
  have regE : ∀ {a b : ForkedBeaconState preset} (step : Step config checks a b),
      tailC.Contains step → ∀ i, i < split.validators.data.size →
        (!(a.state.validators.data[i]?.map (·.slashed)).getD false &&
          (b.state.validators.data[i]?.map (·.slashed)).getD false) = true →
        effectiveAt a i ≤ E i := by
    intro a b step member i inside flag
    rw [hE i]
    obtain ⟨pre, -, -, aEarly, -⟩ :=
      DirectSafety.Apriori.Internal.Run.contains_step_facts member h.early
    have capped := PinSeatDebits.effectiveAt_le_capMax ((shared.append fromFin).append pre)
      h.genesis
      h.caps aEarly i
    by_cases unslashed : (split.validators.data[i]?.map (·.slashed)).getD false = false
    · simp only [unslashed]
      refine le_min ?_ capped
      simp only [whistleRead]
      split
      · rename_i cond
        exact le_min (registry step member i inside unslashed flag)
          (registryCharge step member i inside unslashed flag cond.2)
      · exact registry step member i inside unslashed flag
    · simp only [unslashed]
      exact capped
  -- the created keys are read at `createdCeil` while active at C, and at their charge after
  have createdE : ∀ {a b : ForkedBeaconState preset} (step : Step config checks a b),
      tailC.Contains step → ∀ i, split.validators.data.size ≤ i →
        (!(a.state.validators.data[i]?.map (·.slashed)).getD false &&
          (b.state.validators.data[i]?.map (·.slashed)).getD false) = true →
        effectiveAt a i / (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat ≤ cr i := by
    intro a b step member i created flag
    rw [hcr i]
    obtain ⟨pre, -, -, aEarly, -⟩ :=
      DirectSafety.Apriori.Internal.Run.contains_step_facts member h.early
    have capped := PinSeatDebits.effectiveAt_le_capMax ((shared.append fromFin).append pre)
      h.genesis
      h.caps aEarly i
    by_cases act : isActiveAt counted (getCurrentEpoch counted) i = true
    · simp only [act]
      exact Nat.div_le_div_right (le_min (created_active h tailC highC endEpochC replayedC step
        member i (Nat.not_lt.mpr created) act flag) capped)
    · simp only [act]
      exact Nat.div_le_div_right (le_min (created_charge h fromFin tailC
        (whistleExtra (pinTerms config pulled anc fin) tailC highC eventsC)
        (fun step member i created old foundA assigned =>
          earlier_charge h tailC highC endEpochC replayedC step member i created old foundA
            assigned) step member i created flag) capped)
  have charged := slashing_charge h fromFin tailC highC endEpochC replayedC E cr regE createdE
  refine limit.trans (charged.trans (le_of_eq ?_))
  -- the sum over the slashed keys splits into the three kinds of key
  change ∑ i ∈ slashedOnC split counted, _ = _
  rw [← Finset.sum_filter_add_sum_filter_not (slashedOnC split counted)
    (fun i => i < split.validators.data.size)]
  rw [← Finset.sum_filter_add_sum_filter_not
    ((slashedOnC split counted).filter (fun i => ¬ i < split.validators.data.size))
    (fun i => isActiveAt counted (getCurrentEpoch counted) i = true)]
  rw [← add_assoc]
  congr 1
  congr 1
  · refine Finset.sum_congr rfl fun i member => ?_
    obtain ⟨inSlashed, inside⟩ := Finset.mem_filter.mp member
    have unslashed := (Finset.mem_filter.mp inSlashed).2.1
    simp only [inside, ↓reduceIte, hE i, unslashed]
  · refine Finset.sum_congr rfl fun i member => ?_
    obtain ⟨inNew, act⟩ := Finset.mem_filter.mp member
    have outside := (Finset.mem_filter.mp inNew).2
    simp [outside, hcr i, act]
  · refine Finset.sum_congr rfl fun i member => ?_
    obtain ⟨inNew, act⟩ := Finset.mem_filter.mp member
    have outside := (Finset.mem_filter.mp inNew).2
    simp [outside, hcr i, act]

/-- The sum of a function of the positions over the images of the positions of a set is its sum. -/
private theorem sum_image_ofNat (T : Finset ℕ) (small : ∀ i ∈ T, i < 2 ^ 64) (f : ℕ → ℕ) :
    ∑ v ∈ T.image UInt64.ofNat, f v.toNat = ∑ i ∈ T, f i := by
  rw [Finset.sum_image fun a ha b hb same => by
    rw [← UInt64.toNat_ofNat_of_lt' (small a ha), ← UInt64.toNat_ofNat_of_lt' (small b hb), same]]
  exact Finset.sum_congr rfl fun i member => by rw [UInt64.toNat_ofNat_of_lt' (small i member)]

/-- A slashed flag at a position of the registry is the flag that `slashedOnC` reads. -/
private theorem slashedFlagAt_eq_some {s : BeaconState preset fork} {i : ℕ} {b : Bool} :
    slashedFlagAt s i = some b ↔
      i < s.validators.data.size ∧ (s.validators.data[i]?.map (·.slashed)).getD false = b := by
  constructor
  · intro flag
    have inside : i < s.validators.data.size := by
      by_contra out
      simp [slashedFlagAt, Array.getElem?_eq_none (Nat.le_of_not_lt out)] at flag
    refine ⟨inside, ?_⟩
    unfold slashedFlagAt at flag
    rw [flag]
    rfl
  · rintro ⟨inside, flag⟩
    simp only [slashedFlagAt, Array.getElem?_eq_getElem inside, Option.map_some] at flag ⊢
    simpa using flag

/-- The keys of `SC` are the keys of `slashedOnC` inside the split's registry, read at positions. -/
private theorem sum_SC_positions (h : Setting config checks g split fin pulled anc counted V)
    (f : ℕ → ℕ) :
    ∑ v ∈ SC pulled counted split, f v.toNat =
      ∑ i ∈ (slashedOnC split counted).filter (fun i => i < split.validators.data.size), f i := by
  classical
  obtain ⟨toPulled⟩ := h.toPulled
  have grows : split.validators.data.size ≤ pulled.validators.data.size :=
    registryGrows_of_chainSteps toPulled.chainSteps
  have limit := BeaconState.validators_size_lt_of_lt_glamsterdam h.early pulled
  rw [← Finset.sum_image (f := f) (g := UInt64.toNat) fun a _ b _ same => UInt64.toNat_inj.mp same]
  refine Finset.sum_congr ?_ fun _ _ => rfl
  ext i
  constructor
  · intro mem
    obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp mem
    obtain ⟨-, hcs, hss⟩ := Finset.mem_filter.mp hv
    obtain ⟨hsplit, flagS⟩ := slashedFlagAt_eq_some.mp hss
    obtain ⟨hcount, flagC⟩ := slashedFlagAt_eq_some.mp hcs
    exact Finset.mem_filter.mpr
      ⟨Finset.mem_filter.mpr ⟨Finset.mem_range.mpr hcount, flagS, flagC⟩, hsplit⟩
  · intro mem
    obtain ⟨hmem, hin⟩ := Finset.mem_filter.mp mem
    obtain ⟨hrange, hsl, hcs⟩ := Finset.mem_filter.mp hmem
    have below := (Nat.lt_of_lt_of_le hin grows).trans limit
    refine Finset.mem_image.mpr ⟨UInt64.ofNat i, ?_, UInt64.toNat_ofNat_of_lt' below⟩
    rw [SC, Finset.mem_filter, UInt64.toNat_ofNat_of_lt' below]
    exact ⟨Finset.mem_image.mpr ⟨i, Finset.mem_range.mpr (by omega), rfl⟩,
      slashedFlagAt_eq_some.mpr ⟨Finset.mem_range.mp hrange, hcs⟩,
      slashedFlagAt_eq_some.mpr ⟨hin, hsl⟩⟩

/-- The keys of `CS` are the keys of `slashedOnC` beyond the split's registry, read at positions. -/
private theorem sum_CS_positions (h : Setting config checks g split fin pulled anc counted V)
    (f : ℕ → ℕ) :
    ∑ v ∈ CS counted split, f v.toNat =
      ∑ i ∈ (slashedOnC split counted).filter (fun i => ¬ i < split.validators.data.size), f i := by
  classical
  rw [← Finset.sum_image (f := f) (g := UInt64.toNat) fun a _ b _ same => UInt64.toNat_inj.mp same]
  refine Finset.sum_congr ?_ fun _ _ => rfl
  ext i
  constructor
  · intro mem
    obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp mem
    obtain ⟨-, hge, hcs⟩ := Finset.mem_filter.mp hv
    obtain ⟨hcount, flagC⟩ := slashedFlagAt_eq_some.mp hcs
    refine Finset.mem_filter.mpr ⟨Finset.mem_filter.mpr ⟨Finset.mem_range.mpr hcount, ?_, flagC⟩,
      Nat.not_lt.mpr hge⟩
    simp [Array.getElem?_eq_none hge]
  · intro mem
    obtain ⟨hmem, hout⟩ := Finset.mem_filter.mp mem
    obtain ⟨hrange, hsl, hcs⟩ := Finset.mem_filter.mp hmem
    have below := (Finset.mem_range.mp hrange).trans
      (BeaconState.validators_size_lt_of_lt_glamsterdam h.early counted)
    refine Finset.mem_image.mpr ⟨UInt64.ofNat i, ?_, UInt64.toNat_ofNat_of_lt' below⟩
    rw [CS, Finset.mem_filter, UInt64.toNat_ofNat_of_lt' below]
    exact ⟨Finset.mem_image.mpr ⟨i, hrange, rfl⟩, Nat.not_lt.mp hout,
      slashedFlagAt_eq_some.mpr ⟨Finset.mem_range.mp hrange, hcs⟩⟩

/-- The keys of `SC` that satisfy a test at their positions are those positions of `slashedOnC`. -/
private theorem sum_SC_filter_positions (h : Setting config checks g split fin pulled anc counted V)
    (p : ℕ → Prop) [DecidablePred p] (f : ℕ → ℕ) :
    ∑ v ∈ SC pulled counted split with p v.toNat, f v.toNat =
      ∑ i ∈ ((slashedOnC split counted).filter (fun i => i < split.validators.data.size)).filter p,
        f i :=
  (Finset.sum_filter _ _).trans ((sum_SC_positions h (fun i => if p i then f i else 0)).trans
    (Finset.sum_filter _ _).symm)

/-- A key that C slashes after the split, and that R neither slashes nor exits, keeps its exit late.

The exit guard of its run from the finalized block holds along the run.

Its exit at C is after R's cutoff less the delay.

The exit is assigned on C's run, so it is a departure charge there, after the split.

Or it is assigned by the split, and then it is kept, and so it is R's exit.

R's exit is then after the cutoff.

Or R holds the key withdrawable by the finalized epoch, which `sc3a_unwithdrawn` excludes. -/
private theorem slashedC_retained (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (i : ValidatorIndex)
    (slashedC : i.toNat ∈ slashedOnC split counted)
    (inside : i.toNat < split.validators.data.size)
    (notR : ¬ (pinTerms config pulled anc fin).slashedRB i.toNat = true)
    (notExit : ¬ PinTerms.exitedSlashable anc pulled i.toNat = true) :
    ∀ {m n : ForkedBeaconState preset} (before : Run config checks ⟨fork, fin⟩ m)
      (step : Step config checks m n) (after : Run config checks n ⟨fork, counted⟩),
      (before.snoc step).append after = fromFin.append tailC → ∀ w,
      n.state.validators.data[i.toNat]? = some w →
      ((getCurrentEpoch pulled).toNat + 1 < w.exitEpoch.toNat ∨
        ∀ u, m.state.validators.data[i.toNat]? = some u →
          (getCurrentEpoch pulled).toNat + 1 < u.withdrawableEpoch.toNat) := by
  classical
  obtain ⟨hLt, hSplit, hCount⟩ : i.toNat < counted.validators.data.size ∧
      (split.validators.data[i.toNat]?.map (·.slashed)).getD false = false ∧
      (counted.validators.data[i.toNat]?.map (·.slashed)).getD false = true := by
    simpa [slashedOnC] using slashedC
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  obtain ⟨vS, foundS⟩ : ∃ v, split.validators.data[i.toNat]? = some v :=
    ⟨_, Array.getElem?_eq_getElem inside⟩
  obtain ⟨wC, foundC⟩ : ∃ w, counted.validators.data[i.toNat]? = some w :=
    ⟨_, Array.getElem?_eq_getElem hLt⟩
  have unslashedS : vS.slashed = false := by simpa [foundS] using hSplit
  have slashedAtC : wC.slashed = true := by simpa [foundC] using hCount
  have finalized := UInt64.le_iff_toNat_le.mp h.finalized
  have called := UInt64.le_iff_toNat_le.mp h.called
  have finSplit := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps fromFin.chainSteps)
  simp only at finSplit
  have shallow := h.shallow
  have slashC := tailC.newly_slashed_withdrawableEpoch h.caps.activation h.caps.compounding
    h.early h.delay i.toNat vS wC foundS foundC unslashedS slashedAtC
  have late : (getCurrentEpoch pulled).toNat + 1 <
      wC.exitEpoch.toNat + config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat := by
    by_cases unset : vS.exitEpoch = FAR_FUTURE_EPOCH
    · obtain ⟨c, mem, -, epoch⟩ := PinKeys.Run.charge_of_exit tailC electra h.early i.toNat
        (fun v found => by
          rw [foundS] at found
          cases found
          exact unset) wC foundC slashC.1
      have start := Run.departureCharges_epoch_ge_start tailC electra h.early c mem
      simp only at start
      omega
    · obtain ⟨wL, foundL, kept⟩ := tailC.registryLifecycle.validators i.toNat vS foundS
      obtain rfl : wL = wC := Option.some.inj (foundL.symm.trans foundC)
      have exitC := congrArg UInt64.toNat (kept.exitEpoch unset)
      obtain ⟨wR, foundR, keptR⟩ := tail.registryLifecycle.validators i.toNat vS foundS
      have exitR := congrArg UInt64.toNat (keptR.exitEpoch unset)
      by_cases far : (getCurrentEpoch pulled).toNat + 1 < wR.exitEpoch.toNat
      · omega
      have unslashedR : wR.slashed = false := by
        by_contra marked
        exact notR (slashedRB_of_newly_slashed h foundS foundR unslashedS (by simpa using marked))
      exfalso
      refine sc3a_unwithdrawn h foundS foundR foundC unslashedS slashedAtC unslashedR ?_
      by_contra waiting
      have reached : wR.exitEpoch.toNat ≤ (getCurrentEpoch pulled).toNat + 1 := by omega
      have lt := Nat.lt_of_not_le waiting
      apply notExit
      simp [PinTerms.exitedSlashable, foundR, unslashedR, reached, lt]
  intro m n before step after cut w found
  exact retained_of_exit h fromFin tailC _ (Nat.le_refl _) i foundC late before step after cut w
    found

/-- A key that R holds withdrawable by the next epoch is a key with `withdrawnRB`. -/
private theorem withdrawnRB_of_le (config : Config) (pulled anc fin : BeaconState preset fork)
    {i : ℕ} {w : Validator} (found : pulled.validators.data[i]? = some w)
    (le : w.withdrawableEpoch.toNat ≤ (getCurrentEpoch pulled).toNat + 1) :
    (pinTerms config pulled anc fin).withdrawnRB i = true := by
  simp only [pinTerms]
  simp [found, le]

/-- The deposit credits of some events are within `depPre` when each credited one is unslashed. -/
private theorem deposits_le_depPre (L : List (BalanceEvent preset)) (i : ℕ)
    (clean : ∀ e ∈ L, e.source = .deposits →
      keyCredit i e = 0 ∨ ¬ slashedFlagAt e.before.state i = some true) :
    ((L.filter fun e => e.source = .deposits).map (keyCredit i)).sum ≤ depPre L i := by
  induction L with
  | nil => simp [depPre]
  | cons e rest ih =>
    have tail := ih fun x member => clean x (List.mem_cons_of_mem _ member)
    unfold depPre at tail ⊢
    by_cases dep : e.source = .deposits
    · rcases clean e List.mem_cons_self dep with zero | unslashed
      · by_cases slashed : slashedFlagAt e.before.state i = some true <;>
          simp [dep, zero, slashed] <;> omega
      · simp [dep, unslashed]
        omega
    · simp [dep]
      omega

/-- Each deposit of a run's replay that credits a key finds it unslashed.

The run ends with the key unslashed.

A deposit event of a block credits no balance.

One of a slot step starts from a state that does not hold the key slashed.

A slashed key stays slashed up to the end of the run. -/
private theorem prefix_deposits_clean (h : Setting config checks g split fin pulled anc counted V)
    {a : ForkedBeaconState preset} (pre : Run config checks ⟨fork, split⟩ a)
    (aEarly : a.fork < .glamsterdam) (highC : ℕ) {e1 : List (BalanceEvent preset)}
    (replayed1 : pre.balanceEvents highC = .ok e1) (v : ValidatorIndex)
    (unslashedA : (a.state.validators.data[v.toNat]?.map (·.slashed)).getD false = false) :
    ∀ e ∈ e1, e.source = .deposits →
      keyCredit v.toNat e = 0 ∨ ¬ slashedFlagAt e.before.state v.toNat = some true := by
  obtain ⟨toFin⟩ := h.toFin
  obtain ⟨fromFin⟩ := h.fromFin
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  intro e member dep
  rcases (run_located pre electra aEarly highC replayed1).1 e member dep with
    unconditional | ⟨u, w, ok, es, contains, replayedEs, inEs, -⟩
  · have := unconditional v.toNat
    unfold keyCredit
    omega
  · right
    intro slashed
    obtain ⟨p1, p2, -⟩ := pre.contains_split (Step.slot ok) contains
    have wEarly : w.fork < .glamsterdam :=
      Nat.lt_of_le_of_lt (fork_le_of_chainSteps p2.chainSteps) aEarly
    have holds := Run.invariant h.genesis.invariant ((toFin.append fromFin).append p1)
    obtain ⟨-, -, -, -, -, -, -, -, -, -, -, -, one, two, -⟩ :=
      (Step.balanceEvents_sites (Step.slot ok) wEarly holds h.caps.compounding replayedEs) e inEs
    obtain ⟨x, found, flagged⟩ : ∃ x, e.before.state.validators.data[v.toNat]? = some x ∧
        x.slashed = true := by
      unfold slashedFlagAt at slashed
      cases hx : e.before.state.validators.data[v.toNat]? <;> simp_all
    obtain ⟨y, foundA, flagA⟩ :=
      ((one.trans two).trans p2.slashedPersistence) v.toNat x found flagged
    simp [foundA, flagA] at unslashedA

/-- A run split at a step is the run before it and the run from the step. -/
private theorem snoc_append_eq {a b c : ForkedBeaconState preset}
    (pre : Run config checks ⟨fork, split⟩ a) (step : Step config checks a b)
    (post : Run config checks b c) :
    (pre.snoc step).append post = pre.append ((Run.nil.snoc step).append post) := by
  rw [Run.append_assoc]
  rfl

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- A bound along R's run from the first state of a key holds on the whole run.

Before the first state `c` the key is absent, so its effective balance is zero there. -/
private theorem path_le_of_start {a e : ForkedBeaconState preset} {c : BeaconState preset fork}
    (toC : Run config checks a ⟨fork, c⟩) (fromC : Run config checks ⟨fork, c⟩ e) (i X : ℕ)
    (before : ∀ p ∈ toC.balancePath, p = ⟨fork, c⟩ ∨ effectiveAt p i = 0)
    (after : ∀ z ∈ fromC.balancePath, effectiveAt z i ≤ X) :
    ∀ z ∈ (toC.append fromC).balancePath, effectiveAt z i ≤ X := by
  intro z member
  rw [Run.balancePath_append] at member
  rcases List.mem_append.mp member with front | later
  · rcases before z front with atC | zero
    · obtain ⟨rest, head⟩ := Run.balancePath_head fromC
      rw [atC]
      exact after _ (by rw [head]; exact List.mem_cons_self)
    · rw [zero]
      exact Nat.zero_le _
  · exact after z (List.mem_of_mem_tail later)

/-- No due entry names a key past the registry when the targets of the queue are inside it. -/
private theorem dueAt_eq_zero_of_targets (X : BeaconState preset fork) (high : ℕ)
    {v : ValidatorIndex}
    (inside : ∀ electra : .pectra ≤ fork, ∀ c ∈ (X.pendingConsolidations electra).data.toList,
      c.targetIndex.toNat < X.validators.data.size)
    (outside : X.validators.data.size ≤ v.toNat) : dueAt X high {v} = 0 := by
  unfold dueAt
  split
  · rename_i electra
    have none : (X.pendingConsolidations electra).data.toList.filter
        (fun c => decide (c.targetIndex ∈ ({v} : Finset ValidatorIndex))) = [] :=
      List.filter_eq_nil_iff.mpr fun c member => by
        have target := inside electra c member
        simp only [Finset.mem_singleton, decide_eq_true_eq]
        rintro rfl
        omega
    rw [none]
    rfl
  · rfl

/-- A key created after the split and activated by C has a deposit credit on C's run.

It holds the activation reserve at its start.

No gross block credit reaches it before its activation, so a deposit or a consolidation pays it.

A consolidation needs an entry of the finalized queue, whose target is inside that registry. -/
private theorem created_deposit (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩) {eventsF : List (BalanceEvent preset)}
    (replayedF : fromFin.balanceEvents (getCurrentEpoch pulled).toNat = .ok eventsF)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    {v : ValidatorIndex} (activated : ∃ w, counted.validators.data[v.toNat]? = some w ∧
      w.activationEpoch ≠ FAR_FUTURE_EPOCH ∧ w.activationEpoch ≤ getCurrentEpoch counted)
    (absent : split.validators.data.size ≤ v.toNat) :
    0 < (creditScan (fun _ => false) (fun s => decide (s = .deposits)) v.toNat highC tailC) := by
  classical
  obtain ⟨toFin⟩ := h.toFin
  by_contra none
  have depZero := Nat.eq_zero_of_not_pos none
  have finGrows : fin.validators.data.size ≤ split.validators.data.size :=
    registryGrows_of_chainSteps fromFin.chainSteps
  obtain ⟨_, pre, post, splitEq, -, -, -, -, funded, -, -, walk, noGross, -⟩ :=
    created_start h tailC highC endEpochC activated absent
  have positive := maxEffectiveBalance_pos h
  have consScan : (creditScan (fun _ => false) (fun s => decide (s = .consolidations)) v.toNat
      highC tailC) ≤ consAmt eventsC v.toNat :=
    scan_le_events _ _ (· = .consolidations) (by intro s; simp) tailC highC v replayedC
  subst splitEq
  have depSplit := creditScan_append (fun _ => false) (fun s => decide (s = .deposits))
    v.toNat highC pre post
  have consSplit := creditScan_append (fun _ => false) (fun s => decide (s = .consolidations))
    v.toNat highC pre post
  have noCons := consAmt_zero h fromFin replayedF (pre.append post) highC endEpochC h.near
    replayedC v (dueAt_eq_zero_of_targets fin highC (toFin.pendingConsolidation_targets
      h.genesis h.early h.delay) (by omega))
  omega

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- A key that C's branch holds beyond the split pays an upward band.

`created_deposit` gives it a deposit credit on C's run, so it has the credit band. -/
private theorem created_band (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩) (high : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    {eventsF : List (BalanceEvent preset)} (replayedF : fromFin.balanceEvents high = .ok eventsF)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    {v : ValidatorIndex} (activated : ∃ w, counted.validators.data[v.toNat]? = some w ∧
      w.activationEpoch ≠ FAR_FUTURE_EPOCH ∧ w.activationEpoch ≤ getCurrentEpoch counted)
    (absent : split.validators.data.size ≤ v.toNat) :
    preset.upwardBand ≤ bandC tailC highC v.toNat + bandX fin highC v.toNat := by
  have replayedF' := replay_at_pulled pulled fromFin high endEpoch h.called replayedF
  have deposit :=
    created_deposit h fromFin replayedF' tailC highC endEpochC replayedC activated absent
  have positive : 0 < grossScan v.toNat highC tailC +
      (creditScan (fun _ => false) (fun s => decide (s = .deposits)) v.toNat highC tailC) := by
    omega
  have band : bandC tailC highC v.toNat = preset.upwardBand := by
    unfold bandC
    simp [positive]
  omega

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- A key of `SC` that R neither slashes nor exits, and that is not active at C, is charged on C.

An exit unset at the split is set by the key's slashing on C's run, which charges it.

An exit set at the split belongs to a key activated by the split's epoch.

If R slashes the key, its withdrawal is a vector past the split, so `slashedRB` holds.

Otherwise its exit is after R's next epoch, or `exitedSlashable` counts it.

An exit after R's next epoch leaves the key active at C. -/
private theorem sc_inactive_charged (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) {i : ℕ}
    (member : i ∈ (slashedOnC split counted).filter (fun i => i < split.validators.data.size))
    (notRB : ¬ (pinTerms config pulled anc fin).slashedRB i = true)
    (notES : ¬ PinTerms.exitedSlashable anc pulled i = true)
    (inactive : ¬ isActiveAt counted (getCurrentEpoch counted) i = true) :
    ∃ c ∈ tailC.departureCharges, c.index = i := by
  obtain ⟨toFin⟩ := h.toFin
  obtain ⟨inSlashed, inside⟩ := Finset.mem_filter.mp member
  obtain ⟨-, unslashedS, slashedC⟩ := Finset.mem_filter.mp inSlashed
  obtain ⟨u, foundS⟩ : ∃ u, split.validators.data[i]? = some u :=
    ⟨_, Array.getElem?_eq_getElem inside⟩
  have cleanU : u.slashed = false := by simpa [foundS] using unslashedS
  obtain ⟨wc, foundC, lifeC⟩ := tailC.registryLifecycle.validators i u foundS
  have markedC : wc.slashed = true := by simpa [foundC] using slashedC
  by_cases unset : u.exitEpoch = FAR_FUTURE_EPOCH
  · have assigned : wc.exitEpoch ≠ FAR_FUTURE_EPOCH :=
      run_slashed_exit_assigned ((toFin.append fromFin).append tailC) h.genesis
        h.caps.activation h.caps.compounding h.early h.delay i wc foundC markedC
    obtain ⟨c, inRun, index, -⟩ :=
      tailC.departure_charge_of_assigned i u wc foundS foundC unset assigned
    exact ⟨c, inRun, index⟩
  exfalso
  obtain ⟨w, foundP, lifeP⟩ := tail.registryLifecycle.validators i u foundS
  have exitP : w.exitEpoch = u.exitEpoch := lifeP.exitEpoch unset
  have exitC : wc.exitEpoch = u.exitEpoch := lifeC.exitEpoch unset
  have far : FAR_FUTURE_EPOCH.toNat = 2 ^ 64 - 1 := rfl
  have belowS := getCurrentEpoch_succ_lt_farFuture h.twoSlots split
  have activated : u.activationEpoch.toNat ≤ (getCurrentEpoch split).toNat :=
    UInt64.le_iff_toNat_le.mp ((toFin.append fromFin).exit_activated h.genesis i u foundS unset)
  have actAssigned : u.activationEpoch ≠ FAR_FUTURE_EPOCH := fun same => by
    rw [same] at activated
    omega
  have actC : wc.activationEpoch = u.activationEpoch := lifeC.activationEpoch actAssigned
  have finalized := UInt64.le_iff_toNat_le.mp h.finalized
  have called := UInt64.le_iff_toNat_le.mp h.called
  have near := h.near
  cases slashedP : w.slashed
  · by_cases early : u.exitEpoch.toNat ≤ (getCurrentEpoch pulled).toNat + 1
    · -- R keeps the key unslashed and exits it by its next epoch, so `exitedSlashable` counts it
      apply notES
      have delayS := (toFin.append fromFin).withdrawable_eq_exit_delay h.genesis i u foundS cleanU
      have delayP := ((toFin.append fromFin).append tail).withdrawable_eq_exit_delay h.genesis i w
        foundP slashedP
      have unassigned : u.exitEpoch.toNat ≠ 2 ^ 64 - 1 := fun same =>
        unset (UInt64.toNat_inj.mp (by rw [same, far]))
      have positive := h.delay
      have openS : (getCurrentEpoch split).toNat < u.withdrawableEpoch.toNat := by
        by_cases exited : u.exitEpoch ≤ getCurrentEpoch split
        · exact UInt64.lt_iff_toNat_lt.mp (tailC.newly_slashed_initial_exited_unwithdrawable
            h.caps.activation h.caps.compounding h.early i u wc foundS foundC cleanU markedC exited)
        · have later := UInt64.lt_iff_toNat_lt.mp (UInt64.not_le.mp exited)
          rcases delayS with ⟨same, -⟩ | same
          · exact absurd same unset
          · omega
      have wdP : w.withdrawableEpoch.toNat = u.withdrawableEpoch.toNat := by
        rcases delayS with ⟨same, -⟩ | eqS
        · exact absurd same unset
        rcases delayP with ⟨same, -⟩ | eqP
        · exact absurd (exitP ▸ same) unset
        rw [eqS, eqP, exitP]
      unfold PinTerms.exitedSlashable
      simp only [foundP, Option.map_some, Option.getD_some, slashedP, Option.any_some, exitP,
        decide_eq_true_eq, true_and]
      omega
    · -- its exit is after R's next epoch, so it is active at C
      apply inactive
      have splitC := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps tailC.chainSteps)
      refine isActiveAt_eq_true_iff.mpr ⟨wc, foundC, ?_⟩
      simp only [isActiveValidator, Bool.and_eq_true, decide_eq_true_eq]
      constructor
      · rw [actC]
        exact UInt64.le_iff_toNat_le.mpr (by simp only at splitC; omega)
      · rw [exitC]
        exact UInt64.lt_iff_toNat_lt.mpr (by omega)
  · -- R slashes the key after the split, so its withdrawal is a vector past the split
    exact notRB (slashedRB_of_newly_slashed h foundS foundP cleanU slashedP)

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- A key absent or unslashed at the finalized state is bounded from there or its creation.

A key already in the split's registry needs its slashing withdrawal bound.

A later key gets that bound from the state that first holds it. -/
private theorem envelope_of_clean_fin (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩)
    {eventsF events : List (BalanceEvent preset)}
    (replayedF : fromFin.balanceEvents (getCurrentEpoch pulled).toNat = .ok eventsF)
    (replayed : tail.balanceEvents (getCurrentEpoch pulled).toNat = .ok events)
    (v : ValidatorIndex) (inside : v.toNat < pulled.validators.data.size)
    (cleanFin : ∀ u, fin.validators.data[v.toNat]? = some u → u.slashed = false)
    (slashedLateSplit : v.toNat < split.validators.data.size →
      ∀ w, pulled.validators.data[v.toNat]? = some w → w.slashed = true →
        anc.finalizedCheckpoint.epoch.toNat + preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat ≤
          w.withdrawableEpoch.toNat)
    (late : ∀ w, pulled.validators.data[v.toNat]? = some w →
      (getCurrentEpoch pulled).toNat + 1 < w.withdrawableEpoch.toNat) :
    ∀ z ∈ (fromFin.append tail).balancePath, effectiveAt z v.toNat ≤
      (pinTerms config pulled anc fin).ebUp v.toNat + preset.EFFECTIVE_BALANCE_INCREMENT.toNat *
        ((syncD eventsF v.toNat + syncD events v.toNat +
            slashW (pinTerms config pulled anc fin) v.toNat) /
          preset.EFFECTIVE_BALANCE_INCREMENT.toNat) := by
  intro z inPath
  by_cases inFin : v.toNat < fin.validators.data.size
  · have splitSize : v.toNat < split.validators.data.size :=
      Nat.lt_of_lt_of_le inFin (registryGrows_of_chainSteps fromFin.chainSteps)
    exact envelope_of_voter h fromFin tail replayedF replayed v
      (Run.nil : Run config checks ⟨fork, fin⟩ ⟨fork, fin⟩) (fromFin.append tail)
      (run_nil_append (fromFin.append tail)) cleanFin (slashedLateSplit splitSize) inFin
      (Or.inl ⟨effective_fin_le_ebUp h v.toNat, Nat.le_refl _⟩) (fun w fw clean' =>
        late_of_withdrawable h fromFin tail v.toNat w fw clean' (late w fw)) z inPath
  · obtain ⟨c, toC, fromC, cutC, insideC, clean, before, floorStart, firstAfter⟩ :=
      created_first_state h (fromFin.append tail) (by omega) inside
    have slashedLate : ∀ w, pulled.validators.data[v.toNat]? = some w → w.slashed = true →
        anc.finalizedCheckpoint.epoch.toNat + preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat ≤
          w.withdrawableEpoch.toNat := by
      by_cases inSplit : v.toNat < split.validators.data.size
      · exact slashedLateSplit inSplit
      · have after := firstAfter split fromFin tail rfl inSplit
        have finalizedNat := UInt64.le_iff_toNat_le.mp h.finalized
        exact slashed_withdrawable_of_clean h fromC v clean insideC
          (UInt64.le_iff_toNat_le.mpr (by omega))
    have envC := envelope_of_voter h fromFin tail replayedF replayed v toC fromC cutC clean
      slashedLate insideC (Or.inr floorStart) (fun w fw clean' =>
        late_of_withdrawable h fromFin tail v.toNat w fw clean' (late w fw))
    rw [← cutC] at inPath
    exact path_le_of_start toC fromC v.toNat _ before envC z inPath

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The replays of the branch from `fin` to the split and of R's run, read at R's epoch.

Both runs end by R's epoch, so the horizon of the replay does not change their events. -/
private theorem replays_at_pulled
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩) (high : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    {eventsF : List (BalanceEvent preset)} (replayedF : fromFin.balanceEvents high = .ok eventsF) :
    fromFin.balanceEvents (getCurrentEpoch pulled).toNat = .ok eventsF ∧
      tail.balanceEvents (getCurrentEpoch pulled).toNat = .ok events :=
  ⟨replay_at_pulled pulled fromFin high endEpoch (currentEpoch_le_of_chainSteps tail.chainSteps)
      replayedF,
    replay_at_pulled pulled tail high endEpoch (UInt64.le_refl _) replayed⟩

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- A key of the split's registry, unslashed there, induces a leak on R's run only with a debit.

Its envelope on R's run is `ebUp` with its debits and its penalty in whole increments.

The penalty is below an increment.

So a key without a sync debit stays within `ebUp`, and induces no leak. -/
private theorem induced_debited (h : Setting config checks g split fin pulled anc counted V)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩) (high : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    {eventsF : List (BalanceEvent preset)} (replayedF : fromFin.balanceEvents high = .ok eventsF)
    {i : ℕ} (inside : i < split.validators.data.size)
    (unslashed : (split.validators.data[i]?.map (·.slashed)).getD false = false)
    (positive : 0 < inducedR (pinTerms config pulled anc fin) (fromFin.append tail) i) :
    0 < syncD eventsF i + syncD events i := by
  obtain ⟨replayedF', replayed'⟩ :=
    replays_at_pulled tail high endEpoch replayed fromFin replayedF
  by_contra none
  have zero : syncD eventsF i + syncD events i = 0 := by omega
  by_cases late : ∀ w, pulled.validators.data[i]? = some w →
      (getCurrentEpoch pulled).toNat + 1 < w.withdrawableEpoch.toNat
  swap
  · obtain ⟨w, found, notLate⟩ : ∃ w, pulled.validators.data[i]? = some w ∧
        w.withdrawableEpoch.toNat ≤ (getCurrentEpoch pulled).toNat + 1 := by
      by_contra no
      exact late fun w found => by
        by_contra notLate
        exact no ⟨w, found, by omega⟩
    rw [inducedR_of_withdrawn _ _ _ (withdrawnRB_of_le config pulled anc fin found notLate)]
      at positive
    exact Nat.lt_irrefl 0 positive
  have below := inside.trans (BeaconState.validators_size_lt_of_lt_glamsterdam h.early split)
  obtain ⟨v, rfl⟩ : ∃ v : ValidatorIndex, v.toNat = i :=
    ⟨UInt64.ofNat i, UInt64.toNat_ofNat_of_lt' below⟩
  have cleanSplit : ∀ u, split.validators.data[v.toNat]? = some u → u.slashed = false :=
    fun u foundU => by
      rw [foundU] at unslashed
      simpa using unslashed
  have envelope := envelope_of_clean_fin h fromFin tail replayedF' replayed' v
    (Nat.lt_of_lt_of_le inside (registryGrows_of_chainSteps tail.chainSteps))
    (fun u foundU => unslashed_of_run fromFin foundU cleanSplit)
    (fun splitSize => slashed_withdrawable_of_clean h tail v cleanSplit splitSize h.finalized) late
  have hWdb := slashW_add_downwardBand_le h v.toNat
  have bandLow := h.facts.bandLow
  have incBig := h.facts.incrementSize
  have hW : slashW (pinTerms config pulled anc fin) v.toNat <
      preset.EFFECTIVE_BALANCE_INCREMENT.toNat := by omega
  have perPos : 1 ≤ (pinTerms config pulled anc fin).perIncrement := by
    have := four_le_perIncrement h
    omega
  have bound := inducedR_le config pulled anc fin h.bands.1 perPos (fromFin.append tail) v.toNat
    0 0 (Nat.zero_le _) fun z inPath => by
      have within := envelope z inPath
      rw [zero, Nat.zero_add, Nat.div_eq_of_lt hW] at within
      simpa using within
  simp at bound
  omega

/-- The deposits of `depPre` are among the deposits of the events. -/
private theorem depPre_le_deposits (L : List (BalanceEvent preset)) (i : ℕ) :
    depPre L i ≤ ((L.filter fun e => e.source = .deposits).map (keyCredit i)).sum := by
  induction L with
  | nil => simp [depPre]
  | cons e rest ih =>
    unfold depPre at ih ⊢
    by_cases dep : e.source = .deposits
    · by_cases slashed : slashedFlagAt e.before.state i = some true <;>
        simp [dep, slashed] at ih ⊢ <;> omega
    · simp [dep] at ih ⊢
      omega

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- A key credited by a consolidation from the split, or on the shared segment, has a due entry.

The entry is in the queue of the finalized state, so the key has its band. -/
private theorem band_of_consolidation (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩) {eventsF : List (BalanceEvent preset)}
    (replayedF : fromFin.balanceEvents (getCurrentEpoch pulled).toNat = .ok eventsF)
    {ending : BeaconState preset fork}
    (run : Run config checks ⟨fork, split⟩ ⟨fork, ending⟩) (high : ℕ)
    (endEpoch : (getCurrentEpoch ending).toNat ≤ high + 1)
    (near : (getCurrentEpoch ending).toNat ≤ (getCurrentEpoch pulled).toNat + 1)
    {events : List (BalanceEvent preset)} (replayed : run.balanceEvents high = .ok events)
    {i : ℕ} (small : i < 2 ^ 64) (credited : 0 < consAmt eventsF i + consAmt events i) :
    preset.upwardBand ≤ bandX fin high i := by
  by_contra low
  have none : dueAt fin high {(UInt64.ofNat i : ValidatorIndex)} = 0 := by
    unfold bandX at low
    by_contra pos
    exact low (Nat.le_mul_of_pos_right _ (Nat.pos_of_ne_zero pos))
  have zero := consAmt_zero h fromFin replayedF run high endEpoch near replayed _ none
  rw [UInt64.toNat_ofNat_of_lt' small] at zero
  omega

/-- Ten quotients times three ceilings of a slack are zero, or within thirty slacks and quotients.
-/
private theorem ceil_round (X Q : ℕ) (pos : 0 < Q) :
    10 * Q * (3 * ((X + Q - 1) / Q)) = 0 ∨
      (0 < X ∧ 10 * Q * (3 * ((X + Q - 1) / Q)) ≤ 30 * X + 30 * Q - 30) := by
  rcases Nat.eq_zero_or_pos X with rfl | positive
  · left
    rw [Nat.zero_add, Nat.div_eq_of_lt (by omega)]
    simp
  · right
    refine ⟨positive, ?_⟩
    have floor := Nat.div_mul_le_self (X + Q - 1) Q
    have e : 10 * Q * (3 * ((X + Q - 1) / Q)) = 30 * ((X + Q - 1) / Q * Q) := by ring
    rw [e]
    omega

/-- Thirty-three of an amount is within ten quotients of its share. -/
private theorem share_ge (pos : 0 < (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat)
    (x : ℕ) :
    33 * x ≤ 10 * (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat *
      wShare preset fork x := by
  unfold wShare
  generalize (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat = Q at pos ⊢
  have split := Nat.div_add_mod (33 * x + 10 * Q - 1) (10 * Q)
  have small := Nat.mod_lt (33 * x + 10 * Q - 1) (show 0 < 10 * Q by omega)
  omega

/-- A key's credits on C's run have their gross scan and their credit or consolidation band. -/
private theorem credit_band_bounds (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩) {eventsF : List (BalanceEvent preset)}
    (replayedF : fromFin.balanceEvents (getCurrentEpoch pulled).toNat = .ok eventsF)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    {i : ℕ} (small : i < 2 ^ 64) :
    propN tailC highC i ≤ grossScan i highC tailC ∧
      whistC tailC highC i ≤ grossScan i highC tailC ∧
      (syncCr eventsC i = 0 ∨ 0 < grossScan i highC tailC) ∧
      ((0 < grossScan i highC tailC + (creditScan (fun _ => false)
          (fun s => decide (s = .deposits)) i highC tailC) ∧
          bandC tailC highC i = preset.upwardBand) ∨
        (grossScan i highC tailC + (creditScan (fun _ => false)
          (fun s => decide (s = .deposits)) i highC tailC) = 0 ∧ bandC tailC highC i = 0)) ∧
      (consAmt eventsC i = 0 ∨ preset.upwardBand ≤ bandX fin highC i) := by
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · exact scan_le_gross tailC highC i (fun s => decide (s = .rewards))
      fun s h => by simp at h; simp [h]
  · exact scan_le_gross tailC highC i (fun s => decide (s = .slashings))
      fun s h => by simp at h; simp [h]
  · rcases Nat.eq_zero_or_pos (syncCr eventsC i) with none | positive
    · exact .inl none
    · exact .inr (syncCr_gross (Nat.le_trans (by decide) h.fulu) h.early tailC highC replayedC i
        positive)
  · unfold bandC
    split_ifs <;> omega
  · rcases Nat.eq_zero_or_pos (consAmt eventsC i) with none | positive
    · exact .inl none
    · exact .inr (band_of_consolidation h fromFin replayedF tailC highC endEpochC h.near replayedC
        small (by omega))

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The rounding of one key of `SC` is within its shares and bands, at ten quotients.

The slack's credits pay at eleven tenths of three, the shares' rate.

Each source of the key's slack brings a band, which pays the rounding of its floor. -/
private theorem sc_key_round (h : Setting config checks g split fin pulled anc counted V)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩) (high : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    {eventsF : List (BalanceEvent preset)} (replayedF : fromFin.balanceEvents high = .ok eventsF)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    {b : BeaconState preset fork} (pre : Run config checks ⟨fork, b⟩ ⟨fork, split⟩)
    (eventsP : List (BalanceEvent preset)) (Q : ℕ)
    (hQ : Q = (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat) {i : ℕ}
    (member : i ∈ (slashedOnC split counted).filter (fun i => i < split.validators.data.size)) :
    10 * Q * (3 * ((whistleSlack (pinTerms config pulled anc fin) tailC (fromFin.append tail) highC
        high eventsC eventsF events fin i +
      (if ¬ (pinTerms config pulled anc fin).slashedRB i = true ∧
          ¬ PinTerms.exitedSlashable anc pulled i = true ∧
          ¬ isActiveAt counted (getCurrentEpoch counted) i = true then
        propN pre highC i + whistC pre highC i + syncCr eventsP i else 0) + Q - 1) / Q)) ≤
      33 * propN tailC highC i + 33 * depPre eventsC i + 33 * syncCr eventsC i +
        33 * consAmt eventsC i + 33 * syncD eventsF i + 33 * syncD events i +
        30 * (Q * whistC tailC highC i) + 10 * (Q * bandC tailC highC i) +
        10 * (Q * bandX fin highC i) +
        33 * (if (pinTerms config pulled anc fin).exitBeforeFin i = true then
          syncCr eventsF i else 0) +
        33 * (if (pinTerms config pulled anc fin).exitBeforeFin i = true then
          consAmt eventsF i else 0) +
        10 * (Q * (if (pinTerms config pulled anc fin).exitBeforeFin i = true then
          bandX fin high i else 0)) +
        10 * (Q * (unitK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF i +
          inducedR (pinTerms config pulled anc fin) (fromFin.append tail) i +
          bandR (eventsF ++ events) i +
          if (pinTerms config pulled anc fin).exitBeforeFin i = true then
            (if 0 < syncCr eventsF i then preset.upwardBand else 0) else 0)) +
        33 * propN pre highC i + 10 * (Q * syncCr eventsP i) +
        30 * (Q * (if ∃ c ∈ tailC.departureCharges, c.index = i then whistC pre highC i else 0)) +
        10 * (Q * (if ∃ c ∈ tailC.departureCharges, c.index = i then
          (if 0 < propN pre highC i + whistC pre highC i + syncCr eventsP i then
            preset.upwardBand else 0) else 0)) := by
  have quotient : 30 ≤ Q := hQ ▸ h.facts.whistleblower fork
  have up := h.bands.2
  have incBig := h.facts.incrementSize
  have unit : 4 ≤ (pinTerms config pulled anc fin).unitGain := by
    have finalized := UInt64.le_iff_toNat_le.mp h.finalized
    have called := UInt64.le_iff_toNat_le.mp h.called
    have depth : (pinTerms config pulled anc fin).depth =
        (getCurrentEpoch pulled).toNat + 2 - anc.finalizedCheckpoint.epoch.toNat := rfl
    have unitEq : (pinTerms config pulled anc fin).unitGain =
        (pinTerms config pulled anc fin).depth * ((pinTerms config pulled anc fin).perIncrement *
          (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum / WEIGHT_DENOMINATOR.toNat + 2) := rfl
    have product := Nat.mul_le_mul (show 2 ≤ (pinTerms config pulled anc fin).depth by omega)
      (Nat.le_add_left 2 ((pinTerms config pulled anc fin).perIncrement *
          (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum / WEIGHT_DENOMINATOR.toNat))
    omega
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  obtain ⟨inSlashed, inside⟩ := Finset.mem_filter.mp member
  obtain ⟨-, unslashedS, -⟩ := Finset.mem_filter.mp inSlashed
  have small := inside.trans (BeaconState.validators_size_lt_of_lt_glamsterdam h.early split)
  have replayedF' := replay_at_pulled pulled fromFin high endEpoch h.called replayedF
  -- the credits that the slack reads, and the bands that they bring
  obtain ⟨grossP, grossW, grossS, hbC, consBand⟩ :=
    credit_band_bounds h fromFin replayedF' tailC highC endEpochC replayedC small
  obtain ⟨-, credits⟩ := PinKeys.creditScan_bounds ∅ UInt64.toNat (fun _ => false)
    (fun s => decide (s = .deposits)) highC (fun _ => 0) tailC replayedC (fun e _ _ => by simp)
  have dep := credits (fun s => decide (s = .deposits))
    (Or.inr fun electra early replayed i => PinSeatDebits.block_deposit_zero electra early
      replayed i)
    (Or.inl fun _ covered => covered) electra h.early i
  have deposits := (depPre_le_deposits eventsC i).trans dep
  have bandXZero : ∀ hh, bandX fin hh i = 0 ∨ preset.upwardBand ≤ bandX fin hh i := by
    intro hh
    unfold bandX
    rcases Nat.eq_zero_or_pos (dueAt fin hh {(UInt64.ofNat i : ValidatorIndex)}) with zero | pos
    · exact .inl (by rw [zero, Nat.mul_zero])
    · exact .inr (Nat.le_mul_of_pos_right _ pos)
  have hbX : (bandX fin highC i = 0 ∧ consAmt eventsC i = 0) ∨
      preset.upwardBand ≤ bandX fin highC i := by
    rcases bandXZero highC with zero | big
    · rcases consBand with none | big
      · exact .inl ⟨zero, none⟩
      · exact .inr big
    · exact .inr big
  have hbXh : (bandX fin high i = 0 ∧ consAmt eventsF i = 0) ∨
      preset.upwardBand ≤ bandX fin high i := by
    rcases bandXZero high with zero | big
    · rcases Nat.eq_zero_or_pos (consAmt eventsF i) with none | pos
      · exact .inl ⟨zero, none⟩
      · exact .inr (band_of_consolidation h fromFin replayedF' tail high endEpoch (by omega)
          replayed small (by omega))
    · exact .inr big
  have hbR : (syncD eventsF i + syncD events i = 0 ∧ bandR (eventsF ++ events) i = 0 ∧
        inducedR (pinTerms config pulled anc fin) (fromFin.append tail) i = 0) ∨
      bandR (eventsF ++ events) i =
        preset.EFFECTIVE_BALANCE_INCREMENT.toNat + preset.downwardBand - 1 := by
    have induced : inducedR (pinTerms config pulled anc fin) (fromFin.append tail) i = 0 ∨
        0 < syncD eventsF i + syncD events i := by
      rcases Nat.eq_zero_or_pos
          (inducedR (pinTerms config pulled anc fin) (fromFin.append tail) i) with zero | pos
      · exact .inl zero
      · exact .inr (induced_debited h tail high endEpoch replayed fromFin replayedF inside
          unslashedS pos)
    rw [bandR_eq]
    simp only [List.map_append, List.sum_append]
    unfold syncD at induced ⊢
    split_ifs <;> omega
  have huK : (unitK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF i = 0 ∧
        (if 0 < slashW (pinTerms config pulled anc fin) i then
          (pinTerms config pulled anc fin).unitGain else 0) = 0) ∨
      unitK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF i =
        (pinTerms config pulled anc fin).unitGain := by
    unfold unitK flowCredit
    split_ifs <;> omega
  have hSW : (if 0 < slashW (pinTerms config pulled anc fin) i then
        (pinTerms config pulled anc fin).unitGain else 0) ≤
      unitK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF i := by
    unfold unitK flowCredit
    split_ifs <;> omega
  have huSF : (syncCr eventsF i = 0 ∧
        (if 0 < syncCr eventsF i then preset.upwardBand else 0) = 0) ∨
      (if 0 < syncCr eventsF i then preset.upwardBand else 0) = preset.upwardBand := by
    split_ifs <;> omega
  have hb5 : (propN pre highC i + whistC pre highC i + syncCr eventsP i = 0 ∧
        (if 0 < propN pre highC i + whistC pre highC i + syncCr eventsP i then
          preset.upwardBand else 0) = 0) ∨
      (if 0 < propN pre highC i + whistC pre highC i + syncCr eventsP i then
        preset.upwardBand else 0) = preset.upwardBand := by
    split_ifs <;> omega
  -- the terms of a key that exited by the finalized state
  have hE : ((if (pinTerms config pulled anc fin).exitBeforeFin i = true then
          syncCr eventsF i else 0) = syncCr eventsF i ∧
        (if (pinTerms config pulled anc fin).exitBeforeFin i = true then
          consAmt eventsF i else 0) = consAmt eventsF i ∧
        (if (pinTerms config pulled anc fin).exitBeforeFin i = true then
          bandX fin high i else 0) = bandX fin high i ∧
        (if (pinTerms config pulled anc fin).exitBeforeFin i = true then
          (if 0 < syncCr eventsF i then preset.upwardBand else 0) else 0) =
          (if 0 < syncCr eventsF i then preset.upwardBand else 0) ∧
        (if (pinTerms config pulled anc fin).exitBeforeFin i = true then
          (11 * (syncCr eventsF i + consAmt eventsF i) + 9) / 10 + bandX fin high i +
            (if 0 < syncCr eventsF i then preset.upwardBand else 0) else 0) =
          (11 * (syncCr eventsF i + consAmt eventsF i) + 9) / 10 + bandX fin high i +
            (if 0 < syncCr eventsF i then preset.upwardBand else 0)) ∨
      ((if (pinTerms config pulled anc fin).exitBeforeFin i = true then
          syncCr eventsF i else 0) = 0 ∧
        (if (pinTerms config pulled anc fin).exitBeforeFin i = true then
          consAmt eventsF i else 0) = 0 ∧
        (if (pinTerms config pulled anc fin).exitBeforeFin i = true then
          bandX fin high i else 0) = 0 ∧
        (if (pinTerms config pulled anc fin).exitBeforeFin i = true then
          (if 0 < syncCr eventsF i then preset.upwardBand else 0) else 0) = 0 ∧
        (if (pinTerms config pulled anc fin).exitBeforeFin i = true then
          (11 * (syncCr eventsF i + consAmt eventsF i) + 9) / 10 + bandX fin high i +
            (if 0 < syncCr eventsF i then preset.upwardBand else 0) else 0) = 0) := by
    by_cases e : (pinTerms config pulled anc fin).exitBeforeFin i = true
    · left
      simp only [e, ↓reduceIte, and_self]
    · right
      simp only [e, Bool.false_eq_true, ↓reduceIte, and_self]
  -- the terms of a key not active at C that R neither slashes nor exits, which is charged
  have hD : ((if ¬ (pinTerms config pulled anc fin).slashedRB i = true ∧
          ¬ PinTerms.exitedSlashable anc pulled i = true ∧
          ¬ isActiveAt counted (getCurrentEpoch counted) i = true then
        propN pre highC i + whistC pre highC i + syncCr eventsP i else 0) =
          propN pre highC i + whistC pre highC i + syncCr eventsP i ∧
        (if ∃ c ∈ tailC.departureCharges, c.index = i then whistC pre highC i else 0) =
          whistC pre highC i ∧
        (if ∃ c ∈ tailC.departureCharges, c.index = i then
          (if 0 < propN pre highC i + whistC pre highC i + syncCr eventsP i then
            preset.upwardBand else 0) else 0) =
          (if 0 < propN pre highC i + whistC pre highC i + syncCr eventsP i then
            preset.upwardBand else 0)) ∨
      (if ¬ (pinTerms config pulled anc fin).slashedRB i = true ∧
          ¬ PinTerms.exitedSlashable anc pulled i = true ∧
          ¬ isActiveAt counted (getCurrentEpoch counted) i = true then
        propN pre highC i + whistC pre highC i + syncCr eventsP i else 0) = 0 := by
    by_cases d : ¬ (pinTerms config pulled anc fin).slashedRB i = true ∧
        ¬ PinTerms.exitedSlashable anc pulled i = true ∧
        ¬ isActiveAt counted (getCurrentEpoch counted) i = true
    · have charged := sc_inactive_charged h fromFin tail tailC member d.1 d.2.1 d.2.2
      exact .inl ⟨ite_eq_left d, ite_eq_left charged, ite_eq_left charged⟩
    · exact .inr (ite_eq_right d)
  -- the products by the quotient
  have pWT := Nat.mul_le_mul_right (whistC tailC highC i) (show 2 ≤ Q by omega)
  have pSP := Nat.mul_le_mul_right (syncCr eventsP i) (show 3 ≤ Q by omega)
  have pWP := Nat.mul_le_mul_right
    (if ∃ c ∈ tailC.departureCharges, c.index = i then whistC pre highC i else 0)
    (show 3 ≤ Q by omega)
  obtain ⟨SB, hSB⟩ : ∃ SB, SB = bandC tailC highC i + bandX fin highC i +
      (unitK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF i +
        inducedR (pinTerms config pulled anc fin) (fromFin.append tail) i +
        bandR (eventsF ++ events) i +
        if (pinTerms config pulled anc fin).exitBeforeFin i = true then
          (if 0 < syncCr eventsF i then preset.upwardBand else 0) else 0) +
      (if (pinTerms config pulled anc fin).exitBeforeFin i = true then bandX fin high i else 0) +
      (if ∃ c ∈ tailC.departureCharges, c.index = i then
        (if 0 < propN pre highC i + whistC pre highC i + syncCr eventsP i then
          preset.upwardBand else 0) else 0) := ⟨_, rfl⟩
  have hQSB : Q * bandC tailC highC i + Q * bandX fin highC i +
      Q * (unitK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF i +
        inducedR (pinTerms config pulled anc fin) (fromFin.append tail) i +
        bandR (eventsF ++ events) i +
        if (pinTerms config pulled anc fin).exitBeforeFin i = true then
          (if 0 < syncCr eventsF i then preset.upwardBand else 0) else 0) +
      Q * (if (pinTerms config pulled anc fin).exitBeforeFin i = true then
        bandX fin high i else 0) +
      Q * (if ∃ c ∈ tailC.departureCharges, c.index = i then
        (if 0 < propN pre highC i + whistC pre highC i + syncCr eventsP i then
          preset.upwardBand else 0) else 0) = Q * SB := by
    rw [hSB]
    ring
  have pSB := Nat.mul_le_mul_right SB quotient
  -- the slack is zero, or it has a band of at least four
  have hc := ceil_round (whistleSlack (pinTerms config pulled anc fin) tailC (fromFin.append tail)
    highC high eventsC eventsF events fin i +
    (if ¬ (pinTerms config pulled anc fin).slashedRB i = true ∧
        ¬ PinTerms.exitedSlashable anc pulled i = true ∧
        ¬ isActiveAt counted (getCurrentEpoch counted) i = true then
      propN pre highC i + whistC pre highC i + syncCr eventsP i else 0)) Q (by omega)
  unfold whistleSlack whistleSlackBase at hc ⊢
  have big : (11 * (propN tailC highC i + depPre eventsC i + whistC tailC highC i +
        syncCr eventsC i + consAmt eventsC i + syncD eventsF i + syncD events i) + 9) / 10 +
      bandC tailC highC i + bandX fin highC i + bandR (eventsF ++ events) i +
      unitK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF i +
      inducedR (pinTerms config pulled anc fin) (fromFin.append tail) i +
      (if 0 < slashW (pinTerms config pulled anc fin) i then
        (pinTerms config pulled anc fin).unitGain else 0) +
      (if (pinTerms config pulled anc fin).exitBeforeFin i = true then
        (11 * (syncCr eventsF i + consAmt eventsF i) + 9) / 10 + bandX fin high i +
          (if 0 < syncCr eventsF i then preset.upwardBand else 0) else 0) +
      (if ¬ (pinTerms config pulled anc fin).slashedRB i = true ∧
          ¬ PinTerms.exitedSlashable anc pulled i = true ∧
          ¬ isActiveAt counted (getCurrentEpoch counted) i = true then
        propN pre highC i + whistC pre highC i + syncCr eventsP i else 0) = 0 ∨ 4 ≤ SB := by
    omega
  rcases big with zero | four
  · omega
  · have pFour := Nat.mul_le_mul_left Q four
    omega

/-- The slack and the rounding of the rewards of the keys of `SC` are paid by their shares.

A key of the split's registry is read at its bound and the slack that `registry` adds.

A key that exits on C's branch is read at its charge and its rise after it.

The slashing credits of the slack are the keys' own.

The left side of `bud_whistle_of` gives them up.

The unit, the induced leak and the bands of the slack are paid unscaled.

Its credits are paid by the shares, with a tenth for their gains.

Each credited key has an upward band, which pays the rounding of its floor. -/
private theorem whistle_slack_sc (h : Setting config checks g split fin pulled anc counted V)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩) (high : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    {eventsF : List (BalanceEvent preset)} (replayedF : fromFin.balanceEvents high = .ok eventsF)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    {b : BeaconState preset fork}
    (pre : Run config checks ⟨fork, b⟩ ⟨fork, split⟩) (eventsP : List (BalanceEvent preset)) :
    3 * (∑ i ∈ ((slashedOnC split counted).filter (fun i => i < split.validators.data.size)),
        min (whistleRead (pinTerms config pulled anc fin) pulled anc counted tailC
          (fromFin.append tail) pre highC high eventsC eventsF events eventsP fin i)
          preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat /
        (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat) ≤
      3 * (∑ i ∈ ((slashedOnC split counted).filter
          (fun i => i < split.validators.data.size)).filter
          (fun i => (pinTerms config pulled anc fin).slashedRB i = true),
          whistleEnv (pinTerms config pulled anc fin) pulled anc fin i /
            (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat +
        ∑ i ∈ ((slashedOnC split counted).filter (fun i => i < split.validators.data.size)).filter
          (fun i => PinTerms.exitedSlashable anc pulled i = true),
          whistleEnv (pinTerms config pulled anc fin) pulled anc fin i /
            (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat +
        ∑ i ∈ ((((slashedOnC split counted).filter (fun i => i < split.validators.data.size)).filter
            (fun i => ¬ (pinTerms config pulled anc fin).slashedRB i = true ∧
              ¬ PinTerms.exitedSlashable anc pulled i = true)).filter
            (fun i => isActiveAt counted (getCurrentEpoch counted) i = true)).filter
            (fun i => ¬ ((pinTerms config pulled anc fin).tight = false ∧
              ((pinTerms config pulled anc fin).lateB i = true ∨
                (pinTerms config pulled anc fin).pendingRB i = true))),
          whistleEnv (pinTerms config pulled anc fin) pulled anc fin i /
            (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat +
        ∑ i ∈ ((((slashedOnC split counted).filter (fun i => i < split.validators.data.size)).filter
            (fun i => ¬ (pinTerms config pulled anc fin).slashedRB i = true ∧
              ¬ PinTerms.exitedSlashable anc pulled i = true)).filter
            (fun i => isActiveAt counted (getCurrentEpoch counted) i = true)).filter
            (fun i => (pinTerms config pulled anc fin).tight = false ∧
              ((pinTerms config pulled anc fin).lateB i = true ∨
                (pinTerms config pulled anc fin).pendingRB i = true)),
          whistleEnv (pinTerms config pulled anc fin) pulled anc fin i /
            (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat) +
        3 * (∑ i ∈ (((slashedOnC split counted).filter
            (fun i => i < split.validators.data.size)).filter
            (fun i => ¬ (pinTerms config pulled anc fin).slashedRB i = true ∧
              ¬ PinTerms.exitedSlashable anc pulled i = true)).filter
            (fun i => ¬ isActiveAt counted (getCurrentEpoch counted) i = true),
          (chargeAmt tailC i + riseQ tailC highC i) /
            (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat) +
        3 * (∑ i ∈ (slashedOnC split counted).filter (fun i => i < split.validators.data.size),
          whistC tailC highC i) +
        (wShare preset fork ((∑ v ∈ SC pulled counted split, propN tailC highC v.toNat) +
            ∑ v ∈ SC pulled counted split, depPre eventsC v.toNat) +
          wShare preset fork (∑ v ∈ SC pulled counted split, syncCr eventsC v.toNat) +
          wShare preset fork (∑ v ∈ SC pulled counted split, consAmt eventsC v.toNat) +
          wShare preset fork
            (∑ v ∈ SC pulled counted split, (syncD eventsF v.toNat + syncD events v.toNat)) +
          (∑ v ∈ SC pulled counted split, bandC tailC highC v.toNat) +
          (∑ v ∈ SC pulled counted split, bandX fin highC v.toNat) +
          wShare preset fork (∑ v ∈ SC pulled counted split with
            (pinTerms config pulled anc fin).exitBeforeFin v.toNat = true, syncCr eventsF v.toNat) +
          wShare preset fork (∑ v ∈ SC pulled counted split with
            (pinTerms config pulled anc fin).exitBeforeFin v.toNat = true,
              consAmt eventsF v.toNat) +
          (∑ v ∈ SC pulled counted split with
            (pinTerms config pulled anc fin).exitBeforeFin v.toNat = true,
              bandX fin high v.toNat) : ℕ) +
        (∑ v ∈ SC pulled counted split,
          (unitK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF v.toNat +
            inducedR (pinTerms config pulled anc fin) (fromFin.append tail) v.toNat +
            bandR (eventsF ++ events) v.toNat +
            if (pinTerms config pulled anc fin).exitBeforeFin v.toNat = true then
              (if 0 < syncCr eventsF v.toNat then preset.upwardBand else 0) else 0) : ℕ) +
        wShare preset fork (∑ v ∈ SC pulled counted split, propN pre highC v.toNat) +
        (∑ v ∈ SC pulled counted split, syncCr eventsP v.toNat) +
        3 * (∑ v ∈ scCharged pulled counted split tailC, whistC pre highC v.toNat) +
        (∑ v ∈ scCharged pulled counted split tailC,
          if 0 < propN pre highC v.toNat + whistC pre highC v.toNat + syncCr eventsP v.toNat then
            preset.upwardBand else 0) := by
  have quotient := h.facts.whistleblower fork
  have pos : 0 < (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat := by omega
  -- each key is read at its group's bound, with the ceiling of its slack
  obtain ⟨base, hbase⟩ : ∃ base : ℕ → ℕ, ∀ i, base i =
      if ¬ (pinTerms config pulled anc fin).slashedRB i = true ∧
          ¬ PinTerms.exitedSlashable anc pulled i = true ∧
          ¬ isActiveAt counted (getCurrentEpoch counted) i = true then
        (chargeAmt tailC i + riseQ tailC highC i) /
          (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat
      else whistleEnv (pinTerms config pulled anc fin) pulled anc fin i /
        (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat := ⟨_, fun _ => rfl⟩
  obtain ⟨X, hX⟩ : ∃ X : ℕ → ℕ, ∀ i, X i =
      whistleSlack (pinTerms config pulled anc fin) tailC (fromFin.append tail) highC high eventsC
        eventsF events fin i +
      (if ¬ (pinTerms config pulled anc fin).slashedRB i = true ∧
          ¬ PinTerms.exitedSlashable anc pulled i = true ∧
          ¬ isActiveAt counted (getCurrentEpoch counted) i = true then
        propN pre highC i + whistC pre highC i + syncCr eventsP i else 0) := ⟨_, fun _ => rfl⟩
  have floorKey : ∀ i ∈ (slashedOnC split counted).filter (fun i => i < split.validators.data.size),
      3 * (min (whistleRead (pinTerms config pulled anc fin) pulled anc counted tailC
          (fromFin.append tail) pre highC high eventsC eventsF events eventsP fin i)
          preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat /
        (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat) ≤
      3 * base i + 3 * ((X i + (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat - 1) /
        (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat) := by
    intro i member
    rw [hbase, hX]
    by_cases hD : ¬ (pinTerms config pulled anc fin).slashedRB i = true ∧
        ¬ PinTerms.exitedSlashable anc pulled i = true ∧
        ¬ isActiveAt counted (getCurrentEpoch counted) i = true
    · -- the key is charged, and read at its charge
      obtain ⟨c, inRun, index⟩ := sc_inactive_charged h fromFin tail tailC member hD.1 hD.2.1 hD.2.2
      have any : (tailC.departureCharges.any fun c => c.index == i) = true :=
        List.any_eq_true.mpr ⟨c, inRun, by simp [index]⟩
      have read : whistleRead (pinTerms config pulled anc fin) pulled anc counted tailC
          (fromFin.append tail) pre highC high eventsC eventsF events eventsP fin i ≤
          (chargeAmt tailC i + riseQ tailC highC i) +
            (whistleSlack (pinTerms config pulled anc fin) tailC (fromFin.append tail) highC high
              eventsC eventsF events fin i +
              (propN pre highC i + whistC pre highC i + syncCr eventsP i)) := by
        unfold whistleRead
        rw [ite_eq_left ⟨hD.2.2, any⟩]
        exact (min_le_right _ _).trans (by omega)
      rw [ite_eq_left hD, ite_eq_left hD]
      have down := Nat.div_le_div_right
        (c := (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat)
        ((min_le_left _ preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat).trans read)
      have split := floor_add_ceil_le (chargeAmt tailC i + riseQ tailC highC i)
        (whistleSlack (pinTerms config pulled anc fin) tailC (fromFin.append tail) highC high
          eventsC eventsF events fin i +
          (propN pre highC i + whistC pre highC i + syncCr eventsP i)) _ pos
      omega
    · -- the key is read at its bound and its slack
      have read : whistleRead (pinTerms config pulled anc fin) pulled anc counted tailC
          (fromFin.append tail) pre highC high eventsC eventsF events eventsP fin i ≤
          whistleEnv (pinTerms config pulled anc fin) pulled anc fin i +
            whistleSlack (pinTerms config pulled anc fin) tailC (fromFin.append tail) highC high
              eventsC eventsF events fin i := by
        unfold whistleRead
        split
        · exact min_le_left _ _
        · exact le_rfl
      rw [ite_eq_right hD, ite_eq_right hD, Nat.add_zero]
      have down := Nat.div_le_div_right
        (c := (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat)
        ((min_le_left _ preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat).trans read)
      have split := floor_add_ceil_le (whistleEnv (pinTerms config pulled anc fin) pulled anc fin i)
        (whistleSlack (pinTerms config pulled anc fin) tailC (fromFin.append tail) highC high
          eventsC eventsF events fin i) _ pos
      omega
  have floors := Finset.sum_le_sum floorKey
  rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum, ← Finset.mul_sum] at floors
  -- the bounds of the keys are the sums of the groups
  have apart : ∀ i ∈ (slashedOnC split counted).filter (fun i => i < split.validators.data.size),
      (pinTerms config pulled anc fin).slashedRB i = true →
        ¬ PinTerms.exitedSlashable anc pulled i = true := by
    intro i _ rb es
    rw [slashedRB_eq] at rb
    unfold PinTerms.exitedSlashable at es
    cases f : pulled.validators.data[i]? with
    | none => simp [f] at rb
    | some w => simp [f] at rb es; simp [rb.1] at es
  have splitThree : ∀ (S : Finset ℕ) (p q : ℕ → Prop) [DecidablePred p] [DecidablePred q],
      (∀ i ∈ S, p i → ¬ q i) → ∀ f : ℕ → ℕ, ∑ i ∈ S, f i = ∑ i ∈ S.filter p, f i +
        ∑ i ∈ S.filter q, f i + ∑ i ∈ S.filter (fun i => ¬ p i ∧ ¬ q i), f i := by
    intro S p q _ _ disjoint f
    rw [← Finset.sum_filter_add_sum_filter_not S p, add_assoc]
    congr 1
    rw [← Finset.sum_filter_add_sum_filter_not (S.filter (fun i => ¬ p i)) q, Finset.filter_filter,
      Finset.filter_filter]
    congr 1
    refine Finset.sum_congr ?_ fun _ _ => rfl
    ext i
    simp only [Finset.mem_filter]
    constructor
    · rintro ⟨hi, -, hq⟩
      exact ⟨hi, hq⟩
    · rintro ⟨hi, hq⟩
      exact ⟨hi, fun hp => disjoint i hi hp hq, hq⟩
  have three := splitThree
    ((slashedOnC split counted).filter (fun i => i < split.validators.data.size))
    (fun i => (pinTerms config pulled anc fin).slashedRB i = true)
    (fun i => PinTerms.exitedSlashable anc pulled i = true) apart base
  have g1 : ∑ i ∈ ((slashedOnC split counted).filter
      (fun i => i < split.validators.data.size)).filter
        (fun i => (pinTerms config pulled anc fin).slashedRB i = true), base i =
      ∑ i ∈ ((slashedOnC split counted).filter
        (fun i => i < split.validators.data.size)).filter
          (fun i => (pinTerms config pulled anc fin).slashedRB i = true),
        whistleEnv (pinTerms config pulled anc fin) pulled anc fin i /
          (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat :=
    Finset.sum_congr rfl fun i m => by
      rw [hbase, ite_eq_right fun hD => hD.1 (Finset.mem_filter.mp m).2]
  have g2 : ∑ i ∈ ((slashedOnC split counted).filter
      (fun i => i < split.validators.data.size)).filter
        (fun i => PinTerms.exitedSlashable anc pulled i = true), base i =
      ∑ i ∈ ((slashedOnC split counted).filter
        (fun i => i < split.validators.data.size)).filter
          (fun i => PinTerms.exitedSlashable anc pulled i = true),
        whistleEnv (pinTerms config pulled anc fin) pulled anc fin i /
          (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat :=
    Finset.sum_congr rfl fun i m => by
      rw [hbase, ite_eq_right fun hD => hD.2.1 (Finset.mem_filter.mp m).2]
  have y := (Finset.sum_filter_add_sum_filter_not (((slashedOnC split counted).filter
    (fun i => i < split.validators.data.size)).filter
      (fun i => ¬ (pinTerms config pulled anc fin).slashedRB i = true ∧
        ¬ PinTerms.exitedSlashable anc pulled i = true))
    (fun i => isActiveAt counted (getCurrentEpoch counted) i = true) base).symm
  have g3 := Finset.sum_congr rfl fun i (m : i ∈ (((slashedOnC split counted).filter
      (fun i => i < split.validators.data.size)).filter
        (fun i => ¬ (pinTerms config pulled anc fin).slashedRB i = true ∧
          ¬ PinTerms.exitedSlashable anc pulled i = true)).filter
      (fun i => isActiveAt counted (getCurrentEpoch counted) i = true)) => show base i =
        whistleEnv (pinTerms config pulled anc fin) pulled anc fin i /
          (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat by
      rw [hbase, ite_eq_right fun hD => hD.2.2 (Finset.mem_filter.mp m).2]
  have g4 := Finset.sum_congr rfl fun i (m : i ∈ (((slashedOnC split counted).filter
      (fun i => i < split.validators.data.size)).filter
        (fun i => ¬ (pinTerms config pulled anc fin).slashedRB i = true ∧
          ¬ PinTerms.exitedSlashable anc pulled i = true)).filter
      (fun i => ¬ isActiveAt counted (getCurrentEpoch counted) i = true)) => show base i =
        (chargeAmt tailC i + riseQ tailC highC i) /
          (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat by
      obtain ⟨inY, inactive⟩ := Finset.mem_filter.mp m
      obtain ⟨-, both⟩ := Finset.mem_filter.mp inY
      rw [hbase, ite_eq_left ⟨both.1, both.2, inactive⟩]
  have g5 := (Finset.sum_filter_add_sum_filter_not ((((slashedOnC split counted).filter
    (fun i => i < split.validators.data.size)).filter
      (fun i => ¬ (pinTerms config pulled anc fin).slashedRB i = true ∧
        ¬ PinTerms.exitedSlashable anc pulled i = true)).filter
      (fun i => isActiveAt counted (getCurrentEpoch counted) i = true))
    (fun i => (pinTerms config pulled anc fin).tight = false ∧
      ((pinTerms config pulled anc fin).lateB i = true ∨
        (pinTerms config pulled anc fin).pendingRB i = true))
    (fun i => whistleEnv (pinTerms config pulled anc fin) pulled anc fin i /
      (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat)).symm
  have part := congrArg
    (fun x => 10 * (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat * (3 * x))
    ((three.trans (by rw [g1, g2, y, g3, g4, g5])) : _ = _)
  -- the rounding of the keys is within the shares and bands
  have rounds := Finset.sum_le_sum fun i (m : i ∈ (slashedOnC split counted).filter
      (fun i => i < split.validators.data.size)) => by
    have one := sc_key_round h tail high endEpoch replayed fromFin replayedF tailC highC endEpochC
      replayedC pre eventsP _ rfl m
    rw [← hX i] at one
    exact one
  simp only [Finset.sum_add_distrib, ← Finset.mul_sum] at rounds
  -- the sums over `SC` are sums over the positions
  have fEBF (f : ℕ → ℕ) : ∑ v ∈ SC pulled counted split with
      (pinTerms config pulled anc fin).exitBeforeFin v.toNat = true, f v.toNat =
      ∑ i ∈ (slashedOnC split counted).filter (fun i => i < split.validators.data.size),
        if (pinTerms config pulled anc fin).exitBeforeFin i = true then f i else 0 :=
    (sum_SC_filter_positions h (fun i => (pinTerms config pulled anc fin).exitBeforeFin i = true)
      f).trans (Finset.sum_filter _ _)
  have fCharged (f : ℕ → ℕ) : ∑ v ∈ scCharged pulled counted split tailC, f v.toNat =
      ∑ i ∈ (slashedOnC split counted).filter (fun i => i < split.validators.data.size),
        if ∃ c ∈ tailC.departureCharges, c.index = i then f i else 0 :=
    (sum_SC_filter_positions h (fun i => ∃ c ∈ tailC.departureCharges, c.index = i) f).trans
      (Finset.sum_filter _ _)
  rw [fEBF (fun i => syncCr eventsF i), fEBF (fun i => consAmt eventsF i),
    fEBF (fun i => bandX fin high i), fCharged (fun i => whistC pre highC i),
    fCharged (fun i => if 0 < propN pre highC i + whistC pre highC i + syncCr eventsP i then
      preset.upwardBand else 0),
    sum_SC_positions h (fun i => propN tailC highC i),
    sum_SC_positions h (fun i => depPre eventsC i),
    sum_SC_positions h (fun i => syncCr eventsC i), sum_SC_positions h (fun i => consAmt eventsC i),
    sum_SC_positions h (fun i => syncD eventsF i + syncD events i),
    sum_SC_positions h (fun i => bandC tailC highC i),
    sum_SC_positions h (fun i => bandX fin highC i),
    sum_SC_positions h (fun i => unitK (pinTerms config pulled anc fin) tailC highC eventsC events
      eventsF i + inducedR (pinTerms config pulled anc fin) (fromFin.append tail) i +
      bandR (eventsF ++ events) i + if (pinTerms config pulled anc fin).exitBeforeFin i = true then
        (if 0 < syncCr eventsF i then preset.upwardBand else 0) else 0),
    sum_SC_positions h (fun i => propN pre highC i), sum_SC_positions h (fun i => syncCr eventsP i)]
  simp only [Finset.sum_add_distrib]
  refine Nat.le_of_mul_le_mul_left
    (c := 10 * (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat) ?_ (by omega)
  have scaled := Nat.mul_le_mul_left
    (10 * (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat) floors
  have s1 := share_ge (preset := preset) (fork := fork) pos
    (∑ i ∈ (slashedOnC split counted).filter (fun i => i < split.validators.data.size),
      propN tailC highC i +
    ∑ i ∈ (slashedOnC split counted).filter (fun i => i < split.validators.data.size),
      depPre eventsC i)
  have s2 := share_ge (preset := preset) (fork := fork) pos
    (∑ i ∈ (slashedOnC split counted).filter (fun i => i < split.validators.data.size),
      syncCr eventsC i)
  have s3 := share_ge (preset := preset) (fork := fork) pos
    (∑ i ∈ (slashedOnC split counted).filter (fun i => i < split.validators.data.size),
      consAmt eventsC i)
  have s4 := share_ge (preset := preset) (fork := fork) pos
    (∑ i ∈ (slashedOnC split counted).filter (fun i => i < split.validators.data.size),
      syncD eventsF i +
    ∑ i ∈ (slashedOnC split counted).filter (fun i => i < split.validators.data.size),
      syncD events i)
  have s5 := share_ge (preset := preset) (fork := fork) pos
    (∑ i ∈ (slashedOnC split counted).filter (fun i => i < split.validators.data.size),
      if (pinTerms config pulled anc fin).exitBeforeFin i = true then syncCr eventsF i else 0)
  have s6 := share_ge (preset := preset) (fork := fork) pos
    (∑ i ∈ (slashedOnC split counted).filter (fun i => i < split.validators.data.size),
      if (pinTerms config pulled anc fin).exitBeforeFin i = true then consAmt eventsF i else 0)
  have s7 := share_ge (preset := preset) (fork := fork) pos
    (∑ i ∈ (slashedOnC split counted).filter (fun i => i < split.validators.data.size),
      propN pre highC i)
  linarith

/-- The largest representable epoch is reserved for keys without an assigned exit. -/
private theorem exitEpoch_toNat_lt_of_ne_far {epoch : Epoch} (assigned : epoch ≠ FAR_FUTURE_EPOCH) :
    epoch.toNat < 2 ^ 64 - 1 := by
  have bound := epoch.toNat_lt
  have far : FAR_FUTURE_EPOCH.toNat = 2 ^ 64 - 1 := rfl
  have ne := mt UInt64.toNat_inj.mp assigned
  omega

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- A key that C's run creates and slashes is credited its proposer credits and consolidations.

It is also credited its deposits before its exit.

The run charges the key at the step that sets its exit, and its deposits stop there.

The key is unslashed before that step, since a slashed key has its exit set.

The consolidation credits that the run scans are among those of its events. -/
private theorem created_credC_le (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    {i : ℕ} (created : ¬ i < split.validators.data.size)
    (slashedC : (counted.validators.data[i]?.map (·.slashed)).getD false = true) :
    credC tailC highC i ≤ propN tailC highC i + depPre eventsC i + consAmt eventsC i := by
  obtain ⟨shared⟩ := h.toFin
  obtain ⟨fromFin⟩ := h.fromFin
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  obtain ⟨wc, foundC⟩ : ∃ wc, counted.validators.data[i]? = some wc := by
    cases f : counted.validators.data[i]? with
    | none => simp [f] at slashedC
    | some w => exact ⟨w, rfl⟩
  have markedC : wc.slashed = true := by simpa [foundC] using slashedC
  have assignedC := run_slashed_exit_assigned ((shared.append fromFin).append tailC) h.genesis
    h.caps.activation h.caps.compounding h.early h.delay i wc foundC markedC
  obtain ⟨c, inRun, index, -⟩ := PinKeys.Run.charge_of_exit tailC electra h.early i
    (fun v found => absurd (Array.getElem?_eq_some_iff.mp found).1 created) wc foundC assignedC
  have late := DirectSafety.Run.departureCharges_epoch_ge_start tailC electra h.early c inRun
  simp only at late
  obtain ⟨a, b, pre, step, post, site, u, w, foundA, foundB, unset, set, -, epochW⟩ :=
    tailC.departure_charge_site c inRun
  rw [index] at foundA foundB
  subst site
  have aFork : a.fork = fork :=
    fork_eq_of_run pre ((Run.nil.snoc step).append post) (Nat.le_refl _)
  have aEarly : a.fork < .glamsterdam := by rw [aFork]; exact h.early
  have aFulu : .fusaka ≤ a.fork := by rw [aFork]; exact h.fulu
  have aEpoch : (getCurrentEpoch a.state).toNat ≤ highC + 1 :=
    Nat.le_trans (UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps
      ((Run.nil.snoc step).append post).chainSteps)) endEpochC
  -- the key is unslashed at the step that sets its exit
  have cleanA : u.slashed = false := by
    cases s : u.slashed
    · rfl
    · exact absurd unset (run_slashed_exit_assigned ((shared.append fromFin).append pre)
        h.genesis h.caps.activation h.caps.compounding aEarly h.delay i u foundA s)
  -- the events of C's run are those before the step and those from it
  obtain ⟨e1, replayed1⟩ := pre.balanceEvents_ok aEarly highC
  obtain ⟨eS, replayedS⟩ := ((Run.nil.snoc step).append post).balanceEvents_ok h.early highC
  have whole := balanceEvents_append pre ((Run.nil.snoc step).append post) highC replayed1
    replayedS
  rw [← snoc_append_eq pre step post, replayedC] at whole
  obtain rfl := Except.ok.inj whole
  have insideC := (Array.getElem?_eq_some_iff.mp foundC).1
  have below := insideC.trans (BeaconState.validators_size_lt_of_lt_glamsterdam h.early counted)
  obtain ⟨v, rfl⟩ : ∃ v : ValidatorIndex, v.toNat = i :=
    ⟨UInt64.ofNat i, UInt64.toNat_ofNat_of_lt' below⟩
  have insideA := (Array.getElem?_eq_some_iff.mp foundA).1
  -- from the step on, the key is exited and not withdrawable through C
  have exited := exitEpoch_toNat_lt_of_ne_far set
  have held : (getCurrentEpoch counted).toNat < w.withdrawableEpoch.toNat := by
    have delay := (((shared.append fromFin).append pre).snoc step).exit_withdrawable_delay
      h.genesis v.toNat w foundB set
    have shallow := h.shallow
    have near := h.near
    have called := UInt64.le_iff_toNat_le.mp h.called
    have finSplit := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps fromFin.chainSteps)
    simp only at finSplit
    omega
  have zeroS := PinKeys.Run.charge_deposit_credit_zero (shared.append (fromFin.append pre))
    h.genesis step post aFulu h.early highC aEpoch replayedS v.toNat insideA w foundB exited held
  have cleanPre := prefix_deposits_clean h pre aEarly highC replayed1 v (by simp [foundA, cleanA])
  have depFirst := deposits_le_depPre e1 v.toNat cleanPre
  have scanPre := scan_le_events (fun _ => false) (fun s => decide (s = .deposits))
    (· = .deposits) (by intro s; simp) pre highC v replayed1
  have scanRest := scan_le_events (fun _ => false) (fun s => decide (s = .deposits))
    (· = .deposits) (by intro s; simp) ((Run.nil.snoc step).append post) highC v replayedS
  have consAll := scan_le_events (fun s => decide (s = .consolidations))
    (fun s => decide (s = .consolidations)) (· = .consolidations) (by intro s; simp)
    ((pre.snoc step).append post) highC v replayedC
  have depSplit := creditScan_append (fun _ => false) (fun s => decide (s = .deposits)) v.toNat
    highC pre ((Run.nil.snoc step).append post)
  rw [← snoc_append_eq pre step post] at depSplit
  have depMono : depPre e1 v.toNat ≤ depPre (e1 ++ eS) v.toNat := by
    unfold depPre
    simp only [List.filter_append, List.map_append, List.sum_append]
    omega
  beta_reduce at scanPre scanRest consAll
  rw [credC_split, credN_split]
  unfold consAmt
  omega

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The reward of one key of `CS` is within its charge, its shares and its bands, at ten quotients.

A key active at C is read at `createdCeil`, and one that has exited at its charge and credits.

The credits of a slashed created key are its proposer credits, deposits and consolidations. -/
private theorem cs_key_round (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    (Q : ℕ) (hQ : Q = (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat) {i : ℕ}
    (member : i ∈ (slashedOnC split counted).filter (fun i => ¬ i < split.validators.data.size)) :
    10 * Q * (if isActiveAt counted (getCurrentEpoch counted) i = true then
        3 * (min (createdCeil (pinTerms config pulled anc fin) tailC highC eventsC i)
          preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat / Q)
      else 3 * (min (chargeAmt tailC i + whistleExtra (pinTerms config pulled anc fin) tailC highC
          eventsC i) preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat / Q)) ≤
      10 * Q * (if isActiveAt counted (getCurrentEpoch counted) i = true then 0
        else 3 * ((chargeAmt tailC i + preset.upwardBand + (pinTerms config pulled anc fin).depth *
          (pinTerms config pulled anc fin).gainRateMax) / Q)) +
        33 * propN tailC highC i + 33 * depPre eventsC i + 33 * syncCr eventsC i +
        33 * consAmt eventsC i + 30 * (Q * whistC tailC highC i) +
        10 * (Q * bandC tailC highC i) + 10 * (Q * bandX fin highC i) +
        10 * (Q * (if isActiveAt counted (getCurrentEpoch counted) i = true then
          (if (pinTerms config pulled anc fin).gainHigh = true then
            preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat
          else (pinTerms config pulled anc fin).unitGain) else 0)) := by
  obtain ⟨fromFin⟩ := h.fromFin
  have quotient : 30 ≤ Q := hQ ▸ h.facts.whistleblower fork
  have pos : 0 < Q := by omega
  have up := h.bands.2
  have incBig := h.facts.incrementSize
  have below := h.facts.below
  obtain ⟨inSlashed, created⟩ := Finset.mem_filter.mp member
  obtain ⟨-, -, slashedC⟩ := Finset.mem_filter.mp inSlashed
  have insideC : i < counted.validators.data.size := by
    cases f : counted.validators.data[i]? with
    | none => simp [f] at slashedC
    | some w => exact (Array.getElem?_eq_some_iff.mp f).1
  have small := insideC.trans (BeaconState.validators_size_lt_of_lt_glamsterdam h.early counted)
  obtain ⟨eventsF, replayedF⟩ := fromFin.balanceEvents_ok h.early (getCurrentEpoch pulled).toNat
  -- the credits of the key and their bands
  have cred := created_credC_le h tailC highC endEpochC replayedC created slashedC
  obtain ⟨grossP, grossW, grossS, hbC, hbX⟩ :=
    credit_band_bounds h fromFin replayedF tailC highC endEpochC replayedC small
  have splitC := credC_split tailC highC i
  have splitN := credN_split tailC highC i
  obtain ⟨v, rfl⟩ : ∃ v : ValidatorIndex, v.toNat = i :=
    ⟨UInt64.ofNat i, UInt64.toNat_ofNat_of_lt' small⟩
  have consScan := scan_le_events (fun s => decide (s = .consolidations))
    (fun s => decide (s = .consolidations)) (· = .consolidations) (by intro s; simp) tailC highC v
    replayedC
  beta_reduce at consScan
  have consEq : consAmt eventsC v.toNat =
      ((eventsC.filter fun e => e.source = .consolidations).map (keyCredit v.toNat)).sum := rfl
  have pWT := Nat.mul_le_mul_right (whistC tailC highC v.toNat) (show 2 ≤ Q by omega)
  have pC := Nat.mul_le_mul_right (bandC tailC highC v.toNat) quotient
  have pX := Nat.mul_le_mul_right (bandX fin highC v.toNat) quotient
  by_cases active : isActiveAt counted (getCurrentEpoch counted) v.toNat = true
  · rw [ite_eq_left active, ite_eq_left active, ite_eq_left active]
    -- a key active at C has the band of its creation
    obtain ⟨wv, foundV, activeV⟩ := isActiveAt_eq_true_iff.mp active
    simp only [isActiveValidator, Bool.and_eq_true, decide_eq_true_eq] at activeV
    have finiteC := getCurrentEpoch_succ_lt_farFuture h.twoSlots counted
    have farNat : FAR_FUTURE_EPOCH.toNat = 2 ^ 64 - 1 := rfl
    have activated : ∃ w, counted.validators.data[v.toNat]? = some w ∧
        w.activationEpoch ≠ FAR_FUTURE_EPOCH ∧ w.activationEpoch ≤ getCurrentEpoch counted :=
      ⟨wv, foundV, fun far => by
        have := UInt64.le_iff_toNat_le.mp activeV.1
        rw [far] at this
        omega, activeV.1⟩
    have band := created_band h fromFin (getCurrentEpoch pulled).toNat (by omega) replayedF tailC
      highC endEpochC replayedC activated (by omega)
    have floorMin := Nat.div_mul_le_self
      (min (createdCeil (pinTerms config pulled anc fin) tailC highC eventsC v.toNat)
        preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat) Q
    have minLe := min_le_left (createdCeil (pinTerms config pulled anc fin) tailC highC eventsC
      v.toNat) preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat
    have minMax := min_le_right (createdCeil (pinTerms config pulled anc fin) tailC highC eventsC
      v.toNat) preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat
    have e : 10 * Q * (3 * (min (createdCeil (pinTerms config pulled anc fin) tailC highC eventsC
        v.toNat) preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat / Q)) =
        30 * (min (createdCeil (pinTerms config pulled anc fin) tailC highC eventsC v.toNat)
          preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat / Q * Q) := by ring
    rw [e]
    by_cases high : (pinTerms config pulled anc fin).gainHigh = true
    · rw [ite_eq_left high]
      have pM := Nat.mul_le_mul_right preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat
        (show 3 ≤ Q by omega)
      omega
    · rw [ite_eq_right high]
      have lowGain : (pinTerms config pulled anc fin).gainHigh = false := by simpa using high
      -- off the high rate, the gains of the credits are within a tenth of them
      have wide := wide_of_lowGain h lowGain
      have tenth := gain_tenth preset.EFFECTIVE_BALANCE_INCREMENT.toNat WEIGHT_DENOMINATOR.toNat
        (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum (pinTerms config pulled anc fin).perIncrement
        (pinTerms config pulled anc fin).depth (credC tailC highC v.toNat +
          whistC tailC highC v.toNat + syncCr eventsC v.toNat) wide
      rw [Nat.mul_assoc (11 * (credC tailC highC v.toNat + whistC tailC highC v.toNat +
          syncCr eventsC v.toNat) / (10 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat))] at tenth
      have ceilEq : createdCeil (pinTerms config pulled anc fin) tailC highC eventsC v.toNat =
          credC tailC highC v.toNat + whistC tailC highC v.toNat + syncCr eventsC v.toNat +
            (pinTerms config pulled anc fin).depth *
              (11 * (credC tailC highC v.toNat + whistC tailC highC v.toNat +
                  syncCr eventsC v.toNat) / (10 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat) *
                ((pinTerms config pulled anc fin).perIncrement *
                  (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum) / WEIGHT_DENOMINATOR.toNat) +
            (pinTerms config pulled anc fin).depth *
              ((pinTerms config pulled anc fin).perIncrement *
                (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum / WEIGHT_DENOMINATOR.toNat + 2) +
            preset.downwardBand := by
        unfold createdCeil
        simp only [lowGain, Bool.false_eq_true, ↓reduceIte]
      have unitEq : (pinTerms config pulled anc fin).unitGain =
          (pinTerms config pulled anc fin).depth *
            ((pinTerms config pulled anc fin).perIncrement *
              (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum / WEIGHT_DENOMINATOR.toNat + 2) := rfl
      have pU := Nat.mul_le_mul_right (pinTerms config pulled anc fin).unitGain
        (show 3 ≤ Q by omega)
      omega
  · rw [ite_eq_right active, ite_eq_right active, ite_eq_right active]
    -- a key that has exited is read at its charge and its credits
    have extra : chargeAmt tailC v.toNat + whistleExtra (pinTerms config pulled anc fin) tailC
        highC eventsC v.toNat = (chargeAmt tailC v.toNat + preset.upwardBand +
          (pinTerms config pulled anc fin).depth * (pinTerms config pulled anc fin).gainRateMax) +
        (credC tailC highC v.toNat + whistC tailC highC v.toNat + syncCr eventsC v.toNat) := by
      unfold whistleExtra
      omega
    have mn := Nat.div_le_div_right (c := Q)
      ((min_le_left _ preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat).trans (le_of_eq extra))
    have fl := floor_add_ceil_le (chargeAmt tailC v.toNat + preset.upwardBand +
        (pinTerms config pulled anc fin).depth * (pinTerms config pulled anc fin).gainRateMax)
      (credC tailC highC v.toNat + whistC tailC highC v.toNat + syncCr eventsC v.toNat) Q pos
    have mul := Nat.mul_le_mul_left (10 * Q) (Nat.mul_le_mul_left 3 (mn.trans fl))
    have dist : 10 * Q * (3 * ((chargeAmt tailC v.toNat + preset.upwardBand +
        (pinTerms config pulled anc fin).depth * (pinTerms config pulled anc fin).gainRateMax) / Q +
        (credC tailC highC v.toNat + whistC tailC highC v.toNat + syncCr eventsC v.toNat + Q - 1) /
          Q)) =
        10 * Q * (3 * ((chargeAmt tailC v.toNat + preset.upwardBand +
          (pinTerms config pulled anc fin).depth * (pinTerms config pulled anc fin).gainRateMax) /
            Q)) +
        10 * Q * (3 * ((credC tailC highC v.toNat + whistC tailC highC v.toNat +
          syncCr eventsC v.toNat + Q - 1) / Q)) := by ring
    have hc := ceil_round (credC tailC highC v.toNat + whistC tailC highC v.toNat +
      syncCr eventsC v.toNat) Q pos
    -- credits bring a band of at least four
    have big : credC tailC highC v.toNat + whistC tailC highC v.toNat + syncCr eventsC v.toNat = 0 ∨
        preset.upwardBand ≤ bandC tailC highC v.toNat + bandX fin highC v.toNat := by
      omega
    rcases big with zero | four
    · omega
    · have pB := Nat.mul_le_mul_left Q four
      have pUp := Nat.mul_le_mul_left Q (show 4 ≤ preset.upwardBand by omega)
      rw [Nat.mul_add] at pB
      omega

/-- The slack and the rounding of the rewards of the keys of `CS` are paid by their shares.

A created key that has exited is read at its charge and its credits.

A created key active at C is read at `createdCeil`.

Its credits are paid by the shares, with a tenth for their gains.

Its unit, or its largest cap at a high rate, is paid for each active key.

Each credited key has an upward band, which pays the rounding of its floor.

The credits of a slashed created key are its proposer credits.

They are also its deposits before the slashing and its consolidations. -/
private theorem whistle_slack_cs (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC) :
    3 * (∑ i ∈ (((slashedOnC split counted).filter (fun i => ¬ i <
        split.validators.data.size)).filter (fun i => isActiveAt counted (getCurrentEpoch counted) i
        = true)), min (createdCeil (pinTerms config pulled anc fin) tailC highC eventsC i)
        preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat / (parameters preset
            fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat) +
      3 * (∑ i ∈ (((slashedOnC split counted).filter (fun i => ¬ i <
          split.validators.data.size)).filter (fun i => ¬ isActiveAt counted (getCurrentEpoch
          counted) i = true)), min (chargeAmt tailC i + whistleExtra (pinTerms config pulled anc
          fin) tailC highC eventsC i)
        preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat / (parameters preset
            fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat) ≤
      3 * (∑ i ∈ (((slashedOnC split counted).filter (fun i => ¬ i <
          split.validators.data.size)).filter (fun i => ¬ isActiveAt counted (getCurrentEpoch
          counted) i = true)), (chargeAmt tailC i + preset.upwardBand + (pinTerms config pulled anc
          fin).depth * (pinTerms config pulled anc fin).gainRateMax) / (parameters preset
          fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat) +
        3 * (∑ i ∈ ((slashedOnC split counted).filter (fun i => ¬ i < split.validators.data.size)),
            whistC tailC highC i) +
        (wShare preset fork ((∑ v ∈ CS counted split, propN tailC highC v.toNat) +
            ∑ v ∈ CS counted split, depPre eventsC v.toNat) +
          wShare preset fork (∑ v ∈ CS counted split, syncCr eventsC v.toNat) +
          wShare preset fork (∑ v ∈ CS counted split, consAmt eventsC v.toNat) +
          (∑ v ∈ CS counted split, bandC tailC highC v.toNat) +
          (∑ v ∈ CS counted split, bandX fin highC v.toNat) : ℕ) +
        ((CS counted split).filter fun v => isActiveAt counted (getCurrentEpoch counted) v.toNat =
          true).card * (if (pinTerms config pulled anc fin).gainHigh = true then
              preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat
            else (pinTerms config pulled anc fin).unitGain) := by
  have quotient := h.facts.whistleblower fork
  have pos : 0 < (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat := by omega
  -- each key of `CS` is within its charge, its shares and its bands
  have rounds := Finset.sum_le_sum fun i (m : i ∈ (slashedOnC split counted).filter
      (fun i => ¬ i < split.validators.data.size)) =>
    cs_key_round h tailC highC endEpochC replayedC _ rfl m
  simp only [Finset.sum_add_distrib, ← Finset.mul_sum] at rounds
  -- the two groups of the created keys are the keys active at C and the others
  have active (f g : ℕ → ℕ) : ∑ i ∈ (slashedOnC split counted).filter
      (fun i => ¬ i < split.validators.data.size),
        (if isActiveAt counted (getCurrentEpoch counted) i = true then f i else g i) =
      ∑ i ∈ ((slashedOnC split counted).filter (fun i => ¬ i < split.validators.data.size)).filter
        (fun i => isActiveAt counted (getCurrentEpoch counted) i = true), f i +
      ∑ i ∈ ((slashedOnC split counted).filter (fun i => ¬ i < split.validators.data.size)).filter
        (fun i => ¬ isActiveAt counted (getCurrentEpoch counted) i = true), g i :=
    Finset.sum_ite _ _
  simp only [active, Finset.sum_const_zero, Nat.zero_add, Nat.add_zero] at rounds
  simp only [← Finset.mul_sum] at rounds
  -- the units of the keys active at C are those of the active keys of `CS`
  have cap := sum_CS_positions h (fun i => if isActiveAt counted (getCurrentEpoch counted) i = true
    then 1 else 0)
  rw [← Finset.sum_filter, ← Finset.sum_filter, Finset.sum_const, Finset.sum_const,
    smul_eq_mul, smul_eq_mul, Nat.mul_one, Nat.mul_one] at cap
  have units : ∑ i ∈ ((slashedOnC split counted).filter
      (fun i => ¬ i < split.validators.data.size)).filter
        (fun i => isActiveAt counted (getCurrentEpoch counted) i = true),
        (if (pinTerms config pulled anc fin).gainHigh = true then
          preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat
        else (pinTerms config pulled anc fin).unitGain) =
      ((CS counted split).filter fun v => isActiveAt counted (getCurrentEpoch counted) v.toNat =
        true).card * (if (pinTerms config pulled anc fin).gainHigh = true then
          preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat
        else (pinTerms config pulled anc fin).unitGain) := by
    rw [Finset.sum_const, smul_eq_mul, cap]
  rw [units] at rounds
  rw [sum_CS_positions h (fun i => propN tailC highC i), sum_CS_positions h (fun i =>
      depPre eventsC i), sum_CS_positions h (fun i => syncCr eventsC i),
    sum_CS_positions h (fun i => consAmt eventsC i), sum_CS_positions h (fun i =>
      bandC tailC highC i), sum_CS_positions h (fun i => bandX fin highC i)]
  refine Nat.le_of_mul_le_mul_left (c := 10 *
    (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat) ?_ (by omega)
  have s1 := share_ge (preset := preset) (fork := fork) pos
    (∑ i ∈ (slashedOnC split counted).filter (fun i => ¬ i < split.validators.data.size),
      propN tailC highC i +
    ∑ i ∈ (slashedOnC split counted).filter (fun i => ¬ i < split.validators.data.size),
      depPre eventsC i)
  have s2 := share_ge (preset := preset) (fork := fork) pos
    (∑ i ∈ (slashedOnC split counted).filter (fun i => ¬ i < split.validators.data.size),
      syncCr eventsC i)
  have s3 := share_ge (preset := preset) (fork := fork) pos
    (∑ i ∈ (slashedOnC split counted).filter (fun i => ¬ i < split.validators.data.size),
      consAmt eventsC i)
  linarith

/-- A charge on C's run of a key not active at C is due by C's epoch.

It is also due after the split's epoch and the seed lookahead, as every charge of the run is.

The key is activated at the step that starts its exit, so it is inactive at C only by its exit.

That step is a seed lookahead before the charge's epoch, so the activation is by R's epoch. -/
private theorem charge_due (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) {i : ℕ}
    (inactive : ¬ isActiveAt counted (getCurrentEpoch counted) i = true)
    {c : DepartureCharge} (member : c ∈ tailC.departureCharges) (index : c.index = i) :
    (getCurrentEpoch split).toNat + 1 + preset.MAX_SEED_LOOKAHEAD.toNat ≤ c.epoch ∧
      c.epoch ≤ (getCurrentEpoch counted).toNat ∧
      ∀ wC, counted.validators.data[i]? = some wC →
        wC.activationEpoch.toNat ≤ (getCurrentEpoch pulled).toNat := by
  obtain ⟨fromFin⟩ := h.fromFin
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  obtain ⟨stop, chosen⟩ := stop_of_charge fromFin tailC member index
  have selected := stop.selected
  rw [chosen] at selected
  obtain ⟨-, -, -, next, step, remaining, -, inStep, v, w, atStop, atNext, unset, assigned, -⟩ :=
    selected
  have stopElectra : .pectra ≤ stop.state.fork :=
    Nat.le_trans electra (fork_le_of_chainSteps stop.pre.chainSteps)
  have activated := step.chainStep.exit_assigned_activated stopElectra atStop atNext unset assigned
  have activatedNat := UInt64.le_iff_toNat_le.mp activated
  have toCounted := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps stop.post.chainSteps)
  simp only at toCounted
  have stepLow := DirectSafety.Run.departureCharges_epoch_ge_start (Run.nil.snoc step) stopElectra
    (Nat.lt_of_le_of_lt (fork_le_of_chainSteps remaining.chainSteps) h.early) c
    (by simpa [Run.departureCharges] using inStep)
  obtain ⟨last, located, kept⟩ := stop.post.registryLifecycle.validators i v atStop
  have below := getCurrentEpoch_succ_lt_farFuture h.twoSlots stop.state.state
  have far : FAR_FUTURE_EPOCH.toNat = 2 ^ 64 - 1 := rfl
  have sameActivation := kept.activationEpoch (fun same => by
    rw [same] at activatedNat
    omega)
  obtain ⟨wC, foundC, -, epochC⟩ := Run.departure_charge_exit tailC c member
  rw [index] at foundC
  obtain rfl : last = wC := Option.some.inj (located.symm.trans foundC)
  have notActive : isActiveValidator last (getCurrentEpoch counted) = false := by
    cases now : isActiveValidator last (getCurrentEpoch counted)
    · rfl
    · exact absurd (isActiveAt_eq_true_iff.mpr ⟨last, located, now⟩) inactive
  simp only [isActiveValidator, Bool.and_eq_false_iff, decide_eq_false_iff_not] at notActive
  have due : c.epoch ≤ (getCurrentEpoch counted).toNat := by
    rw [← epochC]
    rcases notActive with late | exited
    · exact absurd (UInt64.le_iff_toNat_le.mpr (by rw [sameActivation]; omega)) late
    · exact Nat.le_of_not_lt fun lt => exited (UInt64.lt_iff_toNat_lt.mpr lt)
  refine ⟨DirectSafety.Run.departureCharges_epoch_ge_start tailC electra h.early c member, due,
    fun wC' found => ?_⟩
  obtain rfl : wC' = last := Option.some.inj (found.symm.trans located)
  have near := h.near
  have lookahead : 3 ≤ preset.MAX_SEED_LOOKAHEAD.toNat := h.window
  rw [sameActivation]
  omega

/-- Positions charged on C's run that are not active at C pay at most the window, and are few.

Each such position holds a validator at C, so it is a validator index.

Its charge is due by C's epoch, and it is activated by R's epoch, so `charged_count_of` counts it.
-/
private theorem charged_window (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (T : Finset ℕ)
    (keys : ∀ i ∈ T, ¬ isActiveAt counted (getCurrentEpoch counted) i = true ∧
      ∃ c ∈ tailC.departureCharges, c.index = i) :
    ∑ i ∈ T, chargeAmt tailC i ≤ (pinTerms config pulled anc fin).queueWindow ∧
      T.card ≤ (pinTerms config pulled anc fin).queueKeys := by
  classical
  have small : ∀ i ∈ T, i < 2 ^ 64 := by
    intro i member
    obtain ⟨-, c, inRun, index⟩ := keys i member
    obtain ⟨w, found, -⟩ := Run.departure_charge_exit tailC c inRun
    rw [index] at found
    exact (Array.getElem?_eq_some_iff.mp found).1.trans
      (BeaconState.validators_size_lt_of_lt_glamsterdam h.early counted)
  have injective : Set.InjOn (fun i => (UInt64.ofNat i : ValidatorIndex)) T :=
    fun a ha b hb same => by
      have := congrArg UInt64.toNat same
      rwa [UInt64.toNat_ofNat_of_lt' (small a ha), UInt64.toNat_ofNat_of_lt' (small b hb)] at this
  have back : ∀ v ∈ T.image (fun i => (UInt64.ofNat i : ValidatorIndex)), v.toNat ∈ T ∧
      ¬ isActiveAt counted (getCurrentEpoch counted) v.toNat = true ∧
      ∃ c ∈ tailC.departureCharges, c.index = v.toNat := by
    intro v member
    obtain ⟨i, inT, rfl⟩ := Finset.mem_image.mp member
    rw [UInt64.toNat_ofNat_of_lt' (small i inT)]
    exact ⟨inT, keys i inT⟩
  have image : ∑ v ∈ T.image (fun i => (UInt64.ofNat i : ValidatorIndex)),
      chargeAmt tailC v.toNat = ∑ i ∈ T, chargeAmt tailC i :=
    sum_image_ofNat T small (chargeAmt tailC)
  refine ⟨image ▸ charge_amounts_le_queueWindow h tailC _ fun v member => ?_, ?_⟩
  · obtain ⟨-, inactive, c, inRun, index⟩ := back v member
    exact ⟨c, inRun, index, (charge_due h tailC inactive inRun index).2.1⟩
  · rw [← Finset.card_image_of_injOn injective]
    refine charged_count_of h tailC _ fun v member => ?_
    obtain ⟨-, inactive, c, inRun, index⟩ := back v member
    exact ⟨(charge_due h tailC inactive inRun index).2.2,
      fun d dRun dIndex => (charge_due h tailC inactive dRun dIndex).2.1, c, inRun, index⟩

/-- The keys that R exits are paid by `reserveW`, with the queue window of the created ones.

A key of the split's registry that is not slashed at R is a term of `exitedSlashable`.

It exits by R's next epoch.

It is read at its balance and rise, or at its finalized balance.

A key of the split's registry that is none of those, and not active at C, is not slashed at R.

Its exit was assigned on C's branch.

It pays its charge and its rise after it, from the window.

A created key that has exited by C pays its charge from the window.

Each key that `queueKeys` counts adds its band and the gains of the largest rate. -/
private theorem whistle_exited (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ) :
    3 * (∑ i ∈ (((slashedOnC split counted).filter (fun i => i < split.validators.data.size)).filter
        (fun i => PinTerms.exitedSlashable anc pulled i = true)),
          whistleEnv (pinTerms config pulled anc fin) pulled anc fin i
            / (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat) +
      3 * (∑ i ∈ ((((slashedOnC split counted).filter (fun i => i <
          split.validators.data.size)).filter (fun i => ¬ (pinTerms config pulled anc fin).slashedRB
          i = true ∧ ¬ PinTerms.exitedSlashable anc pulled i = true)).filter (fun i => ¬ isActiveAt
          counted
          (getCurrentEpoch counted) i = true)), (chargeAmt tailC i + riseQ tailC highC i) /
          (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat) +
      3 * (∑ i ∈ (((slashedOnC split counted).filter (fun i => ¬ i <
          split.validators.data.size)).filter (fun i => ¬ isActiveAt counted (getCurrentEpoch
          counted) i = true)), (chargeAmt tailC i + preset.upwardBand + (pinTerms config pulled anc
          fin).depth * (pinTerms config pulled anc fin).gainRateMax) / (parameters preset
          fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat) ≤
      (pinTerms config pulled anc fin).reserveW := by
  classical
  set G := preset.upwardBand + (pinTerms config pulled anc fin).depth *
    (pinTerms config pulled anc fin).gainRateMax with hG
  set W := (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat with hW
  set S1 := ((slashedOnC split counted).filter (fun i => i < split.validators.data.size)).filter
    (fun i => PinTerms.exitedSlashable anc pulled i = true) with hS1
  set S2 := (((slashedOnC split counted).filter (fun i => i < split.validators.data.size)).filter
    (fun i => ¬ (pinTerms config pulled anc fin).slashedRB i = true ∧
      ¬ PinTerms.exitedSlashable anc pulled i = true)).filter
    (fun i => ¬ isActiveAt counted (getCurrentEpoch counted) i = true) with hS2
  set S3 := ((slashedOnC split counted).filter (fun i => ¬ i < split.validators.data.size)).filter
    (fun i => ¬ isActiveAt counted (getCurrentEpoch counted) i = true) with hS3
  set P := (Finset.range pulled.validators.data.size).filter fun i =>
    ((pulled.validators.data[i]?).map (·.slashed)).getD false = false ∧
      ((pulled.validators.data[i]?).map fun v =>
        decide (v.exitEpoch.toNat ≤ (getCurrentEpoch pulled).toNat + 1)).getD false = true ∧
      (pulled.validators.data[i]?).any (fun v =>
        decide (anc.finalizedCheckpoint.epoch.toNat < v.withdrawableEpoch.toNat)) = true with hP
  have reserveEq : (pinTerms config pulled anc fin).reserveW =
      3 * (∑ i ∈ P, max (balanceAt pulled i + (pinTerms config pulled anc fin).rise i)
          (max ((pinTerms config pulled anc fin).bF i) (balanceAt fin i)) +
        (if (pinTerms config pulled anc fin).tight = true then 0 else
          (pinTerms config pulled anc fin).queueWindow +
            (pinTerms config pulled anc fin).queueKeys * G)) / W := rfl
  -- the keys that `exitedSlashable` marks are its terms
  have group1 : ∑ i ∈ S1, whistleEnv (pinTerms config pulled anc fin) pulled anc fin i ≤
      ∑ i ∈ P, max (balanceAt pulled i + (pinTerms config pulled anc fin).rise i)
        (max ((pinTerms config pulled anc fin).bF i) (balanceAt fin i)) := by
    have term : ∀ i ∈ S1, whistleEnv (pinTerms config pulled anc fin) pulled anc fin i =
        max (balanceAt pulled i + (pinTerms config pulled anc fin).rise i)
          (max ((pinTerms config pulled anc fin).bF i) (balanceAt fin i)) := by
      intro i member
      have marked := of_decide_eq_true (Finset.mem_filter.mp member).2
      have notRB : ¬ (pinTerms config pulled anc fin).slashedRB i = true := by
        rw [slashedRB_eq]
        simp only [decide_eq_true_eq, not_and]
        intro slashed
        rw [marked.1] at slashed
        exact absurd slashed Bool.false_ne_true
      rw [whistleEnv, ite_eq_right_of_eq_false _ _ (eq_false notRB),
        ite_eq_left_of_eq_true _ _ (eq_true (Or.inl (Finset.mem_filter.mp member).2))]
    rw [Finset.sum_congr rfl term]
    refine Finset.sum_le_sum_of_subset fun i member => ?_
    have marked := of_decide_eq_true (Finset.mem_filter.mp member).2
    obtain ⟨w, found⟩ := validator_of_flag (state := pulled) (Or.inl marked.2.2)
    exact Finset.mem_filter.mpr
      ⟨Finset.mem_range.mpr (Array.getElem?_eq_some_iff.mp found).1, marked⟩
  -- the keys charged on C's run, of the split's registry or created on it
  have createdCharged : ∀ i ∈ S3, ∃ c ∈ tailC.departureCharges, c.index = i := by
    intro i member
    obtain ⟨⟨slashedC, created⟩, -⟩ := Finset.mem_filter.mp member |>.imp_left Finset.mem_filter.mp
    obtain ⟨-, flags⟩ := Finset.mem_filter.mp slashedC
    have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
    cases foundC : counted.validators.data[i]? with
    | none => simp [foundC] at flags
    | some w =>
      have marked : w.slashed = true := by simpa [foundC] using flags.2
      have assigned := (Internal.CapStep.run tailC h.caps.activation h.caps.compounding
        h.early).1.appended h.delay i w (Nat.le_of_not_lt created) foundC marked
      obtain ⟨c, inRun, index, -⟩ := PinKeys.Run.charge_of_exit tailC electra h.early i
        (fun v found => absurd (Array.getElem?_eq_some_iff.mp found).1 created) w foundC assigned
      exact ⟨c, inRun, index⟩
  set T2 := S2.filter fun i => ∃ c ∈ tailC.departureCharges, c.index = i with hT2
  have dropUncharged : ∑ i ∈ S2, (chargeAmt tailC i + riseQ tailC highC i) =
      ∑ i ∈ T2, (chargeAmt tailC i + riseQ tailC highC i) := by
    rw [hT2, Finset.sum_filter (p := fun i => ∃ c ∈ tailC.departureCharges, c.index = i)]
    refine Finset.sum_congr rfl fun i _ => ?_
    split_ifs with charged
    · rfl
    · rw [chargeAmt_eq_zero tailC charged,
        riseQ_eq_zero tailC highC i fun c member same => charged ⟨c, member, same⟩]
      rfl
  have inT : ∀ i ∈ T2 ∪ S3, ¬ isActiveAt counted (getCurrentEpoch counted) i = true ∧
      ∃ c ∈ tailC.departureCharges, c.index = i := by
    intro i member
    rcases Finset.mem_union.mp member with inT2 | inS3
    · obtain ⟨inS2, charged⟩ := Finset.mem_filter.mp inT2
      exact ⟨(Finset.mem_filter.mp inS2).2, charged⟩
    · exact ⟨(Finset.mem_filter.mp inS3).2, createdCharged i inS3⟩
  have apart : Disjoint T2 S3 := by
    refine Finset.disjoint_left.mpr fun i one two => ?_
    have small := (Finset.mem_filter.mp (Finset.mem_filter.mp (Finset.mem_filter.mp
      (Finset.mem_filter.mp one).1).1).1).2
    exact (Finset.mem_filter.mp (Finset.mem_filter.mp two).1).2 small
  have queued : ∑ i ∈ T2, (chargeAmt tailC i + riseQ tailC highC i) +
      ∑ i ∈ S3, (chargeAmt tailC i + preset.upwardBand +
        (pinTerms config pulled anc fin).depth * (pinTerms config pulled anc fin).gainRateMax) ≤
      (if (pinTerms config pulled anc fin).tight = true then 0 else
        (pinTerms config pulled anc fin).queueWindow +
          (pinTerms config pulled anc fin).queueKeys * G) := by
    by_cases tight : (pinTerms config pulled anc fin).tight = true
    · -- tight: no charge of the run is due by C's epoch
      have empty : T2 ∪ S3 = ∅ := by
        refine Finset.eq_empty_of_forall_notMem fun i member => ?_
        obtain ⟨inactive, c, inRun, index⟩ := inT i member
        have bounds := charge_due h tailC inactive inRun index
        have depthBound := (tight_iff config pulled anc fin).mp tight
        have finalized := UInt64.le_iff_toNat_le.mp h.finalized
        have near := h.near
        omega
      have none2 : T2 = ∅ := Finset.subset_empty.mp (empty ▸ Finset.subset_union_left)
      have none3 : S3 = ∅ := Finset.subset_empty.mp (empty ▸ Finset.subset_union_right)
      simp [none2, none3, tight]
    · rw [ite_eq_right_of_eq_false _ _ (eq_false tight)]
      have rises : ∀ i ∈ T2, riseQ tailC highC i ≤ G := fun i _ => by
        rw [hG]
        exact riseQ_le h tailC highC i
      obtain ⟨window, count⟩ := charged_window h tailC (T2 ∪ S3) inT
      rw [Finset.sum_union apart] at window
      rw [Finset.card_union_of_disjoint apart] at count
      have riseSum : ∑ i ∈ T2, riseQ tailC highC i ≤ T2.card * G := by
        simpa using Finset.sum_le_card_nsmul T2 _ G rises
      have rewrite3 : ∑ i ∈ S3, (chargeAmt tailC i + preset.upwardBand +
          (pinTerms config pulled anc fin).depth * (pinTerms config pulled anc fin).gainRateMax) =
          ∑ i ∈ S3, chargeAmt tailC i + S3.card * G := by
        rw [hG, Finset.sum_add_distrib, Finset.sum_add_distrib, Finset.sum_const, Finset.sum_const,
          smul_eq_mul, smul_eq_mul]
        ring
      rw [Finset.sum_add_distrib, rewrite3]
      have times := Nat.mul_le_mul_right G count
      rw [Nat.add_mul] at times
      omega
  have floors := DirectSafety.Apriori.Internal.sum_div_le S1
    (whistleEnv (pinTerms config pulled anc fin) pulled anc fin) W
  have floors2 := DirectSafety.Apriori.Internal.sum_div_le S2
    (fun i => chargeAmt tailC i + riseQ tailC highC i) W
  have floors3 := DirectSafety.Apriori.Internal.sum_div_le S3
    (fun i => chargeAmt tailC i + preset.upwardBand +
      (pinTerms config pulled anc fin).depth * (pinTerms config pulled anc fin).gainRateMax) W
  rw [reserveEq]
  generalize ∑ i ∈ S1, whistleEnv (pinTerms config pulled anc fin) pulled anc fin i = a
    at floors group1
  generalize ∑ i ∈ S2, (chargeAmt tailC i + riseQ tailC highC i) = b at floors2 dropUncharged
  generalize ∑ i ∈ S3, (chargeAmt tailC i + preset.upwardBand +
    (pinTerms config pulled anc fin).depth * (pinTerms config pulled anc fin).gainRateMax) = c
    at floors3 queued
  have total : 3 * (a / W) + 3 * (b / W) + 3 * (c / W) ≤ 3 * (a + b + c) / W := by
    calc 3 * (a / W) + 3 * (b / W) + 3 * (c / W) = 3 * (a / W + b / W + c / W) := by ring
      _ ≤ 3 * ((a + b + c) / W) := Nat.mul_le_mul_left 3
          ((Nat.add_le_add Nat.div_add_div_le_add_div (Nat.le_refl _)).trans
            Nat.div_add_div_le_add_div)
      _ ≤ 3 * (a + b + c) / W := Nat.mul_div_le_mul_div_assoc 3 (a + b + c) W
  refine le_trans (Nat.add_le_add (Nat.add_le_add (Nat.mul_le_mul_left 3 floors)
    (Nat.mul_le_mul_left 3 floors2)) (Nat.mul_le_mul_left 3 floors3)) (total.trans ?_)
  exact Nat.div_le_div_right (Nat.mul_le_mul_left 3 (by omega))

/-- A key active at C has no exit by the finalized epoch at R, so its `bF` is zero.

Such an exit is already set at the finalized state, which would leave the key inactive at C. -/
private theorem bF_zero_of_active (h : Setting config checks g split fin pulled anc counted V)
    {i : ℕ} (active : isActiveAt counted (getCurrentEpoch counted) i = true) :
    (pinTerms config pulled anc fin).bF i = 0 := by
  obtain ⟨fromFin⟩ := h.fromFin
  obtain ⟨tailC⟩ := h.toCounted
  have stays : (pinTerms config pulled anc fin).exitBeforeFin i = false := by
    show (pulled.validators.data[i]?).any
      (fun v => decide (v.exitEpoch.toNat ≤ (getCurrentEpoch fin).toNat)) = false
    cases found : pulled.validators.data[i]? with
    | none => rfl
    | some w =>
      simp only [Option.any_some, decide_eq_false_iff_not]
      intro exited
      obtain ⟨w0, foundFin, kept⟩ := exit_kept_of_le_fin h found exited
      have inactive := inactive_of_exited h.twoSlots (fromFin.append tailC) foundFin
        (by rw [kept]; exact exited)
      simp only at inactive
      rw [inactive] at active
      exact Bool.false_ne_true active
  show (if (pinTerms config pulled anc fin).exitBeforeFin i = true then _ else 0) = 0
  rw [stays]
  rfl

/-- Three rewards at a bound above an aligned bound cost at most the excess more.

The excess is zero or an increment, since both bounds are whole numbers of increments.

An excess below an increment could raise the quotient's floor by one.

Three rewards weigh that more than the excess itself. -/
private theorem floor_excess {E V r Q inc : ℕ} (quotient : 30 ≤ Q) (big : 4 ≤ inc)
    (alignedE : E % inc = 0) (alignedV : V % inc = 0) (within : V ≤ E + r) :
    3 * (max E V / Q) ≤ 3 * (E / Q) + r := by
  by_cases le : V ≤ E
  · rw [max_eq_left le]
    omega
  · have lt : E < V := Nat.lt_of_not_le le
    rw [max_eq_right lt.le]
    have gap := add_le_of_lt_of_aligned alignedV alignedE lt
    obtain ⟨x, rfl⟩ := Nat.exists_eq_add_of_le lt.le
    have sum : (E + x) / Q ≤ E / Q + x / Q + 1 := by
      rw [Nat.add_div (by omega)]
      split_ifs <;> omega
    have small : x / Q ≤ x / 30 := Nat.div_le_div_left quotient (by norm_num)
    omega

/-- The balance of a key at R with its rise is a whole number of increments. -/
private theorem eR_rise_aligned (h : Setting config checks g split fin pulled anc counted V)
    {i : ℕ} (within : i < pulled.validators.data.size) :
    (balanceAt pulled i + (pinTerms config pulled anc fin).rise i) %
      preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0 := by
  obtain ⟨kind, alignedMin, alignedMax⟩ := capAt_kind h i within
  obtain ⟨alignedR, alignedFin⟩ := balances_aligned h i
  have fill : ∀ X : ℕ, X % preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0 →
      (balanceAt pulled i + (X - balanceAt pulled i)) %
        preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0 := fun X aligned => by
    rcases le_total (balanceAt pulled i) X with le | le
    · rw [Nat.add_sub_of_le le]
      exact aligned
    · rw [Nat.sub_eq_zero_of_le le, Nat.add_zero]
      exact alignedR
  by_cases kept : (pinTerms config pulled anc fin).keptArm i = true
  · have capAligned : (pinTerms config pulled anc fin).capFor i %
        preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0 := by
      rw [capFor_eq]
      split
      · rcases kind with e | e <;> rw [e] <;> assumption
      · exact alignedMax
    rw [rise_kept config pulled anc fin i rfl kept]
    exact fill _ (min_max_aligned capAligned (min_max_aligned (round_aligned _ _)
      (min_max_aligned alignedFin (round_aligned _ _)).2).1).1
  · rw [rise_of_notKept h i kept]
    exact fill _ alignedMax

/-- A key that `whistle_free` pays is slashable at R, as `flagged` reads the term.

It is in R's registry and unslashed there.

It is activated by R's next epoch.

It is not yet withdrawable at the finalized epoch.

A key outside these cases is a term of `slashedRB`, `lateB` or `pendingRB`.

`sc3a_unwithdrawn` excludes a key that is withdrawable by the finalized epoch. -/
private theorem free_slashable (h : Setting config checks g split fin pulled anc counted V)
    {i : ℕ} (inside : i < split.validators.data.size) (below : i < 2 ^ 64)
    (unslashedS : (split.validators.data[i]?.map (·.slashed)).getD false = false)
    (slashedC : (counted.validators.data[i]?.map (·.slashed)).getD false = true)
    (notSlashedR : ¬ (pinTerms config pulled anc fin).slashedRB i = true)
    (active : isActiveAt counted (getCurrentEpoch counted) i = true)
    (notLate : ¬ ((pinTerms config pulled anc fin).tight = false ∧
      ((pinTerms config pulled anc fin).lateB i = true ∨
        (pinTerms config pulled anc fin).pendingRB i = true))) :
    ∃ w, pulled.validators.data[i]? = some w ∧ w.slashed = false ∧
      w.activationEpoch.toNat ≤ (getCurrentEpoch pulled).toNat + 1 ∧
      anc.finalizedCheckpoint.epoch.toNat < w.withdrawableEpoch.toNat := by
  classical
  obtain ⟨rp⟩ := h.toPulled
  have finSplit := UInt64.le_iff_toNat_le.mp h.finalized
  have near := h.near
  have roundTrip : (UInt64.ofNat i).toNat = i := UInt64.toNat_ofNat_of_lt' below
  have oldFound := Array.getElem?_eq_getElem inside
  have oldUnslashed : split.validators.data[i].slashed = false := by
    simpa [oldFound] using unslashedS
  obtain ⟨w, foundR, lifeSplit⟩ := rp.registryLifecycle.validators i _ oldFound
  have unslashedR : w.slashed = false := by
    by_contra slashed
    exact notSlashedR (slashedRB_of_newly_slashed h oldFound foundR oldUnslashed
      (by simpa using slashed))
  have activated : w.activationEpoch.toNat ≤ (getCurrentEpoch pulled).toNat + 1 := by
    by_contra late
    by_cases tight : (pinTerms config pulled anc fin).tight = true
    · have bound := (tight_iff config pulled anc fin).mp tight
      have memberAC : (UInt64.ofNat i : ValidatorIndex) ∈ AC counted := by
        simpa [AC, activeVoters] using mem_getActiveValidatorIndices_of_isActiveAt
          (by rw [roundTrip]; exact active)
      have le := activation_le_of_active h (by omega) memberAC (by rw [roundTrip]; exact foundR)
      omega
    · have loose : (pinTerms config pulled anc fin).tight = false := by simpa using tight
      have deep := mt (tight_iff config pulled anc fin).mpr tight
      exact notLate ⟨loose, late_or_pending h foundR (by omega) (by omega)⟩
  have settled : anc.finalizedCheckpoint.epoch.toNat < w.withdrawableEpoch.toNat := by
    by_contra waited
    cases foundC : counted.validators.data[i]? with
    | none => simp [foundC] at slashedC
    | some u =>
      simp only [foundC, Option.map_some, Option.getD_some] at slashedC
      exact sc3a_unwithdrawn h oldFound foundR foundC oldUnslashed slashedC unslashedR
        (by omega)
  exact ⟨w, foundR, unslashedR, activated, settled⟩

/-- A key that `whistle_free` pays is paid by `flagged` or by its stake at C and its seat debits.

Its bound is `ebUp` or its balance and rise.

The excess over `ebUp` is at most its `rise`.

If the floor test fails, `flagged` pays the reward at `ebUp`.

Otherwise `lowEB_slashed` bounds the reward by the key's balance at C.

It also adds the key's seat debits on both runs. -/
private theorem free_key (h : Setting config checks g split fin pulled anc counted V)
    (high : ℕ) (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    {eventsF : List (BalanceEvent preset)} (replayedF : fromFin.balanceEvents high = .ok eventsF)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    (v : ValidatorIndex) (inside : v.toNat < split.validators.data.size)
    (unslashedS : (split.validators.data[v.toNat]?.map (·.slashed)).getD false = false)
    (slashedC : (counted.validators.data[v.toNat]?.map (·.slashed)).getD false = true)
    (notSlashedR : ¬ (pinTerms config pulled anc fin).slashedRB v.toNat = true)
    (notExited : ¬ PinTerms.exitedSlashable anc pulled v.toNat = true)
    (active : isActiveAt counted (getCurrentEpoch counted) v.toNat = true)
    (notLate : ¬ ((pinTerms config pulled anc fin).tight = false ∧
      ((pinTerms config pulled anc fin).lateB v.toNat = true ∨
        (pinTerms config pulled anc fin).pendingRB v.toNat = true)))
    (retained : ∀ {m n : ForkedBeaconState preset} (before : Run config checks ⟨fork, fin⟩ m)
      (step : Step config checks m n) (after : Run config checks n ⟨fork, counted⟩),
      (before.snoc step).append after = fromFin.append tailC → ∀ w,
      n.state.validators.data[v.toNat]? = some w →
      ((getCurrentEpoch pulled).toNat + 1 < w.exitEpoch.toNat ∨
        ∀ u, m.state.validators.data[v.toNat]? = some u →
          (getCurrentEpoch pulled).toNat + 1 < u.withdrawableEpoch.toNat)) :
    3 * (whistleEnv (pinTerms config pulled anc fin) pulled anc fin v.toNat / (parameters preset
        fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat) ≤
      (if 2 * ((pinTerms config pulled anc fin).lowEB v.toNat - max
          ((pinTerms config pulled anc fin).ebUp v.toNat)
          (max (balanceAt fin v.toNat) ((pinTerms config pulled anc fin).base0 v.toNat) +
            preset.EFFECTIVE_BALANCE_INCREMENT.toNat) / (parameters preset
              fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat) <
          3 * ((pinTerms config pulled anc fin).ebUp v.toNat / (parameters preset
            fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat) then
        3 * ((pinTerms config pulled anc fin).ebUp v.toNat / (parameters preset
          fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat) else 0) +
      (((pinTerms config pulled anc fin).rise v.toNat + 2 * balanceAt counted v.toNat) +
        2 * syncD eventsF v.toNat + 2 * syncD eventsC v.toNat) := by
  classical
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  have below : v.toNat < 2 ^ 64 := v.toNat_lt
  obtain ⟨w, foundR, -, -, -⟩ := free_slashable h inside below unslashedS slashedC notSlashedR
    active notLate
  have bound := bF_zero_of_active h active
  -- the bound of the key is `ebUp` or its balance and rise
  have env : whistleEnv (pinTerms config pulled anc fin) pulled anc fin v.toNat =
      max ((pinTerms config pulled anc fin).ebUp v.toNat)
        (balanceAt pulled v.toNat + (pinTerms config pulled anc fin).rise v.toNat) := by
    unfold whistleEnv
    rw [ite_eq_right_of_eq_false _ _ (eq_false notSlashedR),
      ite_eq_right_of_eq_false _ _ (eq_false (not_or.mpr ⟨notExited, notLate⟩)), bound]
    exact max_zero _
  have excess := floor_excess (r := (pinTerms config pulled anc fin).rise v.toNat)
    (h.facts.whistleblower fork) (by have := h.facts.incrementSize; omega)
    (ebUp_aligned h v.toNat) (eR_rise_aligned h (Array.getElem?_eq_some_iff.mp foundR).1)
    (by
      obtain ⟨t, ht⟩ : ∃ t, (pinTerms config pulled anc fin).ebUp v.toNat =
          max (max (balanceAt pulled v.toNat) (balanceAt fin v.toNat))
            (min (PinTerms.capAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat)
              (t - t % preset.EFFECTIVE_BALANCE_INCREMENT.toNat)) :=
        ⟨_, ebUp_eq config pulled anc fin electra v.toNat _ rfl⟩
      have := le_trans (le_max_left _ _) (le_max_left _ _) |>.trans ht.ge
      omega)
  rw [env]
  split_ifs with flag
  · omega
  · have floorLe : (pinTerms config pulled anc fin).lowEB v.toNat - max
        ((pinTerms config pulled anc fin).ebUp v.toNat)
        (max (balanceAt fin v.toNat) ((pinTerms config pulled anc fin).base0 v.toNat) +
          preset.EFFECTIVE_BALANCE_INCREMENT.toNat) / (parameters preset
            fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat ≤
        balanceAt counted v.toNat + syncD eventsF v.toNat + syncD eventsC v.toNat := by
      cases foundFin : fin.validators.data[v.toNat]? with
      | none =>
        have zero : balanceAt fin v.toNat = 0 := by simp [balanceAt, foundFin]
        have : (pinTerms config pulled anc fin).lowEB v.toNat = 0 := by
          rw [lowEB_unfold, zero]
          simp
        rw [this, Nat.zero_sub]
        exact Nat.zero_le _
      | some val =>
        have unslashedFin : val.slashed = false := by
          by_contra slashed
          obtain ⟨now, nowFound, nowSlashed⟩ := fromFin.slashedPersistence v.toNat val foundFin
            (by simpa using slashed)
          simp [nowFound, nowSlashed] at unslashedS
        have events := V_events h fromFin tailC high highC endEpoch endEpochC replayedF replayedC
        have := lowEB_slashed h fromFin tailC events v val foundFin unslashedFin retained
        simp only [List.map_append, List.sum_append] at this
        unfold syncD
        omega
    omega

/-- The stake at C of keys active at C and outside its quorum is paid twice by `cK7`. -/
private theorem free_k7 (T : Finset ValidatorIndex)
    (member : ∀ v ∈ T, v ∈ AC counted ∧ v ∉ Q counted) :
    ((2 * ∑ v ∈ T, balanceAt counted v.toNat : ℕ) : ℤ) ≤ -cK7 pulled counted := by
  classical
  let term : ValidatorIndex → ℤ := fun v => if v ∈ AC counted ∧ v ∉ Q counted then
    ((2 * eC counted v : ℕ) : ℤ) + (if v ∈ AR pulled then (eR pulled v : ℤ) else 0) else 0
  have negK7 : -cK7 pulled counted = ∑ v ∈ U pulled counted, term v := by
    unfold cK7
    rw [← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl fun v _ => ?_
    simp only [term]
    split_ifs <;> push_cast <;> ring
  have onT : ∀ v ∈ T, ((2 * balanceAt counted v.toNat : ℕ) : ℤ) ≤ term v := fun v hv => by
    have inside := member v hv
    simp only [term, inside.1, inside.2, not_false_eq_true, and_self, ↓reduceIte]
    split_ifs <;> simp [eC]
  rw [negK7, Finset.mul_sum, Nat.cast_sum]
  exact (Finset.sum_le_sum onT).trans (Finset.sum_le_sum_of_subset_of_nonneg
    (fun v hv => Finset.mem_union.mpr (.inl (Finset.mem_union.mpr (.inr (member v hv).1))))
    fun v _ _ => by simp only [term]; split_ifs <;> positivity)

/-- The whistleblower rewards of C's other slashed keys are paid from their own stake.

These are the keys of the split's registry that C slashes and leaves active.

R neither slashes them nor exits them.

Outside the tight window, R does not count them in `late` or `pendingR`.

They are active at both branches.

A slashable key whose floor does not cover its reward is flagged, and `flagged` pays it at `ebUp`.

The others pay from their stake at C and its seat debits, by `cK7`.

The seat debits of C's branch are paid by `seatShortfall`.

The seat debits of the shared segment are the last term, which `bud_sync` pays.

The excess of the bound over `ebUp` is the key's own `rise`. -/
private theorem whistle_free (h : Setting config checks g split fin pulled anc counted V)
    (high : ℕ) (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    {eventsF : List (BalanceEvent preset)} (replayedF : fromFin.balanceEvents high = .ok eventsF)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC) :
    ((3 * (∑ i ∈ (((((slashedOnC split counted).filter (fun i => i <
        split.validators.data.size)).filter (fun i => ¬ (pinTerms config pulled anc fin).slashedRB i
        = true ∧ ¬ PinTerms.exitedSlashable anc pulled i = true)).filter (fun i => isActiveAt
        counted
        (getCurrentEpoch counted) i = true)).filter (fun i => ¬ ((pinTerms config pulled anc
        fin).tight = false ∧ ((pinTerms config pulled anc fin).lateB i = true ∨ (pinTerms config
        pulled anc fin).pendingRB i = true)))),
          whistleEnv (pinTerms config pulled anc fin) pulled anc fin i
            / (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat) : ℕ) : ℤ) ≤
      -cK7 pulled counted - cS pulled counted V + (pinTerms config pulled anc fin).flagged +
          (pinTerms config pulled anc fin).seatShortfall +
        ((∑ i ∈ (((((slashedOnC split counted).filter (fun i => i <
            split.validators.data.size)).filter (fun i => ¬ (pinTerms config pulled anc
            fin).slashedRB i = true ∧ ¬ PinTerms.exitedSlashable anc pulled i = true)).filter (fun
            i =>
            isActiveAt counted (getCurrentEpoch counted) i = true)).filter (fun i => ¬ ((pinTerms
            config pulled anc fin).tight = false ∧ ((pinTerms config pulled anc fin).lateB i = true
            ∨ (pinTerms config pulled anc fin).pendingRB i = true)))), (pinTerms config pulled anc
            fin).rise i + 2 * ∑ i ∈ (((((slashedOnC split counted).filter (fun i => i <
            split.validators.data.size)).filter (fun i => ¬ (pinTerms config pulled anc
            fin).slashedRB i = true ∧ ¬ PinTerms.exitedSlashable anc pulled i = true)).filter (fun
            i =>
            isActiveAt counted (getCurrentEpoch counted) i = true)).filter (fun i => ¬ ((pinTerms
            config pulled anc fin).tight = false ∧ ((pinTerms config pulled anc fin).lateB i = true
            ∨ (pinTerms config pulled anc fin).pendingRB i = true)))),
            syncD eventsF i : ℕ) : ℤ) := by
  classical
  obtain ⟨pulledTotal, pulledOk⟩ := h.pulledTotal
  set FW : Finset ℕ := (((((slashedOnC split counted).filter (fun i => i <
    split.validators.data.size)).filter (fun i => ¬ (pinTerms config pulled anc fin).slashedRB i
    = true ∧ ¬ PinTerms.exitedSlashable anc pulled i = true)).filter (fun i => isActiveAt counted
    (getCurrentEpoch counted) i = true)).filter (fun i => ¬ ((pinTerms config pulled anc
    fin).tight = false ∧ ((pinTerms config pulled anc fin).lateB i = true ∨ (pinTerms config
    pulled anc fin).pendingRB i = true)))) with hFW
  have facts : ∀ i ∈ FW, i < split.validators.data.size ∧ i < 2 ^ 64 ∧
      (split.validators.data[i]?.map (·.slashed)).getD false = false ∧
      (counted.validators.data[i]?.map (·.slashed)).getD false = true ∧
      ¬ (pinTerms config pulled anc fin).slashedRB i = true ∧
      ¬ PinTerms.exitedSlashable anc pulled i = true ∧
      isActiveAt counted (getCurrentEpoch counted) i = true ∧
      ¬ ((pinTerms config pulled anc fin).tight = false ∧
        ((pinTerms config pulled anc fin).lateB i = true ∨
          (pinTerms config pulled anc fin).pendingRB i = true)) := by
    intro i hi
    simp only [hFW, slashedOnC, Finset.mem_filter, Finset.mem_range] at hi
    obtain ⟨⟨⟨⟨⟨count, unslashed, slashedC⟩, inside⟩, notSlashed, notExited⟩, active⟩, notLate⟩ :=
      hi
    exact ⟨inside, count.trans (BeaconState.validators_size_lt_of_lt_glamsterdam h.early counted),
      unslashed, slashedC, notSlashed, notExited, active, notLate⟩
  have retained : ∀ v : ValidatorIndex, v.toNat ∈ FW →
      ∀ {m n : ForkedBeaconState preset} (before : Run config checks ⟨fork, fin⟩ m)
      (step : Step config checks m n) (after : Run config checks n ⟨fork, counted⟩),
      (before.snoc step).append after = fromFin.append tailC → ∀ w,
      n.state.validators.data[v.toNat]? = some w →
      ((getCurrentEpoch pulled).toNat + 1 < w.exitEpoch.toNat ∨
        ∀ u, m.state.validators.data[v.toNat]? = some u →
          (getCurrentEpoch pulled).toNat + 1 < u.withdrawableEpoch.toNat) :=
    fun v member => by
      obtain ⟨tail⟩ := h.toPulled
      obtain ⟨⟨⟨⟨onC, inside⟩, notR, notExit⟩, -⟩, -⟩ := by
        simpa only [hFW, Finset.mem_filter] using member
      exact slashedC_retained h fromFin tail tailC v onC inside notR notExit
  -- each key is paid by `flagged`, its stake at C, its seat debits and its rise
  have key := fun i (member : i ∈ FW) => by
    obtain ⟨inside, below, unslashed, slashedC, notSlashed, notExited, active, notLate⟩ :=
      facts i member
    have roundTrip : (UInt64.ofNat i).toNat = i := UInt64.toNat_ofNat_of_lt' below
    have paid := free_key h high endEpoch fromFin replayedF tailC highC endEpochC replayedC
      (UInt64.ofNat i) (by simpa only [roundTrip] using inside)
      (by simpa only [roundTrip] using unslashed) (by simpa only [roundTrip] using slashedC)
      (by simpa only [roundTrip] using notSlashed)
      (by simpa only [roundTrip] using notExited) (by simpa only [roundTrip] using active)
      (by simpa only [roundTrip] using notLate)
      (retained _ (by simpa only [roundTrip] using member))
    simpa only [roundTrip] using paid
  have summed := Finset.sum_le_sum key
  simp only [Finset.sum_add_distrib, ← Finset.mul_sum] at summed
  -- `flagged` pays the keys that fail the floor test
  have flagSum : ∑ i ∈ FW, (if 2 * ((pinTerms config pulled anc fin).lowEB i - max
      ((pinTerms config pulled anc fin).ebUp i)
      (max (balanceAt fin i) ((pinTerms config pulled anc fin).base0 i) +
        preset.EFFECTIVE_BALANCE_INCREMENT.toNat) / (parameters preset
          fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat) <
      3 * ((pinTerms config pulled anc fin).ebUp i / (parameters preset
        fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat) then
      3 * ((pinTerms config pulled anc fin).ebUp i / (parameters preset
        fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat) else 0) ≤
      (pinTerms config pulled anc fin).flagged := by
    have flaggedEq : (pinTerms config pulled anc fin).flagged =
        ∑ i ∈ (Finset.range pulled.validators.data.size).filter (fun i =>
          ((pulled.validators.data[i]?.map (·.slashed)).getD false = false ∧
            (pulled.validators.data[i]?).any (fun v =>
              decide (v.activationEpoch.toNat ≤ (getCurrentEpoch pulled).toNat + 1) &&
                decide (anc.finalizedCheckpoint.epoch.toNat < v.withdrawableEpoch.toNat)) = true) ∧
          2 * ((pinTerms config pulled anc fin).lowEB i - max
            ((pinTerms config pulled anc fin).ebUp i)
            (max (balanceAt fin i) ((pinTerms config pulled anc fin).base0 i) +
              preset.EFFECTIVE_BALANCE_INCREMENT.toNat) / (parameters preset
                fork).MIN_SLASHING_PENALTY_QUOTIENT.toNat) <
          3 * ((pinTerms config pulled anc fin).ebUp i / (parameters preset
            fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat)),
          3 * ((pinTerms config pulled anc fin).ebUp i / (parameters preset
            fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat) := rfl
    rw [flaggedEq, ← Finset.sum_filter]
    refine Finset.sum_le_sum_of_subset fun i member => ?_
    obtain ⟨inFW, flag⟩ := Finset.mem_filter.mp member
    obtain ⟨inside, below, unslashed, slashedC, notSlashed, notExited, active, notLate⟩ :=
      facts i inFW
    obtain ⟨w, found, unslashedR, activated, settled⟩ := free_slashable h inside below unslashed
      slashedC notSlashed active notLate
    refine Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (Array.getElem?_eq_some_iff.mp found).1,
      ⟨by simp [found, unslashedR], ?_⟩, flag⟩
    simp [found, activated, settled]
  -- `seatShortfall` pays the seat debits of C's run
  have seats : 2 * ∑ i ∈ FW, syncD eventsC i ≤ (pinTerms config pulled anc fin).seatShortfall := by
    have finSplit := UInt64.le_iff_toNat_le.mp h.finalized
    have debits := (PinSeatDebits.Run.syncDebits_le tailC h.fulu h.early highC replayedC
      pulledTotal.toNat (step_band_of_tail h fromFin tailC h.near pulledOk) FW).1
    have totalEq := getD_total_eq pulledOk
    have seatEq : (pinTerms config pulled anc fin).seatShortfall =
        2 * ((pinTerms config pulled anc fin).depth * preset.SLOTS_PER_EPOCH.toNat *
          preset.SYNC_COMMITTEE_SIZE.toNat * PinTerms.syncEnvelope preset
            ((getTotalActiveBalance pulled).toOption.getD 0).toNat) := rfl
    have depthEq : (pinTerms config pulled anc fin).depth =
        (getCurrentEpoch pulled).toNat + 2 - anc.finalizedCheckpoint.epoch.toNat := rfl
    have epochs : (getCurrentEpoch counted).toNat + 1 - (getCurrentEpoch split).toNat ≤
        (pinTerms config pulled anc fin).depth := by
      have := h.near
      omega
    rw [seatEq, totalEq]
    exact Nat.mul_le_mul_left 2 (debits.trans (Nat.mul_le_mul_right _
      (Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ epochs))))
  -- `cK7` pays twice the stake at C of the keys, which are active at C and slashed there
  have k7 : ((2 * ∑ i ∈ FW, balanceAt counted i : ℕ) : ℤ) ≤ -cK7 pulled counted := by
    have toSC := sum_SC_filter_positions h (fun i => ((¬ (pinTerms config pulled anc
      fin).slashedRB i = true ∧ ¬ PinTerms.exitedSlashable anc pulled i = true) ∧
      isActiveAt counted (getCurrentEpoch counted) i = true) ∧ ¬ ((pinTerms config pulled anc
      fin).tight = false ∧ ((pinTerms config pulled anc fin).lateB i = true ∨ (pinTerms config
      pulled anc fin).pendingRB i = true))) (fun i => balanceAt counted i)
    have sameFW : ∑ i ∈ FW, balanceAt counted i = ∑ i ∈ ((slashedOnC split counted).filter
        (fun i => i < split.validators.data.size)).filter (fun i => ((¬ (pinTerms config pulled
          anc fin).slashedRB i = true ∧ ¬ PinTerms.exitedSlashable anc pulled i = true) ∧
          isActiveAt counted (getCurrentEpoch counted) i = true) ∧ ¬ ((pinTerms config pulled anc
          fin).tight = false ∧ ((pinTerms config pulled anc fin).lateB i = true ∨ (pinTerms config
          pulled anc fin).pendingRB i = true))), balanceAt counted i := by
      rw [hFW]
      simp only [Finset.filter_filter]
      exact Finset.sum_congr (Finset.filter_congr fun x _ => by tauto) fun _ _ => rfl
    rw [sameFW, ← toSC]
    refine free_k7 _ fun v member => ?_
    obtain ⟨inSC, ⟨⟨-, active⟩, -⟩⟩ := Finset.mem_filter.mp member
    refine ⟨by simpa [AC, activeVoters] using
      mem_getActiveValidatorIndices_of_isActiveAt active, ?_⟩
    intro quorum
    have flag := (Finset.mem_filter.mp inSC).2.1
    simp only [Q, quorumVoters, Finset.mem_filter] at quorum
    unfold slashedFlagAt at flag
    have := quorum.2
    rw [flag] at this
    simp at this
  have rest : 0 ≤ -cS pulled counted V := by
    unfold cS
    rw [← Finset.sum_neg_distrib]
    exact Finset.sum_nonneg fun v _ => by split_ifs <;> simp
  have nat : 3 * ∑ i ∈ FW, whistleEnv (pinTerms config pulled anc fin) pulled anc fin i /
      (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat ≤
      (pinTerms config pulled anc fin).flagged +
      (∑ i ∈ FW, (pinTerms config pulled anc fin).rise i + 2 * ∑ i ∈ FW, balanceAt counted i +
        2 * ∑ i ∈ FW, syncD eventsF i + 2 * ∑ i ∈ FW, syncD eventsC i) := by
    omega
  push_cast at k7 ⊢
  have seatsZ : (2 * ∑ i ∈ FW, syncD eventsC i : ℤ) ≤
      (pinTerms config pulled anc fin).seatShortfall := by exact_mod_cast seats
  have natZ := (Int.ofNat_le.mpr nat)
  push_cast at natZ
  linarith

private def whistleActiveRow (config : Config) (pulled anc fin : BeaconState preset fork)
    (i seatDebit : ℕ) : ℕ :=
  let terms := pinTerms config pulled anc fin
  let W := (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat
  let excess := (balanceAt fin i - balanceAt pulled i - terms.rise i + (W - 1)) / W
  terms.rise i + 2 * seatDebit +
    (if terms.tight = false ∧ terms.lateB i = true then 3 * balanceAt pulled i + 3 * excess
      else 0) +
    (if terms.tight = false ∧ terms.pendingRB i = true then balanceAt pulled i + 3 * excess
      else 0)

/-- A key of the split's registry that only C activates pays from its row of R.

At R it is in `late` or in `pendingR`, which only `cJ_le`'s keys of `K6` claim.

It needs no floor.

Its effective part is that row's, three times for `late`, and its rise is the single claim.

Its finalized balance can exceed its balance and rise at R.

The row's reward of that excess, rounded up, pays the rest. -/
private theorem whistle_late (h : Setting config checks g split fin pulled anc counted V) :
    3 * (∑ i ∈ (((((slashedOnC split counted).filter (fun i => i <
        split.validators.data.size)).filter (fun i => ¬ (pinTerms config pulled anc fin).slashedRB i
        = true ∧ ¬ PinTerms.exitedSlashable anc pulled i = true)).filter (fun i => isActiveAt
        counted
        (getCurrentEpoch counted) i = true)).filter (fun i => ((pinTerms config pulled anc
        fin).tight = false ∧ ((pinTerms config pulled anc fin).lateB i = true ∨ (pinTerms config
        pulled anc fin).pendingRB i = true)))),
          whistleEnv (pinTerms config pulled anc fin) pulled anc fin i
            / (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat) ≤
      ∑ i ∈ (((((slashedOnC split counted).filter (fun i => i < split.validators.data.size)).filter
          (fun i => ¬ (pinTerms config pulled anc fin).slashedRB i = true ∧ ¬
          PinTerms.exitedSlashable anc
          pulled i = true)).filter (fun i => isActiveAt counted (getCurrentEpoch counted) i =
          true)).filter (fun i => ((pinTerms config pulled anc fin).tight = false ∧ ((pinTerms
          config pulled anc fin).lateB i = true ∨ (pinTerms config pulled anc fin).pendingRB i =
          true)))), whistleActiveRow config pulled anc fin i 0 := by
  rw [Finset.mul_sum]
  refine Finset.sum_le_sum fun i member => ?_
  simp only [Finset.mem_filter] at member
  obtain ⟨⟨⟨-, notRB⟩, active⟩, late⟩ := member
  -- the key is active at C, so its `bF` is zero
  have noExit := bF_zero_of_active h active
  rw [whistleEnv, ite_eq_right_of_eq_false _ _ (eq_false notRB.1),
    ite_eq_left_of_eq_true _ _ (eq_true (Or.inr late)), noExit, max_eq_right (Nat.zero_le _)]
  have quotient := h.facts.whistleblower fork
  -- the larger of the two balances is the balance and rise at R, and the excess over them
  have floor : max (balanceAt pulled i + (pinTerms config pulled anc fin).rise i)
        (balanceAt fin i) / (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat ≤
      (balanceAt pulled i + (pinTerms config pulled anc fin).rise i) /
          (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat +
        (balanceAt fin i - balanceAt pulled i - (pinTerms config pulled anc fin).rise i +
          ((parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat - 1)) /
          (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat := by
    have split := floor_add_ceil_le (balanceAt pulled i + (pinTerms config pulled anc fin).rise i)
      (balanceAt fin i - (balanceAt pulled i + (pinTerms config pulled anc fin).rise i))
      (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat (by omega)
    have whole : max (balanceAt pulled i + (pinTerms config pulled anc fin).rise i)
        (balanceAt fin i) = balanceAt pulled i + (pinTerms config pulled anc fin).rise i +
          (balanceAt fin i - (balanceAt pulled i + (pinTerms config pulled anc fin).rise i)) := by
      rw [Nat.max_def]
      split_ifs <;> omega
    have excess : balanceAt fin i - (balanceAt pulled i + (pinTerms config pulled anc fin).rise i) +
        (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat - 1 =
        balanceAt fin i - balanceAt pulled i - (pinTerms config pulled anc fin).rise i +
          ((parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat - 1) := by
      omega
    rw [whole]
    rw [excess] at split
    exact split
  have three : 3 * ((balanceAt pulled i + (pinTerms config pulled anc fin).rise i) /
      (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat) ≤
      balanceAt pulled i + (pinTerms config pulled anc fin).rise i :=
    (Nat.mul_le_mul_right _ (by omega)).trans (Nat.mul_div_le _ _)
  simp only [whistleActiveRow]
  split_ifs
  · omega
  · omega
  · omega
  · rename_i notLate notPending
    rcases late.2 with lateKey | pendingKey
    · exact absurd ⟨late.1, lateKey⟩ notLate
    · exact absurd ⟨late.1, pendingKey⟩ notPending

/-- W from the keys' payers.

The slashed keys' rewards are paid by the shares, `reserveW`, `flagged`, `cK7` and `cS`.

The seat debits, the keys' own `rise` and R's slashing of the key pay the rest.

`registry` is the bound of the keys of the split's registry on each step of C's branch. -/
private theorem bud_whistle_of (h : Setting config checks g split fin pulled anc counted V)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩) (high : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    {eventsF : List (BalanceEvent preset)} (replayedF : fromFin.balanceEvents high = .ok eventsF)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    {b : BeaconState preset fork} (pre : Run config checks ⟨fork, b⟩ ⟨fork, split⟩)
    {eventsP : List (BalanceEvent preset)}
    (registry : ∀ {a b : ForkedBeaconState preset} (step : Step config checks a b),
      tailC.Contains step → ∀ i, i < split.validators.data.size →
        (split.validators.data[i]?.map (·.slashed)).getD false = false →
        (!(a.state.validators.data[i]?.map (·.slashed)).getD false &&
          (b.state.validators.data[i]?.map (·.slashed)).getD false) = true →
          effectiveAt a i ≤ whistleEnv (pinTerms config pulled anc fin) pulled anc fin i +
            whistleSlack (pinTerms config pulled anc fin) tailC (fromFin.append tail) highC high
                eventsC eventsF events fin i)
    (registryCharge : ∀ {a b : ForkedBeaconState preset} (step : Step config checks a b),
      tailC.Contains step → ∀ i, i < split.validators.data.size →
        (split.validators.data[i]?.map (·.slashed)).getD false = false →
        (!(a.state.validators.data[i]?.map (·.slashed)).getD false &&
          (b.state.validators.data[i]?.map (·.slashed)).getD false) = true →
        (tailC.departureCharges.any fun c => c.index == i) = true →
          effectiveAt a i ≤ chargeAmt tailC i + riseQ tailC highC i +
            (propN pre highC i + whistC pre highC i + syncCr eventsP i) +
            whistleSlack (pinTerms config pulled anc fin) tailC (fromFin.append tail) highC high
                eventsC eventsF events fin i) :
    3 * ((∑ v ∈ (K4 pulled counted V), (whistC tailC highC v.toNat : ℤ)) +
      (∑ v ∈ (K5 counted V), (whistC tailC highC v.toNat : ℤ)) +
      (∑ v ∈ (K6 pulled counted), (whistC tailC highC v.toNat : ℤ))) ≤
      -cK7 pulled counted - cS pulled counted V + (pinTerms config pulled anc fin).reserveW +
        (pinTerms config pulled anc fin).flagged + (pinTerms config pulled anc fin).seatShortfall +
        ((wShare preset fork ((∑ v ∈ SC pulled counted split, propN tailC highC v.toNat) +
            ∑ v ∈ SC pulled counted split, depPre eventsC v.toNat) +
          wShare preset fork (∑ v ∈ SC pulled counted split, syncCr eventsC v.toNat) +
          wShare preset fork (∑ v ∈ SC pulled counted split, consAmt eventsC v.toNat) +
          wShare preset fork
            (∑ v ∈ SC pulled counted split, (syncD eventsF v.toNat + syncD events v.toNat)) +
          (∑ v ∈ SC pulled counted split, bandC tailC highC v.toNat) +
          (∑ v ∈ SC pulled counted split, bandX fin highC v.toNat) +
          wShare preset fork ((∑ v ∈ CS counted split, propN tailC highC v.toNat) +
            ∑ v ∈ CS counted split, depPre eventsC v.toNat) +
          wShare preset fork (∑ v ∈ CS counted split, syncCr eventsC v.toNat) +
          wShare preset fork (∑ v ∈ CS counted split, consAmt eventsC v.toNat) +
          (∑ v ∈ CS counted split, bandC tailC highC v.toNat) +
          (∑ v ∈ CS counted split, bandX fin highC v.toNat) +
          wShare preset fork (∑ v ∈ SC pulled counted split with
            (pinTerms config pulled anc fin).exitBeforeFin v.toNat = true, syncCr eventsF v.toNat) +
          wShare preset fork (∑ v ∈ SC pulled counted split with
            (pinTerms config pulled anc fin).exitBeforeFin v.toNat = true,
              consAmt eventsF v.toNat) +
          (∑ v ∈ SC pulled counted split with
            (pinTerms config pulled anc fin).exitBeforeFin v.toNat = true, bandX fin high v.toNat) :
            ℕ) : ℤ) +
        ((∑ v ∈ SC pulled counted split, (unitK (pinTerms config pulled anc fin) tailC highC eventsC
            events eventsF v.toNat +
            inducedR (pinTerms config pulled anc fin) (fromFin.append tail) v.toNat + bandR (eventsF
                ++ events) v.toNat +
            if (pinTerms config pulled anc fin).exitBeforeFin v.toNat = true then
              (if 0 < syncCr eventsF v.toNat then preset.upwardBand else 0) else 0) : ℕ) : ℤ) +
        ((wShare preset fork (∑ v ∈ SC pulled counted split, propN pre highC v.toNat) +
          (∑ v ∈ SC pulled counted split, syncCr eventsP v.toNat) +
          3 * (∑ v ∈ scCharged pulled counted split tailC, whistC pre highC v.toNat) +
          (∑ v ∈ scCharged pulled counted split tailC,
            if 0 < propN pre highC v.toNat + whistC pre highC v.toNat + syncCr eventsP v.toNat then
              preset.upwardBand else 0) : ℕ) : ℤ) +
        ((∑ v ∈ SC pulled counted split with (¬ (pinTerms config pulled anc fin).slashedRB v.toNat =
            true ∧
          ¬ PinTerms.exitedSlashable anc pulled v.toNat = true) ∧
          isActiveAt counted (getCurrentEpoch counted) v.toNat = true,
          whistleActiveRow config pulled anc fin v.toNat (syncD eventsF v.toNat) : ℕ) : ℤ) +
        ((3 * ∑ v ∈ SC pulled counted split with (pinTerms config pulled anc fin).slashedRB v.toNat
            = true,
          ((max (balanceAt pulled v.toNat + (pinTerms config pulled anc fin).rise v.toNat)
            (balanceAt fin v.toNat)) / (parameters
              preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat +
            (preset.EFFECTIVE_BALANCE_INCREMENT.toNat + (parameters preset
                fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat - 1) / (parameters preset
                fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat) : ℕ) : ℤ) +
        (((CS counted split).filter fun v => isActiveAt counted (getCurrentEpoch counted) v.toNat =
          true).card * (if (pinTerms config pulled anc fin).gainHigh = true then
              preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat
            else (pinTerms config pulled anc fin).unitGain) : ℕ) := by
  classical
  have quotient := h.facts.whistleblower fork
  -- the whistleblower credits of the classes and of `CS` are bounded by the reward base
  have core := whistle_core h fromFin tail high tailC highC endEpochC replayedC pre registry
    registryCharge ((K4 pulled counted V ∪ K5 counted V ∪ K6 pulled counted) ∪ SC pulled counted
      split ∪ CS counted split)
  obtain ⟨dK, -⟩ := cs_disjoint h
  obtain ⟨dS, -⟩ := sc_disjoint h
  obtain ⟨d45, d46, d56, -⟩ := classes_disjoint h
  rw [Finset.sum_union dK, Finset.sum_union dS,
    Finset.sum_union (Finset.disjoint_union_left.mpr ⟨d46, d56⟩), Finset.sum_union d45,
    sum_CS_positions h (fun i => whistC tailC highC i),
    sum_SC_positions h (fun i => whistC tailC highC i)] at core
  -- the part of the reward base that each payer takes
  have sc := whistle_slack_sc h tail high endEpoch replayed fromFin replayedF tailC highC
    endEpochC replayedC pre eventsP
  have cs := whistle_slack_cs h tailC highC endEpochC replayedC
  have whistSplit := (Finset.sum_filter_add_sum_filter_not (slashedOnC split counted)
    (fun i => i < split.validators.data.size) (fun i => whistC tailC highC i)).symm
  have exited := whistle_exited h tailC highC
  have free := whistle_free h high endEpoch fromFin replayedF tailC highC endEpochC replayedC
  -- the keys that R slashes pay `branchR`'s claim
  have slashedKeys : 3 * ∑ i ∈ (((slashedOnC split counted).filter (fun i => i <
      split.validators.data.size)).filter (fun i => (pinTerms config pulled anc fin).slashedRB i =
      true)), whistleEnv (pinTerms config pulled anc fin) pulled anc fin i / (parameters preset
      fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat ≤
      3 * ∑ v ∈ SC pulled counted split with (pinTerms config pulled anc fin).slashedRB v.toNat =
          true,
        ((max (balanceAt pulled v.toNat + (pinTerms config pulled anc fin).rise v.toNat)
            (balanceAt fin v.toNat)) / (parameters
            preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat +
          (preset.EFFECTIVE_BALANCE_INCREMENT.toNat + (parameters preset
              fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat - 1) / (parameters preset
              fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat) := by
    rw [sum_SC_filter_positions h (fun i => (pinTerms config pulled anc fin).slashedRB i = true)
      (fun i => (max (balanceAt pulled i + (pinTerms config pulled anc fin).rise i)
          (balanceAt fin i)) / (parameters preset
          fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat +
        (preset.EFFECTIVE_BALANCE_INCREMENT.toNat + (parameters preset
            fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat - 1) / (parameters preset
            fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat)]
    refine Nat.mul_le_mul_left 3 (Finset.sum_le_sum fun i member => ?_)
    have slashedR : (pinTerms config pulled anc fin).slashedRB i = true := (Finset.mem_filter.mp
        member).2
    simp only [slashedR, whistleEnv, ite_true]
    exact (Nat.div_le_div_right (by omega : max (balanceAt pulled i +
      (pinTerms config pulled anc fin).rise i + preset.EFFECTIVE_BALANCE_INCREMENT.toNat)
      (balanceAt fin i) ≤ max (balanceAt pulled i + (pinTerms config pulled anc fin).rise i)
      (balanceAt fin i) + preset.EFFECTIVE_BALANCE_INCREMENT.toNat)).trans
      (floor_add_ceil_le (max (balanceAt pulled i + (pinTerms config pulled anc fin).rise i)
        (balanceAt fin i)) preset.EFFECTIVE_BALANCE_INCREMENT.toNat (parameters preset
          fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat (by omega))
  -- the keys that C leaves active, read at their rise, their rows and their seat debits
  have activeKeys : ∑ v ∈ SC pulled counted split with (¬ (pinTerms config pulled anc fin).slashedRB
      v.toNat = true ∧
        ¬ PinTerms.exitedSlashable anc pulled v.toNat = true) ∧
        isActiveAt counted (getCurrentEpoch counted) v.toNat = true,
        whistleActiveRow config pulled anc fin v.toNat (syncD eventsF v.toNat) =
      ∑ i ∈ ((((slashedOnC split counted).filter (fun i => i < split.validators.data.size)).filter
          (fun i => ¬ (pinTerms config pulled anc fin).slashedRB i = true ∧ ¬
          PinTerms.exitedSlashable anc
          pulled i = true)).filter (fun i => isActiveAt counted (getCurrentEpoch counted) i =
          true)), whistleActiveRow config pulled anc fin i (syncD eventsF i) := by
    rw [sum_SC_filter_positions h (fun i => (¬ (pinTerms config pulled anc fin).slashedRB i = true ∧
      ¬ PinTerms.exitedSlashable anc pulled i = true) ∧ isActiveAt counted (getCurrentEpoch
      counted) i =
          true)
      (fun i => whistleActiveRow config pulled anc fin i (syncD eventsF i))]
    simp only [Finset.filter_filter, and_assoc]
  have late := whistle_late h
  have partition := Finset.sum_filter_add_sum_filter_not ((((slashedOnC split counted).filter (fun i
      => i < split.validators.data.size)).filter (fun i => ¬ (pinTerms config pulled anc
      fin).slashedRB i = true ∧ ¬ PinTerms.exitedSlashable anc pulled i = true)).filter (fun i =>
      isActiveAt
      counted (getCurrentEpoch counted) i = true)) (fun i => ((pinTerms config pulled anc fin).tight
      = false ∧ ((pinTerms config pulled anc fin).lateB i = true ∨ (pinTerms config pulled anc
      fin).pendingRB i = true)))
    (fun i => whistleActiveRow config pulled anc fin i (syncD eventsF i))
  have freeKeys : ∑ i ∈ (((((slashedOnC split counted).filter (fun i => i <
      split.validators.data.size)).filter (fun i => ¬ (pinTerms config pulled anc fin).slashedRB i =
      true ∧ ¬ PinTerms.exitedSlashable anc pulled i = true)).filter (fun i => isActiveAt counted
      (getCurrentEpoch counted) i = true)).filter (fun i => ¬ ((pinTerms config pulled anc
      fin).tight = false ∧ ((pinTerms config pulled anc fin).lateB i = true ∨ (pinTerms config
      pulled anc fin).pendingRB i = true)))), (pinTerms config pulled anc fin).rise i + 2 * ∑ i ∈
      (((((slashedOnC split counted).filter (fun i => i < split.validators.data.size)).filter (fun i
      => ¬ (pinTerms config pulled anc fin).slashedRB i = true ∧ ¬ PinTerms.exitedSlashable anc
      pulled i =
      true)).filter (fun i => isActiveAt counted (getCurrentEpoch counted) i = true)).filter (fun i
      => ¬ ((pinTerms config pulled anc fin).tight = false ∧ ((pinTerms config pulled anc fin).lateB
      i = true ∨ (pinTerms config pulled anc fin).pendingRB i = true)))), syncD eventsF i ≤
      ∑ i ∈ (((((slashedOnC split counted).filter (fun i => i < split.validators.data.size)).filter
          (fun i => ¬ (pinTerms config pulled anc fin).slashedRB i = true ∧ ¬
          PinTerms.exitedSlashable anc
          pulled i = true)).filter (fun i => isActiveAt counted (getCurrentEpoch counted) i =
          true)).filter (fun i => ¬ ((pinTerms config pulled anc fin).tight = false ∧ ((pinTerms
          config pulled anc fin).lateB i = true ∨ (pinTerms config pulled anc fin).pendingRB i =
          true)))), whistleActiveRow config pulled anc fin i (syncD eventsF i) := by
    rw [Finset.mul_sum, ← Finset.sum_add_distrib]
    exact Finset.sum_le_sum fun i _ => by simp only [whistleActiveRow]; split_ifs <;> omega
  have lateKeys : ∑ i ∈ (((((slashedOnC split counted).filter (fun i => i <
      split.validators.data.size)).filter (fun i => ¬ (pinTerms config pulled anc fin).slashedRB i =
      true ∧ ¬ PinTerms.exitedSlashable anc pulled i = true)).filter (fun i => isActiveAt counted
      (getCurrentEpoch counted) i = true)).filter (fun i => ((pinTerms config pulled anc fin).tight
      = false ∧ ((pinTerms config pulled anc fin).lateB i = true ∨ (pinTerms config pulled anc
      fin).pendingRB i = true)))), whistleActiveRow config pulled anc fin i 0 ≤
      ∑ i ∈ (((((slashedOnC split counted).filter (fun i => i < split.validators.data.size)).filter
          (fun i => ¬ (pinTerms config pulled anc fin).slashedRB i = true ∧ ¬
          PinTerms.exitedSlashable anc
          pulled i = true)).filter (fun i => isActiveAt counted (getCurrentEpoch counted) i =
          true)).filter (fun i => ((pinTerms config pulled anc fin).tight = false ∧ ((pinTerms
          config pulled anc fin).lateB i = true ∨ (pinTerms config pulled anc fin).pendingRB i =
          true)))), whistleActiveRow config pulled anc fin i (syncD eventsF i) :=
    Finset.sum_le_sum fun i _ => by simp only [whistleActiveRow]; split_ifs <;> omega
  have wSplit := (Finset.sum_filter_add_sum_filter_not (slashedOnC split counted)
    (fun i => i < split.validators.data.size) (fun i => whistC tailC highC i)).symm
  zify at core sc cs whistSplit exited free late slashedKeys activeKeys partition
  zify at freeKeys lateKeys wSplit ⊢
  linarith

/-- Glue: V keys are current at R, and distinct keys have distinct positions. -/
private theorem bud_fall (h : Setting config checks g split fin pulled anc counted V) :
    (∑ v ∈ V, (pinTerms config pulled anc fin).fall v.toNat) ≤
      ∑ i ∈ (pinTerms config pulled anc fin).positions with
        (pinTerms config pulled anc fin).current i = true,
        (pinTerms config pulled anc fin).fall i := by
  have within := BeaconState.registryWithinLimit_of_lt h.early pulled
  refine voters_sum_le (pinTerms config pulled anc fin).fall fun v voter => ?_
  have listed : v ∈ getActiveValidatorIndices pulled (getCurrentEpoch pulled) := by
    simpa [activeVoters] using (h.voting v voter).1
  obtain ⟨validator, found, active⟩ := (mem_getActiveValidatorIndices within).mp listed
  exact mem_positions_filter config pulled anc fin found
    (isActiveAt_eq_true_iff.mpr ⟨validator, found, active⟩)

/-- `quorumReserve` holds `joining` (its gain term). -/
private theorem bud_joining : (pinTerms config pulled anc fin).joining ≤
    (pinTerms config pulled anc fin).quorum := by
  dsimp only [pinTerms, quorumReserve]
  exact (show ∀ a b c : ℕ, a ≤ 2 * (a + b) + 3 * c by intros; omega) _ _ _

/-- The weighted gains of the flows fit `creditLow`, the slashed term and the credits themselves.

The gains are bounded linearly, at the rate `11 * D * FP / (I * WD)` of a unit of flow.

The credit part pays at a rate below one, so it costs at most itself.

The other parts round down their increments once, and `f` at least two covers the rounding.

The consolidations are a whole number `m` of increments, and the slashed keys are at most `n`. -/
private theorem flow_close (I WD FP D D2 m OC Wr Wc Wo Ws n df L : ℕ)
    (hI : 0 < I) (hWD : 0 < WD) (key : 0 < L → 11 * D * FP < WD * I) (f2 : 0 < L → 2 ≤ FP / WD)
    (hD : D ≤ df) (hDD : D ≤ D2) (hc : Wc ≤ 3 * (I * m)) (ho : Wo ≤ OC) (hs : Ws ≤ 3 * (I * n))
    (lin : 10 * (I * WD) * L ≤ 11 * D * FP * (Wr + Wc + Wo + Ws)) :
    10 * L ≤ 10 * ((33 * D2 * (m * FP / WD) + 11 * D2 * ((OC / I) * FP / WD) +
      30 * D2 * (FP / WD + 1) + 9) / 10 + 3 * (n * (2 * df * (FP / WD)))) + Wr := by
  rcases Nat.eq_zero_or_pos L with zero | pos
  · subst zero; simp
  have key := key pos
  have f2 := f2 pos
  generalize hf : FP / WD = f at f2 ⊢
  generalize hcg : m * FP / WD = cg
  generalize hog : OC / I * FP / WD = og
  have cG : m * FP ≤ WD * (cg + 1) := by
    have := Nat.lt_mul_div_succ (m * FP) hWD; rw [hcg] at this; exact this.le
  have oG : OC / I * FP ≤ WD * (og + 1) := by
    have := Nat.lt_mul_div_succ (OC / I * FP) hWD; rw [hog] at this; exact this.le
  have fG : FP ≤ WD * (f + 1) := by
    have := Nat.lt_mul_div_succ FP hWD; rw [hf] at this; exact this.le
  have ocLt : OC < I * (OC / I + 1) := by
    have := Nat.lt_mul_div_succ OC hI; exact this
  -- the credit part pays at the rate below one
  have rate : 11 * D * FP * Wr ≤ I * WD * Wr := by
    have := Nat.mul_le_mul_right Wr key.le; linarith
  have consB : 11 * D * FP * Wc ≤ I * WD * (33 * D * (cg + 1)) := by
    calc 11 * D * FP * Wc ≤ 11 * D * FP * (3 * (I * m)) := Nat.mul_le_mul_left _ hc
      _ = 33 * D * I * (m * FP) := by ring
      _ ≤ 33 * D * I * (WD * (cg + 1)) := Nat.mul_le_mul_left _ cG
      _ = I * WD * (33 * D * (cg + 1)) := by ring
  have otherB : 11 * D * FP * Wo ≤ I * WD * (11 * D * (og + f + 2)) := by
    have step1 : FP * OC ≤ FP * (I * (OC / I)) + FP * I := by
      have := Nat.mul_le_mul_left FP ocLt.le
      calc FP * OC ≤ FP * (I * (OC / I + 1)) := this
        _ = FP * (I * (OC / I)) + FP * I := by ring
    have step2 : FP * (I * (OC / I)) ≤ I * (WD * (og + 1)) := by
      calc FP * (I * (OC / I)) = I * (OC / I * FP) := by ring
        _ ≤ I * (WD * (og + 1)) := Nat.mul_le_mul_left _ oG
    have step3 : FP * I ≤ I * (WD * (f + 1)) := by
      calc FP * I = I * FP := by ring
        _ ≤ I * (WD * (f + 1)) := Nat.mul_le_mul_left _ fG
    calc 11 * D * FP * Wo ≤ 11 * D * (FP * OC) := by
          calc 11 * D * FP * Wo = 11 * D * (FP * Wo) := by ring
            _ ≤ 11 * D * (FP * OC) := Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ ho)
      _ ≤ 11 * D * (I * (WD * (og + 1)) + I * (WD * (f + 1))) := by
          refine Nat.mul_le_mul_left _ ?_
          omega
      _ = I * WD * (11 * D * (og + f + 2)) := by ring
  have slashB : 11 * D * FP * Ws ≤ I * WD * (33 * D * n * (f + 1)) := by
    calc 11 * D * FP * Ws ≤ 11 * D * FP * (3 * (I * n)) := Nat.mul_le_mul_left _ hs
      _ = 33 * D * n * I * FP := by ring
      _ ≤ 33 * D * n * I * (WD * (f + 1)) := Nat.mul_le_mul_left _ fG
      _ = I * WD * (33 * D * n * (f + 1)) := by ring
  have total : 10 * (I * WD) * L ≤ I * WD * (Wr + 33 * D * (cg + 1) + 11 * D * (og + f + 2) +
      33 * D * n * (f + 1)) := by
    calc 10 * (I * WD) * L ≤ 11 * D * FP * (Wr + Wc + Wo + Ws) := lin
      _ = 11 * D * FP * Wr + 11 * D * FP * Wc + 11 * D * FP * Wo + 11 * D * FP * Ws := by ring
      _ ≤ _ := by nlinarith [rate, consB, otherB, slashB]
  have cancel : 10 * L ≤ Wr + 33 * D * (cg + 1) + 11 * D * (og + f + 2) + 33 * D * n * (f + 1) := by
    have hq : 0 < I * WD := Nat.mul_pos hI hWD
    have : I * WD * (10 * L) ≤ I * WD * (Wr + 33 * D * (cg + 1) + 11 * D * (og + f + 2) +
      33 * D * n * (f + 1)) := by linarith
    exact Nat.le_of_mul_le_mul_left this hq
  have t1 : 25 * D ≤ 19 * (D * f) := by nlinarith
  have t2 : 33 * D * n * (f + 1) ≤ 60 * (n * (df * f)) := by
    have a : D * n * f ≤ n * (df * f) := by
      calc D * n * f = n * (D * f) := by ring
        _ ≤ n * (df * f) := Nat.mul_le_mul_left _ (Nat.mul_le_mul_right _ hD)
    have b : D * n * 2 ≤ n * (df * f) := by
      calc D * n * 2 ≤ n * (df * 2) := by
            have := Nat.mul_le_mul_left n (Nat.mul_le_mul_right 2 hD); linarith
        _ ≤ n * (df * f) := Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ f2)
    have e : 33 * D * n * (f + 1) = 33 * (D * n * f) + 33 * (D * n) := by ring
    have hN := Nat.zero_le (n * (df * f))
    linarith
  have rnd : 33 * D2 * cg + 11 * D2 * og + 30 * D2 * (f + 1) ≤
      10 * ((33 * D2 * cg + 11 * D2 * og + 30 * D2 * (f + 1) + 9) / 10) := by omega
  have m1 : D * cg ≤ D2 * cg := Nat.mul_le_mul_right _ hDD
  have m2 : D * og ≤ D2 * og := Nat.mul_le_mul_right _ hDD
  have m3 : D * f ≤ D2 * f := Nat.mul_le_mul_right _ hDD
  have e1 : 33 * D * (cg + 1) = 33 * D * cg + 33 * D := by ring
  have e2 : 11 * D * (og + f + 2) = 11 * D * og + 11 * (D * f) + 22 * D := by ring
  have e3 : 30 * D2 * (f + 1) = 30 * (D2 * f) + 30 * D2 := by ring
  have e4 : 3 * (n * (2 * df * f)) = 6 * (n * (df * f)) := by ring
  rw [e3] at rnd
  rw [e3, e4]
  linarith

/-- The gains of the counted keys, at their weights, are at most the linear rate of their flows.

The credits of each class are read through the function `cA`, `cB` or `cC` of the key. -/
private theorem flow_lin (t : PinTerms preset) {x y : ForkedBeaconState preset}
    (tailC : Run config checks x y) (high : ℕ)
    (eventsC events eventsF : List (BalanceEvent preset)) (A B C : Finset ValidatorIndex)
    (cA cB cC : ℕ → ℕ) :
    10 * (preset.EFFECTIVE_BALANCE_INCREMENT.toNat * WEIGHT_DENOMINATOR.toNat) *
        ((∑ v ∈ A, flowK t tailC high eventsC events eventsF v.toNat (cA v.toNat)) +
          3 * (∑ v ∈ B, flowK t tailC high eventsC events eventsF v.toNat (cB v.toNat)) +
          (∑ v ∈ C, flowK t tailC high eventsC events eventsF v.toNat (cC v.toNat))) ≤
      11 * min t.depth t.depthFin *
          (t.perIncrement * (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum) *
        ((∑ v ∈ A, flowCredit t tailC high eventsC events eventsF v.toNat (cA v.toNat)) +
          3 * (∑ v ∈ B, flowCredit t tailC high eventsC events eventsF v.toNat (cB v.toNat)) +
          (∑ v ∈ C, flowCredit t tailC high eventsC events eventsF v.toNat (cC v.toNat))) := by
  have each (i c : ℕ) :
      10 * (preset.EFFECTIVE_BALANCE_INCREMENT.toNat * WEIGHT_DENOMINATOR.toNat) *
        flowK t tailC high eventsC events eventsF i c ≤
      11 * min t.depth t.depthFin *
          (t.perIncrement * (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum) *
        flowCredit t tailC high eventsC events eventsF i c := by
    have lin := gain_lin preset.EFFECTIVE_BALANCE_INCREMENT.toNat WEIGHT_DENOMINATOR.toNat
      (t.perIncrement * (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum) (min t.depth t.depthFin)
      (flowCredit t tailC high eventsC events eventsF i c)
    unfold flowK
    split_ifs
    · unfold flowGain
      rwa [Nat.mul_assoc (11 * flowCredit t tailC high eventsC events eventsF i c /
        (10 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat))]
    · simp
  have sum (S : Finset ValidatorIndex) (cS : ℕ → ℕ) :
      10 * (preset.EFFECTIVE_BALANCE_INCREMENT.toNat * WEIGHT_DENOMINATOR.toNat) *
          (∑ v ∈ S, flowK t tailC high eventsC events eventsF v.toNat (cS v.toNat)) ≤
        11 * min t.depth t.depthFin *
            (t.perIncrement * (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum) *
          (∑ v ∈ S, flowCredit t tailC high eventsC events eventsF v.toNat (cS v.toNat)) := by
    rw [Finset.mul_sum, Finset.mul_sum]
    exact Finset.sum_le_sum fun v _ => each v.toNat (cS v.toNat)
  have a := sum A cA
  have b := sum B cB
  have c := sum C cC
  nlinarith [a, b, c]

/-- The initial slashing penalties of a key set on R's branch are at most `slashedR` increments.

The penalty is at most the increment that `slashR` charges, by `slashBand`. -/
private theorem flow_slash (h : Setting config checks g split fin pulled anc counted V)
    (W : Finset ValidatorIndex) :
    ∑ v ∈ W, slashW (pinTerms config pulled anc fin) v.toNat ≤
      preset.EFFECTIVE_BALANCE_INCREMENT.toNat * (pinTerms config pulled anc fin).slashedR := by
  refine le_trans (Finset.sum_le_sum fun v _ => ?_) (slashR_le config pulled anc fin W)
  unfold slashW slashR
  split_ifs
  · have := h.facts.slashBand
    exact le_trans (Nat.le_add_right _ _) this
  · exact le_rfl

/-- The sync flows of any keys fit the sync part of `otherCredits`.

The flows are C's credits and the debits of R's run and of the shared segment.

The debits of the shared segment and of R's run take the epochs from the finalized block to the end.

C's credits take the seats' envelope and the proposer's share, as `syncCredits_le` bounds them. -/
private theorem flow_sync (h : Setting config checks g split fin pulled anc counted V)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩) (high : ℕ)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    {eventsF : List (BalanceEvent preset)} (replayedF : fromFin.balanceEvents high = .ok eventsF)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    (keys : Finset ℕ) :
    ∑ i ∈ keys, (syncCr eventsC i + syncD events i + syncD eventsF i) ≤
      ((pinTerms config pulled anc fin).depth +
          ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat)) *
        preset.SLOTS_PER_EPOCH.toNat * preset.SYNC_COMMITTEE_SIZE.toNat *
          PinTerms.syncEnvelope preset ((getTotalActiveBalance pulled).toOption.getD 0).toNat +
        (pinTerms config pulled anc fin).depth * (pinTerms config pulled anc fin).syncProposer := by
  obtain ⟨pulledTotal, pulledOk⟩ := h.pulledTotal
  have totalEq := getD_total_eq pulledOk
  have called := UInt64.le_iff_toNat_le.mp h.called
  have credits := syncCredits_le h tailC highC replayedC keys
  have shared := (PinSeatDebits.Run.syncDebits_le fromFin h.fulu h.early high replayedF
    pulledTotal.toNat (step_band_of_guard h fromFin (by omega) pulledOk) keys).1
  have own := (PinSeatDebits.Run.syncDebits_le tail h.fulu h.early high replayed pulledTotal.toNat
    (step_band_of_tail h fromFin tail (Nat.le_succ _) pulledOk) keys).1
  have epochs := pin_epochs h fromFin
  rw [totalEq]
  simp only [Finset.sum_add_distrib]
  unfold syncCr syncD
  have scaled := Nat.mul_le_mul_right
    (preset.SLOTS_PER_EPOCH.toNat * preset.SYNC_COMMITTEE_SIZE.toNat *
      PinTerms.syncEnvelope preset pulledTotal.toNat) (le_of_eq epochs)
  rw [totalEq] at credits
  nlinarith [credits, shared, own, scaled]

/-- Some counted key has a positive flow gain when the weighted gains are positive. -/
private theorem flow_pos (t : PinTerms preset) {x y : ForkedBeaconState preset}
    (tailC : Run config checks x y) (high : ℕ)
    (eventsC events eventsF : List (BalanceEvent preset)) (A B C : Finset ValidatorIndex)
    (cA cB cC : ℕ → ℕ)
    (pos : 0 < (∑ v ∈ A, flowK t tailC high eventsC events eventsF v.toNat (cA v.toNat)) +
      3 * (∑ v ∈ B, flowK t tailC high eventsC events eventsF v.toNat (cB v.toNat)) +
      (∑ v ∈ C, flowK t tailC high eventsC events eventsF v.toNat (cC v.toNat))) :
    ∃ i c, 0 < flowK t tailC high eventsC events eventsF i c := by
  by_contra none
  have zero : ∀ i c, flowK t tailC high eventsC events eventsF i c = 0 := fun i c =>
    Nat.eq_zero_of_not_pos fun p => none ⟨i, c, p⟩
  simp only [zero, Finset.sum_const_zero] at pos
  omega

/-- A key with a positive flow gain is on a kept arm or beyond R's registry in the low regime.

Either way its rate per increment is below an eleventh, so the credit part pays below its worth. -/
private theorem flow_key (h : Setting config checks g split fin pulled anc counted V)
    {x y : ForkedBeaconState preset} (tailC : Run config checks x y) (high : ℕ)
    (eventsC events eventsF : List (BalanceEvent preset)) (i c : ℕ)
    (pos : 0 < flowK (pinTerms config pulled anc fin) tailC high eventsC events eventsF i c) :
    11 * (pinTerms config pulled anc fin).depth *
        ((pinTerms config pulled anc fin).perIncrement *
          (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum) <
      WEIGHT_DENOMINATOR.toNat * preset.EFFECTIVE_BALANCE_INCREMENT.toNat := by
  have arm : (pinTerms config pulled anc fin).keptArm i = true ∨
      (i ∉ (pinTerms config pulled anc fin).positions ∧
        (pinTerms config pulled anc fin).gainHigh = false) := by
    by_contra none
    unfold flowK at pos
    rw [ite_eq_right_iff.mpr (fun c => absurd c none)] at pos
    exact Nat.lt_irrefl 0 pos
  rcases arm with kept | ⟨-, low⟩
  · exact key_of_kept h i _ (Nat.le_refl _) kept
  · exact wide_of_lowGain h low

/-- The rate of one increment, at the pin's base reward, is at least two.

The base reward per increment is at least four, by `four_le_perIncrement`. -/
private theorem flow_rate (h : Setting config checks g split fin pulled anc counted V) :
    2 ≤ (pinTerms config pulled anc fin).perIncrement *
        (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum / WEIGHT_DENOMINATOR.toNat := by
  have four := four_le_perIncrement h
  have weights : (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum = 54 := by decide
  have denominator : WEIGHT_DENOMINATOR.toNat = 64 := by decide
  rw [weights, denominator]
  omega

/-- The bound `ebUp` of a key of the registry is at least one increment.

Its top holds the leak of the cap over the window.

That leak is positive since the cap is an increment or more and the rate is at least four. -/
private theorem inc_le_ebUp (h : Setting config checks g split fin pulled anc counted V) {i : ℕ}
    (inside : i < pulled.validators.data.size) :
    preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤ (pinTerms config pulled anc fin).ebUp i := by
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  have incPos := h.bands.1
  have four := four_le_perIncrement h
  obtain ⟨fromFin⟩ := h.fromFin
  have finSplit : (getCurrentEpoch fin).toNat ≤ (getCurrentEpoch split).toNat :=
    UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps fromFin.chainSteps)
  have called := UInt64.le_iff_toNat_le.mp h.called
  have incMeb : preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤ preset.MAX_EFFECTIVE_BALANCE.toNat := by
    have newKey := h.facts.newKey fork
    have := ((newKey.trans (Nat.sub_le _ _)).trans (Nat.sub_le _ _)).trans (Nat.sub_le _ _)
    omega
  have capLe : preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤
      PinTerms.capAt (⟨fork, pulled⟩ : ForkedBeaconState preset) i := by
    unfold PinTerms.capAt
    simp only [Array.getElem?_eq_getElem inside, Option.map_some, Option.getD_some]
    exact Nat.le_trans incMeb (UInt64.le_iff_toNat_le.mp
      (Internal.minimum_cap h.caps.activation h.caps.compounding _))
  have floor : ∀ T : ℕ, preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤ T →
      preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤ T - T % preset.EFFECTIVE_BALANCE_INCREMENT.toNat :=
    fun T le => by
      have parts := Nat.div_add_mod T preset.EFFECTIVE_BALANCE_INCREMENT.toNat
      have one : 1 ≤ T / preset.EFFECTIVE_BALANCE_INCREMENT.toNat :=
        (Nat.le_div_iff_mul_le incPos).2 (by omega)
      have whole : preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤
          preset.EFFECTIVE_BALANCE_INCREMENT.toNat *
            (T / preset.EFFECTIVE_BALANCE_INCREMENT.toNat) := by nlinarith
      omega
  have leak : 2 * (PinTerms.capAt (⟨fork, pulled⟩ : ForkedBeaconState preset) i /
      preset.EFFECTIVE_BALANCE_INCREMENT.toNat * (pinTerms config pulled anc fin).perIncrement) ≤
        (pinTerms config pulled anc fin).leakAt
          (PinTerms.capAt (⟨fork, pulled⟩ : ForkedBeaconState preset) i) i :=
    Nat.le_add_right _ _
  have capOne : 1 ≤ PinTerms.capAt (⟨fork, pulled⟩ : ForkedBeaconState preset) i /
      preset.EFFECTIVE_BALANCE_INCREMENT.toNat := (Nat.le_div_iff_mul_le incPos).2 (by omega)
  have leakPos : 1 ≤ (pinTerms config pulled anc fin).leakAt
      (PinTerms.capAt (⟨fork, pulled⟩ : ForkedBeaconState preset) i) i := by
    have := Nat.mul_le_mul capOne four
    omega
  have window : 1 ≤ (getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat := by omega
  have product := Nat.mul_le_mul window leakPos
  rw [ebUp_eq config pulled anc fin electra i _ rfl]
  refine le_max_of_le_right (le_min capLe (floor _ ?_))
  omega

/-- The bound that the core reads for a key of R's registry is at most its bound and its slack. -/
private theorem whistleRead_le (t : PinTerms preset) (pulled anc counted : BeaconState preset fork)
    {x y : ForkedBeaconState preset} (tail : Run config checks x y)
    {x' y' : ForkedBeaconState preset} (rrun : Run config checks x' y')
    {x'' y'' : ForkedBeaconState preset} (pre : Run config checks x'' y'') (highC high : ℕ)
    (eventsC eventsF events eventsP : List (BalanceEvent preset)) (fin : BeaconState preset fork)
    (i : ℕ) :
    whistleRead t pulled anc counted tail rrun pre highC high eventsC eventsF events eventsP fin
        i ≤
      whistleEnv t pulled anc fin i +
        whistleSlack t tail rrun highC high eventsC eventsF events fin i := by
  unfold whistleRead
  split_ifs
  · exact min_le_left _ _
  · exact le_rfl

/-- A key of R's registry is read at most twice the largest of its bounds by `whistleEnv`.

The increment that a key slashed on R's branch adds is at most its bound `ebUp`.

Every other branch reads at most the key's balance and rise, or `bF`, or its bound `ebUp`. -/
private theorem whistleEnv_le (t : PinTerms preset) (pulled anc fin : BeaconState preset fork)
    (i : ℕ) (inc : preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤ t.ebUp i)
    (finLe : balanceAt fin i ≤ t.ebUp i) :
    whistleEnv t pulled anc fin i ≤
      2 * max (max (t.ebUp i) (balanceAt pulled i + t.rise i)) (t.bF i) := by
  unfold whistleEnv
  split_ifs <;> omega

/-- The keys of R's registry are read at twice the largest bounds that `otherCredits` pays. -/
private theorem whistleEnv_sum_le (h : Setting config checks g split fin pulled anc counted V)
    (T : Finset ℕ) (inside : ∀ i ∈ T, i < pulled.validators.data.size) :
    ∑ i ∈ T, whistleEnv (pinTerms config pulled anc fin) pulled anc fin i ≤
      2 * ∑ i ∈ (pinTerms config pulled anc fin).positions,
        max (max ((pinTerms config pulled anc fin).ebUp i)
          (balanceAt pulled i + (pinTerms config pulled anc fin).rise i))
          ((pinTerms config pulled anc fin).bF i) := by
  calc ∑ i ∈ T, whistleEnv (pinTerms config pulled anc fin) pulled anc fin i
      ≤ ∑ i ∈ T, 2 * max (max ((pinTerms config pulled anc fin).ebUp i)
          (balanceAt pulled i + (pinTerms config pulled anc fin).rise i))
          ((pinTerms config pulled anc fin).bF i) :=
        Finset.sum_le_sum fun i member =>
          whistleEnv_le _ _ _ _ i (inc_le_ebUp h (inside i member))
            (effective_fin_le_ebUp h i)
    _ = 2 * ∑ i ∈ T, max (max ((pinTerms config pulled anc fin).ebUp i)
          (balanceAt pulled i + (pinTerms config pulled anc fin).rise i))
          ((pinTerms config pulled anc fin).bF i) := (Finset.mul_sum _ _ _).symm
    _ ≤ _ := Nat.mul_le_mul_left _ (Finset.sum_le_sum_of_subset fun i member =>
        Finset.mem_range.mpr (inside i member))

/-- The sync flows of any keys on the three runs fit the sync part of the credit total.

C's credits take the seats' envelope and the proposer's share.

The shared segment's credits and debits of a seat are at most its reward with the proposer's share.

R's debits take the envelope.

So the segment from the finalized state takes the share too. -/
private theorem sync_flows_le (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩) (highF : ℕ)
    {eventsF : List (BalanceEvent preset)} (replayedF : fromFin.balanceEvents highF = .ok eventsF)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩) (high : ℕ)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    (keys : Finset ℕ) :
    ∑ i ∈ keys, (syncCr eventsC i + syncCr eventsF i + syncD eventsF i + syncD events i) ≤
      ((pinTerms config pulled anc fin).depth +
          ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat)) *
        preset.SLOTS_PER_EPOCH.toNat * preset.SYNC_COMMITTEE_SIZE.toNat *
          PinTerms.syncEnvelope preset ((getTotalActiveBalance pulled).toOption.getD 0).toNat +
        ((pinTerms config pulled anc fin).depth +
          ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat)) *
            (pinTerms config pulled anc fin).syncProposer := by
  obtain ⟨pulledTotal, pulledOk⟩ := h.pulledTotal
  have totalEq := getD_total_eq pulledOk
  have called := UInt64.le_iff_toNat_le.mp h.called
  have credits := syncCredits_le h tailC highC replayedC keys
  have pair := (PinSeatDebits.Run.syncDebits_le fromFin h.fulu h.early highF replayedF
    pulledTotal.toNat (step_band_of_guard h fromFin (by omega) pulledOk) keys).2.1
  have own := (PinSeatDebits.Run.syncDebits_le tail h.fulu h.early high replayed pulledTotal.toNat
    (step_band_of_tail h fromFin tail (Nat.le_succ _) pulledOk) keys).1
  have epochs := pin_epochs h fromFin
  have proposer := syncProposer_eq config pulled anc fin
  rw [proposer] at credits ⊢
  rw [totalEq] at credits ⊢
  unfold PinSeatDebits.syncSeatEnvelope at pair
  rw [← epochs]
  simp only [Finset.sum_add_distrib] at pair ⊢
  unfold syncCr syncD
  generalize PinTerms.syncEnvelope preset pulledTotal.toNat = env at *
  generalize env * PROPOSER_WEIGHT.toNat / (WEIGHT_DENOMINATOR.toNat - PROPOSER_WEIGHT.toNat) =
    share at *
  generalize (pinTerms config pulled anc fin).depth = depth at *
  generalize (getCurrentEpoch pulled).toNat + 1 - (getCurrentEpoch split).toNat = n2 at *
  generalize (getCurrentEpoch split).toNat + 1 - (getCurrentEpoch fin).toNat = n1 at *
  nlinarith [credits, pair, own, Nat.zero_le (n2 * (preset.SLOTS_PER_EPOCH.toNat *
    preset.SYNC_COMMITTEE_SIZE.toNat * share))]

/-- The consolidation credits and bands of any keys, on C's run and the shared segment, fit caps.

Both runs charge entries of the finalized state's queue, which `cons_due_bound` bounds by caps.

A due entry's cap is at least ten bands, so the bands of both runs are at most a fifth of the caps.

The caps are at most `consolidationsX`, as `bud_consolidations_base` reads them. -/
private theorem cons_slack_le (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (high : ℕ) (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    {eventsF : List (BalanceEvent preset)} (replayedF : fromFin.balanceEvents high = .ok eventsF)
    (highLeR : high ≤ (getCurrentEpoch pulled).toNat)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    (highLe : highC ≤ (getCurrentEpoch pulled).toNat) (T : Finset ValidatorIndex) :
    (∑ v ∈ T, (consAmt eventsC v.toNat + consAmt eventsF v.toNat)) ≤
        (pinTerms config pulled anc fin).consolidationsX ∧
      10 * ((∑ v ∈ T, bandX fin highC v.toNat) + ∑ v ∈ T, bandX fin high v.toNat) ≤
        2 * (pinTerms config pulled anc fin).consolidationsX := by
  classical
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  have finEpoch : (getCurrentEpoch fin).toNat ≤ (getCurrentEpoch split).toNat :=
    UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps fromFin.chainSteps)
  have splitPulled : (getCurrentEpoch split).toNat ≤ (getCurrentEpoch pulled).toNat :=
    UInt64.le_iff_toNat_le.mp h.called
  obtain ⟨eventsFin, replayedFin⟩ := fromFin.balanceEvents_ok h.early highC
  have sameF : eventsFin = eventsF := by
    have splitC := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps tailC.chainSteps)
    simp only at splitC
    have same := DirectSafety.Apriori.Internal.balanceEvents_eq_of_endpoint_le fromFin
      (high := highC) (localHigh := high) (by simp only; omega) (by simp only; omega)
    rw [same, replayedF] at replayedFin
    exact (Except.ok.inj replayedFin).symm
  rw [sameF] at replayedFin
  have boundC := cons_due_bound h fromFin tailC highC endEpochC highLe replayedFin replayedC T
  have caps : ∀ H, H ≤ (getCurrentEpoch pulled).toNat →
      ((dueList fin electra H T).map fun v =>
        (withdrawalMaxEffectiveBalance preset fork v).toNat).sum ≤
          (pinTerms config pulled anc fin).consolidationsX := fun H later =>
    (dueList_sum_mono fin electra later T fun v =>
      (withdrawalMaxEffectiveBalance preset fork v).toNat).trans
        ((dueList_sum_le_all fin electra (getCurrentEpoch pulled).toNat T fun v =>
          (withdrawalMaxEffectiveBalance preset fork v).toNat).trans
            (le_of_eq (consolidationsX_eq h electra).symm))
  have bands : ∀ H, H ≤ (getCurrentEpoch pulled).toNat →
      10 * ∑ v ∈ T, bandX fin H v.toNat ≤ (pinTerms config pulled anc fin).consolidationsX :=
    fun H later => by
      rw [bandX_sum fin electra H T, dueAt_eq fin electra H T]
      calc 10 * (preset.upwardBand * (dueList fin electra H T).length)
          = (10 * preset.upwardBand) * (dueList fin electra H T).length := by ring
        _ ≤ preset.MAX_EFFECTIVE_BALANCE.toNat * (dueList fin electra H T).length :=
          Nat.mul_le_mul_right _ h.facts.band
        _ ≤ _ := cap_floor_sum h _
        _ ≤ _ := caps H later
  refine ⟨?_, ?_⟩
  · refine le_trans (Finset.sum_le_sum fun v _ => ?_) (boundC.trans (caps highC highLe))
    simp only [consAmt, List.filter_append, List.map_append, List.sum_append]
    omega
  · have first := bands highC highLe
    have second := bands high highLeR
    omega

/-- The rounding slacks of any keys credited on C's run fit the credited-key slots of the window. -/
private theorem band_credited_le (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (T : Finset ValidatorIndex) (inside : ∀ v ∈ T, v.toNat < counted.validators.data.size) :
    ∑ v ∈ T, bandC tailC highC v.toNat ≤ preset.upwardBand *
      ((pinTerms config pulled anc fin).depth * preset.SLOTS_PER_EPOCH.toNat +
        ((pinTerms config pulled anc fin).depth /
          max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat + 2) *
            preset.SYNC_COMMITTEE_SIZE.toNat +
        (pinTerms config pulled anc fin).depth * preset.MAX_PENDING_DEPOSITS_PER_EPOCH.toNat) := by
  rw [band_sum]
  exact Nat.mul_le_mul_left _ (credited_slots_le h tailC highC T inside)

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The credits that the registry keys without a deposit gain on C's branch fit the credit total.

Each credit is rounded to at most its double, so the keys pay twice their credits.

Their whistleblower credits stay as they are, for the base to bound.

The proposer credits, the sync flows and the consolidations fit the credit total of `otherCredits`.

The bands of the consolidation targets are at most a fifth of the consolidation total.

The bands of the credited keys are the upward band for each slot of the window.

`SB` is the bands of the keys that hold a seat on the shared segment or on R's run.

`SU` is the units and the induced leak of the keys. -/
private theorem slack_le (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩) (high : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    {eventsF : List (BalanceEvent preset)} (replayedF : fromFin.balanceEvents high = .ok eventsF)
    (highLeR : high ≤ (getCurrentEpoch pulled).toNat)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    (highLe : highC ≤ (getCurrentEpoch pulled).toNat)
    (T : Finset ℕ) (inside : ∀ i ∈ T, i < split.validators.data.size)
    (quiet : ∀ i ∈ T, depPre eventsC i = 0) (SB SU : ℕ)
    (seat : ∑ i ∈ T, (bandR (eventsF ++ events) i +
      if (pinTerms config pulled anc fin).exitBeforeFin i = true then
        (if 0 < syncCr eventsF i then preset.upwardBand else 0) else 0) ≤ SB)
    (units : ∑ i ∈ T, (unitK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF i +
      inducedR (pinTerms config pulled anc fin) (fromFin.append tail) i +
      (if 0 < slashW (pinTerms config pulled anc fin) i then
        (pinTerms config pulled anc fin).unitGain else 0)) ≤ SU) :
    ∑ i ∈ T, whistleSlack (pinTerms config pulled anc fin) tailC (fromFin.append tail) highC high
        eventsC eventsF events fin i ≤
      2 * ((11 * ((pinTerms config pulled anc fin).consolidationsX +
        (pinTerms config pulled anc fin).depth * (pinTerms config pulled anc fin).proposerCredit +
        (pinTerms config pulled anc fin).depth * preset.SLOTS_PER_EPOCH.toNat *
          preset.SYNC_COMMITTEE_SIZE.toNat *
            PinTerms.syncEnvelope preset
              ((getTotalActiveBalance pulled).toOption.getD 0).toNat +
        ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) *
          preset.SLOTS_PER_EPOCH.toNat * preset.SYNC_COMMITTEE_SIZE.toNat *
            PinTerms.syncEnvelope preset
              ((getTotalActiveBalance pulled).toOption.getD 0).toNat +
        ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) *
          (pinTerms config pulled anc fin).syncProposer) + 9) / 10) +
      2 * ∑ i ∈ T, whistC tailC highC i +
      preset.upwardBand * ((pinTerms config pulled anc fin).depth * preset.SLOTS_PER_EPOCH.toNat +
        ((pinTerms config pulled anc fin).depth /
          max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat + 2) *
            preset.SYNC_COMMITTEE_SIZE.toNat +
        (pinTerms config pulled anc fin).depth * preset.MAX_PENDING_DEPOSITS_PER_EPOCH.toNat) +
      SB + SU := by
  classical
  have grows : split.validators.data.size ≤ counted.validators.data.size := by
    have := registryGrows_of_chainSteps tailC.chainSteps
    exact this
  have within := BeaconState.validators_size_lt_of_lt_glamsterdam h.early counted
  have small : ∀ i ∈ T, i < 2 ^ 64 := fun i member =>
    Nat.lt_trans (Nat.lt_of_lt_of_le (inside i member) grows) within
  have conv := sum_image_ofNat T small
  -- each credit is rounded to at most its double
  have pointwise : ∀ i ∈ T, whistleSlack (pinTerms config pulled anc fin) tailC
      (fromFin.append tail) highC high eventsC eventsF events fin i ≤
      2 * (propN tailC highC i + whistC tailC highC i +
        (syncCr eventsC i + syncCr eventsF i + syncD eventsF i + syncD events i) +
        (consAmt eventsC i + consAmt eventsF i)) +
      bandC tailC highC i + bandX fin highC i + bandX fin high i +
      (bandR (eventsF ++ events) i +
        if (pinTerms config pulled anc fin).exitBeforeFin i = true then
          (if 0 < syncCr eventsF i then preset.upwardBand else 0) else 0) +
      (unitK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF i +
        inducedR (pinTerms config pulled anc fin) (fromFin.append tail) i +
        (if 0 < slashW (pinTerms config pulled anc fin) i then
          (pinTerms config pulled anc fin).unitGain else 0)) := by
    intro i member
    have dep := quiet i member
    unfold whistleSlack whistleSlackBase
    rw [dep]
    split_ifs <;> omega
  have total := Finset.sum_le_sum pointwise
  simp only [Finset.sum_add_distrib, ← Finset.mul_sum] at total
  simp only [Finset.sum_add_distrib] at seat units
  -- the sums of the credits
  obtain ⟨toFin⟩ := h.toFin
  have prop := proposer_rewards_le h (toFin.append fromFin) (.inl ⟨fromFin⟩) Run.nil rfl tailC highC
    (T.image UInt64.ofNat)
  rw [run_nil_append] at prop
  have c1 := conv fun i => propN tailC highC i
  beta_reduce at c1
  rw [c1] at prop
  have sync := sync_flows_le h fromFin high replayedF tail high replayed tailC highC replayedC T
  simp only [Finset.sum_add_distrib] at sync
  obtain ⟨consSum, consBand⟩ := cons_slack_le h fromFin high endEpoch replayedF highLeR tailC highC
    endEpochC replayedC highLe (T.image UInt64.ofNat)
  have c2 := conv fun i => consAmt eventsC i + consAmt eventsF i
  have c3 := conv fun i => bandX fin highC i
  have c4 := conv fun i => bandX fin high i
  beta_reduce at c2 c3 c4
  rw [c2] at consSum
  rw [c3, c4] at consBand
  simp only [Finset.sum_add_distrib] at consSum
  have bands := band_credited_le h tailC highC (T.image UInt64.ofNat) (by
    intro v member
    obtain ⟨i, mem, rfl⟩ := Finset.mem_image.mp member
    rw [UInt64.toNat_ofNat_of_lt' (small i mem)]
    exact Nat.lt_of_lt_of_le (inside i mem) grows)
  have c5 := conv fun i => bandC tailC highC i
  beta_reduce at c5
  rw [c5] at bands
  have credits : (∑ i ∈ T, propN tailC highC i) + (∑ i ∈ T, syncCr eventsC i) +
      (∑ i ∈ T, syncCr eventsF i) + (∑ i ∈ T, syncD eventsF i) + (∑ i ∈ T, syncD events i) ≤
      (pinTerms config pulled anc fin).depth * (pinTerms config pulled anc fin).proposerCredit +
        (pinTerms config pulled anc fin).depth * preset.SLOTS_PER_EPOCH.toNat *
          preset.SYNC_COMMITTEE_SIZE.toNat *
            PinTerms.syncEnvelope preset
              ((getTotalActiveBalance pulled).toOption.getD 0).toNat +
        ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) *
          preset.SLOTS_PER_EPOCH.toNat * preset.SYNC_COMMITTEE_SIZE.toNat *
            PinTerms.syncEnvelope preset
              ((getTotalActiveBalance pulled).toOption.getD 0).toNat +
        ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) *
          (pinTerms config pulled anc fin).syncProposer := by
    nlinarith [prop, sync]
  omega

/-- The keys of a set that hold a deposit scan on C's run are at most the deposit recipients.

An epoch pass applies at most `MAX_PENDING_DEPOSITS_PER_EPOCH` deposits.

C's run has at most the epochs from the finalized state. -/
private theorem deposit_scan_card_le (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ) (T : Finset ℕ)
    (positive : ∀ i ∈ T,
      0 < (creditScan (fun _ => false) (fun s => decide (s = .deposits)) i highC tailC)) :
    T.card ≤ (pinTerms config pulled anc fin).depthFin *
      preset.MAX_PENDING_DEPOSITS_PER_EPOCH.toNat := by
  classical
  obtain ⟨toFin⟩ := h.toFin
  obtain ⟨fromFin⟩ := h.fromFin
  have shared : Run config checks g ⟨fork, split⟩ := toFin.append fromFin
  have low : (getCurrentEpoch split).toNat ≤ (getCurrentEpoch counted).toNat :=
    UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps tailC.chainSteps)
  have finSplit : (getCurrentEpoch fin).toNat ≤ (getCurrentEpoch split).toNat :=
    UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps fromFin.chainSteps)
  have near := h.near
  have periodLe := Nat.div_le_div_right
    (c := max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat) low
  have periods : (getCurrentEpoch counted).toNat /
      max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat =
      (getCurrentEpoch split).toNat / max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat +
        ((getCurrentEpoch counted).toNat / max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat -
          (getCurrentEpoch split).toNat /
            max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat) := by omega
  obtain ⟨B, S, D, cardB, cardS, cardD, hBS, hD, hSD⟩ := credited_pieces h.genesis
    h.parameters.lookahead (y := ⟨fork, counted⟩) h.early h.delay highC
    ((getCurrentEpoch counted).toNat / max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat -
      (getCurrentEpoch split).toNat / max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat)
    shared tailC h.fulu periods
  have inD : T ⊆ D := fun i member => hD i (positive i member)
  refine (Finset.card_le_card inD).trans (cardD.trans ?_)
  have epochs : (getCurrentEpoch counted).toNat - (getCurrentEpoch split).toNat ≤
      (pinTerms config pulled anc fin).depthFin := by
    show _ ≤ (getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat
    omega
  rw [Nat.mul_comm]
  exact Nat.mul_le_mul_right _ epochs

/-- The deposited keys of R's registry and the created keys that C slashes fit the recipients.

A key that a deposit credits before its slashing has a positive deposit scan.

`created` is that scan for the keys created on C's branch and slashed there. -/
private theorem whist_count (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    (created : ∀ i ∈ (slashedOnC split counted).filter
        (fun i => ¬ i < split.validators.data.size),
      0 < (creditScan (fun _ => false) (fun s => decide (s = .deposits)) i highC tailC)) :
    ((((slashedOnC split counted).filter
          (fun i => i < split.validators.data.size)).filter
            (fun i => 0 < depPre eventsC i)).card +
        (((slashedOnC split counted).filter (fun i => ¬ i < split.validators.data.size)).filter
          (fun i => isActiveAt counted (getCurrentEpoch counted) i = true)).card +
        (((slashedOnC split counted).filter (fun i => ¬ i < split.validators.data.size)).filter
          (fun i => ¬ isActiveAt counted (getCurrentEpoch counted) i = true)).card) ≤
      (pinTerms config pulled anc fin).depthFin *
        preset.MAX_PENDING_DEPOSITS_PER_EPOCH.toNat := by
  classical
  have apart : Disjoint
      (((slashedOnC split counted).filter (fun i => i < split.validators.data.size)).filter
        (fun i => 0 < depPre eventsC i))
      ((slashedOnC split counted).filter (fun i => ¬ i < split.validators.data.size)) :=
    Finset.disjoint_left.mpr fun i registry beyond =>
      (Finset.mem_filter.mp beyond).2 (Finset.mem_filter.mp (Finset.mem_filter.mp registry).1).2
  have all := deposit_scan_card_le h tailC highC
    ((((slashedOnC split counted).filter (fun i => i < split.validators.data.size)).filter
        (fun i => 0 < depPre eventsC i)) ∪
      (slashedOnC split counted).filter (fun i => ¬ i < split.validators.data.size))
    fun i member => by
      rcases Finset.mem_union.mp member with deposited | beyond
      · exact depPre_pos_scan h tailC highC endEpochC replayedC i
          (Finset.mem_filter.mp deposited).2
      · exact created i beyond
  rw [Finset.card_union_of_disjoint apart] at all
  have split2 := Finset.card_filter_add_card_filter_not
    (s := (slashedOnC split counted).filter (fun i => ¬ i < split.validators.data.size))
    (fun i => isActiveAt counted (getCurrentEpoch counted) i = true)
  omega

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The whistleblower credits of any keys are at most the whistleblower base of `otherCredits`.

The base is `Sx`, the credit total `Y` and the band total `Ck` of `otherCredits`.

A key that received a deposit on C's branch, or was created there, is read at the largest cap.

`count` bounds those keys by the deposit recipients of the window, so `Y` pays them.

`slack` is the credits that the other keys of R's registry gain on C's branch.

It holds their whistleblower credits twice, because their rounding is at most their double.

Those credits are within the base too, so the bound divides by the quotient less two. -/
private theorem flow_whist_of (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩)
    {eventsF events : List (BalanceEvent preset)} (high : ℕ)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    {b : BeaconState preset fork} (pre : Run config checks ⟨fork, b⟩ ⟨fork, split⟩)
    {eventsP : List (BalanceEvent preset)}
    (registry : ∀ {a b : ForkedBeaconState preset} (step : Step config checks a b),
      tailC.Contains step → ∀ i, i < split.validators.data.size →
        (split.validators.data[i]?.map (·.slashed)).getD false = false →
        (!(a.state.validators.data[i]?.map (·.slashed)).getD false &&
          (b.state.validators.data[i]?.map (·.slashed)).getD false) = true →
          effectiveAt a i ≤ whistleEnv (pinTerms config pulled anc fin) pulled anc fin i +
            whistleSlack (pinTerms config pulled anc fin) tailC (fromFin.append tail) highC high
              eventsC eventsF events fin i)
    (registryCharge : ∀ {a b : ForkedBeaconState preset} (step : Step config checks a b),
      tailC.Contains step → ∀ i, i < split.validators.data.size →
        (split.validators.data[i]?.map (·.slashed)).getD false = false →
        (!(a.state.validators.data[i]?.map (·.slashed)).getD false &&
          (b.state.validators.data[i]?.map (·.slashed)).getD false) = true →
        (tailC.departureCharges.any fun c => c.index == i) = true →
          effectiveAt a i ≤ chargeAmt tailC i + riseQ tailC highC i +
            (propN pre highC i + whistC pre highC i + syncCr eventsP i) +
            whistleSlack (pinTerms config pulled anc fin) tailC (fromFin.append tail) highC high
              eventsC eventsF events fin i)
    (Sx Y Ck : ℕ)
    (hSx : Sx = ∑ i ∈ (pinTerms config pulled anc fin).positions,
      max (max ((pinTerms config pulled anc fin).ebUp i)
        (balanceAt pulled i + (pinTerms config pulled anc fin).rise i))
        ((pinTerms config pulled anc fin).bF i))
    (count : ((((slashedOnC split counted).filter
          (fun i => i < split.validators.data.size)).filter
            (fun i => 0 < depPre eventsC i)).card +
        (((slashedOnC split counted).filter (fun i => ¬ i < split.validators.data.size)).filter
          (fun i => isActiveAt counted (getCurrentEpoch counted) i = true)).card +
        (((slashedOnC split counted).filter (fun i => ¬ i < split.validators.data.size)).filter
          (fun i => ¬ isActiveAt counted (getCurrentEpoch counted) i = true)).card) ≤
      (pinTerms config pulled anc fin).depthFin * preset.MAX_PENDING_DEPOSITS_PER_EPOCH.toNat)
    (slack : (∑ i ∈ ((slashedOnC split counted).filter
          (fun i => i < split.validators.data.size)).filter (fun i => ¬ 0 < depPre eventsC i),
        whistleSlack (pinTerms config pulled anc fin) tailC (fromFin.append tail) highC high
          eventsC eventsF events fin i) +
      preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat *
        ((pinTerms config pulled anc fin).depthFin *
          preset.MAX_PENDING_DEPOSITS_PER_EPOCH.toNat) ≤
      2 * ((11 * Y + 9) / 10) + 2 * (Ck) +
        2 * ∑ i ∈ ((slashedOnC split counted).filter
          (fun i => i < split.validators.data.size)).filter (fun i => ¬ 0 < depPre eventsC i),
            whistC tailC highC i)
    (keys : Finset ValidatorIndex) :
    ∑ v ∈ keys, whistC tailC highC v.toNat ≤
      2 * (Sx + (11 * Y + 9) / 10 + Ck) /
        ((parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat - 2) := by
  classical
  obtain ⟨toPulled⟩ := h.toPulled
  have grows : split.validators.data.size ≤ pulled.validators.data.size :=
    registryGrows_of_chainSteps toPulled.chainSteps
  have core := whistle_core h fromFin tail high tailC highC endEpochC replayedC pre registry
    registryCharge
  obtain ⟨T1, hT1⟩ : ∃ T, T = (slashedOnC split counted).filter
      (fun i => i < split.validators.data.size) := ⟨_, rfl⟩
  obtain ⟨T2, hT2⟩ : ∃ T, T = ((slashedOnC split counted).filter
      (fun i => ¬ i < split.validators.data.size)).filter
        (fun i => isActiveAt counted (getCurrentEpoch counted) i = true) := ⟨_, rfl⟩
  obtain ⟨T3, hT3⟩ : ∃ T, T = ((slashedOnC split counted).filter
      (fun i => ¬ i < split.validators.data.size)).filter
        (fun i => ¬ isActiveAt counted (getCurrentEpoch counted) i = true) := ⟨_, rfl⟩
  rw [← hT1, ← hT2, ← hT3] at core
  rw [← hT1] at count slack
  rw [← hT2, ← hT3] at count
  have insideT1 : ∀ i ∈ T1, i < pulled.validators.data.size := fun i member => by
    rw [hT1] at member
    exact Nat.lt_of_lt_of_le (Finset.mem_filter.mp member).2 grows
  have envSum := whistleEnv_sum_le h T1 insideT1
  rw [← hSx] at envSum
  have hW : 30 ≤ (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat :=
    h.facts.whistleblower fork
  set W := (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat with hWd
  set M := preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat with hM
  set t := pinTerms config pulled anc fin with ht
  have add2 : ∀ a b : ℕ, a / W + b / W ≤ (a + b) / W := fun a b =>
    (Nat.le_div_iff_mul_le (by omega)).2 (by
      rw [Nat.add_mul]
      exact Nat.add_le_add (Nat.div_mul_le_self a W) (Nat.div_mul_le_self b W))
  -- the registry keys without a deposit on C's branch pay their bound and their credits
  have x1 : ∑ i ∈ T1, min (whistleRead t pulled anc counted tailC (fromFin.append tail) pre highC
        high eventsC eventsF events eventsP fin i) M ≤
      (∑ i ∈ T1, whistleEnv t pulled anc fin i) +
        (∑ i ∈ T1.filter (fun i => ¬ 0 < depPre eventsC i),
          whistleSlack t tailC (fromFin.append tail) highC high eventsC eventsF events fin i) +
        M * (T1.filter (fun i => 0 < depPre eventsC i)).card := by
    rw [← Finset.sum_filter_add_sum_filter_not T1 (fun i => 0 < depPre eventsC i)]
    have deposited : ∑ i ∈ T1.filter (fun i => 0 < depPre eventsC i), min (whistleRead t pulled anc
        counted tailC (fromFin.append tail) pre highC high eventsC eventsF events eventsP fin
        i) M ≤
          M * (T1.filter (fun i => 0 < depPre eventsC i)).card :=
      (Finset.sum_le_sum fun i _ => min_le_right _ _).trans (by
        rw [Finset.sum_const, smul_eq_mul, Nat.mul_comm])
    have quiet : ∑ i ∈ T1.filter (fun i => ¬ 0 < depPre eventsC i), min (whistleRead t pulled anc
        counted tailC (fromFin.append tail) pre highC high eventsC eventsF events eventsP fin
        i) M ≤
          (∑ i ∈ T1.filter (fun i => ¬ 0 < depPre eventsC i), whistleEnv t pulled anc fin i) +
          ∑ i ∈ T1.filter (fun i => ¬ 0 < depPre eventsC i),
            whistleSlack t tailC (fromFin.append tail) highC high eventsC eventsF events fin i := by
      rw [← Finset.sum_add_distrib]
      exact Finset.sum_le_sum fun i _ =>
        (min_le_left _ _).trans (whistleRead_le _ _ _ _ _ _ _ _ _ _ _ _ _ _ _)
    have sub : ∑ i ∈ T1.filter (fun i => ¬ 0 < depPre eventsC i), whistleEnv t pulled anc fin i ≤
        ∑ i ∈ T1, whistleEnv t pulled anc fin i :=
      Finset.sum_le_sum_of_subset (Finset.filter_subset _ _)
    omega
  have x2 : ∑ i ∈ T2, min (createdCeil t tailC highC eventsC i) M ≤ M * T2.card :=
    (Finset.sum_le_sum fun i _ => min_le_right _ _).trans (by
      rw [Finset.sum_const, smul_eq_mul, Nat.mul_comm])
  have x3 : ∑ i ∈ T3, min (chargeAmt tailC i + whistleExtra t tailC highC eventsC i) M ≤
      M * T3.card :=
    (Finset.sum_le_sum fun i _ => min_le_right _ _).trans (by
      rw [Finset.sum_const, smul_eq_mul, Nat.mul_comm])
  have paid : M * (T1.filter (fun i => 0 < depPre eventsC i)).card + M * T2.card +
      M * T3.card ≤ M * (t.depthFin * preset.MAX_PENDING_DEPOSITS_PER_EPOCH.toNat) := by
    have := Nat.mul_le_mul_left M count
    rwa [Nat.mul_add, Nat.mul_add] at this
  -- the numerator of the three sums, which every set of keys is bounded by over `W`
  obtain ⟨N, hN⟩ : ∃ N, N = (∑ i ∈ T1, whistleEnv t pulled anc fin i) +
      (∑ i ∈ T1.filter (fun i => ¬ 0 < depPre eventsC i),
        whistleSlack t tailC (fromFin.append tail) highC high eventsC eventsF events fin i) +
      M * (T1.filter (fun i => 0 < depPre eventsC i)).card + M * T2.card + M * T3.card :=
    ⟨_, rfl⟩
  have bound : ∀ S' : Finset ValidatorIndex, ∑ v ∈ S', whistC tailC highC v.toNat ≤ N / W := by
    intro S'
    refine (core S').trans ?_
    refine (Nat.add_le_add (Nat.add_le_add (sum_div_le T1 _ W) (sum_div_le T2 _ W))
      (sum_div_le T3 _ W)).trans ?_
    refine ((Nat.add_le_add_right (add2 _ _) _).trans (add2 _ _)).trans ?_
    refine Nat.div_le_div_right ?_
    omega
  -- the whistleblower credits of the keys in the numerator are bounded by the base itself
  have within := BeaconState.validators_size_lt_of_lt_glamsterdam h.early counted
  have credits : ∑ i ∈ T1.filter (fun i => ¬ 0 < depPre eventsC i), whistC tailC highC i ≤
      N / W := by
    have small : ∀ i ∈ T1.filter (fun i => ¬ 0 < depPre eventsC i), i < 2 ^ 64 :=
      fun i member => by
        have inT1 := (Finset.mem_filter.mp member).1
        rw [hT1] at inT1
        have inSlashed := (Finset.mem_filter.mp inT1).1
        unfold slashedOnC at inSlashed
        exact Nat.lt_trans (Finset.mem_range.mp (Finset.mem_filter.mp inSlashed).1) within
    have image := bound ((T1.filter (fun i => ¬ 0 < depPre eventsC i)).image UInt64.ofNat)
    rwa [sum_image_ofNat _ small] at image
  -- `N` is at most the numerator that `otherCredits` pays, with the credits counted twice
  have numerator : N ≤ 2 * (Sx + (11 * Y + 9) / 10 +
      Ck) + 2 * (N / W) := by
    omega
  refine (bound keys).trans ?_
  refine (Nat.le_div_iff_mul_le (by omega)).2 ?_
  have shape : N / W * W ≤ N := Nat.div_mul_le_self N W
  have split2 : N / W * W = N / W * (W - 2) + N / W * 2 := by
    rw [← Nat.mul_add]
    congr 1
    omega
  omega

/-- A key with a flow credit of `cred` or a whistleblower credit has a gross credit on C's run.

Or a consolidation credits it. -/
private theorem credit_gate {x y : ForkedBeaconState preset} (tail : Run config checks x y)
    (high : ℕ) (v : ValidatorIndex) {cred : ℕ}
    (source : cred = credC tail high v.toNat ∨ cred = propC tail high v.toNat)
    (positive : 0 < cred + whistC tail high v.toNat) :
    creditedKey tail high v = true ∨
      0 < (creditScan (fun s => decide (s = .consolidations))
        (fun s => decide (s = .consolidations)) v.toNat high tail) := by
  have prop : propN tail high v.toNat ≤ grossScan v.toNat high tail :=
    scan_le_gross tail high v.toNat _ fun s h => .inl (by simpa using h)
  have whist : whistC tail high v.toNat ≤ grossScan v.toNat high tail :=
    scan_le_gross tail high v.toNat _ fun s h => .inr (.inl (by simpa using h))
  have cn := credN_split tail high v.toNat
  have cc := credC_split tail high v.toNat
  have pc := propC_split tail high v.toNat
  by_cases cons : 0 < (creditScan (fun s => decide (s = .consolidations))
      (fun s => decide (s = .consolidations)) v.toNat high tail)
  · exact .inr cons
  · left
    simp only [creditedKey, decide_eq_true_eq]
    rcases source with rfl | rfl <;> omega

/-- A block step gives no reward or slashing credit to a key that is not its proposer. -/
private theorem block_proposer_credit_zero {g : ForkedBeaconState preset}
    (genesis : Genesis config checks g)
    (apart : preset.MIN_SEED_LOOKAHEAD.toNat + 2 < preset.EPOCHS_PER_HISTORICAL_VECTOR.toNat)
    {f : Fork} {s t : BeaconState preset f} {engine : ExecutionEngine preset f}
    {signed : SignedBeaconBlock preset f} {due : upgradeDue config ⟨f, s⟩ = false}
    {ok : applySignedBlock config checks engine s signed true = .ok t}
    (shared : Run config checks g ⟨f, s⟩) (fulu : .fusaka ≤ f) (early : f < .glamsterdam) (v : ℕ)
    (notProposer : ∀ p, getBeaconProposerIndex s = .ok p → p.toNat ≠ v)
    (blockP slotP : BalanceSource → Bool)
    (sources : ∀ x, blockP x = true → x = .rewards ∨ x = .slashings) :
    stepCredit blockP slotP v (Step.block engine signed due ok) = 0 := by
  obtain ⟨events, replayed⟩ := (Step.block engine signed due ok :
    Step config checks ⟨f, s⟩ ⟨f, t⟩).balanceEvents_ok early
  obtain ⟨K, -, proposer, keys⟩ := block_gross_keys genesis apart shared fulu early replayed
  simp only [stepCredit, replayed, Except.toOption, Option.getD_some]
  refine List.sum_eq_zero fun c member => ?_
  obtain ⟨e, inEvents, rfl⟩ := List.mem_map.mp member
  obtain ⟨inList, selected⟩ := List.mem_filter.mp inEvents
  by_contra positive
  rcases keys e inList v (Nat.pos_of_ne_zero positive) with inK | ⟨isSync, -⟩
  · obtain ⟨p, read, same⟩ := proposer v inK
    exact notProposer p read same
  · rcases sources _ selected with rewards | slashings <;> simp_all

/-- The proposer and whistleblower credits of a key that exited by the finalized state are 0.

The key is inactive on the whole run from that state, so it proposes no block.

Its slashings and rewards credit only the proposer. -/
private theorem exited_proposer_credits_zero
    (h : Setting config checks g split fin pulled anc counted V) {u : ForkedBeaconState preset}
    (run : Run config checks ⟨fork, fin⟩ u) (early : u.fork < .glamsterdam) (high i : ℕ)
    {w : Validator} (foundPulled : pulled.validators.data[i]? = some w)
    (exited : w.exitEpoch.toNat ≤ (getCurrentEpoch fin).toNat) :
    propN run high i = 0 ∧ whistC run high i = 0 := by
  obtain ⟨toFin⟩ := h.toFin
  have zero : ∀ (blockP : BalanceSource → Bool),
      (∀ x, blockP x = true → x = .rewards ∨ x = .slashings) →
      (creditScan blockP (fun _ => false) i high run) = 0 := fun blockP sources =>
    creditScan_eq_zero_of_steps blockP _ i high run fun {m n} step member => by
      cases step with
      | slot ok => simp [stepCredit]
      | @block f s t engine signed due ok =>
        obtain ⟨pre, -, -, mEarly, -⟩ :=
          DirectSafety.Apriori.Internal.Run.contains_step_facts member early
        exact block_proposer_credit_zero h.genesis h.parameters.lookahead (toFin.append pre)
          (Nat.le_trans h.fulu (fork_le_of_chainSteps pre.chainSteps)) mEarly i
          (fun p read => exited_not_proposer h foundPulled exited _ pre p mEarly read) blockP _
          sources
  exact ⟨zero _ fun x hx => .inl (by simpa using hx),
    zero _ fun x hx => .inr (by simpa using hx)⟩

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The ceiling of the effective balance of a key that exited before the finalized state.

It is read at a state that C's branch slashes the key from.

Its credits on the run from the finalized state are sync and consolidation credits.

Deposits, proposer credits and whistleblower credits are 0 for such a key. -/
private theorem exited_credit_ceiling
    (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩) (high : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    {eventsF : List (BalanceEvent preset)} (replayedF : fromFin.balanceEvents high = .ok eventsF)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    {a b : ForkedBeaconState preset} (step : Step config checks a b) (member : tailC.Contains step)
    (i : ℕ) (w : Validator) (foundPulled : pulled.validators.data[i]? = some w)
    (exited : w.exitEpoch.toNat + 1 ≤ (getCurrentEpoch fin).toNat)
    (flag : (!(a.state.validators.data[i]?.map (·.slashed)).getD false &&
      (b.state.validators.data[i]?.map (·.slashed)).getD false) = true) :
    ∃ Cr, Cr ≤ syncCr eventsF i + consAmt eventsF i + syncCr eventsC i + consAmt eventsC i ∧
      (0 < Cr → 0 < syncCr eventsF i ∨ 0 < syncCr eventsC i ∨
        0 < consAmt eventsF i + consAmt eventsC i) ∧
      effectiveAt a i ≤
        max (effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) i)
          ((actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i -
            actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i %
              preset.EFFECTIVE_BALANCE_INCREMENT.toNat) +
            preset.EFFECTIVE_BALANCE_INCREMENT.toNat *
              ((Cr + preset.EFFECTIVE_BALANCE_INCREMENT.toNat - 1) /
                preset.EFFECTIVE_BALANCE_INCREMENT.toNat)) := by
  classical
  obtain ⟨shared⟩ := h.toFin
  obtain ⟨pre, post, cut, aEarly, aEpoch⟩ :=
    DirectSafety.Apriori.Internal.Run.contains_step_facts member h.early
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  obtain ⟨u, foundFin, sameExit⟩ := exit_kept_of_le_fin h foundPulled (by omega)
  have exitedFin : u.exitEpoch.toNat + 1 ≤ (getCurrentEpoch fin).toNat := by
    rw [sameExit]; exact exited
  have sameFork : a.fork = fork :=
    fork_eq_of_run pre ((Run.nil.snoc step).append post) (Nat.le_refl _)
  obtain ⟨af, as⟩ := a
  simp only at sameFork aEarly aEpoch
  subst sameFork
  have epochA : (getCurrentEpoch as).toNat ≤ highC + 1 := by omega
  -- the replays of the shared segment, and of the run from the finalized state to `a`
  obtain ⟨eF, replayedF'⟩ := fromFin.balanceEvents_ok h.early highC
  obtain ⟨eP, replayedP⟩ := pre.balanceEvents_ok aEarly highC
  have sameF : eF = eventsF := by
    have splitC := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps tailC.chainSteps)
    have calledNat := UInt64.le_iff_toNat_le.mp h.called
    simp only at splitC calledNat
    have same := balanceEvents_eq_of_endpoint_le fromFin (high := highC) (localHigh := high)
      (by simp only; omega) (by simp only; omega)
    rw [same, replayedF] at replayedF'
    exact (Except.ok.inj replayedF').symm
  subst sameF
  have wholeR := balanceEvents_append fromFin pre highC replayedF' replayedP
  have cred := credits_le_sources shared h.genesis (fromFin.append pre) aEarly electra i highC
    wholeR
  -- the key has no proposer, whistleblower or deposit credit on the run
  obtain ⟨propZero, whistZero⟩ := exited_proposer_credits_zero h (fromFin.append pre) aEarly highC
    i foundPulled (by omega)
  have insideFin : i < fin.validators.data.size := (Array.getElem?_eq_some_iff.mp foundFin).1
  have inA : i < as.validators.data.size :=
    Nat.lt_of_lt_of_le insideFin (registryGrows_of_chainSteps (fromFin.append pre).chainSteps)
  obtain ⟨vA, foundA⟩ : ∃ vA, as.validators.data[i]? = some vA :=
    ⟨_, Array.getElem?_eq_getElem inA⟩
  obtain ⟨vB, foundB⟩ : ∃ vB, b.state.validators.data[i]? = some vB := by
    cases found : b.state.validators.data[i]? with
    | none => simp [found] at flag
    | some vB => exact ⟨vB, rfl⟩
  obtain ⟨flagA, flagB⟩ := Bool.and_eq_true_iff.mp flag
  have cleanA : vA.slashed = false := by simpa [foundA] using flagA
  have slashedB : vB.slashed = true := by simpa [foundB] using flagB
  have unset : u.exitEpoch ≠ FAR_FUTURE_EPOCH := fun far => by
    have := getCurrentEpoch_succ_lt_farFuture h.twoSlots fin
    have := congrArg UInt64.toNat far
    omega
  have kept := PinEventsKept.kept_run shared h.genesis h.fulu (fromFin.append pre) aEarly
  obtain ⟨vA', foundA', -⟩ := kept.life.validators i u foundFin
  obtain rfl := Option.some.inj (foundA'.symm.trans foundA)
  have constant : vA'.withdrawableEpoch = u.withdrawableEpoch :=
    (kept.withdrawable i u vA' foundFin foundA unset).2.resolve_left (by simp [cleanA])
  have lateA : (getCurrentEpoch as).toNat < vA'.withdrawableEpoch.toNat :=
    newly_slashed_unwithdrawable h.genesis h.caps (shared.append (fromFin.append pre))
      step (Nat.lt_of_le_of_lt
        (fork_le_of_chainSteps post.chainSteps) h.early) foundA foundB cleanA slashedB
  have exitLt := exitEpoch_toNat_lt_of_ne_far unset
  have deposits := PinKeys.Run.exiting_deposit_credit_zero shared h.genesis (fromFin.append pre)
    h.fulu aEarly highC wholeR i u foundFin exitLt (by rw [← constant]; exact lateA)
  have index : i.toUInt64.toNat = i := toNat_toUInt64_of_lt
    (BeaconState.registryWithinLimit_of_lt h.early fin) insideFin
  have depScan : (creditScan (fun _ => false) (fun s => decide (s = .deposits)) i highC
      (fromFin.append pre)) = 0 := by
    have := scan_le_events (fun _ => false) (fun s => decide (s = .deposits)) (· = .deposits)
      (by intro s; simp) (fromFin.append pre) highC i.toUInt64 wholeR
    rw [index] at this
    omega
  have consScan : (creditScan (fun s => decide (s = .consolidations))
      (fun s => decide (s = .consolidations)) i highC (fromFin.append pre)) ≤
        consAmt (eF ++ eP) i := by
    have := scan_le_events (fun s => decide (s = .consolidations))
      (fun s => decide (s = .consolidations))
      (· = .consolidations) (by intro s; simp) (fromFin.append pre) highC i.toUInt64 wholeR
    rw [index] at this
    exact this
  obtain ⟨gross, netLe, -⟩ := cred
  have hN := credN_split (fromFin.append pre) highC i
  have hC := credC_split (fromFin.append pre) highC i
  have ceiling := exited_ceiling h (fromFin.append pre) highC epochA i foundFin exitedFin
    (consAmt (eF ++ eP) i + syncCr (eF ++ eP) i) (by
      unfold syncCr
      omega)
  -- the prefix of C's replay that the run to `a` reads
  rw [cut] at replayedC
  obtain ⟨before, replayedB, prefixB⟩ := Run.balanceEvents_prefix (pre.snoc step) post highC eventsC
    replayedC
  obtain ⟨eP', replayedP', prefixP⟩ := Run.balanceEvents_prefix pre (Run.nil.snoc step) highC before
    replayedB
  rw [replayedP] at replayedP'
  obtain rfl := Except.ok.inj replayedP'
  obtain ⟨rest, restEq⟩ := prefixP.trans prefixB
  have sums : syncCr eventsC i = syncCr eP i + syncCr rest i ∧
      consAmt eventsC i = consAmt eP i + consAmt rest i := by
    subst restEq
    unfold syncCr consAmt
    simp only [List.map_append, List.sum_append, List.filter_append, and_self]
  have splitR : syncCr (eF ++ eP) i = syncCr eF i + syncCr eP i ∧
      consAmt (eF ++ eP) i = consAmt eF i + consAmt eP i := by
    unfold syncCr consAmt
    simp only [List.map_append, List.sum_append, List.filter_append, and_self]
  refine ⟨_, by omega, fun positive => by omega, ceiling⟩

/-- A key whose exit at R is by the finalized epoch is read by `exitBeforeFin`. -/
private theorem exitBeforeFin_of_exit (config : Config) (pulled anc fin : BeaconState preset fork)
    (i : ℕ) {w : Validator} (foundPulled : pulled.validators.data[i]? = some w)
    (exited : w.exitEpoch.toNat ≤ (getCurrentEpoch fin).toNat) :
    (pinTerms config pulled anc fin).exitBeforeFin i = true := by
  simp only [pinTerms]
  simp [foundPulled, exited]

/-- `bF` of a key that `exitBeforeFin` reads is its finalized effective or rounded balance. -/
private theorem bF_of_exit (config : Config) (pulled anc fin : BeaconState preset fork) (i : ℕ)
    (exit : (pinTerms config pulled anc fin).exitBeforeFin i = true) :
    (pinTerms config pulled anc fin).bF i =
      max (effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) i)
        (actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i -
          actualBalanceAt (⟨fork, fin⟩ : ForkedBeaconState preset) i %
            preset.EFFECTIVE_BALANCE_INCREMENT.toNat) := by
  simp only [pinTerms] at exit ⊢
  simp only [exit, ↓reduceIte]
  rfl

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- A key of the split's registry that exited before the finalized state is bounded by `whistleEnv`.

The key is not one that R slashes: `registry_frozen` bounds those, from the finalized state.

Its balance at a state of C's branch is its finalized balance and its credits since.

Those credits are sync and consolidation credits, which the slack holds with one rounding band. -/
private theorem registry_exited
    (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩)
    {eventsF events : List (BalanceEvent preset)} (high : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    (replayedF : fromFin.balanceEvents high = .ok eventsF)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    {a b : ForkedBeaconState preset} (step : Step config checks a b) (member : tailC.Contains step)
    (i : ℕ) (inside : i < split.validators.data.size)
    (exited : ∀ w, pulled.validators.data[i]? = some w →
      w.exitEpoch.toNat + 1 ≤ (getCurrentEpoch fin).toNat)
    (flag : (!(a.state.validators.data[i]?.map (·.slashed)).getD false &&
      (b.state.validators.data[i]?.map (·.slashed)).getD false) = true)
    (slashed : ¬ (pinTerms config pulled anc fin).slashedRB i = true) :
    effectiveAt a i ≤ whistleEnv (pinTerms config pulled anc fin) pulled anc fin i +
      whistleSlack (pinTerms config pulled anc fin) tailC (fromFin.append tail) highC high
        eventsC eventsF events fin i := by
  classical
  obtain ⟨toPulled⟩ := h.toPulled
  obtain ⟨w, foundPulled⟩ : ∃ w, pulled.validators.data[i]? = some w :=
    ⟨_, Array.getElem?_eq_getElem (Nat.lt_of_lt_of_le inside
      (registryGrows_of_chainSteps toPulled.chainSteps))⟩
  have exitedW := exited w foundPulled
  have exit := exitBeforeFin_of_exit config pulled anc fin i foundPulled (by omega)
  obtain ⟨Cr, credits, positive, ceiling⟩ := exited_credit_ceiling h fromFin high endEpoch
    replayedF tailC highC endEpochC replayedC step member i w foundPulled exitedW flag
  have bF := bF_of_exit config pulled anc fin i exit
  have incPos := h.bands.1
  have up := h.bands.2
  -- the rounding of the credits up to whole increments costs less than one band
  have roundLe : preset.EFFECTIVE_BALANCE_INCREMENT.toNat *
      ((Cr + preset.EFFECTIVE_BALANCE_INCREMENT.toNat - 1) /
        preset.EFFECTIVE_BALANCE_INCREMENT.toNat) ≤
        Cr + (if 0 < Cr then preset.upwardBand else 0) := by
    by_cases zero : Cr = 0
    · subst zero
      simp [Nat.div_eq_of_lt (show preset.EFFECTIVE_BALANCE_INCREMENT.toNat - 1 <
        preset.EFFECTIVE_BALANCE_INCREMENT.toNat by omega)]
    · have := Nat.mul_div_le (Cr + preset.EFFECTIVE_BALANCE_INCREMENT.toNat - 1)
        preset.EFFECTIVE_BALANCE_INCREMENT.toNat
      simp only [Nat.pos_of_ne_zero zero, ↓reduceIte]
      omega
  -- a credited key has a band: its sync credit on either segment, or a due consolidation entry
  have band : 0 < Cr → preset.upwardBand ≤ bandC tailC highC i + bandX fin highC i +
      (if 0 < syncCr eventsF i then preset.upwardBand else 0) := by
    intro credited
    rcases positive credited with sharedSync | sync | cons
    · simp only [sharedSync, ↓reduceIte]
      omega
    · have gross := syncCr_gross (Nat.le_trans (by decide) h.fulu) h.early tailC highC replayedC i
        sync
      unfold bandC
      split_ifs <;> omega
    · have index : i.toUInt64.toNat = i := toNat_toUInt64_of_lt
        (BeaconState.registryWithinLimit_of_lt h.early pulled)
        (Array.getElem?_eq_some_iff.mp foundPulled).1
      have replayedF' := replay_at_pulled pulled fromFin high endEpoch h.called replayedF
      have due : 0 < dueAt fin highC {i.toUInt64} := by
        refine Nat.pos_of_ne_zero fun none => ?_
        have zero := consAmt_zero h fromFin replayedF' tailC highC endEpochC h.near replayedC
          i.toUInt64 none
        rw [index] at zero
        omega
      unfold bandX
      have ge := Nat.le_mul_of_pos_right preset.upwardBand due
      rw [Nat.toUInt64_eq] at due
      simp only [Nat.toUInt64_eq] at ge ⊢
      omega
  have main : effectiveAt a i ≤ (pinTerms config pulled anc fin).bF i +
      preset.EFFECTIVE_BALANCE_INCREMENT.toNat *
        ((Cr + preset.EFFECTIVE_BALANCE_INCREMENT.toNat - 1) /
          preset.EFFECTIVE_BALANCE_INCREMENT.toNat) := by
    omega
  have pay : preset.EFFECTIVE_BALANCE_INCREMENT.toNat *
      ((Cr + preset.EFFECTIVE_BALANCE_INCREMENT.toNat - 1) /
        preset.EFFECTIVE_BALANCE_INCREMENT.toNat) ≤
      (11 * (syncCr eventsF i + consAmt eventsF i) + 9) / 10 +
      (11 * (syncCr eventsC i + consAmt eventsC i) + 9) / 10 + bandC tailC highC i +
      bandX fin highC i + (if 0 < syncCr eventsF i then preset.upwardBand else 0) := by
    split_ifs at roundLe band ⊢ <;> omega
  clear ceiling roundLe band positive credits bF
  unfold whistleEnv whistleSlack whistleSlackBase
  simp only [slashed, exit, ↓reduceIte, Bool.false_eq_true]
  split_ifs at pay ⊢ <;> omega

/-- A key with a flow credit is credited.

Or a consolidation of X, a seat debit or R's slashing takes it. -/
private theorem unit_gate (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    (events eventsF : List (BalanceEvent preset)) (v : ValidatorIndex) {cred : ℕ}
    (source : cred = credC tailC highC v.toNat ∨ cred = propC tailC highC v.toNat)
    (positive : 0 < flowCredit (pinTerms config pulled anc fin) tailC highC eventsC events eventsF
      v.toNat cred) :
    creditedKey tailC highC v = true ∨ 0 < consAmt eventsC v.toNat ∨
      0 < syncD eventsF v.toNat ∨ 0 < syncD events v.toNat ∨
      (pinTerms config pulled anc fin).slashedRB v.toNat = true := by
  unfold flowCredit at positive
  by_cases credit : 0 < cred + whistC tailC highC v.toNat
  · rcases credit_gate tailC highC v source credit with credited | consolidated
    · exact .inl credited
    · exact .inr (.inl (Nat.lt_of_lt_of_le consolidated
        (scan_le_events _ _ (· = .consolidations) (by intro s; simp) tailC highC v replayedC)))
  by_cases seat : 0 < syncCr eventsC v.toNat
  · left
    have := syncCr_gross (Nat.le_trans (by decide) h.fulu) h.early tailC highC replayedC
      v.toNat seat
    simp only [creditedKey, decide_eq_true_eq]
    omega
  by_cases debitF : 0 < syncD eventsF v.toNat
  · exact .inr (.inr (.inl debitF))
  by_cases debitR : 0 < syncD events v.toNat
  · exact .inr (.inr (.inr (.inl debitR)))
  right; right; right; right
  have slash : 0 < slashW (pinTerms config pulled anc fin) v.toNat := by omega
  by_contra not
  simp [slashW, not] at slash

/-- The units of a set of keys are the unit for each key with a flow credit. -/
private theorem sum_unitK (t : PinTerms preset) {x y : ForkedBeaconState preset}
    (tailC : Run config checks x y) (high : ℕ) (eventsC events eventsF : List (BalanceEvent preset))
    (S : Finset ValidatorIndex) (cred : ValidatorIndex → ℕ) :
    ∑ v ∈ S, unitK t tailC high eventsC events eventsF v.toNat (cred v) =
      t.unitGain * (S.filter fun v =>
        0 < flowCredit t tailC high eventsC events eventsF v.toNat (cred v)).card := by
  rw [Finset.card_filter, Finset.mul_sum]
  refine Finset.sum_congr rfl fun v _ => ?_
  unfold unitK
  split <;> simp_all

/-- The units of the counted keys, at their weights, fit the unit terms of `pinReserve`.

A credited key's unit takes a slot of `creditUnits`, and a seat-only key's takes a seat unit.

A key credited only by a consolidation of X takes its unit from `consolidationsXCount`.

A key slashed only on R's branch takes its unit in `branchR`.

The keys of `SC` and `CS` hold the slots that the keys of `K4`, `K5` and `K6` leave.

The keys of `SC` alone fit the slots and the extra units at weight one. -/
private theorem bud_units (h : Setting config checks g split fin pulled anc counted V)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩) (high : ℕ)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    {eventsF : List (BalanceEvent preset)} (replayedF : fromFin.balanceEvents high = .ok eventsF)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC) :
    ((∑ v ∈ (K4 pulled counted V),
        unitK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF v.toNat) +
      3 * (∑ v ∈ (K5 counted V),
          unitK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF v.toNat
            (propC tailC highC v.toNat)) +
      (∑ v ∈ (K6 pulled counted),
          unitK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF v.toNat) +
      (∑ v ∈ SC pulled counted split,
          unitK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF v.toNat) +
      (∑ v ∈ CS counted split,
          unitK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF v.toNat) ≤
      (pinTerms config pulled anc fin).creditUnits +
        3 * (pinTerms config pulled anc fin).unitGain *
          (pinTerms config pulled anc fin).consolidationsXCount +
        3 * ((pinTerms config pulled anc fin).unitGain *
          (pinTerms config pulled anc fin).slashedR)) ∧
      ∑ v ∈ SC pulled counted split,
          unitK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF v.toNat ≤
        (pinTerms config pulled anc fin).creditUnits +
          (pinTerms config pulled anc fin).unitGain *
            ((pinTerms config pulled anc fin).consolidationsXCount +
              (pinTerms config pulled anc fin).slashedR) := by
  classical
  obtain ⟨N, units, slots⟩ := creditUnits_eq config pulled anc fin
  obtain ⟨d45, d46, d56, -⟩ := classes_disjoint h
  obtain ⟨dSC, -⟩ := sc_disjoint h
  obtain ⟨dCS, -⟩ := cs_disjoint h
  have credited := credited_classes_le h tailC highC
  have five := card_K5_le h tailC
  -- The consolidation counts read the pulled epoch as their horizon.
  obtain ⟨eventsF', replayedF'⟩ := fromFin.balanceEvents_ok h.early (getCurrentEpoch pulled).toNat
  have replayedC' : tailC.balanceEvents (getCurrentEpoch pulled).toNat = .ok eventsC :=
    (DirectSafety.Apriori.Internal.balanceEvents_eq_of_endpoint_le tailC
      (high := (getCurrentEpoch pulled).toNat) (localHigh := highC) h.near endEpochC).trans
      replayedC
  set G4 := (K4 pulled counted V).filter fun v => 0 < flowCredit
    (pinTerms config pulled anc fin) tailC highC eventsC events eventsF v.toNat
    (credC tailC highC v.toNat)
  set G5 := (K5 counted V).filter fun v => 0 < flowCredit
    (pinTerms config pulled anc fin) tailC highC eventsC events eventsF v.toNat
    (propC tailC highC v.toNat)
  set G6 := (K6 pulled counted).filter fun v => 0 < flowCredit
    (pinTerms config pulled anc fin) tailC highC eventsC events eventsF v.toNat
    (credC tailC highC v.toNat)
  set Gsc := (SC pulled counted split).filter fun v => 0 < flowCredit
    (pinTerms config pulled anc fin) tailC highC eventsC events eventsF v.toNat
    (credC tailC highC v.toNat)
  set Gcs := (CS counted split).filter fun v => 0 < flowCredit
    (pinTerms config pulled anc fin) tailC highC eventsC events eventsF v.toNat
    (credC tailC highC v.toNat)
  have s4 : ∑ v ∈ K4 pulled counted V,
      unitK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF v.toNat =
        (pinTerms config pulled anc fin).unitGain * G4.card :=
    sum_unitK _ tailC highC eventsC events eventsF _ fun v => credC tailC highC v.toNat
  have s5 : ∑ v ∈ K5 counted V,
      unitK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF v.toNat
        (propC tailC highC v.toNat) =
        (pinTerms config pulled anc fin).unitGain * G5.card :=
    sum_unitK _ tailC highC eventsC events eventsF _ fun v => propC tailC highC v.toNat
  have s6 : ∑ v ∈ K6 pulled counted,
      unitK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF v.toNat =
        (pinTerms config pulled anc fin).unitGain * G6.card :=
    sum_unitK _ tailC highC eventsC events eventsF _ fun v => credC tailC highC v.toNat
  have ssc : ∑ v ∈ SC pulled counted split,
      unitK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF v.toNat =
        (pinTerms config pulled anc fin).unitGain * Gsc.card :=
    sum_unitK _ tailC highC eventsC events eventsF _ fun v => credC tailC highC v.toNat
  have scs : ∑ v ∈ CS counted split,
      unitK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF v.toNat =
        (pinTerms config pulled anc fin).unitGain * Gcs.card :=
    sum_unitK _ tailC highC eventsC events eventsF _ fun v => credC tailC highC v.toNat
  set All := K4 pulled counted V ∪ K5 counted V ∪ K6 pulled counted ∪ SC pulled counted split ∪
    CS counted split
  set Co := All.filter fun v => 0 < consAmt eventsC v.toNat
  set A := All.filter fun v => 0 < syncD eventsF v.toNat
  set B := All.filter fun v => 0 < syncD events v.toNat
  set Sl := All.filter fun v => (pinTerms config pulled anc fin).slashedRB v.toNat = true
  set Cr4 := (K4 pulled counted V).filter fun v => creditedKey tailC highC v = true
  set Cr5 := (K5 counted V).filter fun v => creditedKey tailC highC v = true
  set Cr6 := (K6 pulled counted).filter fun v => creditedKey tailC highC v = true
  set Crsc := (SC pulled counted split).filter fun v => creditedKey tailC highC v = true
  set Crcs := (CS counted split).filter fun v => creditedKey tailC highC v = true
  -- A key with a unit is credited, or a consolidation, a seat debit or a slashing takes it.
  have route : ∀ (v : ValidatorIndex) (cred : ℕ), v ∈ All →
      (cred = credC tailC highC v.toNat ∨ cred = propC tailC highC v.toNat) →
      0 < flowCredit (pinTerms config pulled anc fin) tailC highC eventsC events eventsF
        v.toNat cred →
      creditedKey tailC highC v = true ∨ v ∈ Co ∪ (A ∪ B) ∪ Sl := by
    intro v cred inAll source positive
    rcases unit_gate h tailC highC replayedC events eventsF v source positive with
      credit | consolidated | debitF | debitR | slashed
    · exact .inl credit
    · exact .inr (Finset.mem_union_left _ (Finset.mem_union_left _
        (Finset.mem_filter.mpr ⟨inAll, consolidated⟩)))
    · exact .inr (Finset.mem_union_left _ (Finset.mem_union_right _
        (Finset.mem_union_left _ (Finset.mem_filter.mpr ⟨inAll, debitF⟩))))
    · exact .inr (Finset.mem_union_left _ (Finset.mem_union_right _
        (Finset.mem_union_right _ (Finset.mem_filter.mpr ⟨inAll, debitR⟩))))
    · exact .inr (Finset.mem_union_right _ (Finset.mem_filter.mpr ⟨inAll, slashed⟩))
  have inAll : ∀ v, v ∈ K4 pulled counted V ∨ v ∈ K5 counted V ∨ v ∈ K6 pulled counted ∨
      v ∈ SC pulled counted split ∨ v ∈ CS counted split → v ∈ All := fun v member => by
    simp only [All, Finset.mem_union]
    tauto
  have cover : G4 ∪ G5 ∪ G6 ∪ Gsc ∪ Gcs ⊆
      (Cr4 ∪ Cr5 ∪ Cr6 ∪ Crsc ∪ Crcs) ∪ (Co ∪ (A ∪ B) ∪ Sl) := by
    intro v member
    simp only [G4, G5, G6, Gsc, Gcs, Cr4, Cr5, Cr6, Crsc, Crcs, Finset.mem_union,
      Finset.mem_filter] at member ⊢
    rcases member with (((⟨i4, p4⟩ | ⟨i5, p5⟩) | ⟨i6, p6⟩) | ⟨isc, psc⟩) | ⟨ics, pcs⟩
    · rcases route v _ (inAll v (.inl i4)) (.inl rfl) p4 with c | r
      · exact .inl (.inl (.inl (.inl (.inl ⟨i4, c⟩))))
      · simp only [Finset.mem_union] at r
        exact .inr r
    · rcases route v _ (inAll v (.inr (.inl i5))) (.inr rfl) p5 with c | r
      · exact .inl (.inl (.inl (.inl (.inr ⟨i5, c⟩))))
      · simp only [Finset.mem_union] at r
        exact .inr r
    · rcases route v _ (inAll v (.inr (.inr (.inl i6)))) (.inl rfl) p6 with c | r
      · exact .inl (.inl (.inl (.inr ⟨i6, c⟩)))
      · simp only [Finset.mem_union] at r
        exact .inr r
    · rcases route v _ (inAll v (.inr (.inr (.inr (.inl isc))))) (.inl rfl) psc with c | r
      · exact .inl (.inl (.inr ⟨isc, c⟩))
      · simp only [Finset.mem_union] at r
        exact .inr r
    · rcases route v _ (inAll v (.inr (.inr (.inr (.inr ics))))) (.inl rfl) pcs with c | r
      · exact .inl (.inr ⟨ics, c⟩)
      · simp only [Finset.mem_union] at r
        exact .inr r
  have apart45 : Disjoint G4 G5 := Finset.disjoint_left.mpr fun v a b =>
    Finset.disjoint_left.mp d45 (Finset.mem_filter.mp a).1 (Finset.mem_filter.mp b).1
  have apart456 : Disjoint (G4 ∪ G5) G6 := Finset.disjoint_left.mpr fun v a b => by
    rcases Finset.mem_union.mp a with a | a
    · exact Finset.disjoint_left.mp d46 (Finset.mem_filter.mp a).1 (Finset.mem_filter.mp b).1
    · exact Finset.disjoint_left.mp d56 (Finset.mem_filter.mp a).1 (Finset.mem_filter.mp b).1
  have inK3 : ∀ v, v ∈ G4 ∪ G5 ∪ G6 → v ∈ K4 pulled counted V ∪ K5 counted V ∪ K6 pulled counted :=
    fun v hv => by
      rcases Finset.mem_union.mp hv with hv | hv
      · rcases Finset.mem_union.mp hv with hv | hv
        · exact Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_filter.mp hv).1)
        · exact Finset.mem_union_left _ (Finset.mem_union_right _ (Finset.mem_filter.mp hv).1)
      · exact Finset.mem_union_right _ (Finset.mem_filter.mp hv).1
  have apartSC : Disjoint (G4 ∪ G5 ∪ G6) Gsc := Finset.disjoint_left.mpr fun v a b =>
    Finset.disjoint_left.mp dSC (inK3 v a) (Finset.mem_filter.mp b).1
  have apartCS : Disjoint (G4 ∪ G5 ∪ G6 ∪ Gsc) Gcs := Finset.disjoint_left.mpr fun v a b => by
    rcases Finset.mem_union.mp a with a | a
    · exact Finset.disjoint_left.mp dCS (Finset.mem_union_left _ (inK3 v a))
        (Finset.mem_filter.mp b).1
    · exact Finset.disjoint_left.mp dCS (Finset.mem_union_right _ (Finset.mem_filter.mp a).1)
        (Finset.mem_filter.mp b).1
  have total := Finset.card_le_card cover
  rw [Finset.card_union_of_disjoint apartCS, Finset.card_union_of_disjoint apartSC,
    Finset.card_union_of_disjoint apart456, Finset.card_union_of_disjoint apart45] at total
  have union1 := Finset.card_union_le (Cr4 ∪ Cr5 ∪ Cr6 ∪ Crsc ∪ Crcs) (Co ∪ (A ∪ B) ∪ Sl)
  have union2 := Finset.card_union_le (Cr4 ∪ Cr5 ∪ Cr6 ∪ Crsc) Crcs
  have union3 := Finset.card_union_le (Cr4 ∪ Cr5 ∪ Cr6) Crsc
  have union4 := Finset.card_union_le (Cr4 ∪ Cr5) Cr6
  have union5 := Finset.card_union_le Cr4 Cr5
  have union6 := Finset.card_union_le (Co ∪ (A ∪ B)) Sl
  have union7 := Finset.card_union_le Co (A ∪ B)
  -- The counts of the credited keys, the consolidations, the seat debits and the slashings.
  have consolidations := cons_keys_le h fromFin tailC (getCurrentEpoch pulled).toNat h.near
    (Nat.le_refl _) replayedF' replayedC' Co fun v hv => (Finset.mem_filter.mp hv).2
  have seats := debit_keys_le h fromFin tail tailC high replayed replayedF A B
    (fun v hv => (Finset.mem_filter.mp hv).2) fun v hv => (Finset.mem_filter.mp hv).2
  have slashed : Sl.card ≤ (pinTerms config pulled anc fin).slashedR :=
    slashedRB_card_le config pulled anc fin All
  have inFive : G5.card ≤ (K5 counted V).card := Finset.card_le_card (Finset.filter_subset _ _)
  have key : G4.card + G6.card + 3 * G5.card + Gsc.card + Gcs.card ≤ N +
      2 * ((((pinTerms config pulled anc fin).positions.filter fun i =>
        (pinTerms config pulled anc fin).exitingB i = true).card +
          (pinTerms config pulled anc fin).queueKeys)) +
      3 * (pinTerms config pulled anc fin).consolidationsXCount +
      3 * (pinTerms config pulled anc fin).slashedR := by
    omega
  -- The keys of `SC` alone take one slot each, and the other classes' slots are not weighed.
  have keySC : Gsc.card ≤ N + (pinTerms config pulled anc fin).consolidationsXCount +
      (pinTerms config pulled anc fin).slashedR := by
    omega
  refine ⟨?_, ?_⟩
  swap
  · rw [ssc, units]
    calc (pinTerms config pulled anc fin).unitGain * Gsc.card
        ≤ (pinTerms config pulled anc fin).unitGain * (N +
            (pinTerms config pulled anc fin).consolidationsXCount +
            (pinTerms config pulled anc fin).slashedR) := Nat.mul_le_mul_left _ keySC
      _ = (pinTerms config pulled anc fin).unitGain * N +
          (pinTerms config pulled anc fin).unitGain *
            ((pinTerms config pulled anc fin).consolidationsXCount +
              (pinTerms config pulled anc fin).slashedR) := by ring
      _ ≤ _ := by
        rw [Nat.add_mul, Nat.mul_comm (pinTerms config pulled anc fin).unitGain N]
        exact Nat.add_le_add (Nat.le_add_right _ _) (Nat.le_refl _)
  rw [s4, s5, s6, ssc, scs, units]
  calc (pinTerms config pulled anc fin).unitGain * G4.card +
        3 * ((pinTerms config pulled anc fin).unitGain * G5.card) +
        (pinTerms config pulled anc fin).unitGain * G6.card +
        (pinTerms config pulled anc fin).unitGain * Gsc.card +
        (pinTerms config pulled anc fin).unitGain * Gcs.card
      = (pinTerms config pulled anc fin).unitGain *
          (G4.card + G6.card + 3 * G5.card + Gsc.card + Gcs.card) := by ring
    _ ≤ (pinTerms config pulled anc fin).unitGain * (N +
        2 * ((((pinTerms config pulled anc fin).positions.filter fun i =>
          (pinTerms config pulled anc fin).exitingB i = true).card +
            (pinTerms config pulled anc fin).queueKeys)) +
        3 * (pinTerms config pulled anc fin).consolidationsXCount +
        3 * (pinTerms config pulled anc fin).slashedR) := Nat.mul_le_mul_left _ key
    _ = _ := by ring

/-- The arithmetic of the sync leak: the debited increments `A` of all keys fit `D` at `inc` each.

Three increments of a key fit two of the window's, since `D / (inc - 1)` bounds them.

The floors of the keys add up to at most the floor of their sum. -/
private theorem leak_arith (dF P X Q D inc A F S R SL Sig : ℕ) (hinc : 1 < inc)
    (debits : inc * A ≤ D) (floors : F ≤ inc * A * X / Q) (count : S ≤ R)
    (keys : Sig ≤ dF * (3 * P * A + F) + S * SL) :
    3 * Sig ≤ 3 * dF * (2 * P * (2 * D / (inc - 1) + 1) + 2 * D * X / Q + 1) + 3 * (R * SL) := by
  have within : A ≤ D / (inc - 1) := (Nat.le_div_iff_mul_le (by omega)).mpr
    (le_trans (Nat.mul_le_mul_left _ (Nat.sub_le _ _)) (by rw [Nat.mul_comm]; exact debits))
  have double := Nat.mul_div_le_mul_div_assoc 2 D (inc - 1)
  have three : 3 * P * A ≤ 2 * P * (2 * D / (inc - 1) + 1) :=
    calc 3 * P * A = P * (3 * A) := by ring
      _ ≤ P * (2 * (2 * D / (inc - 1) + 1)) := Nat.mul_le_mul_left _ (by omega)
      _ = _ := by ring
  have rounded : F ≤ 2 * D * X / Q := floors.trans (Nat.div_le_div_right (by
    calc inc * A * X ≤ D * X := Nat.mul_le_mul_right _ debits
      _ ≤ 2 * D * X := Nat.mul_le_mul_right _ (by omega)))
  have := Nat.mul_le_mul_left dF (Nat.add_le_add_right (Nat.add_le_add three rounded) 1)
  have := Nat.mul_le_mul_right SL count
  nlinarith

/-- A key's penalty on R's branch is at most one increment, and only a slashed key has one. -/
private theorem slashW_le (h : Setting config checks g split fin pulled anc counted V) (i : ℕ) :
    slashW (pinTerms config pulled anc fin) i ≤ preset.EFFECTIVE_BALANCE_INCREMENT.toNat *
      (if (pinTerms config pulled anc fin).slashedRB i = true then 1 else 0) := by
  unfold slashW
  split_ifs
  · rw [Nat.mul_one]
    exact (Nat.le_add_right _ _).trans h.facts.slashBand
  · exact Nat.zero_le _

/-- The leak induced by the sync debits of any keys fits `syncLeak` and the slashed keys' leak.

A key withdrawn by R's horizon induces no leak.

A key's induced leak is that of its debited increments and of its penalty's increment.

The keys that R slashed after the finalized epoch are at most `slashedR`. -/
private theorem syncLeak_of_envelope (h : Setting config checks g split fin pulled anc counted V)
    (perPos : 1 ≤ (pinTerms config pulled anc fin).perIncrement)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩)
    {eventsF events : List (BalanceEvent preset)}
    (replayedF : fromFin.balanceEvents (getCurrentEpoch pulled).toNat = .ok eventsF)
    (replayed : tail.balanceEvents (getCurrentEpoch pulled).toNat = .ok events)
    (W : Finset ValidatorIndex)
    (envelope : ∀ v ∈ W, (∀ w, pulled.validators.data[v.toNat]? = some w →
        (getCurrentEpoch pulled).toNat + 1 < w.withdrawableEpoch.toNat) →
      ∀ z ∈ (fromFin.append tail).balancePath, effectiveAt z v.toNat ≤
        (pinTerms config pulled anc fin).ebUp v.toNat + preset.EFFECTIVE_BALANCE_INCREMENT.toNat *
          ((syncD eventsF v.toNat + syncD events v.toNat +
              slashW (pinTerms config pulled anc fin) v.toNat) /
            preset.EFFECTIVE_BALANCE_INCREMENT.toNat)) :
    3 * ∑ v ∈ W, inducedR (pinTerms config pulled anc fin) (fromFin.append tail) v.toNat ≤
      (pinTerms config pulled anc fin).syncLeak +
        3 * ((pinTerms config pulled anc fin).slashedR *
          (pinTerms config pulled anc fin).slashLeak) := by
  classical
  have incPos : 0 < preset.EFFECTIVE_BALANCE_INCREMENT.toNat := by
    have := h.facts.incrementSize
    omega
  -- the abbreviations of the pin's terms
  obtain ⟨a, ha⟩ : ∃ a : ValidatorIndex → ℕ, ∀ v, a v = (syncD eventsF v.toNat +
    syncD events v.toNat) / preset.EFFECTIVE_BALANCE_INCREMENT.toNat := ⟨_, fun _ => rfl⟩
  obtain ⟨s, hs⟩ : ∃ s : ValidatorIndex → ℕ, ∀ v, s v =
    if (pinTerms config pulled anc fin).slashedRB v.toNat = true then 1 else 0 := ⟨_, fun _ => rfl⟩
  have total := Finset.sum_le_sum fun v (member : v ∈ W) => by
    by_cases late : ∀ w, pulled.validators.data[v.toNat]? = some w →
        (getCurrentEpoch pulled).toNat + 1 < w.withdrawableEpoch.toNat
    · refine inducedR_le config pulled anc fin incPos perPos _ v.toNat (a v) (s v)
        (by rw [hs]; split_ifs <;> omega) fun z inPath =>
          (envelope v member late z inPath).trans ?_
      refine Nat.add_le_add_left (Nat.mul_le_mul_left _ ?_) _
      have within := slashW_le h v.toNat
      rw [← hs] at within
      calc _ ≤ (syncD eventsF v.toNat + syncD events v.toNat +
              preset.EFFECTIVE_BALANCE_INCREMENT.toNat * s v) /
            preset.EFFECTIVE_BALANCE_INCREMENT.toNat :=
            Nat.div_le_div_right (Nat.add_le_add_left within _)
        _ = a v + s v := by
            rw [Nat.add_mul_div_left _ _ incPos, ha]
    · obtain ⟨w, found, notLate⟩ : ∃ w, pulled.validators.data[v.toNat]? = some w ∧
          w.withdrawableEpoch.toNat ≤ (getCurrentEpoch pulled).toNat + 1 := by
        by_contra none
        exact late fun w found => by
          by_contra notLate
          exact none ⟨w, found, by omega⟩
      rw [inducedR_of_withdrawn _ _ _ (withdrawnRB_of_le config pulled anc fin found notLate)]
      exact Nat.zero_le _
  rw [Finset.sum_add_distrib, ← Finset.mul_sum, Finset.sum_add_distrib, ← Finset.mul_sum,
    ← Finset.sum_mul] at total
  have appended := DirectSafety.Apriori.Internal.balanceEvents_append fromFin tail _ replayedF
    replayed
  have epochs : (getCurrentEpoch pulled).toNat + 1 - (getCurrentEpoch fin).toNat ≤
      (getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat := by omega
  have hA := (show preset.EFFECTIVE_BALANCE_INCREMENT.toNat * ∑ v ∈ W, a v ≤
      ∑ v ∈ W, ((eventsF ++ events).map (syncDebit v.toNat)).sum by
    rw [Finset.mul_sum]
    refine Finset.sum_le_sum fun v _ => ?_
    rw [ha, List.map_append, List.sum_append]
    exact Nat.mul_div_le _ _).trans
    ((syncDebits_window_le h (fromFin.append tail) (Nat.le_succ _) appended W).trans
      (Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ epochs))))
  have hS : ∑ v ∈ W, s v ≤ (pinTerms config pulled anc fin).slashedR := by
    refine Nat.le_of_mul_le_mul_left (le_trans (le_of_eq ?_)
      (slashR_le config pulled anc fin W)) incPos
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun v _ => by unfold slashR; rw [hs]; split_ifs <;> simp
  have floors := (DirectSafety.Apriori.Internal.sum_div_le W
    (fun v => preset.EFFECTIVE_BALANCE_INCREMENT.toNat * a v *
    ((pinTerms config pulled anc fin).scoreMaxFin +
      (pinTerms config pulled anc fin).depthFin * config.INACTIVITY_SCORE_BIAS.toNat))
    (config.INACTIVITY_SCORE_BIAS.toNat *
      (parameters preset fork).INACTIVITY_PENALTY_QUOTIENT.toNat)).trans
    (Nat.div_le_div_right (le_of_eq (by rw [← Finset.sum_mul, ← Finset.mul_sum])))
  have hc : 1 < preset.EFFECTIVE_BALANCE_INCREMENT.toNat := by
    have := h.facts.incrementSize
    omega
  exact leak_arith _ _ _ _ _ _ _ _ _ _ _ _ hc hA floors hS total

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- A counted key's balance at C is at most its balance at R plus its rise and its flows.

It adds the rise of the key and the credits, flows and slacks that `rise` does not read.

The slacks are one increment for a slashing on R's branch.

They are one rounding step for a credit on C's branch.

They are one rounding step for a sync debit on R's branch or on its shared segment with C's.

The key's flows also compound, which `keyExtra` charges with its unit and its induced leak.

The start's rounding is `prefix_envelope`'s floor form. -/
private def keyCeiling (anc : BeaconState preset fork)
    (run : Run config checks ⟨fork, fin⟩ ⟨fork, pulled⟩)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (eventsC events eventsF : List (BalanceEvent preset)) (i : ℕ) : Prop :=
  balanceAt counted i ≤ balanceAt pulled i + (pinTerms config pulled anc fin).rise i +
    (credC tailC highC i +
      keyExtra (pinTerms config pulled anc fin) run tailC highC eventsC events eventsF i) +
    whistC tailC highC i + (syncF events i + syncF eventsC i) +
    slashR (pinTerms config pulled anc fin) i + bandC tailC highC i +
    bandR (eventsF ++ events) i + bandX fin highC i

/-- The gain of the flows `Z0` and a penalty `W` is within a tenth of `Z0`, rounded up, and a unit.

The gain of the flows alone is within a tenth of them, by `key`.

A penalty below an increment adds at most one increment to the floor of the flows' gain.

That increment gains at most one unit. -/
private theorem flow_gain_slack {I WD F P D Z0 W U : ℕ} (hI : 0 < I)
    (key : 11 * D * (P * F) < WD * I) (hW : 11 * W < 10 * I)
    (unit : D * (P * F / WD + 2) ≤ U) :
    D * (11 * (Z0 + W) / (10 * I) * P * F / WD) ≤ (Z0 + 9) / 10 + (if 0 < W then U else 0) := by
  have hWD : 0 < WD := by
    rcases Nat.eq_zero_or_pos WD with z | p
    · subst z
      simp at key
    · exact p
  have base : ∀ Z : ℕ, 10 * (D * (11 * Z / (10 * I) * P * F / WD)) ≤ Z := by
    intro Z
    obtain ⟨x, hx⟩ : ∃ x, x = 11 * Z / (10 * I) := ⟨_, rfl⟩
    rw [← hx]
    obtain ⟨q, hq⟩ : ∃ q, q = x * P * F / WD := ⟨_, rfl⟩
    rw [← hq]
    have h1 : WD * q ≤ x * P * F := by
      rw [hq]
      exact Nat.mul_div_le _ _
    have h2 : x * (10 * I) ≤ 11 * Z := by
      rw [hx]
      exact Nat.div_mul_le_self _ _
    have h3 : 11 * D * (P * F) + 1 ≤ WD * I := key
    have h4 : 11 * (D * q * WD) ≤ 11 * (D * (x * P * F)) :=
      Nat.mul_le_mul_left _ (by nlinarith)
    have h5 : 11 * (D * (x * P * F)) * 10 ≤ WD * (x * (10 * I)) := by nlinarith
    have h6 : 11 * (10 * (D * q)) * WD ≤ 11 * Z * WD := by nlinarith
    exact Nat.le_of_mul_le_mul_right
      (Nat.le_of_mul_le_mul_left (by nlinarith) (by norm_num : 0 < 11)) hWD
  have g0 := base Z0
  by_cases w : 0 < W
  · simp only [w, ↓reduceIte]
    obtain ⟨x0, hx0⟩ : ∃ x0, x0 = 11 * Z0 / (10 * I) := ⟨_, rfl⟩
    have hx : 11 * (Z0 + W) / (10 * I) ≤ x0 + 1 := by
      have : 11 * (Z0 + W) ≤ 11 * Z0 + 10 * I := by omega
      calc 11 * (Z0 + W) / (10 * I) ≤ (11 * Z0 + 10 * I) / (10 * I) :=
            Nat.div_le_div_right this
        _ = x0 + 1 := by rw [hx0, Nat.add_div_right _ (by omega)]
    have step : 11 * (Z0 + W) / (10 * I) * P * F / WD ≤ x0 * P * F / WD + P * F / WD + 1 := by
      calc 11 * (Z0 + W) / (10 * I) * P * F / WD ≤ (x0 + 1) * P * F / WD :=
            Nat.div_le_div_right (Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ hx))
        _ = (x0 * P * F + P * F) / WD := by
            congr 1
            ring
        _ ≤ x0 * P * F / WD + P * F / WD + 1 := Nat.add_div_le_div_add_div_add_one _ _ _
    have g1 : D * (11 * (Z0 + W) / (10 * I) * P * F / WD) ≤
        D * (x0 * P * F / WD) + D * (P * F / WD + 2) := by
      calc D * (11 * (Z0 + W) / (10 * I) * P * F / WD)
          ≤ D * (x0 * P * F / WD + P * F / WD + 1) := Nat.mul_le_mul_left _ step
        _ ≤ D * (x0 * P * F / WD) + D * (P * F / WD + 2) := by
            rw [← Nat.mul_add]
            exact Nat.mul_le_mul_left _ (by omega)
    rw [← hx0] at g0
    omega
  · simp only [w, ↓reduceIte]
    have : W = 0 := by omega
    subst this
    simp only [Nat.add_zero]
    omega

/-- The explicit closing of a key at its slashing state is within `whistleEnv` and `whistleSlack`.

`pre` is C's run up to the state before the slashing, and `tailC` is the whole run.

The slashing's increment is `whistleEnv`'s when R's branch slashes the key.

`Cr` and the sync debits are credits of the slack.

The flows' gain is within a tenth of them, rounded up, with a unit for the penalty of R's slashing.

The key's bands and unit of the prefix are within those of the whole run. -/
private theorem whistle_of_close (h : Setting config checks g split fin pulled anc counted V)
    (t : PinTerms preset) (ht : t = pinTerms config pulled anc fin)
    {x y x' y' r r' : ForkedBeaconState preset}
    (pre : Run config checks x y) (tailC : Run config checks x' y')
    (rrun : Run config checks r r') (highC high : ℕ)
    (eventsC eventsPre eventsF events : List (BalanceEvent preset))
    (i Cr X : ℕ)
    (close : X ≤ balanceAt pulled i + t.rise i +
      (syncD eventsF i + syncD events i + Cr + inducedR t rrun i +
        flowK t pre highC eventsPre events eventsF i +
        unitK t pre highC eventsPre events eventsF i) +
      (bandC pre highC i + bandR (eventsF ++ events) i + bandX fin highC i + slashR t i))
    (hCr : Cr ≤ propN tailC highC i + depPre eventsC i + whistC tailC highC i +
      syncCr eventsC i + consAmt eventsC i)
    (hcredC : credC pre highC i ≤ credC tailC highC i)
    (hcredN : credC pre highC i ≤ propN tailC highC i + depPre eventsC i + consAmt eventsC i)
    (hwhist : whistC pre highC i ≤ whistC tailC highC i)
    (hsync : syncCr eventsPre i ≤ syncCr eventsC i)
    (hband : bandC pre highC i ≤ bandC tailC highC i)
    (kept : t.keptArm i = true) :
    X ≤ whistleEnv t pulled anc fin i +
      whistleSlack t tailC rrun highC high eventsC eventsF events fin i := by
  have incPos := h.bands.1
  have key : 11 * min t.depth t.depthFin * (t.perIncrement *
      (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum) <
      WEIGHT_DENOMINATOR.toNat * preset.EFFECTIVE_BALANCE_INCREMENT.toNat := by
    subst ht
    exact key_of_kept h i _ (Nat.min_le_left _ _) kept
  have hunit : t.unitGain = t.depth * (t.perIncrement *
      (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum / WEIGHT_DENOMINATOR.toNat + 2) := by
    subst ht
    rfl
  have hW : 11 * slashW t i < 10 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat := by
    subst ht
    have hWdb := slashW_add_downwardBand_le h i
    have := h.facts.bandLow
    omega
  have envLe : balanceAt pulled i + t.rise i + slashR t i ≤ whistleEnv t pulled anc fin i := by
    unfold whistleEnv slashR
    split_ifs <;> omega
  have fK : flowK t pre highC eventsPre events eventsF i =
      flowGain t pre highC eventsPre events eventsF i := by
    simp [flowK, kept]
  have gain := flow_gain_slack (I := preset.EFFECTIVE_BALANCE_INCREMENT.toNat)
    (WD := WEIGHT_DENOMINATOR.toNat) (F := (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum)
    (P := t.perIncrement) (D := min t.depth t.depthFin)
    (Z0 := credC pre highC i + whistC pre highC i + syncCr eventsPre i + syncD events i +
      syncD eventsF i) (W := slashW t i) (U := t.unitGain) incPos key hW
    (by rw [hunit]; exact Nat.mul_le_mul_right _ (min_le_left _ _))
  have gainEq : flowGain t pre highC eventsPre events eventsF i =
      min t.depth t.depthFin * (11 * (credC pre highC i + whistC pre highC i +
        syncCr eventsPre i + syncD events i + syncD eventsF i + slashW t i) /
          (10 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat) * t.perIncrement *
            (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum / WEIGHT_DENOMINATOR.toNat) := by
    unfold flowGain flowCredit
    rfl
  have unitLe : unitK t pre highC eventsPre events eventsF i ≤
      unitK t tailC highC eventsC events eventsF i := by
    unfold unitK flowCredit
    split_ifs with p q
    · exact Nat.le_refl _
    · omega
    · exact Nat.zero_le _
    · exact Nat.le_refl _
  unfold whistleSlack whistleSlackBase
  rw [fK, gainEq] at close
  omega

/-- The key that a step slashes is an index.

The events of C's run are those of its prefix first.

Each deposit of the prefix replay finds the key unslashed or gives it no credit. -/
private theorem prefix_prologue (h : Setting config checks g split fin pulled anc counted V)
    {a b : ForkedBeaconState preset} (pre : Run config checks ⟨fork, split⟩ a)
    (step : Step config checks a b) (post : Run config checks b ⟨fork, counted⟩) (highC : ℕ)
    {eventsC : List (BalanceEvent preset)}
    (replayedC : ((pre.snoc step).append post).balanceEvents highC = .ok eventsC) (i : ℕ)
    (flag : (!(a.state.validators.data[i]?.map (·.slashed)).getD false &&
      (b.state.validators.data[i]?.map (·.slashed)).getD false) = true) :
    ∃ v : ValidatorIndex, v.toNat = i ∧
      ∃ e1 t : List (BalanceEvent preset), pre.balanceEvents highC = .ok e1 ∧
        eventsC = e1 ++ t ∧ ∀ e ∈ e1, e.source = .deposits →
          keyCredit i e = 0 ∨ ¬ slashedFlagAt e.before.state i = some true := by
  have bEarly : b.fork < .glamsterdam :=
    Nat.lt_of_le_of_lt (fork_le_of_chainSteps post.chainSteps) h.early
  have aEarly : a.fork < .glamsterdam := Nat.lt_of_le_of_lt step.chainStep.fork_le bEarly
  -- The key is in the registry at `b`, so its position is an index.
  have inside : i < b.state.validators.data.size := by
    cases found : b.state.validators.data[i]? with
    | none => simp [found] at flag
    | some _ => exact (Array.getElem?_eq_some_iff.mp found).1
  obtain ⟨v, rfl⟩ := Uint64.exists_toNat_eq
    (inside.trans (BeaconState.validators_size_lt_of_lt_glamsterdam bEarly b.state))
  rw [snoc_append_eq] at replayedC
  obtain ⟨e1, replayed1, t, rfl⟩ := Run.balanceEvents_prefix pre _ highC _ replayedC
  exact ⟨v, rfl, e1, t, replayed1, rfl, prefix_deposits_clean h pre aEarly highC replayed1 v
    (by simpa using (Bool.and_eq_true_iff.mp flag).1)⟩

/-- The credits of C's run before a key's slashing are within the credit terms of `whistleSlack`.

They are the key's block credits from rewards and its consolidation and deposit credits.

They are those up to the step.

The proposer credits are within `propN` of the whole run.

The deposits before the step are those of `depPre`, since the key is unslashed before it.

The consolidation credits are within `consAmt`. -/
private theorem credC_prefix_le (h : Setting config checks g split fin pulled anc counted V)
    {a b : ForkedBeaconState preset} (pre : Run config checks ⟨fork, split⟩ a)
    (step : Step config checks a b) (post : Run config checks b ⟨fork, counted⟩) (highC : ℕ)
    {eventsC : List (BalanceEvent preset)}
    (replayedC : ((pre.snoc step).append post).balanceEvents highC = .ok eventsC) (i : ℕ)
    (flag : (!(a.state.validators.data[i]?.map (·.slashed)).getD false &&
      (b.state.validators.data[i]?.map (·.slashed)).getD false) = true) :
    credC pre highC i ≤
      propN ((pre.snoc step).append post) highC i + depPre eventsC i + consAmt eventsC i := by
  obtain ⟨v, rfl, e1, t, replayed1, rfl, clean⟩ :=
    prefix_prologue h pre step post highC replayedC i flag
  have whole := snoc_append_eq pre step post
  rw [whole] at replayedC ⊢
  have depPreOk := deposits_le_depPre e1 v.toNat clean
  have deps := scan_le_events (fun _ => false) (fun s => decide (s = .deposits)) (· = .deposits)
    (by intro s; simp) pre highC v replayed1
  have consEvents := scan_le_events (fun s => decide (s = .consolidations))
    (fun s => decide (s = .consolidations)) (· = .consolidations) (by intro s; simp)
    (pre.append ((Run.nil.snoc step).append post)) highC v replayedC
  have propScan := creditScan_append (fun s => decide (s = .rewards)) (fun _ => false) v.toNat highC
    pre ((Run.nil.snoc step).append post)
  have consScan := creditScan_append (fun s => decide (s = .consolidations))
    (fun s => decide (s = .consolidations)) v.toNat highC pre ((Run.nil.snoc step).append post)
  have split1 := credC_split pre highC v.toNat
  have split2 := credN_split pre highC v.toNat
  have depMono : depPre e1 v.toNat ≤ depPre (e1 ++ t) v.toNat := by
    unfold depPre
    simp only [List.filter_append, List.map_append, List.sum_append]
    omega
  beta_reduce at deps consEvents
  unfold propN at split2 ⊢
  unfold consAmt
  omega

/-- The credits of a key over the run before a step are at most those over the whole run. -/
private theorem creditScan_prefix_le (blockP slotP : BalanceSource → Bool) (v high : ℕ)
    {x a b c : ForkedBeaconState preset} (pre : Run config checks x a)
    (step : Step config checks a b) (post : Run config checks b c) :
    (creditScan blockP slotP v high pre) ≤
      (creditScan blockP slotP v high ((pre.snoc step).append post)) := by
  rw [creditScan_append, creditScan_snoc]
  split <;> omega

/-- The credits, whistleblower credits and credit band of a prefix are within the whole run's. -/
private theorem prefix_credits_mono {a b : ForkedBeaconState preset}
    (pre : Run config checks ⟨fork, split⟩ a) (step : Step config checks a b)
    (post : Run config checks b ⟨fork, counted⟩) (highC i : ℕ) :
    credC pre highC i ≤ credC ((pre.snoc step).append post) highC i ∧
      whistC pre highC i ≤ whistC ((pre.snoc step).append post) highC i ∧
      bandC pre highC i ≤ bandC ((pre.snoc step).append post) highC i := by
  have gross := creditScan_prefix_le
    (fun s => decide (s = .rewards ∨ s = .slashings ∨ s = .sync)) (fun _ => false) i highC pre step
    post
  have deposits := creditScan_prefix_le (fun _ => false) (fun s => decide (s = .deposits)) i highC
    pre step post
  refine ⟨creditScan_prefix_le _ _ i highC pre step post,
    creditScan_prefix_le _ _ i highC pre step post, ?_⟩
  unfold bandC grossScan
  split_ifs <;> omega

/-- The sync credits of the events of a prefix of C's run are within those of the whole run.

The replay of the prefix at `highC` is a prefix of the replay of the run. -/
private theorem syncCr_prefix_le {a b : ForkedBeaconState preset}
    (pre : Run config checks ⟨fork, split⟩ a) (step : Step config checks a b)
    (post : Run config checks b ⟨fork, counted⟩) (highC : ℕ)
    {eventsPre eventsC : List (BalanceEvent preset)}
    (replayedPre : pre.balanceEvents highC = .ok eventsPre)
    (replayedC : ((pre.snoc step).append post).balanceEvents highC = .ok eventsC) (i : ℕ) :
    syncCr eventsPre i ≤ syncCr eventsC i := by
  obtain ⟨eventsStep, replayedStep, prefixStep⟩ :=
    (pre.snoc step).balanceEvents_prefix post highC eventsC replayedC
  obtain ⟨events, replayed, prefixPre⟩ :=
    pre.balanceEvents_prefix (Run.nil.snoc step) highC eventsStep (by exact replayedStep)
  obtain rfl : events = eventsPre := Except.ok.inj (replayed.symm.trans replayedPre)
  obtain ⟨rest, restEq⟩ := prefixPre.trans prefixStep
  rw [← restEq]
  unfold syncCr
  simp [List.map_append, List.sum_append]

/-- A slashing penalty and the gain on it over the window fit below one increment.

The penalty leaves a downward band, which is at least a quarter of the increment.

The penalty alone gains the unit gain, as it is under ten elevenths of an increment.

The unit gain is a gain per increment over the window, and two more gwei for each epoch.

`key` bounds the gain per increment by an eleventh of an increment. -/
private theorem slash_gain_small {I db WD F P D W : ℕ} (hI : 0 < I)
    (key : 11 * D * (P * F) < WD * I) (band : I ≤ 4 * db) (slashBand : W + db ≤ I)
    (window : 88 * D ≤ 3 * I) :
    W + (D * (11 * W / (10 * I) * P * F / WD) +
      if 0 < W then D * (P * F / WD + 2) else 0) < I := by
  have zero : 11 * W / (10 * I) = 0 := Nat.div_eq_of_lt (by omega)
  have small : 11 * (D * (P * F / WD)) < I := by
    have h1 := Nat.mul_le_mul_left (11 * D) (Nat.mul_div_le (P * F) WD)
    have h2 : WD * (11 * (D * (P * F / WD))) < WD * I :=
      calc WD * (11 * (D * (P * F / WD))) = 11 * D * (WD * (P * F / WD)) := by ring
        _ ≤ 11 * D * (P * F) := h1
        _ < WD * I := key
    exact Nat.lt_of_mul_lt_mul_left h2
  rw [zero]
  split_ifs
  · rw [Nat.mul_add]
    simp only [Nat.zero_mul, Nat.zero_div, Nat.mul_zero, Nat.zero_add]
    omega
  · simp only [Nat.zero_mul, Nat.zero_div, Nat.mul_zero, Nat.zero_add]
    omega

/-- A key that the split holds, unslashed, is not withdrawable at R's next epoch.

An unslashed key has its withdrawable epoch at its exit plus the delay, or both unset.

Its exit is late at R, which `late` states.

A key that R slashes after the split has its withdrawable epoch a slashings vector past the split.

The window of the guard is under half a vector. -/
private theorem voter_not_withdrawn (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩)
    (v : ValidatorIndex)
    (unslashed : (split.validators.data[v.toNat]?.map (·.slashed)).getD false = false)
    (late : ∀ w, pulled.validators.data[v.toNat]? = some w → w.slashed = false →
      (getCurrentEpoch pulled).toNat + 1 <
        w.exitEpoch.toNat + config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    (inSplit : v.toNat < split.validators.data.size) :
    (pinTerms config pulled anc fin).withdrawnRB v.toNat = false := by
  classical
  obtain ⟨shared⟩ := h.toFin
  have sizeSplit := registryGrows_of_chainSteps tail.chainSteps
  obtain ⟨uS, foundS⟩ : ∃ uS, split.validators.data[v.toNat]? = some uS :=
    ⟨_, Array.getElem?_eq_getElem inSplit⟩
  obtain ⟨wP, foundP⟩ : ∃ wP, pulled.validators.data[v.toNat]? = some wP :=
    ⟨_, Array.getElem?_eq_getElem (Nat.lt_of_lt_of_le inSplit sizeSplit)⟩
  have cleanS : uS.slashed = false := by simpa [foundS] using unslashed
  have half := depthFin_lt_half h
  have finSplit : (getCurrentEpoch fin).toNat ≤ (getCurrentEpoch split).toNat :=
    epoch_le_of_slot_le fin.slot split.slot (Run.slot_le fromFin)
  have far := getCurrentEpoch_succ_lt_farFuture h.twoSlots pulled
  have beyond : (getCurrentEpoch pulled).toNat + 1 < wP.withdrawableEpoch.toNat := by
    by_cases slashedP : wP.slashed = true
    · have newly := (tail.newly_slashed_withdrawableEpoch h.caps.activation h.caps.compounding
        h.early h.delay v.toNat uS wP foundS foundP cleanS slashedP).2
      have newly' : (getCurrentEpoch split).toNat + preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat ≤
          wP.withdrawableEpoch.toNat := newly
      omega
    · have cleanP : wP.slashed = false := by simpa using slashedP
      have late := late wP foundP cleanP
      rcases Run.withdrawable_eq_exit_delay (shared.append (fromFin.append tail)) h.genesis
        v.toNat wP foundP cleanP with ⟨exitFar, withdrawFar⟩ | eq
      · have := congrArg UInt64.toNat withdrawFar
        omega
      · omega
  show ((pulled.validators.data[v.toNat]?).any fun w =>
    decide (w.withdrawableEpoch.toNat ≤ (getCurrentEpoch pulled).toNat + 1)) = false
  rw [foundP]
  simpa using beyond

/-- The credit stake of a key on a low rate, rounded down to increments, is paid by the slack.

The stake is its credits, the gain on them and the gain of its base stake.

On a low rate, the base gain is below an increment, so it rounds away.

With bands, an increment of slack pays what is left of the gain over the flows.

With none, there are no credits.

Then a slashing's penalty is below an increment, and the stake is below two.

A stake below two increments rounds to one at most, which the slashing's increment pays. -/
private theorem y_floor_le (I WD F P D Df q Cr Ds DsF W gc S U Fl : ℕ)
    (key : 11 * D * (P * F) < WD * I) (hDf : D ≤ Df)
    (lowG : Df * ((11 * q + 9) / 10 + 3) < I)
    (hform : gc = D * (11 * ((Cr + Ds + DsF) + W + D * q + D) / (10 * I) * P * F / WD))
    (cases : (I ≤ U + 1 ∧ Cr + Fl ≤ S ∧
        gc + (D * q + D) ≤ Fl + Df * ((11 * q + 9) / 10 + 3)) ∨
      (Cr = 0 ∧ Ds = 0 ∧ DsF = 0 ∧ W < I ∧ (0 < W → I ≤ S + U))) :
    Cr + (gc + (D * q + D)) - (Cr + (gc + (D * q + D))) % I ≤ S + U := by
  have hI : 0 < I := by
    rcases Nat.eq_zero_or_pos I with h | h
    · subst h; simp at key
    · exact h
  rcases cases with ⟨hU, hCr, hgc⟩ | ⟨hCr, hDs, hDsF, hW, hS⟩
  · refine le_trans (Nat.sub_le _ _) ?_
    omega
  · subst hCr hDs hDsF
    rcases Nat.eq_zero_or_pos D with hD | hD
    · subst hD
      have : gc = 0 := by rw [hform]; simp
      subst this
      simp
    · have hG : 10 * ((11 * q + 9) / 10) + 9 ≥ 11 * q + 9 := by omega
      have h1 : D * (11 * q + 30) ≤ 10 * (Df * ((11 * q + 9) / 10 + 3)) := by
        calc D * (11 * q + 30) ≤ Df * (11 * q + 30) := Nat.mul_le_mul_right _ hDf
          _ ≤ Df * (10 * ((11 * q + 9) / 10 + 3)) :=
            Nat.mul_le_mul_left _ (by omega)
          _ = 10 * (Df * ((11 * q + 9) / 10 + 3)) := by ring
      have hX : 11 * (D * q + D) < 10 * I := by
        have : 11 * (D * q + D) < D * (11 * q + 30) := by
          have : D * (11 * q + 30) = 11 * (D * q + D) + 19 * D := by ring
          omega
        omega
      rcases Nat.eq_zero_or_pos W with hW0 | hW0
      · subst hW0
        have zero : 11 * (0 + 0 + 0 + 0 + D * q + D) / (10 * I) = 0 :=
          Nat.div_eq_of_lt (by omega)
        have g0 : gc = 0 := by rw [hform, zero]; simp
        subst g0
        have : D * q + D < I := by omega
        simp only [Nat.zero_add]
        rw [Nat.mod_eq_of_lt this]
        omega
      · have quot : 11 * (0 + 0 + 0 + W + D * q + D) / (10 * I) ≤ 2 := by
          have : 11 * (0 + 0 + 0 + W + D * q + D) < 3 * (10 * I) := by omega
          have := (Nat.div_lt_iff_lt_mul (by omega)).2 this
          omega
        have gcle : gc ≤ D * (2 * P * F / WD) := by
          rw [hform]
          refine Nat.mul_le_mul_left _ (Nat.div_le_div_right ?_)
          exact Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ quot)
        have gclt : 11 * gc < 2 * I := by
          have h2 : D * (2 * P * F / WD) * WD ≤ D * (2 * P * F) := by
            calc D * (2 * P * F / WD) * WD = D * (WD * (2 * P * F / WD)) := by ring
              _ ≤ D * (2 * P * F) := Nat.mul_le_mul_left _ (Nat.mul_div_le _ _)
          have h3 : WD * (11 * gc) < WD * (2 * I) := by
            calc WD * (11 * gc) ≤ WD * (11 * (D * (2 * P * F / WD))) := by
                  exact Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ gcle)
              _ = 11 * (D * (2 * P * F / WD) * WD) := by ring
              _ ≤ 11 * (D * (2 * P * F)) := Nat.mul_le_mul_left _ h2
              _ = 2 * (11 * D * (P * F)) := by ring
              _ < 2 * (WD * I) := by omega
              _ = WD * (2 * I) := by ring
          exact Nat.lt_of_mul_lt_mul_left h3
        have hY : 0 + (gc + (D * q + D)) < 2 * I := by omega
        have hdiv : (0 + (gc + (D * q + D))) / I ≤ 1 := by
          have := (Nat.div_lt_iff_lt_mul hI).2 (by omega : 0 + (gc + (D * q + D)) < 2 * I)
          omega
        have hmod := Nat.div_add_mod (0 + (gc + (D * q + D))) I
        have : I * ((0 + (gc + (D * q + D))) / I) ≤ I * 1 := Nat.mul_le_mul_left _ hdiv
        have := hS hW0
        omega

/-- The closing of a key, with the credits `Cr` that it holds, gives `keyCeiling`.

`Cr` is at most the credits of C's run, and the sync credits are at most `syncF`. -/
private theorem keyCeiling_of_close (anc : BeaconState preset fork)
    {ending : BeaconState preset fork}
    (run : Run config checks ⟨fork, fin⟩ ⟨fork, pulled⟩)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, ending⟩) (highC : ℕ)
    (eventsC events eventsF : List (BalanceEvent preset)) (v Cr : ℕ)
    (close : balanceAt ending v ≤ balanceAt pulled v + (pinTerms config pulled anc fin).rise v +
      (syncD eventsF v + syncD events v + Cr + inducedR (pinTerms config pulled anc fin) run v +
        flowK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF v +
        unitK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF v) +
      (bandC tailC highC v + bandR (eventsF ++ events) v + bandX fin highC v +
        slashR (pinTerms config pulled anc fin) v))
    (creditsLe : Cr ≤ credC tailC highC v + whistC tailC highC v +
      (eventsC.map (syncCredit v)).sum) :
    keyCeiling anc run tailC highC eventsC events eventsF v := by
  have fSyncE : syncD events v ≤ syncF events v := by
    rw [syncF_eq]; unfold syncD; omega
  have fSyncC : (eventsC.map (syncCredit v)).sum ≤ syncF eventsC v := by
    rw [syncF_eq]; omega
  unfold keyCeiling keyExtra
  omega

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The closing of the per-key core of the rise, for a key on its kept arm with any cap.

Its balance on C's branch is bounded by `Bc`, and the effective balance by `stay`.

`Bc` adds up R's balance and the leak at the largest effective balance.

It adds the debits and slack on R's runs, and the credits and gains of C's run.

R's rise closes it, up to the flows and the bands that pay the rounding.

The cap enters only through `stay` and `cappedY`, which the cap arms prove.

C's run may end at any state, so a prefix of it closes the same way.

The start of the effective balance's ceiling is any state's, bounded as `rise_close` reads it.

It concludes with the flows and bands in the form of `keyExtra`, without the credits of `credC`.

`keyCeiling_of_close` gives `keyCeiling` from it, and the credits `Cr` that it holds.

`cappedY` is the premise `capped` of `rise_close`, for a key on a low rate.

It says the effective balance at C is at most the cap that `capFor` reads, and the rounded stake.

A key off the low rate reads the largest cap. -/
private theorem key_close (h : Setting config checks g split fin pulled anc counted V)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    {ending : BeaconState preset fork}
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, ending⟩) (highC : ℕ)
    {eventsC events eventsF : List (BalanceEvent preset)} (v : ValidatorIndex)
    (kept : (pinTerms config pulled anc fin).keptArm v.toNat = true)
    (notWithdrawn : (pinTerms config pulled anc fin).withdrawnRB v.toNat = false) (P : ℕ)
    (hP : P = ((getBaseRewardPerIncrement preset
      (if 18 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤
          ((getTotalActiveBalance pulled).toOption.getD 0).toNat then
        (getTotalActiveBalance pulled).toOption.getD 0 / 4
      else preset.EFFECTIVE_BALANCE_INCREMENT / 5)).toOption.getD 0).toNat)
    (Df D q gc Cr M Bc capHigh : ℕ)
    (hDf : Df = (getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat)
    (hD : D = min (pinTerms config pulled anc fin).depth Df)
    (hq : q = (pinTerms config pulled anc fin).gainRate v.toNat)
    (hM : M = ((fromFin.append tail).balancePath.map fun z => effectiveAt z v.toNat).foldl max 0)
    (hform : gc = D * (11 * ((Cr + (events.map (syncDebit v.toNat)).sum +
          (eventsF.map (syncDebit v.toNat)).sum) +
        slashW (pinTerms config pulled anc fin) v.toNat + D * q + D) /
        (10 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat) * P *
      (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum / WEIGHT_DENOMINATOR.toNat))
    (hBc : Bc = actualBalanceAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat +
        (Df * (pinTerms config pulled anc fin).leakAt M v.toNat +
          (PinTerms.dueAmount fin (Nat.le_trans (by decide) h.fulu) v.toNat
              ((getCurrentEpoch pulled).toNat + 1) -
            PinTerms.dueAmount pulled (Nat.le_trans (by decide) h.fulu) v.toNat
              ((getCurrentEpoch pulled).toNat + 1))) +
      ((eventsF.map (syncDebit v.toNat)).sum + (events.map (syncDebit v.toNat)).sum +
        slashW (pinTerms config pulled anc fin) v.toNat) + (Cr + (gc + (D * q + D))))
    (maxLe : M ≤ (pinTerms config pulled anc fin).ebUp v.toNat +
      preset.EFFECTIVE_BALANCE_INCREMENT.toNat *
        ((syncD eventsF v.toNat + syncD events v.toNat +
            slashW (pinTerms config pulled anc fin) v.toNat) /
          preset.EFFECTIVE_BALANCE_INCREMENT.toNat))
    (start : ℕ)
    (startLe : ∀ S : ℕ, Bc ≤ (pinTerms config pulled anc fin).high v.toNat + S →
      start ≤ max (balanceAt fin v.toNat)
        (((pinTerms config pulled anc fin).high v.toNat + S) -
          ((pinTerms config pulled anc fin).high v.toNat + S) %
            preset.EFFECTIVE_BALANCE_INCREMENT.toNat))
    (stay : balanceAt ending v.toNat = balanceAt pulled v.toNat ∨
      (balanceAt ending v.toNat ≤ start ∧ ∀ S U : ℕ,
        Bc ≤ (pinTerms config pulled anc fin).high v.toNat + S →
        (S = 0 ∨ preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤ U + 1 ∨
          (S < preset.EFFECTIVE_BALANCE_INCREMENT.toNat ∧
            preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤ S + U)) →
        start ≤ (pinTerms config pulled anc fin).capFor v.toNat + S + U ∧
          start ≤ ((pinTerms config pulled anc fin).high v.toNat +
            preset.downwardBand) - ((pinTerms config pulled anc fin).high v.toNat +
            preset.downwardBand) % preset.EFFECTIVE_BALANCE_INCREMENT.toNat + S + U) ∨
      (balanceAt ending v.toNat ≤ Bc + preset.downwardBand ∧
        balanceAt ending v.toNat ≤ max start
          (min (Bc - Bc % preset.EFFECTIVE_BALANCE_INCREMENT.toNat) capHigh)))
    (cappedY : Df * ((11 * q + 9) / 10 + 3) < preset.EFFECTIVE_BALANCE_INCREMENT.toNat →
      balanceAt ending v.toNat ≤ (pinTerms config pulled anc fin).capFor v.toNat +
        (Cr + (gc + (D * q + D)) - (Cr + (gc + (D * q + D))) %
          preset.EFFECTIVE_BALANCE_INCREMENT.toNat))
    (creditsLe : Cr ≤ credC tailC highC v.toNat + whistC tailC highC v.toNat +
      (eventsC.map (syncCredit v.toNat)).sum)
    (noCredit : bandC tailC highC v.toNat = 0 → bandX fin highC v.toNat = 0 → Cr = 0) :
    balanceAt ending v.toNat ≤ balanceAt pulled v.toNat +
      (pinTerms config pulled anc fin).rise v.toNat +
      (syncD eventsF v.toNat + syncD events v.toNat + Cr +
        inducedR (pinTerms config pulled anc fin) (fromFin.append tail) v.toNat +
        flowK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF v.toNat +
        unitK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF v.toNat) +
      (bandC tailC highC v.toNat + bandR (eventsF ++ events) v.toNat + bandX fin highC v.toNat +
        slashR (pinTerms config pulled anc fin) v.toNat) := by
  classical
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  -- the gain of the flows, and of the base stake, is the flow gain with a unit and the base gain
  have hDle : D ≤ (pinTerms config pulled anc fin).depth := hD ▸ min_le_left _ _
  obtain ⟨toFin⟩ := h.toFin
  have hperIncrement : (pinTerms config pulled anc fin).perIncrement = P := by
    rw [hP]
    rfl
  have key := key_of_kept h v.toNat D hDle kept
  rw [hperIncrement] at key
  have hunit : (pinTerms config pulled anc fin).unitGain =
      (pinTerms config pulled anc fin).depth * (P * (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum /
        WEIGHT_DENOMINATOR.toNat + 2) := by
    rw [← hperIncrement]
    rfl
  have hdf : (pinTerms config pulled anc fin).depthFin = Df := hDf.symm
  have hDF : D ≤ Df := hD ▸ min_le_right _ _
  obtain ⟨Zk, hZk⟩ : ∃ Zk, Zk = Cr + (events.map (syncDebit v.toNat)).sum +
      (eventsF.map (syncDebit v.toNat)).sum + slashW (pinTerms config pulled anc fin) v.toNat :=
    ⟨_, rfl⟩
  have gcEq : gc = D * (11 * (Zk + (D * q + D)) / (10 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat) *
      P * (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum / WEIGHT_DENOMINATOR.toNat) := by
    rw [hform, hZk, Nat.add_assoc _ (D * q) D]
  have gainBound : gc + (D * q + D) ≤
      flowGain (pinTerms config pulled anc fin) tailC highC eventsC events eventsF v.toNat +
        unitK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF v.toNat +
        Df * ((11 * q + 9) / 10 + 3) := by
    have split := flow_gain_split preset.EFFECTIVE_BALANCE_INCREMENT.toNat
      WEIGHT_DENOMINATOR.toNat (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum P D
      (min (pinTerms config pulled anc fin).depth (pinTerms config pulled anc fin).depthFin) Df q Zk
      (flowCredit (pinTerms config pulled anc fin) tailC highC eventsC events eventsF v.toNat)
      key (le_of_eq (by rw [hD, hdf])) hDF
      (by rw [hZk]; unfold flowCredit syncCr syncD; omega)
    unfold flowGain unitK
    rw [hunit, hperIncrement, gcEq]
    refine le_trans split (Nat.add_le_add_right (Nat.add_le_add_left ?_ _) _)
    split_ifs
    · exact Nat.mul_le_mul_right _ (min_le_left _ _)
    · exact Nat.le_refl _
  obtain ⟨Fl, hFl⟩ : ∃ Fl, Fl =
      flowGain (pinTerms config pulled anc fin) tailC highC eventsC events eventsF v.toNat +
        unitK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF v.toNat :=
    ⟨_, rfl⟩
  -- R's rise closes the balance ceiling of C's run, up to the flows and their slack
  obtain ⟨H, hH⟩ : ∃ H, H = (pinTerms config pulled anc fin).high v.toNat :=
    ⟨_, rfl⟩
  have induced : Df * (pinTerms config pulled anc fin).leakAt M v.toNat ≤
      Df * (pinTerms config pulled anc fin).leak v.toNat +
        inducedR (pinTerms config pulled anc fin) (fromFin.append tail) v.toNat := by
    rw [← hdf, hM]
    exact leakAt_foldl_le config pulled anc fin (fromFin.append tail) v.toNat notWithdrawn
  have hHeq : H = actualBalanceAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat +
      Df * ((11 * q + 9) / 10 + 3 + (pinTerms config pulled anc fin).leak v.toNat) +
        (PinTerms.dueAmount fin electra v.toNat ((getCurrentEpoch pulled).toNat + 1) -
          PinTerms.dueAmount pulled electra v.toNat ((getCurrentEpoch pulled).toNat + 1)) := by
    rw [hH, hq, hDf]
    exact high_eq config pulled anc fin electra v.toNat
  have gap : Bc ≤ H + (syncD eventsF v.toNat + syncD events v.toNat +
      slashW (pinTerms config pulled anc fin) v.toNat + Cr +
      inducedR (pinTerms config pulled anc fin) (fromFin.append tail) v.toNat +
      (flowGain (pinTerms config pulled anc fin) tailC highC eventsC events eventsF v.toNat +
        unitK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF v.toNat)) := by
    unfold syncD
    rw [hBc, hHeq, Nat.mul_add (Df) _ _]
    omega
  -- the closing: R's rise, the flows, and the bands that pay the rounding
  have alignedC : balanceAt ending v.toNat % preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0 :=
    FloorTrace.effective_aligned (toFin.append (fromFin.append tailC)) h.genesis h.aligned v.toNat
  have atMax : balanceAt ending v.toNat ≤ preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat :=
    PinSeatDebits.effectiveAt_le_capMax (toFin.append (fromFin.append tailC)) h.genesis h.caps
      h.early
      v.toNat
  -- the cap that `capFor` reads is the largest one off the low rate, and otherwise `cappedY`'s
  have capped : ∀ S U : ℕ, ((preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤ U + 1 ∧ Cr + Fl ≤ S ∧
        gc + (D * q + D) ≤ Fl + Df * ((11 * q + 9) / 10 + 3)) ∨
      (Cr = 0 ∧ (events.map (syncDebit v.toNat)).sum = 0 ∧
        (eventsF.map (syncDebit v.toNat)).sum = 0 ∧
        slashW (pinTerms config pulled anc fin) v.toNat <
          preset.EFFECTIVE_BALANCE_INCREMENT.toNat ∧
        (0 < slashW (pinTerms config pulled anc fin) v.toNat →
          preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤ S + U))) →
      balanceAt ending v.toNat ≤
        (pinTerms config pulled anc fin).capFor v.toNat + S + U := by
    intro S U cases
    by_cases lowG : Df * ((11 * q + 9) / 10 + 3) < preset.EFFECTIVE_BALANCE_INCREMENT.toNat
    · have y := y_floor_le preset.EFFECTIVE_BALANCE_INCREMENT.toNat WEIGHT_DENOMINATOR.toNat
        (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum P D Df q Cr
        (events.map (syncDebit v.toNat)).sum (eventsF.map (syncDebit v.toNat)).sum
        (slashW (pinTerms config pulled anc fin) v.toNat) gc S U Fl key hDF lowG hform cases
      have := cappedY lowG
      omega
    · have notLow : (pinTerms config pulled anc fin).capFor v.toNat =
          preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat := by
        rw [capFor_eq]
        refine ite_eq_right_iff.mpr fun low => ?_
        simp only [Bool.and_eq_true, decide_eq_true_eq] at low
        have lt := low.1
        rw [hdf, ← hq] at lt
        exact absurd lt lowG
      omega
  have close : ∀ S U : ℕ, Bc ≤ H + S → (S = 0 ∨ preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤ U + 1 ∨
      (S < preset.EFFECTIVE_BALANCE_INCREMENT.toNat ∧
        preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤ S + U)) → balanceAt ending v.toNat ≤
          (pinTerms config pulled anc fin).capFor v.toNat + S + U →
      balanceAt ending v.toNat ≤
        balanceAt pulled v.toNat + (pinTerms config pulled anc fin).rise v.toNat + S + U :=
    fun S U ceiling slack cap => rise_close config pulled anc fin v.toNat hH h.bands.1 kept
      alignedC (by subst hH; exact startLe S ceiling)
      (stay.imp_right fun st => st.elim
        (fun ⟨atStart, bounds⟩ => Or.inl ⟨atStart, by subst hH; exact bounds S U ceiling slack⟩)
        Or.inr) cap ceiling slack
  have fK : flowK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF v.toNat =
      flowGain (pinTerms config pulled anc fin) tailC highC eventsC events eventsF v.toNat := by
    simp [flowK, kept]
  have hWdb := slashW_add_downwardBand_le h v.toNat
  have fW : slashW (pinTerms config pulled anc fin) v.toNat ≤
      slashR (pinTerms config pulled anc fin) v.toNat := by
    have := hWdb
    unfold slashW at this ⊢
    unfold slashR
    split_ifs at this ⊢ <;> omega
  have incPos : 1 < preset.EFFECTIVE_BALANCE_INCREMENT.toNat := by
    have := h.facts.incrementSize
    omega
  have bandsOne : 0 < bandC tailC highC v.toNat ∨ 0 < bandR (eventsF ++ events) v.toNat ∨
      0 < bandX fin highC v.toNat → preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤
        bandC tailC highC v.toNat + bandR (eventsF ++ events) v.toNat +
          bandX fin highC v.toNat + 1 := by
    have up := h.bands.2
    rintro (pos | pos | pos)
    · unfold bandC at pos ⊢
      split_ifs at pos ⊢ <;> omega
    · unfold bandR at pos ⊢
      split_ifs at pos ⊢ <;> omega
    · unfold bandX at pos ⊢
      have dpos : 0 < dueAt fin highC {UInt64.ofNat v.toNat} :=
        Nat.pos_of_ne_zero fun z => by rw [z, Nat.mul_zero] at pos; exact Nat.lt_irrefl _ pos
      have := Nat.le_mul_of_pos_right preset.upwardBand dpos
      omega
  by_cases bands : 0 < bandC tailC highC v.toNat ∨ 0 < bandR (eventsF ++ events) v.toNat ∨
      0 < bandX fin highC v.toNat
  · have := close _ (bandC tailC highC v.toNat + bandR (eventsF ++ events) v.toNat +
      bandX fin highC v.toNat + (slashR (pinTerms config pulled anc fin) v.toNat -
        slashW (pinTerms config pulled anc fin) v.toNat))
      gap
      (Or.inr (Or.inl (by have := bandsOne bands; omega)))
      (capped _ _ (Or.inl ⟨by have := bandsOne bands; omega, by omega, by omega⟩))
    omega
  · simp only [not_or, not_lt, Nat.le_zero] at bands
    obtain ⟨hbC, hbR, hbX⟩ := bands
    have up := h.bands.2
    have sD0 : (eventsF.map (syncDebit v.toNat)).sum +
        (events.map (syncDebit v.toNat)).sum = 0 := by
      have := bandR_eq (eventsF ++ events) v.toNat
      simp only [List.map_append, List.sum_append] at this
      split_ifs at this <;> omega
    have Cr0 : Cr = 0 := noCredit hbC hbX
    have hW : slashW (pinTerms config pulled anc fin) v.toNat <
        preset.EFFECTIVE_BALANCE_INCREMENT.toNat := by
      have := h.facts.bandLow
      omega
    have M0 : M ≤ (pinTerms config pulled anc fin).ebUp v.toNat := by
      have e := maxLe
      rw [Nat.div_eq_of_lt (show syncD eventsF v.toNat + syncD events v.toNat +
        slashW (pinTerms config pulled anc fin) v.toNat < preset.EFFECTIVE_BALANCE_INCREMENT.toNat
            by unfold syncD; omega), Nat.mul_zero, Nat.add_zero] at e
      exact e
    have ind0 : inducedR (pinTerms config pulled anc fin) (fromFin.append tail) v.toNat = 0 := by
      rw [inducedR_of_not_withdrawn _ _ _ notWithdrawn]
      rw [← hM, Nat.sub_eq_zero_of_le (leakAt_mono config pulled anc fin v.toNat M0), Nat.mul_zero]
    have hZkW : Zk = slashW (pinTerms config pulled anc fin) v.toNat := by
      rw [hZk]
      omega
    have gainNet := flow_gain_split preset.EFFECTIVE_BALANCE_INCREMENT.toNat
        WEIGHT_DENOMINATOR.toNat (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum P D D Df q Zk Zk key
      (Nat.le_refl _) hDF (Nat.le_refl _)
    rw [hZkW] at gainNet
    obtain ⟨εn, hεn⟩ : ∃ εn, εn =
        D * (11 * slashW (pinTerms config pulled anc fin) v.toNat /
          (10 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat) * P *
          (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum / WEIGHT_DENOMINATOR.toNat) +
        (if 0 < slashW (pinTerms config pulled anc fin) v.toNat then
          D * (P * (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum / WEIGHT_DENOMINATOR.toNat + 2)
          else 0) := ⟨_, rfl⟩
    rw [← hεn] at gainNet
    have small := slash_gain_small h.bands.1 key h.facts.bandLow hWdb (by
      have := depthFin_lt_half h
      have := h.facts.vectorSmall
      omega)
    rw [← hεn] at small
    rw [hZkW] at gcEq
    have ceilII : Bc ≤ H + (slashW (pinTerms config pulled anc fin) v.toNat + εn) := by
      rw [hBc, hHeq, Nat.mul_add Df _ _]
      omega
    have εle : εn ≤ flowGain (pinTerms config pulled anc fin) tailC highC eventsC events eventsF
        v.toNat +
        unitK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF v.toNat := by
      have hWle : slashW (pinTerms config pulled anc fin) v.toNat ≤
          flowCredit (pinTerms config pulled anc fin) tailC highC eventsC events eventsF
            v.toNat := by
        unfold flowCredit
        omega
      have hdf' : min (pinTerms config pulled anc fin).depth
          (pinTerms config pulled anc fin).depthFin = D := by rw [hdf, hD]
      unfold flowGain unitK
      rw [hdf', hperIncrement, hunit, hεn]
      refine Nat.add_le_add (Nat.mul_le_mul_left _ (Nat.div_le_div_right
        (Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ (Nat.div_le_div_right
          (Nat.mul_le_mul_left 11 hWle)))))) ?_
      split_ifs <;> first | exact Nat.zero_le _ | exact Nat.mul_le_mul_right _ hDle | omega
    have hsl : 0 < slashW (pinTerms config pulled anc fin) v.toNat →
        slashR (pinTerms config pulled anc fin) v.toNat =
          preset.EFFECTIVE_BALANCE_INCREMENT.toNat := fun pos => by
      unfold slashW at pos
      unfold slashR
      split_ifs at pos ⊢ <;> omega
    have slack : slashW (pinTerms config pulled anc fin) v.toNat + εn = 0 ∨
        preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤
          (slashR (pinTerms config pulled anc fin) v.toNat -
            slashW (pinTerms config pulled anc fin) v.toNat) + 1 ∨
        (slashW (pinTerms config pulled anc fin) v.toNat + εn <
            preset.EFFECTIVE_BALANCE_INCREMENT.toNat ∧
          preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤
            slashW (pinTerms config pulled anc fin) v.toNat + εn +
              (slashR (pinTerms config pulled anc fin) v.toNat -
                slashW (pinTerms config pulled anc fin) v.toNat)) := by
      by_cases w0 : slashW (pinTerms config pulled anc fin) v.toNat = 0
      · left
        rw [hεn, w0]
        simp
      · right
        right
        have sl := hsl (Nat.pos_of_ne_zero w0)
        exact ⟨small, by omega⟩
    have := close _ _ ceilII slack
      (capped _ _ (Or.inr ⟨Cr0, by omega, by omega, hW, fun pos => by have := hsl pos; omega⟩))
    omega

/-- A start is within the finalized balance or the rounded top.

It is within the finalized effective balance, or within the floor of the balance at it.

The floor start is within the balance ceiling.

It is aligned, so it is within the rounding of the ceiling. -/
private theorem start_le_round {inc fin e a cap H S : ℕ}
    (aligned : e % inc = 0) (capped : e ≤ cap) (ceiling : min a cap ≤ H + S)
    (start : e ≤ fin ∨ e ≤ a - a % inc) :
    e ≤ max fin ((H + S) - (H + S) % inc) := by
  rcases start with atFin | floorA
  · exact Nat.le_trans atFin (Nat.le_max_left _ _)
  · refine Nat.le_trans ?_ (Nat.le_max_right _ _)
    exact aligned_le_round aligned capped ceiling floorA

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The closing of the rise for a key on its kept arm, from a start state `c`, at any end of C.

The key is in the registry at the state `c` of the shared segment, and unslashed at the split.

The run from the finalized state reaches `c` first, and the key is absent before it.

The caps along the runs are those of each state, so a switch to compounding on either run is read.

The credits `Cr` are all of C's, so they cover the cap's rise on C's run.

`late` is read only for a key that is unslashed at R.

At an end before R's epoch and no later than `c`, `shortStart` bounds the effective balance at `c`.

The replays are read at R's epoch. -/
private theorem key_core_frozen_from (h : Setting config checks g split fin pulled anc counted V)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩)
    {events : List (BalanceEvent preset)}
    (replayed : tail.balanceEvents (getCurrentEpoch pulled).toNat = .ok events)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    {eventsF : List (BalanceEvent preset)}
    (replayedF : fromFin.balanceEvents (getCurrentEpoch pulled).toNat = .ok eventsF)
    {ending : BeaconState preset fork}
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, ending⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch ending).toNat ≤ highC + 1)
    (nearC : (getCurrentEpoch ending).toNat ≤ (getCurrentEpoch pulled).toNat + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    (v : ValidatorIndex)
    (unslashed : (split.validators.data[v.toNat]?.map (·.slashed)).getD false = false)
    (late : ∀ w, pulled.validators.data[v.toNat]? = some w → w.slashed = false →
      (getCurrentEpoch pulled).toNat + 1 <
        w.exitEpoch.toNat + config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    {c : BeaconState preset fork} (toC : Run config checks ⟨fork, fin⟩ ⟨fork, c⟩)
    (fromC : Run config checks ⟨fork, c⟩ ⟨fork, split⟩) (cutC : toC.append fromC = fromFin)
    (inside : v.toNat < c.validators.data.size)
    (before : ∀ p ∈ toC.balancePath, p = ⟨fork, c⟩ ∨ effectiveAt p v.toNat = 0)
    (start : (effectiveAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat ≤
        (pinTerms config pulled anc fin).ebUp v.toNat ∧
        effectiveAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat ≤ balanceAt fin v.toNat) ∨
      effectiveAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat ≤
        actualBalanceAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat -
          actualBalanceAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat %
            preset.EFFECTIVE_BALANCE_INCREMENT.toNat)
    (shortStart : (getCurrentEpoch ending).toNat < (getCurrentEpoch pulled).toNat →
      (getCurrentEpoch ending).toNat ≤ (getCurrentEpoch c).toNat → ∀ S U : ℕ,
      (S = 0 ∨ preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤ U + 1 ∨
        (S < preset.EFFECTIVE_BALANCE_INCREMENT.toNat ∧
          preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤ S + U)) →
      min (actualBalanceAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat)
          (PinTerms.capAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat) ≤
        (pinTerms config pulled anc fin).high v.toNat + S →
      effectiveAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat ≤
          (pinTerms config pulled anc fin).capFor v.toNat + S + U ∧
        effectiveAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat ≤
          ((pinTerms config pulled anc fin).high v.toNat + preset.downwardBand) -
            ((pinTerms config pulled anc fin).high v.toNat + preset.downwardBand) %
              preset.EFFECTIVE_BALANCE_INCREMENT.toNat + S + U)
    (kept : (pinTerms config pulled anc fin).keptArm v.toNat = true) :
    balanceAt ending v.toNat ≤ balanceAt pulled v.toNat +
      (pinTerms config pulled anc fin).rise v.toNat +
      (syncD eventsF v.toNat + syncD events v.toNat +
        (credC tailC highC v.toNat + whistC tailC highC v.toNat +
          (eventsC.map (syncCredit v.toNat)).sum) +
        inducedR (pinTerms config pulled anc fin) (fromFin.append tail) v.toNat +
        flowK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF v.toNat +
        unitK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF v.toNat) +
      (bandC tailC highC v.toNat + bandR (eventsF ++ events) v.toNat + bandX fin highC v.toNat +
        slashR (pinTerms config pulled anc fin) v.toNat) := by
  classical
  obtain ⟨toFin⟩ := h.toFin
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  have sizeC := registryGrows_of_chainSteps fromC.chainSteps
  -- the floor of each state of R's run, and the largest effective balance on it
  obtain ⟨M, hM⟩ : ∃ M, M = ((fromFin.append tail).balancePath.map
      fun z => effectiveAt z v.toNat).foldl max 0 := ⟨_, rfl⟩
  -- the credit ceiling of C's run, from the floor and the debits of R's
  have splitSize : v.toNat < split.validators.data.size := Nat.lt_of_lt_of_le inside sizeC
  have debitsM := debits_le_top h fromFin tail (getCurrentEpoch pulled).toNat (Nat.le_succ _)
    replayedF replayed v splitSize M
    (fun pre post same => hM ▸ effective_le_foldl_max (fromFin.append tail) v.toNat
      (fromFin.append pre) post (by rw [← Run.append_assoc, ← same]))
  have debitsCap := debits_le_top h fromFin tail (getCurrentEpoch pulled).toNat (Nat.le_succ _)
    replayedF replayed v splitSize
    (PinTerms.capAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat)
    (fun pre post _ => effective_le_cap_pulled h (fromFin.append pre) post v.toNat)
  have splitOn {x : ForkedBeaconState preset} (pre : Run config checks x ⟨fork, split⟩) :
      (⟨fork, split⟩ : ForkedBeaconState preset) ∈ (pre.append tail).balancePath := by
    rw [Run.balancePath_append]
    exact List.mem_append_left _ (List.mem_of_mem_getLast? (Run.balancePath_ends pre).2)
  -- the envelope and the floor read the key's run from `c` to R's whole
  have cutRest : toC.append (fromC.append tail) = fromFin.append tail := by
    rw [Run.append_assoc, cutC]
  have cleanSplit : ∀ u, split.validators.data[v.toNat]? = some u → u.slashed = false :=
    fun u foundU => by
      obtain ⟨uS, foundS⟩ : ∃ uS, split.validators.data[v.toNat]? = some uS :=
        ⟨_, Array.getElem?_eq_getElem splitSize⟩
      rw [foundS] at foundU
      cases foundU
      simpa [foundS] using unslashed
  have clean : ∀ u, c.validators.data[v.toNat]? = some u → u.slashed = false :=
    fun u foundU => unslashed_of_run fromC foundU cleanSplit
  have slashedLate := slashed_withdrawable_of_clean h tail v cleanSplit splitSize h.finalized
  have envAll := envelope_of_voter h fromFin tail replayedF replayed v toC (fromC.append tail)
    cutRest clean slashedLate inside start late
  have startEff := envAll (⟨fork, split⟩ : ForkedBeaconState preset) (splitOn fromC)
  have floorR : min (actualBalanceAt (⟨fork, split⟩ : ForkedBeaconState preset) v.toNat)
      (PinTerms.capAt (⟨fork, split⟩ : ForkedBeaconState preset) v.toNat) ≤
      actualBalanceAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat +
        ((events.map (penaltyDebit v.toNat)).sum + (events.map (floorPartialDebit v)).sum) +
        (events.map (syncDebit v.toNat)).sum + slashW (pinTerms config pulled anc fin) v.toNat := by
    have := voter_floorAt h fromFin tail v toC (fromC.append tail) cutRest clean slashedLate inside
      late fromC tail rfl replayed
    omega
  have rateLow := keptArm_eq v.toNat kept
  obtain ⟨P, hP⟩ : ∃ P, P = ((getBaseRewardPerIncrement preset
      (if 18 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤
          ((getTotalActiveBalance pulled).toOption.getD 0).toNat then
        (getTotalActiveBalance pulled).toOption.getD 0 / 4
      else preset.EFFECTIVE_BALANCE_INCREMENT / 5)).toOption.getD 0).toNat := ⟨_, rfl⟩
  obtain ⟨credits, netLe, -⟩ := credits_le_sources (toFin.append fromFin) h.genesis tailC
    h.early electra v.toNat highC replayedC
  obtain ⟨Cr, hCr⟩ : ∃ Cr, Cr = credC tailC highC v.toNat + whistC tailC highC v.toNat +
    (eventsC.map (syncCredit v.toNat)).sum := ⟨_, rfl⟩
  obtain ⟨gc, hform, hgc, bound0⟩ := c_ceiling h fromFin tailC highC endEpochC nearC P hP v
    splitSize (slashW (pinTerms config pulled anc fin) v.toNat) replayedC Cr (by omega)
    (fun _ => hCr.symm.le) startEff floorR debitsCap rateLow
  have bound : ∀ z ∈ tailC.balancePath,
      min (actualBalanceAt z v.toNat) (PinTerms.capAt z v.toNat) ≤
      actualBalanceAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat +
        ((events.map (penaltyDebit v.toNat)).sum + (events.map (floorPartialDebit v)).sum) +
        (events.map (syncDebit v.toNat)).sum + slashW (pinTerms config pulled anc fin) v.toNat +
        Cr + (gc + (min (pinTerms config pulled anc fin).depth
            ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) *
          (pinTerms config pulled anc fin).gainRate v.toNat +
          min (pinTerms config pulled anc fin).depth
            ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat))) := by
    intro z member
    have := bound0 z member
    have := Nat.min_le_left
      (actualBalanceAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat +
        ((events.map (penaltyDebit v.toNat)).sum + (events.map (floorPartialDebit v)).sum) +
        (events.map (syncDebit v.toNat)).sum + slashW (pinTerms config pulled anc fin) v.toNat)
      (PinTerms.capAt (⟨fork, split⟩ : ForkedBeaconState preset) v.toNat)
    omega
  -- the names of the parts of the ceilings
  obtain ⟨Df, hDf⟩ : ∃ Df, Df = (getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat :=
    ⟨_, rfl⟩
  obtain ⟨D, hD⟩ : ∃ D, D = min (pinTerms config pulled anc fin).depth Df := ⟨_, rfl⟩
  obtain ⟨q, hq⟩ : ∃ q, q = (pinTerms config pulled anc fin).gainRate v.toNat := ⟨_, rfl⟩
  rw [← hDf, ← hD, ← hq] at hform hgc bound bound0
  rw [← hDf] at debitsM
  -- R's run has the ceiling on its balance, and C's run adds its credits and gains
  have onR : ∀ z ∈ (fromC.append tail).balancePath,
      min (actualBalanceAt z v.toNat) (PinTerms.capAt z v.toNat) ≤
        actualBalanceAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat +
          (Df * (pinTerms config pulled anc fin).leakAt M v.toNat +
            (PinTerms.dueAmount fin electra v.toNat ((getCurrentEpoch pulled).toNat + 1) -
              PinTerms.dueAmount pulled electra v.toNat ((getCurrentEpoch pulled).toNat + 1))) +
          ((eventsF.map (syncDebit v.toNat)).sum + (events.map (syncDebit v.toNat)).sum +
            slashW (pinTerms config pulled anc fin) v.toNat) := by
    intro z member
    have := path_ceiling h fromFin tail (getCurrentEpoch pulled).toNat (Nat.le_succ _) replayedF
      replayed v (slashW (pinTerms config pulled anc fin) v.toNat) M
      (fun pre post cut => hM ▸ effective_le_foldl_max (fromFin.append tail) v.toNat pre post cut)
      toC fromC cutC inside
      (voter_floorAt h fromFin tail v toC (fromC.append tail) cutRest clean slashedLate inside
        late) z member
    rw [hDf]
    omega
  obtain ⟨Bc, hBc⟩ : ∃ Bc, Bc = actualBalanceAt (⟨fork, pulled⟩ : ForkedBeaconState preset)
        v.toNat + (Df * (pinTerms config pulled anc fin).leakAt M v.toNat +
          (PinTerms.dueAmount fin electra v.toNat ((getCurrentEpoch pulled).toNat + 1) -
            PinTerms.dueAmount pulled electra v.toNat ((getCurrentEpoch pulled).toNat + 1))) +
      ((eventsF.map (syncDebit v.toNat)).sum + (events.map (syncDebit v.toNat)).sum +
        slashW (pinTerms config pulled anc fin) v.toNat) + (Cr + (gc + (D * q + D))) :=
    ⟨_, rfl⟩
  -- Before the split C shares R's path, so only the tail needs C's credit bounds.
  have onSharedOrTail {z : ForkedBeaconState preset}
      (member : z ∈ (fromC.append tailC).balancePath) :
      z ∈ (fromC.append tail).balancePath ∨ z ∈ tailC.balancePath := by
    rw [Run.balancePath_append] at member
    rcases List.mem_append.mp member with front | later
    · exact .inl (by rw [Run.balancePath_append]; exact List.mem_append_left _ front)
    · exact .inr (List.mem_of_mem_tail later)
  have onC : ∀ z ∈ (fromC.append tailC).balancePath,
      min (actualBalanceAt z v.toNat) (PinTerms.capAt z v.toNat) ≤ Bc := by
    intro z member
    rcases onSharedOrTail member with inR | later
    · have := onR z inR
      omega
    · have := bound z later
      omega
  have atC : min (actualBalanceAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat)
      (PinTerms.capAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat) ≤ Bc := by
    obtain ⟨rest, head⟩ := Run.balancePath_head (fromC.append tailC)
    exact onC _ (by rw [head]; exact List.mem_cons_self)
  have stay : balanceAt ending v.toNat = balanceAt pulled v.toNat ∨
      (balanceAt ending v.toNat ≤ effectiveAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat ∧
        ∀ S U : ℕ, Bc ≤ (pinTerms config pulled anc fin).high v.toNat + S →
        (S = 0 ∨ preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤ U + 1 ∨
          (S < preset.EFFECTIVE_BALANCE_INCREMENT.toNat ∧
            preset.EFFECTIVE_BALANCE_INCREMENT.toNat ≤ S + U)) →
        effectiveAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat ≤
            (pinTerms config pulled anc fin).capFor v.toNat + S + U ∧
          effectiveAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat ≤
            ((pinTerms config pulled anc fin).high v.toNat +
              preset.downwardBand) - ((pinTerms config pulled anc fin).high v.toNat +
              preset.downwardBand) % preset.EFFECTIVE_BALANCE_INCREMENT.toNat + S + U) ∨
      (balanceAt ending v.toNat ≤ Bc + preset.downwardBand ∧
        balanceAt ending v.toNat ≤ max (effectiveAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat)
          (min (Bc - Bc % preset.EFFECTIVE_BALANCE_INCREMENT.toNat)
            (PinTerms.capAt (⟨fork, ending⟩ : ForkedBeaconState preset) v.toNat))) := by
    rcases key_stay_to h toC fromC tailC v.toNat inside Bc onC with ⟨flat, same⟩ | ⟨-, near, top⟩
    · by_cases reached : (getCurrentEpoch pulled).toNat ≤ (getCurrentEpoch ending).toNat
      · rcases key_stay_to h toC fromC tail v.toNat inside _ onR with ⟨flatR, sameR⟩ | ⟨lt, -⟩
        · exact .inl (same.trans sameR.symm)
        · omega
      · exact .inr (.inl ⟨le_of_eq same, fun S U ceiling slack =>
        shortStart (by omega) flat S U slack (by omega)⟩)
    · exact .inr (.inr ⟨near, top⟩)
  have cappedLe : PinTerms.capAt (⟨fork, ending⟩ : ForkedBeaconState preset) v.toNat ≤
      PinTerms.capAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat →
      balanceAt ending v.toNat ≤ (pinTerms config pulled anc fin).capFor v.toNat :=
    fun le => Nat.le_trans (effective_le_cap_at (toFin.append (toC.append (fromC.append tailC)))
      h.genesis h.caps h.early v.toNat)
      (Nat.le_trans le
        (capAt_le_capFor config pulled anc fin v.toNat (capAt_le_capMax h.caps electra v.toNat)))
  have maxLe : M ≤ (pinTerms config pulled anc fin).ebUp v.toNat +
      preset.EFFECTIVE_BALANCE_INCREMENT.toNat *
        ((syncD eventsF v.toNat + syncD events v.toNat +
            slashW (pinTerms config pulled anc fin) v.toNat) /
          preset.EFFECTIVE_BALANCE_INCREMENT.toNat) := by
    have mapped : effectiveAt (⟨fork, split⟩ : ForkedBeaconState preset) v.toNat ∈
        (fromFin.append tail).balancePath.map fun z => effectiveAt z v.toNat :=
      List.mem_map.mpr ⟨_, splitOn fromFin, rfl⟩
    rw [hM, List.foldl_max_eq_max (List.ne_nil_of_mem mapped)]
    refine Nat.max_le.2 ⟨Nat.zero_le _, (List.max_le_iff (List.ne_nil_of_mem mapped)).2 ?_⟩
    intro x hx
    obtain ⟨z, hz, rfl⟩ := List.mem_map.mp hx
    rw [← cutC, ← Run.append_assoc] at hz
    exact path_le_of_start toC (fromC.append tail) v.toNat _ before envAll z hz
  have noCredit : bandC tailC highC v.toNat = 0 → bandX fin highC v.toNat = 0 → Cr = 0 := by
    intro hbC hbX
    have up := h.bands.2
    have incPos : 1 < preset.EFFECTIVE_BALANCE_INCREMENT.toNat := by
      have := h.facts.incrementSize
      omega
    have scans : grossScan v.toNat highC tailC = 0 ∧
        (creditScan (fun _ => false) (fun s => decide (s = .deposits)) v.toNat highC tailC) =
          0 := by
      unfold bandC at hbC
      split_ifs at hbC <;> omega
    have hdue : dueAt fin highC {v} = 0 := by
      unfold bandX at hbX
      rw [UInt64.ofNat_toNat] at hbX
      rcases Nat.eq_zero_or_pos (dueAt fin highC {v}) with z | p
      · exact z
      · have := Nat.le_mul_of_pos_right preset.upwardBand p
        omega
    have c0 := consAmt_zero h fromFin replayedF tailC highC endEpochC nearC replayedC v hdue
    have consScan : (creditScan (fun s => decide (s = .consolidations))
        (fun s => decide (s = .consolidations)) v.toNat highC tailC) ≤
          consAmt eventsC v.toNat :=
      scan_le_events _ _ (· = .consolidations) (by intro s; simp) tailC highC v replayedC
    have noOwn : ¬ 0 < credC tailC highC v.toNat + whistC tailC highC v.toNat := fun pos => by
      rcases credit_gate tailC highC v (Or.inl rfl) pos with credited | consolidated
      · simp only [creditedKey, decide_eq_true_eq] at credited
        omega
      · omega
    have noSeat : ¬ 0 < syncCr eventsC v.toNat := fun pos => by
      have := syncCr_gross (Nat.le_trans (by decide) h.fulu) h.early tailC highC replayedC
        v.toNat pos
      omega
    unfold syncCr at noSeat
    omega
  have startLe : ∀ S : ℕ, Bc ≤ (pinTerms config pulled anc fin).high v.toNat + S →
      effectiveAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat ≤
        max (balanceAt fin v.toNat)
          (((pinTerms config pulled anc fin).high v.toNat + S) -
            ((pinTerms config pulled anc fin).high v.toNat + S) %
              preset.EFFECTIVE_BALANCE_INCREMENT.toNat) := by
    intro S ceiling
    exact start_le_round
      (FloorTrace.effective_aligned (toFin.append toC) h.genesis h.aligned v.toNat)
      (effective_le_cap_at (toFin.append toC) h.genesis h.caps h.early v.toNat) (by omega)
      (start.imp_left And.right)
  -- on the headroom of C's cap, which R's cap may not reach, the cap adds to the rounded credits
  have cappedY : Df * ((11 * q + 9) / 10 + 3) < preset.EFFECTIVE_BALANCE_INCREMENT.toNat →
      balanceAt ending v.toNat ≤ (pinTerms config pulled anc fin).capFor v.toNat +
        (Cr + (gc + (D * q + D)) - (Cr + (gc + (D * q + D))) %
          preset.EFFECTIVE_BALANCE_INCREMENT.toNat) := by
    intro lowGain
    by_cases le : PinTerms.capAt (⟨fork, ending⟩ : ForkedBeaconState preset) v.toNat ≤
        PinTerms.capAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat
    · exact Nat.le_trans (cappedLe le) (Nat.le_add_right _ _)
    · have lowArm : (decide ((pinTerms config pulled anc fin).depthFin *
            ((11 * (pinTerms config pulled anc fin).gainRate v.toNat + 9) / 10 + 3) <
              preset.EFFECTIVE_BALANCE_INCREMENT.toNat) &&
          decide (11 * (pinTerms config pulled anc fin).depth *
            ((pinTerms config pulled anc fin).gainRate v.toNat + 1) ≤
              (pinTerms config pulled anc fin).ebUp v.toNat)) = true := by
        simp only [Bool.and_eq_true, decide_eq_true_eq]
        exact ⟨by rw [show (pinTerms config pulled anc fin).depthFin = Df from hDf.symm, ← hq]
                  exact lowGain, rateLow⟩
      have capFor : (pinTerms config pulled anc fin).capFor v.toNat =
          PinTerms.capAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat := by
        rw [capFor_eq]
        simp only [lowArm, ↓reduceIte]
      have pulledSize : v.toNat < pulled.validators.data.size :=
        Nat.lt_of_lt_of_le splitSize (registryGrows_of_chainSteps tail.chainSteps)
      obtain ⟨wP, foundP⟩ : ∃ w, pulled.validators.data[v.toNat]? = some w :=
        ⟨_, Array.getElem?_eq_getElem pulledSize⟩
      have aligned := capAt_aligned h.aligned (z := (⟨fork, pulled⟩ : ForkedBeaconState preset))
        electra foundP
      have capSP := cap_le_cap_of_run h.caps tail h.early v.toNat
      have stay2 := key_stay_to h toC fromC tailC v.toNat inside
        (PinTerms.capAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat +
          (Cr + (gc + (D * q + D))))
        (fun z member => by
          rcases onSharedOrTail member with inR | later
          · have := capCeil_path (fromC.append tail) h.caps h.early (Nat.le_refl _) v.toNat z inR
            omega
          · have := bound0 z later
            have := Nat.min_le_right
              (actualBalanceAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat +
                ((events.map (penaltyDebit v.toNat)).sum + (events.map (floorPartialDebit v)).sum) +
                (events.map (syncDebit v.toNat)).sum +
                slashW (pinTerms config pulled anc fin) v.toNat)
              (PinTerms.capAt (⟨fork, split⟩ : ForkedBeaconState preset) v.toNat)
            omega)
      have whole : (PinTerms.capAt (⟨fork, pulled⟩ : ForkedBeaconState preset) v.toNat +
          (Cr + (gc + (D * q + D)))) % preset.EFFECTIVE_BALANCE_INCREMENT.toNat =
          (Cr + (gc + (D * q + D))) % preset.EFFECTIVE_BALANCE_INCREMENT.toNat := by
        rw [Nat.add_mod, aligned, Nat.zero_add, Nat.mod_mod]
      have atC := effective_le_cap_at (toFin.append toC) h.genesis h.caps h.early v.toNat
      have atPulled := effective_le_cap_at (toFin.append (toC.append (fromC.append tail))) h.genesis
        h.caps h.early v.toNat
      have capCP := cap_le_cap_of_run h.caps (fromC.append tail) h.early v.toNat
      rw [capFor]
      rcases stay2 with ⟨-, same⟩ | ⟨-, -, atMost⟩
      · show effectiveAt (⟨fork, ending⟩ : ForkedBeaconState preset) v.toNat ≤ _
        omega
      · show effectiveAt (⟨fork, ending⟩ : ForkedBeaconState preset) v.toNat ≤ _
        omega
  have creditsLe : Cr ≤ credC tailC highC v.toNat + whistC tailC highC v.toNat +
      (eventsC.map (syncCredit v.toNat)).sum := hCr.le
  rw [← hCr]
  exact key_close h tail fromFin tailC highC v kept
    (voter_not_withdrawn h fromFin tail v unslashed late
      (Nat.lt_of_lt_of_le inside (registryGrows_of_chainSteps fromC.chainSteps)))
    P hP Df D q gc Cr M Bc _ hDf hD hq hM hform hBc
    maxLe (effectiveAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat) startLe stay
    cappedY creditsLe noCredit

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The per-key core of the rise for a counted voter on its kept arm, from a start state `c`.

The key's cap may stay or move, from `c` to R and to C.

It is `key_core_frozen_from` at the end of C's run.

C's run ends at or after R's epoch, so `shortStart` holds vacuously. -/
private theorem key_core_cap (h : Setting config checks g split fin pulled anc counted V)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩)
    {events : List (BalanceEvent preset)}
    (replayed : tail.balanceEvents (getCurrentEpoch pulled).toNat = .ok events)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    {eventsF : List (BalanceEvent preset)}
    (replayedF : fromFin.balanceEvents (getCurrentEpoch pulled).toNat = .ok eventsF)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    (v : ValidatorIndex)
    (unslashed : (split.validators.data[v.toNat]?.map (·.slashed)).getD false = false)
    (late : ∀ w, pulled.validators.data[v.toNat]? = some w →
      (getCurrentEpoch pulled).toNat + 1 <
        w.exitEpoch.toNat + config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    {c : BeaconState preset fork} (toC : Run config checks ⟨fork, fin⟩ ⟨fork, c⟩)
    (fromC : Run config checks ⟨fork, c⟩ ⟨fork, split⟩) (cutC : toC.append fromC = fromFin)
    (inside : v.toNat < c.validators.data.size)
    (before : ∀ p ∈ toC.balancePath, p = ⟨fork, c⟩ ∨ effectiveAt p v.toNat = 0)
    (start : (effectiveAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat ≤
        (pinTerms config pulled anc fin).ebUp v.toNat ∧
        effectiveAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat ≤ balanceAt fin v.toNat) ∨
      effectiveAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat ≤
        actualBalanceAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat -
          actualBalanceAt (⟨fork, c⟩ : ForkedBeaconState preset) v.toNat %
            preset.EFFECTIVE_BALANCE_INCREMENT.toNat)
    (kept : (pinTerms config pulled anc fin).keptArm v.toNat = true) :
    keyCeiling anc (fromFin.append tail) tailC highC eventsC events eventsF v.toNat :=
  keyCeiling_of_close anc (fromFin.append tail) tailC highC eventsC events eventsF v.toNat _
    (key_core_frozen_from h tail replayed fromFin replayedF tailC highC endEpochC h.near replayedC
      v unslashed (fun w fw _ => late w fw) toC fromC cutC inside before start
      (fun lt => absurd lt (by
        have := UInt64.le_iff_toNat_le.mp h.later
        omega)) kept)
    (Nat.le_refl _)

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- A key of the split's registry, unslashed at the split and kept, is bounded at its slashing.

The key is held at a state `c` of the shared segment.

The closing reads the cap of each state, so the cap is not read as frozen.

The step `a → b` of C's run slashes it, and `pre` is C's run up to `a`.

Its credits are those of the prefix, within the terms of `whistleSlack`.

The slashing's increment is `whistleEnv`'s.

An unslashed key at R is late for the whole run, which `late` states for the key. -/
private theorem registry_frozen (h : Setting config checks g split fin pulled anc counted V)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩) (high : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    {eventsF : List (BalanceEvent preset)}
    (replayedF : fromFin.balanceEvents high = .ok eventsF)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    {a b : ForkedBeaconState preset} (step : Step config checks a b) (member : tailC.Contains step)
    (i : ℕ) {c : BeaconState preset fork} (toC : Run config checks ⟨fork, fin⟩ ⟨fork, c⟩)
    (fromC : Run config checks ⟨fork, c⟩ ⟨fork, split⟩) (cutC : toC.append fromC = fromFin)
    (inside : i < c.validators.data.size)
    (before : ∀ p ∈ toC.balancePath, p = ⟨fork, c⟩ ∨ effectiveAt p i = 0)
    (start : (effectiveAt (⟨fork, c⟩ : ForkedBeaconState preset) i ≤
        (pinTerms config pulled anc fin).ebUp i ∧
        effectiveAt (⟨fork, c⟩ : ForkedBeaconState preset) i ≤ balanceAt fin i) ∨
      effectiveAt (⟨fork, c⟩ : ForkedBeaconState preset) i ≤
        actualBalanceAt (⟨fork, c⟩ : ForkedBeaconState preset) i -
          actualBalanceAt (⟨fork, c⟩ : ForkedBeaconState preset) i %
            preset.EFFECTIVE_BALANCE_INCREMENT.toNat)
    (unslashed : (split.validators.data[i]?.map (·.slashed)).getD false = false)
    (flag : (!(a.state.validators.data[i]?.map (·.slashed)).getD false &&
      (b.state.validators.data[i]?.map (·.slashed)).getD false) = true)
    (late : ∀ w, pulled.validators.data[i]? = some w → w.slashed = false →
      (getCurrentEpoch pulled).toNat + 1 <
        w.exitEpoch.toNat + config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat)
    (kept : (pinTerms config pulled anc fin).keptArm i = true) :
    effectiveAt a i ≤ whistleEnv (pinTerms config pulled anc fin) pulled anc fin i +
      whistleSlack (pinTerms config pulled anc fin) tailC (fromFin.append tail) highC high
        eventsC eventsF events fin i := by
  classical
  obtain ⟨pre, post, cut, aEarly, aEpoch⟩ :=
    DirectSafety.Apriori.Internal.Run.contains_step_facts member h.early
  obtain ⟨af, as⟩ := a
  have sameFork : fork = af :=
    (fork_eq_of_run pre ((Run.nil.snoc step).append post) (Nat.le_refl _)).symm
  subst sameFork
  -- a short end with the finalized start keeps its balance at `c`, within `whistleEnv`
  by_cases leftShort : ((getCurrentEpoch as).toNat < (getCurrentEpoch pulled).toNat ∧
      (getCurrentEpoch as).toNat ≤ (getCurrentEpoch c).toNat) ∧
      (effectiveAt (⟨fork, c⟩ : ForkedBeaconState preset) i ≤
          (pinTerms config pulled anc fin).ebUp i ∧
        effectiveAt (⟨fork, c⟩ : ForkedBeaconState preset) i ≤ balanceAt fin i)
  · have bound := short_in_fin h fromC tailC step member i inside leftShort.2.2
      (whistleSlack (pinTerms config pulled anc fin) tailC (fromFin.append tail) highC high
        eventsC eventsF events fin i) leftShort.1.2
    omega
  have near := h.near
  -- the replays are read at R's epoch
  obtain ⟨replayedF', replayed'⟩ :=
    replays_at_pulled tail high endEpoch replayed fromFin replayedF
  obtain ⟨eventsPre, replayedPre⟩ := pre.balanceEvents_ok aEarly highC
  subst cut
  -- the key as a validator index
  have sizeC : c.validators.data.size ≤ split.validators.data.size :=
    registryGrows_of_chainSteps fromC.chainSteps
  have sizeCounted : split.validators.data.size ≤ counted.validators.data.size :=
    registryGrows_of_chainSteps ((pre.snoc step).append post).chainSteps
  have aEpoch' : (getCurrentEpoch as).toNat ≤ (getCurrentEpoch counted).toNat := aEpoch
  obtain ⟨v, rfl⟩ := Uint64.exists_toNat_eq
    ((inside.trans_le (sizeC.trans sizeCounted)).trans
      (BeaconState.validators_size_lt_of_lt_glamsterdam h.early counted))
  have core := key_core_frozen_from h tail replayed' fromFin replayedF' pre highC
    (by omega) (by omega) replayedPre v unslashed late
    toC fromC cutC inside before start
    (fun lt le S U slack ceiling => by
      rcases start with ⟨within, atFin⟩ | floorC
      · exact absurd ⟨⟨lt, le⟩, within, atFin⟩ leftShort
      · obtain ⟨toFin⟩ := h.toFin
        have capped := effective_le_cap_at (toFin.append toC) h.genesis h.caps h.early v.toNat
        have capsLater := cap_le_cap_of_run h.caps (fromC.append tail) h.early v.toNat
        have forOf := capAt_le_capFor config pulled anc fin v.toNat
          (capAt_le_capMax h.caps (Nat.le_trans (by decide) h.fulu) v.toNat)
        exact ⟨by omega, short_start_floor h.bands.1
          (FloorTrace.effective_aligned (toFin.append toC) h.genesis h.aligned v.toNat) capped
          ceiling floorC slack⟩)
    kept
  have p1 := credC_prefix_le h pre step post highC replayedC v.toNat flag
  have p2 := prefix_credits_mono (counted := counted) pre step post highC v.toNat
  have p3 : (eventsPre.map (syncCredit v.toNat)).sum ≤ syncCr eventsC v.toNat :=
    syncCr_prefix_le pre step post highC replayedPre replayedC v.toNat
  exact whistle_of_close h _ rfl pre ((pre.snoc step).append post) (fromFin.append tail) highC high
    eventsC eventsPre eventsF events v.toNat
    (credC pre highC v.toNat + whistC pre highC v.toNat +
      (eventsPre.map (syncCredit v.toNat)).sum)
    (balanceAt as v.toNat) core (by omega) p2.1 p1 p2.2.1 p3 p2.2.2 kept

/-- At the finalized state there is no earlier balance path, and the effective balance fits. -/
private theorem finalized_start (h : Setting config checks g split fin pulled anc counted V)
    (i : ℕ) :
    (∀ p ∈ (Run.nil : Run config checks ⟨fork, fin⟩ ⟨fork, fin⟩).balancePath,
      p = ⟨fork, fin⟩ ∨ effectiveAt p i = 0) ∧
    (effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) i ≤
        (pinTerms config pulled anc fin).ebUp i ∧
      effectiveAt (⟨fork, fin⟩ : ForkedBeaconState preset) i ≤ balanceAt fin i) :=
  ⟨fun _ mem => Or.inl (by simpa [Run.balancePath] using mem),
    effective_fin_le_ebUp h i, Nat.le_refl _⟩

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- A key of the split's registry that is off the kept arm is bounded by the largest cap.

Its rise is its whole headroom, so the bound reads the largest cap at each step of C's branch. -/
private theorem registry_headroom (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩)
    {a b : ForkedBeaconState preset} (step : Step config checks a b) (member : tailC.Contains step)
    (i : ℕ) (notKept : ¬ (pinTerms config pulled anc fin).keptArm i = true) (slack : ℕ) :
    effectiveAt a i ≤ whistleEnv (pinTerms config pulled anc fin) pulled anc fin i + slack := by
  obtain ⟨shared⟩ := h.toFin
  obtain ⟨fromFin⟩ := h.fromFin
  obtain ⟨pre, -, -, aEarly, -⟩ :=
    DirectSafety.Apriori.Internal.Run.contains_step_facts member h.early
  have capped := PinSeatDebits.effectiveAt_le_capMax ((shared.append fromFin).append pre) h.genesis
    h.caps aEarly i
  have headroom := rise_of_notKept h i notKept
  unfold whistleEnv
  split_ifs <;> omega

/-- The per-key core of the rise for a key on the headroom arm.

Its rise is its whole headroom, to the largest cap.

The cap holds the balance on C's branch, whatever the replays read. -/
private theorem key_core_headroom (h : Setting config checks g split fin pulled anc counted V)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩)
    {events : List (BalanceEvent preset)}
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    {eventsF : List (BalanceEvent preset)}
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    {eventsC : List (BalanceEvent preset)} (v : ValidatorIndex)
    (notKept : ¬ (pinTerms config pulled anc fin).keptArm v.toNat = true) :
    keyCeiling anc (fromFin.append tail) tailC highC eventsC events eventsF v.toNat := by
  obtain ⟨shared⟩ := h.toFin
  have capped := PinSeatDebits.effectiveAt_le_capMax (shared.append (fromFin.append tailC))
    h.genesis h.caps h.early v.toNat
  have headroom := rise_of_notKept h v.toNat notKept
  have countedLe : balanceAt counted v.toNat ≤
      preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat := capped
  unfold keyCeiling
  omega

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- A key that C's branch created beyond the split is bounded by its credits and their gains.

The key's stake is its credits on C's branch.

Its effective balance is within the ceiling of a created key.

Its flows hold the credits, and the key's gain over the depth of the window is the flow gain.

The premises are the rate of the ceiling at the depth of the window.

They are also the charge of the flow gain to the key.

The unit pays the joint floor, and the band is an upward band at least. -/
private theorem created_key_ceiling (h : Setting config checks g split fin pulled anc counted V)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩)
    {events : List (BalanceEvent preset)}
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    {eventsF : List (BalanceEvent preset)}
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    {v : ValidatorIndex} (activated : ∃ w, counted.validators.data[v.toNat]? = some w ∧
      w.activationEpoch ≠ FAR_FUTURE_EPOCH ∧ w.activationEpoch ≤ getCurrentEpoch counted)
    (absent : split.validators.data.size ≤ v.toNat)
    (key : 11 * (min (pinTerms config pulled anc fin).depth
      ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat)) *
        ((pinTerms config pulled anc fin).perIncrement *
          (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum) <
      WEIGHT_DENOMINATOR.toNat * preset.EFFECTIVE_BALANCE_INCREMENT.toNat)
    (charged : (pinTerms config pulled anc fin).keptArm v.toNat = true ∨
      (v.toNat ∉ (pinTerms config pulled anc fin).positions ∧
        (pinTerms config pulled anc fin).gainHigh = false))
    (band : preset.upwardBand ≤ bandC tailC highC v.toNat + bandX fin highC v.toNat) :
    balanceAt counted v.toNat ≤
      (((credC tailC highC v.toNat +
          keyExtra (pinTerms config pulled anc fin) (fromFin.append tail) tailC highC
            eventsC events eventsF v.toNat) +
          whistC tailC highC v.toNat) +
        (syncF events v.toNat + syncF eventsC v.toNat) +
        (slashR (pinTerms config pulled anc fin) v.toNat + bandC tailC highC v.toNat +
          bandR (eventsF ++ events) v.toNat)) + bandX fin highC v.toNat := by
  classical
  obtain ⟨z, pre, post, -, positive, -, bound⟩ := created_ceiling h tailC highC endEpochC replayedC
    activated absent (pinTerms config pulled anc fin).perIncrement rfl key
  set Z := credC tailC highC v.toNat + whistC tailC highC v.toNat + syncCr eventsC v.toNat with hZ
  have atEnd : (⟨fork, counted⟩ : ForkedBeaconState preset) ∈ post.balancePath := by
    obtain ⟨front, eq⟩ := Run.balancePath_last post
    rw [eq]
    simp
  have ceiling := bound _ atEnd
  have effective : effectiveAt (⟨fork, counted⟩ : ForkedBeaconState preset) v.toNat =
      balanceAt counted v.toNat := rfl
  -- the flow gain is charged to the key
  have flowEq : flowK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF
      v.toNat = flowGain (pinTerms config pulled anc fin) tailC highC eventsC events eventsF
        v.toNat := by
    unfold flowK
    rw [ite_eq_left charged]
  have credit : Z ≤ flowCredit (pinTerms config pulled anc fin) tailC highC eventsC events eventsF
      v.toNat := by
    unfold flowCredit
    omega
  have gain : min (pinTerms config pulled anc fin).depth
        ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) *
      (11 * Z / (10 * preset.EFFECTIVE_BALANCE_INCREMENT.toNat) *
        (pinTerms config pulled anc fin).perIncrement *
          (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum / WEIGHT_DENOMINATOR.toNat) ≤
      flowGain (pinTerms config pulled anc fin) tailC highC eventsC events eventsF v.toNat :=
    Nat.mul_le_mul_left _ (Nat.div_le_div_right (Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _
      (Nat.div_le_div_right (Nat.mul_le_mul_left 11 credit)))))
  have unit : min (pinTerms config pulled anc fin).depth
        ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) *
      ((pinTerms config pulled anc fin).perIncrement *
        (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum / WEIGHT_DENOMINATOR.toNat + 2) ≤
      unitK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF v.toNat := by
    unfold unitK
    rw [ite_eq_left (Nat.lt_of_lt_of_le positive credit)]
    exact Nat.mul_le_mul_right _ (Nat.min_le_left _ _)
  have below := h.facts.below
  have upward := h.bands.2
  have sync := syncF_eq eventsC v.toNat
  have credits : syncCr eventsC v.toNat = (eventsC.map (syncCredit v.toNat)).sum := rfl
  unfold keyExtra
  omega

/-- The exit of a key that the finalized state does not hold is not before the finalized epoch.

An exit up to the finalized epoch would be an exit of the finalized registry. -/
private theorem created_exitAfterFin (h : Setting config checks g split fin pulled anc counted V)
    {i : ℕ} (created : fin.validators.data.size ≤ i) :
    ∀ w, pulled.validators.data[i]? = some w →
      (getCurrentEpoch fin).toNat ≤ w.exitEpoch.toNat := by
  intro w found
  by_contra before
  obtain ⟨u, foundFin, -⟩ := exit_kept_of_le_fin h found (by omega)
  have := (Array.getElem?_eq_some_iff.mp foundFin).1
  omega

/-- The withdrawal delay outlasts the run for a key created after finalization. -/
private theorem created_late (h : Setting config checks g split fin pulled anc counted V)
    {v : ValidatorIndex} (created : fin.validators.data.size ≤ v.toNat) :
    ∀ w, pulled.validators.data[v.toNat]? = some w →
      (getCurrentEpoch pulled).toNat + 1 <
        w.exitEpoch.toNat + config.MIN_VALIDATOR_WITHDRAWABILITY_DELAY.toNat :=
  fun w found => (window_short h).trans_le
    (Nat.add_le_add_right (created_exitAfterFin h created w found) _)

/-- The per-key core of the rise for a counted voter created after the finalized state.

The key is absent from the finalized registry, and its rise is on the kept arm.

A key created on C's branch after the split is bounded by its credits and their gains.

The kept arm bounds the key's gain rate, which is the rate that bound reads.

The replays are read at R's epoch. -/
private theorem key_core_created (h : Setting config checks g split fin pulled anc counted V)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩)
    {events : List (BalanceEvent preset)}
    (replayed : tail.balanceEvents (getCurrentEpoch pulled).toNat = .ok events)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    {eventsF : List (BalanceEvent preset)}
    (replayedF : fromFin.balanceEvents (getCurrentEpoch pulled).toNat = .ok eventsF)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    (v : ValidatorIndex) (voter : v ∈ Q counted)
    (created : fin.validators.data.size ≤ v.toNat)
    (kept : (pinTerms config pulled anc fin).keptArm v.toNat = true) :
    keyCeiling anc (fromFin.append tail) tailC highC eventsC events eventsF v.toNat := by
  classical
  by_cases absent : split.validators.data.size ≤ v.toNat
  · have activated := activated_of_quorum h.early voter
    have core := created_key_ceiling (events := events) (eventsF := eventsF) h tail fromFin tailC
      highC endEpochC replayedC activated absent
      (key_of_kept h v.toNat _ (Nat.min_le_left _ _) kept) (Or.inl kept)
      (created_band h fromFin (getCurrentEpoch pulled).toNat (Nat.le_succ _) replayedF tailC highC
        endEpochC replayedC activated absent)
    unfold keyCeiling
    omega
  · -- the key is created on the shared segment, and its envelope starts at its first state
    have splitSize : v.toNat < split.validators.data.size := Nat.lt_of_not_le absent
    obtain ⟨c, toC, fromC, cutC, insideC, -, before, floorStart, -⟩ :=
      created_first_state h fromFin created splitSize
    exact key_core_cap h tail replayed fromFin replayedF tailC highC endEpochC replayedC v
      (voter_unslashed h v voter) (created_late h created) toC fromC cutC insideC before
      (Or.inr floorStart) kept

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The leak that the counted keys' sync debits on R's branch induce, at their weights.

The keys that are slashed at C and not at the split are counted too, at weight one.

The keys slashed at the split that R's call reads as slashed are counted at weight three.

They are the keys of `Kc` in `bud_sync`.

It fits `syncLeak`, and the leak of one increment for each key slashed on R's branch.

The second bound is read by `flow_whist`, through `whist_units`. -/
private theorem bud_syncLeak (h : Setting config checks g split fin pulled anc counted V)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩) (high : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    {eventsF : List (BalanceEvent preset)} (replayedF : fromFin.balanceEvents high = .ok eventsF) :
    (∑ v ∈ (K4 pulled counted V), inducedR (pinTerms config pulled anc fin) (fromFin.append tail)
          v.toNat) +
      3 * (∑ v ∈ (K5 counted V), inducedR (pinTerms config pulled anc fin) (fromFin.append tail)
          v.toNat) +
      (∑ v ∈ (K6 pulled counted), inducedR (pinTerms config pulled anc fin) (fromFin.append tail)
          v.toNat) +
      (∑ v ∈ (SC pulled counted split), inducedR (pinTerms config pulled anc fin)
          (fromFin.append tail) v.toNat) +
      3 * (∑ v ∈ cutKeys config pulled anc fin split,
          inducedR (pinTerms config pulled anc fin) (fromFin.append tail) v.toNat) ≤
      (pinTerms config pulled anc fin).syncLeak +
        3 * ((pinTerms config pulled anc fin).slashedR *
          (pinTerms config pulled anc fin).slashLeak) ∧
    (∑ v ∈ (SC pulled counted split), inducedR (pinTerms config pulled anc fin)
        (fromFin.append tail) v.toNat) ≤
      (pinTerms config pulled anc fin).syncLeak +
        (pinTerms config pulled anc fin).slashedR *
          (pinTerms config pulled anc fin).slashLeak := by
  classical
  obtain ⟨tailC⟩ := h.toCounted
  -- the replays are read at R's epoch
  obtain ⟨replayedF', replayed'⟩ :=
    replays_at_pulled tail high endEpoch replayed fromFin replayedF
  have perPos : 1 ≤ (pinTerms config pulled anc fin).perIncrement := by
    have := four_le_perIncrement h
    omega
  obtain ⟨d45, d46, d56, -, -, -⟩ := classes_disjoint h
  obtain ⟨dKS, -⟩ := sc_disjoint h
  -- the keys slashed at the split that R's call reads as slashed
  set Kc : Finset ValidatorIndex := cutKeys config pulled anc fin split with hKc
  have kcSlashed : ∀ v ∈ Kc, ∃ u, split.validators.data[v.toNat]? = some u ∧
      u.slashed = true := by
    intro v member
    have flag := (Finset.mem_filter.mp member).2.1
    cases found : split.validators.data[v.toNat]? with
    | none => simp [found] at flag
    | some u => exact ⟨u, rfl, by simpa [found] using flag⟩
  have dK : Disjoint (K4 pulled counted V ∪ K5 counted V ∪ K6 pulled counted) Kc := by
    rw [Finset.disjoint_left]
    intro v member inKc
    obtain ⟨u, found, flag⟩ := kcSlashed v inKc
    obtain ⟨w, foundC, flagC⟩ := tailC.slashedPersistence v.toNat u found flag
    exact classes_unslashed member (by simp [slashedFlagAt, foundC, flagC])
  have dS : Disjoint (SC pulled counted split) Kc := by
    rw [Finset.disjoint_left]
    intro v member inKc
    obtain ⟨u, found, flag⟩ := kcSlashed v inKc
    simp only [SC, Finset.mem_filter] at member
    have flagS := member.2.2
    simp [slashedFlagAt, found, flag] at flagS
  -- a key slashed at the split that R reads as slashed withdraws a vector past `fin`
  have kcFrozen : ∀ v ∈ Kc, ∀ w, pulled.validators.data[v.toNat]? = some w →
      (getCurrentEpoch fin).toNat + preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat ≤
        w.withdrawableEpoch.toNat := by
    intro v inKc w fw
    have frozen := (Finset.mem_filter.mp inKc).2.2.2
    simp only [fw, Option.any_some, decide_eq_true_eq] at frozen
    exact frozen
  have notKcUnslashed : ∀ v ∈ K4 pulled counted V ∪ K5 counted V ∪ K6 pulled counted ∪
      SC pulled counted split, (split.validators.data[v.toNat]?.map (·.slashed)).getD false =
        false := by
    intro v notKc
    rcases Finset.mem_union.mp notKc with counted' | member'
    · exact voter_unslashed h v (classes_mem_Q counted')
    · simp only [SC, Finset.mem_filter] at member'
      have flag := member'.2.2
      simp only [slashedFlagAt] at flag
      rw [flag]
      rfl
  have envelope : ∀ v ∈ K4 pulled counted V ∪ K5 counted V ∪ K6 pulled counted ∪
      SC pulled counted split ∪ Kc, (∀ w, pulled.validators.data[v.toNat]? = some w →
        (getCurrentEpoch pulled).toNat + 1 < w.withdrawableEpoch.toNat) →
      ∀ z ∈ (fromFin.append tail).balancePath, effectiveAt z v.toNat ≤
        (pinTerms config pulled anc fin).ebUp v.toNat + preset.EFFECTIVE_BALANCE_INCREMENT.toNat *
          ((syncD eventsF v.toNat + syncD events v.toNat +
              slashW (pinTerms config pulled anc fin) v.toNat) /
            preset.EFFECTIVE_BALANCE_INCREMENT.toNat) := by
    intro v member late z inPath
    by_cases beyond : pulled.validators.data.size ≤ v.toNat
    · -- R's registry does not hold the key, so it has no effective balance on R's run
      obtain ⟨q1, q2, -⟩ := balancePath_endpoint (fromFin.append tail)
        (Run.nil : Run config checks ⟨fork, pulled⟩ ⟨fork, pulled⟩) (Nat.le_refl _) inPath
      obtain ⟨zf, zs⟩ := z
      have same : fork = zf := (fork_eq_of_run q1 q2 (Nat.le_refl _)).symm
      subst same
      have grows : zs.validators.data.size ≤ pulled.validators.data.size :=
        registryGrows_of_chainSteps q2.chainSteps
      have absent : zs.validators.data[v.toNat]? = none := Array.getElem?_eq_none (by omega)
      have zero : effectiveAt (⟨fork, zs⟩ : ForkedBeaconState preset) v.toNat = 0 := by
        simp [effectiveAt, absent]
      rw [zero]
      exact Nat.zero_le _
    · by_cases inFin : v.toNat < fin.validators.data.size
      · by_cases inKc : v ∈ Kc
        · exact kc_envelope h fromFin tail replayedF' replayed' v inFin (kcSlashed v inKc)
            (Finset.mem_filter.mp inKc).2.2.1 (kcFrozen v inKc) late z inPath
        · have notKc : v ∈ K4 pulled counted V ∪ K5 counted V ∪ K6 pulled counted ∪
              SC pulled counted split := (Finset.mem_union.mp member).resolve_right inKc
          have unslashed := notKcUnslashed v notKc
          have cleanSplit : ∀ u, split.validators.data[v.toNat]? = some u →
              u.slashed = false := fun u foundU => by
            rw [foundU] at unslashed
            simpa using unslashed
          exact envelope_of_clean_fin h fromFin tail replayedF' replayed' v (by omega)
            (fun u foundU => unslashed_of_run fromFin foundU cleanSplit)
            (fun splitSize => slashed_withdrawable_of_clean h tail v cleanSplit splitSize
              h.finalized) late z inPath
      · have createdV : fin.validators.data.size ≤ v.toNat := by omega
        have slashedLate : v.toNat < split.validators.data.size →
            ∀ w, pulled.validators.data[v.toNat]? = some w → w.slashed = true →
              anc.finalizedCheckpoint.epoch.toNat + preset.EPOCHS_PER_SLASHINGS_VECTOR.toNat ≤
                w.withdrawableEpoch.toNat := by
          intro splitSize
          by_cases inKc : v ∈ Kc
          · intro w fw flag
            have rb := (Finset.mem_filter.mp inKc).2.2.1
            rw [slashedRB_eq] at rb
            simp only [fw, flag, Option.map_some, Option.getD_some, Option.any_some,
              decide_eq_true_eq, true_and] at rb
            exact rb
          · have notKc : v ∈ K4 pulled counted V ∪ K5 counted V ∪ K6 pulled counted ∪
                SC pulled counted split := (Finset.mem_union.mp member).resolve_right inKc
            have unslashed := notKcUnslashed v notKc
            exact slashed_withdrawable_of_clean h tail v (fun u foundU => by
              rw [foundU] at unslashed
              simpa using unslashed) splitSize h.finalized
        exact envelope_of_clean_fin h fromFin tail replayedF' replayed' v (by omega)
          (fun u foundU => by
            rw [Array.getElem?_eq_none createdV] at foundU
            contradiction) slashedLate late z inPath
  have whole := syncLeak_of_envelope h perPos fromFin tail replayedF' replayed'
    (K4 pulled counted V ∪ K5 counted V ∪ K6 pulled counted ∪ SC pulled counted split ∪ Kc)
    envelope
  have scOnly := syncLeak_of_envelope h perPos fromFin tail replayedF' replayed'
    (SC pulled counted split)
    (fun v member => envelope v (Finset.mem_union_left _ (Finset.mem_union_right _ member)))
  have weights := weighted_le (fun v : ValidatorIndex =>
    inducedR (pinTerms config pulled anc fin) (fromFin.append tail) v.toNat) d45 d46 d56
  beta_reduce at weights
  rw [Finset.sum_union (Finset.disjoint_union_left.mpr ⟨dK, dS⟩), Finset.sum_union dKS] at whole
  refine ⟨?_, ?_⟩
  · change _ + _ + _ + _ + 3 * (∑ x ∈ Kc, inducedR (pinTerms config pulled anc fin)
      (fromFin.append tail) (UInt64.toNat x)) ≤ _
    omega
  · omega

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The per-key core of the rise.

A key of R's registry rises from R to C by at most its rise term.

It also rises by the credits and slacks that `rise` does not read.

The slacks are one increment for a slashing on R's branch.

They are one rounding step for a credit on C's branch or a sync debit on R's.

The key's flows also compound, which `keyExtra` charges with its unit and its induced leak.

`keyExtra` also holds the key's sync debits on the shared segment. -/
private theorem key_core (h : Setting config checks g split fin pulled anc counted V)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩) (high : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    {eventsF : List (BalanceEvent preset)} (replayedF : fromFin.balanceEvents high = .ok eventsF)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    (i : ℕ) (inside : i < pulled.validators.data.size)
    (voter : (UInt64.ofNat i : ValidatorIndex) ∈ Q counted) :
    keyCeiling anc (fromFin.append tail) tailC highC eventsC events eventsF i := by
  classical
  -- the replays are read at R's epoch
  obtain ⟨replayedF', replayed'⟩ :=
    replays_at_pulled tail high endEpoch replayed fromFin replayedF
  -- the key as a validator index
  have below := inside.trans (BeaconState.validators_size_lt_of_lt_glamsterdam h.early pulled)
  generalize hv : (UInt64.ofNat i : ValidatorIndex) = v at voter
  have hvi : v.toNat = i := by
    rw [← hv]
    exact UInt64.toNat_ofNat_of_lt' below
  subst hvi
  by_cases kept : (pinTerms config pulled anc fin).keptArm v.toNat = true
  · by_cases inFin : v.toNat < fin.validators.data.size
    · exact key_core_cap h tail replayed' fromFin replayedF' tailC highC endEpochC replayedC v
        (voter_unslashed h v voter)
        (voter_late h fromFin v voter) Run.nil fromFin (run_nil_append fromFin) inFin
        (finalized_start h v.toNat).1 (.inl (finalized_start h v.toNat).2) kept
    · exact key_core_created h tail replayed' fromFin replayedF' tailC highC endEpochC replayedC
        v voter (Nat.le_of_not_lt inFin) kept
  · exact key_core_headroom h tail fromFin tailC highC v kept

/-- The rise of the other keys, which are active in both. -/
private theorem cN_le (h : Setting config checks g split fin pulled anc counted V)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩) (high : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    {eventsF : List (BalanceEvent preset)} (replayedF : fromFin.balanceEvents high = .ok eventsF)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC) :
    cN pulled counted V ≤
      ((∑ v ∈ (K4 pulled counted V), ((pinTerms config pulled anc fin).rise v.toNat +
      (credC tailC highC v.toNat +
          keyExtra (pinTerms config pulled anc fin) (fromFin.append tail) tailC highC
            eventsC events eventsF v.toNat) + whistC tailC highC v.toNat +
      (syncF events v.toNat + syncF eventsC v.toNat) +
      slashR (pinTerms config pulled anc fin) v.toNat + bandC tailC highC v.toNat +
      bandR (eventsF ++ events) v.toNat + bandX fin highC v.toNat)) : ℕ) := by
  have early := h.early
  have term : ∀ v ∈ K4 pulled counted V, ((eC counted v : ℤ) - eR pulled v) ≤
      (((pinTerms config pulled anc fin).rise v.toNat +
        (credC tailC highC v.toNat +
            keyExtra (pinTerms config pulled anc fin) (fromFin.append tail) tailC highC
              eventsC events eventsF v.toNat) +
        whistC tailC highC v.toNat + (syncF events v.toNat + syncF eventsC v.toNat) +
        slashR (pinTerms config pulled anc fin) v.toNat + bandC tailC highC v.toNat +
        bandR (eventsF ++ events) v.toNat + bandX fin highC v.toNat : ℕ) : ℤ) := by
    intro v member
    have active : v ∈ AR pulled := (Finset.mem_filter.mp member).2.1
    obtain ⟨w, found, -⟩ := active_of_activeVoters early (s := pulled) active
    have core := key_core h tail high endEpoch replayed fromFin replayedF tailC highC endEpochC
      replayedC v.toNat (Array.getElem?_eq_some_iff.mp found).1
      (by rw [UInt64.ofNat_toNat]; exact (Finset.mem_filter.mp member).2.2.1)
    simp only [eC, eR]
    push_cast
    unfold keyCeiling at core
    zify at core
    omega
  have eq : cN pulled counted V =
      ∑ v ∈ K4 pulled counted V, ((eC counted v : ℤ) - eR pulled v) := by
    unfold cN
    rw [← Finset.sum_filter]
    congr 1
    ext v
    simp only [K4]
    rw [Finset.mem_filter, Finset.mem_filter]
    simp only [U, AC, AR, Q, Finset.mem_union]
    tauto
  rw [eq]
  refine le_trans (Finset.sum_le_sum term) (le_of_eq ?_)
  exact (Nat.cast_sum _ _).symm

/-- The charge of a charged key of `K5`: the run splits at the step that starts its exit.

The charge is the key's effective balance before that step.

It counts as `exitQ`, since a key of `K5` exits at C's epoch. -/
private theorem K5_charge_site (h : Setting config checks g split fin pulled anc counted V)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) {v : ValidatorIndex}
    (member : v ∈ K5 counted V) (charged : ∃ c ∈ tailC.departureCharges, c.index = v.toNat) :
    ∃ (a b : ForkedBeaconState preset) (pre : Run config checks ⟨fork, split⟩ a)
      (step : Step config checks a b) (post : Run config checks b ⟨fork, counted⟩),
      (pre.snoc step).append post = tailC ∧
        step.departureCharges.any (·.index == v.toNat) = true ∧
        (∀ w, a.state.validators.data[v.toNat]? = some w → w.exitEpoch = FAR_FUTURE_EPOCH) ∧
        v.toNat < a.state.validators.data.size ∧
        exitQ tailC v.toNat = effectiveAt a v.toNat := by
  obtain ⟨c, cMember, cIndex⟩ := charged
  obtain ⟨a, b, pre, step, post, site, vv, w, found, foundB, unset, set, amount, epoch⟩ :=
    tailC.departure_charge_site c cMember
  rw [cIndex] at found foundB
  -- the key exits at C's epoch, so the charge counts
  obtain ⟨wc, foundC, life⟩ := post.registryLifecycle.validators v.toNat w foundB
  have exitSame := life.exitEpoch set
  obtain ⟨u, foundU, activeBefore, notNow⟩ := K5_previous_only h member
  have exitC := ((previous_only_iff_exit counted u).mp ⟨activeBefore, notNow⟩).2
  have same : u = wc := Option.some.inj (foundU.symm.trans foundC)
  have counts : c.epoch ≤ (getCurrentEpoch counted).toNat := by
    have exitNat := congrArg UInt64.toNat exitSame
    subst same
    omega
  have exitQEq : exitQ tailC v.toNat = c.amount := by
    rcases exitQ_cases tailC v.toNat with ⟨none, -⟩ | ⟨d, dMember, dIndex, -, dQ⟩
    · exact absurd counts (none c cMember cIndex)
    · rw [dQ, charge_unique tailC dMember cMember (dIndex.trans cIndex.symm)]
  obtain ⟨d, dMember, dIndex, -⟩ :=
    (Run.nil.snoc step).departure_charge_of_assigned v.toNat vv w found foundB unset set
  refine ⟨a, b, pre, step, post, site, ?_, fun x hx => ?_, ?_, ?_⟩
  · refine List.any_eq_true.mpr ⟨d, ?_, by simpa using dIndex⟩
    simpa [Run.departureCharges] using dMember
  · exact (Option.some.inj (found.symm.trans hx)) ▸ unset
  · exact (Array.getElem?_eq_some_iff.mp found).1
  · simp only [exitQEq, amount, effectiveAt, found, Option.map_some, Option.getD_some]

/-- Within one epoch, a key's balance rises at most by its block credits.

A slot step inside the epoch keeps the balances.

A block step counts the net rise of the balance across it. -/
private theorem same_epoch_balance_le (i high : ℕ) {c a : ForkedBeaconState preset}
    (r : Run config checks c a) (early : a.fork < .glamsterdam)
    (same : getCurrentEpoch a.state = getCurrentEpoch c.state)
    (endEpoch : (getCurrentEpoch a.state).toNat ≤ high + 1) :
    actualBalanceAt a i ≤ actualBalanceAt c i + netScan i high r +
      (creditScan (fun _ => false) (fun s => decide (s ≠ .rewards)) i high r) := by
  refine Run.induction_of_same_epoch (fun z r' => (getCurrentEpoch z.state).toNat ≤ high + 1 →
      actualBalanceAt z i ≤ actualBalanceAt c i + netScan i high r' +
        (creditScan (fun _ => false) (fun s => decide (s ≠ .rewards)) i high r'))
    (fun _ => by simp [netScan_nil, creditScan_nil]) ?_ ?_ r early same endEpoch
  · intro f s t engine signed due ok pre' _ prior within
    have epoch : (getCurrentEpoch t).toNat = (getCurrentEpoch s).toNat := by
      simp only [getCurrentEpoch, processBlock_slot (applySignedBlock_ok ok).2.1]
    have before := prior (by simp only at within ⊢; omega)
    have net := netScan_snoc i high pre' (Step.block engine signed due ok)
    have credit := creditScan_snoc (fun _ => false) (fun s => decide (s ≠ .rewards)) i high
      pre' (Step.block engine signed due ok)
    simp only at within net credit
    simp only [show (getCurrentEpoch s).toNat ≤ high + 1 by omega, ↓reduceIte] at net credit
    rw [net, credit]
    simp only [stepNet]
    omega
  · intro middle last cached next pre' ok lastEq cachedOk kept prior within
    subst lastEq
    obtain ⟨_, _, _, _, rfl⟩ := processSlot_ok cachedOk
    have net := netScan_snoc i high pre' (Step.slot ok)
    have credit := creditScan_snoc (fun _ => false) (fun s => decide (s ≠ .rewards)) i high
      pre' (Step.slot ok)
    simp only at within kept
    rw [kept] at within
    have before := prior within
    simp only [within, ↓reduceIte] at net credit
    rw [net, credit]
    simp only [stepNet, actualBalanceAt] at before ⊢
    omega

/-- A slot step that stays in its epoch records no balance event.

It is no epoch's last slot, so no epoch pass runs.

From Electra, the upgrades record no crossing. -/
private theorem slot_events_nil {u w : ForkedBeaconState preset}
    (ok : advanceSlotAcross config checks u = .ok w) (electra : .pectra ≤ u.fork)
    (early : w.fork < .glamsterdam) (same : getCurrentEpoch w.state = getCurrentEpoch u.state)
    {events : List (BalanceEvent preset)}
    (replayed : (Step.slot ok : Step config checks u w).balanceEvents = .ok events) :
    events = [] := by
  obtain ⟨advanced, _, crossings, -, upgrades, -, crossingOk, branch⟩ :=
    Step.balanceEvents_slot ok early replayed
  have noCrossings : crossings = [] :=
    DirectSafety.Apriori.Internal.upgradeBalanceReplay_electra_nil
      (u := ⟨u.fork, advanced⟩) electra crossingOk
  rcases branch with ⟨_, eventsEq⟩ | ⟨middle, updated, recorded, recordOk, updatedOk,
      validatorsEq, _, eventsEq, next, nextNat, nextSlot, nextMod, -⟩
  · rw [eventsEq, noCrossings]
  · exfalso
    have mod0 := congrArg UInt64.toNat nextMod
    rw [UInt64.toNat_mod] at mod0
    have sameNat := congrArg UInt64.toNat same
    rw [getCurrentEpoch_toNat, getCurrentEpoch_toNat,
      (processUpgrades_slot upgrades).trans nextSlot, nextNat, Nat.succ_div] at sameNat
    rw [nextNat] at mod0
    have dvd := Nat.dvd_of_mod_eq_zero mod0
    simp only [dvd, ↓reduceIte] at sameNat
    omega

/-- Within one epoch, a key has no consolidation credit and no deposit credit.

A block step records no consolidation, and a deposit of a block credits no balance.

A slot step inside the epoch records no event.

Each consolidation and deposit event of the run lies in a slot step that crosses an epoch.

So the run has none. -/
private theorem same_epoch_no_epoch_credits (v : ValidatorIndex) (high : ℕ)
    {c a : ForkedBeaconState preset}
    (r : Run config checks c a) (electra : .pectra ≤ c.fork) (early : a.fork < .glamsterdam)
    (same : getCurrentEpoch a.state = getCurrentEpoch c.state) :
    (creditScan (fun s => decide (s = .consolidations)) (fun s => decide (s = .consolidations))
        v.toNat high r) = 0 ∧
      (creditScan (fun _ => false) (fun s => decide (s = .deposits)) v.toNat high r) = 0 := by
  obtain ⟨events, replayed⟩ := r.balanceEvents_ok early high
  obtain ⟨deposits, consolidations⟩ := run_located r electra early high replayed
  -- a slot step of the run starts and ends in the epoch of the run, so it records no event
  have quiet : ∀ (u w : ForkedBeaconState preset) (ok : advanceSlotAcross config checks u = .ok w)
      (es : List (BalanceEvent preset)), r.Contains (Step.slot ok) →
      (Step.slot ok : Step config checks u w).balanceEvents = .ok es → es = [] := by
    intro u w ok es contained replayedEs
    obtain ⟨p1, p2, rfl⟩ := r.contains_split (Step.slot ok) contained
    have uElectra : .pectra ≤ u.fork := Nat.le_trans electra (fork_le_of_chainSteps p1.chainSteps)
    have wEarly : w.fork < .glamsterdam :=
      Nat.lt_of_le_of_lt (fork_le_of_chainSteps p2.chainSteps) early
    have lo := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps p1.chainSteps)
    have mid := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps
      (Run.nil.snoc (Step.slot ok) : Run config checks u w).chainSteps)
    have hi := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps p2.chainSteps)
    have sameNat := congrArg UInt64.toNat same
    exact slot_events_nil ok uElectra wEarly (UInt64.toNat_inj.mp (by omega)) replayedEs
  refine ⟨Nat.le_zero.mp ((scan_le_events _ _ (· = .consolidations) (by intro s; simp) r high v
    replayed).trans (le_of_eq (List.sum_eq_zero fun n member => ?_))),
    Nat.le_zero.mp ((scan_le_events _ _ (· = .deposits) (by intro s; simp) r high v
    replayed).trans (le_of_eq (List.sum_eq_zero fun n member => ?_)))⟩
  · obtain ⟨e, filtered, rfl⟩ := List.mem_map.mp member
    obtain ⟨inEvents, sourceEq⟩ := List.mem_filter.mp filtered
    obtain ⟨u, w, ok, es, contained, replayedEs, inStep⟩ :=
      consolidations e inEvents (of_decide_eq_true sourceEq)
    simp [quiet u w ok es contained replayedEs] at inStep
  · obtain ⟨e, filtered, rfl⟩ := List.mem_map.mp member
    obtain ⟨inEvents, sourceEq⟩ := List.mem_filter.mp filtered
    rcases deposits e inEvents (of_decide_eq_true sourceEq) with unconditional |
      ⟨u, w, ok, es, contained, replayedEs, inStep, -⟩
    · have := unconditional v.toNat
      simp only [keyCredit]
      omega
    · simp [quiet u w ok es contained replayedEs] at inStep

/-- A state that starts its epoch on a run from genesis is within the bands of hysteresis.

The steps of the run before it are all in earlier epochs.

So the last one is a slot step that crossed into the epoch of `b`.

The epoch transition of that step sets the bands, and the upgrades of the slot keep them.

A run with no step ends at genesis, which is a Phase 0 state, so it ends before Fulu. -/
private theorem hysteresis_at_epoch_start
    (h : Setting config checks g split fin pulled anc counted V)
    {b : BeaconState preset fork} (toB : Run config checks g ⟨fork, b⟩)
    (earlier : ∀ {u w : ForkedBeaconState preset} (step : Step config checks u w),
      toB.Contains step → (getCurrentEpoch u.state).toNat < (getCurrentEpoch b).toNat) :
    Hysteresis b := by
  have crossed : ∀ {x : ForkedBeaconState preset} (run : Run config checks g x),
      x = ⟨fork, b⟩ → (∀ {u w : ForkedBeaconState preset} (st : Step config checks u w),
        run.Contains st → (getCurrentEpoch u.state).toNat < (getCurrentEpoch b).toNat) →
      Hysteresis b := by
    intro x run hx before
    cases run with
    | nil =>
      have fulu : .fusaka ≤ g.fork := by rw [hx]; exact h.fulu
      obtain ⟨_, _, _, initialized⟩ := h.genesis
      obtain ⟨phase0, -⟩ := initializeBeaconStateFromEth1_ok initialized
      exact absurd (Nat.lt_of_le_of_lt fulu phase0) (by decide)
    | @snoc middle last pre' st =>
      subst hx
      have crossing := before st (.last pre' st)
      have ok := DirectSafety.Apriori.Internal.slot_of_crossing st crossing
      have first : b.slot % preset.SLOTS_PER_EPOCH = 0 := by
        have next : b.slot.toNat = middle.state.slot.toNat + 1 :=
          (advanceSlotAcross_cases ok).1
        by_contra inside
        have notDvd : ¬ preset.SLOTS_PER_EPOCH.toNat ∣ middle.state.slot.toNat + 1 := by
          rw [Nat.dvd_iff_mod_eq_zero, ← next]
          intro zero
          exact inside (UInt64.toNat_inj.mp (by rw [UInt64.toNat_mod, zero, UInt64.toNat_zero]))
        simp only [getCurrentEpoch_toNat, next, Nat.succ_div, notDvd, ↓reduceIte,
          Nat.add_zero, Nat.lt_irrefl] at crossing
      exact hysteresis_of_run_slot h.genesis h.bands h.caps h.facts.activation pre' ok h.early
        first
  exact crossed toB rfl earlier

/-- A key charged at a step is in the registry at any state of the epoch that it started.

The state `n` has the bands of hysteresis.

A run leads from `n` to the step's start `a`, inside one epoch.

There the key's balance is within the upward band of its effective balance.

The effective balance stays to the charge.

Over the rest of that epoch the balance rises at most by the key's block credits.

The key is active at the charge step, so it is in the registry at `n`. -/
private theorem charge_start_at (h : Setting config checks g split fin pulled anc counted V)
    (highC : ℕ) {n a b : ForkedBeaconState preset} (rest : Run config checks n a)
    (step : Step config checks a b) (i : ℕ) (inside : i < a.state.validators.data.size)
    (unset : ∀ w, a.state.validators.data[i]? = some w → w.exitEpoch = FAR_FUTURE_EPOCH)
    (aFulu : .fusaka ≤ a.fork) (aEarly : a.fork < .glamsterdam)
    (same : getCurrentEpoch n.state = getCurrentEpoch a.state) (hyst : Hysteresis n.state)
    (endEpoch : (getCurrentEpoch a.state).toNat ≤ highC + 1)
    (charged : step.departureCharges.any (·.index == i) = true) :
    i < n.state.validators.data.size ∧ effectiveAt n i = effectiveAt a i ∧
      min (actualBalanceAt n i) (PinTerms.capAt n i) ≤ effectiveAt n i + preset.upwardBand ∧
      (effectiveAt n i < PinTerms.capAt n i →
        actualBalanceAt n i ≤ effectiveAt n i + preset.upwardBand) ∧
      actualBalanceAt a i ≤ actualBalanceAt n i + netScan i highC rest +
        (creditScan (fun _ => false) (fun s => decide (s ≠ .rewards)) i highC rest) := by
  -- the key is active at the charge, so it is in the registry at the start of the epoch
  obtain ⟨charge, member, index⟩ := List.any_eq_true.mp charged
  obtain ⟨w, later, assigned, -⟩ := (Run.nil.snoc step).departure_charge_exit charge
    (by simpa [Run.departureCharges] using member)
  rw [beq_iff_eq.mp index] at later
  obtain ⟨v, found⟩ : ∃ v, a.state.validators.data[i]? = some v :=
    ⟨_, Array.getElem?_eq_getElem inside⟩
  have far := unset v found
  have activated := step.chainStep.exit_assigned_activated (Nat.le_trans (by decide) aFulu)
    found later far assigned
  have activeA : isActiveAt a.state (getCurrentEpoch a.state) i = true := by
    refine isActiveAt_eq_true_iff.mpr ⟨v, found, ?_⟩
    have below : getCurrentEpoch a.state < FAR_FUTURE_EPOCH := by
      rw [UInt64.lt_iff_toNat_lt, getCurrentEpoch_toNat]
      have := a.state.slot.toNat_lt
      have := Nat.div_le_div_left (a := a.state.slot.toNat) h.twoSlots (by decide : 0 < 2)
      have : FAR_FUTURE_EPOCH.toNat = 2 ^ 64 - 1 := rfl
      omega
    simp only [isActiveValidator, Bool.and_eq_true, decide_eq_true_eq, far]
    exact ⟨activated, below⟩
  have activeN : isActiveAt n.state (getCurrentEpoch a.state) i = true := by
    rw [← activeKept_of_chainSteps rest.chainSteps _
      (same ▸ getCurrentEpoch_le_activityFixedEpoch n.state)]
    exact activeA
  obtain ⟨vn, foundN, -⟩ := isActiveAt_eq_true_iff.mp activeN
  have insideN : i < n.state.validators.data.size := (Array.getElem?_eq_some_iff.mp foundN).1
  have up : effectiveAt n i < PinTerms.capAt n i →
      actualBalanceAt n i ≤ effectiveAt n i + preset.upwardBand := by
    intro lt
    cases bal : n.state.balances.data[i]? with
    | none => simp [actualBalanceAt, bal]
    | some balance =>
      simp only [effectiveAt, PinTerms.capAt, foundN, Option.map_some, Option.getD_some] at lt
      simpa [actualBalanceAt, effectiveAt, bal, foundN] using
        hyst.up i vn balance foundN bal (UInt64.lt_iff_toNat_lt.mpr lt)
  refine ⟨insideN, (DirectSafety.run_same_epoch_effective rest aEarly same.symm i insideN).symm,
    ?_, up, same_epoch_balance_le i highC rest aEarly same.symm endEpoch⟩
  by_cases lt : effectiveAt n i < PinTerms.capAt n i
  · exact (Nat.min_le_left _ _).trans (up lt)
  · exact (Nat.min_le_right _ _).trans (by omega)

/-- The start-of-epoch half of the charge arm, for a charge after the split's epoch.

The run to the charge crosses an epoch boundary, at the state `c`.

There the key's balance is within the upward band of its effective balance.

The effective balance stays to the charge.

Over the rest of that epoch the balance rises at most by the key's block credits.

The key is active at the charge step, so it is in the registry at `c`.

The fork of `a` is before Gloas, since `post` runs on to C.

The epoch of `a` is at most `highC + 1`, since `post` runs on to C. -/
private theorem charge_epoch_start (h : Setting config checks g split fin pulled anc counted V)
    (highC : ℕ) {y : ForkedBeaconState preset} (yFork : y.fork = fork)
    {a b : ForkedBeaconState preset} (pre : Run config checks ⟨fork, split⟩ a)
    (step : Step config checks a b) (post : Run config checks b y) (i : ℕ)
    (inside : i < a.state.validators.data.size)
    (unset : ∀ w, a.state.validators.data[i]? = some w → w.exitEpoch = FAR_FUTURE_EPOCH)
    (started : (getCurrentEpoch split).toNat < (getCurrentEpoch a.state).toNat)
    (endEpochC : (getCurrentEpoch y.state).toNat ≤ highC + 1)
    (charged : step.departureCharges.any (·.index == i) = true) :
    ∃ (c : ForkedBeaconState preset) (before : Run config checks ⟨fork, split⟩ c)
      (r : Run config checks c a), before.append r = pre ∧ i < c.state.validators.data.size ∧
      getCurrentEpoch c.state = getCurrentEpoch a.state ∧ effectiveAt c i = effectiveAt a i ∧
      min (actualBalanceAt c i) (PinTerms.capAt c i) ≤ effectiveAt c i + preset.upwardBand ∧
      (effectiveAt c i < PinTerms.capAt c i →
        actualBalanceAt c i ≤ effectiveAt c i + preset.upwardBand) ∧
      actualBalanceAt a i ≤ actualBalanceAt c i + netScan i highC r +
        (creditScan (fun _ => false) (fun s => decide (s ≠ .rewards)) i highC r) := by
  have aFork : a.fork = fork := fork_eq_of_run pre ((Run.nil.snoc step).append post)
    (by rw [yFork]; exact Nat.le_refl _)
  have aEarly : a.fork < .glamsterdam := by rw [aFork]; exact h.early
  have aFulu : .fusaka ≤ a.fork := by rw [aFork]; exact h.fulu
  have aCounted := UInt64.le_iff_toNat_le.mp
    (currentEpoch_le_of_chainSteps ((Run.nil.snoc step).append post).chainSteps)
  obtain ⟨z, n, pre0, ok, rest, cut, hz, hn⟩ :=
    Run.cross_split pre ((getCurrentEpoch a.state).toNat - 1) (by simp only; omega) (by omega)
  have same : getCurrentEpoch n.state = getCurrentEpoch a.state := UInt64.toNat_inj.mp (by omega)
  have zFulu : .fusaka ≤ z.fork := Nat.le_trans h.fulu (fork_le_of_chainSteps pre0.chainSteps)
  have nEarly : n.fork < .glamsterdam :=
    Nat.lt_of_le_of_lt (fork_le_of_chainSteps rest.chainSteps) aEarly
  -- the bands of hysteresis at the start of the epoch
  have hyst := DirectSafety.Apriori.Internal.hysteresis_of_crossing_slot ok h.bands zFulu nEarly
    (by omega)
  obtain ⟨insideN, effEq, floor, up, rise⟩ := charge_start_at h highC rest step i inside unset
    aFulu aEarly same hyst (by omega) charged
  exact ⟨n, pre0.snoc (Step.slot ok), rest, cut.symm, insideN, same, effEq, floor, up, rise⟩

/-- The switch case of the start of the epoch.

A key at its cap that switches to compounding in the epoch keeps at most the old cap of balance.

The switch moves the balance beyond the old cap into the pending deposits.

The step that switches also takes the block credits that follow the switch in it.

So the credits are the gross ones: the net rise of that step can be zero while a credit is not. -/
private theorem charge_flip (h : Setting config checks g split fin pulled anc counted V)
    (highC : ℕ) {c a : ForkedBeaconState preset}
    (toC : Run config checks g c) (r : Run config checks c a) (i : ℕ)
    (inside : i < c.state.validators.data.size)
    (same : getCurrentEpoch c.state = getCurrentEpoch a.state)
    (sameFork : a.fork = fork) (cFork : c.fork = fork)
    (endEpoch : (getCurrentEpoch a.state).toNat ≤ highC + 1)
    (flipped : PinTerms.capAt c i ≠ PinTerms.capAt a i)
    (atCap : ¬ effectiveAt c i < PinTerms.capAt c i) :
    min (actualBalanceAt a i) (PinTerms.capAt a i) ≤ effectiveAt c i + grossScan i highC r +
      (creditScan (fun _ => false) (fun s => decide (s ≠ .rewards)) i highC r) := by
  classical
  have sameC : fork = c.fork := cFork.symm
  obtain ⟨cf, cs⟩ := c
  obtain ⟨af, as⟩ := a
  simp only at sameC sameFork endEpoch same
  have sameA : fork = af := sameFork.symm
  subst sameC sameA
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  -- the caps: the key's cap is the activation balance at C and the largest balance after
  have insideA : i < as.validators.data.size :=
    Nat.lt_of_lt_of_le inside (registryGrows_of_chainSteps r.chainSteps)
  obtain ⟨kindC, -, -⟩ := capAt_kind (z := cs) h i inside
  obtain ⟨kindA, -, -⟩ := capAt_kind (z := as) h i insideA
  have capMono := cap_le_cap_of_run h.caps r h.early i
  have minMax := UInt64.le_iff_toNat_le.mp h.caps.compounding
  have capC : PinTerms.capAt (⟨fork, cs⟩ : ForkedBeaconState preset) i =
      preset.MIN_ACTIVATION_BALANCE.toNat := by omega
  have capA : PinTerms.capAt (⟨fork, as⟩ : ForkedBeaconState preset) i =
      preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat := by omega
  have strict : preset.MIN_ACTIVATION_BALANCE.toNat <
      PinTerms.capAt (⟨fork, as⟩ : ForkedBeaconState preset) i := by omega
  have effC : preset.MIN_ACTIVATION_BALANCE.toNat ≤
      effectiveAt (⟨fork, cs⟩ : ForkedBeaconState preset) i := by omega
  -- the run splits at the step that makes the key compound
  obtain ⟨m, n, pre, step, post, cut, flatM, largeN, balN, sameEpoch⟩ :=
    Run.flip_split r h.early h.fulu (Run.invariant (Genesis.invariant h.genesis)
      toC) i (by omega) strict
  obtain ⟨mf, ms⟩ := m
  obtain ⟨nf, ns⟩ := n
  have sameM : fork = mf :=
    (fork_eq_of_run pre ((Run.nil.snoc step).append post) (Nat.le_refl _)).symm
  have sameN : fork = nf := (fork_eq_of_run (pre.snoc step) post (Nat.le_refl _)).symm
  subst sameM sameN
  have epochPre := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps pre.chainSteps)
  have epochStep := UInt64.le_iff_toNat_le.mp step.chainStep.currentEpoch_le
  have epochPost := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps post.chainSteps)
  have sameNat := congrArg UInt64.toNat same
  simp only at epochPre epochStep epochPost sameNat sameEpoch
  have epochsEq : (getCurrentEpoch ns).toNat = (getCurrentEpoch as).toNat := by omega
  -- the credits of the step that switches are gross, since it is a block step
  have gross : stepCredit (fun _ => true) (fun _ => true) i step ≤
      stepCredit (fun s => decide (s = .rewards ∨ s = .slashings ∨ s = .sync)) (fun _ => false) i
        step := by
    cases step with
    | slot ok =>
      exact absurd rfl (step_flip_not_slot (Step.slot ok) h.early h.fulu i
        (Nat.lt_of_lt_of_le inside (registryGrows_of_chainSteps pre.chainSteps))
        (by omega) largeN ok)
    | block engine signed due ok =>
      exact block_credit_le_gross (due := due) (ok := ok) (toC.append pre)
        h.genesis h.early electra i
  -- after the switch the balance rises by the credits alone
  have after := same_epoch_balance_le i highC post h.early (UInt64.toNat_inj.mp epochsEq.symm)
    endEpoch
  obtain ⟨eventsPost, replayedPost⟩ := post.balanceEvents_ok h.early highC
  have net := (credits_le_sources (toC.append (pre.snoc step)) h.genesis post
    h.early (Nat.le_trans (by decide) h.fulu) i highC replayedPost).2.1
  subst cut
  have grossAll := grossScan_append i highC (pre.snoc step) post
  have grossStep := grossScan_snoc i highC pre step
  have creditAll := creditScan_append (fun _ => false) (fun s => decide (s ≠ .rewards)) i highC
    (pre.snoc step) post
  have within :
      (getCurrentEpoch (⟨fork, ms⟩ : ForkedBeaconState preset).state).toNat ≤ highC + 1 := by
    show (getCurrentEpoch ms).toNat ≤ highC + 1
    omega
  simp only [within, ↓reduceIte] at grossStep
  rw [grossAll, grossStep, creditAll]
  rw [capA]
  omega

/-- The exact rise fold: from a run that has the key's charge, its balance rises by the steps after.

Each step adds its epoch rewards, which `riseScan` sums once the charge is seen.

It also adds its net block credits and the credits of its slot steps other than the rewards.

The rewards that `riseScan` sums do not fall along the run. -/
private theorem rise_fold (i high : ℕ) {x m : ForkedBeaconState preset}
    (pre : Run config checks x m) (seen : (riseScan i high pre).1 = true) :
    ∀ {y : ForkedBeaconState preset} (t : Run config checks m y), y.fork < .glamsterdam →
      (getCurrentEpoch y.state).toNat ≤ high + 1 →
      (riseScan i high (pre.append t)).1 = true ∧
      (riseScan i high pre).2 ≤ (riseScan i high (pre.append t)).2 ∧
      actualBalanceAt y i + (riseScan i high pre).2 ≤ actualBalanceAt m i +
        (riseScan i high (pre.append t)).2 + netScan i high t +
        (creditScan (fun _ => false) (fun s => decide (s ≠ .rewards)) i high t) := by
  intro y t
  induction t with
  | nil =>
    intro _ _
    refine ⟨seen, Nat.le_refl _, ?_⟩
    show actualBalanceAt m i + (riseScan i high pre).2 ≤
      actualBalanceAt m i + (riseScan i high pre).2 + 0 + 0
    omega
  | @snoc n y t step ih =>
    intro early endEpoch
    have nEarly := Nat.lt_of_le_of_lt step.chainStep.fork_le early
    have ny := UInt64.le_iff_toNat_le.mp step.chainStep.currentEpoch_le
    obtain ⟨flag, mono, fold⟩ := ih nEarly (by omega)
    have within : (getCurrentEpoch n.state).toNat ≤ high + 1 := by omega
    have bound := PinKeyFloor.step_balance_le step early i
    have net := netScan_snoc i high t step
    have credit := creditScan_snoc (fun _ => false) (fun s => decide (s ≠ .rewards)) i high
      t step
    simp only [within, ↓reduceIte] at net credit
    change (riseScan i high ((pre.append t).snoc step)).1 = true ∧
      (riseScan i high pre).2 ≤ (riseScan i high ((pre.append t).snoc step)).2 ∧
      actualBalanceAt y i + (riseScan i high pre).2 ≤ actualBalanceAt m i +
        (riseScan i high ((pre.append t).snoc step)).2 + netScan i high (t.snoc step) +
        (creditScan (fun _ => false) (fun s => decide (s ≠ .rewards)) i high (t.snoc step))
    simp only [riseScan, flag, Bool.true_or, true_or, true_and, within, ↓reduceIte]
    rw [net, credit]
    exact ⟨by omega, by omega⟩

/-- A key with an assigned exit has no larger cap at the end of a run than at its start.

Compounding needs an unset exit, so the run cannot switch the key to it. -/
private theorem capAt_le_of_exit {x z : ForkedBeaconState preset} (r : Run config checks x z)
    (caps : CapOrder preset) (electraX : .pectra ≤ x.fork) (electraZ : .pectra ≤ z.fork)
    (early : z.fork < .glamsterdam) (i : ℕ) {w : Validator}
    (found : x.state.validators.data[i]? = some w) (assigned : w.exitEpoch ≠ FAR_FUTURE_EPOCH) :
    PinTerms.capAt z i ≤ PinTerms.capAt x i := by
  obtain ⟨wz, foundZ, kept⟩ := r.compounding_of_exit_assigned caps.activation caps.compounding
    early i w found assigned
  rw [capAt_of_found electraZ foundZ, capAt_of_found electraX found]
  have order := UInt64.le_iff_toNat_le.mp caps.compounding
  cases hz : hasCompoundingWithdrawalCredential wz <;>
    cases hb : hasCompoundingWithdrawalCredential w <;> simp_all

/-- The exact rise of a charged key's balance after its charge.

The cap is fixed from the state `b` after the step that starts the exit.

The step itself can switch the key to compounding: one payload can switch it, then start its exit.

So the cap is at most `capAt b` on the whole run, and on `post`.

From `a` the balance rises by the epoch rewards that `riseScan` sums, and by the other credits.

From `b` it rises by the same rewards and the credits of `post`. -/
private theorem charge_rise_fold (h : Setting config checks g split fin pulled anc counted V)
    {xs : BeaconState preset fork}
    (highC : ℕ) {y : ForkedBeaconState preset} (yFork : y.fork = fork)
    (endEpochC : (getCurrentEpoch y.state).toNat ≤ highC + 1)
    {a b : ForkedBeaconState preset} (pre : Run config checks ⟨fork, xs⟩ a)
    (step : Step config checks a b) (post : Run config checks b y) (i : ℕ)
    (charged : step.departureCharges.any (·.index == i) = true) :
    (∀ z ∈ ((Run.nil.snoc step).append post).balancePath,
      PinTerms.capAt z i ≤ PinTerms.capAt b i) ∧
    (∀ z ∈ post.balancePath, PinTerms.capAt z i ≤ PinTerms.capAt b i) ∧
    (∀ z ∈ ((Run.nil.snoc step).append post).balancePath, actualBalanceAt z i ≤
      actualBalanceAt a i + (riseScan i highC ((pre.snoc step).append post)).2 +
        netScan i highC ((Run.nil.snoc step).append post) +
        (creditScan (fun _ => false) (fun s => decide (s ≠ .rewards)) i highC
          ((Run.nil.snoc step).append post))) ∧
    ∀ z ∈ post.balancePath, actualBalanceAt z i ≤
      actualBalanceAt b i + (riseScan i highC ((pre.snoc step).append post)).2 +
        netScan i highC post +
        (creditScan (fun _ => false) (fun s => decide (s ≠ .rewards)) i highC post) := by
  have yBack : y.fork ≤ fork := by rw [yFork]; exact Nat.le_refl _
  have yEarly : y.fork < .glamsterdam := by rw [yFork]; exact h.early
  have aFork : a.fork = fork := fork_eq_of_run pre ((Run.nil.snoc step).append post) yBack
  have bFork : b.fork = fork := fork_eq_of_run (pre.snoc step) post yBack
  have aFulu : .fusaka ≤ a.fork := by rw [aFork]; exact h.fulu
  have bEarly : b.fork < .glamsterdam := by rw [bFork]; exact h.early
  have stepPath : ∀ p ∈ step.balancePath, p = a ∨ p = b := by
    cases step with
    | block => intro p hp; simpa [Step.balancePath] using hp
    | slot ok =>
      obtain ⟨next, advanced, upgraded⟩ := bind_ok_iff.mp ok
      have same := DirectSafety.Apriori.Internal.processUpgrades_eq_of_window upgraded
        aFulu bEarly
      subst same
      intro p hp
      simpa [Step.balancePath, advanced, Except.toOption] using hp
  have bCounted := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps post.chainSteps)
  have ab := UInt64.le_iff_toNat_le.mp step.chainStep.currentEpoch_le
  have within : (getCurrentEpoch a.state).toNat ≤ highC + 1 := by omega
  -- the charge: the key's exit is set at `b`
  obtain ⟨charge, member, index⟩ := List.any_eq_true.mp charged
  obtain ⟨w, foundB, assigned, -⟩ := (Run.nil.snoc step).departure_charge_exit charge
    (by simpa [Run.departureCharges] using member)
  rw [beq_iff_eq.mp index] at foundB
  -- a state of the path of `post` splits it
  have splitPost : ∀ z ∈ post.balancePath, ∃ (r1 : Run config checks b z)
      (r2 : Run config checks z y), r1.append r2 = post := fun z hz => by
    obtain ⟨r1, r2, eq⟩ := balancePath_endpoint post (Run.nil : Run config checks y y)
      (by rw [bFork]; exact yBack) hz
    exact ⟨r1, r2, eq⟩
  -- the cap: compounding needs an unset exit, so the cap is fixed from `b`
  have capPost : ∀ z ∈ post.balancePath, PinTerms.capAt z i ≤ PinTerms.capAt b i := by
    intro z hz
    obtain ⟨r1, r2, -⟩ := splitPost z hz
    have zFork : z.fork = fork := fork_eq_of_run ((pre.snoc step).append r1) r2 yBack
    exact capAt_le_of_exit r1 h.caps (by rw [bFork]; exact Nat.le_trans (by decide) h.fulu)
      (by rw [zFork]; exact Nat.le_trans (by decide) h.fulu) (by rw [zFork]; exact h.early) i
      foundB assigned
  -- the fold from `b`, through the charged prefix
  have seen : (riseScan i highC (pre.snoc step)).1 = true := by
    simp [riseScan, charged]
  have riseStep : (riseScan i highC (pre.snoc step)).2 =
      (riseScan i highC pre).2 + PinKeyFloor.epochRewards i step := by
    simp [riseScan, charged, within]
  have stepBound := PinKeyFloor.step_balance_le step bEarly i
  have netStep : netScan i highC ((Run.nil.snoc step).append post) =
      stepNet i step + netScan i highC post := by
    rw [netScan_append, netScan_snoc, netScan_nil]
    simp [within]
  have creditStep : (creditScan (fun _ => false) (fun s => decide (s ≠ .rewards)) i highC
      ((Run.nil.snoc step).append post)) =
      stepCredit (fun _ => false) (fun s => decide (s ≠ .rewards)) i step +
        (creditScan (fun _ => false) (fun s => decide (s ≠ .rewards)) i highC post) := by
    rw [creditScan_append, creditScan_snoc, creditScan_nil]
    simp [within]
  have fromB : ∀ z ∈ post.balancePath, actualBalanceAt z i + (riseScan i highC (pre.snoc step)).2 ≤
      actualBalanceAt b i + (riseScan i highC ((pre.snoc step).append post)).2 +
        netScan i highC post +
        (creditScan (fun _ => false) (fun s => decide (s ≠ .rewards)) i highC post) := by
    intro z hz
    obtain ⟨r1, r2, eq⟩ := splitPost z hz
    have zEarly : z.fork < .glamsterdam :=
      Nat.lt_of_le_of_lt (fork_le_of_chainSteps r2.chainSteps) yEarly
    have zCounted := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps r2.chainSteps)
    obtain ⟨flag, -, fold⟩ := rise_fold i highC (pre.snoc step) seen r1 zEarly (by omega)
    obtain ⟨-, mono, -⟩ := rise_fold i highC ((pre.snoc step).append r1) flag r2 yEarly endEpochC
    rw [← Run.append_assoc, eq] at mono
    have net := netScan_append i highC r1 r2
    have credit := creditScan_append (fun _ => false) (fun s => decide (s ≠ .rewards)) i highC r1 r2
    rw [eq] at net credit
    omega
  refine ⟨fun z hz => ?_, capPost, fun z hz => ?_, fun z hz => ?_⟩
  · rw [Run.balancePath_append] at hz
    rcases List.mem_append.mp hz with head | tail
    · simp only [Run.balancePath, List.mem_append, List.mem_singleton] at head
      have capA := cap_le_cap_of_run h.caps (Run.nil.snoc step) bEarly i
      rcases head with rfl | onStep
      · exact capA
      · rcases stepPath z onStep with rfl | rfl
        · exact capA
        · exact Nat.le_refl _
    · exact capPost z (List.mem_of_mem_tail tail)
  · have riseLe := (rise_fold i highC (pre.snoc step) seen post yEarly endEpochC).2.1
    rw [Run.balancePath_append] at hz
    rcases List.mem_append.mp hz with head | tail
    · simp only [Run.balancePath, List.mem_append, List.mem_singleton] at head
      rcases head with rfl | onStep
      · omega
      · rcases stepPath z onStep with rfl | rfl
        · omega
        · rw [netStep, creditStep]
          omega
    · have := fromB z (List.mem_of_mem_tail tail)
      rw [netStep, creditStep]
      omega
  · have := fromB z hz
    omega

/-- The credits of a charged key from the epoch's start to a state `y`.

They are at most those of `propC`, `whistC` and sync.

The key is not yet withdrawable at `y` (`held`), so its deposits from the charge on are postponed.

The credits before the charge are the gross ones, which bound the net ones.

The first bound adds the credits of the run from the charge on, read net.

The second bound adds the whole credits of the charge step, then those of `post`, read net.

It needs the charge step to be a block step.

A slot step's whole credits hold its epoch rewards, which none of the three sources pays. -/
private theorem charge_credits_to (h : Setting config checks g split fin pulled anc counted V)
    {xs : BeaconState preset fork} (toX : Run config checks g ⟨fork, xs⟩)
    {y : ForkedBeaconState preset} (yFork : y.fork = fork)
    (tailY : Run config checks ⟨fork, xs⟩ y) (highC : ℕ)
    (endEpochY : (getCurrentEpoch y.state).toNat ≤ highC + 1)
    {eventsY : List (BalanceEvent preset)} (replayedY : tailY.balanceEvents highC = .ok eventsY)
    {v : ValidatorIndex}
    {a b c : ForkedBeaconState preset} (pre : Run config checks ⟨fork, xs⟩ a)
    (step : Step config checks a b) (post : Run config checks b y)
    (site : (pre.snoc step).append post = tailY)
    (charged : step.departureCharges.any (·.index == v.toNat) = true)
    (before : Run config checks ⟨fork, xs⟩ c) (r : Run config checks c a)
    (cut : before.append r = pre) (same : getCurrentEpoch c.state = getCurrentEpoch a.state)
    (held : ∀ w, b.state.validators.data[v.toNat]? = some w →
      (getCurrentEpoch y.state).toNat < w.withdrawableEpoch.toNat) :
    (grossScan v.toNat highC r + (creditScan (fun _ => false) (fun s => decide (s ≠ .rewards))
        v.toNat highC r) +
      (netScan v.toNat highC ((Run.nil.snoc step).append post) +
        (creditScan (fun _ => false) (fun s => decide (s ≠ .rewards)) v.toNat highC
          ((Run.nil.snoc step).append post))) ≤
      propC tailY highC v.toNat + whistC tailY highC v.toNat + syncCr eventsY v.toNat) ∧
    ((∀ ok, step ≠ Step.slot ok) →
      grossScan v.toNat highC r + (creditScan (fun _ => false) (fun s => decide (s ≠ .rewards))
        v.toNat highC r) + stepCredit (fun _ => true) (fun _ => true) v.toNat step +
      (netScan v.toNat highC post +
        (creditScan (fun _ => false) (fun s => decide (s ≠ .rewards)) v.toNat highC post)) ≤
      propC tailY highC v.toNat + whistC tailY highC v.toNat + syncCr eventsY v.toNat) := by
  subst site
  subst cut
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  have yBack : y.fork ≤ fork := by rw [yFork]; exact Nat.le_refl _
  have yEarly : y.fork < .glamsterdam := by rw [yFork]; exact h.early
  have cFork : c.fork = fork :=
    fork_eq_of_run before (r.append ((Run.nil.snoc step).append post)) yBack
  have aFork : a.fork = fork :=
    fork_eq_of_run (before.append r) ((Run.nil.snoc step).append post) yBack
  have bFork : b.fork = fork := fork_eq_of_run ((before.append r).snoc step) post yBack
  have cEarly : c.fork < .glamsterdam := by rw [cFork]; exact h.early
  have aEarly : a.fork < .glamsterdam := by rw [aFork]; exact h.early
  have bEarly : b.fork < .glamsterdam := by rw [bFork]; exact h.early
  have cElectra : .pectra ≤ c.fork := by rw [cFork]; exact electra
  have aElectra : .pectra ≤ a.fork := by rw [aFork]; exact electra
  have aEpoch : (getCurrentEpoch a.state).toNat ≤ highC + 1 :=
    Nat.le_trans (UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps
      ((Run.nil.snoc step).append post).chainSteps)) endEpochY
  obtain ⟨e0, h0⟩ := before.balanceEvents_ok cEarly highC
  obtain ⟨er, hr⟩ := r.balanceEvents_ok aEarly highC
  obtain ⟨es, hs⟩ := step.balanceEvents_ok bEarly
  obtain ⟨ep, hp⟩ := post.balanceEvents_ok yEarly highC
  have one : (Run.nil.snoc step : Run config checks a b).balanceEvents highC = .ok es := by
    simp [Run.balanceEvents, aEpoch, hs, pure, Except.pure]
    rfl
  have hR := DirectSafety.Apriori.Internal.balanceEvents_append _ post highC one hp
  have hX := DirectSafety.Apriori.Internal.balanceEvents_append r _ highC hr hR
  have eqX : r.append ((Run.nil.snoc step).append post) = (r.snoc step).append post :=
    Run.append_assoc r (Run.nil.snoc step) post
  have eqTail : ((before.append r).snoc step).append post =
      before.append (r.append ((Run.nil.snoc step).append post)) := by
    rw [Run.append_assoc, Run.append_assoc]
    rfl
  rw [eqTail, DirectSafety.Apriori.Internal.balanceEvents_append _ _ highC h0 hX] at replayedY
  obtain rfl := Except.ok.inj replayedY
  rw [eqTail]
  -- the key has no deposit credit from the epoch's start to C
  obtain ⟨_, w, foundA, foundB, unset, set⟩ := charge_exits step charged
  have inside : v.toNat < a.state.validators.data.size := (Array.getElem?_eq_some_iff.mp foundA).1
  have exited := exitEpoch_toNat_lt_of_ne_far set
  have depR : (creditScan (fun _ => false) (fun s => decide (s = .deposits)) v.toNat highC r) =
      0 := by
    refine Nat.le_zero.mp
      ((scan_le_events (fun _ => false) (fun s => decide (s = .deposits)) (· = .deposits)
        (by intro s; simp) r highC v hr).trans (Nat.le_of_eq ?_))
    refine PinKeys.Run.exiting_deposit_credit_zero_of_exited r cElectra aEarly highC hr v.toNat ?_
    intro u' w' ok contains es' replayedEs e inStep sourceEq
    exfalso
    obtain ⟨pre', post', -⟩ := Run.contains_split r (Step.slot ok) contains
    have fuluU : .fusaka ≤ u'.fork := Nat.le_trans (by rw [cFork]; exact h.fulu)
      (fork_le_of_chainSteps pre'.chainSteps)
    have earlyW : w'.fork < .glamsterdam :=
      Nat.lt_of_le_of_lt (fork_le_of_chainSteps post'.chainSteps) aEarly
    have strict :=
      (PinEventsKept.Step.deposit_input ok fuluU earlyW replayedEs e inStep sourceEq).2.2.2.2
    have e1 := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps pre'.chainSteps)
    have e2 := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps post'.chainSteps)
    have eq := congrArg UInt64.toNat same
    omega
  have depR' : (creditScan (fun _ => false) (fun s => decide (s = .deposits)) v.toNat highC
      ((Run.nil.snoc step).append post)) = 0 := by
    refine Nat.le_zero.mp
      ((scan_le_events (fun _ => false) (fun s => decide (s = .deposits)) (· = .deposits)
        (by intro s; simp) _ highC v hR).trans (Nat.le_of_eq ?_))
    exact PinKeys.Run.charge_deposit_credit_zero (toX.append (before.append r))
      h.genesis step post (by rw [aFork]; exact h.fulu) yEarly highC aEpoch hR v.toNat inside w
      foundB exited (held w foundB)
  -- the credits of the run from the epoch's start, by source
  have gross := credits_le_sources (toX.append before) h.genesis
    (r.append ((Run.nil.snoc step).append post)) yEarly cElectra v.toNat highC hX
  have netR := (credits_le_sources (toX.append (before.append r)) h.genesis
    ((Run.nil.snoc step).append post) yEarly aElectra v.toNat highC hR).2.1
  have split := credC_split (r.append ((Run.nil.snoc step).append post)) highC v.toNat
  have splitN := credN_split (r.append ((Run.nil.snoc step).append post)) highC v.toNat
  have splitP := propC_split (r.append ((Run.nil.snoc step).append post)) highC v.toNat
  simp only [List.map_append, List.sum_append] at gross
  unfold propC whistC syncCr
  simp only [List.map_append, List.sum_append]
  unfold propC at splitP
  unfold whistC at gross
  simp only [creditScan_append, grossScan_append, netScan_append] at gross netR split splitN splitP
  simp only [creditScan_append, netScan_append] at depR' ⊢
  refine ⟨by omega, fun notSlot => ?_⟩
  have flip := (flip_credits_le_sources (toX.append before) h.genesis r step
    post notSlot yEarly cElectra v.toNat highC aEpoch (events := er ++ (es ++ ep))
    (by rw [← eqX]; exact hX)).2
  rw [← eqX] at flip
  unfold whistC at flip
  simp only [List.map_append, List.sum_append, creditScan_append] at flip
  omega

/-- The effective balance of a charged key at a state `y` of the run, after its charge.

It is the key's effective balance before the charge step, plus the upward band.

It adds the key's credits since the epoch's start.

It also adds the exact epoch rewards of the steps from the charge on.

The run starts at any state `xs` with a run `toX` from genesis.

The epoch's start is given as data.

It is the state `c`, the run `r` from it to the charge, and the hysteresis there.

The key is not yet withdrawable at `y` (`held`). -/
private theorem charge_effective_bound_of
    (h : Setting config checks g split fin pulled anc counted V)
    {xs : BeaconState preset fork} (toX : Run config checks g ⟨fork, xs⟩)
    {y : ForkedBeaconState preset} (yFork : y.fork = fork)
    (tailY : Run config checks ⟨fork, xs⟩ y) (highC : ℕ)
    (endEpochY : (getCurrentEpoch y.state).toNat ≤ highC + 1)
    {eventsY : List (BalanceEvent preset)} (replayedY : tailY.balanceEvents highC = .ok eventsY)
    {v : ValidatorIndex} {a b : ForkedBeaconState preset}
    (pre : Run config checks ⟨fork, xs⟩ a) (step : Step config checks a b)
    (post : Run config checks b y) (site : (pre.snoc step).append post = tailY)
    (hcharge : step.departureCharges.any (·.index == v.toNat) = true)
    (start : ∃ (c : ForkedBeaconState preset) (before : Run config checks ⟨fork, xs⟩ c)
      (r : Run config checks c a), before.append r = pre ∧
      v.toNat < c.state.validators.data.size ∧ getCurrentEpoch c.state = getCurrentEpoch a.state ∧
      effectiveAt c v.toNat = effectiveAt a v.toNat ∧
      min (actualBalanceAt c v.toNat) (PinTerms.capAt c v.toNat) ≤
        effectiveAt c v.toNat + preset.upwardBand ∧
      (effectiveAt c v.toNat < PinTerms.capAt c v.toNat →
        actualBalanceAt c v.toNat ≤ effectiveAt c v.toNat + preset.upwardBand) ∧
      actualBalanceAt a v.toNat ≤ actualBalanceAt c v.toNat + netScan v.toNat highC r +
        (creditScan (fun _ => false) (fun s => decide (s ≠ .rewards)) v.toNat highC r))
    (held : ∀ w, b.state.validators.data[v.toNat]? = some w →
      (getCurrentEpoch y.state).toNat < w.withdrawableEpoch.toNat) :
    effectiveAt y v.toNat ≤ effectiveAt a v.toNat + preset.upwardBand +
      (propC tailY highC v.toNat + whistC tailY highC v.toNat + syncCr eventsY v.toNat) +
      (riseScan v.toNat highC tailY).2 := by
  obtain ⟨_, -, foundA0, -, unset, -⟩ := charge_exits step hcharge
  have hin : v.toNat < a.state.validators.data.size := (Array.getElem?_eq_some_iff.mp foundA0).1
  subst site
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  have yBack : y.fork ≤ fork := by rw [yFork]; exact Nat.le_refl _
  have yEarly : y.fork < .glamsterdam := by rw [yFork]; exact h.early
  have aFork : a.fork = fork := fork_eq_of_run pre ((Run.nil.snoc step).append post) yBack
  have bFork : b.fork = fork := fork_eq_of_run (pre.snoc step) post yBack
  have aEpoch : (getCurrentEpoch a.state).toNat ≤ highC + 1 :=
    Nat.le_trans (UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps
      ((Run.nil.snoc step).append post).chainSteps)) endEpochY
  obtain ⟨c, before, r, cut, hc, same, effEq, hyst, hystLt, scanR⟩ := start
  subst cut
  have cFork : c.fork = fork := fork_eq_of_run before
    (r.append ((Run.nil.snoc step).append post)) yBack
  obtain ⟨er, hr⟩ := r.balanceEvents_ok (aFork ▸ h.early) highC
  have netLe := (credits_le_sources (toX.append before) h.genesis r
    (aFork ▸ h.early) (cFork ▸ electra) v.toNat highC hr).2.1
  have start : min (actualBalanceAt a v.toNat) (PinTerms.capAt a v.toNat) ≤
      effectiveAt a v.toNat + preset.upwardBand + (grossScan v.toNat highC r +
        (creditScan (fun _ => false) (fun s => decide (s ≠ .rewards)) v.toNat highC r)) := by
    by_cases capEq : PinTerms.capAt c v.toNat = PinTerms.capAt a v.toNat
    · omega
    · by_cases lt : effectiveAt c v.toNat < PinTerms.capAt c v.toNat
      · have := hystLt lt
        omega
      · have := charge_flip h highC (toX.append before) r v.toNat hc same
          aFork cFork aEpoch capEq lt
        omega
  obtain ⟨capAll, capPost, ceilings, ceilingsPost⟩ :=
    charge_rise_fold h highC yFork endEpochY _ step post v.toNat hcharge
  obtain ⟨creditsAll, creditsStep⟩ := charge_credits_to h toX yFork _ highC endEpochY replayedY _
    step post rfl hcharge before r rfl same held
  set TC : Run config checks ⟨fork, xs⟩ y := ((before.append r).snoc step).append post with hTC
  obtain ⟨_, foundA⟩ : ∃ w, a.state.validators.data[v.toNat]? = some w :=
    ⟨_, Array.getElem?_eq_getElem hin⟩
  have final : effectiveAt y v.toNat ≤
      effectiveAt a v.toNat + preset.upwardBand + (propC TC
        highC v.toNat + whistC TC highC v.toNat +
        syncCr eventsY v.toNat) +
      (riseScan v.toNat highC TC).2 := by
    by_cases capEq : PinTerms.capAt b v.toNat = PinTerms.capAt a v.toNat
    · -- no switch at the charge step: the rise is read from `a`
      have capped := DirectSafety.Apriori.Internal.effectiveAt_le_withdrawalMax
        (toX.append (before.append r)) h.genesis h.caps (aFork ▸ h.early)
        foundA
      have startCap : effectiveAt a v.toNat ≤ PinTerms.capAt a v.toNat := by
        simpa [PinTerms.capAt, foundA] using capped
      have alignedCap := capAt_aligned h.aligned (aFork ▸ electra) foundA
      have ceil := PinKeyFloor.Run.effective_ceiling_of_balance_ceiling
        ((Run.nil.snoc step).append post) yEarly (aFork ▸ h.fulu) v.toNat hin
        (effectiveAt a v.toNat + preset.upwardBand + (propC TC
          highC v.toNat + whistC TC highC v.toNat +
          syncCr eventsY v.toNat) +
          (riseScan v.toNat highC TC).2)
        _ alignedCap startCap
        (fun z member => by have := ceilings z member; omega)
        (fun z member => by have := capAll z member; omega)
      have := ceil.1
      omega
    · -- the charge step switches the key: the rise is read from `b`
      have insideB : v.toNat < b.state.validators.data.size :=
        Nat.lt_of_lt_of_le hin
          (Run.nil.snoc step : Run config checks a b).registryLifecycle.size_le
      obtain ⟨_, foundB⟩ : ∃ w, b.state.validators.data[v.toNat]? = some w :=
        ⟨_, Array.getElem?_eq_getElem insideB⟩
      have capMono := cap_le_cap_of_run h.caps (Run.nil.snoc step : Run config checks a b)
        (bFork ▸ h.early) v.toNat
      obtain ⟨capAmin, large⟩ : PinTerms.capAt a v.toNat = preset.MIN_ACTIVATION_BALANCE.toNat ∧
          preset.MIN_ACTIVATION_BALANCE.toNat < PinTerms.capAt b v.toNat := by
        have ca := capAt_of_found (aFork ▸ electra) foundA
        have cb := capAt_of_found (bFork ▸ electra) foundB
        have order := UInt64.le_iff_toNat_le.mp h.caps.compounding
        split at ca <;> split at cb <;> omega
      have flat : ¬preset.MIN_ACTIVATION_BALANCE.toNat < PinTerms.capAt a v.toNat := by omega
      have epochEq := step_flip_epoch step (bFork ▸ h.early) (aFork ▸ h.fulu) v.toNat hin flat
        large
      have creditsFlip := creditsStep (step_flip_not_slot step (bFork ▸ h.early)
        (aFork ▸ h.fulu) v.toNat hin flat large)
      have effB := run_same_epoch_effective (Run.nil.snoc step : Run config checks a b)
        (bFork ▸ h.early) (UInt64.toNat_inj.mp (by omega)) v.toNat hin
      have bound := step_flip_min step (bFork ▸ h.early) (aFork ▸ h.fulu)
        ((toX.append (before.append r)).invariant h.genesis.invariant)
        v.toNat flat large
      have capped := DirectSafety.Apriori.Internal.effectiveAt_le_withdrawalMax
        (toX.append ((before.append r).snoc step)) h.genesis h.caps
        (bFork ▸ h.early) foundB
      have startCap : effectiveAt b v.toNat ≤ PinTerms.capAt b v.toNat := by
        simpa [PinTerms.capAt, foundB] using capped
      have alignedCap := capAt_aligned h.aligned (bFork ▸ electra) foundB
      have ceil := PinKeyFloor.Run.effective_ceiling_of_balance_ceiling post yEarly
        (bFork ▸ h.fulu) v.toNat insideB
        (effectiveAt a v.toNat + preset.upwardBand + (propC TC
          highC v.toNat + whistC TC highC v.toNat +
          syncCr eventsY v.toNat) +
          (riseScan v.toNat highC TC).2)
        _ alignedCap startCap
        (fun z member => by have := ceilingsPost z member; omega) capPost
      have := ceil.1
      omega
  exact final

/-- The effective balance of a charged key at a state `y` of the run, after its charge.

It is the key's effective balance before the charge step, plus the upward band.

It adds the key's credits since the epoch's start.

It also adds the exact epoch rewards of the steps from the charge on.

The charge is in an epoch after the split's.

The key is not yet withdrawable at `y` (`held`). -/
private theorem charge_effective_bound (h : Setting config checks g split fin pulled anc counted V)
    {y : ForkedBeaconState preset} (yFork : y.fork = fork)
    (tailY : Run config checks ⟨fork, split⟩ y) (highC : ℕ)
    (endEpochY : (getCurrentEpoch y.state).toNat ≤ highC + 1)
    {eventsY : List (BalanceEvent preset)} (replayedY : tailY.balanceEvents highC = .ok eventsY)
    {v : ValidatorIndex} {a b : ForkedBeaconState preset}
    (pre : Run config checks ⟨fork, split⟩ a) (step : Step config checks a b)
    (post : Run config checks b y) (site : (pre.snoc step).append post = tailY)
    (hcharge : step.departureCharges.any (·.index == v.toNat) = true)
    (started : (getCurrentEpoch split).toNat < (getCurrentEpoch a.state).toNat)
    (held : ∀ w, b.state.validators.data[v.toNat]? = some w →
      (getCurrentEpoch y.state).toNat < w.withdrawableEpoch.toNat) :
    effectiveAt y v.toNat ≤ effectiveAt a v.toNat + preset.upwardBand +
      (propC tailY highC v.toNat + whistC tailY highC v.toNat + syncCr eventsY v.toNat) +
      (riseScan v.toNat highC tailY).2 := by
  obtain ⟨shared⟩ := h.toFin
  obtain ⟨fromFin⟩ := h.fromFin
  obtain ⟨_, -, foundA0, -, unset, -⟩ := charge_exits step hcharge
  exact charge_effective_bound_of h (shared.append fromFin) yFork tailY highC endEpochY replayedY
    pre step post site hcharge
    (charge_epoch_start h highC yFork pre step post v.toNat
      (Array.getElem?_eq_some_iff.mp foundA0).1 unset started endEpochY hcharge) held

/-- A charged key of `K5` is not yet withdrawable at C, in the state after its charge step.

A key of `K5` exits at C's epoch, so it is not withdrawable at C. -/
private theorem K5_charged_held (h : Setting config checks g split fin pulled anc counted V)
    {v : ValidatorIndex} (member : v ∈ K5 counted V)
    {a b : ForkedBeaconState preset} (pre : Run config checks ⟨fork, split⟩ a)
    (step : Step config checks a b) (post : Run config checks b ⟨fork, counted⟩)
    (charged : step.departureCharges.any (·.index == v.toNat) = true) :
    ∀ w, b.state.validators.data[v.toNat]? = some w →
      (getCurrentEpoch counted).toNat < w.withdrawableEpoch.toNat := by
  obtain ⟨shared⟩ := h.toFin
  obtain ⟨fromFin⟩ := h.fromFin
  obtain ⟨_, w0, foundA, foundB0, unset, set⟩ := charge_exits step charged
  have bFork : b.fork = fork := fork_eq_of_run (pre.snoc step) post (Nat.le_refl _)
  intro w foundB
  obtain rfl : w = w0 := Option.some.inj (foundB.symm.trans foundB0)
  obtain ⟨u, foundU, activeBefore, notNow⟩ := K5_previous_only h member
  have exitU := ((previous_only_iff_exit counted u).mp ⟨activeBefore, notNow⟩).2
  have kept := PinEventsKept.kept_run (shared.append (fromFin.append (pre.snoc step)))
    h.genesis (by rw [bFork]; exact h.fulu) post h.early
  obtain ⟨x, foundX, life⟩ := kept.life.validators v.toNat w foundB
  obtain rfl : x = u := Option.some.inj (foundX.symm.trans foundU)
  have exitX := congrArg UInt64.toNat (life.exitEpoch set)
  obtain ⟨-, wdEq⟩ := kept.withdrawable v.toNat w x foundB foundX set
  have wdSame : x.withdrawableEpoch = w.withdrawableEpoch := by
    rcases wdEq with slashed | same
    · exact absurd slashed (by simp [K5_unslashed member x foundU])
    · exact same
  have delayed := (shared.append (fromFin.append
    ((pre.snoc step).append post))).exit_withdrawable_delay h.genesis v.toNat x foundU
    (by rw [life.exitEpoch set]; exact set)
  rw [← wdSame]
  have := h.delay
  omega

/-- A key with no charge on a run has not started its rise on it. -/
private theorem riseScan_of_none (v high : ℕ) {x y : ForkedBeaconState preset}
    (run : Run config checks x y) (uncharged : ∀ c ∈ run.departureCharges, c.index ≠ v) :
    riseScan v high run = (false, 0) := by
  induction run with
  | nil => rfl
  | snoc pre step ih =>
    have before := ih fun c member => uncharged c (by simp [Run.departureCharges, member])
    have notCharged : step.departureCharges.any (·.index == v) = false := by
      refine Bool.eq_false_iff.mpr fun any => ?_
      obtain ⟨c, member, index⟩ := List.any_eq_true.mp any
      exact uncharged c (by simp [Run.departureCharges, member]) (beq_iff_eq.mp index)
    simp [riseScan, before, notCharged]

/-- A run after a run with no charge of the key reads the same rise as it does alone. -/
private theorem riseScan_append_of_none (v high : ℕ) {x m y : ForkedBeaconState preset}
    (pre : Run config checks x m) (post : Run config checks m y)
    (uncharged : ∀ c ∈ pre.departureCharges, c.index ≠ v) :
    riseScan v high (pre.append post) = riseScan v high post := by
  induction post with
  | nil => exact riseScan_of_none v high pre uncharged
  | snoc post step ih => simp only [Run.append, riseScan, ih]

/-- An assigned exit persists, so an unset key has no charge on a prefix of the run. -/
private theorem no_prefix_charge_of_unset {x m y : ForkedBeaconState preset}
    (pre : Run config checks x m) (post : Run config checks m y) (i : ℕ)
    (unset : ∀ w, y.state.validators.data[i]? = some w → w.exitEpoch = FAR_FUTURE_EPOCH) :
    ∀ c ∈ pre.departureCharges, c.index ≠ i := by
  intro c member index
  obtain ⟨w, found, assigned, -⟩ := (pre.append post).departure_charge_exit c
    (by simp [Run.departureCharges_append, member])
  exact assigned (unset w (index ▸ found))

/-- The credits and the rise of the shared run `pre` add to those of the run `rest` after it.

The run `pre` is inside one epoch, so it holds no consolidation or deposit credit.

The key has no charge on `pre`. -/
private theorem prefix_append_credits (v : ValidatorIndex) (highC : ℕ)
    {t : BeaconState preset fork} (pre : Run config checks ⟨fork, t⟩ ⟨fork, split⟩)
    {m : ForkedBeaconState preset} (rest : Run config checks ⟨fork, split⟩ m)
    (electra : .pectra ≤ fork) (early : fork < .glamsterdam)
    (sameEpoch : getCurrentEpoch split = getCurrentEpoch t)
    (noneBefore : ∀ c ∈ pre.departureCharges, c.index ≠ v.toNat) :
    propC (pre.append rest) highC v.toNat = propN pre highC v.toNat + propC rest highC v.toNat ∧
      whistC (pre.append rest) highC v.toNat =
        whistC pre highC v.toNat + whistC rest highC v.toNat ∧
      riseScan v.toNat highC (pre.append rest) = riseScan v.toNat highC rest := by
  have noCons := (same_epoch_no_epoch_credits v highC pre electra early sameEpoch).1
  have propPre := propC_split pre highC v.toNat
  have propSplit : propC (pre.append rest) highC v.toNat =
      propC pre highC v.toNat + propC rest highC v.toNat := creditScan_append _ _ _ _ pre rest
  exact ⟨by omega, creditScan_append _ _ _ _ pre rest,
    riseScan_append_of_none v.toNat highC pre rest noneBefore⟩

/-- The data at the start of the split's epoch that bounds a key charged in that epoch.

The key's charge step starts in the split's epoch, whose first state `t` is on the shared run.

The run from `t` to the charge is `pre` and the front of C's run.

Its balance at the charge is within the upward band of its effective balance at `t`.

From `t` it rises at most by the credits of the run. -/
private theorem split_epoch_start_data (h : Setting config checks g split fin pulled anc counted V)
    (highC : ℕ) {t : BeaconState preset fork} (toT : Run config checks g ⟨fork, t⟩)
    (pre : Run config checks ⟨fork, t⟩ ⟨fork, split⟩)
    (sameEpoch : getCurrentEpoch split = getCurrentEpoch t)
    (earlier : ∀ {u w : ForkedBeaconState preset} (step : Step config checks u w),
      toT.Contains step → (getCurrentEpoch u.state).toNat < (getCurrentEpoch t).toNat)
    {p q : ForkedBeaconState preset} (cf : Run config checks ⟨fork, split⟩ p)
    (step : Step config checks p q) (rest : Run config checks q ⟨fork, counted⟩)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1) {v : ValidatorIndex}
    (inSplitEpoch : ¬ (getCurrentEpoch split).toNat < (getCurrentEpoch p.state).toNat)
    (charged : step.departureCharges.any (·.index == v.toNat) = true) :
    ∃ (c : ForkedBeaconState preset) (before : Run config checks ⟨fork, t⟩ c)
      (r : Run config checks c p), before.append r = pre.append cf ∧
      v.toNat < c.state.validators.data.size ∧ getCurrentEpoch c.state = getCurrentEpoch p.state ∧
      effectiveAt c v.toNat = effectiveAt p v.toNat ∧
      min (actualBalanceAt c v.toNat) (PinTerms.capAt c v.toNat) ≤
        effectiveAt c v.toNat + preset.upwardBand ∧
      (effectiveAt c v.toNat < PinTerms.capAt c v.toNat →
        actualBalanceAt c v.toNat ≤ effectiveAt c v.toNat + preset.upwardBand) ∧
      actualBalanceAt p v.toNat ≤ actualBalanceAt c v.toNat + netScan v.toNat highC r +
        (creditScan (fun _ => false) (fun s => decide (s ≠ .rewards)) v.toNat highC r) := by
  obtain ⟨u0, -, foundP, -, unset, -⟩ := charge_exits step charged
  have hin : v.toNat < p.state.validators.data.size := (Array.getElem?_eq_some_iff.mp foundP).1
  have pFork : p.fork = fork :=
    fork_eq_of_run cf ((Run.nil.snoc step).append rest) (Nat.le_refl _)
  have pEarly : p.fork < .glamsterdam := by rw [pFork]; exact h.early
  have pFulu : .fusaka ≤ p.fork := by rw [pFork]; exact h.fulu
  have pEpoch : (getCurrentEpoch p.state).toNat ≤ highC + 1 :=
    Nat.le_trans (UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps
      ((Run.nil.snoc step).append rest).chainSteps)) endEpochC
  have splitLe := UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps cf.chainSteps)
  have sameNat := congrArg UInt64.toNat sameEpoch
  have sameT : getCurrentEpoch (⟨fork, t⟩ : ForkedBeaconState preset).state =
      getCurrentEpoch p.state := UInt64.toNat_inj.mp (by simp only at splitLe sameNat ⊢; omega)
  have hystT := hysteresis_at_epoch_start h toT earlier
  obtain ⟨insideT, effEq, floor, up, rise⟩ := charge_start_at h highC (pre.append cf) step
    v.toNat hin unset pFulu pEarly sameT hystT pEpoch charged
  exact ⟨⟨fork, t⟩, Run.nil, pre.append cf, run_nil_append _, insideT, sameT, effEq, floor, up,
    rise⟩

/-- Two splits of a run at steps that charge the same key start at the same state.

One split is a prefix of the other.

If the first step comes first, the exit it assigns stays assigned.

So the second step cannot charge it. -/
private theorem charge_site_start {x y p q cp cq : ForkedBeaconState preset}
    {tail : Run config checks x y} (front : Run config checks x p) (step : Step config checks p q)
    (post : Run config checks q y) (site : (front.snoc step).append post = tail)
    (cfront : Run config checks x cp) (cstep : Step config checks cp cq)
    (cpost : Run config checks cq y) (csite : (cfront.snoc cstep).append cpost = tail) {i : ℕ}
    (charges : step.departureCharges.any (·.index == i) = true)
    (cCharges : cstep.departureCharges.any (·.index == i) = true) : p = cp := by
  obtain ⟨-, w, -, foundQ, unset, assigned⟩ := charge_exits step charges
  obtain ⟨-, cw, -, foundCq, cUnset, cAssigned⟩ := charge_exits cstep cCharges
  rcases Run.prefix_total (cfront.snoc cstep) cpost (front.snoc step) post csite site with
    ⟨r, extended⟩ | ⟨r, extended⟩
  · rcases Run.prefix_snoc (cfront.snoc cstep) r front step extended with
      ⟨rfl, same⟩ | ⟨r', earlier⟩
    · cases eq_of_heq same
      rfl
    · obtain ⟨later, foundLater, life⟩ := r'.registryLifecycle.validators i cw foundCq
      exact absurd (by rw [← life.exitEpoch cAssigned]; exact unset later foundLater) cAssigned
  · rcases Run.prefix_snoc (front.snoc step) r cfront cstep extended with
      ⟨rfl, same⟩ | ⟨r', earlier⟩
    · cases eq_of_heq same
      rfl
    · obtain ⟨later, foundLater, life⟩ := r'.registryLifecycle.validators i w foundQ
      exact absurd (by rw [← life.exitEpoch assigned]; exact cUnset later foundLater) assigned

/-- The effective balance at its slashing of a charged key of the split's registry.

The run `pre` is the shared run from a state `t` of the split's epoch, or the empty run.

The bound at the charge is given as `bound`, from the charge step and the run to it.

If the slashing step assigns the exit, that step is the charge.

If an earlier step assigned it, the balance before the slashing is bounded by the charge step.

The key is not withdrawable at the slashing, since it is still slashable there.

The credits are at most the slack's credits, at eleven tenths. -/
private theorem registry_charge_of (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩)
    {eventsF events : List (BalanceEvent preset)} (high : ℕ)
    {t : BeaconState preset fork} (pre : Run config checks ⟨fork, t⟩ ⟨fork, split⟩)
    (sameEpoch : getCurrentEpoch split = getCurrentEpoch t)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    {eventsP : List (BalanceEvent preset)}
    {a b : ForkedBeaconState preset} (step : Step config checks a b) (member : tailC.Contains step)
    (v : ValidatorIndex) (inside : v.toNat < split.validators.data.size)
    (flag : (!(a.state.validators.data[v.toNat]?.map (·.slashed)).getD false &&
      (b.state.validators.data[v.toNat]?.map (·.slashed)).getD false) = true)
    (charged : (tailC.departureCharges.any fun c => c.index == v.toNat) = true)
    (bound : ∀ {front : Run config checks ⟨fork, split⟩ a}
        {post : Run config checks b ⟨fork, counted⟩} {p q : ForkedBeaconState preset}
        {eventsY : List (BalanceEvent preset)}
        (cf : Run config checks ⟨fork, split⟩ p) (step' : Step config checks p q)
        (post' : Run config checks q a),
        (cf.snoc step').append post' = front →
        (cf.snoc step').append ((post'.snoc step).append post) = tailC →
        step'.departureCharges.any (·.index == v.toNat) = true →
        a.fork = fork → (getCurrentEpoch a.state).toNat ≤ highC + 1 →
        front.balanceEvents highC = .ok eventsY →
        (∀ w, q.state.validators.data[v.toNat]? = some w →
          (getCurrentEpoch a.state).toNat < w.withdrawableEpoch.toNat) →
        effectiveAt a v.toNat ≤ effectiveAt p v.toNat + preset.upwardBand +
          (propC (pre.append front) highC v.toNat + whistC (pre.append front) highC v.toNat +
            syncCr (eventsP ++ eventsY) v.toNat) + (riseScan v.toNat highC (pre.append front)).2) :
    effectiveAt a v.toNat ≤ chargeAmt tailC v.toNat + riseQ tailC highC v.toNat +
      (propN pre highC v.toNat + whistC pre highC v.toNat + syncCr eventsP v.toNat) +
      whistleSlack (pinTerms config pulled anc fin) tailC (fromFin.append tail) highC high
        eventsC eventsF events fin v.toNat := by
  classical
  obtain ⟨shared⟩ := h.toFin
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  simp only [Bool.and_eq_true, Bool.not_eq_true'] at flag
  obtain ⟨flagA, flagB⟩ := flag
  obtain ⟨front, post, cut, aEarly, aEpoch⟩ :=
    DirectSafety.Apriori.Internal.Run.contains_step_facts member h.early
  have insideA : v.toNat < a.state.validators.data.size :=
    Nat.lt_of_lt_of_le inside front.registryLifecycle.size_le
  have insideB : v.toNat < b.state.validators.data.size :=
    Nat.lt_of_lt_of_le insideA (Run.nil.snoc step : Run config checks a b).registryLifecycle.size_le
  obtain ⟨old, foundA⟩ : ∃ w, a.state.validators.data[v.toNat]? = some w :=
    ⟨_, Array.getElem?_eq_getElem insideA⟩
  obtain ⟨new, foundB⟩ : ∃ w, b.state.validators.data[v.toNat]? = some w :=
    ⟨_, Array.getElem?_eq_getElem insideB⟩
  have cleanA : old.slashed = false := by simpa [foundA] using flagA
  have markedB : new.slashed = true := by simpa [foundB] using flagB
  by_cases unset : old.exitEpoch = FAR_FUTURE_EPOCH
  · -- the slashing assigns the exit, so it is the charge
    have := slash_exit_charge h fromFin tailC step member v.toNat old new foundA foundB unset
      markedB
    omega
  -- an earlier step assigned the exit
  subst cut
  have bEarly : b.fork < .glamsterdam :=
    Nat.lt_of_le_of_lt (fork_le_of_chainSteps post.chainSteps) h.early
  have aFork : a.fork = fork :=
    fork_eq_of_run front ((Run.nil.snoc step).append post) (Nat.le_refl _)
  have aEpoch' : (getCurrentEpoch a.state).toNat ≤ (getCurrentEpoch counted).toNat := aEpoch
  have unsetSplit : ∀ w, (⟨fork, split⟩ : ForkedBeaconState preset).state.validators.data[
      v.toNat]? = some w → w.exitEpoch = FAR_FUTURE_EPOCH := by
    intro w0 found0
    by_contra assigned0
    obtain ⟨c, cMember, cIndex⟩ := List.any_eq_true.mp charged
    have cIndex' : c.index = v.toNat := by simpa using cIndex
    obtain ⟨p', q', pre', step', post', -, vv, ww, foundP, -, unsetP, -, -, -⟩ :=
      ((front.snoc step).append post).departure_charge_site c cMember
    rw [cIndex'] at foundP
    obtain ⟨x, foundX, life⟩ := pre'.registryLifecycle.validators v.toNat w0 found0
    obtain rfl : x = vv := Option.some.inj (foundX.symm.trans foundP)
    exact assigned0 (by rw [← life.exitEpoch assigned0]; exact unsetP)
  obtain ⟨c0, c0Member, c0Index, -⟩ :=
    PinKeys.Run.charge_of_exit front electra aEarly v.toNat unsetSplit old foundA unset
  obtain ⟨p, q, cf, step', post', cut', vv, ww, foundP, foundQ, unsetP, setQ, amount, -⟩ :=
    front.departure_charge_site c0 c0Member
  rw [c0Index] at foundP foundQ
  have inRun : c0 ∈ ((front.snoc step).append post).departureCharges := by
    rw [Run.departureCharges_append]
    simp [Run.departureCharges, c0Member]
  have chargeEq : chargeAmt ((front.snoc step).append post) v.toNat = c0.amount := by
    unfold chargeAmt
    rw [find_charge inRun (by simp [c0Index])
      (fun d inD hd =>
        charge_unique ((front.snoc step).append post) inD inRun (by simpa [c0Index] using hd))]
    rfl
  have amountEq : c0.amount = effectiveAt p v.toNat := by simp [amount, effectiveAt, foundP]
  -- the charge step
  obtain ⟨d, dMember, dIndex, -⟩ :=
    (Run.nil.snoc step').departure_charge_of_assigned v.toNat vv ww foundP foundQ unsetP setQ
  have hcharge : step'.departureCharges.any (·.index == v.toNat) = true :=
    List.any_eq_true.mpr ⟨d, by simpa [Run.departureCharges] using dMember, by simpa using dIndex⟩
  have site : (cf.snoc step').append ((post'.snoc step).append post) =
      (front.snoc step).append post := by
    rw [← cut']
    exact Run.append_assoc _ _ _
  -- the key is not withdrawable at the slashing
  have held : ∀ w, q.state.validators.data[v.toNat]? = some w →
      (getCurrentEpoch a.state).toNat < w.withdrawableEpoch.toNat := by
    intro w foundW
    have eqW : w = ww := Option.some.inj (foundW.symm.trans foundQ)
    have lateA : (getCurrentEpoch a.state).toNat < old.withdrawableEpoch.toNat :=
      newly_slashed_unwithdrawable h.genesis h.caps (shared.append (fromFin.append front)) step
        bEarly foundA foundB cleanA markedB
    have kept := PinEventsKept.kept_run (shared.append (fromFin.append (cf.snoc step'))) h.genesis
      (Nat.le_trans h.fulu (fork_le_of_chainSteps (cf.snoc step').chainSteps)) post' aEarly
    obtain ⟨-, wdEq⟩ := kept.withdrawable v.toNat ww old foundQ foundA setQ
    have same : old.withdrawableEpoch = ww.withdrawableEpoch :=
      wdEq.resolve_left (by simp [cleanA])
    rw [eqW, ← same]
    exact lateA
  obtain ⟨eventsY, replayedY⟩ := front.balanceEvents_ok aEarly highC
  have whole := bound cf step' post' cut' site hcharge aFork (by omega) replayedY held
  -- the credits of `pre` are its proposer, whistleblower and sync credits
  have noneBefore := no_prefix_charge_of_unset pre Run.nil v.toNat unsetSplit
  obtain ⟨propSplit, whistSplit, riseSame⟩ := prefix_append_credits v highC pre front electra
    h.early sameEpoch noneBefore
  rw [riseSame] at whole
  -- the rise of the whole run is at least the rise before the slashing
  obtain ⟨seenC, riseMono, -⟩ := rise_fold v.toNat highC (front.snoc step)
    ((riseScan_fst _ _ _).mpr ⟨c0, by simp [Run.departureCharges, c0Member], c0Index⟩) post
    h.early endEpochC
  have riseSnoc : (riseScan v.toNat highC front).2 ≤
      (riseScan v.toNat highC (front.snoc step)).2 := by
    simp only [riseScan]
    split_ifs <;> omega
  have rise := riseQ_eq_of_seen _ _ _ seenC
  -- the credits before the slashing are at most those of the run
  have propLe := creditScan_prefix_le (fun s => decide (s = .rewards ∨ s = .consolidations))
    (fun s => decide (s = .consolidations)) v.toNat highC front step post
  have whistLe := creditScan_prefix_le (fun s => decide (s = .slashings)) (fun _ => false)
    v.toNat highC front step post
  have parts := (credit_parts_le ((front.snoc step).append post) highC v replayedC).2
  have syncSplit : syncCr (eventsP ++ eventsY) v.toNat =
      syncCr eventsP v.toNat + syncCr eventsY v.toNat := by
    simp only [syncCr, List.map_append, List.sum_append]
  have syncLe := syncCr_prefix_le front step post highC replayedY replayedC v.toNat
  unfold whistleSlack whistleSlackBase
  simp only [propC, whistC] at whole propSplit whistSplit parts ⊢
  omega

/-- The effective balance at its slashing of a charged key of the split's registry.

The charge of the key is on C's run, in an epoch after the split's.

The balance at the charge is read as `charge_effective_bound` reads it.

Its bound is that of `registryCharge` in `whistle_core`, without the credits of `pre`. -/
private theorem registry_charge (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩)
    {eventsF events : List (BalanceEvent preset)} (high : ℕ)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    {a b : ForkedBeaconState preset} (step : Step config checks a b) (member : tailC.Contains step)
    (i : ℕ) (inside : i < split.validators.data.size)
    (flag : (!(a.state.validators.data[i]?.map (·.slashed)).getD false &&
      (b.state.validators.data[i]?.map (·.slashed)).getD false) = true)
    (charged : (tailC.departureCharges.any fun c => c.index == i) = true)
    {cp cq : ForkedBeaconState preset} (cfront : Run config checks ⟨fork, split⟩ cp)
    (cstep : Step config checks cp cq) (cpost : Run config checks cq ⟨fork, counted⟩)
    (csite : (cfront.snoc cstep).append cpost = tailC)
    (charge : cstep.departureCharges.any (·.index == i) = true)
    (started : (getCurrentEpoch split).toNat < (getCurrentEpoch cp.state).toNat) :
    effectiveAt a i ≤ chargeAmt tailC i + riseQ tailC highC i +
      whistleSlack (pinTerms config pulled anc fin) tailC (fromFin.append tail) highC high
        eventsC eventsF events fin i := by
  obtain ⟨v, rfl⟩ := Uint64.exists_toNat_eq
    (inside.trans (BeaconState.validators_size_lt_of_lt_glamsterdam h.early split))
  have core := registry_charge_of h fromFin tail high (Run.nil : Run config checks ⟨fork, split⟩ _)
    rfl tailC highC endEpochC replayedC (eventsP := []) step member v inside flag charged
    (eventsF := eventsF) (events := events) (by
      intro front post p q eventsY cf step' post' cut' site hcharge aFork aEpoch replayedY held
      have sameStart := charge_site_start cf step' _ site cfront cstep cpost csite hcharge charge
      have later : (getCurrentEpoch split).toNat < (getCurrentEpoch p.state).toNat := by
        rw [sameStart]
        exact started
      have := charge_effective_bound h (y := a) aFork front highC aEpoch replayedY cf step' post'
        cut' hcharge later held
      simpa only [run_nil_append, List.nil_append] using this)
  simp only [propN, whistC, creditScan_nil, syncCr, List.map_nil, List.sum_nil,
    Nat.add_zero] at core
  exact core

/-- The effective balance at its slashing of a charged key whose charge is in the split's epoch.

The epoch's start `t` is on the shared run, before the split.

The key's credits from `t` come through the shared suffix `pre`, and then through C's run.

`pre` holds no consolidation or deposit credit, since it is inside one epoch.

So its credits are the proposer, whistleblower and sync credits.

The bands of hysteresis at `t` come from the slot step that crossed into its epoch.

Its bound is that of `whistle_core`'s premise `registryCharge`. -/
private theorem registry_charge_split_epoch
    (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩)
    {eventsF events : List (BalanceEvent preset)} (high : ℕ)
    {t : BeaconState preset fork} (toT : Run config checks g ⟨fork, t⟩)
    (pre : Run config checks ⟨fork, t⟩ ⟨fork, split⟩)
    (sameEpoch : getCurrentEpoch split = getCurrentEpoch t)
    (earlier : ∀ {u w : ForkedBeaconState preset} (step : Step config checks u w),
      toT.Contains step → (getCurrentEpoch u.state).toNat < (getCurrentEpoch t).toNat)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    {eventsP : List (BalanceEvent preset)} (replayedP : pre.balanceEvents highC = .ok eventsP)
    {a b : ForkedBeaconState preset} (step : Step config checks a b) (member : tailC.Contains step)
    (i : ℕ) (inside : i < split.validators.data.size)
    (flag : (!(a.state.validators.data[i]?.map (·.slashed)).getD false &&
      (b.state.validators.data[i]?.map (·.slashed)).getD false) = true)
    (charged : (tailC.departureCharges.any fun c => c.index == i) = true)
    {cp cq : ForkedBeaconState preset} (cfront : Run config checks ⟨fork, split⟩ cp)
    (cstep : Step config checks cp cq) (cpost : Run config checks cq ⟨fork, counted⟩)
    (csite : (cfront.snoc cstep).append cpost = tailC)
    (charge : cstep.departureCharges.any (·.index == i) = true)
    (inSplitEpoch : ¬ (getCurrentEpoch split).toNat < (getCurrentEpoch cp.state).toNat) :
    effectiveAt a i ≤ chargeAmt tailC i + riseQ tailC highC i +
      (propN pre highC i + whistC pre highC i + syncCr eventsP i) +
      whistleSlack (pinTerms config pulled anc fin) tailC (fromFin.append tail) highC high
        eventsC eventsF events fin i := by
  obtain ⟨v, rfl⟩ := Uint64.exists_toNat_eq
    (inside.trans (BeaconState.validators_size_lt_of_lt_glamsterdam h.early split))
  refine registry_charge_of h fromFin tail high pre sameEpoch tailC highC endEpochC replayedC step
    member v inside flag charged ?_
  intro front post p q eventsY cf step' post' cut' site hcharge aFork aEpoch replayedY held
  have sameStart := charge_site_start cf step' _ site cfront cstep cpost csite hcharge charge
  have notStarted : ¬ (getCurrentEpoch split).toNat < (getCurrentEpoch p.state).toNat := by
    rw [sameStart]
    exact inSplitEpoch
  have start := split_epoch_start_data h highC toT pre sameEpoch earlier cf step'
    ((post'.snoc step).append post) endEpochC notStarted hcharge
  exact charge_effective_bound_of h toT (y := a) aFork (pre.append front) highC aEpoch
    (DirectSafety.Apriori.Internal.balanceEvents_append pre front highC replayedP replayedY)
    (pre.append cf) step' post'
    (by rw [← cut']; exact (Run.append_assoc pre (cf.snoc step') post').symm) hcharge
    start held

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The registry keys of the split are bounded at each slashing step on C's branch.

Every key is read at `whistleEnv` and the slack.

A key that C's branch charges to depart is also read at its charge.

A charge in the split's own epoch also reads the credits of `pre`. -/
private theorem registry_bounds (h : Setting config checks g split fin pulled anc counted V)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩) (high : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    {eventsF : List (BalanceEvent preset)} (replayedF : fromFin.balanceEvents high = .ok eventsF)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    {b : BeaconState preset fork} (toB : Run config checks g ⟨fork, b⟩)
    (pre : Run config checks ⟨fork, b⟩ ⟨fork, split⟩)
    (sameEpoch : getCurrentEpoch split = getCurrentEpoch b)
    (earlier : ∀ {u w : ForkedBeaconState preset} (step : Step config checks u w),
      toB.Contains step → (getCurrentEpoch u.state).toNat < (getCurrentEpoch b).toNat)
    {eventsP : List (BalanceEvent preset)} (replayedP : pre.balanceEvents highC = .ok eventsP) :
    (∀ {a b : ForkedBeaconState preset} (step : Step config checks a b),
      tailC.Contains step → ∀ i, i < split.validators.data.size →
        (split.validators.data[i]?.map (·.slashed)).getD false = false →
        (!(a.state.validators.data[i]?.map (·.slashed)).getD false &&
          (b.state.validators.data[i]?.map (·.slashed)).getD false) = true →
          effectiveAt a i ≤ whistleEnv (pinTerms config pulled anc fin) pulled anc fin i +
            whistleSlack (pinTerms config pulled anc fin) tailC (fromFin.append tail) highC high
              eventsC eventsF events fin i) ∧
    (∀ {a b : ForkedBeaconState preset} (step : Step config checks a b),
      tailC.Contains step → ∀ i, i < split.validators.data.size →
        (split.validators.data[i]?.map (·.slashed)).getD false = false →
        (!(a.state.validators.data[i]?.map (·.slashed)).getD false &&
          (b.state.validators.data[i]?.map (·.slashed)).getD false) = true →
        (tailC.departureCharges.any fun c => c.index == i) = true →
          effectiveAt a i ≤ chargeAmt tailC i + riseQ tailC highC i +
            (propN pre highC i + whistC pre highC i + syncCr eventsP i) +
            whistleSlack (pinTerms config pulled anc fin) tailC (fromFin.append tail) highC high
              eventsC eventsF events fin i) := by
  classical
  obtain ⟨toPulled⟩ := h.toPulled
  have grows : split.validators.data.size ≤ pulled.validators.data.size :=
    registryGrows_of_chainSteps toPulled.chainSteps
  refine ⟨fun {a b} step member i inside unslashed flag => ?_,
    fun {a b} step member i inside unslashed flag charged => ?_⟩
  · by_cases beyond : fin.validators.data.size ≤ i
    · -- A key created after the finalized state.
      by_cases kept : (pinTerms config pulled anc fin).keptArm i = true
      · obtain ⟨v, rfl⟩ := Uint64.exists_toNat_eq
          (inside.trans (BeaconState.validators_size_lt_of_lt_glamsterdam h.early split))
        obtain ⟨c, toC, fromC, cutC, insideC, -, before, floorStart, -⟩ :=
          created_first_state h fromFin beyond inside
        exact registry_frozen h tail high endEpoch replayed fromFin replayedF tailC highC
          endEpochC replayedC step member v.toNat toC fromC cutC insideC before (.inr floorStart)
          unslashed flag
          (fun w found _ => late_of_exitAfterFin h v.toNat (created_exitAfterFin h beyond) w found)
          kept
      · exact registry_headroom (config := config) h tailC step member i kept _
    · have inFin : i < fin.validators.data.size := Nat.lt_of_not_le beyond
      obtain ⟨w, found⟩ : ∃ w, pulled.validators.data[i]? = some w :=
        ⟨_, Array.getElem?_eq_getElem (Nat.lt_of_lt_of_le inside grows)⟩
      by_cases exited : w.exitEpoch.toNat + 1 ≤ (getCurrentEpoch fin).toNat
      · by_cases slashedR : (pinTerms config pulled anc fin).slashedRB i = true
        · by_cases kept : (pinTerms config pulled anc fin).keptArm i = true
          · refine registry_frozen h tail high endEpoch replayed fromFin replayedF tailC highC
              endEpochC replayedC step member i Run.nil fromFin (run_nil_append fromFin) inFin
              (finalized_start h i).1 (.inl (finalized_start h i).2) unslashed flag
              (fun w' found' unslashedR => ?_) kept
            -- R slashes the key, so it is not unslashed there
            rw [slashedRB_eq] at slashedR
            have := (of_decide_eq_true slashedR).1
            simp [found'] at this
            rw [this] at unslashedR
            exact absurd unslashedR (by decide)
          · exact registry_headroom (config := config) h tailC step member i kept _
        · exact registry_exited h fromFin tail high endEpoch replayedF tailC highC endEpochC
            replayedC step member i inside
            (fun w' found' => by
              obtain rfl := Option.some.inj (found.symm.trans found')
              exact exited) flag slashedR
      · -- A finalized key that exits at or after the finalized epoch.
        by_cases kept : (pinTerms config pulled anc fin).keptArm i = true
        · exact registry_frozen h tail high endEpoch replayed fromFin replayedF tailC highC
            endEpochC replayedC step member i Run.nil fromFin (run_nil_append fromFin) inFin
            (finalized_start h i).1 (.inl (finalized_start h i).2) unslashed flag
            (fun w' found' _ => late_of_exitAfterFin h i
              (fun w'' found'' => by
                obtain rfl := Option.some.inj (found.symm.trans found'')
                omega) w' found') kept
        · exact registry_headroom (config := config) h tailC step member i kept _
  · -- the charge of the key on C's run, found from the exit that the step assigns
    obtain ⟨c, chargeMember, chargeIndex⟩ := List.any_eq_true.mp charged
    have indexEq : c.index = i := by simpa using chargeIndex
    obtain ⟨cp, cq, cfront, cstep, cpost, csite, u, w, foundU, foundW, unset, assigned, -, -⟩ :=
      tailC.departure_charge_site c chargeMember
    have charge : cstep.departureCharges.any (·.index == i) = true := by
      rw [← indexEq]
      exact step_charges_of_exits cstep foundU foundW unset assigned
    by_cases started : (getCurrentEpoch split).toNat < (getCurrentEpoch cp.state).toNat
    · have bound := registry_charge (eventsF := eventsF) (events := events) h fromFin tail high
        tailC highC endEpochC replayedC step member i inside flag charged cfront cstep cpost
        csite charge started
      omega
    · exact registry_charge_split_epoch h fromFin tail high toB pre sameEpoch earlier tailC highC
        endEpochC replayedC replayedP step member i inside flag charged cfront cstep cpost csite
        charge started

/-- A charged key of `K5` whose charge is in the split's epoch.

The epoch's start `b` is on the shared run, before the split.

The key's credits from `b` come through the shared suffix `pre` of the split's epoch.

Then they come through C's run.

The bands of hysteresis at `b` come from the slot step that crossed into its epoch. -/
private theorem K5_charged_split_epoch
    (h : Setting config checks g split fin pulled anc counted V)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩)
    {events : List (BalanceEvent preset)}
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    {b : BeaconState preset fork} (toB : Run config checks g ⟨fork, b⟩)
    (pre : Run config checks ⟨fork, b⟩ ⟨fork, split⟩)
    (sameEpoch : getCurrentEpoch split = getCurrentEpoch b)
    (earlier : ∀ {u w : ForkedBeaconState preset} (step : Step config checks u w),
      toB.Contains step → (getCurrentEpoch u.state).toNat < (getCurrentEpoch b).toNat)
    {eventsF : List (BalanceEvent preset)}
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    {eventsP : List (BalanceEvent preset)} (replayedP : pre.balanceEvents highC = .ok eventsP)
    {v : ValidatorIndex} (member : v ∈ K5 counted V)
    {a c : ForkedBeaconState preset} (front : Run config checks ⟨fork, split⟩ a)
    (step : Step config checks a c) (post : Run config checks c ⟨fork, counted⟩)
    (site : (front.snoc step).append post = tailC)
    (charged : step.departureCharges.any (·.index == v.toNat) = true)
    (inSplitEpoch : ¬ (getCurrentEpoch split).toNat < (getCurrentEpoch a.state).toNat)
    (hexit : exitQ tailC v.toNat = effectiveAt a v.toNat) :
    eC counted v ≤ exitQ tailC v.toNat + riseQ tailC highC v.toNat +
      ((propN pre highC v.toNat + whistC pre highC v.toNat + syncCr eventsP v.toNat +
          propC tailC highC v.toNat +
          keyExtra (pinTerms config pulled anc fin) (fromFin.append tail) tailC highC
            eventsC events eventsF v.toNat (propC tailC highC v.toNat)) +
        whistC tailC highC v.toNat +
        (syncF events v.toNat + syncF eventsC v.toNat) +
        slashR (pinTerms config pulled anc fin) v.toNat + bandC tailC highC v.toNat +
        bandR (eventsF ++ events) v.toNat + bandX fin highC v.toNat) := by
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  subst site
  obtain ⟨-, -, -, -, unset, -⟩ := charge_exits step charged
  have charges : ∃ c ∈ ((front.snoc step).append post).departureCharges, c.index = v.toNat := by
    obtain ⟨charge, member, index⟩ := List.any_eq_true.mp charged
    exact ⟨charge, by simp [Run.departureCharges_append, Run.departureCharges, member],
      beq_iff_eq.mp index⟩
  have start := split_epoch_start_data h highC toB pre sameEpoch earlier front step post endEpochC
    inSplitEpoch charged
  -- the whole run from `b`: the shared part `pre`, then C's run from the split
  have whole := charge_effective_bound_of h toB (y := ⟨fork, counted⟩) rfl
    (pre.append ((front.snoc step).append post)) highC endEpochC
    (DirectSafety.Apriori.Internal.balanceEvents_append pre _ highC replayedP replayedC)
    (pre.append front) step post (Run.append_assoc pre (front.snoc step) post).symm charged
    start (K5_charged_held h member front step post charged)
  -- the credits of `pre` are its proposer, whistleblower and sync credits
  have noneBefore := no_prefix_charge_of_unset pre front v.toNat unset
  obtain ⟨propSplit, whistSplit, riseSame⟩ := prefix_append_credits v highC pre
    ((front.snoc step).append post) electra h.early sameEpoch noneBefore
  have rise := riseQ_eq_of_seen _ _ _ ((riseScan_fst v.toNat highC _).mpr charges)
  have syncLe : syncCr eventsC v.toNat ≤ syncF eventsC v.toNat := by
    have := syncF_eq eventsC v.toNat
    unfold syncCr
    omega
  have syncSplit : syncCr (eventsP ++ eventsC) v.toNat =
      syncCr eventsP v.toNat + syncCr eventsC v.toNat := by
    simp only [syncCr, List.map_append, List.sum_append]
  have eCeq : eC counted v = effectiveAt (⟨fork, counted⟩ : ForkedBeaconState preset) v.toNat :=
    rfl
  rw [riseSame] at whole
  omega

/-- A key of `K5` whose exit R reads: no charge on C's run.

Its exit is assigned at the split, so its deposits on C's run are postponed.

So `credC` is `propC`.

The rest is `key_core`. -/
private theorem K5_uncharged_key (h : Setting config checks g split fin pulled anc counted V)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩) (high : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    {eventsF : List (BalanceEvent preset)} (replayedF : fromFin.balanceEvents high = .ok eventsF)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    {v : ValidatorIndex} (member : v ∈ K5 counted V)
    (uncharged : ¬ ∃ c ∈ tailC.departureCharges, c.index = v.toNat) :
    eC counted v ≤ eR pulled v + (pinTerms config pulled anc fin).rise v.toNat +
      ((propC tailC highC v.toNat +
          keyExtra (pinTerms config pulled anc fin) (fromFin.append tail) tailC highC
            eventsC events eventsF v.toNat (propC tailC highC v.toNat)) +
        whistC tailC highC v.toNat +
        (syncF events v.toNat + syncF eventsC v.toNat) +
        slashR (pinTerms config pulled anc fin) v.toNat + bandC tailC highC v.toNat +
        bandR (eventsF ++ events) v.toNat + bandX fin highC v.toNat) := by
  obtain ⟨shared⟩ := h.toFin
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  obtain ⟨u, foundU, activeBefore, notNow⟩ := K5_previous_only h member
  have exitU := ((previous_only_iff_exit counted u).mp ⟨activeBefore, notNow⟩).2
  have notFar := getCurrentEpoch_ne_farFuture h.twoSlots counted
  have assignedU : u.exitEpoch ≠ FAR_FUTURE_EPOCH := fun far =>
    notFar (UInt64.toNat_inj.mp (by rw [← exitU, far]))
  -- every exit is a charge, so the key's exit was assigned before the split
  have insideSplit : v.toNat < split.validators.data.size := by
    by_contra out
    obtain ⟨c, listed, index, -⟩ := PinKeys.Run.charge_of_exit tailC electra h.early v.toNat
      (fun w hw => absurd (Array.getElem?_eq_some_iff.mp hw).1 out) u foundU assignedU
    exact uncharged ⟨c, listed, index⟩
  obtain ⟨v0, found0⟩ : ∃ w, split.validators.data[v.toNat]? = some w :=
    ⟨_, Array.getElem?_eq_getElem insideSplit⟩
  have assigned0 : v0.exitEpoch ≠ FAR_FUTURE_EPOCH := fun far => by
    obtain ⟨c, listed, index, -⟩ := PinKeys.Run.charge_of_exit tailC electra h.early v.toNat
      (fun w hw => by
        obtain rfl := Option.some.inj (found0.symm.trans hw)
        exact far) u foundU assignedU
    exact uncharged ⟨c, listed, index⟩
  obtain ⟨x, foundX, life⟩ := tailC.registryLifecycle.validators v.toNat v0 found0
  obtain rfl : x = u := Option.some.inj (foundX.symm.trans foundU)
  have exit0 := congrArg UInt64.toNat (life.exitEpoch assigned0)
  have delayed := (shared.append fromFin).exit_withdrawable_delay h.genesis v.toNat v0 found0
    assigned0
  have held : (getCurrentEpoch counted).toNat < v0.withdrawableEpoch.toNat := by
    have := h.delay
    omega
  have exited := exitEpoch_toNat_lt_of_ne_far assigned0
  have dep : (creditScan (fun _ => false) (fun s => decide (s = .deposits)) v.toNat highC tailC) =
      0 := by
    refine Nat.le_zero.mp
      ((scan_le_events (fun _ => false) (fun s => decide (s = .deposits)) (· = .deposits)
        (by intro s; simp) tailC highC v replayedC).trans (Nat.le_of_eq ?_))
    exact PinKeys.Run.exiting_deposit_credit_zero (shared.append fromFin) h.genesis tailC h.fulu
      h.early highC replayedC v.toNat v0 found0 exited held
  have credEq : credC tailC highC v.toNat = propC tailC highC v.toNat := by
    have split := credC_split tailC highC v.toNat
    have splitN := credN_split tailC highC v.toNat
    have splitP := propC_split tailC highC v.toNat
    omega
  have core := key_core h tail high endEpoch replayed fromFin replayedF tailC highC endEpochC
    replayedC v.toNat (Nat.lt_of_lt_of_le insideSplit tail.registryLifecycle.size_le)
    (by rw [UInt64.ofNat_toNat]; exact (Finset.mem_filter.mp member).1)
  unfold keyCeiling at core
  rw [credEq] at core
  simp only [eC, eR]
  omega

/-- The other keys that are previous-epoch-only in C, and their exits.

A key with a departure charge on C's run is at its charge plus its rise after that.

Any other key has its exit assigned before the split, so it is at its balance at R plus its rise.

Both add C's proposer credits and sync seats.

A key with a charge pays no deposit credit after it, so `propC` stands for its credits.

The run `pre` is the shared run from the start of the split's epoch.

A charge in that epoch reads the balance before the credits of `pre`.

So the key's proposer, whistleblower and sync credits over `pre` are read too. -/
private theorem cP_le (h : Setting config checks g split fin pulled anc counted V)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩) (high : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    {b : BeaconState preset fork} (toB : Run config checks g ⟨fork, b⟩)
    (pre : Run config checks ⟨fork, b⟩ ⟨fork, split⟩)
    (sameEpoch : getCurrentEpoch split = getCurrentEpoch b)
    (earlier : ∀ {u w : ForkedBeaconState preset} (step : Step config checks u w),
      toB.Contains step → (getCurrentEpoch u.state).toNat < (getCurrentEpoch b).toNat)
    {eventsF : List (BalanceEvent preset)} (replayedF : fromFin.balanceEvents high = .ok eventsF)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    {eventsP : List (BalanceEvent preset)} (replayedP : pre.balanceEvents highC = .ok eventsP) :
    cP pulled counted V ≤ ((∑ v ∈ (K5 counted V) with
        ¬ ∃ c ∈ tailC.departureCharges, c.index = v.toNat,
        (eR pulled v + (pinTerms config pulled anc fin).rise v.toNat)) +
      (∑ v ∈ (K5 counted V) with ∃ c ∈ tailC.departureCharges, c.index = v.toNat,
        (exitQ tailC v.toNat + riseQ tailC highC v.toNat)) +
      (∑ v ∈ (K5 counted V), ((propN pre highC v.toNat + whistC pre highC v.toNat +
          syncCr eventsP v.toNat + propC tailC highC v.toNat +
          keyExtra (pinTerms config pulled anc fin) (fromFin.append tail) tailC highC
            eventsC events eventsF v.toNat (propC tailC highC v.toNat)) +
        whistC tailC highC v.toNat +
        (syncF events v.toNat + syncF eventsC v.toNat) +
        slashR (pinTerms config pulled anc fin) v.toNat + bandC tailC highC v.toNat +
        bandR (eventsF ++ events) v.toNat + bandX fin highC v.toNat)) : ℕ) := by
  set T : ValidatorIndex → ℕ := fun v => (propN pre highC v.toNat + whistC pre highC v.toNat +
          syncCr eventsP v.toNat + propC tailC highC v.toNat +
          keyExtra (pinTerms config pulled anc fin) (fromFin.append tail) tailC highC
            eventsC events eventsF v.toNat (propC tailC highC v.toNat)) +
        whistC tailC highC v.toNat +
        (syncF events v.toNat + syncF eventsC v.toNat) +
        slashR (pinTerms config pulled anc fin) v.toNat + bandC tailC highC v.toNat +
        bandR (eventsF ++ events) v.toNat + bandX fin highC v.toNat with hT
  -- a charged key: its charge, the start of its epoch, and its exact rise after the charge
  have charged : ∀ v ∈ K5 counted V, (∃ c ∈ tailC.departureCharges, c.index = v.toNat) →
      eC counted v ≤ exitQ tailC v.toNat + riseQ tailC highC v.toNat + T v := by
    intro v member ch
    obtain ⟨a, c, front, step, post, site, hcharge, unset, hin, hexit⟩ :=
      K5_charge_site h tailC member ch
    subst site
    by_cases started : (getCurrentEpoch split).toNat < (getCurrentEpoch a.state).toNat
    swap
    · exact K5_charged_split_epoch h tail fromFin toB pre sameEpoch earlier _ highC endEpochC
        replayedC replayedP member front step post rfl hcharge started hexit
    have bound := charge_effective_bound h (y := ⟨fork, counted⟩) rfl _ highC endEpochC replayedC
      front step post rfl hcharge started (K5_charged_held h member front step post hcharge)
    have rise := riseQ_eq_of_seen _ _ _ ((riseScan_fst v.toNat highC _).mpr ch)
    have sync := syncF_eq eventsC v.toNat
    unfold syncCr at bound
    have slack : propC ((front.snoc step).append post) highC v.toNat +
        whistC ((front.snoc step).append post) highC v.toNat + syncF eventsC v.toNat ≤ T v := by
      simp only [hT]
      omega
    have eCeq : eC counted v = effectiveAt (⟨fork, counted⟩ : ForkedBeaconState preset) v.toNat :=
      rfl
    omega
  have eq : cP pulled counted V = ∑ v ∈ K5 counted V, (eC counted v : ℤ) := by
    unfold cP
    rw [← Finset.sum_filter]
    congr 1
    ext v
    simp only [K5]
    rw [Finset.mem_filter, Finset.mem_filter]
    simp only [U, AC, AR, Q, Finset.mem_union]
    tauto
  rw [eq, ← Nat.cast_sum]
  refine Nat.cast_le.mpr ?_
  show _ ≤ _ + _ + ∑ v ∈ K5 counted V, T v
  have splitE := Finset.sum_filter_add_sum_filter_not (K5 counted V)
    (fun v => ∃ c ∈ tailC.departureCharges, c.index = v.toNat) (eC counted)
  have splitT := Finset.sum_filter_add_sum_filter_not (K5 counted V)
    (fun v => ∃ c ∈ tailC.departureCharges, c.index = v.toNat) T
  have onCharged : ∑ v ∈ (K5 counted V) with ∃ c ∈ tailC.departureCharges, c.index = v.toNat,
      eC counted v ≤ ∑ v ∈ (K5 counted V) with ∃ c ∈ tailC.departureCharges, c.index = v.toNat,
        (exitQ tailC v.toNat + riseQ tailC highC v.toNat) +
      ∑ v ∈ (K5 counted V) with ∃ c ∈ tailC.departureCharges, c.index = v.toNat, T v := by
    rw [← Finset.sum_add_distrib]
    exact Finset.sum_le_sum fun v hv => charged v (Finset.mem_filter.mp hv).1
      (Finset.mem_filter.mp hv).2
  have onUncharged : ∑ v ∈ (K5 counted V) with ¬ ∃ c ∈ tailC.departureCharges,
        c.index = v.toNat, eC counted v ≤ ∑ v ∈ (K5 counted V) with ¬ ∃ c ∈ tailC.departureCharges,
        c.index = v.toNat, (eR pulled v + (pinTerms config pulled anc fin).rise v.toNat) +
      ∑ v ∈ (K5 counted V) with ¬ ∃ c ∈ tailC.departureCharges, c.index = v.toNat, T v := by
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_le_sum fun v hv => ?_
    obtain ⟨member, none⟩ := Finset.mem_filter.mp hv
    have key := K5_uncharged_key h tail high endEpoch replayed fromFin replayedF tailC highC
      endEpochC replayedC member none
    simp only [hT]
    omega
  omega

/-- The cap takes over exactly when the weighted gain bound exceeds it. -/
private theorem gainHigh_eq_true_iff : (pinTerms config pulled anc fin).gainHigh = true ↔
    ¬ 11 * (pinTerms config pulled anc fin).depth *
      ((pinTerms config pulled anc fin).gainRateMax + 1) ≤
        preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat := by
  change (!decide (11 * (pinTerms config pulled anc fin).depth *
    ((pinTerms config pulled anc fin).gainRateMax + 1) ≤
      preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat)) = true ↔ _
  simp

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- A key of `K6` beyond R's registry rises by its credits and their gains, when the rate is low.

The key is not in R's registry, so its flow gain is charged when the largest rate is low.

The depth of the window is below an eleventh of an increment against the rate.

That gives the rate premise of `created_key_ceiling`. -/
private theorem beyond_key (h : Setting config checks g split fin pulled anc counted V)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩) (high : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    {events : List (BalanceEvent preset)}
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    {eventsF : List (BalanceEvent preset)} (replayedF : fromFin.balanceEvents high = .ok eventsF)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    (low : 11 * (pinTerms config pulled anc fin).depth *
      ((pinTerms config pulled anc fin).gainRateMax + 1) ≤
        preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat)
    {v : ValidatorIndex} (member : v ∈ K6 pulled counted)
    (created : pulled.validators.data.size ≤ v.toNat) :
    balanceAt counted v.toNat ≤
      (((credC tailC highC v.toNat +
          keyExtra (pinTerms config pulled anc fin) (fromFin.append tail) tailC highC
            eventsC events eventsF v.toNat) +
          whistC tailC highC v.toNat) +
        (syncF events v.toNat + syncF eventsC v.toNat) +
        (slashR (pinTerms config pulled anc fin) v.toNat + bandC tailC highC v.toNat +
          bandR (eventsF ++ events) v.toNat)) + bandX fin highC v.toNat := by
  classical
  obtain ⟨toPulled⟩ := h.toPulled
  have grows : split.validators.data.size ≤ pulled.validators.data.size :=
    registryGrows_of_chainSteps toPulled.chainSteps
  have activated := activated_of_activeVoters h.early (Finset.mem_filter.mp member).1
  have absent := Nat.le_trans grows created
  -- the key is beyond R's registry, so its flow gain is charged while the rate is low
  have notPosition : v.toNat ∉ (pinTerms config pulled anc fin).positions := by
    show v.toNat ∉ Finset.range pulled.validators.data.size
    rw [Finset.mem_range]
    omega
  have lowGain : (pinTerms config pulled anc fin).gainHigh = false :=
    Bool.eq_false_iff.mpr fun high => gainHigh_eq_true_iff.mp high low
  exact created_key_ceiling h tail fromFin tailC highC endEpochC replayedC activated absent
    (key_of_lowGain h lowGain) (Or.inr ⟨notPosition, lowGain⟩)
    (created_band h fromFin high endEpoch replayedF tailC highC endEpochC replayedC activated
      absent)

/-- The units of the active keys of `CS` are held by the units of the keys of `CS`.

Off the high gain rate each active key of `CS` charges one `unitGain` for its stake at the slashing.

Each of them was created by a deposit of C's run, so its flows are positive and its unit is one.

The slot of that unit is the slot of the deposit, which `bud_units` already gives to the key. -/
private theorem bud_csUnits (h : Setting config checks g split fin pulled anc counted V)
    {events eventsF : List (BalanceEvent preset)}
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC) :
    (if (pinTerms config pulled anc fin).gainHigh = true then 0 else
      ((CS counted split).filter fun v =>
        isActiveAt counted (getCurrentEpoch counted) v.toNat = true).card *
          (pinTerms config pulled anc fin).unitGain) ≤
      ∑ v ∈ CS counted split,
        unitK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF v.toNat := by
  split_ifs
  · exact Nat.zero_le _
  obtain ⟨_, replayedF⟩ := fromFin.balanceEvents_ok h.early (getCurrentEpoch pulled).toNat
  rw [sum_unitK _ tailC highC eventsC events eventsF _ fun v => credC tailC highC v.toNat,
    Nat.mul_comm]
  refine Nat.mul_le_mul_left _ (Finset.card_le_card fun v member => ?_)
  obtain ⟨inCS, active⟩ := Finset.mem_filter.mp member
  refine Finset.mem_filter.mpr ⟨inCS, ?_⟩
  obtain ⟨-, absent, -⟩ := Finset.mem_filter.mp inCS
  obtain ⟨w, found, live⟩ := isActiveAt_eq_true_iff.mp active
  have deposit := created_deposit h fromFin replayedF tailC highC endEpochC replayedC
    ⟨w, found, activated_of_active live (UInt64.le_refl _)⟩ absent
  have cSplit := credC_split tailC highC v.toNat
  have nSplit := credN_split tailC highC v.toNat
  unfold flowCredit
  omega

/-- The keys of `K6` beyond R's registry and the active keys of `CS` fit the deposit slots.

Each is created after the split and activated by C, so a deposit of C's run credits it.

The two sets are apart, since the keys of `K6` are unslashed at C and those of `CS` are slashed.

The deposits of C's run credit at most one epoch's slots in each epoch since the split. -/
private theorem created_slots_le (h : Setting config checks g split fin pulled anc counted V) :
    ((K6 pulled counted).filter fun v => pulled.validators.data.size ≤ v.toNat).card +
      ((CS counted split).filter fun v =>
        isActiveAt counted (getCurrentEpoch counted) v.toNat = true).card ≤
      ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) *
        preset.MAX_PENDING_DEPOSITS_PER_EPOCH.toNat := by
  classical
  obtain ⟨fromFin⟩ := h.fromFin
  obtain ⟨toPulled⟩ := h.toPulled
  obtain ⟨tailC⟩ := h.toCounted
  have grows : split.validators.data.size ≤ pulled.validators.data.size :=
    registryGrows_of_chainSteps toPulled.chainSteps
  obtain ⟨eventsF, replayedF⟩ := fromFin.balanceEvents_ok h.early (getCurrentEpoch pulled).toNat
  obtain ⟨eventsC, replayedC⟩ := tailC.balanceEvents_ok h.early (getCurrentEpoch counted).toNat
  have deposit : ∀ v : ValidatorIndex, (∃ w, counted.validators.data[v.toNat]? = some w ∧
      w.activationEpoch ≠ FAR_FUTURE_EPOCH ∧ w.activationEpoch ≤ getCurrentEpoch counted) →
      split.validators.data.size ≤ v.toNat →
        0 < (creditScan (fun _ => false) (fun s => decide (s = .deposits)) v.toNat
          (getCurrentEpoch counted).toNat tailC) := fun v activated absent =>
    created_deposit h fromFin replayedF tailC (getCurrentEpoch counted).toNat (Nat.le_succ _)
      replayedC activated absent
  have apart := (cs_disjoint h).1
  rw [← Finset.card_union_of_disjoint (Finset.disjoint_left.mpr fun v inK6 inCS =>
    Finset.disjoint_left.mp apart (Finset.mem_union_left _ (Finset.mem_union_right _
      (Finset.mem_filter.mp inK6).1)) (Finset.mem_filter.mp inCS).1)]
  have image : ((((K6 pulled counted).filter fun v => pulled.validators.data.size ≤ v.toNat) ∪
      ((CS counted split).filter fun v =>
        isActiveAt counted (getCurrentEpoch counted) v.toNat = true)).image
          fun v : ValidatorIndex => v.toNat).card = (((K6 pulled counted).filter fun v =>
            pulled.validators.data.size ≤ v.toNat) ∪ ((CS counted split).filter fun v =>
              isActiveAt counted (getCurrentEpoch counted) v.toNat = true)).card :=
    Finset.card_image_of_injOn fun a _ b _ same => UInt64.toNat_inj.mp same
  rw [← image]
  refine deposit_scan_card_le h tailC (getCurrentEpoch counted).toNat _ fun i hi => ?_
  obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp hi
  rcases Finset.mem_union.mp hv with inK6 | inCS
  · obtain ⟨member, beyond⟩ := Finset.mem_filter.mp inK6
    exact deposit v (activated_of_activeVoters h.early (Finset.mem_filter.mp member).1)
      (Nat.le_trans grows beyond)
  · obtain ⟨member, active⟩ := Finset.mem_filter.mp inCS
    obtain ⟨w, found, isActive⟩ := isActiveAt_eq_true_iff.mp active
    exact deposit v ⟨w, found, activated_of_active isActive (UInt64.le_refl _)⟩
      (Finset.mem_filter.mp member).2.1

/-- The keys of `CS` that are active at C fit the deposit slots that the keys beyond R leave.

At a high gain rate each takes the largest cap, and `creditCap` is the cap of each deposit slot.

The keys of `K6` beyond R's registry take `capUse` of it, so the slots are counted once.

Each key created after R's registry came through a pending deposit of the window. -/
private theorem bud_capSlots (h : Setting config checks g split fin pulled anc counted V) :
    capUse config pulled anc fin counted +
      (if (pinTerms config pulled anc fin).gainHigh = true then
        ((CS counted split).filter fun v =>
          isActiveAt counted (getCurrentEpoch counted) v.toNat = true).card *
            preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat else 0) ≤
      (pinTerms config pulled anc fin).creditCap := by
  classical
  by_cases high : (pinTerms config pulled anc fin).gainHigh = true
  · have cap : (pinTerms config pulled anc fin).creditCap =
        ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat) *
          preset.MAX_PENDING_DEPOSITS_PER_EPOCH.toNat *
            preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat := by
      have low := gainHigh_eq_true_iff.mp high
      show (if 11 * (pinTerms config pulled anc fin).depth *
          ((pinTerms config pulled anc fin).gainRateMax + 1) ≤
            preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat then 0 else
              (pinTerms config pulled anc fin).depthFin *
                preset.MAX_PENDING_DEPOSITS_PER_EPOCH.toNat *
                  preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat) = _
      rw [ite_eq_right_of_eq_false _ _ (eq_false low)]
      rfl
    unfold capUse
    rw [ite_eq_left high, ite_eq_left high, cap, ← Nat.add_mul]
    exact Nat.mul_le_mul_right _ (by
      rw [Nat.mul_comm _ preset.MAX_PENDING_DEPOSITS_PER_EPOCH.toNat]
      exact (created_slots_le h).trans (Nat.le_of_eq (Nat.mul_comm _ _)))
  · unfold capUse
    rw [ite_eq_right high, ite_eq_right high]
    exact Nat.zero_le _

/-- A key beyond the split's registry that C slashes has a positive deposit scan on C's run.

Its exit is assigned on C's run, so the run holds its departure charge.

The charge's step activates the key, and the activation is at most C's epoch.

`created_deposit` reads the deposit of a created key activated by C. -/
private theorem whist_created (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩) (high : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    {eventsF : List (BalanceEvent preset)} (replayedF : fromFin.balanceEvents high = .ok eventsF)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC) :
    ∀ i ∈ (slashedOnC split counted).filter (fun i => ¬ i < split.validators.data.size),
      0 < (creditScan (fun _ => false) (fun s => decide (s = .deposits)) i highC tailC) := by
  classical
  intro i member
  obtain ⟨toFin⟩ := h.toFin
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  obtain ⟨inSlashed, outside⟩ := Finset.mem_filter.mp member
  simp only [slashedOnC, Finset.mem_filter, Finset.mem_range] at inSlashed
  obtain ⟨insideC, -, flagC⟩ := inSlashed
  have foundC : counted.validators.data[i]? = some counted.validators.data[i] :=
    Array.getElem?_eq_some_iff.mpr ⟨insideC, rfl⟩
  have slashedW : counted.validators.data[i].slashed = true := by simpa [foundC] using flagC
  have exitAssigned := run_slashed_exit_assigned ((toFin.append fromFin).append tailC) h.genesis
    h.caps.activation h.caps.compounding h.early h.delay i _ foundC slashedW
  have unset : ∀ v, (⟨fork, split⟩ : ForkedBeaconState preset).state.validators.data[i]? =
      some v → v.exitEpoch = FAR_FUTURE_EPOCH := fun v found => by
    rw [Array.getElem?_eq_none (Nat.le_of_not_lt outside)] at found
    cases found
  obtain ⟨c, cMember, cIndex, -⟩ := PinKeys.Run.charge_of_exit tailC electra h.early i unset _
    foundC exitAssigned
  obtain ⟨a, b, pre, step, post, -, vv, ww, found, foundB, -, set, activated, -, -⟩ :=
    charge_activated (x := ⟨fork, split⟩) electra tailC c (tailC.departure_charge_site c cMember)
  rw [cIndex] at found foundB
  obtain ⟨wc, foundWc, lifeB⟩ := post.registryLifecycle.validators i ww foundB
  have sameWc : wc = counted.validators.data[i] :=
    Option.some.inj (foundWc.symm.trans foundC)
  have finite : (getCurrentEpoch a.state).toNat < FAR_FUTURE_EPOCH.toNat := by
    have farNat : FAR_FUTURE_EPOCH.toNat = 2 ^ 64 - 1 := rfl
    have two := h.twoSlots
    have slotLt := a.state.slot.toNat_lt
    rw [getCurrentEpoch_toNat, farNat]
    calc a.state.slot.toNat / preset.SLOTS_PER_EPOCH.toNat ≤ a.state.slot.toNat / 2 :=
          Nat.div_le_div_left two (by norm_num)
      _ < 2 ^ 64 - 1 := by omega
  have notFar : vv.activationEpoch ≠ FAR_FUTURE_EPOCH := fun same =>
    absurd (UInt64.le_iff_toNat_le.mp (same ▸ activated)) (Nat.not_le.mpr finite)
  obtain ⟨u, foundU, keptStep⟩ := (RegistryLifecycle.chainStep step.chainStep).validators i vv
    found
  have sameU : u = ww := Option.some.inj (foundU.symm.trans foundB)
  have actEq : counted.validators.data[i].activationEpoch = vv.activationEpoch := by
    rw [← sameWc, lifeB.activationEpoch (by rw [← sameU, keptStep.activationEpoch notFar]; exact
      notFar), ← sameU, keptStep.activationEpoch notFar]
  have epochLe : (getCurrentEpoch a.state).toNat ≤ (getCurrentEpoch counted).toNat :=
    Nat.le_trans (UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps
      (Relation.ReflTransGen.single step.chainStep)))
      (UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps post.chainSteps))
  have within := BeaconState.validators_size_lt_of_lt_glamsterdam h.early counted
  have same : (UInt64.ofNat i).toNat = i :=
    UInt64.toNat_ofNat_of_lt' (Nat.lt_trans insideC within)
  have replayedF' := replay_at_pulled pulled fromFin high endEpoch h.called replayedF
  have actLe : counted.validators.data[i].activationEpoch ≤ getCurrentEpoch counted := by
    rw [actEq]
    exact UInt64.le_iff_toNat_le.mpr (Nat.le_trans (UInt64.le_iff_toNat_le.mp activated) epochLe)
  have := created_deposit h fromFin replayedF' tailC highC endEpochC replayedC
    (v := UInt64.ofNat i)
    ⟨counted.validators.data[i], by rw [same]; exact foundC, by rw [actEq]; exact notFar, actLe⟩
    (by rw [same]; exact Nat.le_of_not_lt outside)
  rwa [same] at this

/-- The seat bands of the registry keys that C slashes fit the seat term of the base.

A key with a band holds a seat on the run from the finalized state to R.

An exited key's shared credit is a gross credit of that run, and the key is no proposer on it.

The seats of one run are the committees of the periods from the finalized state's to R's. -/
private theorem whist_seat (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩) (high : ℕ)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    {eventsF : List (BalanceEvent preset)} (replayedF : fromFin.balanceEvents high = .ok eventsF)
    (T : Finset ℕ) :
    ∑ i ∈ T, (bandR (eventsF ++ events) i +
      if (pinTerms config pulled anc fin).exitBeforeFin i = true then
        (if 0 < syncCr eventsF i then preset.upwardBand else 0) else 0) ≤
      2 * (((pinTerms config pulled anc fin).depthFin /
          max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat + 2) *
        preset.SYNC_COMMITTEE_SIZE.toNat *
          (preset.EFFECTIVE_BALANCE_INCREMENT.toNat + preset.downwardBand)) := by
  classical
  obtain ⟨toFin⟩ := h.toFin
  have finSplit : (getCurrentEpoch fin).toNat ≤ (getCurrentEpoch split).toNat :=
    UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps fromFin.chainSteps)
  have called := UInt64.le_iff_toNat_le.mp h.called
  generalize hP : max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat = P
  have periods : (getCurrentEpoch pulled).toNat / P =
      (getCurrentEpoch fin).toNat / P +
        ((getCurrentEpoch pulled).toNat / P - (getCurrentEpoch fin).toNat / P) := by
    have := Nat.div_le_div_right (c := P) (Nat.le_trans finSplit called)
    omega
  have replayedR : (fromFin.append tail).balanceEvents high = .ok (eventsF ++ events) :=
    DirectSafety.Apriori.Internal.balanceEvents_append fromFin tail high replayedF replayed
  obtain ⟨Ls, B, S, D, -, cardS, -, hBS, -, -, hProposer, hDebit, -⟩ :=
    credited_pieces_seated h.genesis h.parameters.lookahead (y := ⟨fork, pulled⟩) h.early
      h.delay high ((getCurrentEpoch pulled).toNat /
          max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat -
        (getCurrentEpoch fin).toNat / max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat)
      toFin (fromFin.append tail) h.fulu (by rw [hP]; exact periods)
  rw [hP] at cardS
  -- the keys with a band hold a seat of the run
  obtain ⟨term, hterm⟩ : ∃ term : ℕ → ℕ, ∀ i, term i = bandR (eventsF ++ events) i +
      if (pinTerms config pulled anc fin).exitBeforeFin i = true then
        (if 0 < syncCr eventsF i then preset.upwardBand else 0) else 0 := ⟨_, fun _ => rfl⟩
  have seated : ∀ i, term i ≠ 0 → i ∈ S := by
    intro i nonzero
    rw [hterm] at nonzero
    by_cases debit : 0 < ((eventsF ++ events).map (syncDebit i)).sum
    · exact (hDebit _ replayedR i debit).1
    · simp only [bandR_eq, debit, ↓reduceIte, Nat.zero_add] at nonzero
      by_cases exited : (pinTerms config pulled anc fin).exitBeforeFin i = true
      · simp only [exited, ↓reduceIte] at nonzero
        have credit : 0 < syncCr eventsF i := by
          by_contra none
          simp [none] at nonzero
        have gross := syncCr_gross_shared h fromFin tail high replayedF i credit
        rcases hBS i gross with proposer | seat
        · exfalso
          obtain ⟨u, run, p, early, found, same⟩ := hProposer i proposer
          obtain ⟨w, foundW, exit⟩ : ∃ w, pulled.validators.data[i]? = some w ∧
              w.exitEpoch.toNat ≤ (getCurrentEpoch fin).toNat := by
            have flag : ((pulled.validators.data[i]?).any fun v =>
                decide (v.exitEpoch.toNat ≤ (getCurrentEpoch fin).toNat)) = true := exited
            cases found : pulled.validators.data[i]? with
            | none => simp [found] at flag
            | some w =>
              rw [found] at flag
              exact ⟨w, rfl, of_decide_eq_true (by simpa using flag)⟩
          exact exited_not_proposer h foundW exit u run p early found same
        · exact seat
      · simp only [exited] at nonzero
        exact absurd rfl nonzero
  have perKey : ∀ i, term i ≤ 2 * (preset.EFFECTIVE_BALANCE_INCREMENT.toNat +
      preset.downwardBand) := by
    intro i
    have up := h.facts.upward
    rw [hterm, bandR_eq]
    split_ifs <;> omega
  have cover : ∑ i ∈ T, term i ≤
      (T.filter fun i => term i ≠ 0).card * (2 * (preset.EFFECTIVE_BALANCE_INCREMENT.toNat +
        preset.downwardBand)) := by
    rw [← Finset.sum_filter_ne_zero]
    exact (Finset.sum_le_card_nsmul _ _ _ fun i _ => perKey i).trans (by rw [smul_eq_mul])
  have count : (T.filter fun i => term i ≠ 0).card ≤ preset.SYNC_COMMITTEE_SIZE.toNat *
      ((pinTerms config pulled anc fin).depthFin / P + 2) := by
    refine (Finset.card_le_card fun i member => seated i (Finset.mem_filter.mp member).2).trans
      (cardS.trans (Nat.mul_le_mul_left _ ?_))
    have := Nat.add_div_le_div_add_div_add_one
      ((getCurrentEpoch pulled).toNat - (getCurrentEpoch fin).toNat) (getCurrentEpoch fin).toNat P
    have back : (getCurrentEpoch pulled).toNat - (getCurrentEpoch fin).toNat +
        (getCurrentEpoch fin).toNat = (getCurrentEpoch pulled).toNat := by omega
    rw [back] at this
    have wide := Nat.div_le_div_right (c := P)
      (show (getCurrentEpoch pulled).toNat - (getCurrentEpoch fin).toNat ≤
        (pinTerms config pulled anc fin).depthFin from by
          show _ ≤ (getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat
          omega)
    omega
  rw [show ∑ i ∈ T, (bandR (eventsF ++ events) i +
      if (pinTerms config pulled anc fin).exitBeforeFin i = true then
        (if 0 < syncCr eventsF i then preset.upwardBand else 0) else 0) = ∑ i ∈ T, term i from
    Finset.sum_congr rfl fun i _ => (hterm i).symm]
  calc ∑ i ∈ T, term i ≤ _ := cover
    _ ≤ 2 * (((pinTerms config pulled anc fin).depthFin / P + 2) *
        preset.SYNC_COMMITTEE_SIZE.toNat *
          (preset.EFFECTIVE_BALANCE_INCREMENT.toNat + preset.downwardBand)) := by
      have := Nat.mul_le_mul_right (2 * (preset.EFFECTIVE_BALANCE_INCREMENT.toNat +
        preset.downwardBand)) count
      calc _ ≤ _ := this
        _ = _ := by ring

/-- The units and the induced leak of the registry keys that C slashes fit the base.

The keys are in `SC`, and `bud_units` and `bud_syncLeak` bound `SC` alone at weight one.

A key that R slashes holds a second unit, and `slashedRB_card_le` bounds those keys. -/
private theorem whist_units (h : Setting config checks g split fin pulled anc counted V)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩) (high : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    {eventsF : List (BalanceEvent preset)} (replayedF : fromFin.balanceEvents high = .ok eventsF)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    (T : Finset ℕ)
    (sub : T ⊆ (slashedOnC split counted).filter (fun i => i < split.validators.data.size)) :
    ∑ i ∈ T, (unitK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF i +
      inducedR (pinTerms config pulled anc fin) (fromFin.append tail) i +
      (if 0 < slashW (pinTerms config pulled anc fin) i then
        (pinTerms config pulled anc fin).unitGain else 0)) ≤
      (pinTerms config pulled anc fin).creditUnits + (pinTerms config pulled anc fin).syncLeak +
        (pinTerms config pulled anc fin).unitGain *
          ((pinTerms config pulled anc fin).consolidationsXCount +
            2 * (pinTerms config pulled anc fin).slashedR) +
        (pinTerms config pulled anc fin).slashedR *
          (pinTerms config pulled anc fin).slashLeak := by
  classical
  obtain ⟨toPulled⟩ := h.toPulled
  have units := (bud_units h tail high replayed fromFin replayedF tailC highC endEpochC
    replayedC).2
  have leak := (bud_syncLeak h tail high endEpoch replayed fromFin replayedF).2
  have grows : split.validators.data.size ≤ pulled.validators.data.size :=
    registryGrows_of_chainSteps toPulled.chainSteps
  have within := BeaconState.validators_size_lt_of_lt_glamsterdam h.early pulled
  have insideT : ∀ i ∈ T, i < split.validators.data.size := fun i member =>
    (Finset.mem_filter.mp (sub member)).2
  have small : ∀ i ∈ T, i < 2 ^ 64 := fun i member =>
    Nat.lt_trans (Nat.lt_of_lt_of_le (insideT i member) grows) within
  have inSC : T.image UInt64.ofNat ⊆ SC pulled counted split := by
    intro v member
    obtain ⟨i, mem, rfl⟩ := Finset.mem_image.mp member
    obtain ⟨slashedOn, inside⟩ := Finset.mem_filter.mp (sub mem)
    simp only [slashedOnC, Finset.mem_filter, Finset.mem_range] at slashedOn
    obtain ⟨insideC, cleanSplit, slashedC⟩ := slashedOn
    simp only [SC, Finset.mem_filter, Finset.mem_image, Finset.mem_range,
      UInt64.toNat_ofNat_of_lt' (small i mem)]
    refine ⟨⟨i, Nat.lt_of_lt_of_le inside grows, rfl⟩, ?_, ?_⟩
    · have found : counted.validators.data[i]? = some counted.validators.data[i] :=
        Array.getElem?_eq_some_iff.mpr ⟨insideC, rfl⟩
      rw [found] at slashedC
      simp only [slashedFlagAt, found]
      simpa using slashedC
    · have found : split.validators.data[i]? = some split.validators.data[i] :=
        Array.getElem?_eq_some_iff.mpr ⟨inside, rfl⟩
      rw [found] at cleanSplit
      simp only [slashedFlagAt, found]
      simpa using cleanSplit
  have conv := sum_image_ofNat T small
  have sumSC : ∀ f : ℕ → ℕ, ∑ i ∈ T, f i ≤ ∑ v ∈ SC pulled counted split, f v.toNat := fun f => by
    rw [← conv f]
    exact Finset.sum_le_sum_of_subset inSC
  -- the second unit of the keys that R slashes
  have second : ∑ i ∈ T, (if 0 < slashW (pinTerms config pulled anc fin) i then
      (pinTerms config pulled anc fin).unitGain else 0) ≤
      (pinTerms config pulled anc fin).unitGain * (pinTerms config pulled anc fin).slashedR := by
    rw [← conv (fun i => if 0 < slashW (pinTerms config pulled anc fin) i then
      (pinTerms config pulled anc fin).unitGain else 0)]
    have pointwise : ∀ v ∈ T.image UInt64.ofNat,
        (if 0 < slashW (pinTerms config pulled anc fin) v.toNat then
          (pinTerms config pulled anc fin).unitGain else 0) ≤
        if (pinTerms config pulled anc fin).slashedRB v.toNat = true then
          (pinTerms config pulled anc fin).unitGain else 0 := fun v _ => by
      by_cases pos : 0 < slashW (pinTerms config pulled anc fin) v.toNat
      · have flag : (pinTerms config pulled anc fin).slashedRB v.toNat = true := by
          by_contra no
          simp [slashW, no] at pos
        simp [pos, flag]
      · simp [pos]
    refine (Finset.sum_le_sum pointwise).trans ?_
    rw [← Finset.sum_filter, Finset.sum_const, smul_eq_mul, Nat.mul_comm]
    exact Nat.mul_le_mul_left _ (slashedRB_card_le config pulled anc fin _)
  simp only [Finset.sum_add_distrib]
  have u := sumSC (fun i => unitK (pinTerms config pulled anc fin) tailC highC eventsC events
    eventsF i)
  have l := sumSC (fun i => inducedR (pinTerms config pulled anc fin) (fromFin.append tail) i)
  have expand : (pinTerms config pulled anc fin).unitGain *
      ((pinTerms config pulled anc fin).consolidationsXCount +
        2 * (pinTerms config pulled anc fin).slashedR) =
      (pinTerms config pulled anc fin).unitGain *
        ((pinTerms config pulled anc fin).consolidationsXCount +
          (pinTerms config pulled anc fin).slashedR) +
      (pinTerms config pulled anc fin).unitGain * (pinTerms config pulled anc fin).slashedR := by
    ring
  omega

/-- The slack of the keys and the extra terms fit twice the credit, band and unit totals. -/
private theorem whist_slack_arith (S Yp Y X0 Wc u SB SU slotsInc B F cu sl e1 e2 : ℕ)
    (hs : S ≤ 2 * ((11 * Yp + 9) / 10) + 2 * Wc + u + SB + SU) (hY : Yp + X0 ≤ Y)
    (hu : u ≤ 2 * slotsInc) (hB : slotsInc ≤ B) (hSB : SB ≤ 2 * F) (hSU : SU ≤ cu + sl + e1 + e2) :
    S + X0 ≤ 2 * ((11 * Y + 9) / 10) + 2 * (B + F + cu + sl + e1 + e2) + 2 * Wc := by
  have rise : (11 * Yp + 9) / 10 + X0 ≤ (11 * Y + 9) / 10 := by omega
  omega

/-- The whistleblower credits of any keys on C's branch fit the base of `otherCredits`.

The base reads each key of R's registry at twice its bound.

It reads each deposited or created key at the largest cap.

`registry` and `registryCharge` are the bounds of the registry keys at their slashing.

The proof reads the base of `otherCredits` off its definition and pays each term of the slack. -/
private theorem flow_whist (h : Setting config checks g split fin pulled anc counted V)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩) (high : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    {eventsF : List (BalanceEvent preset)} (replayedF : fromFin.balanceEvents high = .ok eventsF)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    (highLeR : high ≤ (getCurrentEpoch pulled).toNat)
    (highLe : highC ≤ (getCurrentEpoch pulled).toNat)
    {b : BeaconState preset fork} (pre : Run config checks ⟨fork, b⟩ ⟨fork, split⟩)
    {eventsP : List (BalanceEvent preset)}
    (registry : ∀ {a b : ForkedBeaconState preset} (step : Step config checks a b),
      tailC.Contains step → ∀ i, i < split.validators.data.size →
        (split.validators.data[i]?.map (·.slashed)).getD false = false →
        (!(a.state.validators.data[i]?.map (·.slashed)).getD false &&
          (b.state.validators.data[i]?.map (·.slashed)).getD false) = true →
          effectiveAt a i ≤ whistleEnv (pinTerms config pulled anc fin) pulled anc fin i +
            whistleSlack (pinTerms config pulled anc fin) tailC (fromFin.append tail) highC high
              eventsC eventsF events fin i)
    (registryCharge : ∀ {a b : ForkedBeaconState preset} (step : Step config checks a b),
      tailC.Contains step → ∀ i, i < split.validators.data.size →
        (split.validators.data[i]?.map (·.slashed)).getD false = false →
        (!(a.state.validators.data[i]?.map (·.slashed)).getD false &&
          (b.state.validators.data[i]?.map (·.slashed)).getD false) = true →
        (tailC.departureCharges.any fun c => c.index == i) = true →
          effectiveAt a i ≤ chargeAmt tailC i + riseQ tailC highC i +
            (propN pre highC i + whistC pre highC i + syncCr eventsP i) +
            whistleSlack (pinTerms config pulled anc fin) tailC (fromFin.append tail) highC high
              eventsC eventsF events fin i) :
    ∃ WB : ℕ, (pinTerms config pulled anc fin).otherGain =
        (3 * (WB + (((pinTerms config pulled anc fin).depth +
          ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat)) *
            preset.SLOTS_PER_EPOCH.toNat * preset.SYNC_COMMITTEE_SIZE.toNat *
              PinTerms.syncEnvelope preset
                ((getTotalActiveBalance pulled).toOption.getD 0).toNat +
            (pinTerms config pulled anc fin).depth *
              (pinTerms config pulled anc fin).syncProposer))) /
          preset.EFFECTIVE_BALANCE_INCREMENT.toNat * (pinTerms config pulled anc fin).perIncrement *
            (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum / WEIGHT_DENOMINATOR.toNat ∧
      ∀ keys : Finset ValidatorIndex, ∑ v ∈ keys, whistC tailC highC v.toNat ≤ WB := by
  classical
  have count := whist_count h tailC highC endEpochC replayedC
    (whist_created h fromFin high endEpoch replayedF tailC highC endEpochC replayedC)
  set t := pinTerms config pulled anc fin with ht
  have hdf : t.depthFin = (getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat := rfl
  have inc_pos := h.bands.1
  set inc := preset.EFFECTIVE_BALANCE_INCREMENT.toNat with hinc
  set M := preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat with hM
  set MPD := preset.MAX_PENDING_DEPOSITS_PER_EPOCH.toNat with hMPD
  set SCS := preset.SYNC_COMMITTEE_SIZE.toNat with hSCS
  set slots := preset.SLOTS_PER_EPOCH.toNat with hslots
  set P := max 1 preset.EPOCHS_PER_SYNC_COMMITTEE_PERIOD.toNat with hP
  set env := PinTerms.syncEnvelope preset
    ((getTotalActiveBalance pulled).toOption.getD 0).toNat
    with henv
  set W := (parameters preset fork).WHISTLEBLOWER_REWARD_QUOTIENT.toNat with hW
  set Sx := ∑ i ∈ t.positions, max (max (t.ebUp i) (balanceAt pulled i + t.rise i)) (t.bF i)
    with hSx
  set Y := t.depthFin * MPD * M + t.consolidationsX + t.depth * t.proposerCredit +
    t.depthFin * t.syncProposer + t.depth * slots * SCS * env + t.depthFin * slots * SCS * env
    with hY
  set F := (t.depthFin / P + 2) * SCS * (inc + preset.downwardBand) with hF
  set e1 := t.unitGain * (t.consolidationsXCount + 2 * t.slashedR) with he1
  set e2 := t.slashedR * t.slashLeak with he2
  set slots' := t.depth * slots + (t.depth / P + 2) * SCS + t.depth * MPD with hslots'
  obtain ⟨L, hX⟩ : ∃ L : ℕ, t.otherGain = (3 * (2 * (Sx + (11 * Y + 9) / 10 +
        (slots' + L) * inc + F + t.creditUnits + t.syncLeak + e1 + e2) / (W - 2) +
      (t.depth + ((getCurrentEpoch pulled).toNat + 2 - (getCurrentEpoch fin).toNat)) * slots * SCS *
        env + t.depth * t.syncProposer)) / inc * t.perIncrement *
          (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum / WEIGHT_DENOMINATOR.toNat :=
    ⟨_, rfl⟩
  refine ⟨2 * (Sx + (11 * Y + 9) / 10 + (slots' + L) * inc + F + t.creditUnits + t.syncLeak + e1 +
    e2) / (W - 2), ?_, fun keys => ?_⟩
  · rw [hX, Nat.add_assoc _ ((t.depth + _) * _ * _ * _)]
  -- the slack of the registry keys that C slashes and no deposit credits
  set T1 := (slashedOnC split counted).filter (fun i => i < split.validators.data.size) with hT1
  have subT : T1.filter (fun i => ¬ 0 < depPre eventsC i) ⊆
      (slashedOnC split counted).filter (fun i => i < split.validators.data.size) := by
    rw [← hT1]
    exact Finset.filter_subset _ _
  have slackT := slack_le h fromFin tail high endEpoch replayed replayedF highLeR tailC highC
    endEpochC replayedC highLe (T1.filter (fun i => ¬ 0 < depPre eventsC i))
    (fun i member => by
      have inT1 := (Finset.mem_filter.mp member).1
      rw [hT1] at inT1
      exact (Finset.mem_filter.mp inT1).2)
    (fun i member => Nat.eq_zero_of_not_pos (Finset.mem_filter.mp member).2) _ _
    (whist_seat h fromFin tail high replayed replayedF _)
    (whist_units h fromFin tail high endEpoch replayed replayedF tailC highC endEpochC replayedC _
      subT)
  have ub : preset.upwardBand * slots' ≤ 2 * (slots' * inc) := by
    have up := h.facts.upward
    have quarter := h.facts.quarterBand
    have le : preset.upwardBand ≤ 2 * inc := by omega
    calc preset.upwardBand * slots' ≤ 2 * inc * slots' := Nat.mul_le_mul_right _ le
      _ = 2 * (slots' * inc) := by ring
  have hB : slots' * inc ≤ (slots' + L) * inc := Nat.mul_le_mul_right _ (Nat.le_add_right _ _)
  have hM' : t.depthFin * MPD * M = M * (t.depthFin * MPD) := by ring
  have hYY : (t.consolidationsX + t.depth * t.proposerCredit + t.depth * slots * SCS * env +
      t.depthFin * slots * SCS * env + t.depthFin * t.syncProposer) +
        M * (t.depthFin * MPD) ≤ Y := by
    rw [hY, hM']
    omega
  have slack := whist_slack_arith _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ slackT hYY ub hB le_rfl le_rfl
  exact (flow_whist_of h fromFin tail high tailC highC endEpochC replayedC pre registry
    registryCharge Sx Y ((slots' + L) * inc + F + t.creditUnits + t.syncLeak + e1 + e2) hSx count
    slack keys).trans
    (le_of_eq (by congr 2; omega))

/-- The flow gains of the counted keys, at their weights, fit the low part of `creditGain`.

They also take the surplus of the slash charge over R's slashed keys.

They take a tenth of the keys' credits too.

The bound is scaled by ten, so the tenth is exact.

One floor of all of a key's flows bounds its gain, and each split by kind costs one step.

`registry` and `registryCharge` are the bounds of the registry keys at their slashing. -/
private theorem flow_split_of (h : Setting config checks g split fin pulled anc counted V)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩) (high : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    {eventsF : List (BalanceEvent preset)} (replayedF : fromFin.balanceEvents high = .ok eventsF)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC)
    (highLeR : high ≤ (getCurrentEpoch pulled).toNat)
    (highLe : highC ≤ (getCurrentEpoch pulled).toNat)
    {b : BeaconState preset fork} (pre : Run config checks ⟨fork, b⟩ ⟨fork, split⟩)
    {eventsP : List (BalanceEvent preset)}
    (registry : ∀ {a b : ForkedBeaconState preset} (step : Step config checks a b),
      tailC.Contains step → ∀ i, i < split.validators.data.size →
        (split.validators.data[i]?.map (·.slashed)).getD false = false →
        (!(a.state.validators.data[i]?.map (·.slashed)).getD false &&
          (b.state.validators.data[i]?.map (·.slashed)).getD false) = true →
          effectiveAt a i ≤ whistleEnv (pinTerms config pulled anc fin) pulled anc fin i +
            whistleSlack (pinTerms config pulled anc fin) tailC (fromFin.append tail) highC high
              eventsC eventsF events fin i)
    (registryCharge : ∀ {a b : ForkedBeaconState preset} (step : Step config checks a b),
      tailC.Contains step → ∀ i, i < split.validators.data.size →
        (split.validators.data[i]?.map (·.slashed)).getD false = false →
        (!(a.state.validators.data[i]?.map (·.slashed)).getD false &&
          (b.state.validators.data[i]?.map (·.slashed)).getD false) = true →
        (tailC.departureCharges.any fun c => c.index == i) = true →
          effectiveAt a i ≤ chargeAmt tailC i + riseQ tailC highC i +
            (propN pre highC i + whistC pre highC i + syncCr eventsP i) +
            whistleSlack (pinTerms config pulled anc fin) tailC (fromFin.append tail) highC high
              eventsC eventsF events fin i)
    :
    10 * ((∑ v ∈ (K4 pulled counted V),
        flowK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF v.toNat) +
      3 * (∑ v ∈ (K5 counted V),
          flowK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF v.toNat
            (propC tailC highC v.toNat)) +
      (∑ v ∈ (K6 pulled counted),
          flowK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF v.toNat)) ≤
      10 * ((pinTerms config pulled anc fin).creditLow +
        3 * ((pinTerms config pulled anc fin).slashedR *
          (2 * (pinTerms config pulled anc fin).depthFin *
            (pinTerms config pulled anc fin).flagRate))) +
        (((∑ v ∈ (K4 pulled counted V), credN tailC highC v.toNat) +
          (∑ v ∈ (K6 pulled counted), credN tailC highC v.toNat) +
          (∑ v ∈ (K5 counted V), propN tailC highC v.toNat)) +
          2 * (∑ v ∈ (K5 counted V), propN tailC highC v.toNat)) := by
  classical
  have incPos := h.bands.1
  obtain ⟨d45, d46, d56, -, -, -⟩ := classes_disjoint h
  have called := UInt64.le_iff_toNat_le.mp h.called
  have near := h.near
  -- The consolidations are read at the pulled epoch, where `bud_consolidations_base` holds.
  have whole : (∑ v ∈ (K4 pulled counted V), consAmt eventsC v.toNat) +
      (∑ v ∈ (K6 pulled counted), consAmt eventsC v.toNat) +
      3 * (∑ v ∈ (K5 counted V), consAmt eventsC v.toNat) ≤
      3 * (pinTerms config pulled anc fin).consolidationsX := by
    have finSplit : (getCurrentEpoch fin).toNat ≤ (getCurrentEpoch split).toNat :=
      UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps fromFin.chainSteps)
    obtain ⟨onF, onR⟩ := replays_at_pulled tail high endEpoch replayed fromFin replayedF
    have onC := (DirectSafety.Apriori.Internal.balanceEvents_eq_of_endpoint_le tailC
      (high := highC) (localHigh := (getCurrentEpoch pulled).toNat) endEpochC
      (by simp only; omega)).symm.trans replayedC
    exact (bud_consolidations_base h fromFin tail _ (by omega) onR onF le_rfl tailC _ (by omega)
      onC le_rfl).2
  set t := pinTerms config pulled anc fin with ht
  obtain ⟨B, hOther, hB⟩ : ∃ B : ℕ,
      t.otherGain = (3 * B) / preset.EFFECTIVE_BALANCE_INCREMENT.toNat *
        t.perIncrement * (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum / WEIGHT_DENOMINATOR.toNat ∧
      ∀ keys : Finset ValidatorIndex, ∑ v ∈ keys, (whistC tailC highC v.toNat +
        (syncCr eventsC v.toNat + syncD events v.toNat + syncD eventsF v.toNat)) ≤ B := by
    obtain ⟨WB, hOther, hWhist⟩ := flow_whist h tail high endEpoch replayed fromFin replayedF tailC
      highC endEpochC replayedC highLeR highLe pre registry registryCharge
    refine ⟨WB + _, hOther, fun keys => ?_⟩
    rw [Finset.sum_add_distrib]
    exact Nat.add_le_add (hWhist keys)
      ((voters_sum_le (fun i => syncCr eventsC i + syncD events i + syncD eventsF i)
        fun v member => Finset.mem_image_of_mem _ member).trans
        (flow_sync h tail high replayed fromFin replayedF tailC highC replayedC _))
  -- The credits of each class split by kind: the credit part, the consolidations, the rest.
  have split4 : ∀ (S : Finset ValidatorIndex) (r cr : ℕ → ℕ),
      (∀ v ∈ S, flowCredit t tailC highC eventsC events eventsF v.toNat (cr v.toNat) ≤
        r v.toNat + consAmt eventsC v.toNat +
          (whistC tailC highC v.toNat + (syncCr eventsC v.toNat + syncD events v.toNat +
            syncD eventsF v.toNat)) + slashW t v.toNat) →
      ∑ v ∈ S, flowCredit t tailC highC eventsC events eventsF v.toNat (cr v.toNat) ≤
        ∑ v ∈ S, r v.toNat + ∑ v ∈ S, consAmt eventsC v.toNat +
          ∑ v ∈ S, (whistC tailC highC v.toNat + (syncCr eventsC v.toNat + syncD events v.toNat +
            syncD eventsF v.toNat)) + ∑ v ∈ S, slashW t v.toNat := by
    intro S r cr each
    refine (Finset.sum_le_sum each).trans (le_of_eq ?_)
    simp only [Finset.sum_add_distrib]
  have z4 := split4 (K4 pulled counted V) (fun i => credN tailC highC i)
      (fun i => credC tailC highC i) fun v _ => by
    have := (credit_parts_le tailC highC v replayedC).1
    unfold flowCredit
    omega
  have z5 := split4 (K5 counted V) (fun i => propN tailC highC i)
      (fun i => propC tailC highC i) fun v _ => by
    have := (credit_parts_le tailC highC v replayedC).2
    unfold flowCredit
    omega
  have z6 := split4 (K6 pulled counted) (fun i => credN tailC highC i)
      (fun i => credC tailC highC i) fun v _ => by
    have := (credit_parts_le tailC highC v replayedC).1
    unfold flowCredit
    omega
  -- The other flows and the slashed keys fit their bases, once over the three classes.
  have others : ∑ v ∈ K4 pulled counted V ∪ K5 counted V ∪ K6 pulled counted,
      (whistC tailC highC v.toNat + (syncCr eventsC v.toNat + syncD events v.toNat +
        syncD eventsF v.toNat)) ≤ B :=
    hB _
  have slashed : ∑ v ∈ K4 pulled counted V ∪ K5 counted V ∪ K6 pulled counted, slashW t v.toNat ≤
      preset.EFFECTIVE_BALANCE_INCREMENT.toNat * t.slashedR :=
    flow_slash h (K4 pulled counted V ∪ K5 counted V ∪ K6 pulled counted)
  have weightOther := weighted_le (fun v : ValidatorIndex => whistC tailC highC v.toNat +
    (syncCr eventsC v.toNat + syncD events v.toNat + syncD eventsF v.toNat)) d45 d46 d56
  have weightSlash := weighted_le (fun v : ValidatorIndex => slashW t v.toNat) d45 d46 d56
  have lin := flow_lin t tailC highC eventsC events eventsF (K4 pulled counted V) (K5 counted V)
    (K6 pulled counted) (fun i => credC tailC highC i) (fun i => propC tailC highC i)
    (fun i => credC tailC highC i)
  beta_reduce at z4 z5 z6 weightOther weightSlash lin
  have aligned : t.consolidationsX % preset.EFFECTIVE_BALANCE_INCREMENT.toNat = 0 :=
    consolidationsX_aligned h
  have key : 0 < (∑ v ∈ K4 pulled counted V, flowK t tailC highC eventsC events eventsF v.toNat) +
      3 * (∑ v ∈ K5 counted V,
        flowK t tailC highC eventsC events eventsF v.toNat (propC tailC highC v.toNat)) +
      (∑ v ∈ K6 pulled counted, flowK t tailC highC eventsC events eventsF v.toNat) →
      11 * min t.depth t.depthFin *
          (t.perIncrement * (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum) <
        WEIGHT_DENOMINATOR.toNat * preset.EFFECTIVE_BALANCE_INCREMENT.toNat := fun pos => by
    obtain ⟨i, c, found⟩ := flow_pos t tailC highC eventsC events eventsF _ _ _
      (fun i => credC tailC highC i) (fun i => propC tailC highC i)
      (fun i => credC tailC highC i) pos
    exact lt_of_le_of_lt (Nat.mul_le_mul_right _ (Nat.mul_le_mul_left 11 (min_le_left _ _)))
      (flow_key h tailC highC eventsC events eventsF i c found)
  have rate : 0 < (∑ v ∈ K4 pulled counted V, flowK t tailC highC eventsC events eventsF v.toNat) +
      3 * (∑ v ∈ K5 counted V,
        flowK t tailC highC eventsC events eventsF v.toNat (propC tailC highC v.toNat)) +
      (∑ v ∈ K6 pulled counted, flowK t tailC highC eventsC events eventsF v.toNat) →
      2 ≤ t.perIncrement * (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum /
        WEIGHT_DENOMINATOR.toNat := fun _ => flow_rate h
  have close := flow_close preset.EFFECTIVE_BALANCE_INCREMENT.toNat WEIGHT_DENOMINATOR.toNat
    (t.perIncrement * (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum) (min t.depth t.depthFin)
    t.depth
    (t.consolidationsX / preset.EFFECTIVE_BALANCE_INCREMENT.toNat) (3 * B)
    ((∑ v ∈ K4 pulled counted V, credN tailC highC v.toNat) +
      (∑ v ∈ K6 pulled counted, credN tailC highC v.toNat) +
      3 * (∑ v ∈ K5 counted V, propN tailC highC v.toNat))
    ((∑ v ∈ K4 pulled counted V, consAmt eventsC v.toNat) +
      (∑ v ∈ K6 pulled counted, consAmt eventsC v.toNat) +
      3 * (∑ v ∈ K5 counted V, consAmt eventsC v.toNat))
    ((∑ v ∈ K4 pulled counted V, (whistC tailC highC v.toNat + (syncCr eventsC v.toNat +
        syncD events v.toNat + syncD eventsF v.toNat))) +
      (∑ v ∈ K6 pulled counted, (whistC tailC highC v.toNat + (syncCr eventsC v.toNat +
        syncD events v.toNat + syncD eventsF v.toNat))) +
      3 * (∑ v ∈ K5 counted V, (whistC tailC highC v.toNat + (syncCr eventsC v.toNat +
        syncD events v.toNat + syncD eventsF v.toNat))))
    ((∑ v ∈ K4 pulled counted V, slashW t v.toNat) + (∑ v ∈ K6 pulled counted, slashW t v.toNat) +
      3 * (∑ v ∈ K5 counted V, slashW t v.toNat))
    t.slashedR t.depthFin _ incPos (by decide) key rate (min_le_right _ _) (min_le_left _ _)
    (by
      have := Nat.mul_div_cancel' (Nat.dvd_of_mod_eq_zero aligned)
      omega)
    (by omega)
    (by omega)
    (lin.trans (Nat.mul_le_mul_left _ (by omega)))
  have creditLow : t.creditLow = (33 * t.depth * (t.consolidationsX /
        preset.EFFECTIVE_BALANCE_INCREMENT.toNat * t.perIncrement *
          (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum / WEIGHT_DENOMINATOR.toNat) +
      11 * t.depth * t.otherGain +
      30 * t.depth * (t.perIncrement * (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum /
        WEIGHT_DENOMINATOR.toNat + 1) + 9) / 10 := rfl
  rw [hOther] at creditLow
  rw [Nat.mul_assoc (t.consolidationsX / preset.EFFECTIVE_BALANCE_INCREMENT.toNat),
    Nat.mul_assoc (3 * B / preset.EFFECTIVE_BALANCE_INCREMENT.toNat)] at creditLow
  have rateEq : t.flagRate = t.perIncrement * (PARTICIPATION_FLAG_WEIGHTS.map (·.toNat)).sum /
      WEIGHT_DENOMINATOR.toNat := rfl
  rw [rateEq, creditLow]
  linarith

/-- The keys of `K6` beyond R's registry are paid by the credits.

In the high regime they are also paid by `capUse`, their share of `creditCap`.

They joined the registry on C's branch, so their stake is the credits that reach them.

The credits compound, which `keyExtra`'s flow gain charges, when the gain rate is low.

Otherwise `capUse` charges each key up to the cap. -/
private theorem beyond_keys (h : Setting config checks g split fin pulled anc counted V)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩) (high : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    {events : List (BalanceEvent preset)}
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    {eventsF : List (BalanceEvent preset)} (replayedF : fromFin.balanceEvents high = .ok eventsF)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC) :
    ∑ v ∈ (K6 pulled counted) with pulled.validators.data.size ≤ v.toNat, eC counted v ≤
      (∑ v ∈ (K6 pulled counted) with pulled.validators.data.size ≤ v.toNat,
        (((credC tailC highC v.toNat +
            keyExtra (pinTerms config pulled anc fin) (fromFin.append tail) tailC highC
              eventsC events eventsF v.toNat) +
            whistC tailC highC v.toNat) +
          (syncF events v.toNat + syncF eventsC v.toNat) +
          (slashR (pinTerms config pulled anc fin) v.toNat + bandC tailC highC v.toNat +
            bandR (eventsF ++ events) v.toNat) + bandX fin highC v.toNat)) +
        capUse config pulled anc fin counted := by
  classical
  by_cases low : 11 * (pinTerms config pulled anc fin).depth *
      ((pinTerms config pulled anc fin).gainRateMax + 1) ≤
        preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat
  · refine Nat.le_trans (Finset.sum_le_sum fun v member => ?_) (Nat.le_add_right _ _)
    obtain ⟨inK6, beyond⟩ := Finset.mem_filter.mp member
    exact beyond_key h tail high endEpoch fromFin replayedF tailC highC endEpochC replayedC low
      inK6 beyond
  · -- Each key is at most the cap, and `capUse` is that cap for each key, at a high rate.
    obtain ⟨shared⟩ := h.toFin
    have capped (v : ValidatorIndex) : eC counted v ≤ preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat :=
      PinSeatDebits.effectiveAt_le_capMax (shared.append (fromFin.append tailC)) h.genesis h.caps
        h.early v.toNat
    have highGain : (pinTerms config pulled anc fin).gainHigh = true :=
      gainHigh_eq_true_iff.mpr low
    have total := Finset.sum_le_card_nsmul
      ((K6 pulled counted).filter fun v => pulled.validators.data.size ≤ v.toNat) (eC counted)
      preset.MAX_EFFECTIVE_BALANCE_ELECTRA.toNat fun v _ => capped v
    rw [smul_eq_mul] at total
    unfold capUse
    rw [ite_eq_left highGain]
    exact Nat.le_trans total (Nat.le_add_left _ _)

/-- The keys counted in C and not active at R.

A key whose exit started on R's branch after the split is inactive at R and active in C.

`bud_exitedR` charges it.

Its stake in C is at most its stake at R and its rise.

So is the stake of a key whose exit R reads, which `exiting` and `exitingRise` charge. -/
private theorem cJ_le (h : Setting config checks g split fin pulled anc counted V)
    (tail : Run config checks ⟨fork, split⟩ ⟨fork, pulled⟩) (high : ℕ)
    (endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1)
    {events : List (BalanceEvent preset)} (replayed : tail.balanceEvents high = .ok events)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩)
    {eventsF : List (BalanceEvent preset)} (replayedF : fromFin.balanceEvents high = .ok eventsF)
    (tailC : Run config checks ⟨fork, split⟩ ⟨fork, counted⟩) (highC : ℕ)
    (endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1)
    {eventsC : List (BalanceEvent preset)} (replayedC : tailC.balanceEvents highC = .ok eventsC) :
    cJ pulled counted ≤ (((pinTerms config pulled anc fin).joining +
      (∑ v ∈ (K6 pulled counted) with
        (isActiveAt pulled (getCurrentEpoch pulled) v.toNat = false ∧
          isActiveAt pulled (getCurrentEpoch pulled + 1) v.toNat = true),
        (pinTerms config pulled anc fin).rise v.toNat) +
      (∑ v ∈ (K6 pulled counted) with (pinTerms config pulled anc fin).lateB v.toNat = true,
        (3 * eR pulled v + (pinTerms config pulled anc fin).rise v.toNat)) +
      (∑ v ∈ (K6 pulled counted) with (pinTerms config pulled anc fin).exitedRB v.toNat = true,
        (eR pulled v + (pinTerms config pulled anc fin).rise v.toNat)) +
      (∑ v ∈ (K6 pulled counted) with (pinTerms config pulled anc fin).exitingB v.toNat = true,
        (eR pulled v + (pinTerms config pulled anc fin).rise v.toNat)) +
      (∑ v ∈ (K6 pulled counted), ((credC tailC highC v.toNat +
          keyExtra (pinTerms config pulled anc fin) (fromFin.append tail) tailC highC
            eventsC events eventsF v.toNat) +
        whistC tailC highC v.toNat)) +
      (∑ v ∈ (K6 pulled counted), (syncF events v.toNat + syncF eventsC v.toNat)) +
      (∑ v ∈ (K6 pulled counted),
        (slashR (pinTerms config pulled anc fin) v.toNat + bandC tailC highC v.toNat +
          bandR (eventsF ++ events) v.toNat)) +
      (∑ v ∈ (K6 pulled counted) with (pinTerms config pulled anc fin).pendingRB v.toNat = true,
        (eR pulled v + (pinTerms config pulled anc fin).rise v.toNat)) +
      (∑ v ∈ (K6 pulled counted), bandX fin highC v.toNat) +
      capUse config pulled anc fin counted) : ℕ) := by
  classical
  -- `cJ` is the stake in C of the keys of `K6`.
  have cJ_eq : cJ pulled counted = ((∑ v ∈ K6 pulled counted, eC counted v : ℕ) : ℤ) := by
    unfold cJ
    push_cast
    rw [← Finset.sum_filter]
    refine Finset.sum_congr ?_ fun _ _ => rfl
    ext v
    simp only [Finset.mem_filter, K6, U, Finset.mem_union]
    tauto
  rw [cJ_eq, Nat.cast_le]
  -- The keys at or beyond R's registry are paid by `creditGain` and the credits.
  have beyond := beyond_keys (events := events) h tail high endEpoch fromFin replayedF tailC highC
    endEpochC replayedC
  -- The keys inside R's registry rise by `key_core`, and R's record puts each in a class.
  have core : ∀ v ∈ K6 pulled counted, v.toNat < pulled.validators.data.size →
      eC counted v ≤ (eR pulled v + (pinTerms config pulled anc fin).rise v.toNat +
          bandX fin highC v.toNat) +
        (((credC tailC highC v.toNat +
            keyExtra (pinTerms config pulled anc fin) (fromFin.append tail) tailC highC
              eventsC events eventsF v.toNat) +
            whistC tailC highC v.toNat) +
          (syncF events v.toNat + syncF eventsC v.toNat) +
          (slashR (pinTerms config pulled anc fin) v.toNat + bandC tailC highC v.toNat +
            bandR (eventsF ++ events) v.toNat)) := by
    intro v hv hin
    have := key_core (config := config) h tail high endEpoch replayed fromFin replayedF tailC highC
      endEpochC replayedC v.toNat hin
      (by rw [UInt64.ofNat_toNat]; exact (Finset.mem_filter.mp hv).2.1)
    unfold eC eR
    unfold keyCeiling at this
    omega
  have classes : ∀ v ∈ K6 pulled counted, v.toNat < pulled.validators.data.size →
      eR pulled v + (pinTerms config pulled anc fin).rise v.toNat ≤
        ((if (isActiveAt pulled (getCurrentEpoch pulled) v.toNat = false ∧
              isActiveAt pulled (getCurrentEpoch pulled + 1) v.toNat = true) then
            eR pulled v + (pinTerms config pulled anc fin).rise v.toNat else 0) +
          (if (pinTerms config pulled anc fin).lateB v.toNat = true then
            3 * eR pulled v + (pinTerms config pulled anc fin).rise v.toNat else 0) +
          (if (pinTerms config pulled anc fin).exitedRB v.toNat = true then
            eR pulled v + (pinTerms config pulled anc fin).rise v.toNat else 0) +
          (if (pinTerms config pulled anc fin).exitingB v.toNat = true then
            eR pulled v + (pinTerms config pulled anc fin).rise v.toNat else 0) +
          (if (pinTerms config pulled anc fin).pendingRB v.toNat = true then
            eR pulled v + (pinTerms config pulled anc fin).rise v.toNat else 0)) := by
    intro v hK hin
    obtain ⟨w, found⟩ : ∃ w, pulled.validators.data[v.toNat]? = some w :=
      ⟨_, Array.getElem?_eq_getElem hin⟩
    rcases K6_class h hK found with c | c | c | c | c
    · rw [ite_eq_left c]; omega
    · rw [ite_eq_left c]; omega
    · rw [ite_eq_left c]; omega
    · rw [ite_eq_left c]; omega
    · rw [ite_eq_left c]; omega
  -- Sum the classes over the keys inside R's registry.
  set inside := (K6 pulled counted).filter (fun v => v.toNat < pulled.validators.data.size)
    with hInside
  have partition := Finset.sum_filter_add_sum_filter_not (K6 pulled counted)
    (fun v => v.toNat < pulled.validators.data.size) (eC counted)
  have notInside : (K6 pulled counted).filter (fun v => ¬ v.toNat < pulled.validators.data.size) =
      (K6 pulled counted).filter (fun v => pulled.validators.data.size ≤ v.toNat) := by
    refine Finset.filter_congr fun v _ => ?_
    omega
  rw [notInside, ← hInside] at partition
  have insideSum : ∑ v ∈ inside, eC counted v ≤
      ∑ v ∈ inside, (((eR pulled v + (pinTerms config pulled anc fin).rise v.toNat +
          bandX fin highC v.toNat) +
        (((credC tailC highC v.toNat +
            keyExtra (pinTerms config pulled anc fin) (fromFin.append tail) tailC highC
              eventsC events eventsF v.toNat) +
            whistC tailC highC v.toNat) +
          (syncF events v.toNat + syncF eventsC v.toNat) +
          (slashR (pinTerms config pulled anc fin) v.toNat + bandC tailC highC v.toNat +
            bandR (eventsF ++ events) v.toNat)))) :=
    Finset.sum_le_sum fun v hv =>
      core v (Finset.mem_filter.mp hv).1 (Finset.mem_filter.mp hv).2
  rw [Finset.sum_add_distrib] at insideSum
  -- The consolidation bands of the inside keys are within those of `K6`.
  have bandSplit : ∑ v ∈ inside, (eR pulled v + (pinTerms config pulled anc fin).rise v.toNat +
        bandX fin highC v.toNat) =
      ∑ v ∈ inside, (eR pulled v + (pinTerms config pulled anc fin).rise v.toNat) +
        ∑ v ∈ inside, bandX fin highC v.toNat := Finset.sum_add_distrib
  have bandAll : ∑ v ∈ K6 pulled counted, bandX fin highC v.toNat =
      ∑ v ∈ inside, bandX fin highC v.toNat +
        ∑ v ∈ (K6 pulled counted) with pulled.validators.data.size ≤ v.toNat,
          bandX fin highC v.toNat := by
    have split := Finset.sum_filter_add_sum_filter_not (K6 pulled counted)
      (fun v => v.toNat < pulled.validators.data.size) (fun v => bandX fin highC v.toNat)
    rw [notInside] at split
    exact split.symm
  have classSum : ∑ v ∈ inside, (eR pulled v + (pinTerms config pulled anc fin).rise v.toNat) ≤
      (∑ v ∈ inside with (isActiveAt pulled (getCurrentEpoch pulled) v.toNat = false ∧
          isActiveAt pulled (getCurrentEpoch pulled + 1) v.toNat = true),
        (eR pulled v + (pinTerms config pulled anc fin).rise v.toNat)) +
      (∑ v ∈ inside with (pinTerms config pulled anc fin).lateB v.toNat = true,
        (3 * eR pulled v + (pinTerms config pulled anc fin).rise v.toNat)) +
      (∑ v ∈ inside with (pinTerms config pulled anc fin).exitedRB v.toNat = true,
        (eR pulled v + (pinTerms config pulled anc fin).rise v.toNat)) +
      (∑ v ∈ inside with (pinTerms config pulled anc fin).exitingB v.toNat = true,
        (eR pulled v + (pinTerms config pulled anc fin).rise v.toNat)) +
      (∑ v ∈ inside with (pinTerms config pulled anc fin).pendingRB v.toNat = true,
        (eR pulled v + (pinTerms config pulled anc fin).rise v.toNat)) := by
    refine Nat.le_trans (Finset.sum_le_sum fun v hv =>
      classes v (Finset.mem_filter.mp hv).1 (Finset.mem_filter.mp hv).2) (Nat.le_of_eq ?_)
    simp only [Finset.sum_filter]
    simp only [Finset.sum_add_distrib]
  -- Each class of inside keys is within the matching class of `K6`.
  have restrict : ∀ (p : ValidatorIndex → Prop) [DecidablePred p] (f : ValidatorIndex → ℕ),
      ∑ v ∈ inside with p v, f v ≤ ∑ v ∈ (K6 pulled counted) with p v, f v := fun p _ f =>
    Finset.sum_le_sum_of_subset (Finset.filter_subset_filter _ (Finset.filter_subset _ _))
  have joinStake : ∑ v ∈ inside with (isActiveAt pulled (getCurrentEpoch pulled) v.toNat = false ∧
        isActiveAt pulled (getCurrentEpoch pulled + 1) v.toNat = true), eR pulled v ≤
      (pinTerms config pulled anc fin).joining := by
    show _ ≤ joiningStake pulled
    unfold joiningStake
    refine voters_sum_le (fun i => balanceAt pulled i) fun v hv => ?_
    obtain ⟨hi, hj⟩ := Finset.mem_filter.mp hv
    obtain ⟨hK, hin⟩ := Finset.mem_filter.mp hi
    exact mem_positions_filter config pulled anc fin (Array.getElem?_eq_getElem hin) hj
  have joinRise : ∑ v ∈ inside with (isActiveAt pulled (getCurrentEpoch pulled) v.toNat = false ∧
        isActiveAt pulled (getCurrentEpoch pulled + 1) v.toNat = true),
        (pinTerms config pulled anc fin).rise v.toNat ≤
      ∑ v ∈ (K6 pulled counted) with (isActiveAt pulled (getCurrentEpoch pulled) v.toNat = false ∧
        isActiveAt pulled (getCurrentEpoch pulled + 1) v.toNat = true),
        (pinTerms config pulled anc fin).rise v.toNat :=
    restrict (fun v => isActiveAt pulled (getCurrentEpoch pulled) v.toNat = false ∧
        isActiveAt pulled (getCurrentEpoch pulled + 1) v.toNat = true)
      (fun v => (pinTerms config pulled anc fin).rise v.toNat)
  have joinSplit : ∑ v ∈ inside with (isActiveAt pulled (getCurrentEpoch pulled) v.toNat = false ∧
        isActiveAt pulled (getCurrentEpoch pulled + 1) v.toNat = true),
        (eR pulled v + (pinTerms config pulled anc fin).rise v.toNat) =
      (∑ v ∈ inside with (isActiveAt pulled (getCurrentEpoch pulled) v.toNat = false ∧
        isActiveAt pulled (getCurrentEpoch pulled + 1) v.toNat = true), eR pulled v) +
      ∑ v ∈ inside with (isActiveAt pulled (getCurrentEpoch pulled) v.toNat = false ∧
        isActiveAt pulled (getCurrentEpoch pulled + 1) v.toNat = true),
        (pinTerms config pulled anc fin).rise v.toNat := Finset.sum_add_distrib
  have late := restrict (fun v => (pinTerms config pulled anc fin).lateB v.toNat = true)
    (fun v => 3 * eR pulled v + (pinTerms config pulled anc fin).rise v.toNat)
  have exited := restrict (fun v => (pinTerms config pulled anc fin).exitedRB v.toNat = true)
    (fun v => eR pulled v + (pinTerms config pulled anc fin).rise v.toNat)
  have exiting := restrict (fun v => (pinTerms config pulled anc fin).exitingB v.toNat = true)
    (fun v => eR pulled v + (pinTerms config pulled anc fin).rise v.toNat)
  have pending := restrict (fun v => (pinTerms config pulled anc fin).pendingRB v.toNat = true)
    (fun v => eR pulled v + (pinTerms config pulled anc fin).rise v.toNat)
  -- The credits, sync flows and slash bands over `K6` split at R's registry.
  have bounds := Finset.sum_filter_add_sum_filter_not (K6 pulled counted)
    (fun v => v.toNat < pulled.validators.data.size)
    (fun v => (((credC tailC highC v.toNat +
        keyExtra (pinTerms config pulled anc fin) (fromFin.append tail) tailC highC
          eventsC events eventsF v.toNat) +
            whistC tailC highC v.toNat) +
          (syncF events v.toNat + syncF eventsC v.toNat) +
          (slashR (pinTerms config pulled anc fin) v.toNat + bandC tailC highC v.toNat +
            bandR (eventsF ++ events) v.toNat)))
  rw [notInside, ← hInside] at bounds
  have boundSplit : ∑ v ∈ K6 pulled counted,
      (((credC tailC highC v.toNat +
          keyExtra (pinTerms config pulled anc fin) (fromFin.append tail) tailC highC
            eventsC events eventsF v.toNat) +
            whistC tailC highC v.toNat) +
          (syncF events v.toNat + syncF eventsC v.toNat) +
          (slashR (pinTerms config pulled anc fin) v.toNat + bandC tailC highC v.toNat +
            bandR (eventsF ++ events) v.toNat)) =
      (∑ v ∈ K6 pulled counted, ((credC tailC highC v.toNat +
          keyExtra (pinTerms config pulled anc fin) (fromFin.append tail) tailC highC
            eventsC events eventsF v.toNat) +
        whistC tailC highC v.toNat)) +
      (∑ v ∈ K6 pulled counted, (syncF events v.toNat + syncF eventsC v.toNat)) +
      ∑ v ∈ K6 pulled counted, (slashR (pinTerms config pulled anc fin) v.toNat +
        bandC tailC highC v.toNat + bandR (eventsF ++ events) v.toNat) := by
    simp only [Finset.sum_add_distrib]
  rw [Finset.sum_add_distrib] at beyond
  omega

end Terms

/-! ## The top-level step, from the bounds of the terms -/

section Closure
variable {g : ForkedBeaconState preset} {split fin pulled anc counted : BeaconState preset fork}
  {V : Finset ValidatorIndex}

open DirectSafety.Apriori DirectSafety.Apriori.Internal in
/-- The shared run to the split has a state `b` at the start of the split's epoch.

The run from `b` to the split, `pre`, is the end of the shared run.

The state `b` comes after the finalized state, or before it in its epoch.

No step of the run to `b` starts in the epoch of `b`, so no block of that epoch precedes it. -/
private theorem split_epoch_start (toFin : Run config checks g ⟨fork, fin⟩)
    (fromFin : Run config checks ⟨fork, fin⟩ ⟨fork, split⟩) :
    ∃ (b : BeaconState preset fork) (toB : Run config checks g ⟨fork, b⟩)
      (pre : Run config checks ⟨fork, b⟩ ⟨fork, split⟩),
      getCurrentEpoch split = getCurrentEpoch b ∧
      (Nonempty (Run config checks ⟨fork, fin⟩ ⟨fork, b⟩) ∨
        ∃ _ : Run config checks ⟨fork, b⟩ ⟨fork, fin⟩,
          getCurrentEpoch fin = getCurrentEpoch b) ∧
      (∀ {u w : ForkedBeaconState preset} (step : Step config checks u w), toB.Contains step →
        (getCurrentEpoch u.state).toNat < (getCurrentEpoch b).toNat) ∧
      ((∃ fromB : Run config checks ⟨fork, fin⟩ ⟨fork, b⟩, fromFin = fromB.append pre) ∨
        ∃ toFinB : Run config checks ⟨fork, b⟩ ⟨fork, fin⟩, pre = toFinB.append fromFin) := by
  have finSplit : (getCurrentEpoch fin).toNat ≤ (getCurrentEpoch split).toNat :=
    UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps fromFin.chainSteps)
  have gFin : (getCurrentEpoch g.state).toNat ≤ (getCurrentEpoch fin).toNat :=
    UInt64.le_iff_toNat_le.mp (currentEpoch_le_of_chainSteps toFin.chainSteps)
  by_cases inFin : (getCurrentEpoch fin).toNat = (getCurrentEpoch split).toNat
  · by_cases atGenesis : (getCurrentEpoch g.state).toNat = (getCurrentEpoch fin).toNat
    · -- the whole shared run is in one epoch
      have gFork := Run.fork_eq_of_same_epoch toFin (UInt64.toNat_inj.mp atGenesis.symm)
      obtain ⟨gf, gs⟩ := g
      subst gFork
      dsimp only at atGenesis
      exact ⟨gs, Run.nil, toFin.append fromFin, UInt64.toNat_inj.mp (by omega),
        .inr ⟨toFin, UInt64.toNat_inj.mp (by omega)⟩, (fun _ member => by cases member),
        .inr ⟨toFin, rfl⟩⟩
    · -- the boundary into the split's epoch is in the run to the finalized state
      obtain ⟨z, ⟨nf, ns⟩, pre0, ok, rest, cut, hz, hn⟩ := Run.cross_split toFin
        ((getCurrentEpoch fin).toNat - 1) (by omega)
        (by change _ < (getCurrentEpoch fin).toNat; omega)
      dsimp only at hz hn
      have nEpoch : getCurrentEpoch fin = getCurrentEpoch ns :=
        UInt64.toNat_inj.mp (by omega)
      have nFork := Run.fork_eq_of_same_epoch rest nEpoch
      dsimp only at nFork
      subst nFork
      subst cut
      refine ⟨ns, pre0.snoc (Step.slot ok), rest.append fromFin,
        UInt64.toNat_inj.mp (by omega), .inr ⟨rest, nEpoch⟩, fun {u w} step member => ?_,
        .inr ⟨rest, rfl⟩⟩
      cases member with
      | last => omega
      | earlier inner =>
        have := steps_before_end pre0 step inner
        simp only [ix] at this
        omega
  · -- the boundary into the split's epoch is in the run from the finalized state
    obtain ⟨z, ⟨nf, ns⟩, pre0, ok, rest, cut, hz, hn⟩ := Run.cross_split fromFin
      ((getCurrentEpoch split).toNat - 1) (by change (getCurrentEpoch fin).toNat ≤ _; omega)
      (by change _ < (getCurrentEpoch split).toNat; omega)
    dsimp only at hz hn
    have nEpoch : getCurrentEpoch split = getCurrentEpoch ns :=
      UInt64.toNat_inj.mp (by omega)
    have nFork := Run.fork_eq_of_same_epoch rest nEpoch
    dsimp only at nFork
    subst nFork
    subst cut
    refine ⟨ns, toFin.append (pre0.snoc (Step.slot ok)), rest,
      nEpoch, .inl ⟨pre0.snoc (Step.slot ok)⟩, fun {u w} step member => ?_,
      .inl ⟨pre0.snoc (Step.slot ok), rfl⟩⟩
    rcases (Run.contains_append _ _ _).mp member with early | late
    · have := steps_before_end toFin step early
      simp only [ix] at this
      omega
    · cases late with
      | last => omega
      | earlier inner =>
        have := steps_before_end pre0 step inner
        simp only [ix] at this
        omega

/-- The weighted drift, key by key: exact per-key algebra, no reserve term. -/
private theorem drift_le_costs (h : Setting config checks g split fin pulled anc counted V) :
    3 * (∑ v ∈ Q counted, (eC counted v : ℤ)) + 3 * (∑ v ∈ V, (eR pulled v : ℤ)) -
        2 * (∑ v ∈ AC counted, (eC counted v : ℤ)) - (∑ v ∈ AR pulled, (eR pulled v : ℤ)) -
        3 * (∑ v ∈ (Q counted).filter (· ∈ V), (eC counted v : ℤ)) ≤
      2 * cV1 pulled counted V + 2 * cV2 pulled counted V + cN pulled counted V +
        3 * cP pulled counted V + cJ pulled counted + cK7 pulled counted +
        cS pulled counted V := by
  have hAR : ∀ v ∈ V, v ∈ AR pulled := fun v m => (h.voting v m).1
  have hQ := glue_quorum h
  have subQ : Q counted ⊆ U pulled counted := fun v m => by simp [U, m]
  have subAC : AC counted ⊆ U pulled counted := fun v m => by simp [U, m]
  have subAR : AR pulled ⊆ U pulled counted := fun v m => by simp [U, m]
  have subV : V ⊆ U pulled counted := fun v m => subAR (hAR v m)
  have subQV : (Q counted).filter (· ∈ V) ⊆ U pulled counted :=
    fun v m => subQ (Finset.mem_filter.mp m).1
  rw [sum_eq_U subQ, sum_eq_U subV, sum_eq_U subAC, sum_eq_U subAR, sum_eq_U subQV]
  unfold cV1 cV2 cN cP cJ cK7 cS
  simp only [Finset.mul_sum, ← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
  apply Finset.sum_le_sum
  intro v _
  simp only [Finset.mem_filter]
  by_cases hv : v ∈ V
  · have hr := hAR v hv
    by_cases ha : v ∈ AC counted
    · have hq := hQ v hv ha
      simp [hv, ha, hr, hq]
      omega
    · by_cases hq : v ∈ Q counted <;> simp [hv, ha, hr, hq] <;> omega
  · by_cases hq : v ∈ Q counted <;> by_cases ha : v ∈ AC counted <;>
      by_cases hr : v ∈ AR pulled <;> simp [hv, ha, hr, hq] <;> omega

/-- A bound on `x` gives the bound at weight two against weight three. -/
private theorem two_le_three {x : ℤ} {r : ℕ} (le : x ≤ r) : 2 * x ≤ 3 * (r : ℤ) := by omega

/-- The total read is at least the active stake. -/
private theorem stake_le_total {state : BeaconState preset fork} {total : Gwei}
    (ok : getTotalActiveBalance state = .ok total) :
    (∑ v ∈ activeVoters state, balanceAt state v.toNat) ≤ total.toNat := by
  obtain ⟨-, -, value⟩ := getTotalBalance_ok_iff_stake.mp (getTotalActiveBalance_ok ok)
  rw [value]
  exact le_max_right _ _

/-- The quorum drifts from a call's pulled-up state to a counting state by at most the pin reserve.

The quorum at the counting state and `V` at the pulled-up state weigh three each.

Their sum is at most twice the counting total, the pulled-up total and `pinReserve`.

It also adds three times the counting stake of the quorum voters that are in `V`.

The theorem takes the setting and the two total active balances. -/
theorem le_pinReserve (h : Setting config checks g split fin pulled anc counted V)
    {total pulledTotal : Gwei} (totalOk : getTotalActiveBalance counted = .ok total)
    (pulledOk : getTotalActiveBalance pulled = .ok pulledTotal) :
    3 * stake (fun v => balanceAt counted v.toNat) (quorumVoters counted) +
        3 * stake (fun v => balanceAt pulled v.toNat) V ≤
      2 * total.toNat + pulledTotal.toNat + pinReserve config pulled anc fin +
        3 * stake (fun v => balanceAt counted v.toNat) {v ∈ quorumVoters counted | v ∈ V} := by
  have nn {ι : Type} (S : Finset ι) (f : ι → ℕ) : (0 : ℤ) ≤ ∑ x ∈ S, (f x : ℤ) :=
    Finset.sum_nonneg fun _ _ => Int.natCast_nonneg _
  obtain ⟨tail⟩ := h.toPulled
  obtain ⟨tailC⟩ := h.toCounted
  -- Both replays read the events up to the call's epoch.
  obtain ⟨high, hHigh⟩ : ∃ n, n = (getCurrentEpoch pulled).toNat := ⟨_, rfl⟩
  obtain ⟨highC, hHighC⟩ : ∃ n, n = (getCurrentEpoch pulled).toNat := ⟨_, rfl⟩
  have endEpoch : (getCurrentEpoch pulled).toNat ≤ high + 1 := by omega
  have endEpochC : (getCurrentEpoch counted).toNat ≤ highC + 1 := by have := h.near; omega
  have highLe : highC ≤ (getCurrentEpoch pulled).toNat := by omega
  have highLeR : high ≤ (getCurrentEpoch pulled).toNat := by omega
  clear hHigh hHighC
  obtain ⟨events, replayed⟩ := tail.balanceEvents_ok h.early high
  obtain ⟨eventsC, replayedC⟩ := tailC.balanceEvents_ok h.early highC
  have key := drift_le_costs h
  have tC := stake_le_total totalOk
  have tR := stake_le_total pulledOk
  obtain ⟨toFin⟩ := h.toFin
  obtain ⟨fromFin⟩ := h.fromFin
  obtain ⟨b, toB, pre, sameEpoch, link, earlier, shape⟩ := split_epoch_start toFin fromFin
  obtain ⟨eventsF, replayedF⟩ := fromFin.balanceEvents_ok h.early high
  obtain ⟨eventsP, replayedP⟩ := pre.balanceEvents_ok h.early highC
  have sV := two_le_three (cV_le (config := config) h high endEpoch events fromFin replayedF
    tailC highC endEpochC replayedC)
  have sN := cN_le (config := config) h tail high endEpoch replayed fromFin replayedF tailC highC
    endEpochC replayedC
  have sP := cP_le (config := config) h tail high endEpoch replayed fromFin toB pre
    sameEpoch earlier replayedF tailC highC endEpochC replayedC replayedP
  have sJ := cJ_le (config := config) h tail high endEpoch replayed fromFin replayedF tailC highC
    endEpochC replayedC
  -- The terms that `keyExtra` adds are paid by the flow split, the units and the induced leak.
  have reg := registry_bounds (config := config) h tail high endEpoch replayed fromFin replayedF
    tailC highC endEpochC replayedC toB pre sameEpoch earlier replayedP
  have f1 := flow_split_of (config := config) h tail high endEpoch replayed fromFin replayedF
    tailC highC endEpochC replayedC highLeR highLe pre reg.1 reg.2
  have u1 := (bud_units (config := config) h tail high replayed fromFin replayedF tailC highC
    endEpochC replayedC).1
  have u2 := bud_csUnits (config := config) (events := events) (eventsF := eventsF) h fromFin
    tailC highC endEpochC replayedC
  have l1 := (bud_syncLeak (config := config) h tail high endEpoch replayed fromFin replayedF).1
  have cg := creditGain_split config pulled anc fin
  have b1 := bud_exiting (config := config) h tailC
  have b2 := bud_late (config := config) h
  have b3 := bud_queues (config := config) h tailC
  have b4 := bud_credits (config := config) h toB link pre sameEpoch tailC highC endEpochC replayedC
  have b5 := bud_branchR (config := config) h tail high endEpoch replayed fromFin toB pre
    sameEpoch replayedF tailC highC endEpochC replayedC replayedP
  have replayedPHigh : pre.balanceEvents high = .ok eventsP := by
    have called := UInt64.le_iff_toNat_le.mp h.called
    have later := UInt64.le_iff_toNat_le.mp h.later
    rw [DirectSafety.Apriori.Internal.balanceEvents_eq_of_endpoint_le pre (localHigh := highC)
      (by simp only; omega) (by simp only; omega)]
    exact replayedP
  have b6 := bud_sync (config := config) h tail high replayed fromFin pre sameEpoch shape replayedF
    tailC highC replayedC replayedPHigh
  have b7 := bud_fall (config := config) h
  have b8 := bud_rise (config := config) h
  have b10 := bud_deposits (config := config) h tail high endEpoch replayed
  have b11 := bud_queueRise (config := config) h tailC highC
  have b12 := bud_exitingRise (config := config) h tailC
  have b13 := bud_exitingCredits (config := config) h toB link pre sameEpoch tailC highC replayedC
  have b17 := bud_exitingBands (config := config) h tailC highC
  have b18 := bud_pendingR (config := config) h
  have b15 := bud_consolidations (config := config) h fromFin tail high endEpoch replayed replayedF
    highLeR tailC highC endEpochC replayedC highLe
  have b16 := bud_exitedR (config := config) (pulled := pulled) (anc := anc) (fin := fin)
    (counted := counted)
  -- `bud_consolidations` pays the band of each due entry: the counted keys' bands and V's share.
  have electra : .pectra ≤ fork := Nat.le_trans (by decide) h.fulu
  have bandV : ∑ v ∈ K4 pulled counted V, bandX fin highC v.toNat +
        ∑ v ∈ K6 pulled counted, bandX fin highC v.toNat +
        3 * ∑ v ∈ K5 counted V, bandX fin highC v.toNat +
        3 * (preset.upwardBand * dueAt fin high V) =
      preset.upwardBand * (dueAt fin highC (K4 pulled counted V) +
        dueAt fin highC (K6 pulled counted) + 3 * dueAt fin highC (K5 counted V) +
        3 * dueAt fin high V) := by
    rw [bandX_sum fin electra highC, bandX_sum fin electra highC, bandX_sum fin electra highC]
    ring
  have b15' := Nat.le_trans (Nat.add_le_add_left (Nat.le_of_eq bandV) _) b15
  have qs := queues_split config pulled anc fin
  have b14 := bud_whistle_of (config := config) h tail high endEpoch replayed fromFin replayedF
    tailC highC endEpochC replayedC pre reg.1 reg.2
  simp only [whistleActiveRow] at b14
  have b19 := bud_joinRise (config := config) h
  have b20 := sc_3a_split (config := config) h
  have b21 := bud_capSlots (config := config) h
  have w4 : 0 ≤ ∑ v ∈ (K4 pulled counted V), (whistC tailC highC v.toNat : ℤ) :=
    nn _ _
  have w6 : 0 ≤ ∑ v ∈ (K6 pulled counted), (whistC tailC highC v.toNat : ℤ) :=
    nn _ _
  have b9 := bud_joining (config := config) (pulled := pulled) (anc := anc) (fin := fin)
  -- The upward bands of the charged keys of `SC` are not read by the drift.
  have bandPosSC : (0 : ℤ) ≤ ((∑ v ∈ scCharged pulled counted split tailC,
      if 0 < propN pre highC v.toNat + whistC pre highC v.toNat + syncCr eventsP v.toNat then
        preset.upwardBand else 0 : ℕ) : ℤ) := Int.natCast_nonneg _
  unfold pinReserve
  unfold PinTerms.total stake
  simp only [AC, AR, Q, eC, eR] at *
  simp only [sc3a, scSlashedReward] at *
  simp only [keyExtra, Finset.sum_add_distrib] at sV sN sP sJ b2 b5 b6 b14 b16 b18 b20 ⊢
  simp only [← Finset.mul_sum] at b6 b14
  zify at *
  have syncPos : 0 ≤ ∑ x ∈ K4 pulled counted V, (syncF events x.toNat : ℤ) :=
    nn _ _
  have syncPosC : 0 ≤ ∑ x ∈ K4 pulled counted V, (syncF eventsC x.toNat : ℤ) :=
    nn _ _
  -- `bud_sync` weighs the shared segment's debits of `K4` three times, and `cN_le` once.
  have syncPosF : 0 ≤ ∑ x ∈ K4 pulled counted V, (syncD eventsF x.toNat : ℤ) :=
    nn _ _
  -- `bud_units` also weighs the units of `SC` and `CS`, which the drift does not read.
  have unitPosSC : 0 ≤ ∑ x ∈ SC pulled counted split,
      (unitK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF x.toNat : ℤ) :=
    nn _ _
  have unitPosCS : 0 ≤ ∑ x ∈ CS counted split,
      (unitK (pinTerms config pulled anc fin) tailC highC eventsC events eventsF x.toNat : ℤ) :=
    nn _ _
  -- The compounding in `bud_credits` pays a tenth of the shared credits that `cP_le` reads.
  have scChargedPre : 0 ≤
      ∑ v ∈ scCharged pulled counted split tailC, (whistC pre highC v.toNat : ℤ) :=
    nn _ _
  have wShareSC : 0 ≤ ((wShare preset fork (∑ v ∈ SC pulled counted split,
      propN pre highC v.toNat) : ℕ) : ℤ) := Int.natCast_nonneg _
  have syncPre : 0 ≤ ∑ v ∈ SC pulled counted split, (syncCr eventsP v.toNat : ℤ) :=
    nn _ _
  have proposerPre : 0 ≤ ∑ x ∈ K5 counted V, (propN pre highC x.toNat : ℤ) :=
    nn _ _
  have xPos : 0 ≤ (33 * ((pinTerms config pulled anc fin).consolidationsX : ℤ) + 9) / 10 := by
    positivity
  have proposerPos : 0 ≤ ((pinTerms config pulled anc fin).depth : ℤ) *
      ((pinTerms config pulled anc fin).syncProposer : ℤ) := by positivity
  have unitPos : 0 ≤ ((pinTerms config pulled anc fin).unitGain : ℤ) *
      ((pinTerms config pulled anc fin).consolidationsXCount : ℤ) := by positivity
  -- A key of `K6` whose exit R reads weighs once in the drift and three times in `exiting`.
  have exitingK6 : 0 ≤ ∑ v ∈ K6 pulled counted with
      (pinTerms config pulled anc fin).exitingB v.toNat = true, (balanceAt pulled v.toNat : ℤ) :=
    nn _ _
  have riseK6 : 0 ≤ ∑ v ∈ K6 pulled counted with
      (pinTerms config pulled anc fin).exitingB v.toNat = true,
        ((pinTerms config pulled anc fin).rise v.toNat : ℤ) :=
    nn _ _
  -- The keys slashed at C add a nonnegative leak to the left side of `bud_syncLeak`.
  have leakSC : 0 ≤ ∑ v ∈ SC pulled counted split,
      (inducedR (pinTerms config pulled anc fin) (fromFin.append tail) v.toNat : ℤ) :=
    nn _ _
  by_cases gH : (pinTerms config pulled anc fin).gainHigh = true
  · simp only [gH, ↓reduceIte] at b14 b21 u2
    linarith
  · simp only [gH, Bool.false_eq_true, ↓reduceIte] at b14 b21 u2
    linarith

end Closure

