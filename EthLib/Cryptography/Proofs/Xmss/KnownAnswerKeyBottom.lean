  apply Vector.ext
  intro j hj
  have : (0 ≤ j ∧ j < 8)
    ∨ (8 ≤ j ∧ j < 16)
    ∨ (16 ≤ j ∧ j < 24)
    ∨ (24 ≤ j ∧ j < 32)
    ∨ (32 ≤ j ∧ j < 40)
    ∨ (40 ≤ j ∧ j < 48)
    ∨ (48 ≤ j ∧ j < 56)
    ∨ (56 ≤ j ∧ j < 58) := by
    simp only [V] at hj
    omega
  rcases this with h | h | h | h | h | h | h | h
  · exact bottomStarts_0 ⟨j, hj⟩ h.1 h.2
  · exact bottomStarts_1 ⟨j, hj⟩ h.1 h.2
