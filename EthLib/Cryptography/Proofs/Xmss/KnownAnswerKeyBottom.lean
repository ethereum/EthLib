  intro j hj
  have : (0 ≤ j ∧ j < 8)
    ∨ (8 ≤ j ∧ j < 16)
    ∨ (16 ≤ j ∧ j < 24)
    ∨ (24 ≤ j ∧ j < 32)
    ∨ (32 ≤ j ∧ j < 40)
