/-- The public key encodes to its bytes. -/
theorem encode_publicKey : (encodePublicKey publicKey).data.toList = publicKeyBytes.data.toList := by
  -- Lists, not arrays: the kernel appends a list in one pass.
  simp only [encodePublicKey, packBytes, ByteArray.data_append, Array.toList_append]
  decide +kernel

/-- The signature encodes to its bytes. -/
theorem encode_signature : (encodeSignature signature).data.toList = signatureBytes.data.toList := by
  -- Lists, not arrays: the kernel appends a list in one pass.
  simp only [encodeSignature, encodeLayerSignature, packDigests, packBytes, ByteArray.data_append,
    Array.toList_append, Vector.flatten, Array.toList_flatten, Array.toList_map]
  decide +kernel

/-- The public key bytes decode to the public key. -/
theorem decode_publicKey : (decodePublicKey publicKeyBytes).toOption = some publicKey := by
  rw [show publicKeyBytes = encodePublicKey publicKey from
      (ByteArray.ext (Array.toList_inj.mp encode_publicKey)).symm,
    decodePublicKey_encodePublicKey]
  rfl

/-- The signature bytes decode to the signature. -/
theorem decode_signature : (decodeSignature signatureBytes).toOption = some signature := by
  rw [show signatureBytes = encodeSignature signature from
      (ByteArray.ext (Array.toList_inj.mp encode_signature)).symm,
    decodeSignature_encodeSignature]
  rfl

