module

public import EthLib.Cryptography.Proofs.Aes.Gcm

/-!
# Proofs: known answers for AES-128-GCM with a long IV

The test cases come from the NIST CAVP file
[gcmtestvectors.zip](https://csrc.nist.gov/CSRC/media/Projects/Cryptographic-Algorithm-Validation-Program/documents/mac/gcmtestvectors.zip).

Each section names its response file and the parameters of its test case.

The kernel runs each encryption, and decryption follows from the round trip.
-/

@[expose] public section

namespace EthLib.Cryptography.Aes.Gcm

/-! ## gcmEncryptExtIV128.rsp, Count = 0

Its section is `Keylen = 128, IVlen = 1024, PTlen = 128, AADlen = 128, Taglen = 128`.

A 128-byte IV, so the pre-counter block is hashed. -/

/-- The key. -/
def longIvKey : Key .aes128 := #v[
  0xca, 0x91, 0xe2, 0x41, 0x44, 0x09, 0xa4, 0x39, 0xb0, 0x65, 0x73, 0xd7, 0x72, 0xf9, 0x0a, 0xfb]

/-- The IV. -/
def longIvIv : ByteArray := ⟨#[
  0x17, 0x70, 0x08, 0xf9, 0x20, 0xa0, 0x61, 0x69, 0xcc, 0xdf, 0x75, 0x3a, 0x33, 0x85, 0x53, 0xfe,
  0xfd, 0x46, 0x84, 0x58, 0x69, 0xc9, 0x24, 0x4d, 0xa4, 0x49, 0x97, 0xf8, 0x3d, 0x4c, 0xe8, 0x05,
  0xa1, 0x87, 0x07, 0xc8, 0x4d, 0x11, 0x4f, 0x9c, 0x68, 0x42, 0x7b, 0x22, 0x84, 0x15, 0x91, 0xe6,
  0xca, 0xec, 0xf5, 0xc3, 0xe7, 0x2a, 0x25, 0x16, 0x7a, 0xa8, 0x60, 0xc5, 0x1b, 0xdc, 0x1a, 0xa5,
  0x6d, 0xcd, 0x69, 0xf2, 0x9a, 0x2f, 0x35, 0xe7, 0x0a, 0x32, 0x2b, 0x9e, 0xba, 0x09, 0x2a, 0x98,
  0xd6, 0x6a, 0x95, 0x6b, 0x4d, 0x29, 0x43, 0x83, 0xa0, 0xeb, 0xab, 0x26, 0xf7, 0xc4, 0xdf, 0x1a,
  0x5d, 0x40, 0x60, 0xdf, 0xc4, 0x5a, 0x14, 0x15, 0x51, 0x00, 0xea, 0x7d, 0x9e, 0x32, 0xde, 0xbb,
  0x65, 0x37, 0x40, 0x6b, 0x75, 0x72, 0x91, 0x71, 0x05, 0x05, 0x14, 0x2e, 0x76, 0x59, 0xfc, 0x77]⟩

/-- The plaintext. -/
def longIvPt : ByteArray := ⟨#[
  0x28, 0x00, 0x3e, 0x30, 0xc4, 0xa4, 0xca, 0x9e, 0x41, 0xaa, 0xfe, 0xfa, 0xc1, 0xe1, 0xc3, 0xde]⟩

/-- The additional data. -/
def longIvAad : ByteArray := ⟨#[
  0xbf, 0xeb, 0x15, 0xfc, 0xf7, 0xb1, 0x5f, 0x0e, 0x14, 0xc0, 0x44, 0x39, 0xb6, 0x79, 0x50, 0xbd]⟩

/-- The ciphertext. -/
def longIvCt : ByteArray := ⟨#[
  0x00, 0xe4, 0x72, 0x97, 0x1f, 0x3a, 0x77, 0x70, 0xaa, 0x71, 0x58, 0xfd, 0x92, 0xf1, 0x7b, 0xb7]⟩

/-- The tag. -/
def longIvTag : ByteArray := ⟨#[
  0x16, 0x66, 0x1b, 0x85, 0xeb, 0x51, 0x64, 0x6c, 0x94, 0xcf, 0x2b, 0xe4, 0xe4, 0x2d, 0x7a, 0x8e]⟩


/-- Encryption gives the ciphertext and the tag of the file. -/
theorem encrypt_longIv :
    (encrypt (ciph .aes128 longIvKey) 16 longIvIv longIvPt longIvAad).toOption =
      some (longIvCt, longIvTag) := by
  decide +kernel

/-- Decryption returns the plaintext, by the round trip. -/
theorem decrypt_longIv :
    decrypt (ciph .aes128 longIvKey) 16 longIvIv longIvCt longIvAad longIvTag =
      .ok longIvPt :=
  decrypt_encrypt _ _ _ _ _ _ _ (eq_ok_of_toOption encrypt_longIv)

end EthLib.Cryptography.Aes.Gcm
