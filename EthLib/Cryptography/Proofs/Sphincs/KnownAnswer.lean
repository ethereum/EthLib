/-! ## The digest -/

/-- The message and the randomizer hash to the digest. -/
theorem digest_known_answer : messageDigest publicKey.publicParam message signature.randomizer = digest := by
  simp only [messageDigest, Kernel.thFull_eq, Kernel.toList_append, Kernel.toList_packBytes]
  decide +kernel

/-- The digest names index 65963065. -/
theorem digestIndex_known_answer : digestIndex digest = 65963065 := by
  decide +kernel

/-- The digest names the leaves above. -/
theorem digestLeaves_known_answer : digestLeaves digest = leaves := by
  decide +kernel

/-! ## Joining the pieces -/

/-- The end a verifier walks chain `i` to, from its revealed value at position `x_i`. -/
def chainEnd (pp : PublicParam) (key : OtsKey) (x : Codeword) (y : Vector Digest V) (i : Fin V) :
    Digest :=
  chain pp key i x[i] (CHAIN_LENGTH - 1 - x[i]) (by have := x[i].isLt; omega) y[i]

/-- A layer's root, from its codeword, its chain ends, its leaf and its path, each checked apart. -/
theorem layerRoot_eq {pp : PublicParam} {layer : Layer} {idx : Nat} {msg : ByteArray}
    {sig : LayerSignature layer} {x : Codeword} {ends : Vector Digest V} {leaf root : Digest}
    (hx : encode pp (OtsKey.ofIndex layer idx) msg sig.counter = some x)
    (hends : ∀ i : Fin V, chainEnd pp (OtsKey.ofIndex layer idx) x sig.chainValues i = ends[i])
    (hleaf : otsLeafHash pp (OtsKey.ofIndex layer idx) ends = leaf)
    (hroot : fold pp layer (OtsKey.ofIndex layer idx).tree (OtsKey.ofIndex layer idx).leaf leaf sig.path
      = root) :
    layerRoot pp layer idx msg sig = some root := by
  -- The walked chains are the stated ends, chain by chain.
  have hv : (Vector.ofFn fun i => chain pp (OtsKey.ofIndex layer idx) i x[i]
      (CHAIN_LENGTH - 1 - x[i]) (by have := x[i].isLt; omega) sig.chainValues[i]) = ends :=
    Vector.ext fun i hi => by simpa [chainEnd] using hends ⟨i, hi⟩
  rw [layerRoot, otsLeaf, hx]
  simp only [Option.bind_eq_bind, Option.bind_some, Option.pure_def, hv, hleaf, hroot]

/-- The FORS key, from each tree's two level-9 nodes, checked apart. -/
theorem forsRecover_eq {pp : PublicParam} {idx : Nat} {leaves : Vector (Fin (2 ^ FORS_HEIGHT)) FORS_TREES}
    {openings : Vector TreeOpening FORS_TREES} {key : ForsKey}
    (h : ∀ kappa : Fin FORS_TREES, treeRecover pp idx kappa leaves[kappa] openings[kappa] = key[kappa]) :
    forsRecover pp idx leaves openings = key :=
  Vector.ext fun k hk => by simpa [forsRecover] using h ⟨k, hk⟩

