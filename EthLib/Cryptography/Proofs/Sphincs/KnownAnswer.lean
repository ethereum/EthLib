/-- The public key encodes to its bytes. -/
theorem encode_publicKey : (encodePublicKey publicKey).data.toList = publicKeyBytes.data.toList := by
  -- Lists, not arrays: the kernel appends a list in one pass.
  simp only [encodePublicKey, Xmss.packBytes, ByteArray.data_append, Array.toList_append]
  decide +kernel

/-- The randomizer encodes to its bytes. -/
theorem encode_randomizer :
    (packBytes signature.randomizer).data.toList = randomizerBytes.data.toList := by
  decide +kernel

/-- The FORS openings encode to their bytes. -/
theorem encode_fors : (encodeFors signature.fors).data.toList = forsBytes.data.toList := by
  -- Lists, not arrays: the kernel appends a list in one pass.
  simp only [encodeFors, treeOpeningBytes, Xmss.packBytes, Vector.flatten, Array.toList_flatten,
    Array.toList_map, Vector.toArray_map, Vector.toArray_append, Array.toList_append, List.map_map,
    Function.comp_def]
  decide +kernel

/-- The bottom layer encodes to its bytes. -/
theorem encode_bottom :
    (encodeLayerSignature signature.bottom).data.toList = bottomBytes.data.toList := by
  simp only [encodeLayerSignature, packDigests, Xmss.packBytes, ByteArray.data_append,
    Array.toList_append, Vector.flatten, Array.toList_flatten, Array.toList_map]
  decide +kernel

/-- The middle layer encodes to its bytes. -/
