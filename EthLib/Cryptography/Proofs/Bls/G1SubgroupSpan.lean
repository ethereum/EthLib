module

public import EthLib.Cryptography.Bls.Compress
public import EthLib.Cryptography.Proofs.Bls.Compress
public import EthLib.Cryptography.Proofs.Bls.G1Cardinality
public import Mathlib.GroupTheory.Index
public import Mathlib.Data.ZMod.QuotientGroup

/-!
# Proofs: completeness of the `G1` generator span on `r`-torsion

The elementary bound `#E(Fp) <= 2 * p + 1` from `G1Cardinality` is smaller than `r^2`.

Two independent `r`-torsion points would force `r^2` to divide `#E(Fp)` by Lagrange's theorem, which is impossible.

Therefore every `r`-torsion point in `G1` lies in the cyclic subgroup generated by `G1.generator`.

Each `G1.keyValidatePoint` key (`IRTF draft-irtf-cfrg-bls-signature-04 §2.5`) is `[a] * g_1` with `a != 0`.
-/

@[expose] public section

namespace EthLib.Cryptography.Bls.G1

open WeierstrassCurve.Jacobian

/-- By Lagrange's theorem, a nonzero `q`-torsion element of prime order `q` forces `q | Nat.card G`. -/
private theorem prime_dvd_card_of_annihilated {G : Type*} [AddCommGroup G] [Finite G]
    {q : Nat} (hq : q.Prime) (P : G) (hP : q • P = 0) (hne : P ≠ 0) : q ∣ Nat.card G := by
  let _ : Fact q.Prime := ⟨hq⟩
  rw [← addOrderOf_eq_prime hP hne]
  exact addOrderOf_dvd_natCard P

/-- A `q`-torsion `Q` outside `zmultiples P` (the subgroup of integer multiples of `P`) gives `q^2 | Nat.card G`. -/
private theorem prime_sq_dvd_card_of_independent {G : Type*} [AddCommGroup G] [Finite G]
    {q : Nat} (hq : q.Prime) (P Q : G) (hP : q • P = 0) (hQ : q • Q = 0) (hne : P ≠ 0)
    (hind : ∀ i : Fin q, Q ≠ i.val • P) : q ^ 2 ∣ Nat.card G := by
  classical
  let _ : Fact q.Prime := ⟨hq⟩
  have hpord : addOrderOf P = q := addOrderOf_eq_prime hP hne
  let S : AddSubgroup G := AddSubgroup.zmultiples P
  -- Because `P` has prime order `q`, every element of `S` has the form `[i] * P` with `i < q`.
  have hnotmem : Q ∉ S := by
    intro hm
    change Q ∈ AddSubgroup.zmultiples P at hm
    rw [mem_zmultiples_iff_mem_range_addOrderOf, hpord] at hm
    obtain ⟨i, hi, he⟩ := Finset.mem_image.mp hm
    exact hind ⟨i, Finset.mem_range.mp hi⟩ he.symm
  -- The image of `Q` in `G / S` is a nonzero `q`-torsion element, so `q` divides `Nat.card (G / S)`.
  have hquot : q • (QuotientAddGroup.mk Q : G ⧸ S) = 0 := by
    change q • (QuotientAddGroup.mk' S Q) = 0
    rw [← map_nsmul, hQ, map_zero]
  have hquotne : (QuotientAddGroup.mk Q : G ⧸ S) ≠ 0 := by
    intro h
    exact hnotmem ((QuotientAddGroup.eq_zero_iff Q).mp h)
  have hdiv : q ∣ Nat.card (G ⧸ S) :=
    prime_dvd_card_of_annihilated hq _ hquot hquotne
  -- Multiply `q | Nat.card (G / S)` by `Nat.card S = q` via Lagrange's index identity.
  rw [S.card_eq_card_quotient_mul_card_addSubgroup,
    show Nat.card S = q by dsimp [S]; rw [Nat.card_zmultiples, hpord]]
  obtain ⟨k, hk⟩ := hdiv
  refine ⟨k, ?_⟩
  rw [hk]
  ring

/-- `Valid` is required because singular `z != 0` triples also map to `0` under `toPoint`. -/
theorem isInfinity_eq_true_iff_toPoint_eq_zero {P : G1} (hP : Valid P) :
    P.isInfinity = true ↔ toPoint P = 0 := by
  constructor
  · intro h
    exact Point.toAffine_of_Z_eq_zero (isZero_iff.mp h)
  · intro h
    -- A finite nonsingular representative maps to `Point.some`, never `0`.
    by_contra hne
    have hz : (P.z : ZMod Fp.modulus) ≠ 0 := fun hz0 => hne (isZero_iff.mpr hz0)
    rw [toPoint, Point.toAffine_of_Z_ne_zero hP hz] at h
    cases h

theorem inSubgroup_iff_modulus_smul_eq_zero {P : G1} (hP : Valid P) :
    inSubgroup P = true ↔ Fr.modulus • toPoint P = 0 := by
  rw [inSubgroup]
  by_cases hi : P.isInfinity = true
  · rw [ite_eq_left hi, (isInfinity_eq_true_iff_toPoint_eq_zero hP).mp hi]
    simp
  · rw [ite_eq_right hi, isInfinity_eq_true_iff_toPoint_eq_zero (valid_mulNat hP _),
      toPoint_mulNat hP]

/-- Rules out a rank-2 `r`-torsion subgroup inside `E(Fp)` once `#E(Fp) <= 2 * p + 1` meets Lagrange's theorem. -/
theorem modulus_sq_gt_card_bound : 2 * Fp.modulus + 1 < Fr.modulus ^ 2 := by
  decide +kernel

/-- Independence from `toPoint generator` would force `r^2 | #E(Fp)`, violating `card_point_le`. -/
theorem exists_nsmul_generator_of_modulus_smul_eq_zero {Q : curve.toAffine.Point}
    (hQ : Fr.modulus • Q = 0) :
    ∃ n : Nat, n < Fr.modulus ∧ Q = n • toPoint generator := by
  classical
  by_contra hnot
  have hind : ∀ i : Fin Fr.modulus, Q ≠ i.val • toPoint generator := by
    intro i he
    exact hnot ⟨i.val, i.isLt, he⟩
  -- An independent `r`-torsion point forces `r^2 | #E(Fp)`, contradicting `#E(Fp) <= 2 * p + 1 < r^2`.
  have hd : Fr.modulus ^ 2 ∣ Nat.card curve.toAffine.Point :=
    prime_sq_dvd_card_of_independent Fr.modulus_prime
      (toPoint generator) Q modulus_smul_generator hQ toPoint_generator_ne_zero hind
  have hle := Nat.le_of_dvd (Nat.card_pos (α := curve.toAffine.Point)) hd
  have hc := card_point_le
  have hn := modulus_sq_gt_card_bound
  omega

theorem exists_mulNat_generator_of_inSubgroup {P : G1} (hP : Valid P)
    (hsub : inSubgroup P = true) :
    ∃ n : Nat, n < Fr.modulus ∧ toPoint P = toPoint (mulNat generator n) := by
  obtain ⟨n, hn, he⟩ := exists_nsmul_generator_of_modulus_smul_eq_zero
    ((inSubgroup_iff_modulus_smul_eq_zero hP).mp hsub)
  exact ⟨n, hn, he.trans (toPoint_mulNat valid_generator n).symm⟩

theorem exists_mul_generator_of_inSubgroup {P : G1} (hP : Valid P)
    (hsub : inSubgroup P = true) :
    ∃ a : Fr, toPoint P = toPoint (mul generator a) := by
  obtain ⟨n, hn, he⟩ := exists_mulNat_generator_of_inSubgroup hP hsub
  exact ⟨⟨n, hn⟩, he⟩

/-- Because `g_1` has order `r` and `s.val < r`, `[s] * g_1` vanishes only at `s = 0`. -/
theorem mul_generator_isInfinity_iff (s : Fr) :
    (mul generator s).isInfinity = true ↔ s = 0 := by
  rw [isInfinity_eq_true_iff_toPoint_eq_zero (valid_mul valid_generator s),
    toPoint_mul valid_generator, ← addOrderOf_dvd_iff_nsmul_eq_zero,
    addOrderOf_toPoint_generator]
  constructor
  · intro h
    exact Fin.ext (Nat.eq_zero_of_dvd_of_lt h s.isLt)
  · rintro rfl
    exact Nat.dvd_zero _

/-- `KeyValidate` (`IRTF draft-irtf-cfrg-bls-signature-04 §2.5`) rejects `0` and requires `inSubgroup` so `a != 0`. -/
theorem exists_mul_generator_of_keyValidatePoint {bytes : ByteArray} {P : G1}
    (h : keyValidatePoint bytes = .ok P) :
    Valid P ∧ ∃ a : Fr, a ≠ 0 ∧ toPoint P = toPoint (mul generator a) := by
  unfold keyValidatePoint at h
  cases hunc : uncompress bytes with
  | error e =>
    rw [hunc] at h
    cases h
  | ok p =>
    rw [hunc] at h
    dsimp only [Bind.bind, Except.bind, pure, Except.pure, throw, Except.error] at h
    by_cases hinf : p.isInfinity = true
    -- `keyValidatePoint` rejects the point at infinity.
    · rw [ite_eq_left hinf] at h
      cases h
    · rw [ite_eq_right hinf] at h
      by_cases hsub : inSubgroup p = true
      · rw [show (!inSubgroup p) = false by simp [hsub]] at h
        cases h
        have hvalid : Valid P := uncompress_valid hunc
        obtain ⟨a, ha⟩ := exists_mul_generator_of_inSubgroup hvalid hsub
        -- Because `P` is not at infinity, `toPoint P != 0`, forcing the discrete logarithm `a != 0`.
        refine ⟨hvalid, a, ?_, ha⟩
        intro ha0
        subst ha0
        have hp0 : toPoint P = 0 := by
          rw [ha, mul, show (0 : Fr).val = 0 from rfl, mulNat_def, ite_eq_left rfl, toPoint_zero]
        exact hinf ((isInfinity_eq_true_iff_toPoint_eq_zero hvalid).mpr hp0)
      · rw [show (!inSubgroup p) = true by simp [hsub]] at h
        cases h

end EthLib.Cryptography.Bls.G1
