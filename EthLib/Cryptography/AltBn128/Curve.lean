module

public import EthLib.Cryptography.Secp256k1.Field
public import EthLib.Cryptography.Jacobian

/-!
# `AltBn128.Curve`

The curve `E: y^2 = x^3 + 3` over `Fp`, also called BN254.

[EIP-196](https://eips.ethereum.org/EIPS/eip-196) defines the curve.

[EIP-197](https://eips.ethereum.org/EIPS/eip-197) defines its groups and its pairing.

- `Fp` is the base field, integers mod the prime `p`.
- `Fr` is the scalar field, integers mod the prime order `q` of the group `G_1`.

The points of `E` over `Fp` form a group of order `q`, generated by `P1 = (1, 2)`.

They follow the addition rule of SEC 1 v2 §2.2.1, with `a = 0`, as for secp256k1.
-/

@[expose] public section

namespace EthLib.Cryptography.AltBn128

/-- `p`, the modulus of the base field, from EIP-196. -/
def Fp.modulus : Nat := 21888242871839275222246405745257275088696311157297823662689037894645226208583

/-- `q`, the order of `G_1` and `G_2`, from EIP-197. -/
def Fr.modulus : Nat := 21888242871839275222246405745257275088548364400416034343698204186575808495617

-- Named explicitly, since both anonymous instances would get the same name.
instance Fp.instNeZeroModulus : NeZero Fp.modulus := ⟨by decide⟩
instance Fr.instNeZeroModulus : NeZero Fr.modulus := ⟨by decide⟩

/-- An element of the base field. -/
abbrev Fp := Fin Fp.modulus

/-- The inverse in `Fp`, by the extended Euclidean algorithm, and 0 for 0. -/
def Fp.inv (a : Fp) : Fp := Fin.inverse a

/-- `b = 3`, from EIP-196. -/
def b : Fp := 3

/-- A point of `E` over `Fp`, or the point at infinity `O`. -/
inductive Point where
  /-- The point at infinity `O`, the zero of the group. -/
  | infinity
  /-- The point `(x, y)`. -/
  | affine (x y : Fp)
deriving DecidableEq, Repr, Inhabited

namespace Point

/-- Whether a point satisfies `y^2 = x^3 + 3`.

The point at infinity always does. -/
def isOnCurve : Point → Bool
  | infinity => true
  | affine x y => y * y == x * x * x + b

/-- The generator `P1 = (1, 2)` of `G_1`, from EIP-197. -/
def generator : Point := affine 1 2

/-- The negative of a point: `-(x, y) = (x, -y)`. -/
def neg : Point → Point
  | infinity => infinity
  | affine x y => affine x (-y)

/-- The sum of two points, by the addition rule of SEC 1 v2 §2.2.1, with `a = 0`.

- `O + P = P + O = P`, and `(x, y) + (x, -y) = O`.
- Two points with different `x` take the chord's slope `l = (y2 - y1) / (x2 - x1)`.
- A point added to itself takes the tangent's slope `l = 3 x1^2 / (2 y1)`.

Then `x3 = l^2 - x1 - x2` and `y3 = l (x1 - x3) - y1`. -/
def add : Point → Point → Point
  | infinity, q => q
  | p, infinity => p
  | affine x1 y1, affine x2 y2 =>
    if x1 = x2 then
      -- The same x: two points of the curve are then equal, or opposite.
      if y2 = -y1 then infinity
      else
        -- The point is doubled, with the tangent's slope.
        let l := 3 * x1 * x1 * (2 * y1).inv
        let x3 := l * l - x1 - x2
        affine x3 (l * (x1 - x3) - y1)
    else
      -- Two different x: the chord's slope.
      let l := (y2 - y1) * (x2 - x1).inv
      let x3 := l * l - x1 - x2
      affine x3 (l * (x1 - x3) - y1)

instance : Add Point := ⟨add⟩

/-- The Jacobian form of a point. -/
def toJacobian : Point → Jacobian Fp.modulus
  | infinity => .infinity
  | affine x y => .ofAffine x y

/-- The point of a Jacobian form. -/
def ofJacobian (p : Jacobian Fp.modulus) : Point :=
  match p.toAffine with
  | none => infinity
  | some (x, y) => affine x y

/-- `k P`, for `k < 2^fuel`, by double and add on the bits of `k`, low bit first.

The steps run in Jacobian coordinates, so only the conversion back takes an inverse. -/
def mulBits (fuel k : Nat) (p : Point) : Point :=
  ofJacobian (Jacobian.mulBits 0 fuel k (toJacobian p))

end Point

end EthLib.Cryptography.AltBn128
