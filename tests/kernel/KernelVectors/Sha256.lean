module

import EthLib.Cryptography.Hash.Sha256

/-!
# SHA-256 known answers in the kernel

Each case is a file of `tests/cryptography/sha256/hash/`, copied byte for byte.

That directory is pinned: its `SHA256SUMS` names FIPS 180-2 as the source of these two cases.

The kernel computes each digest, so a case holds only if the definition gives the expected bytes.
-/

open EthLib.Cryptography.Hash

/-- `hash_case_fips_abc`: the three bytes of "abc", in one block. -/
example : Sha256.hash
      ⟨#[0x61, 0x62, 0x63]⟩ =
    ⟨#[0xba, 0x78, 0x16, 0xbf, 0x8f, 0x01, 0xcf, 0xea, 0x41, 0x41, 0x40, 0xde, 0x5d, 0xae,
       0x22, 0x23, 0xb0, 0x03, 0x61, 0xa3, 0x96, 0x17, 0x7a, 0x9c, 0xb4, 0x10, 0xff, 0x61,
       0xf2, 0x00, 0x15, 0xad]⟩ := by
  decide +kernel

/-- `hash_case_fips_56_bytes`: 56 bytes, so the padding takes a second block. -/
example : Sha256.hash
      ⟨#[0x61, 0x62, 0x63, 0x64, 0x62, 0x63, 0x64, 0x65, 0x63, 0x64, 0x65, 0x66, 0x64, 0x65,
         0x66, 0x67, 0x65, 0x66, 0x67, 0x68, 0x66, 0x67, 0x68, 0x69, 0x67, 0x68, 0x69, 0x6a,
         0x68, 0x69, 0x6a, 0x6b, 0x69, 0x6a, 0x6b, 0x6c, 0x6a, 0x6b, 0x6c, 0x6d, 0x6b, 0x6c,
         0x6d, 0x6e, 0x6c, 0x6d, 0x6e, 0x6f, 0x6d, 0x6e, 0x6f, 0x70, 0x6e, 0x6f, 0x70, 0x71]⟩ =
    ⟨#[0x24, 0x8d, 0x6a, 0x61, 0xd2, 0x06, 0x38, 0xb8, 0xe5, 0xc0, 0x26, 0x93, 0x0c, 0x3e,
       0x60, 0x39, 0xa3, 0x3c, 0xe4, 0x59, 0x64, 0xff, 0x21, 0x67, 0xf6, 0xec, 0xed, 0xd4,
       0x19, 0xdb, 0x06, 0xc1]⟩ := by
  decide +kernel
